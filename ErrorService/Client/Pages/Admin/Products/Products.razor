@page "/admin/products"
@page "/admin/products/edit/{Id:int}"
@page "/admin/products/new"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.products.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using ErrorService.Client.Utils

@using ErrorService.Client.Services
@implements IDisposable
@inject IJSRuntime JS
@inject ToastService ToastService
@inject NavigationManager NavManager

<PageTitle>محصولات | ارورسرویس</PageTitle>

<div class="admin-container">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h3 class="admin-page-title m-0">مدیریت محصولات</h3>
        <div class="d-flex gap-2 flex-wrap">
            <AuthorizeView Policy="perm:admin.orders.view">
                <a href="/admin/shop-accounting" class="btn btn-outline-primary shadow-sm rounded-3">
                    <span class="oi oi-calculator me-1"></span> حسابداری فروشگاه
                </a>
            </AuthorizeView>
            <a href="/admin/shop-settings" class="btn btn-outline-secondary shadow-sm rounded-3">
                <span class="oi oi-cog me-1"></span> تنظیمات فروشگاه
            </a>
            <button class="btn btn-primary shadow-sm rounded-3" @onclick="NewProduct">
                <span class="oi oi-plus me-1"></span> افزودن محصول جدید
            </button>
        </div>
    </div>

    <AuthorizeView Policy="perm:admin.orders.view">
        <div class="shop-kpi mb-4">
            <div class="shop-kpi__item shop-kpi__item--info" title="مبلغ سفارش‌های امروز به تومان — سفارش لغو/رد شده حساب نمی‌شود">
                <span class="shop-kpi__label">درآمد امروز (تومان)</span>
                <span class="shop-kpi__value">@_acctToday.ToString("N0")</span>
                <span class="shop-kpi__hint">بدون سفارش‌های لغو/رد شده</span>
            </div>
            <div class="shop-kpi__item" title="فروش قابل پرداخت از ابتدای ماه جاری">
                <span class="shop-kpi__label">درآمد این ماه (تومان)</span>
                <span class="shop-kpi__value">@((_acct?.SellAmount ?? 0m).ToString("N0"))</span>
                <span class="shop-kpi__hint">بدون لغو/رد شده</span>
            </div>
            <div class="shop-kpi__item shop-kpi__item--ok" title="فروش تایید/تکمیل شده این ماه">
                <span class="shop-kpi__label">تاییدشده این ماه (تومان)</span>
                <span class="shop-kpi__value">@((_acct?.ConfirmedAmount ?? 0m).ToString("N0"))</span>
                <span class="shop-kpi__hint">@(_acct?.ConfirmedCount ?? 0) سفارش تایید شده</span>
            </div>
            <div class="shop-kpi__item shop-kpi__item--warn" title="تعداد اقلام فروخته‌شده در این ماه">
                <span class="shop-kpi__label">اقلام فروخته‌شده (ماه)</span>
                <span class="shop-kpi__value">@((_acct?.UnitsSold ?? 0).ToString("N0"))</span>
                <span class="shop-kpi__hint">@(_acct?.OrdersCount ?? 0) سفارش ثبت شده</span>
            </div>
            <div class="shop-kpi__item shop-kpi__item--danger" title="بازپرداخت‌های مرجوعی در این ماه">
                <span class="shop-kpi__label">مرجوعی (ماه)</span>
                <span class="shop-kpi__value">@((_acct?.RefundAmount ?? 0m).ToString("N0"))</span>
                <span class="shop-kpi__hint">@(_acct?.ReturnsCount ?? 0) درخواست مرجوعی</span>
            </div>
            <button type="button" class="shop-kpi__item shop-kpi__item--acc" @onclick="GoAccounting"
                    title="باز کردن فرم کامل حسابداری فروشگاه با انتخاب بازهٔ تاریخ">
                <span class="shop-kpi__label">گزارش کامل مالی</span>
                <span class="shop-kpi__value shop-kpi__value--acc">حسابداری فروشگاه</span>
                <span class="shop-kpi__hint">کلیک: ورود به فرم حسابداری</span>
            </button>
        </div>
    </AuthorizeView>

    <ConfirmDialog IsVisible="showConfirm" 
                   Title="حذف محصول" 
                   Message=@($"آیا از حذف محصول \"{itemToDelete?.Name}\" اطمینان دارید؟")
                   OnResult="HandleDeleteResult" />

    <ConfirmDialog IsVisible="_showPointConfirm"
                   Title="حذف رکورد تاریخچه"
                   Message="آیا از حذف این رکورد از تاریخچه قیمت اطمینان دارید؟"
                   OnResult="HandlePointDeleteResult" />

    @if (_phModalOpen)
    {
        <div class="phm-backdrop" @onclick="ClosePhModal"></div>
        <div class="phm" role="dialog" aria-modal="true">
            <div class="phm__h">
                <span class="oi oi-clock"></span>
                @(_phEditingPointId > 0 ? "ویرایش رکورد تاریخچه قیمت" : "افزودن رکورد تاریخچه قیمت")
                <button type="button" class="btn-close" @onclick="ClosePhModal"></button>
            </div>
            <div class="phm__b">
                <label class="form-label fw-bold">تاریخ ثبت (شمسی)</label>
                <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="_phDateInput" placeholder="1404/01/01" />
                <div class="text-muted small mt-1">تاریخ ایجاد محصول به‌صورت پیش‌فرض استفاده می‌شود.</div>
                <label class="form-label fw-bold mt-3">قیمت (تومان)</label>
                <input id="ph-price-input" class="form-control rounded-3 price-input-ltr" autocomplete="off" @bind="_phPriceInput" />
                <label class="form-label fw-bold mt-3">قیمت با تخفیف (اختیاری)</label>
                <input id="ph-discount-input" class="form-control rounded-3 price-input-ltr" autocomplete="off" @bind="_phDiscountInput" placeholder="خالی = بدون تخفیف" />
            </div>
            <div class="phm__f">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClosePhModal">انصراف</button>
                <button type="button" class="btn btn-sm btn-warning" @onclick="SavePricePoint" disabled="@_phSaving">
                    @(_phSaving ? "در حال ذخیره..." : "ذخیره رکورد")
                </button>
            </div>
        </div>
    }

    @if (showEditor)
    {
        <div @ref="editorCard" class="card shadow-sm border-0 rounded-4 mb-4 p-4 animate__animated animate__fadeIn">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="m-0">@(editingId == 0 ? "ایجاد محصول جدید" : "ویرایش محصول")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>

            @if (!string.IsNullOrWhiteSpace(model.Name))
            {
                <div class="pe-namechip-wrap">
                    <span class="pe-namechip" title="@model.Name">
                        <i class="pe-namechip__dot"></i>
                        <span class="pe-namechip__txt">@model.Name</span>
                    </span>
                </div>
            }

            <EditForm Model="model" OnValidSubmit="SaveProduct">
                <DataAnnotationsValidator />

                <ul class="pe-tabs mb-4">
                    <li><button type="button" class="pe-tabs__btn @(_tab == 0 ? "pe-tabs__btn--active" : "")" @onclick="() => _tab = 0">اطلاعات اصلی</button></li>
                    <li><button type="button" class="pe-tabs__btn @(_tab == 1 ? "pe-tabs__btn--active" : "")" @onclick="() => _tab = 1">قیمت و تخفیف</button></li>
                    <li><button type="button" class="pe-tabs__btn @(_tab == 2 ? "pe-tabs__btn--active" : "")" @onclick="() => _tab = 2">تصاویر محصول</button></li>
                    <li><button type="button" class="pe-tabs__btn @(_tab == 3 ? "pe-tabs__btn--active" : "")" @onclick="() => _tab = 3">موجودی و ارسال</button></li>
                    <li><button type="button" class="pe-tabs__btn @(_tab == 4 ? "pe-tabs__btn--active" : "")" @onclick="() => _tab = 4">مشخصات فنی</button></li>
                </ul>

                <div data-title="اطلاعات اصلی" class="pe-pane @(_tab == 0 ? "pe-pane--active" : "")">
                    <div class="row g-3">
                        <div class="col-md-4 order-first">
                            <div class="pe-sec" style="--acc:#0ea5e9">
                                <div class="pe-sec__h"><span class="oi oi-folder"></span> دسته‌بندی <i>محل نمایش محصول در فروشگاه</i></div>
                                <div class="mb-0">
                                    <InputSelect @bind-Value="model.CategoryId" class="form-select rounded-3">
                                        <option value="0">انتخاب کنید...</option>
                                        @if (categories != null)
                                        {
                                            @foreach (var cat in categories)
                                            {
                                                <option value="@cat.Id">@cat.Name (@cat.ProductCount)</option>
                                            }
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="@(() => model.CategoryId)" class="text-danger small" />
                                </div>
                            </div>
                        </div>
                        <div class="col-md-8">
                            <div class="pe-sec" style="--acc:#6366f1">
                                <div class="pe-sec__h"><span class="oi oi-document"></span> اطلاعات شناسه‌ای <i>نام و کد کالا</i></div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">نام محصول</label>
                                    <InputText @bind-Value="model.Name" class="form-control rounded-3" />
                                    <ValidationMessage For="@(() => model.Name)" class="text-danger small" />
                                </div>
                                <div class="mb-0">
                                    <label class="form-label fw-bold">کد محصول - SKU (اختیاری)</label>
                                    <InputText @bind-Value="model.Sku" class="form-control rounded-3 ltr" placeholder="مثال: ERR-SENS-001" />
                                </div>
                            </div>
                            <div class="pe-sec" style="--acc:#f59e0b">
                                <div class="pe-sec__h"><span class="oi oi-pencil"></span> توضیحات محصول <i>معرفی کامل برای مشتری</i></div>
                                <div class="editor-container">
                                    <textarea id="tiny-editor-product" class="form-control">@model.Description</textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div data-title="قیمت و تخفیف" class="pe-pane @(_tab == 1 ? "pe-pane--active" : "")">
                    <div class="pe-sec" style="--acc:#16a34a">
                        <div class="pe-sec__h"><span class="oi oi-tag"></span> قیمت و تخفیف <i>قیمت اصلی و شرایط تخفیف</i></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">قیمت (تومان)</label>
                                <input type="text" class="form-control rounded-3 price-input-ltr" id="price-input"
                                       value="@(model.Price > 0 ? model.Price.ToString("N0") : "")" />
                                <ValidationMessage For="@(() => model.Price)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">نوع تخفیف</label>
                                <div class="d-flex gap-3 flex-wrap align-items-center pt-1">
                                    <label class="form-check form-check-inline m-0">
                                        <input type="radio" class="form-check-input" name="discountType" value="" checked="@(discountTypeInput == DiscountTypeNone)" @onchange="() => SetDiscountType(DiscountTypeNone)" />
                                        <span class="form-check-label small fw-bold">بدون تخفیف</span>
                                    </label>
                                    <label class="form-check form-check-inline m-0">
                                        <input type="radio" class="form-check-input" name="discountType" value="permanent" checked="@(discountTypeInput == DiscountTypePermanent)" @onchange="() => SetDiscountType(DiscountTypePermanent)" />
                                        <span class="form-check-label small fw-bold">دائمی</span>
                                    </label>
                                    <label class="form-check form-check-inline m-0">
                                        <input type="radio" class="form-check-input" name="discountType" value="timed" checked="@(discountTypeInput == DiscountTypeTimed)" @onchange="() => SetDiscountType(DiscountTypeTimed)" />
                                        <span class="form-check-label small fw-bold">زمان‌دار</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        @if (discountTypeInput == "permanent" || discountTypeInput == "timed")
                        {
                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">قیمت با تخفیف</label>
                                    <input type="text" class="form-control rounded-3 price-input-ltr" id="discount-price-input"
                                           value="@(model.DiscountPrice.HasValue ? model.DiscountPrice.Value.ToString("N0") : "")" />
                                </div>
                            </div>
                        }
                        @if (discountTypeInput == "timed")
                        {
                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">تاریخ شروع تخفیف</label>
                                    <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="discountStartInput" />
                                    <div class="text-muted small mt-1">در صورت خالی بودن، از همین حالا فعال است.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">تاریخ پایان تخفیف <span class="text-danger">*</span></label>
                                    <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="discountExpiryInput" />
                                    <div class="text-muted small mt-1">پس از این تاریخ، قیمت اصلی نمایش داده می‌شود.</div>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="pe-sec" style="--acc:#6366f1">
                        <div class="pe-sec__h"><span class="oi oi-calendar"></span> زمان ثبت <i>تاریخ ایجاد این محصول</i></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">تاریخ و ساعت ایجاد محصول</label>
                                <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="createdAtInput" />
                                <div class="text-muted small mt-1">در صورت خالی بودن، زمان فعلی ثبت می‌شود.</div>
                            </div>
                        </div>
                    </div>
                    <div class="pe-sec" style="--acc:#f59e0b">
                        <div class="pe-sec__h"><span class="oi oi-clock"></span> تاریخچه قیمت <i>تغییرات قیمت در گذشته</i></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                @if (editingId > 0 && _priceHistory != null)
                                {
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="text-muted small">@(_priceHistory.Count) رکورد، مرتب‌شده بر اساس تاریخ</span>
                                        <button type="button" class="btn btn-sm btn-outline-warning" @onclick="OpenAddPricePoint">
                                            <span class="oi oi-plus"></span> افزودن رکورد
                                        </button>
                                    </div>
                                    @if (_priceHistory.Count == 0)
                                    {
                                        <div class="text-muted small">هنوز تغییر قیمتی ثبت نشده است.</div>
                                    }
                                    else
                                    {
                                        <div class="price-history">
                                            @foreach (var p in _priceHistory)
                                            {
                                                <div class="price-history__row">
                                                    <span class="price-history__date">@p.DateFa</span>
                                                    <span class="price-history__meta">
                                                        <span class="price-history__val">@p.Price.ToString("N0") تومان</span>
                                                        @if (p.DiscountPrice.HasValue)
                                                        {
                                                            <span class="price-history__disc">@p.DiscountPrice.Value.ToString("N0")</span>
                                                        }
                                                        @if (p.Id > 0)
                                                        {
                                                            <button type="button" class="price-history__edit" title="ویرایش این رکورد" @onclick="() => OpenEditPricePoint(p)" disabled="@_phSaving">
                                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                                                            </button>
                                                            <button type="button" class="price-history__del" title="حذف این رکورد" @onclick="() => RequestDeletePricePoint(p.Id)" disabled="@_deletingPoint">
                                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                                            </button>
                                                        }
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-muted small">پس از ذخیره محصول نمایش داده می‌شود.</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
                <div data-title="تصاویر محصول" class="pe-pane @(_tab == 2 ? "pe-pane--active" : "")">
                    <div class="pe-sec" style="--acc:#7c3aed">
                        <div class="pe-sec__h"><span class="oi oi-image"></span> گالری تصاویر <i>حداکثر ۴ تصویر برای محصول</i></div>
                        <div class="row g-2">
                            <div class="col-6 col-md-3">
                                <ImageUploader @bind-ImageUrl="model.MainImageUrl" UploadUrl="api/products/upload" ShowCamera="false" />
                                <div class="text-center small text-muted">تصویر اصلی</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <ImageUploader @bind-ImageUrl="model.ImageUrl2" UploadUrl="api/products/upload" ShowCamera="false" />
                                <div class="text-center small text-muted">تصویر 2</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <ImageUploader @bind-ImageUrl="model.ImageUrl3" UploadUrl="api/products/upload" ShowCamera="false" />
                                <div class="text-center small text-muted">تصویر 3</div>
                            </div>
                            <div class="col-6 col-md-3">
                                <ImageUploader @bind-ImageUrl="model.ImageUrl4" UploadUrl="api/products/upload" ShowCamera="false" />
                                <div class="text-center small text-muted">تصویر 4</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div data-title="مشخصات فنی" class="pe-pane @(_tab == 4 ? "pe-pane--active" : "")">
                    <div class="pe-sec" style="--acc:#6366f1">
                        <div class="pe-sec__h"><span class="oi oi-list"></span> مشخصات فنی محصول <i>مشخصه‌های نمایشی در صفحهٔ محصول</i></div>
                        @if (editingId == 0)
                    {
                        <div class="alert alert-info rounded-3 small mb-0">
                            ابتدا محصول را ذخیره کنید، سپس مشخصات فنی را وارد نمایید.
                        </div>
                    }
                    else
                    {
                        <div class="spec-editor">
                            <div class="row g-2 align-items-end mb-3">
                                <div class="col-md-5">
                                    <label class="form-label fw-bold small mb-1">نام مشخصه</label>
                                    <input class="form-control form-control-sm rounded-3" @bind="_newSpecName" placeholder="مثال: ولتاژ تغذیه" maxlength="120" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold small mb-1">مقدار</label>
                                    <input class="form-control form-control-sm rounded-3" @bind="_newSpecValue" placeholder="مثال: ۱۲ ولت" maxlength="500" />
                                </div>
                                <div class="col-md-1">
                                    <button type="button" class="btn btn-sm btn-primary w-100 rounded-3" @onclick="AddSpec">افزودن</button>
                                </div>
                            </div>
                            @if (_specs.Count == 0)
                            {
                                <div class="text-muted small">مشخصه‌ای ثبت نشده است.</div>
                            }
                            else
                            {
                                <div class="spec-list">
                                    @for (var i = 0; i < _specs.Count; i++)
                                    {
                                        var idx = i;
                                        <div class="spec-list__row">
                                            <input class="form-control form-control-sm rounded-3" value="@_specs[idx].SpecKey" maxlength="120"
                                                   @onchange="e => _specs[idx].SpecKey = e.Value?.ToString() ?? _specs[idx].SpecKey" />
                                            <input class="form-control form-control-sm rounded-3" value="@_specs[idx].SpecValue" maxlength="500"
                                                   @onchange="e => _specs[idx].SpecValue = e.Value?.ToString() ?? _specs[idx].SpecValue" />
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-3" @onclick="() => RemoveSpec(idx)">حذف</button>
                                        </div>
                                    }
                                </div>
                            }
                            <div class="d-flex align-items-center gap-3 mt-3">
                                <button type="button" class="btn btn-sm btn-outline-primary rounded-3" @onclick="SaveSpecs" disabled="@_specsSaving">
                                    @if (_specsSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                    ذخیره مشخصات فنی
                                </button>
                                <span class="text-muted small">با «ذخیره نهایی محصول» نیز مشخصات فنی ذخیره می‌شود.</span>
                            </div>
                        </div>
                    }
                    </div>
                    <div class="pe-sec" style="--acc:#7c3aed">
                        <div class="pe-sec__h"><span class="oi oi-wrench"></span> سازگاری و پشتیبانی <i>سازگاری، علائم خرابی و مستندات فنی</i></div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">اطلاعات سازگاری</label>
                                <InputTextArea @bind-Value="model.CompatibilityInfo" class="form-control rounded-3" rows="3" placeholder="برندها و مدل‌های سازگار با این قطعه" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">علائم خرابی</label>
                                <InputTextArea @bind-Value="model.FailureSymptoms" class="form-control rounded-3" rows="3" placeholder="علائمی که نشان می‌دهد این قطعه خراب است" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">لینک دیتاشیت (PDF)</label>
                                <InputText @bind-Value="model.DatasheetUrl" class="form-control rounded-3" placeholder="https://example.com/datasheet.pdf" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">شناسه محصولات مرتبط</label>
                                <InputText @bind-Value="model.RelatedProductIds" class="form-control rounded-3" placeholder="مثال: 5,12,23" />
                                <div class="text-muted small mt-1">شناسه عددی محصولات مرتبط را با کاما جدا کنید.</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div data-title="موجودی و ارسال" class="pe-pane @(_tab == 3 ? "pe-pane--active" : "")">
                    <div class="pe-sec" style="--acc:#0d6efd">
                        <div class="pe-sec__h"><span class="oi oi-eye"></span> وضعیت فروش <i>قابل فروش بودن و نمایش ویژه</i></div>
                        <div class="d-flex gap-4 flex-wrap align-items-center">
                            <div class="form-check form-switch m-0">
                                <InputCheckbox @bind-Value="model.IsAvailable" class="form-check-input" id="isAvailable" />
                                <label class="form-check-label fw-bold" for="isAvailable">قابل فروش</label>
                            </div>
                            <div class="form-check form-switch m-0">
                                <InputCheckbox @bind-Value="model.IsFeatured" class="form-check-input" id="isFeatured" />
                                <label class="form-check-label fw-bold" for="isFeatured">محصول مهم (نمایش در هیرو و صفحه اصلی)</label>
                            </div>
                            <div class="form-check form-switch m-0">
                                <InputCheckbox @bind-Value="model.IsDraft" class="form-check-input" id="isDraft" />
                                <label class="form-check-label fw-bold" for="isDraft">پیش‌نویس (عدم نمایش در فروشگاه)</label>
                            </div>
                        </div>
                        <div class="text-muted small mt-2">
                            با روشن‌کردن «پیش‌نویس»، محصول در فروشگاه برای مشتری نمایش داده نمی‌شود و قابل سفارش نیست، اما در همین لیست مدیریت باقی می‌ماند. پیش‌فرض خاموش است.
                        </div>
                        <div class="mt-3" style="max-width:280px">
                            <label class="form-label fw-bold mb-1">اولویت نمایش (ترتیب دلخواه)</label>
                            <InputNumber @bind-Value="model.SortOrder" class="form-control rounded-3" />
                            <div class="text-muted small mt-1">عدد کوچک‌تر در «ترتیب دلخواه مدیر» جلوتر نمایش داده می‌شود؛ پیش‌فرض ۰.</div>
                        </div>
                    </div>
                    <div class="pe-sec" style="--acc:#f59e0b">
                        <div class="pe-sec__h"><span class="oi oi-box"></span> موجودی انبار <i>تعداد قابل عرضه</i></div>
                        <div class="mb-0">
                            <label class="form-label fw-bold">موجودی انبار (تعداد)</label>
                            <InputNumber @bind-Value="model.StockQuantity" class="form-control rounded-3" min="0" />
                            <div class="text-muted small mt-1">در صورت ۰ بودن، محصول به صورت خودکار غیرفعال می‌شود.</div>
                        </div>
                    </div>
                    <div class="pe-sec" style="--acc:#0ea5e9">
                        <div class="pe-sec__h"><span class="oi oi-truck"></span> زمان ارسال <i>متن نمایشی زیر قیمت در صفحه محصول</i></div>
                        <div class="mb-0">
                            <label class="form-label fw-bold">مهلت / زمان تقریبی ارسال</label>
                            <InputText @bind-Value="model.EstimatedDeliveryText" maxlength="300" class="form-control rounded-3" placeholder="@StoreDefaults.DeliveryEta" />
                            <div class="text-muted small mt-1">این متن زیر «زمان تقریبی تحویل» در صفحهٔ محصول نمایش داده می‌شود؛ اگر خالی باشد متن پیش‌فرض نمایش داده می‌شود.</div>
                        </div>
                    </div>
                </div>

                <div class="pe-footer mt-4 pt-3 border-top">
                    <div class="pe-footer__nav">
                        @if (_tab > 0)
                        {
                            <button type="button" class="pe-step pe-step--prev" @onclick="() => GoStep(_tab - 1)">
                                <svg class="pe-step__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6" /></svg>
                                <span class="pe-step__txt">
                                    <span class="pe-step__cap">مرحلهٔ قبل · @FaNum(_tab)</span>
                                    <span class="pe-step__title">@TabTitles[_tab - 1]</span>
                                </span>
                            </button>
                        }
                        @if (_tab < TabTitles.Length - 1)
                        {
                            <button type="button" class="pe-step pe-step--next" @onclick="() => GoStep(_tab + 1)">
                                <span class="pe-step__txt">
                                    <span class="pe-step__cap">مرحلهٔ بعد · @FaNum(_tab + 2)</span>
                                    <span class="pe-step__title">@TabTitles[_tab + 1]</span>
                                </span>
                                <svg class="pe-step__ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6" /></svg>
                            </button>
                        }
                    </div>
                    <div class="pe-footer__actions">
                        <button type="button" class="btn btn-light rounded-3 px-4" @onclick="CloseEditor">انصراف</button>
                        <button type="submit" class="btn btn-primary rounded-3 px-4" disabled="@(isSaving || isUploading)">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            ذخیره نهایی محصول
                        </button>
                    </div>
                </div>
            </EditForm>
        </div>
    }

    @if (!_editorPage)
    {
    @if (summary != null)
    {
        <div class="shop-kpi mb-4">
            <button type="button" class="shop-kpi__item @(KpiActive("all") ? "shop-kpi__item--active" : "")"
                    @onclick="@(() => ApplyKpi("all"))" title="نمایش همه محصولات (همه فیلترها را پاک می‌کند)">
                <span class="shop-kpi__label">کل محصولات</span>
                <span class="shop-kpi__value">@summary.Total.ToString("N0")</span>
                <span class="shop-kpi__hint">کلیک: نمایش همه</span>
            </button>
            <button type="button" class="shop-kpi__item shop-kpi__item--ok @(KpiActive("available") ? "shop-kpi__item--active" : "")"
                    @onclick="@(() => ApplyKpi("available"))" title="فقط محصولات فعال با موجودی بیشتر از صفر">
                <span class="shop-kpi__label">قابل فروش</span>
                <span class="shop-kpi__value">@summary.Available.ToString("N0")</span>
                <span class="shop-kpi__hint">کلیک: فیلتر روی این‌ها</span>
            </button>
            <button type="button" class="shop-kpi__item shop-kpi__item--danger @(KpiActive("out") ? "shop-kpi__item--active" : "")"
                    @onclick="@(() => ApplyKpi("out"))" title="فقط محصولاتی که موجودی‌شان صفر است">
                <span class="shop-kpi__label">ناموجود (موجودی صفر)</span>
                <span class="shop-kpi__value">@summary.OutOfStock.ToString("N0")</span>
                <span class="shop-kpi__hint">کلیک: فیلتر روی این‌ها</span>
            </button>
            <button type="button" class="shop-kpi__item shop-kpi__item--warn @(KpiActive("low") ? "shop-kpi__item--active" : "")"
                    @onclick="@(() => ApplyKpi("low"))" title="موجودی بیشتر از صفر و حداکثر @summary.LowStockThreshold عدد">
                <span class="shop-kpi__label">موجودی کم (≤ @summary.LowStockThreshold)</span>
                <span class="shop-kpi__value">@summary.LowStock.ToString("N0")</span>
                <span class="shop-kpi__hint">کلیک: فیلتر روی این‌ها</span>
            </button>
            <button type="button" class="shop-kpi__item @(KpiActive("discounted") ? "shop-kpi__item--active" : "")"
                    @onclick="@(() => ApplyKpi("discounted"))" title="فقط محصولاتی که هم‌اکنون تخفیف فعال دارند">
                <span class="shop-kpi__label">تخفیف‌دار (فعال)</span>
                <span class="shop-kpi__value">@summary.Discounted.ToString("N0")</span>
                <span class="shop-kpi__hint">کلیک: فیلتر روی این‌ها</span>
            </button>
            <div class="shop-kpi__item shop-kpi__item--info" title="مجموع ارزش ریالی موجودی انبار بر اساس قیمت فعلی — فقط اطلاع‌رسانی است">
                <span class="shop-kpi__label">ارزش موجودی (تومان)</span>
                <span class="shop-kpi__value">@summary.InventoryValue.ToString("N0")</span>
                <span class="shop-kpi__hint">بدون فیلتر — فقط اطلاعات</span>
            </div>
            <button type="button" class="shop-kpi__item @(summary.EmptyCategoryCount > 0 ? "shop-kpi__item--warn" : "")"
                    @onclick="GoCategories" title="دسته‌بندی‌هایی که هیچ محصولی ندارند — رفتن به مدیریت دسته‌بندی‌ها">
                <span class="shop-kpi__label">دسته‌بندی خالی (بدون محصول)</span>
                <span class="shop-kpi__value">@summary.EmptyCategoryCount.ToString("N0") / @summary.CategoryCount.ToString("N0")</span>
                <span class="shop-kpi__hint">کلیک: رفتن به دسته‌بندی‌ها</span>
            </button>
        </div>
    }

    <div class="admin-toolbar">
        <div class="search-box">
            <svg class="search-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" class="search-box__input" placeholder="جستجوی محصول..." 
                   value="@_searchQuery" @oninput="OnSearchInput" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button class="search-box__clear" @onclick="ClearSearch">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            }
        </div>
                <select class="filter-select" value="@_categoryIdFilter" @onchange="OnCategoryChanged">

            <option value="0">همه دسته‌بندی‌ها</option>

            @if (categories != null)

            {

                @foreach (var c in categories)

                {

                    <option value="@c.Id">@c.Name (@c.ProductCount)</option>

                }

            }

        </select>

        <select class="filter-select" value="@_statusFilter" @onchange="OnStatusChanged">

            <option value="all">همه وضعیت‌ها</option>

            <option value="available">قابل فروش</option>

            <option value="unavailable">ناموجود</option>

        </select>

        <select class="filter-select" value="@_stockFilter" @onchange="OnStockChanged">

            <option value="all">همه سطوح موجودی</option>

            <option value="in">موجودی کافی</option>

            <option value="low">موجودی کم</option>

            <option value="out">صفر</option>

        </select>

        <select class="filter-select" value="@_sort" @onchange="OnSortChanged">

            <option value="newest">جدیدترین</option>

            <option value="oldest">قدیمی‌ترین</option>

            <option value="name_asc">نام (الفبا)</option>

            <option value="price_asc">ارزان‌ترین</option>

            <option value="price_desc">گران‌ترین</option>

            <option value="stock_asc">کمترین موجودی</option>

            <option value="views">پربازدیدترین</option>

        </select>

        <button type="button" class="stock-filter-chip @(_showFeaturedOnly ? "stock-filter-chip--active" : "")" @onclick="ToggleFeaturedFilter">

            <span class="oi oi-@(_showFeaturedOnly ? "check" : "star") me-1"></span>

            فقط مهم‌ها

        </button>

        <button type="button" class="stock-filter-chip @(_onlyDiscounted ? "stock-filter-chip--active" : "")" @onclick="ToggleDiscountedFilter" title="فقط محصولاتی که تخفیف فعال دارند">

            <span class="oi oi-@(_onlyDiscounted ? "check" : "tag") me-1"></span>

            فقط تخفیف‌دار

        </button>

        <button type="button" class="stock-filter-chip" @onclick="ResetFilters" title="حذف همه فیلترها">

            <span class="oi oi-reload me-1"></span>

            پاک‌کردن

        </button>

        @if (products != null)

        {

            <span class="admin-toolbar__count">@products.Count از @totalCount محصول</span>

        }

        <div class="view-switch ms-auto">

            <button type="button" class="view-switch__btn @(_viewMode == "table" ? "view-switch__btn--active" : "")" @onclick="() => ToggleView(false)" title="نمای جدول">

                <span class="oi oi-list"></span>

            </button>

            <button type="button" class="view-switch__btn @(_viewMode == "card" ? "view-switch__btn--active" : "")" @onclick="() => ToggleView(true)" title="نمای کارت">

                <span class="oi oi-grid-three-up"></span>

            </button>

        </div>
    </div>

    @if (_viewMode == "table" && products != null && FilteredProducts.Any())
    {
        <div class="ptable">
            <div class="ptable__head">
                <span>کالا</span>
                <span>دسته‌بندی</span>
                <span>قیمت (تومان)</span>
                <span>موجودی</span>
                <span>وضعیت</span>
                <span>بازدید</span>
                <span>عملیات</span>
            </div>
            @foreach (var prod in FilteredProducts)
            {
                <div class="ptable__row @(prod.IsDraft ? "ptable__row--draft" : "")">
                    <div class="ptable__cell ptable__cell--product">
                        <div class="ptable__thumb">
                            @if (!string.IsNullOrEmpty(prod.MainImageUrl))
                            {
                                <img src="@prod.MainImageUrl" onerror="this.src='/images/placeholder-product.svg'" />
                            }
                        </div>
                        <div class="ptable__meta">
                            <div class="ptable__name">@prod.Name</div>
                            <div class="ptable__sub">#@prod.Id@(!string.IsNullOrWhiteSpace(prod.Sku) ? $" · {prod.Sku}" : "")</div>
                        </div>
                    </div>
                    <div class="ptable__cell ptable__cell--cat">@(string.IsNullOrWhiteSpace(prod.CategoryName) ? "—" : prod.CategoryName)</div>
                    <div class="ptable__cell ptable__cell--price">
                        <svg class="ptable__price-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.83z" />
                            <circle cx="7" cy="7" r="1.5" />
                        </svg>
                        @if (DiscountHelper.IsActive(prod))
                        {
                            <span class="ptable__old">@prod.Price.ToString("N0")</span>
                            <span class="ptable__now">@DiscountHelper.GetEffectivePrice(prod).ToString("N0")<span class="ptable__unit"> تومان</span></span>
                        }
                        else
                        {
                            <span class="ptable__now">@prod.Price.ToString("N0")<span class="ptable__unit"> تومان</span></span>
                        }
                    </div>
                    <div class="ptable__cell ptable__cell--stock">
                        <span class="ptable__lbl">موجودی: </span>
                        <span class="stock-pill @(prod.StockQuantity <= 0 ? "stock-pill--out" : prod.StockQuantity <= 5 ? "stock-pill--low" : "stock-pill--ok")">@prod.StockQuantity</span>
                    </div>
                    <div class="ptable__cell ptable__cell--status">
                        @if (prod.IsDraft)
                        {
                            <span class="badge bg-secondary rounded-pill" title="پیش‌نویس — در فروشگاه نمایش داده نمی‌شود">پیش‌نویس</span>
                        }
                        else
                        {
                            <span class="product-card__status @(prod.IsAvailable ? "status-available" : "status-unavailable")">@(prod.IsAvailable ? "موجود" : "ناموجود")</span>
                        }
                    </div>
                    <div class="ptable__cell ptable__cell--views"><span class="ptable__lbl">بازدید: </span>@prod.ViewCount.ToString("N0")</div>
                    <div class="ptable__cell ptable__cell--actions">
                        <button class="btn-icon btn-icon--edit" title="ویرایش" @onclick="() => EditProduct(prod)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </button>
                        <button class="btn-icon btn-icon--delete" title="حذف" @onclick="() => DeleteProduct(prod)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                <line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        </div>
    }

    <div class="product-grid @((_viewMode == "table" && FilteredProducts.Any()) ? "product-grid--hidden" : "")">
        @if (products == null)
        {
            <div class="product-grid__empty">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (!products.Any())
        {
            <div class="product-grid__empty">
                <span class="oi oi-cart" style="font-size: 2rem; opacity: 0.3;"></span>
                <p class="text-muted mt-2 mb-0">هیچ محصولی یافت نشد.</p>
            </div>
        }
        else if (!FilteredProducts.Any())
        {
            <div class="product-grid__empty">
                <span class="oi oi-magnifying-glass" style="font-size: 2rem; opacity: 0.3;"></span>
                <p class="text-muted mt-2 mb-0">محصولی با این عبارت یافت نشد.</p>
            </div>
        }
        else
        {
            @foreach (var prod in FilteredProducts)
            {
                <div class="product-card @(prod.IsDraft ? "product-card--draft" : "")">
                    <div class="product-card__top">
                        <div class="product-card__thumb">
                            @if (!string.IsNullOrEmpty(prod.MainImageUrl))
                            {
                                <img src="@prod.MainImageUrl" onerror="this.src='/images/placeholder-product.svg'" />
                            }
                            else
                            {
                                <div class="product-card__thumb--empty">
                                    <span class="oi oi-image"></span>
                                </div>
                            }
                        </div>
                        <div class="product-card__info">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <div class="product-card__name">@prod.Name</div>
                                @if (prod.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill" title="محصول مهم">
                                        <span class="oi oi-star"></span> مهم
                                    </span>
                                }
                                @if (prod.IsDraft)
                                {
                                    <span class="badge bg-secondary rounded-pill" title="پیش‌نویس — در فروشگاه نمایش داده نمی‌شود">
                                        <span class="oi oi-pencil"></span> پیش‌نویس
                                    </span>
                                }
                            </div>
                            <div class="product-card__id">کد: #@prod.Id@(!string.IsNullOrWhiteSpace(prod.Sku) ? $" • {prod.Sku}" : "")</div>
                            <div class="product-card__views"><span class="oi oi-eye"></span> @prod.ViewCount.ToString("N0") بازدید</div>
                        </div>
                        <span class="product-card__status @(prod.IsAvailable ? "status-available" : "status-unavailable")">
                            @(prod.IsAvailable ? $"موجود ({prod.StockQuantity} عدد)" : "ناموجود")
                        </span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__row">
                            <span class="product-card__label">دسته‌بندی</span>
                            <span class="product-card__value">@prod.CategoryName</span>
                        </div>
                        <div class="product-card__row">
                            <span class="product-card__label">قیمت</span>
                            <span class="product-card__value">
                                @if (DiscountHelper.IsActive(prod))
                                {
                                    <span class="text-decoration-line-through text-muted ms-2" style="font-size:0.75rem;">@prod.Price.ToString("N0")</span>
                                    <span class="fw-bold text-success">@DiscountHelper.GetEffectivePrice(prod).ToString("N0") <small>تومان</small></span>
                                }
                                else
                                {
                                    <span class="fw-bold">@prod.Price.ToString("N0") <small>تومان</small></span>
                                }
                            </span>
                        </div>
                        <div class="product-card__row">
                            <span class="product-card__label">تخفیف</span>
                            <span class="product-card__value">
                                @if (DiscountHelper.IsTimedActive(prod))
                                {
                                    <span class="badge bg-primary rounded-pill">زمان‌دار تا @prod.DiscountExpiryDate!.Value.ToString("yyyy/MM/dd HH:mm")</span>
                                }
                                else if (DiscountHelper.IsPermanentActive(prod))
                                {
                                    <span class="badge bg-info text-dark rounded-pill">دائمی</span>
                                }
                                else if (DiscountHelper.IsExpired(prod))
                                {
                                    <span class="badge bg-danger rounded-pill">منقضی</span>
                                }
                                else if (DiscountHelper.IsScheduled(prod))
                                {
                                    <span class="badge bg-secondary rounded-pill">شروع نشده</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="product-card__actions">
                        <button class="btn-icon btn-icon--edit" title="ویرایش" @onclick="() => EditProduct(prod)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </button>
                        <button class="btn-icon btn-icon--delete" title="حذف" @onclick="() => DeleteProduct(prod)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                <line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        }
    </div>

    @if (products != null && products.Any() && TotalPages > 1)
    {
        <div class="pager">
            <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="() => GoPage(page - 1)" disabled="@(page <= 1 || isLoadingMore)">
                <span class="oi oi-chevron-left"></span> قبلی
            </button>
            <span class="pager__info">صفحه @(page) از @(TotalPages)</span>
            <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="() => GoPage(page + 1)" disabled="@(page >= TotalPages || isLoadingMore)">
                بعدی <span class="oi oi-chevron-right"></span>
            </button>
        </div>
    }
    }
</div>

<style>
    .object-fit-cover { object-fit: cover; }
