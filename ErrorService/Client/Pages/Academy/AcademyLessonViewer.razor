@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int LessonId { get; set; }

    private TrainingLessonDto? lesson;
    private string courseTitle = "...";
    private bool isLoading = true;
    private bool isForbidden;
    private bool plyrInitialized;
    private string? lessonJsonLd;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (lesson != null && !isLoading && !plyrInitialized)
        {
            await Task.Delay(500); // Give time for DOM to settle
            try
            {
                await JS.InvokeVoidAsync("lazyVideoLoader.observe");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"LazyVideoLoader Error: {ex.Message}");
            }
            await JS.InvokeVoidAsync("initPlyr", ".js-plyr");
            await JS.InvokeVoidAsync("initLessonLightbox");
            plyrInitialized = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            plyrInitialized = false;
            isForbidden = false;

            var lessonResp = await Http.GetAsync($"api/trainings/lessons/{LessonId}");
            if (lessonResp.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                isForbidden = true;
                lesson = null;
            }
            else             if (lessonResp.IsSuccessStatusCode)
            {
                lesson = await lessonResp.Content.ReadFromJsonAsync<TrainingLessonDto>();
                BuildLessonJsonLd();
            }
            else
            {
                lesson = null;
            }
            
            // Get course title for breadcrumb
            var course = await Http.GetFromJsonAsync<TrainingCourseDto>($"api/trainings/courses/{CourseId}");
            courseTitle = course?.Title ?? "دوره";
        }
        catch { }
        finally { isLoading = false; }
    }

    private string? GetPlayableUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return url;
        if (url.StartsWith("/api/trainings/media/", StringComparison.OrdinalIgnoreCase)) return url;

        // Backward compatibility: old uploads path
        var prefix = "/uploads/academy/";
        if (url.StartsWith(prefix, StringComparison.OrdinalIgnoreCase))
        {
            var fileName = url.Substring(prefix.Length);
            fileName = fileName.Split('?', '#')[0];
            return $"/api/trainings/media/{fileName}";
        }

        return url;
    }

    private static string GetVideoMime(string? url)
    {
        var ext = GetExt(url);
        return ext switch
        {
            ".mp4" => "video/mp4",
            ".webm" => "video/webm",
            ".ogv" => "video/ogg",
            ".avi" => "video/x-msvideo",
            ".mov" => "video/quicktime",
            ".mkv" => "video/x-matroska",
            ".ts" => "application/vnd.apple.mpegurl",
            ".m3u8" => "application/vnd.apple.mpegurl",
            _ => "video/mp4"
        };
    }

    private static string GetAudioMime(string? url)
    {
        var ext = GetExt(url);
        return ext switch
        {
            ".wav" => "audio/wav",
            ".ogg" => "audio/ogg",
            _ => "audio/mpeg"
        };
    }

    private static string GetExt(string? url)
    {
        if (string.IsNullOrWhiteSpace(url)) return string.Empty;
        var clean = url.Split('?', '#')[0];
        return Path.GetExtension(clean).ToLowerInvariant();
    }

    private static List<LessonBlockGroup> BuildBlockGroups(IEnumerable<TrainingBlockDto> blocks)
    {
        var groups = new List<LessonBlockGroup>();
        foreach (var block in blocks.OrderBy(x => x.SortOrder))
        {
            if (block.BlockType == TrainingBlockTypeDto.Text
                || groups.Count == 0
                || groups[^1].Type != block.BlockType)
            {
                groups.Add(new LessonBlockGroup
                {
                    Type = block.BlockType,
                    Blocks = new List<TrainingBlockDto> { block }
                });
            }
            else
            {
                groups[^1].Blocks.Add(block);
            }
        }
        return groups;
    }

    private sealed class LessonBlockGroup
    {
        public TrainingBlockTypeDto Type { get; set; }
        public List<TrainingBlockDto> Blocks { get; set; } = new();
        public int Key => Blocks.Count > 0 ? Blocks[0].Id : 0;
    }

    private void BuildLessonJsonLd()
    {
        if (lesson == null) return;

        var baseUrl = "https://errorservice.ir";
        var url = $"{baseUrl}/academy/{CourseId}/{LessonId}";

        var learningResource = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "LearningResource",
            ["name"] = lesson.Title,
            ["description"] = lesson.Summary ?? lesson.Title,
            ["url"] = url,
            ["learningResourceType"] = "Lesson",
            ["isPartOf"] = new Dictionary<string, object?>
            {
                ["@type"] = "Course",
                ["name"] = lesson.CourseTitle ?? courseTitle,
                ["url"] = $"{baseUrl}/academy/{CourseId}"
            }
        };

        var breadcrumbList = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new object[]
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = baseUrl },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "آکادمی", ["item"] = $"{baseUrl}/academy" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = lesson.CourseTitle ?? courseTitle, ["item"] = $"{baseUrl}/academy/{CourseId}" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 4, ["name"] = lesson.Title, ["item"] = url }
            }
        };

        lessonJsonLd = $"[{JsonSerializer.Serialize(learningResource)},{JsonSerializer.Serialize(breadcrumbList)}]";
    }
}
