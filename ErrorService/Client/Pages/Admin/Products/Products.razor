        /* موبایل: فوتر مرحله‌ای تمام‌عرض — ردیف اول مرحله قبل/بعد، ردیف دوم انصراف/ذخیره */
        .pe-footer { flex-direction: column; align-items: stretch; gap: 10px; }
        .pe-footer__nav { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
