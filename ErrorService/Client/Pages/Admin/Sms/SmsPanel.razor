                                        <div class="sms-charge-card__receipt">
                                            <a href="@ch.ReceiptFilePath" target="_blank" class="btn btn-sm btn-outline-info">
                                                <span class="oi oi-eye"></span> رسید پرداخت
                                            </a>
                                        </div>
                                    }
                                    <div class="sms-charge-card__row sms-charge-card__meta">
                                        <span>@PersianDateHelper.ToPersianDateTimeString(ch.CreatedAt.ToLocalTime(), true)</span>
                                        @if (ch.ReviewedBy != null)
                                        {
                                            <span>توسط: @ch.ReviewedBy</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(ch.ReviewNote))
                                    {
                                        <div class="sms-charge-card__desc@(ch.Status == 2 ? " sms-charge-card__desc--rejected" : "")">@ch.ReviewNote</div>
                                    }
                                </div>
                            }
                        </div>
                        @if (_myCharges.Count == 0)
                        {
                            <div class="sms-empty">هیچ درخواستی ثبت نشده است.</div>
                        }
                        @if (_totalMyCharges > _myChargePage * _myChargePageSize)
                        {
                            <button class="btn btn-outline-primary w-100 mt-2" @onclick="LoadMoreMyCharges" disabled="@_loadingMyCharges">
                                بارگذاری بیشتر
                            </button>
                        }
                    }
                </div>
            }
        </div>

        <!-- Reject reason modal -->
        @if (_showRejectModal)
        {
            <div class="sms-modal-overlay" @onclick="CloseRejectModal">
                <div class="sms-modal" @onclick:stopPropagation>
                    <div class="sms-modal__header">
                        <h3>دلیل رد شارژ</h3>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CloseRejectModal">✕</button>
                    </div>
                    <div class="sms-modal__body">
                        <div class="sms-form__group">
                            <label class="sms-form__label">دلیل رد را وارد کنید</label>
                            <textarea class="sms-input sms-input--textarea" rows="3"
                                      @bind="_rejectReason" @bind:event="oninput" placeholder="دلیل رد شارژ (اختیاری)"></textarea>
                        </div>
                    </div>
                    <div class="sms-modal__footer">
                        <button class="btn btn-outline-secondary" @onclick="CloseRejectModal">انصراف</button>
                        <button class="btn btn-danger" @onclick="ConfirmReject">تایید و رد شارژ</button>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Tab: Logs -->
    @if (activeTab == "logs")
    {
        <div class="sms-section">
            @if (_isAdminLogs)
            {
                <!-- Admin view: all logs -->
                <div class="sms-table-toolbar sms-table-toolbar--wrap">
                    <input type="text" class="sms-input sms-input--search" placeholder="نام کارگاه..." bind="@_logWorkshopSearch" />
                    <select class="sms-input sms-input--select" @bind="@_logModuleFilter" @bind:after="LoadAdminLogs">
                        <option value="">همه ماژول‌ها</option>
                        <option value="1">ثبت سفارش</option>
                        <option value="2">آماده تحویل</option>
                        <option value="3">غیر قابل تعمیر</option>
                        <option value="4">کار جدید تکنسین</option>
                    </select>
                    <select class="sms-input sms-input--select" @bind="@_logStatusFilter" @bind:after="LoadAdminLogs">
                        <option value="-1">همه وضعیت‌ها</option>
                        <option value="0">در انتظار</option>
                        <option value="1">ارسال شده</option>
                        <option value="2">ناموفق</option>
                    </select>
                    <button class="sms-btn sms-btn--check" @onclick="CheckDeliveryStatus" disabled="@_checkingDelivery">
                        @if (_checkingDelivery) { <span class="spinner-border spinner-border-sm"></span> }
                        <span class="oi oi-loop-circular"></span>
                        بررسی وضعیت ارسال
                    </button>
                </div>
                @if (_deliveryCheckResult != null)
                {
                    <div class="sms-delivery-check-result">
                        <span class="oi oi-check"></span>
                        بررسی شد: @_deliveryCheckResult.Checked | به‌روزرسانی: @_deliveryCheckResult.Updated | خطا: @_deliveryCheckResult.Errors
                    </div>
                }
                @if (_loadingLogs)
                {
                    <div class="sms-loading">در حال بارگذاری...</div>
                }
                else
                {
                    @foreach (var log in _logs)
                    {
                        <div class="sms-log-card">
                            <div class="sms-log-card__header">
                                <span class="sms-log-card__workshop">@log.WorkshopName</span>
                                @if (log.ModuleTitle != null)
                                {
                                    <span class="sms-badge sms-badge--info">@log.ModuleTitle</span>
                                }
                            </div>
                            <div class="sms-log-card__recipient">
                                <span class="oi oi-phone"></span>
                                <span dir="ltr">@log.RecipientNumber</span>
                            </div>
                            <div class="sms-log-card__text">@log.MessageText</div>
                            <div class="sms-log-card__footer">
                                <span class="sms-badge sms-badge--@(log.SendStatus == "ارسال شده" ? "success" : log.SendStatus == "ناموفق" ? "danger" : "warn")">
                                    @log.SendStatus
                                </span>
                                <span class="sms-badge sms-badge--delivery sms-badge--@GetDeliveryBadgeClass(log.DeliveryStatus)">
                                    @GetDeliveryStatusText(log.DeliveryStatus)
                                </span>
                                <span class="sms-log-card__date">@PersianDateHelper.ToPersianDateTimeString(log.CreatedAt.ToLocalTime(), true)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(log.ErrorMessage))
