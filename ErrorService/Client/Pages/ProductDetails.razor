    private async Task SubmitReply(int questionId)
    {
        if (product == null || _replySending) return;
        var text = _replyText.Trim();
        if (text.Length < 3) return;

        if (!_isAuthenticated)
        {
            Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}");
            return;
        }

        _replySending = true;
        try
        {
            var resp = await HttpApi.PostAsJsonAsync($"api/products/{product.Id}/questions/{questionId}/reply",
                new ProductQuestionReplyRequest { Body = text });
            if (resp.IsSuccessStatusCode)
            {
                string message = "پاسخ شما ثبت شد";
                try
                {
                    var payload = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (payload.TryGetProperty("message", out var m) && m.ValueKind == System.Text.Json.JsonValueKind.String)
                        message = m.GetString() ?? message;
                }
                catch { }

                ToastService.ShowSuccess(message);
                CancelReply();
                await LoadQuestions();
            }
            else
            {
                ToastService.ShowError("خطا در ثبت پاسخ");
            }
        }
        catch (Exception ex) { ToastService.ShowError($"خطای سیستمی: {ex.Message}"); }
        finally { _replySending = false; }
    }

