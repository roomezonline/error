    }

    private void OpenLightbox(string? url) => _lightboxUrl = url;

    private void SetFilter(string filter)
    {
        _activeFilter = filter;
        if (filter == "all") _newSessionCount = 0;
    }

    private string FormatTime(DateTime dt)
    {
        var local = dt.ToLocalTime();
        var diff = DateTime.Now - local;
        if (diff.TotalMinutes < 1) return "الان";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}p";
        if (diff.TotalDays < 1) return local.ToString("HH:mm");
        return local.ToString("MM/dd HH:mm");
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_hub != null) await _hub.DisposeAsync();
    }
}
