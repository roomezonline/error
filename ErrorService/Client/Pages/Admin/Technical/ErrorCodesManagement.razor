    private ErrorCode? duplicateMatch
    {
        get
        {
            if (string.IsNullOrWhiteSpace(editingItem.Brand) ||
                string.IsNullOrWhiteSpace(editingItem.DeviceType) ||
                string.IsNullOrWhiteSpace(editingItem.Code))
                return null;

            var b = editingItem.Brand.Trim();
            var d = editingItem.DeviceType.Trim();
            var c = editingItem.Code.Trim();

            return errorCodes.FirstOrDefault(x =>
                x.Id != editingItem.Id &&
                string.Equals(x.Brand?.Trim(), b, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(x.DeviceType?.Trim(), d, StringComparison.OrdinalIgnoreCase) &&
                string.Equals(x.Code?.Trim(), c, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<ErrorCode> RelatedSubsetCodes
    {
        get
        {
            if (string.IsNullOrWhiteSpace(editingItem.Brand) ||
                string.IsNullOrWhiteSpace(editingItem.DeviceType))
                return Enumerable.Empty<ErrorCode>();

            var b = editingItem.Brand.Trim();
            var d = editingItem.DeviceType.Trim();

            return errorCodes
                .Where(x =>
                    string.Equals(x.Brand?.Trim(), b, StringComparison.OrdinalIgnoreCase) &&
                    string.Equals(x.DeviceType?.Trim(), d, StringComparison.OrdinalIgnoreCase))
                .OrderBy(x => x.Code, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
    }

    private async Task LoadRelatedIntoModal(ErrorCode item)
    {
        if (item.Id == editingItem.Id) return;
        OpenModal(item);
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync() => await LoadData();

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private string TruncateText(string text, int max) =>
        text.Length <= max ? text : text[..max] + "...";

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(280, token);
            if (!token.IsCancellationRequested)
            {
                FilterList();
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

    private void FilterList()
    {
        IEnumerable<ErrorCode> query = errorCodes;

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            var q = searchQuery.Trim().ToLowerInvariant();
            query = query.Where(x =>
                (x.Brand != null && x.Brand.ToLowerInvariant().Contains(q)) ||
                (x.DeviceType != null && x.DeviceType.ToLowerInvariant().Contains(q)) ||
                (x.Code != null && x.Code.ToLowerInvariant().Contains(q)) ||
                (x.Description != null && x.Description.ToLowerInvariant().Contains(q)));
        }

        if (!string.IsNullOrEmpty(filterBrand))
            query = query.Where(x => string.Equals(x.Brand?.Trim(), filterBrand, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(filterDevice))
            query = query.Where(x => string.Equals(x.DeviceType?.Trim(), filterDevice, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrEmpty(filterCategory))
            query = query.Where(x => string.Equals(x.Category?.Trim(), filterCategory, StringComparison.OrdinalIgnoreCase));

        filteredCodes = query.ToList();

        groupedFiltered = filteredCodes
            .GroupBy(x => string.IsNullOrWhiteSpace(x.Category) ? "بدون دسته‌بندی" : x.Category.Trim(), StringComparer.OrdinalIgnoreCase)
            .OrderBy(g => string.Equals(g.Key, "بدون دسته‌بندی", StringComparison.OrdinalIgnoreCase) ? 1 : 0)
            .ThenBy(g => g.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Drop collapse state for categories that no longer exist
        var keys = groupedFiltered.Select(g => g.Key).ToHashSet(StringComparer.OrdinalIgnoreCase);
        collapsedCategories.RemoveWhere(k => !keys.Contains(k));

        resultCount = filteredCodes.Count;
        brandCount = filteredCodes
            .Select(x => (x.Brand ?? "").Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();
        deviceCount = filteredCodes
            .Select(x => (x.DeviceType ?? "").Trim())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Count();

        if (visibleGroupLimit < 20) visibleGroupLimit = 20;
    }

    private bool IsCategoryCollapsed(string key) => collapsedCategories.Contains(key);

    private void ToggleCategory(string key)
    {
        if (!collapsedCategories.Remove(key))
            collapsedCategories.Add(key);
    }

    private void ToggleCollapseAll()
    {
        if (allCollapsed)
        {
            collapsedCategories.Clear();
        }
        else
        {
            foreach (var g in groupedFiltered)
                collapsedCategories.Add(g.Key);
        }
    }

    private void ResetFilters()
    {
        filterBrand = "";
        filterDevice = "";
        filterCategory = "";
        searchQuery = "";
        FilterList();
    }

    private void ClearSearch()
    {
        searchQuery = "";
        FilterList();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var codesTask = Http.GetFromJsonAsync<List<ErrorCode>>("api/technical/error-codes");
            var brandTask = Http.GetFromJsonAsync<List<ErrorCodeCatalogItem>>("api/technical/error-codes/catalog?kind=Brand");
            var deviceTask = Http.GetFromJsonAsync<List<ErrorCodeCatalogItem>>("api/technical/error-codes/catalog?kind=DeviceType");
            var catTask = Http.GetFromJsonAsync<List<ErrorCodeCatalogItem>>("api/technical/error-codes/catalog?kind=Category");

            await Task.WhenAll(codesTask, brandTask, deviceTask, catTask);

            errorCodes = await codesTask ?? new();
            brandCatalog = await brandTask ?? new();
            deviceCatalog = await deviceTask ?? new();
            categoryCatalog = await catTask ?? new();

            // Fallback: ensure any value used on codes appears in catalogs (in case API missed sync)
            MergeCatalogFromCodes(ErrorCodeCatalogKind.Brand, errorCodes.Select(x => x.Brand), brandCatalog);
            MergeCatalogFromCodes(ErrorCodeCatalogKind.DeviceType, errorCodes.Select(x => x.DeviceType), deviceCatalog);
            MergeCatalogFromCodes(ErrorCodeCatalogKind.Category, errorCodes.Select(x => x.Category), categoryCatalog);

            availableBrands = brandCatalog.Select(x => x.Name).ToList();
            availableDevices = deviceCatalog.Select(x => x.Name).ToList();
            availableCategories = categoryCatalog.Select(x => x.Name).ToList();

            brandSuggestions = availableBrands;
            deviceSuggestions = availableDevices;

            FilterList();
        }
        catch
        {
            Toast.ShowError("خطا در بارگذاری اطلاعات");
        }
        isLoading = false;
    }

    private static void MergeCatalogFromCodes(ErrorCodeCatalogKind kind, IEnumerable<string?> values, List<ErrorCodeCatalogItem> catalog)
    {
        foreach (var raw in values)
        {
            var v = (raw ?? "").Trim();
            if (v.Length == 0) continue;
            if (!catalog.Any(x => string.Equals(x.Name, v, StringComparison.OrdinalIgnoreCase)))
                catalog.Add(new ErrorCodeCatalogItem { Kind = kind, Name = v, UsageCount = 0, Id = 0 });
        }
        catalog.Sort((a, b) => string.Compare(a.Name, b.Name, StringComparison.OrdinalIgnoreCase));
    }

    private bool HasCatalogItem(ErrorCodeCatalogKind kind, string name) =>
        GetCatalogList(kind).Any(x => string.Equals(x.Name, name, StringComparison.OrdinalIgnoreCase));

    private ErrorCodeCatalogItem? FindCatalogItem(ErrorCodeCatalogKind kind, string name) =>
        GetCatalogList(kind).FirstOrDefault(x => string.Equals(x.Name, name, StringComparison.OrdinalIgnoreCase));

    private List<ErrorCodeCatalogItem> GetCatalogList(ErrorCodeCatalogKind kind) => kind switch
    {
        ErrorCodeCatalogKind.Brand => brandCatalog,
        ErrorCodeCatalogKind.DeviceType => deviceCatalog,
        _ => categoryCatalog
    };

    private static string CatalogKindTitle(ErrorCodeCatalogKind kind, bool singular) => kind switch
    {
        ErrorCodeCatalogKind.Brand => singular ? "برند جدید" : "ویرایش برند",
        ErrorCodeCatalogKind.DeviceType => singular ? "نوع دستگاه جدید" : "ویرایش نوع دستگاه",
        _ => singular ? "دسته‌بندی جدید" : "ویرایش دسته‌بندی"
    };

    private static string CatalogKindLabel(ErrorCodeCatalogKind kind) => kind switch
    {
        ErrorCodeCatalogKind.Brand => "برند",
        ErrorCodeCatalogKind.DeviceType => "نوع دستگاه",
        _ => "دسته‌بندی"
    };

