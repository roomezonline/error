    }

    private static string FormatDuration(int sec)
    {
        sec = Math.Max(0, sec);
        return $"{sec / 60}:{sec % 60:00}";
    }

    private void HandleTyping()
    {
        if (_hub == null || _sessionId == 0) return;
        if ((DateTime.UtcNow - _lastTypingSent).TotalSeconds > 2)
        {
            _ = _hub.InvokeAsync("Typing", _sessionId, true);
            _lastTypingSent = DateTime.UtcNow;
        }
    }

    private void OnInputChanged(ChangeEventArgs e)
    {
        _inputText = e.Value?.ToString() ?? "";
        HandleTyping();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_inputText))
            await SendText();
    }

    private async Task ScrollToBottom()
    {
        await Task.Delay(50);
        await JS.InvokeVoidAsync("__chatScrollToBottom", ".chat-body");
    }

    private void OpenImage(string? url) => _lightboxUrl = url;
    private void CloseLightbox() => _lightboxUrl = null;

    private bool ShouldShowDateSeparator(ChatMessageDto msg)
    {
        var idx = _messages.IndexOf(msg);
        if (idx <= 0) return true;
        return _messages[idx - 1].CreatedAt.ToLocalTime().Date != msg.CreatedAt.ToLocalTime().Date;
    }

    private static string DateSeparatorText(DateTime dt)
    {
        var local = dt.ToLocalTime();
        if (local.Date == DateTime.Today) return "امروز";
        if (local.Date == DateTime.Today.AddDays(-1)) return "دیروز";
        return local.ToString("yyyy/MM/dd");
    }

    private static bool IsOpLike(ChatMessageDto m) =>
        m.SenderType == ChatSenderTypeDto.System ||
        (m.SenderType == ChatSenderTypeDto.Operator && m.SenderId != null && !m.SenderId.StartsWith("اپراتور ("));

    private static bool IsUserLike(ChatMessageDto m) =>
        m.SenderType == ChatSenderTypeDto.User ||
        (m.SenderType == ChatSenderTypeDto.Operator && m.SenderId != null && m.SenderId.StartsWith("اپراتور ("));

    private static string LinkifyContent(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        var escaped = System.Net.WebUtility.HtmlEncode(content);
        return System.Text.RegularExpressions.Regex.Replace(
            escaped,
            @"(https?://[^\s<>""']+)",
            "<a href=\"$1\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:inherit;text-decoration:underline;\">$1</a>");
    }

    private void SetRating(int val)
    {
        _ratingValue = val;
    }

    private async Task SubmitRating()
    {
        if (_ratingValue == 0 || _lastSessionId == 0) return;
        try
        {
            await Http.PostAsJsonAsync($"api/Chat/sessions/{_lastSessionId}/rate?visitorId={await GetVisitorId()}", new { rating = _ratingValue, comment = _ratingComment });
            _showRating = false;
        }
        catch { }
    }

    private async Task RestartChat()
    {
        _messages.Clear();
        _sessionId = 0;
        _status = ChatWidgetStatus.UserInfo;
        _statusMessage = null;
        _operatorRequested = false;
    }

    private async Task<string> GetVisitorId()
    {
        var id = await JS.InvokeAsync<string>("localStorage.getItem", "chat_visitor_id");
        if (string.IsNullOrEmpty(id))
        {
            id = Guid.NewGuid().ToString("N");
            await JS.InvokeVoidAsync("localStorage.setItem", "chat_visitor_id", id);
        }
        return id;
    }

    public void Dispose()
    {
        _hub?.DisposeAsync().AsTask().ConfigureAwait(false);
    }
