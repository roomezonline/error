@page "/auth/forgot-password"
@using ErrorService.Shared
@inject ErrorService.Client.Services.AuthService Auth
@inject NavigationManager Nav
@inject ErrorService.Client.Services.ToastService Toast

<PageTitle>بازیابی رمز عبور | ارورسرویس</PageTitle>

<div class="container py-5 d-flex justify-content-center align-items-center min-vh-80" dir="rtl">
    <div class="auth-card p-4 rounded-5 shadow-lg bg-white w-100" style="max-width: 430px;">
        <div class="text-center mb-4">
            <div class="auth-logo mb-3">
                <span class="oi oi-key text-warning display-4"></span>
            </div>
            <h3 class="fw-black mb-1">بازیابی رمز عبور</h3>
            <p class="text-muted small">با شماره موبایل و کد تایید، رمز جدید تعیین کنید</p>
        </div>

        @if (isLoading)
        {
            <div class="text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (config != null && !config.PasswordResetOtpEnabled)
        {
            <div class="alert alert-warning rounded-4 small">
                بازیابی رمز عبور با کد تایید در حال حاضر غیرفعال است. لطفاً با پشتیبانی تماس بگیرید.
            </div>
            <a href="/auth/login" class="btn btn-outline-secondary w-100 rounded-pill">بازگشت به ورود</a>
        }
        else if (step == 1)
        {
            <div class="mb-3">
                <label class="form-label small fw-bold">شماره موبایل</label>
                <input class="form-control auth-input rounded-pill px-4 py-2 ltr" dir="ltr" inputmode="tel" maxlength="11" @bind="model.PhoneNumber" placeholder="09xxxxxxxxx" />
                <div class="form-text small">کد تایید به شماره‌ای که با آن ثبت‌نام کرده‌اید ارسال می‌شود.</div>
            </div>

            <button type="button" class="btn btn-primary w-100 rounded-pill py-2 fw-bold" @onclick="SendCode" disabled="@(isSending || !IsPhoneValid)">
                @if (isSending) { <span class="spinner-border spinner-border-sm me-2"></span> }
                دریافت کد تایید
            </button>
        }
        else
        {
            <div class="alert alert-light border rounded-4 small mb-3">
                کد تایید برای <span class="fw-bold ltr" dir="ltr">@model.PhoneNumber</span> ارسال شد.
                <a href="javascript:void(0)" class="ms-1 text-decoration-none" @onclick="BackToPhone">ویرایش شماره</a>
            </div>

            <EditForm Model="model" OnValidSubmit="HandleReset">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label small fw-bold">کد تایید</label>
                    <div class="d-flex gap-2">
                        <InputText @bind-Value="model.VerificationCode" class="form-control auth-input rounded-pill px-4 py-2 ltr" inputmode="numeric" maxlength="6" placeholder="کد ۶ رقمی" />
                        <button type="button" class="btn btn-outline-primary rounded-pill px-3 flex-shrink-0" @onclick="SendCode" disabled="@(isSending || cooldownRemaining > 0)">
                            @if (cooldownRemaining > 0)
                            {
                                <span>@cooldownRemaining ثانیه</span>
                            }
                            else
                            {
                                <span>ارسال مجدد</span>
                            }
                        </button>
                    </div>
                    <ValidationMessage For="@(() => model.VerificationCode)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">رمز عبور جدید</label>
                    <InputText @bind-Value="model.NewPassword" type="password" class="form-control auth-input rounded-pill px-4 py-2" placeholder="••••" />
                    <ValidationMessage For="@(() => model.NewPassword)" class="text-danger small" />
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold">تکرار رمز عبور جدید</label>
                    <input type="password" class="form-control auth-input rounded-pill px-4 py-2" @bind="confirmPassword" placeholder="••••" />
                </div>

                <button type="submit" class="btn btn-success w-100 rounded-pill py-2 fw-bold" disabled="@isSubmitting">
                    @if (isSubmitting) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    تغییر رمز عبور
                </button>
            </EditForm>
        }

        <div class="text-center mt-4 border-top pt-3">
            <a href="/auth/login" class="text-primary fw-bold small text-decoration-none">بازگشت به صفحه ورود</a>
        </div>
    </div>
</div>

<style>
    .auth-card { border: 1px solid rgba(0,0,0,0.05); }
    .auth-input { background: #f8fafc; border: 1px solid #e2e8f0; }
    .auth-input:focus { background: #fff; box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.1); }
    .fw-black { font-weight: 900; }
</style>

@code {
    private PasswordResetRequest model = new();
    private AuthPublicConfigDto? config;
    private string confirmPassword = string.Empty;
    private int step = 1;
    private bool isLoading = true;
    private bool isSending;
    private bool isSubmitting;
    private int cooldownRemaining;

    private bool IsPhoneValid =>
        !string.IsNullOrWhiteSpace(model.PhoneNumber) &&
        model.PhoneNumber.Length == 11 &&
        model.PhoneNumber.StartsWith("09");

    protected override async Task OnInitializedAsync()
    {
        config = await Auth.GetPublicConfigAsync();
        isLoading = false;
    }

    private void BackToPhone()
    {
        step = 1;
        model.VerificationCode = string.Empty;
    }

    private async Task SendCode()
    {
        if (!IsPhoneValid)
        {
            Toast.ShowError("شماره موبایل را درست وارد کنید");
            return;
        }

        isSending = true;
        try
        {
            var result = await Auth.SendPasswordResetOtpAsync(model.PhoneNumber);
            if (result.Success)
            {
                step = 2;
                Toast.ShowSuccess(result.Message ?? "کد تایید ارسال شد");
                await StartCooldownAsync(config?.ResendCooldownSeconds ?? 60);
            }
            else
            {
                Toast.ShowError(result.Message ?? "خطا در ارسال کد تایید");
            }
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task HandleReset()
    {
        if (model.NewPassword != confirmPassword)
        {
            Toast.ShowError("رمز عبور و تکرار آن یکسان نیست");
            return;
        }

        isSubmitting = true;
        try
        {
            var (ok, error) = await Auth.ResetPasswordAsync(model);
            if (ok)
            {
                Toast.ShowSuccess("رمز عبور با موفقیت تغییر کرد؛ حالا وارد شوید");
                Nav.NavigateTo("/auth/login");
            }
            else
            {
                Toast.ShowError(error ?? "خطا در تغییر رمز عبور");
            }
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task StartCooldownAsync(int seconds)
    {
        cooldownRemaining = Math.Max(0, seconds);
        while (cooldownRemaining > 0)
        {
            await Task.Delay(1000);
            cooldownRemaining--;
            try
            {
                await InvokeAsync(StateHasChanged);
            }
            catch (ObjectDisposedException)
            {
                return;
            }
        }
    }
}
