    private static bool IsQuillEmpty(string? html)
    {
        if (string.IsNullOrWhiteSpace(html)) return true;
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]*>", string.Empty)
            .Replace("&nbsp;", " ")
            .Trim();
        return text.Length == 0;
    }

    private async Task SaveNews()
    {
        isSaving = true;
        try
        {
            // Get content from Quill editor
            var quillContent = await JS.InvokeAsync<string?>("getQuillContent", "quill-editor-container");
            if (quillContent != null)
            {
                model.Content = IsQuillEmpty(quillContent) ? string.Empty : quillContent;
            }

            if (PersianDate.TryParseJalaliDateTime(createdAtInput, out var createdAt))
                model.CreatedAt = createdAt;
            else
                model.CreatedAt = null;

            model.PublishAt = PersianDate.TryParseJalaliDateTime(_publishAtInput, out var publishAt) ? publishAt : null;
            model.ExpireAt = PersianDate.TryParseJalaliDateTime(_expireAtInput, out var expireAt) ? expireAt : null;
            model.PinnedUntil = PersianDate.TryParseJalaliDateTime(_pinnedUntilInput, out var pinnedUntil) ? pinnedUntil : null;

            if (model.PublishAt.HasValue && model.ExpireAt.HasValue && model.ExpireAt <= model.PublishAt)
            {
                ToastService.ShowError("زمان آرشیو باید بعد از زمان انتشار باشد.");
                return;
            }

            HttpResponseMessage resp;
            if (editingId == 0) resp = await Http.PostAsJsonAsync("api/news", model);
            else resp = await Http.PutAsJsonAsync($"api/news/{editingId}", model);
            
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(editingId == 0 ? "خبر با موفقیت ثبت شد" : "تغییرات خبر ذخیره شد");

                if (editingId == 0)
                {
                    // ردیف تازه بالای لیست اضافه می‌شود تا بارگذاری مجدد، موقعیت اسکرول را از بین نبرد.
                    try
                    {
                        var created = await resp.Content.ReadFromJsonAsync<NewsDto>();
                        var full = created != null
                            ? await Http.GetFromJsonAsync<NewsDto>($"api/news/{created.Id}")
                            : null;
                        if (full != null && newsList != null)
                        {
                            newsList.Insert(0, full);
                            totalCount++;
                        }
                        else
                        {
                            await LoadNews();
                        }
                    }
                    catch
                    {
                        await LoadNews();
                    }
                }
                else
                {
                    // فقط همان ردیف به‌روز می‌شود تا موقعیت اسکرول لیست (خصوصاً در موبایل) حفظ شود.
                    await RefreshNewsRow(editingId);
                }

                CloseEditor();
            }
            else
            {
                ToastService.ShowError("خطا در ذخیره‌سازی خبر");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally { isSaving = false; }
    }

    // فقط همان ردیف لیست را تازه می‌کند تا بارگذاری مجدد کل لیست، اسکرول را جابه‌جا نکند.
    private async Task RefreshNewsRow(int id)
    {
        if (newsList == null) return;

        try
        {
            var full = await Http.GetFromJsonAsync<NewsDto>($"api/news/{id}");
            if (full != null)
            {
                var index = newsList.FindIndex(n => n.Id == id);
                if (index >= 0) newsList[index] = full;
                return;
            }
        }
        catch
        {
            // در صورت خطا، فیلدهای نمایشی از روی فرم به‌روز می‌شوند.
        }

        var row = newsList.FirstOrDefault(n => n.Id == id);
        if (row == null) return;

        row.Title = model.Title;
        row.Summary = model.Summary;
        row.ImageUrl = model.ImageUrl;
        row.Tags = model.Tags;
        row.AuthorName = model.AuthorName;
        row.IsPublished = model.IsPublished;
        row.ContentType = model.ContentType;
        row.CategoryId = model.CategoryId;
        row.CategoryTitle = EditorCategories.FirstOrDefault(c => c.Id == model.CategoryId)?.Title;
        row.PublishAt = model.PublishAt;
        row.ExpireAt = model.ExpireAt;
        row.IsFeatured = model.IsFeatured;
        row.PinnedUntil = model.PinnedUntil;
        row.CreatedAt = model.CreatedAt ?? row.CreatedAt;
        row.PublishedAt = model.PublishAt ?? model.CreatedAt ?? row.PublishedAt;
        row.Status = ContentStatusResolver.Resolve(model.IsPublished, model.PublishAt, model.ExpireAt, DateTimeOffset.UtcNow);
    }

    private void CloseEditor()
    {
        showEditor = false;
        _quillInitialized = false;
        _lastQuillEditingId = 0;
        _ = JS.InvokeVoidAsync("destroyQuillEditor", "quill-editor-container");
    }

    // کلیک روی پس‌زمینه هنگام ذخیره/آپلود، فرم را نمی‌بندد تا کار کاربر از بین نرود.
    private void CloseEditorIfIdle()
    {
        if (!isSaving && !isUploading && !_inlineUploading) CloseEditor();
    }

    private NewsDto? itemToDelete;
    private bool showConfirm;

    private void ConfirmDelete(NewsDto news)
    {
        itemToDelete = news;
        showConfirm = true;
    }

    private async Task HandleDeleteResult(bool result)
    {
        showConfirm = false;
        if (result && itemToDelete != null)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/news/{itemToDelete.Id}");
                if (response.IsSuccessStatusCode)
                {
                    ToastService.ShowSuccess("خبر با موفقیت حذف شد");

                    // ردیف حذف‌شده فقط از لیست برداشته می‌شود تا اسکرول صفحه جابه‌جا نشود.
                    if (newsList != null)
                    {
                        newsList.RemoveAll(n => n.Id == itemToDelete.Id);
                        totalCount = Math.Max(0, totalCount - 1);
                        selectedIds.Remove(itemToDelete.Id);
                    }
                }
                else
                {
                    ToastService.ShowError("خطا در حذف خبر");
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"خطای سیستمی: {ex.Message}");
            }
        }
        itemToDelete = null;
    }
}
