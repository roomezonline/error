    private static string SeverityDotStyle(int severity) => severity switch
    {
        1 => "background:#16a34a",
        2 => "background:#f59e0b",
        3 => "background:#dc2626",
        _ => "background:#0d6efd"
    };

    [JSInvokable]
    public void CloseUserMenuFromOutside()
    {
        showUserMenu = false;
        StateHasChanged();
    }
    private const string RecentSearchesStorageKey = "errorservice_recent_searches";
    private string searchQuery = "";
    private SearchResponseDto? suggestions;
    private bool showSuggestions = false;
    private List<string> recentSearches = new();
    private readonly List<string> popularSearches = new()
    {
        "کد خطای یخچال", "قطعات یخچال", "تعمیر ماشین لباسشویی",
        "کد خطای لباسشویی", "سنسور لوازم خانگی", "آموزش تعمیرات"
    };
    private bool isSearching = false;
    private CancellationTokenSource? suggestCts;

    private async Task HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            await SaveRecentSearchAsync(searchQuery);
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}");
            searchQuery = "";
            HideSuggestions();
        }
    }

    private bool HasAnySuggestions =>
        (suggestions?.Products?.Any() ?? false) ||
        (suggestions?.ErrorCodes?.Any() ?? false) ||
        (suggestions?.Courses?.Any() ?? false) ||
        (suggestions?.News?.Any() ?? false);

    private void ShowSuggestions()
    {
        showSuggestions = true;
        _ = InvokeAsync(LoadRecentSearchesAsync);
        var q = (searchQuery ?? string.Empty).Trim();
        if (q.Length >= 2 && suggestions == null && !isSearching)
            _ = InvokeAsync(() => HandleSearchInput(new ChangeEventArgs { Value = searchQuery }));
    }

    private async Task LoadRecentSearchesAsync()
    {
        try
        {
            var json = await SearchStorage.GetAsync(RecentSearchesStorageKey);
            recentSearches = string.IsNullOrWhiteSpace(json) ? new() : JsonSerializer.Deserialize<List<string>>(json) ?? new();
            recentSearches = recentSearches.Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Take(8).ToList();
            await InvokeAsync(StateHasChanged);
        }
        catch { recentSearches = new(); }
    }

    private async Task SaveRecentSearchAsync(string value)
    {
        var q = value.Trim();
        if (q.Length < 2) return;
        try
        {
            var updated = new[] { q }.Concat(recentSearches).Where(x => !string.IsNullOrWhiteSpace(x)).Select(x => x.Trim()).Distinct(StringComparer.OrdinalIgnoreCase).Take(8).ToList();
            recentSearches = updated;
            await SearchStorage.SetAsync(RecentSearchesStorageKey, JsonSerializer.Serialize(updated));
        }
        catch { }
    }

    private async Task SearchFromChip(string value)
    {
        searchQuery = value;
        await SaveRecentSearchAsync(value);
        HideSuggestions();
        Nav.NavigateTo($"/search?q={Uri.EscapeDataString(value)}");
    }

    private async Task ClearRecentSearches()
    {
        recentSearches.Clear();
        try { await SearchStorage.RemoveAsync(RecentSearchesStorageKey); } catch { }
        await InvokeAsync(StateHasChanged);
    }

    private void HideSuggestions()
    {
        showSuggestions = false;
        suggestions = null;
        isSearching = false;
        suggestCts?.Cancel();
        suggestCts?.Dispose();
        suggestCts = null;
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        showSuggestions = true;

        var q = (searchQuery ?? string.Empty).Trim();
        if (q.Length < 2)
        {
            suggestCts?.Cancel();
            suggestCts?.Dispose();
            suggestCts = null;
            suggestions = null;
            isSearching = false;
            return;
        }

        suggestCts?.Cancel();
        suggestCts?.Dispose();
        suggestCts = new CancellationTokenSource();
        var token = suggestCts.Token;

        isSearching = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(250, token);
            var resp = await Http.GetFromJsonAsync<SearchResponseDto>($"api/search?q={Uri.EscapeDataString(q)}&take=8", token);
            if (token.IsCancellationRequested) return;
            suggestions = resp;
            isSearching = false;
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch
        {
            if (!token.IsCancellationRequested) isSearching = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void NavigateToSuggestion(string url)
    {
        HideSuggestions();
        Nav.NavigateTo(url);
        searchQuery = "";
    }

    private void GoToFullSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        var q = searchQuery;
        _ = SaveRecentSearchAsync(q);
        HideSuggestions();
        Nav.NavigateTo($"/search?q={Uri.EscapeDataString(q)}");
        searchQuery = "";
    }

