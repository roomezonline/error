@code {
    private bool showDrawer = false;
    private bool showUserMenu = false;
    private bool isNavigating = false;
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    private bool _hideBottomNav => Nav.Uri.Contains("/products/");
    private bool _isOnline = true;
    private bool _dismissedOfflineBanner;
    private DotNetObjectReference<MainLayout>? _onlineRef;

    private async Task ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
        if (showUserMenu)
        {
            await JS.InvokeVoidAsync("__um_addHandler", _dotNetRef);
        }
        else
        {
            await JS.InvokeVoidAsync("__um_removeHandler");
        }
    }

    [JSInvokable]
    public void CloseUserMenuFromOutside()
    {
        showUserMenu = false;
        StateHasChanged();
    }
    private string searchQuery = "";
    private SearchResponseDto? suggestions;
    private bool showSuggestions = false;
    private CancellationTokenSource? suggestCts;

    private void HandleSearchKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            Nav.NavigateTo($"/search?q={Uri.EscapeDataString(searchQuery)}");
            searchQuery = "";
            HideSuggestions();
        }
    }

    private bool HasAnySuggestions =>
        (suggestions?.Products?.Any() ?? false) ||
        (suggestions?.ErrorCodes?.Any() ?? false) ||
        (suggestions?.Courses?.Any() ?? false) ||
        (suggestions?.News?.Any() ?? false);

    private void ShowSuggestions()
    {
        showSuggestions = true;
    }

    private void HideSuggestions()
    {
        showSuggestions = false;
        suggestions = null;
        suggestCts?.Cancel();
    }

    private async Task HandleSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        showSuggestions = true;

        var q = (searchQuery ?? string.Empty).Trim();
        if (q.Length < 2)
        {
            suggestions = null;
            return;
        }

        suggestCts?.Cancel();
        suggestCts = new CancellationTokenSource();
        var token = suggestCts.Token;

        suggestions = null;
        try
        {
            await Task.Delay(250, token);
            suggestions = await Http.GetFromJsonAsync<SearchResponseDto>($"api/search?q={Uri.EscapeDataString(q)}&take=6", token);
        }
        catch
        {
            // ignore
        }

        await InvokeAsync(StateHasChanged);
    }

    private void NavigateToSuggestion(string url)
    {
        HideSuggestions();
        Nav.NavigateTo(url);
        searchQuery = "";
    }

    private void GoToFullSearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery)) return;
        var q = searchQuery;
        HideSuggestions();
        Nav.NavigateTo($"/search?q={Uri.EscapeDataString(q)}");
        searchQuery = "";
    }

    protected override async Task OnInitializedAsync()
    {
        await Theme.InitializeAsync();
        Theme.OnChange += StateHasChanged;
        await CartService.InitializeAsync();
        CartService.OnChange += StateHasChanged;
        Nav.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("eval", @"
                window.__um_addHandler = function(dotNetRef) {
                    if (window.__um_handler) {
                        document.removeEventListener('click', window.__um_handler, true);
                    }
                    window.__um_handler = function(e) {
                        var m = document.querySelector('.hdr-usermenu');
                        var b = document.querySelector('.hdr-avatar');
                        if (m && !m.contains(e.target) && b && !b.contains(e.target)) {
                            document.removeEventListener('click', window.__um_handler, true);
                            window.__um_handler = null;
                            dotNetRef.invokeMethodAsync('CloseUserMenuFromOutside');
                        }
                    };
                    document.addEventListener('click', window.__um_handler, true);
                };
                window.__um_removeHandler = function() {
                    if (window.__um_handler) {
                        document.removeEventListener('click', window.__um_handler, true);
                        window.__um_handler = null;
                    }
                };
            ");
            await SetupHeaderScrollBehavior();
            try { await JS.InvokeVoidAsync("initScrollReveal"); } catch { }
            try { await InitOnlineDetection(); } catch { }
        }
    }

    private async Task SetupHeaderScrollBehavior()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    'use strict';

                    var lastScrollTop = 0;
                    var scrollStartPoint = 0;
                    var lastDirection = 'none';
                    var touchStartY = 0;
                    var isTouching = false;
                    var currentTransform = 0;
                    var targetTransform = 0;
                    var isScrollingByNav = false;

                    var headerWrapper = document.querySelector('.app-header-group');
                    var header = document.querySelector('.app-header');
                    var scrollThreshold = 30;
                    var maxTransform = -100;

                    if (!headerWrapper || !header) return;

                    function handleScroll() {
                        if (isScrollingByNav) return;
                        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                        var scrollDirection = scrollTop > lastScrollTop ? 'down' : 'up';
                        if (scrollDirection !== lastDirection) {
                            scrollStartPoint = scrollTop;
                            lastDirection = scrollDirection;
                        }
                        var scrollDistance = Math.abs(scrollTop - scrollStartPoint);
                        if (scrollTop < 10 || isScrollingByNav) {
                            targetTransform = 0;
                        } else if (scrollDirection === 'down' && scrollDistance > scrollThreshold) {
                            var hideProgress = Math.min((scrollDistance - scrollThreshold) / 50, 1);
                            targetTransform = -hideProgress * 100;
                        } else if (scrollDirection === 'up' && scrollDistance > scrollThreshold) {
                            var showProgress = Math.min((scrollDistance - scrollThreshold) / 50, 1);
                            targetTransform = maxTransform + showProgress * 100;
                            if (targetTransform > 0) targetTransform = 0;
                        }
                        lastScrollTop = scrollTop;
                    }

                    function animateHeader() {
                        if (isScrollingByNav) {
                            currentTransform = 0;
                            targetTransform = 0;
                            headerWrapper.style.transform = 'translateY(0%)';
                            header.style.opacity = '1';
                            return;
                        }
                        var diff = targetTransform - currentTransform;
                        if (Math.abs(diff) > 0.1) {
                            currentTransform += diff * 0.15;
                            headerWrapper.style.transform = 'translateY(' + currentTransform + '%)';
                            header.style.opacity = 1 - Math.abs(currentTransform) / 100;
                            requestAnimationFrame(animateHeader);
                        } else {
                            currentTransform = targetTransform;
                            headerWrapper.style.transform = 'translateY(' + currentTransform + '%)';
                            header.style.opacity = 1 - Math.abs(currentTransform) / 100;
                        }
                    }

                    var ticking = false;
                    function throttledScroll() {
                        if (!ticking && !isScrollingByNav) {
                            window.requestAnimationFrame(function() {
                                handleScroll();
                                animateHeader();
                                ticking = false;
                            });
                            ticking = true;
                        }
                    }

                    function handleTouchStart(e) {
                        touchStartY = e.touches[0].clientY;
                        isTouching = true;
                    }

                    function handleTouchMove(e) {
                        if (!isTouching || isScrollingByNav) return;
                        var currentY = e.touches[0].clientY;
                        var deltaY = touchStartY - currentY;
                        if (Math.abs(deltaY) > 5) throttledScroll();
                    }

                    function handleTouchEnd() {
                        isTouching = false;
                        setTimeout(function() {
                            isScrollingByNav = false;
                            throttledScroll();
                        }, 100);
                    }

                    window.addEventListener('scroll', throttledScroll, { passive: true });
                    window.addEventListener('touchstart', handleTouchStart, { passive: true });
                    window.addEventListener('touchmove', handleTouchMove, { passive: true });
                    window.addEventListener('touchend', handleTouchEnd, { passive: true });

                    scrollStartPoint = window.pageYOffset || document.documentElement.scrollTop;
                    handleScroll();
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting up header scroll behavior: {ex.Message}");
        }
    }

    private async Task InitOnlineDetection()
    {
        try
        {
            _onlineRef?.Dispose();
            _onlineRef = DotNetObjectReference.Create(this);
            _isOnline = await JS.InvokeAsync<bool>("__initOnlineDetection", _onlineRef);
        }
        catch { }
    }

    [JSInvokable]
    public void SetOnlineStatus(bool online)
    {
        _isOnline = online;
        if (online) _dismissedOfflineBanner = false;
        InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        isNavigating = true;
        StateHasChanged();
        
        Task.Run(async () => {
            await Task.Delay(800);
            isNavigating = false;
            await InvokeAsync(StateHasChanged);
            await InvokeAsync(async () => {
                try { await JS.InvokeVoidAsync("initScrollReveal"); } catch { }
            });
        });
    }

    public void Dispose()
    {
        Theme.OnChange -= StateHasChanged;
        CartService.OnChange -= StateHasChanged;
        Nav.LocationChanged -= HandleLocationChanged;
        _dotNetRef?.Dispose();
        _onlineRef?.Dispose();
        try { JS.InvokeVoidAsync("__um_removeHandler"); } catch { }
        try { JS.InvokeVoidAsync("__removeOnlineDetection"); } catch { }
    }

    private void ToggleDrawer() => showDrawer = !showDrawer;

    private void GoHome() => Nav.NavigateTo("/");

    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();
        AuthStateProvider.NotifyAuthStateChanged();
        ToastService.ShowSuccess("با موفقیت از حساب خارج شدید");
        showDrawer = false;
        Nav.NavigateTo("/");
    }
}
