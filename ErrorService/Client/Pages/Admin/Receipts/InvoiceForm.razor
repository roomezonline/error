    private async Task SubmitInvoiceAll()
    {
        if (receipt == null) return;
        
        try 
        {
            isLoading = true;
            StateHasChanged();

            // 1. Update Status
            var statusUrl = $"api/customer-receipts/{ReceiptId}/status";
            if (receipt.WorkshopId > 0) statusUrl += $"?workshopId={receipt.WorkshopId}";
            
            var statusRes = await Http.PutAsJsonAsync(statusUrl, new ReceiptStatusUpdateRequest { Status = receiptStatus });
            if (!statusRes.IsSuccessStatusCode)
            {
                var err = await statusRes.Content.ReadAsStringAsync();
                ToastService.ShowError("خطا در بروزرسانی وضعیت: " + err);
                return;
            }

            // 2. Upsert Billing
            var billingUrl = $"api/customer-receipts/{ReceiptId}/billing";
            if (receipt.WorkshopId > 0) billingUrl += $"?workshopId={receipt.WorkshopId}";

            var billingReq = new CustomerReceiptBillingUpsertRequest
            {
                BillTotal = BillTotalLive,
                Discount = billDiscount,
                Prepaid = billPrepaid,
                Paid = billPaid,
                SelectedBankAccountId = selectedBankAccountId,
                Items = invoiceItems.Select(i => new InvoiceItemDto
                {
                    Title = i.Title,
                    ActionDescription = i.ActionDescription,
                    UnitPrice = i.UnitPrice,
                    Quantity = i.Quantity,
                    TechnicianId = i.TechnicianId
                }).ToList()
            };
            var billingRes = await Http.PutAsJsonAsync(billingUrl, billingReq);
            if (!billingRes.IsSuccessStatusCode)
            {
                var err = await billingRes.Content.ReadAsStringAsync();
                ToastService.ShowError("خطا در ثبت صورتحساب: " + err);
                return;
            }

            ToastService.ShowSuccess("فاکتور و وضعیت با موفقیت ثبت شد");

            isLoading = false;
            StateHasChanged();

            if (receiptStatus == "repaired" || receiptStatus == "not_repairable")
            {
                if (receipt.WorkshopId > 0)
                {
                    var moduleType = receiptStatus == "not_repairable" ? 3 : 2;
                    try
                    {
                        var moduleResp = await Http.GetAsync($"api/workshop-sms/module-status?workshopId={receipt.WorkshopId}&moduleType={moduleType}");
                        if (moduleResp.IsSuccessStatusCode)
                        {
                            var smsAllowed = await moduleResp.Content.ReadFromJsonAsync<bool>();
                            if (smsAllowed)
                            {
                                ShowSmsModal(receiptStatus);
                            }
                            else
                            {
                                Navigation.NavigateTo("/admin/receipts");
                            }
                        }
                        else
                        {
                            Navigation.NavigateTo("/admin/receipts");
                        }
                    }
                    catch
                    {
                        Navigation.NavigateTo("/admin/receipts");
                    }
                }
                else
                {
                    Navigation.NavigateTo("/admin/receipts");
                }
            }
            else
            {
                Navigation.NavigateTo("/admin/receipts");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            ToastService.ShowError("خطای سیستمی در ثبت نهایی");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

