    private async Task PrefetchBillingForPaymentFilter()
    {
        paymentPrefetchCts?.Cancel();
        paymentPrefetchCts?.Dispose();
        paymentPrefetchCts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        var ct = paymentPrefetchCts.Token;

        try
        {
            if (filtered == null || filtered.Count == 0) return;

            var need = filtered
                .Take(displayCount)
                .Where(x => !billingCache.ContainsKey(x.Id))
                .Select(x => x.Id)
                .ToList();

            if (need.Count == 0) return;

            isLoadingPaymentPrefetch = true;
            await InvokeAsync(StateHasChanged);

            var qs = WorkshopQs();
            var resp = await Http
                .PostAsJsonAsync($"api/customer-receipts/billing-batch{qs}", need, ct)
                .WaitAsync(ct);

            if (resp.IsSuccessStatusCode)
            {
                var batch = await resp.Content.ReadFromJsonAsync<Dictionary<int, CustomerReceiptBillingDto>>(cancellationToken: ct);
                if (batch != null)
                {
                    foreach (var kv in batch)
                    {
                        billingCache[kv.Key] = kv.Value;
                    }
                }
            }

            ApplyFilter();
        }
        catch (OperationCanceledException)
        {
        }
        catch
        {
        }
        finally
        {
            isLoadingPaymentPrefetch = false;
            await InvokeAsync(StateHasChanged);
        }
    }

