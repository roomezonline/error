    private string _cartBtnClass => _cartBtnState == CartBtnState.Done ? "pd-cart-done" : "";
    private string _scrollTopClass => _showScrollTop ? "pd-scroll-visible" : "";

    private CancellationTokenSource? _toastCts;
    private object? _scrollHandlerRef;

    private bool isInWishlist;

    private bool _stockAlertBusy;
    private bool _stockAlertSubscribed;
    private bool _showConnectModal;
    private bool _connectChannelsLoading;
    private List<MessengerConnectChannelDto> _connectChannels = new();
    private bool _isAuthenticated;

    private SiteSettingsDto? _shop;
    private List<ProductSpecDto> _serverSpecs = new();
    private List<ProductPricePointDto> _pricePoints = new();
    private List<ProductQuestionDto> _questions = new();
    private bool _qnaLoading;
    private bool _qnaSending;
    private string _qnaName = "";
    private string _qnaText = "";
