    private async Task LoadAlerts(int page, bool append = false)
    {
        if (string.IsNullOrWhiteSpace(Code)) return;
        try
        {
            var resp = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/monitoring/alert?monitoringId={Id}&code={Code}&state={_alertFilter}&page={page}&pageSize=20");
            _alertTotal = resp.GetProperty("total").GetInt32();
            _alertPage = resp.GetProperty("page").GetInt32();
            var items = System.Text.Json.JsonSerializer.Deserialize<List<AlertDto>>(resp.GetProperty("items").GetRawText(), new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            if (append)
                _alerts.AddRange(items);
            else
                _alerts = items;
        }
        catch { }
    }

    private async Task SetAlertFilter(string filter)
    {
        _alertFilter = filter;
        _alertPage = 1;
        await LoadAlerts(1);
    }

    private async Task LoadMoreAlerts()
    {
        if (_alertLoadingMore) return;
        _alertLoadingMore = true;
        await LoadAlerts(_alertPage + 1, append: true);
        _alertLoadingMore = false;
    }

    private async Task FetchAlertCount()
    {
        if (string.IsNullOrWhiteSpace(Code)) return;
        try
        {
            var resp = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/monitoring/alert/count?monitoringId={Id}&code={Code}");
            _alertCount = resp.GetProperty("count").GetInt32();
            _hasActiveAlerts = _alertCount > 0;
        }
        catch { }
    }

    private async Task ResolveAlert(int id)
    {
        try
        {
            await Http.PostAsync($"api/monitoring/alert/{id}/resolve", null);
            var alert = _alerts.FirstOrDefault(a => a.Id == id);
            if (alert != null) alert.State = false;
            _alertCount = Math.Max(0, _alertCount - 1);
            _hasActiveAlerts = _alertCount > 0;
            StateHasChanged();
        }
        catch { }
    }

    private async Task DeleteAlert(int id)
    {
        try
        {
            await Http.DeleteAsync($"api/monitoring/alert/{id}");
            _alerts.RemoveAll(a => a.Id == id);
            var wasActive = _alerts.Any(a => a.Id == id && a.State);
            if (wasActive) _alertCount = Math.Max(0, _alertCount - 1);
            _hasActiveAlerts = _alertCount > 0;
            _alertTotal = Math.Max(0, _alertTotal - 1);
            StateHasChanged();
        }
        catch { }
    }

