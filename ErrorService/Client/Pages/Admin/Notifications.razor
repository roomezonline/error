    private async Task ToggleRule(NotificationRuleDto r)
    {
        r.IsEnabled = !r.IsEnabled;
        await SaveRule(r);
    }

    private async Task SaveRule(NotificationRuleDto r)
    {
        if (!canManageRules) return;
        ruleErrors.Remove(r.EventType);
        rulesSuccess = null;
        if (string.IsNullOrWhiteSpace(r.TitleTemplate) || string.IsNullOrWhiteSpace(r.BodyTemplate))
        {
            ruleErrors[r.EventType] = "عنوان و متن قالب الزامی است.";
            return;
        }
        savingRules.Add(r.EventType);
        StateHasChanged();
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/notifications/admin/rules/{Uri.EscapeDataString(r.EventType)}",
                new NotificationRuleUpdateRequest
                {
                    IsEnabled = r.IsEnabled,
                    Severity = r.Severity,
                    TitleTemplate = r.TitleTemplate.Trim(),
                    BodyTemplate = r.BodyTemplate.Trim(),
                    ActionUrlTemplate = string.IsNullOrWhiteSpace(r.ActionUrlTemplate) ? null : r.ActionUrlTemplate.Trim(),
                    BroadcastToAdmins = r.BroadcastToAdmins
                });
            if (!resp.IsSuccessStatusCode)
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ruleErrors[r.EventType] = string.IsNullOrWhiteSpace(msg)
                    ? (resp.StatusCode == System.Net.HttpStatusCode.Forbidden
                        ? "برای این عملیات دسترسی لازم را ندارید."
                        : "ذخیره تنظیمات انجام نشد.")
                    : msg.Trim('"');
                return;
            }
            var updated = await resp.Content.ReadFromJsonAsync<NotificationRuleDto>();
            if (updated != null)
            {
                r.Id = updated.Id;
                r.Group = updated.Group;
                r.Label = updated.Label;
                r.Placeholders = updated.Placeholders;
                r.UpdatedAt = updated.UpdatedAt;
            }
            else r.UpdatedAt = DateTimeOffset.UtcNow;
            ruleSnapshots[r.EventType] = RuleSnapshot(r);
            rulesSuccess = $"تنظیمات «{r.Label}» ذخیره شد.";
        }
        catch { ruleErrors[r.EventType] = "ارتباط با سرور برقرار نشد."; }
        finally { savingRules.Remove(r.EventType); }
    }

    private async Task Load()
    {
        try
        {
            var listTask = Http.GetFromJsonAsync<List<NotificationDto>>("api/notifications/admin?take=100");
            var summaryTask = Http.GetFromJsonAsync<NotificationSummaryDto>("api/notifications/admin/summary");
            items = await listTask ?? new();
            summary = await summaryTask;
        }
        catch (Exception ex) { error = $"دریافت اعلان‌ها انجام نشد: {ex.Message}"; }
    }

    private void ToggleSeg(ref bool flag)
    {
        flag = !flag;
        previewCount = null;
        error = null;
    }

    private void OpenComposer()
    {
        composerStep = 1;
        error = success = null;
        previewCount = null;
    }

    private void CancelComposer()
    {
        composerStep = 0;
        error = success = null;
        ResetComposer();
    }

    private void ResetComposer()
    {
        request = new();
        segAllUsers = segAdmins = segSuperAdmin = segWorkshop = segBuyers = segManual = false;
        workshopIdSel = null;
        workshopIdText = string.Empty;
        recipientText = string.Empty;
        manualPhones = new();
        productQuery = string.Empty;
        productResults = null;
        selectedProducts = new();
        previewCount = null;
        channelPreview = null;
    }

    private void SetRequestChannel(int channel, bool enabled)
    {
        switch (channel)
        {
            case 1: request.BaleEnabled = enabled; break;
            case 2: request.TelegramEnabled = enabled; break;
            default: request.EitaaEnabled = enabled; break;
        }
    }

    private bool HasAnySegment =>
        segAllUsers || segAdmins || segSuperAdmin || segWorkshop || segBuyers
        || (segManual && ParsePhones(recipientText).Count > 0);

    private NotificationCreateRequest BuildRequest()
    {
        var wsId = workshopIdSel;
        if (!wsId.HasValue && int.TryParse(workshopIdText, out var w)) wsId = w;
        return new NotificationCreateRequest
        {
            Title = request.Title?.Trim() ?? string.Empty,
            Body = request.Body?.Trim() ?? string.Empty,
            Severity = request.Severity,
            ActionUrl = string.IsNullOrWhiteSpace(request.ActionUrl) ? null : request.ActionUrl.Trim(),
            IncludeAllUsers = segAllUsers,
            BroadcastToAdmins = segAdmins,
            IncludeSuperAdmins = segSuperAdmin,
            IncludeWorkshopUsers = segWorkshop,
            WorkshopId = segWorkshop ? wsId : null,
            PhoneNumbers = segManual ? ParsePhones(recipientText) : new(),
            PurchasedProductIds = segBuyers ? selectedProducts.Select(p => p.Id).ToList() : new(),
            Channels = request.Channels
        };
    }

    private static string NormalizeDigits(string s)
    {
        var chars = s.ToCharArray();
        for (var i = 0; i < chars.Length; i++)
        {
            var c = chars[i];
            if (c >= '۰' && c <= '۹') chars[i] = (char)('0' + (c - '۰'));
            else if (c >= '٠' && c <= '٩') chars[i] = (char)('0' + (c - '٠'));
        }
        return new string(chars);
    }

    private static List<string> ParsePhones(string text) =>
        NormalizeDigits(text ?? string.Empty)
            .Split(new[] { ',', ';', '،', '\n', '\r', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(x => x.Trim().Trim('+', '-', '(', ')'))
            .Where(x => x.Length >= 10 && x.Length <= 15 && x.All(char.IsDigit))
            .Distinct()
            .ToList();

    private void GoStep2()
    {
        error = null;
        manualPhones = segManual ? ParsePhones(recipientText) : new();
        if (!HasAnySegment) { error = "حداقل یک گروه مخاطب را انتخاب کنید."; return; }
        if (segWorkshop)
        {
            var wsId = workshopIdSel;
            if (!wsId.HasValue && int.TryParse(workshopIdText, out var w)) wsId = w;
            if (!wsId.HasValue || wsId.Value <= 0) { error = "کارگاه مقصد را انتخاب کنید."; return; }
        }
        if (segBuyers && selectedProducts.Count == 0) { error = "حداقل یک محصول برای «خریداران محصول» انتخاب کنید."; return; }
        if (segManual)
        {
            if (manualPhones.Count == 0) { error = "حداقل یک شماره موبایل معتبر وارد کنید (مثلاً 09123456789)."; return; }
            var validSet = new HashSet<string>(manualPhones);
            var invalidTokens = NormalizeDigits(recipientText ?? string.Empty)
                .Split(new[] { ',', ';', '،', '\n', '\r', ' ', '\t' }, StringSplitOptions.RemoveEmptyEntries)
                .Select(x => x.Trim().Trim('+', '-', '(', ')'))
                .Where(x => x.Length > 0 && !validSet.Contains(x))
                .Distinct()
                .ToList();
            if (invalidTokens.Count > 0) { error = $"این موارد شماره موبایل معتبر نیستند: {string.Join("، ", invalidTokens)}"; return; }
        }
        composerStep = 2;
        previewCount = null;
    }

    private async Task GoStep3()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(request.Title) || string.IsNullOrWhiteSpace(request.Body))
        {
            error = "عنوان و متن اعلان الزامی است.";
            return;
        }
        composerStep = 3;
        if (!previewCount.HasValue)
            await LoadPreviewAsync();
    }

    private async Task LoadPreviewAsync()
    {
        error = null;
        previewLoading = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/notifications/admin/preview-recipients", BuildRequest());
            if (resp.IsSuccessStatusCode)
                previewCount = await resp.Content.ReadFromJsonAsync<int>();
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                previewCount = null;
                error = string.IsNullOrWhiteSpace(msg)
                    ? "محاسبه تعداد گیرنده انجام نشد."
                    : msg.Trim('"');
            }

            if (previewCount.HasValue)
            {
                try
                {
                    var chResp = await Http.PostAsJsonAsync("api/notifications/admin/preview-channels", BuildRequest());
                    if (chResp.IsSuccessStatusCode)
                        channelPreview = await chResp.Content.ReadFromJsonAsync<List<ChannelPreviewDto>>();
                }
                catch { channelPreview = null; }
            }
        }
        catch { previewCount = null; error = "ارتباط با سرور برقرار نشد."; }
        finally { previewLoading = false; }
    }

    private async Task Create()
    {
        error = success = null;
        saving = true;
        try
        {
            var payload = BuildRequest();
            if (string.IsNullOrWhiteSpace(payload.Title) || string.IsNullOrWhiteSpace(payload.Body))
            {
                error = "عنوان و متن اعلان الزامی است.";
                return;
            }
            var response = await Http.PostAsJsonAsync("api/notifications/admin/manual", payload);
            if (!response.IsSuccessStatusCode)
            {
                var msg = await response.Content.ReadAsStringAsync();
                error = string.IsNullOrWhiteSpace(msg)
                    ? (response.StatusCode == System.Net.HttpStatusCode.Forbidden
                        ? "برای ارسال به مدیران/سوپر ادمین/همه کاربران، دسترسی «ارسال پخشی» لازم است."
                        : "ثبت اعلان انجام نشد.")
                    : msg.Trim('"');
                return;
            }
            success = "اعلان ثبت شد و برای مخاطبین انتخاب‌شده قرار گرفت.";
            pageSuccess = success;
            previewCount = null;
            await Load();
            composerStep = 0;
            ResetComposer();
        }
        catch (Exception ex) { error = ex.Message; }
        finally { saving = false; }
    }

    /* product picker */
    private async Task OnProductQueryInput(ChangeEventArgs e)
    {
        productQuery = e.Value?.ToString() ?? string.Empty;
        _productCts?.Cancel();
        _productCts = new CancellationTokenSource();
        var ct = _productCts.Token;
        try
        {
            await Task.Delay(320, ct);
            if (productQuery.Trim().Length < 2)
            {
                productResults = null;
                StateHasChanged();
                return;
            }
            var res = await Http.GetFromJsonAsync<List<ProductDto>>(
                $"api/products?search={Uri.EscapeDataString(productQuery.Trim())}&take=8", ct);
            productResults = res ?? new();
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch { productResults = new(); }
    }

    private void AddProduct(ProductDto p)
    {
        if (selectedProducts.All(x => x.Id != p.Id))
            selectedProducts.Add(p);
        productQuery = string.Empty;
        productResults = null;
        previewCount = null;
    }

    private void RemoveProduct(ProductDto p)
    {
        selectedProducts.Remove(p);
        previewCount = null;
    }

    /* edit / delete */
    private void OpenEdit(NotificationDto item)
    {
        editing = item;
        editError = null;
        editReq = new NotificationUpdateRequest
        {
            Title = item.Title,
            Body = item.Body,
            Severity = item.Severity,
            ActionUrl = item.ActionUrl
        };
    }

    private void CloseEdit()
    {
        if (editSaving) return;
        editing = null;
        editError = null;
    }

    private async Task SaveEdit()
    {
        if (editing == null) return;
        editError = null;
        if (string.IsNullOrWhiteSpace(editReq.Title) || string.IsNullOrWhiteSpace(editReq.Body))
        {
            editError = "عنوان و متن اعلان الزامی است.";
            return;
        }
        editSaving = true;
        try
        {
            var response = await Http.PutAsJsonAsync($"api/notifications/admin/{editing.Id}", editReq);
            if (!response.IsSuccessStatusCode)
            {
                var msg = await response.Content.ReadAsStringAsync();
                editError = string.IsNullOrWhiteSpace(msg) ? "ذخیره تغییرات انجام نشد." : msg.Trim('"');
                return;
            }
            var updated = await response.Content.ReadFromJsonAsync<NotificationDto>();
            if (updated != null && items != null)
            {
                var idx = items.FindIndex(x => x.Id == updated.Id);
                if (idx >= 0)
                {
                    updated.RecipientCount = items[idx].RecipientCount;
                    updated.CreatedByName = items[idx].CreatedByName;
                    items[idx] = updated;
                }
            }
            pageSuccess = "اعلان ویرایش شد؛ تغییرات برای همه گیرندگان اعمال شد.";
            editing = null;
        }
        catch { editError = "ارتباط با سرور برقرار نشد."; }
        finally { editSaving = false; }
    }

    private void AskDelete(NotificationDto item)
    {
        deleting = item;
        deleteError = null;
    }

    private async Task ConfirmDelete()
    {
        if (deleting == null) return;
        deleteError = null;
        deleteSaving = true;
        try
        {
            var response = await Http.DeleteAsync($"api/notifications/admin/{deleting.Id}");
            if (!response.IsSuccessStatusCode)
            {
                var msg = await response.Content.ReadAsStringAsync();
                deleteError = string.IsNullOrWhiteSpace(msg) ? "حذف اعلان انجام نشد." : msg.Trim('"');
                return;
            }
            items?.RemoveAll(x => x.Id == deleting.Id);
            pageSuccess = $"اعلان «{deleting.Title}» حذف شد.";
            deleting = null;
            await Load();
        }
        catch { deleteError = "ارتباط با سرور برقرار نشد."; }
        finally { deleteSaving = false; }
    }

    /* list */
    private int CategoryCount(string key)
    {
        var all = items ?? new();
        return key == "all" ? all.Count : all.Count(x => CategoryOf(x.EventType) == key);
    }

    private IEnumerable<NotificationDto> filteredItems =>
        (items ?? new())
        .Where(x => (activeCategory == "all" || CategoryOf(x.EventType) == activeCategory)
            && (activeSeverity < 0 || x.Severity == activeSeverity)
            && (string.IsNullOrWhiteSpace(searchText)
                || x.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase)
                || x.Body.Contains(searchText, StringComparison.OrdinalIgnoreCase)));

    private static string CategoryOf(string eventType) => eventType switch
    {
        "manual" => "manual",
        _ when eventType.StartsWith("order.") => "order",
        _ when eventType.StartsWith("receipt.") => "receipt",
        _ when eventType.StartsWith("return.") => "return",
        _ => "other"
    };

    private static string CategoryIcon(string eventType) => CategoryOf(eventType) switch
    {
        "manual" => "oi-bullhorn",
        "order" => "oi-cart",
        "receipt" => "oi-document",
        "return" => "oi-action-undo",
        _ => "oi-info"
    };

    private static string SevColor(int severity) => severity switch
    {
        1 => "#16a34a",
        2 => "#f59e0b",
        3 => "#dc2626",
        _ => "#0d6efd"
    };

    private static string SevLabel(int severity) => severity switch
    {
        1 => "موفق",
        2 => "هشدار",
        3 => "بحرانی",
        _ => "اطلاع"
    };
