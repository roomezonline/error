@code {
    private UserProfileDto? user;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private UpdateProfileRequest updateModel = new();
    private ChangePasswordRequest passwordModel = new();
    private string activeTab = "overview";
    private bool isBusy = false;
    
    private List<OrderDto> myOrders = new();
    private List<ConsultationTicket> myTickets = new();
    private bool isLoadingOrders = false;
    private bool isLoadingTickets = false;

    private HashSet<int> expandedOrders = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadUser();
        if (user != null)
        {
            await LoadSummary();
        }
    }

    private async Task LoadUser()
    {
        user = await Auth.GetMeAsync();
        if (user != null)
        {
            updateModel = new UpdateProfileRequest {
                FullName = user.FullName,
                Email = user.Email,
                Address = user.Address,
                PostalCode = user.PostalCode
            };
        }
    }

    private async Task LoadSummary()
    {
        var ordersTask = LoadOrdersAsync();
        var ticketsTask = LoadTicketsAsync();
        await Task.WhenAll(ordersTask, ticketsTask);
    }

    private async Task LoadOrdersAsync()
    {
        try
        {
            myOrders = await Http.GetFromJsonAsync<List<OrderDto>>("api/orders/my") ?? new();
        }
        catch { }
    }

    private async Task LoadTicketsAsync()
    {
        try
        {
            myTickets = await Http.GetFromJsonAsync<List<ConsultationTicket>>("api/technical/tickets/my") ?? new();
        }
        catch { }
    }

    private string replyMessage = "";
    private ConsultationTicket newTicket = new();
    private ConsultationTicket? selectedTicketForProfile;
    private bool isCreatingNewTicket = false;

    private async Task SelectTicketForProfile(ConsultationTicket ticket)
    {
        selectedTicketForProfile = ticket;
        if (!ticket.IsUserRead)
        {
            try
            {
                var resp = await Http.PostAsync($"api/technical/tickets/{ticket.Id}/read-user", null);
                if (resp.IsSuccessStatusCode)
                {
                    ticket.IsUserRead = true;
                }
            }
            catch { /* ignore */ }
        }
    }

    private async Task HandleSubmitTicket()
    {
        isBusy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/technical/tickets", newTicket);
            if (response.IsSuccessStatusCode)
            {
                newTicket = new();
                isCreatingNewTicket = false;
                await LoadSummary();
                Toast.ShowSuccess("تیکت شما با موفقیت ثبت شد.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        isBusy = false;
    }

    private async Task HandleReplySubmit()
    {
        if (selectedTicketForProfile == null || string.IsNullOrEmpty(replyMessage)) return;

        isBusy = true;
        try
        {
            var reply = new TicketReply
            {
                Message = replyMessage,
                IsAdmin = false,
                AttachmentUrl = replyAttachmentUrl,
                AttachmentName = replyAttachmentName,
                AttachmentContentType = replyAttachmentType
            };
            var response = await Http.PostAsJsonAsync($"api/technical/tickets/{selectedTicketForProfile.Id}/reply", reply);
            if (response.IsSuccessStatusCode)
            {
                var newReply = await response.Content.ReadFromJsonAsync<TicketReply>();
                if (newReply != null)
                {
                    selectedTicketForProfile.Replies.Add(newReply);
                }
                replyMessage = "";
                replyAttachmentUrl = null;
                replyAttachmentName = null;
                replyAttachmentType = null;
                Toast.ShowInfo("پاسخ شما ثبت شد.");
            }
        }
        catch
        {
            Toast.ShowError("خطا در ارسال پاسخ");
        }
        isBusy = false;
    }

    private string? replyAttachmentUrl;
    private string? replyAttachmentName;
    private string? replyAttachmentType;

    private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isBusy = true;
        try
        {
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var resp = await Http.PostAsync("api/technical/tickets/upload-attachment", content);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null)
                {
                    if (file.ContentType.StartsWith("image/"))
                    {
                        newTicket.ImageUrl = result.Url;
                    }
                    else
                    {
                        newTicket.FileUrl = result.Url;
                        newTicket.FileName = result.Name;
                        newTicket.FileContentType = result.ContentType;
                    }
                    Toast.ShowInfo("فایل پیوست شد");
                }
            }
        }
        catch
        {
            Toast.ShowError("خطا در آپلود فایل");
        }
        isBusy = false;
    }

    private class UploadResult
    {
        public string Url { get; set; } = "";
        public string Name { get; set; } = "";
        public string ContentType { get; set; } = "";
    }

    private List<string> MissingProfileFields
    {
        get
        {
            var missing = new List<string>();
            if (string.IsNullOrWhiteSpace(user?.Email)) missing.Add("ایمیل");
            if (string.IsNullOrWhiteSpace(user?.PostalCode)) missing.Add("کد پستی");
            if (string.IsNullOrWhiteSpace(user?.Address)) missing.Add("آدرس پستی");
            return missing;
        }
    }

    private bool IsProfileIncomplete() => 
        string.IsNullOrWhiteSpace(user?.Email) || 
        string.IsNullOrWhiteSpace(user?.Address) || 
        string.IsNullOrWhiteSpace(user?.PostalCode);

    private async Task HandleUpdateProfile()
    {
        isBusy = true;
        var ok = await Auth.UpdateProfileAsync(updateModel);
        if (ok) {
            if (user != null)
            {
                user.FullName = updateModel.FullName;
                user.Email = updateModel.Email;
                user.Address = updateModel.Address;
                user.PostalCode = updateModel.PostalCode;
            }

            await InvokeAsync(StateHasChanged);
            await LoadUser();
            Toast.ShowSuccess("پروفایل با موفقیت بروزرسانی شد");
        } else {
            Toast.ShowError("خطا در بروزرسانی پروفایل");
        }
        isBusy = false;
    }

    private async Task HandleChangePassword()
    {
        isBusy = true;
        var (ok, error) = await Auth.ChangePasswordAsync(passwordModel);
        if (ok) {
            passwordModel = new();
            Toast.ShowSuccess("رمز عبور با موفقیت تغییر کرد");
        } else {
            Toast.ShowError(error ?? "خطا در تغییر رمز");
        }
        isBusy = false;
    }

    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();
        AuthStateProvider.NotifyAuthStateChanged();
        Nav.NavigateTo("/");
    }

    private string GetOrderStatusClass(OrderStatus status) => status switch {
        OrderStatus.PendingPayment => "bg-warning-subtle text-warning",
        OrderStatus.ReceiptUploaded => "bg-info-subtle text-info",
        OrderStatus.Approved => "bg-success-subtle text-success",
        OrderStatus.Rejected => "bg-danger-subtle text-danger",
        OrderStatus.Cancelled => "bg-secondary-subtle text-secondary",
        OrderStatus.Completed => "bg-success text-white",
        _ => "bg-light"
    };

    private string GetOrderStatusLabel(OrderStatus status) => status switch {
        OrderStatus.PendingPayment => "در انتظار پرداخت",
        OrderStatus.ReceiptUploaded => "رسید آپلود شد",
        OrderStatus.Approved => "تایید شده",
        OrderStatus.Rejected => "رد شده",
        OrderStatus.Cancelled => "لغو شده",
        OrderStatus.Completed => "تکمیل شده",
        _ => status.ToString()
    };

    private async Task SwitchTab(string tab)
    {
        activeTab = tab;
        selectedTicketForProfile = null;
        isCreatingNewTicket = false;
        if (tab == "orders" && !myOrders.Any()) {
            isLoadingOrders = true;
            try { myOrders = await Http.GetFromJsonAsync<List<OrderDto>>("api/orders/my") ?? new(); } catch {}
            isLoadingOrders = false;
        }
        else if (tab == "tickets" && !myTickets.Any()) {
            isLoadingTickets = true;
            try { myTickets = await Http.GetFromJsonAsync<List<ConsultationTicket>>("api/technical/tickets/my") ?? new(); } catch {}
            isLoadingTickets = false;
        }
    }

    private void ToggleOrder(int orderId)
    {
        if (!expandedOrders.Add(orderId))
            expandedOrders.Remove(orderId);
    }

    private static string FormatJalaliDateTime(DateTime dt)
    {
        if (dt == default || dt == DateTime.MinValue || dt.Year < 1000) return "---";
        var pc = new System.Globalization.PersianCalendar();
        try {
            var y = pc.GetYear(dt);
            var m = pc.GetMonth(dt);
            var d = pc.GetDayOfMonth(dt);
            return $"{dt:HH:mm}  {y:0000}/{m:00}/{d:00}";
        } catch {
            return "---";
        }
    }

    private string GetTicketStatusClass(ConsultationTicket ticket)
    {
        // Priority 1: If admin explicitly changed status (not Pending), use status color
        if (ticket.Status != TicketStatus.Pending)
        {
            return ticket.Status switch {
                TicketStatus.InProgress => "bg-warning text-dark",      // Orange - actively working
                TicketStatus.Resolved => "bg-success text-white",       // Green - done
                TicketStatus.Closed => "bg-dark text-white",            // Dark gray - closed
                _ => "bg-light text-dark"
            };
        }
        
        // Priority 2: If user hasn't read and last reply is from admin, highlight it urgent
        if (!ticket.IsUserRead && ticket.Replies.Any() && ticket.Replies.OrderByDescending(r => r.RepliedAt).First().IsAdmin)
            return "bg-danger text-white"; // Red - unread admin reply, needs attention
        
        // Priority 3: Pending status colors
        if (!ticket.Replies.Any())
            return "bg-secondary text-white"; // Gray - not reviewed yet
        
        var lastReply = ticket.Replies.OrderByDescending(r => r.RepliedAt).First();
        if (lastReply.IsAdmin)
            return "bg-info text-dark";      // Light blue - admin replied, user read
        else
            return "bg-primary text-white"; // Blue - user replied, waiting for admin
    }

    private string GetTicketStatusLabel(ConsultationTicket ticket)
    {
        // Priority 1: If admin explicitly changed status (not Pending), show that status
        if (ticket.Status != TicketStatus.Pending)
        {
            return ticket.Status switch {
                TicketStatus.InProgress => "در حال بررسی",
                TicketStatus.Resolved => "حل شده",
                TicketStatus.Closed => "بسته شده",
                _ => "نامشخص"
            };
        }
        
        // Priority 2: Pending status - check replies
        // If no replies yet
        if (!ticket.Replies.Any())
            return "بررسی نشده";
        
        // Get last reply
        var lastReply = ticket.Replies.OrderByDescending(r => r.RepliedAt).FirstOrDefault();
        if (lastReply != null)
        {
            if (lastReply.IsAdmin)
                return "پاسخ داده شده"; // Admin replied - waiting for user
            else
                return "پاسخ کاربر"; // User replied - waiting for admin
        }
        
        return "جدید";
    }
}
