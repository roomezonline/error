@page "/auth/login"
@using ErrorService.Shared
@inject ErrorService.Client.Services.AuthService Auth
@inject ErrorService.Client.Services.JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ErrorService.Client.Services.ToastService Toast
@using Microsoft.AspNetCore.Components
@using System.Security.Claims

<div class="container py-5 d-flex justify-content-center align-items-center min-vh-80" dir="rtl">
    <div class="auth-card p-4 rounded-5 shadow-lg bg-white w-100" style="max-width: 400px;">
        <div class="text-center mb-4">
            <div class="auth-logo mb-3">
                <span class="oi oi-lock-locked text-primary display-4"></span>
            </div>
            <h3 class="fw-black mb-1">ورود به حساب</h3>
            <p class="text-muted small">خوش آمدید! لطفا وارد حساب خود شوید</p>
        </div>

        <EditForm Model="model" OnValidSubmit="HandleLogin">
            <DataAnnotationsValidator />
            
            <div class="mb-3">
                <label class="form-label small fw-bold">شماره موبایل</label>
                <InputText @bind-Value="model.PhoneNumber" class="form-control auth-input rounded-pill px-4 py-2" placeholder="09xxxxxxxxx" />
                <ValidationMessage For="@(() => model.PhoneNumber)" class="text-danger small" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-bold">رمز عبور</label>
                <InputText @bind-Value="model.Password" type="password" class="form-control auth-input rounded-pill px-4 py-2" placeholder="••••" />
                <ValidationMessage For="@(() => model.Password)" class="text-danger small" />
            </div>

            <button type="submit" class="btn btn-primary w-100 rounded-pill py-2 fw-bold shadow-sm" disabled="@isBusy">
                @if (isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                ورود به پنل
            </button>
        </EditForm>

        <div class="text-center mt-4 border-top pt-3">
            <span class="text-muted small">حساب ندارید؟</span>
            <a href="/auth/register" class="text-primary fw-bold small text-decoration-none ms-1">ثبت‌نام سریع</a>
        </div>
    </div>
</div>

<style>
    .auth-card { border: 1px solid rgba(0,0,0,0.05); }
    .auth-input { background: #f8fafc; border: 1px solid #e2e8f0; }
    .auth-input:focus { background: #fff; box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.1); }
    .fw-black { font-weight: 900; }
</style>

@code {
    private LoginRequest model = new();
    private bool isBusy = false;
    [SupplyParameterFromQuery] public string? returnUrl { get; set; }

    private async Task HandleLogin()
    {
        isBusy = true;
        try
        {
            var result = await Auth.UnifiedLoginAsync(model);
            AuthStateProvider.NotifyAuthStateChanged();
            Toast.ShowSuccess("با موفقیت وارد شدید");
            if (!string.IsNullOrWhiteSpace(returnUrl) && returnUrl.StartsWith("/"))
            {
                Nav.NavigateTo(returnUrl);
            }
            else if (result.UserType == "workshop")
            {
                Nav.NavigateTo("/admin");
            }
            else
            {
                var token = await Auth.GetTokenAsync();
                var identity = string.IsNullOrWhiteSpace(token)
                    ? new ClaimsIdentity()
                    : ErrorService.Client.Services.JwtParser.ParseClaimsFromJwt(token);

                var isNonMember =
                    identity.Claims.Any(c => c.Type == ClaimTypes.Role && string.Equals(c.Value, "super_admin", StringComparison.OrdinalIgnoreCase)) ||
                    identity.Claims.Any(c => c.Type == ClaimTypes.Role) ||
                    identity.Claims.Any(c => string.Equals(c.Type, "perm", StringComparison.OrdinalIgnoreCase));

                Nav.NavigateTo(isNonMember ? "/admin" : "/profile");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
