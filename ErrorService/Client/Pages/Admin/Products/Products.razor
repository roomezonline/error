    /* ناوبری مرحله‌ای انتهای فرم: مرحله قبلی/بعدی (با عنوان تب) کنار انصراف و ذخیره */
    .pe-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }
    .pe-footer__nav { display: flex; gap: 10px; flex-wrap: wrap; }
    .pe-footer__actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .pe-step {
        display: inline-flex;
