    /* Modal Styles */
    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(4px);
        z-index: 2000;
        display: grid;
        place-items: center;
        padding: 16px;
    }

    .modal-content {
        background: var(--wr-surface);
