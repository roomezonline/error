            if (resp.IsSuccessStatusCode)
            {
                all?.RemoveAll(x => x.Id == id);
                filtered?.RemoveAll(x => x.Id == id);
                ToastService.ShowSuccess("رسید با موفقیت حذف شد.");
                StateHasChanged();
