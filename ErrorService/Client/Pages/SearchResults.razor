@page "/search"
@using ErrorService.Shared
@inject HttpClient Http
@inject NavigationManager Nav

<PageTitle>نتایج جستجو | ارورسرویس</PageTitle>

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<div class="container py-4" dir="rtl">
    <div class="mb-5 text-center">
        <h2 class="fw-black text-primary mb-2">نتایج جستجو</h2>
        <p class="text-muted">برای عبارت: <span class="fw-bold text-dark">"@Query"</span></p>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">در حال جستجو در پلتفرم...</p>
        </div>
    }
    else if (results == null || (results.Products.Count == 0 && results.ErrorCodes.Count == 0 && results.Courses.Count == 0 && results.News.Count == 0))
    {
        <div class="empty-state-box">
            <span class="empty-icon oi oi-magnifying-glass"></span>
            <h4>نتیجه‌ای یافت نشد</h4>
            <p>متاسفانه موردی با عبارت "@Query" یافت نشد. لطفاً عبارت دیگری را امتحان کنید.</p>
            <a href="/" class="btn btn-outline-primary rounded-pill px-4">بازگشت به صفحه اصلی</a>
        </div>
    }
    else
    {
        <!-- Tabs for Search Categories -->
        <div class="d-flex gap-2 overflow-auto pb-3 mb-4 no-scrollbar border-bottom">
            <button class="btn @(activeTab == "all" ? "btn-primary" : "btn-light") rounded-pill px-4 text-nowrap" @onclick='() => activeTab = "all"'>همه (@TotalCount)</button>
            @if (results.Products.Any()) { <button class="btn @(activeTab == "products" ? "btn-primary" : "btn-light") rounded-pill px-4 text-nowrap" @onclick='() => activeTab = "products"'>محصولات (@results.Products.Count)</button> }
            @if (results.ErrorCodes.Any()) { <button class="btn @(activeTab == "errors" ? "btn-primary" : "btn-light") rounded-pill px-4 text-nowrap" @onclick='() => activeTab = "errors"'>کدهای خطا (@results.ErrorCodes.Count)</button> }
            @if (results.Courses.Any()) { <button class="btn @(activeTab == "courses" ? "btn-primary" : "btn-light") rounded-pill px-4 text-nowrap" @onclick='() => activeTab = "courses"'>آموزش‌ها (@results.Courses.Count)</button> }
            @if (results.News.Any()) { <button class="btn @(activeTab == "news" ? "btn-primary" : "btn-light") rounded-pill px-4 text-nowrap" @onclick='() => activeTab = "news"'>اخبار (@results.News.Count)</button> }
        </div>

        <div class="row g-4">
            @if (activeTab == "all" || activeTab == "products")
            {
                @foreach (var item in results.Products)
                {
                    <div class="col-md-6 col-lg-4">
                        <a href="@item.Url" class="search-result-card p-3 rounded-4 shadow-sm border bg-white d-flex align-items-center gap-3 text-decoration-none text-dark">
                            <div class="icon-box bg-success-subtle text-success rounded-3"><span class="oi oi-box"></span></div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="fw-bold mb-1 text-truncate">@item.Title</h6>
                                <span class="smaller text-muted">در دسته: @item.Subtitle</span>
                            </div>
                            <span class="oi oi-chevron-left text-muted small"></span>
                        </a>
                    </div>
                }
            }

            @if (activeTab == "all" || activeTab == "errors")
            {
                @foreach (var item in results.ErrorCodes)
                {
                    <div class="col-md-6 col-lg-4">
                        <a href="@item.Url" class="search-result-card p-3 rounded-4 shadow-sm border bg-white d-flex align-items-center gap-3 text-decoration-none text-dark">
                            <div class="icon-box bg-primary-subtle text-primary rounded-3"><span class="oi oi-magnifying-glass"></span></div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="fw-bold mb-1 text-truncate">@item.Title</h6>
                                <p class="smaller text-muted text-truncate mb-0">@item.Subtitle</p>
                            </div>
                            <span class="oi oi-chevron-left text-muted small"></span>
                        </a>
                    </div>
                }
            }

            @if (activeTab == "all" || activeTab == "courses")
            {
                @foreach (var item in results.Courses)
                {
                    <div class="col-md-6 col-lg-4">
                        <a href="@item.Url" class="search-result-card p-3 rounded-4 shadow-sm border bg-white d-flex align-items-center gap-3 text-decoration-none text-dark">
                            <div class="icon-box bg-warning-subtle text-warning rounded-3"><span class="oi oi-book"></span></div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="fw-bold mb-1 text-truncate">@item.Title</h6>
                                <p class="smaller text-muted text-truncate mb-0">@item.Subtitle</p>
                            </div>
                            <span class="oi oi-chevron-left text-muted small"></span>
                        </a>
                    </div>
                }
            }

            @if (activeTab == "all" || activeTab == "news")
            {
                @foreach (var item in results.News)
                {
                    <div class="col-md-6 col-lg-4">
                        <a href="@item.Url" class="search-result-card p-3 rounded-4 shadow-sm border bg-white d-flex align-items-center gap-3 text-decoration-none text-dark">
                            <div class="icon-box bg-danger-subtle text-danger rounded-3"><span class="oi oi-list"></span></div>
                            <div class="flex-grow-1 overflow-hidden">
                                <h6 class="fw-bold mb-1 text-truncate">@item.Title</h6>
                                <p class="smaller text-muted text-truncate mb-0">@item.Subtitle</p>
                            </div>
                            <span class="oi oi-chevron-left text-muted small"></span>
                        </a>
                    </div>
                }
            }
        </div>
    }
</div>

<style>
    .fw-black { font-weight: 900; }
    .smaller { font-size: 0.75rem; }
    .icon-box { width: 48px; height: 48px; display: grid; place-items: center; font-size: 1.25rem; flex-shrink: 0; }
    .search-result-card { transition: all 0.2s ease; }
    .search-result-card:hover { transform: translateY(-3px); border-color: var(--app-primary) !important; box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important; }
    .bg-primary-subtle { background: rgba(37, 99, 235, 0.1); }
    .bg-success-subtle { background: rgba(16, 185, 129, 0.1); }
    .bg-warning-subtle { background: rgba(245, 158, 11, 0.1); }
    .bg-danger-subtle { background: rgba(239, 68, 68, 0.1); }
    .no-scrollbar::-webkit-scrollbar { display: none; }
</style>

@code {
    [Parameter] [SupplyParameterFromQuery(Name = "q")] public string Query { get; set; } = "";
    
    private SearchResponseDto? results;
    private bool isLoading = true;
    private string activeTab = "all";

    protected override async Task OnParametersSetAsync()
    {
        if (string.IsNullOrWhiteSpace(Query))
        {
            results = new();
            isLoading = false;
            return;
        }

        isLoading = true;
        try
        {
            results = await Http.GetFromJsonAsync<SearchResponseDto>($"api/search?q={Uri.EscapeDataString(Query)}");
        }
        catch { results = new(); }
        isLoading = false;
    }

    private int TotalCount => (results?.Products.Count ?? 0) + (results?.ErrorCodes.Count ?? 0) + (results?.Courses.Count ?? 0) + (results?.News.Count ?? 0);
}
