    private async Task RunBulk(string action)
    {
        if (selectedIds.Count == 0) return;

        var label = action switch
        {
            "publish" => "انتشار",
            "unpublish" => "لغو انتشار",
            "archive" => "آرشیو",
            _ => "حذف"
        };

        var confirmed = await JS.InvokeAsync<bool>("confirm", $"{label} {selectedIds.Count} مورد انتخاب‌شده انجام شود؟");
        if (!confirmed) return;

        try
        {
            var request = new ContentBulkRequest { Ids = selectedIds.ToList(), Action = action };
            var resp = await Http.PostAsJsonAsync("api/news/bulk", request);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess($"{selectedIds.Count} مورد {label} شد.");
                selectedIds.Clear();
                await LoadNews();
            }
            else
            {
                ToastService.ShowError("عملیات گروهی ناموفق بود.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
    }

