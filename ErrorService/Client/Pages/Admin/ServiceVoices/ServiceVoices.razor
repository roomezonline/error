    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
    }

    private sealed class VoiceUploadResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string? Body { get; set; }
    }

    /// <summary>گروه رویدادهای یک رسید مشتری برای نمایش بازشونده در فهرست.</summary>
    private sealed class EventGroup
    {
        public string Key { get; init; } = string.Empty;
        public string Title { get; init; } = string.Empty;
        public string? CustomerName { get; init; }
        public bool IsOpen { get; init; }
        public string RangeLabel { get; init; } = string.Empty;
        public List<ServiceVoiceEventLogDto> Events { get; init; } = new();
    }
