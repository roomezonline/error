    private async Task CheckMonitoringStatus()
    {
        try
        {
            var resp = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/monitoring/chart/{Id}/connection-info");
            if (resp.TryGetProperty("isActive", out var active))
                _monitoringEnded = !active.GetBoolean();
            if (_monitoringEnded)
            {
                if (resp.TryGetProperty("endedAtFa", out var ended) && ended.ValueKind == System.Text.Json.JsonValueKind.String)
                    _monitoringEndedAtFa = ended.GetString();
                if (resp.TryGetProperty("endReason", out var reason) && reason.ValueKind == System.Text.Json.JsonValueKind.String)
                    _monitoringEndReason = reason.GetString();
            }
            if (resp.TryGetProperty("createdAt", out var ca) && ca.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var caStr = ca.GetString();
                if (DateTime.TryParse(caStr, CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal, out var caDt))
                    _monitoringCreatedAt = caDt;
            }
            if (resp.TryGetProperty("createdAtFa", out var caf) && caf.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                _monitoringCreatedAtFa = caf.GetString() ?? "";
                _startParts = _monitoringCreatedAtFa.Split(' ', 2);
            }

            if (resp.TryGetProperty("isPoweredOn", out var power) && power.ValueKind == System.Text.Json.JsonValueKind.True)
                _isPoweredOn = true;
            else
                _isPoweredOn = false;

            if (resp.TryGetProperty("gracePeriodEndAt", out var gpe) && gpe.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                var gpStr = gpe.GetString();
                if (DateTime.TryParse(gpStr, CultureInfo.InvariantCulture, DateTimeStyles.AdjustToUniversal, out var gpDt))
                {
                    _gracePeriodEndAt = gpDt;
                    _inGracePeriod = gpDt > DateTime.UtcNow;
                    if (_inGracePeriod)
                    {
                        _graceRemaining = gpDt - DateTime.UtcNow;
                        StartGraceTimer();
                    }
                    else
                    {
                        _inGracePeriod = false;
                        _graceTimer?.Dispose();
                        _graceTimer = null;
                    }
                }
            }
            else
            {
                _inGracePeriod = false;
                _graceTimer?.Dispose();
                _graceTimer = null;
            }

            UpdateElapsedLabels();
        }
        catch { }
    }

    private void StartGraceTimer()
    {
        _graceTimer?.Dispose();
        _graceTimer = new Timer(_ =>
        {
            if (_disposed) return;
            _ = InvokeAsync(() =>
            {
                if (_gracePeriodEndAt == null) return;
                _graceRemaining = _gracePeriodEndAt.Value - DateTime.UtcNow;
                if (_graceRemaining <= TimeSpan.Zero)
                {
                    _inGracePeriod = false;
                    _graceRemaining = TimeSpan.Zero;
                    _graceTimer?.Dispose();
                    _graceTimer = null;
                }
            });
        }, null, 0, 1000);
    }

    private void UpdateElapsedLabels()
    {
        if (_monitoringCreatedAt == null)
        {
            _elapsedLabel = "";
            return;
        }
        var elapsed = DateTime.UtcNow - _monitoringCreatedAt.Value;
        var totalHours = elapsed.TotalHours;

        if (totalHours < 1)
            _elapsedLabel = ToPersian($"{(int)elapsed.TotalMinutes} دقیقه");
        else if (totalHours < 24)
            _elapsedLabel = ToPersian($"{(int)totalHours} ساعت و {elapsed.Minutes} دقیقه");
        else
            _elapsedLabel = ToPersian($"{(int)(totalHours / 24)} روز و {(int)(totalHours % 24)} ساعت و {elapsed.Minutes} دقیقه");
    }

    private static string ToPersian(string input)
    {
        var chars = input.ToCharArray();
        for (int i = 0; i < chars.Length; i++)
        {
            if (chars[i] >= '0' && chars[i] <= '9')
                chars[i] = (char)('۰' + (chars[i] - '0'));
        }
        return new string(chars);
    }

