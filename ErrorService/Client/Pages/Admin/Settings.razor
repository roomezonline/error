    private void ApplyRecommendedLayout()
    {
        if (settings?.HomeModules == null) return;

        var position = new Dictionary<int, int>();
        for (var i = 0; i < RecommendedHomeOrder.Length; i++)
            position[(int)RecommendedHomeOrder[i]] = (i + 1) * 10;

        var tail = position.Count * 10;
        foreach (var module in settings.HomeModules)
        {
            if (position.TryGetValue((int)module.Key, out var sortOrder))
                module.SortOrder = sortOrder;
            else
                module.SortOrder = tail += 10;
        }

        settings.HomeModules = settings.HomeModules.OrderBy(x => x.SortOrder).ToList();
        ToastService.ShowSuccess("چیدمان پیشنهادی اعمال شد؛ برای ثبت، تنظیمات را ذخیره کنید.");
    }

    private void SetModuleTitle(SiteHomeModuleDto module, string? title)
        => module.Title = HomeSectionTitles.Normalize(title);

    private void MoveModule(SiteHomeModuleKey key, int direction)
    {
        if (settings?.HomeModules == null || settings.HomeModules.Count < 2) return;

        var ordered = settings.HomeModules.OrderBy(x => x.SortOrder).ToList();
        var idx = ordered.FindIndex(x => x.Key == key);
        if (idx < 0) return;

        var newIdx = idx + direction;
        if (newIdx < 0 || newIdx >= ordered.Count) return;

        var a = ordered[idx];
        var b = ordered[newIdx];

        (a.SortOrder, b.SortOrder) = (b.SortOrder, a.SortOrder);
    }

