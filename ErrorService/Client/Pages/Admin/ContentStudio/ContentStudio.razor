@page "/admin/content-studio"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.contentstudio.view")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using ErrorService.Client.Services
@using ErrorService.Client.Utils
@implements IDisposable
@inject HttpClient Http
@inject ToastService Toast
@inject IJSRuntime JS

<PageTitle>استودیوی محتوا | ارورسرویس</PageTitle>

<ConfirmDialog IsVisible="_showSourceDeleteConfirm"
               Title="حذف منبع"
               Message="منبع و همه آیتم‌های در صف آن حذف می‌شوند. اخبار منتشرشده در سایت باقی می‌مانند. ادامه می‌دهید؟"
               ConfirmText="حذف منبع"
               OnResult="HandleSourceDelete" />

<ConfirmDialog IsVisible="_showItemDeleteConfirm"
               Title="حذف آیتم"
               Message="این آیتم از صف استودیو حذف می‌شود. خبر منتشرشده (در صورت وجود) حذف نمی‌شود."
               ConfirmText="حذف آیتم"
               OnResult="HandleItemDelete" />

<div class="admin-container" dir="rtl">

    <div class="cs-hero">
        <div class="cs-hero__text">
            <h3 class="admin-page-title m-0">استودیوی محتوا</h3>
            <p class="text-muted small m-0">دریافت از فیدهای مجاز، بازنویسی با هوش مصنوعی، کنترل تکرار و انتشار خودکار در بخش اخبار.</p>
        </div>
        <div class="cs-hero__actions">
            @if (_overview != null)
            {
                <span class="cs-pill @(_overview.Settings.Enabled ? "cs-pill--on" : "cs-pill--off")">
                    <span class="cs-dot"></span>
                    @(_overview.Settings.Enabled ? "زمان‌بندی فعال" : "زمان‌بندی غیرفعال")
                </span>
                <span class="cs-pill @(_overview.Settings.UseAiRewrite && _overview.Ai.Configured ? "cs-pill--on" : "cs-pill--warn")" title="@_overview.Ai.Message">
                    <span class="oi oi-lightbulb"></span>
                    @(_overview.Settings.UseAiRewrite
                        ? (_overview.Ai.Configured ? "AI آماده" : "AI تنظیم نشده")
                        : "حالت پیش‌نویس دستی")
                </span>
            }
            <AuthorizeView Policy="perm:admin.contentstudio.manage">
                <button class="btn btn-primary rounded-3 shadow-sm" @onclick="RunNow" disabled="@(_overview?.Progress.IsRunning == true || _runStarting)">
                    @if (_runStarting)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    else
                    {
                        <span class="oi oi-media-play me-1"></span>
                    }
                    اجرای دستی
                </button>
            </AuthorizeView>
            <a href="/admin/ai" class="btn btn-outline-secondary rounded-3">
                <span class="oi oi-cog me-1"></span> تنظیم هوش مصنوعی
            </a>
        </div>
    </div>

    @if (_overview == null)
    {
        <div class="cs-empty">
            <div class="spinner-border text-primary"></div>
            <div>در حال دریافت وضعیت استودیو…</div>
        </div>
    }
    else
    {
        @if (_overview.Progress.IsRunning)
        {
            <div class="cs-progress">
                <div class="cs-progress__head">
                    <span class="fw-bold"><span class="oi oi-loop-circular me-1"></span> اجرای در جریان</span>
                    <span class="small text-muted">@(_overview.Progress.CurrentSource ?? "—")</span>
                </div>
                <div class="cs-progress__stage">@(_overview.Progress.Stage ?? "شروع…")</div>
                <div class="cs-progress__bar">
                    <span style="width:@(ProgressPercent)%"></span>
                </div>
                <div class="cs-progress__meta">
                    <span>@_overview.Progress.Processed از @_overview.Progress.Total منبع</span>
                    <span class="cs-status cs-status--processing">در حال پردازش</span>
                </div>
            </div>
        }
        else if (_overview.Settings.LastRunAt.HasValue)
        {
            <div class="cs-lastrun">
                <div class="cs-lastrun__icon @RunStatusClass(_overview.Settings.LastRunStatus)">
                    <span class="oi @(_overview.Settings.LastRunStatus == "success" ? "oi-check" : "oi-warning")"></span>
                </div>
                <div class="cs-lastrun__body">
                    <div class="fw-bold">آخرین اجرا: @PersianDate.ToJalaliDateTime(_overview.Settings.LastRunAt.Value)</div>
                    <div class="small text-muted">@_overview.Settings.LastRunSummary</div>
                </div>
                <span class="cs-status @RunStatusClass(_overview.Settings.LastRunStatus)">@RunStatusLabel(_overview.Settings.LastRunStatus)</span>
            </div>
        }

        @if (!_overview.Ai.Configured)
        {
            <div class="cs-alert">
                <span class="oi oi-info"></span>
                <div>
                    <div class="fw-bold">هوش مصنوعی تنظیم نشده است — استودیو در حالت پیش‌نویس دستی کار می‌کند</div>
                    <div class="small">فیدها دریافت می‌شوند و متن منبع به‌صورت پیش‌نویس آماده در صف بازبینی قرار می‌گیرد؛ شما آن را ویرایش و منتشر می‌کنید. برای بازنویسی خودکار، در «تنظیمات هوش مصنوعی» زنجیره ارائه‌دهنده/کلید/مدل را ثبت کنید و کاربرد «استودیوی محتوا» را فعال کنید.</div>
                </div>
                <a href="/admin/ai" class="btn btn-sm btn-outline-primary rounded-3">رفتن به تنظیمات</a>
            </div>
        }

        <div class="cs-tabs">
            <button class="cs-tab @(_activeTab == "queue" ? "active" : "")" @onclick='() => SwitchTab("queue")'>
                <span class="oi oi-inbox"></span> صف بازبینی
                @if (QueueBadge > 0)
                {
                    <span class="cs-tab__count">@QueueBadge</span>
                }
            </button>
            <button class="cs-tab @(_activeTab == "sources" ? "active" : "")" @onclick='() => SwitchTab("sources")'>
                <span class="oi oi-rss"></span> منابع
                <span class="cs-tab__count">@_overview.Stats.EnabledSources</span>
            </button>
            <button class="cs-tab @(_activeTab == "settings" ? "active" : "")" @onclick='() => SwitchTab("settings")'>
                <span class="oi oi-sliders"></span> تنظیمات
            </button>
            <button class="cs-tab @(_activeTab == "runs" ? "active" : "")" @onclick='() => SwitchTab("runs")'>
                <span class="oi oi-clock"></span> گزارش اجرا
            </button>
        </div>

        <div class="cs-stats">
            <div class="cs-stat">
                <span class="cs-stat__num">@_overview.Stats.Ready</span>
                <span class="cs-stat__label">آماده بازبینی</span>
            </div>
            <div class="cs-stat">
                <span class="cs-stat__num">@_overview.Stats.Published</span>
                <span class="cs-stat__label">منتشرشده</span>
            </div>
            <div class="cs-stat">
                <span class="cs-stat__num">@_overview.Stats.TodayPublished</span>
                <span class="cs-stat__label">امروز</span>
            </div>
            <div class="cs-stat">
                <span class="cs-stat__num">@_overview.Stats.Duplicate</span>
                <span class="cs-stat__label">تکراری</span>
            </div>
            <div class="cs-stat">
                <span class="cs-stat__num">@_overview.Stats.Failed</span>
                <span class="cs-stat__label">خطا</span>
            </div>
        </div>

        @* ================= صف بازبینی ================= *@
        @if (_activeTab == "queue")
        {
            <div class="cs-panel">
                <div class="cs-toolbar">
                    <div class="cs-chips">
                        @foreach (var chip in QueueStatuses)
                        {
                            <button class="cs-chip @(_statusFilter == chip.Value ? "active" : "")" @onclick='() => FilterStatus(chip.Value)'>
                                @chip.Label
                                <span class="cs-chip__count">@CountFor(chip.Value)</span>
                            </button>
                        }
                    </div>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <div class="input-group cs-search">
                            <span class="input-group-text bg-white border-end-0"><span class="oi oi-magnifying-glass"></span></span>
                            <input type="text" class="form-control border-start-0" placeholder="جستجو در عنوان…" value="@_searchQuery" @oninput="OnSearchInput" />
                        </div>
                        <button class="btn btn-outline-secondary rounded-3" @onclick="() => LoadItems()" title="به‌روزرسانی">
                            <span class="oi oi-reload"></span>
                        </button>
                    </div>
                </div>

                @if (_loadingItems)
                {
                    <div class="cs-empty"><div class="spinner-border text-primary border-2"></div></div>
                }
                else if (_items == null || _items.Items.Count == 0)
                {
                    <div class="cs-empty">
                        <span class="oi oi-inbox"></span>
                        <div class="fw-bold">آیتمی در این وضعیت نیست</div>
                        <div class="small text-muted">یک منبع اضافه کنید یا اجرای دستی را شروع کنید.</div>
                    </div>
                }
                else
                {
                    @foreach (var item in _items.Items)
                    {
                        <div class="cs-item">
                            <div class="cs-item__main">
                                <div class="cs-item__title">@(string.IsNullOrWhiteSpace(item.GeneratedTitle) ? item.OriginalTitle : item.GeneratedTitle)</div>
                                <div class="cs-item__meta">
                                    <span class="cs-status @StatusClass(item.Status)">@StatusLabel(item.Status)</span>
                                    @if (item.IsManualDraft)
                                    {
                                        <span class="cs-tag cs-tag--muted">پیش‌نویس دستی</span>
                                    }
                                    <span class="cs-meta-dot"></span>
                                    <span>@item.SourceName</span>
                                    <span class="cs-meta-dot"></span>
                                    <span>@CategoryLabel(item.Category)</span>
                                    <span class="cs-meta-dot"></span>
                                    <span>@PersianDate.ToJalaliDateTime(item.CreatedAt)</span>
                                    @if (!string.IsNullOrWhiteSpace(item.GeneratedTags))
                                    {
                                        <span class="cs-meta-dot"></span>
                                        <span>@item.GeneratedTags</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.GeneratedSummary))
                                {
                                    <div class="cs-item__summary">@item.GeneratedSummary</div>
                                }
                                else if (!string.IsNullOrWhiteSpace(item.OriginalSummary))
                                {
                                    <div class="cs-item__summary">@item.OriginalSummary</div>
                                }

                                <div class="cs-metrics">
                                    @if (item.CopyOverlapPercent.HasValue)
                                    {
                                        <span class="cs-metric">هم‌پوشانی متن با منبع: @Math.Round(item.CopyOverlapPercent.Value)٪</span>
                                    }
                                    @if (item.TitleSimilarity.HasValue)
                                    {
                                        <span class="cs-metric">تشابه عنوان: @Math.Round(item.TitleSimilarity.Value * 100)٪</span>
                                    }
                                    @if (item.SourcePublishedAt.HasValue)
                                    {
                                        <span class="cs-metric">انتشار منبع: @PersianDate.ToJalaliDate(item.SourcePublishedAt.Value)</span>
                                    }
                                    @if (item.NewsId.HasValue)
                                    {
                                        <a class="cs-metric cs-metric--link" href="/news/@item.NewsId" target="_blank">
                                            @(item.NewsIsPublished ? "مشاهده خبر" : "پیش‌نویس خبر")
                                        </a>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.StatusDetail))
                                {
                                    <div class="cs-item__note">@item.StatusDetail</div>
                                }
                            </div>

                            <div class="cs-item__actions">
                                @if (!string.IsNullOrWhiteSpace(item.GeneratedContent))
                                {
                                    <button class="cs-btn cs-btn--soft" @onclick="() => OpenPreview(item.Id)">
                                        <span class="oi oi-eye"></span> پیش‌نمایش
                                    </button>
                                }
                                <a class="cs-btn cs-btn--ghost" href="@item.SourceUrl" target="_blank" rel="noopener noreferrer">
                                    <span class="oi oi-external-link"></span> منبع
                                </a>

                                <AuthorizeView Policy="perm:admin.contentstudio.manage">
                                    @if (!item.NewsId.HasValue)
                                    {
                                        <button class="cs-btn cs-btn--soft" @onclick="() => OpenDraftEditor(item.Id)" disabled="@(_actionBusyId == item.Id)">
                                            <span class="oi oi-pencil"></span> ویرایش/تکمیل دستی
                                        </button>
                                    }
                                    @if (item.Status is "Pending" or "Failed" or "Rejected")
                                    {
                                        <button class="cs-btn cs-btn--primary" @onclick="() => RewriteItem(item.Id)" disabled="@(_overview.Progress.IsRunning || _actionBusyId == item.Id)">
                                            <span class="oi oi-loop"></span> بازنویسی
                                        </button>
                                    }
                                    @if (item.Status == "Ready")
                                    {
                                        <button class="cs-btn cs-btn--primary" @onclick="() => PublishItem(item.Id, false)" disabled="@(_overview.Progress.IsRunning || _actionBusyId == item.Id)">
                                            <span class="oi oi-check"></span> انتشار
                                        </button>
                                        <button class="cs-btn cs-btn--soft" @onclick="() => PublishItem(item.Id, true)" disabled="@(_overview.Progress.IsRunning || _actionBusyId == item.Id)">
                                            <span class="oi oi-document"></span> پیش‌نویس
                                        </button>
                                        <button class="cs-btn cs-btn--ghost" @onclick="() => RejectItem(item.Id)" disabled="@(_overview.Progress.IsRunning || _actionBusyId == item.Id)">
                                            <span class="oi oi-x"></span> رد
                                        </button>
                                    }
                                    @if (item.Status is not ("Published" or "Rejected"))
                                    {
                                        <button class="cs-btn cs-btn--danger" @onclick="() => AskDeleteItem(item.Id)">
                                            <span class="oi oi-trash"></span> حذف
                                        </button>
                                    }
                                </AuthorizeView>
                            </div>
                        </div>
                    }

                    <div class="cs-pager">
                        <span class="small text-muted">@_items.Total آیتم</span>
                        <div class="d-flex gap-2 align-items-center">
                            <button class="btn btn-sm btn-outline-secondary rounded-3" disabled="@(_page <= 1)" @onclick="PrevPage">قبلی</button>
                            <span class="small">صفحه @_page از @TotalPages</span>
                            <button class="btn btn-sm btn-outline-secondary rounded-3" disabled="@(_page >= TotalPages)" @onclick="NextPage">بعدی</button>
                        </div>
                    </div>
                }
            </div>
        }

        @* ================= منابع ================= *@
        @if (_activeTab == "sources")
        {
            <div class="cs-panel">
                <div class="cs-toolbar mb-3">
                    <div>
                        <div class="fw-bold">منابع فید</div>
                        <div class="small text-muted">آدرس سایت را بدهید تا فید RSS/Atom خودکار پیدا شود؛ فید اختیاری است. محتوا با AI بازنویسی می‌شود یا (در حالت بدون AI) به پیش‌نویس دستی تبدیل می‌شود.</div>
                    </div>
                    <AuthorizeView Policy="perm:admin.contentstudio.manage">
                        <button class="btn btn-primary rounded-3" @onclick="NewSource">
                            <span class="oi oi-plus me-1"></span> منبع جدید
                        </button>
                    </AuthorizeView>
                </div>

                @if (_sources != null)
                {
                    <div class="cs-panel cs-suggest">
                        <div class="cs-toolbar">
                            <div>
                                <div class="fw-bold">۱۰ منبع پیشنهادی</div>
                                <div class="small text-muted">
                                    منابع معتبر خبر دیجیتال، ترفند، آموزش و الکترونیک که فیدشان بررسی شده است. هر منبع را جدا یا همه را یک‌جا اضافه کنید؛ بعد از افزودن قابل ویرایش، غیرفعال‌سازی و حذف است.
                                </div>
                            </div>
                            <AuthorizeView Policy="perm:admin.contentstudio.manage">
                                <button class="btn btn-outline-primary rounded-3" @onclick="AddAllSuggested" disabled="@(_addingSuggested || MissingSuggestedCount == 0)">
                                    @if (_addingSuggested)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    else
                                    {
                                        <span class="oi oi-plus me-1"></span>
                                    }
                                    افزودن همه (@MissingSuggestedCount)
                                </button>
                            </AuthorizeView>
                        </div>

                        <div class="cs-suggest__grid">
                            @foreach (var preset in SuggestedSources)
                            {
                                var added = IsSuggestedAdded(preset);
                                <div class="cs-suggest__item @(added ? "is-added" : "")">
                                    <div class="min-w-0">
                                        <div class="cs-suggest__name">
                                            @preset.Name
                                            <span class="cs-tag">@CategoryLabel(preset.Category)</span>
                                        </div>
                                        <div class="cs-suggest__hint">@preset.Hint</div>
                                        <div class="cs-mono" dir="ltr">@preset.FeedUrl</div>
                                    </div>
                                    <AuthorizeView Policy="perm:admin.contentstudio.manage">
                                        <button class="cs-btn cs-btn--soft" @onclick="() => AddSuggested(preset)" disabled="@(added || _addingSuggested)">
                                            @(added ? "اضافه شده" : "افزودن")
                                        </button>
                                    </AuthorizeView>
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (_sources == null)
                {
                    <div class="cs-empty"><div class="spinner-border text-primary border-2"></div></div>
                }
                else if (_sources.Count == 0)
                {
                    <div class="cs-empty">
                        <span class="oi oi-rss"></span>
                        <div class="fw-bold">هنوز منبعی ثبت نشده است</div>
                        <div class="small text-muted">برای شروع، آدرس فید یک سایت خبری یا فنی معتبر را اضافه کنید.</div>
                    </div>
                }
                else
                {
                    @foreach (var source in _sources)
                    {
                        <div class="cs-source">
                            <div class="cs-source__head">
                                <div class="min-w-0">
                                    <div class="fw-bold d-flex align-items-center gap-2 flex-wrap">
                                        @source.Name
                                        <span class="cs-status @(source.Enabled ? "cs-status--published" : "cs-status--skipped")">@(source.Enabled ? "فعال" : "غیرفعال")</span>
                                        <span class="cs-tag">@CategoryLabel(source.Category)</span>
                                        @if (source.AutoPublishMode == "Never")
                                        {
                                            <span class="cs-tag cs-tag--muted">بدون انتشار خودکار</span>
                                        }
                                    </div>
                                    <div class="cs-mono" dir="ltr">@source.FeedUrl</div>
                                </div>
                                <div class="cs-source__actions">
                                    <AuthorizeView Policy="perm:admin.contentstudio.manage">
                                        <button class="cs-btn cs-btn--soft" @onclick="() => FetchSourceNow(source.Id)" disabled="@(_overview.Progress.IsRunning || _sourceBusyId == source.Id)">
                                            <span class="oi oi-cloud-download"></span> دریافت الان
                                        </button>
                                        <button class="cs-btn cs-btn--ghost" @onclick="() => EditSource(source)">
                                            <span class="oi oi-pencil"></span> ویرایش
                                        </button>
                                        <button class="cs-btn cs-btn--danger" @onclick="() => AskDeleteSource(source)">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    </AuthorizeView>
                                </div>
                            </div>

                            <div class="cs-source__grid">
                                <div><span class="text-muted">سهمیه روز</span><div class="fw-bold">@source.MaxItemsPerDay</div></div>
                                <div><span class="text-muted">در صف</span><div class="fw-bold">@source.PendingCount</div></div>
                                <div><span class="text-muted">منتشرشده</span><div class="fw-bold">@source.PublishedCount</div></div>
                                <div><span class="text-muted">آخرین دریافت</span><div class="fw-bold">@(source.LastFetchedAt.HasValue ? PersianDate.ToJalaliDateTime(source.LastFetchedAt.Value) : "—")</div></div>
                                <div><span class="text-muted">تصویر</span><div class="fw-bold">@ImageModeLabel(source.ImageMode)</div></div>
                            </div>

                            @if (!string.IsNullOrWhiteSpace(source.LastError))
                            {
                                <div class="cs-item__note cs-item__note--danger">آخرین خطا: @source.LastError</div>
                            }
                        </div>
                    }
                }
            </div>
        }

        @* ================= تنظیمات ================= *@
        @if (_activeTab == "settings" && _settings != null)
        {
            <div class="cs-settings-grid">
                <div class="cs-panel">
                    <div class="cs-card-title">
                        <span class="oi oi-lightbulb"></span> وضعیت هوش مصنوعی
                    </div>
                    <div class="cs-ai-box @(_overview.Ai.Configured ? "is-ok" : "is-warn")">
                        <div class="fw-bold">@(_overview.Ai.Configured ? "زنجیره AI آماده است" : "زنجیره AI تنظیم نشده است")</div>
                        <div class="small">@_overview.Ai.Message</div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap mt-3">
                        <AuthorizeView Policy="perm:admin.contentstudio.manage">
                            <button class="btn btn-outline-primary rounded-3" @onclick="TestAi" disabled="@_testingAi">
                                @if (_testingAi)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                else
                                {
                                    <span class="oi oi-signal me-1"></span>
                                }
                                تست اتصال AI
                            </button>
                        </AuthorizeView>
                        <a href="/admin/ai" class="btn btn-outline-secondary rounded-3">
                            <span class="oi oi-cog me-1"></span> تنظیم ارائه‌دهنده/کلید/مدل
                        </a>
                    </div>
                    @if (_aiTest != null)
                    {
                        <div class="cs-test-result @(_aiTest.Ok ? "is-ok" : "is-warn")">
                            @if (_aiTest.Ok)
                            {
                                <span class="oi oi-check"></span>
                                <span>پاسخ مدل: «@_aiTest.Reply» — @_aiTest.ElapsedMs میلی‌ثانیه</span>
                            }
                            else
                            {
                                <span class="oi oi-warning"></span>
                                <span>@_aiTest.Error</span>
                            }
                        </div>
                    }

                    <div class="cs-divider"></div>
                    <div class="cs-card-title"><span class="oi oi-shield"></span> محافظت از کپی‌رایت و تکرار</div>
                    <ul class="cs-list">
                        <li>متن هر خبر به‌طور کامل با AI بازنویسی می‌شود و فقط خروجی ساختاریافته (تیتر، خلاصه، بخش‌ها) منتشر می‌شود؛ HTML خام منبع هرگز درج نمی‌شود.</li>
                        <li>اگر هم‌پوشانی عبارتی متن تولیدشده با منبع از سقف تعیین‌شده بیشتر باشد، یک بازنویسی سخت‌گیرانه دیگر انجام می‌شود و در صورت تکرار، آیتم رد می‌شود.</li>
                        <li>عنوان‌های مشابه (حتی با الفاظ متفاوت) با مقایسه فازی شناسایی و به‌عنوان «تکراری» کنار گذاشته می‌شوند.</li>
                        <li>لینک تکراری به‌صورت قطعی حذف می‌شود و سقف انتشار روزانه از ریزش محتوا جلوگیری می‌کند.</li>
                        <li>تصویر منبع به‌صورت پیش‌فرض استفاده نمی‌شود؛ در حالت «تصویر اختصاصی» تصویر خودتان و در حالت «هات‌لینک با ذکر منبع» تصویر با اعتباردهی متنی نمایش داده می‌شود.</li>
                    </ul>
                </div>

                <div class="cs-panel">
                    <div class="cs-card-title"><span class="oi oi-sliders"></span> کنترل کلی</div>
                    <div class="cs-switch-row">
                        <div>
                            <div class="fw-bold">فعال‌سازی استودیو</div>
                            <div class="small text-muted">اجرای خودکار روزانه در ساعت مشخص. اجرای دستی همیشه ممکن است.</div>
                        </div>
                        <input type="checkbox" class="cs-switch" @bind="_settings.Enabled" />
                    </div>
                    <div class="cs-switch-row">
                        <div>
                            <div class="fw-bold">انتشار خودکار</div>
                            <div class="small text-muted">اگر خاموش باشد، همه آیتم‌ها برای بازبینی در صف می‌مانند.</div>
                        </div>
                        <input type="checkbox" class="cs-switch" @bind="_settings.AutoPublish" />
                    </div>
                    <div class="cs-switch-row">
                        <div>
                            <div class="fw-bold">بازنویسی با هوش مصنوعی</div>
                            <div class="small text-muted">اگر خاموش شود، متن منبع به‌صورت پیش‌نویس دستی آماده می‌شود تا خودتان ویرایش و منتشر کنید (بدون هزینه AI).</div>
                        </div>
                        <input type="checkbox" class="cs-switch" @bind="_settings.UseAiRewrite" />
                    </div>
                    <div class="cs-switch-row @(_settings.UseAiRewrite ? "" : "is-disabled")">
                        <div>
                            <div class="fw-bold">پیش‌نویس دستی در صورت خطای AI</div>
                            <div class="small text-muted">اگر AI پاسخ ندهد یا خروجی‌اش رد شود، به‌جای وضعیت «ناموفق»، متن منبع برای ویرایش دستی آماده می‌شود.</div>
                        </div>
                        <input type="checkbox" class="cs-switch" @bind="_settings.AutoDraftOnAiFailure" disabled="@(!_settings.UseAiRewrite)" />
                    </div>
                    <div class="cs-switch-row">
                        <div>
                            <div class="fw-bold">ذکر منبع در انتهای خبر</div>
                            <div class="small text-muted">یک خط اعتباردهی به نام و لینک منبع اضافه می‌شود.</div>
                        </div>
                        <input type="checkbox" class="cs-switch" @bind="_settings.IncludeSourceCredit" />
                    </div>

                    <div class="cs-divider"></div>
                    <div class="cs-card-title"><span class="oi oi-clock"></span> زمان‌بندی و حجم</div>
                    <div class="cs-form-grid">
                        <div class="cs-field">
                            <label>ساعت اجرای روزانه (به وقت تهران)</label>
                            <input type="number" min="0" max="23" class="form-control" @bind="_settings.DailyRunHour" />
                        </div>
                        <div class="cs-field">
                            <label>حداکثر آیتم در هر اجرا</label>
                            <input type="number" min="1" max="10" class="form-control" @bind="_settings.MaxItemsPerRun" />
                        </div>
                        <div class="cs-field">
                            <label>سقف انتشار روزانه</label>
                            <input type="number" min="1" max="20" class="form-control" @bind="_settings.DailyPublishLimit" />
                        </div>
                        <div class="cs-field">
                            <label>نام نویسنده خبرها</label>
                            <input type="text" maxlength="100" class="form-control" @bind="_settings.AuthorName" />
                        </div>
                    </div>
                    @if (_settings.Enabled && _overview.Settings.NextScheduledRunAt.HasValue)
                    {
                        <div class="cs-hint mt-2">اجرای بعدی: @PersianDate.ToJalaliDateTime(_overview.Settings.NextScheduledRunAt.Value)</div>
                    }

                    <div class="cs-divider"></div>
                    <div class="cs-card-title"><span class="oi oi-shield"></span> آستانه‌های کیفیت</div>
                    <div class="cs-form-grid">
                        <div class="cs-field">
                            <label>آستانه تکرار عنوان (۰٫۵ تا ۱)</label>
                            <input type="number" min="0.5" max="1" step="0.01" class="form-control" @bind="_settings.DuplicateThreshold" />
                            <div class="cs-hint">مثلاً ۰٫۸۲ یعنی تشابه ۸۲٪ یا بیشتر = تکراری.</div>
                        </div>
                        <div class="cs-field">
                            <label>سقف هم‌پوشانی متن با منبع (درصد)</label>
                            <input type="number" min="0" max="100" class="form-control" @bind="_settings.MaxCopyOverlapPercent" />
                            <div class="cs-hint">پیشنهاد: ۳۵٪؛ بیشتر از این، بازنویسی سخت‌گیرانه انجام می‌شود.</div>
                        </div>
                        <div class="cs-field">
                            <label>حداقل طول متن تولیدشده (کاراکتر)</label>
                            <input type="number" min="200" max="5000" class="form-control" @bind="_settings.MinContentChars" />
                        </div>
                        <div class="cs-field">
                            <label>حداکثر توکن خروجی AI</label>
                            <input type="number" min="600" max="6000" class="form-control" @bind="_settings.AiMaxTokens" />
                            <div class="cs-hint">برای مدل‌های استدلالی (reasoning) حداقل ۴۰۰۰ بگذارید تا متن وسط کار قطع نشود.</div>
                        </div>
                        <div class="cs-field">
                            <label>خلاقیت مدل (Temperature)</label>
                            <input type="number" min="0" max="2" step="0.1" class="form-control" @bind="_settings.AiTemperature" />
                            <div class="cs-hint">پیشنهاد: ۰٫۵ برای خبر و ۰٫۷ برای آموزش.</div>
                        </div>
                    </div>

                    <div class="cs-divider"></div>
                    <div class="cs-card-title"><span class="oi oi-document"></span> متن کامل مقاله</div>
                    <div class="cs-switch-row">
                        <div>
                            <div class="fw-bold">دریافت متن کامل از لینک منبع</div>
                            <div class="small text-muted">اگر فید فقط خلاصه بدهد (مثل برخی سایت‌ها)، متن کامل مقاله از صفحه منبع دریافت می‌شود؛ هم برای بازنویسی AI و هم برای پیش‌نویس دستی.</div>
                        </div>
                        <input type="checkbox" class="cs-switch" @bind="_settings.FetchFullArticle" />
                    </div>

                    <div class="cs-divider"></div>
                    <div class="cs-card-title"><span class="oi oi-tag"></span> تگ و کلیدواژه خودکار</div>
                    <div class="cs-switch-row">
                        <div>
                            <div class="fw-bold">استخراج خودکار کلیدواژه از متن</div>
                            <div class="small text-muted">علاوه بر تگ‌های AI و تگ‌های ثابت منبع، واژه‌های پرتکرار خبر/ترفند هم به تگ‌ها اضافه می‌شود.</div>
                        </div>
                        <input type="checkbox" class="cs-switch" @bind="_settings.AutoKeywordTags" />
                    </div>
                    <div class="cs-form-grid">
                        <div class="cs-field">
                            <label>حداکثر تگ هر آیتم (۳ تا ۲۰)</label>
                            <input type="number" min="3" max="20" class="form-control" @bind="_settings.MaxTagsPerItem" />
                            <div class="cs-hint">پیشنهاد: ۱۰؛ تگ‌های بیشتر برای جستجوی داخلی و صفحه‌های موضوعی مفید است.</div>
                        </div>
                    </div>

                    <div class="cs-actions">
                        <AuthorizeView Policy="perm:admin.contentstudio.manage">
                            <button class="btn btn-primary rounded-3 px-4" @onclick="SaveSettings" disabled="@_savingSettings">
                                @if (_savingSettings)
                                {
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                }
                                <span class="oi oi-check me-1"></span> ذخیره تنظیمات
                            </button>
                        </AuthorizeView>
                    </div>

                    <div class="cs-divider"></div>
                    <div class="cs-card-title"><span class="oi oi-task"></span> راه‌اندازی یک‌باره</div>
                    <ol class="cs-list cs-list--num">
                        <li>در تب «منابع»، فقط آدرس سایت را بدهید و «کشف فید» را بزنید؛ فید خودکار پیدا و ثبت می‌شود.</li>
                        <li>اگر بازنویسی خودکار می‌خواهید، در «تنظیمات هوش مصنوعی» زنجیره ارائه‌دهنده/کلید/مدل را ثبت و تست کنید؛ در غیر این صورت «بازنویسی با هوش مصنوعی» را خاموش بگذارید.</li>
                        <li>اینجا «انتشار خودکار» و ساعت اجرا را انتخاب کنید و ذخیره بزنید؛ آیتم‌های آماده در صف بازبینی برای ویرایش و انتشار شما هستند.</li>
                    </ol>
                </div>
            </div>
        }

        @* ================= گزارش اجرا ================= *@
        @if (_activeTab == "runs")
        {
            <div class="cs-panel">
                <div class="cs-toolbar mb-3">
                    <div>
                        <div class="fw-bold">گزارش اجراها</div>
                        <div class="small text-muted">۳۰ اجرای آخر؛ شامل اجرای زمان‌بندی‌شده، دستی و دریافت یک منبع.</div>
                    </div>
                    <button class="btn btn-outline-secondary rounded-3" @onclick="() => LoadRuns()">
                        <span class="oi oi-reload me-1"></span> به‌روزرسانی
                    </button>
                </div>

                @if (_runs == null)
                {
                    <div class="cs-empty"><div class="spinner-border text-primary border-2"></div></div>
                }
                else if (_runs.Count == 0)
                {
                    <div class="cs-empty"><span class="oi oi-clock"></span><div class="small text-muted">هنوز اجرایی ثبت نشده است.</div></div>
                }
                else
                {
                    @foreach (var run in _runs)
                    {
                        <div class="cs-run">
                            <div class="cs-run__head">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="cs-status @RunStatusClass(run.Status)">@RunStatusLabel(run.Status)</span>
                                    <span class="cs-tag">@TriggerLabel(run.Trigger)</span>
                                    <span class="small text-muted">@PersianDate.ToJalaliDateTime(run.StartedAt)</span>
                                </div>
                                @if (run.FinishedAt.HasValue)
                                {
                                    <span class="small text-muted">پایان: @PersianDate.ToTime(run.FinishedAt.Value)</span>
                                }
                            </div>
                            <div class="cs-run__grid">
                                <span>منابع: <b>@run.SourcesChecked</b></span>
                                <span>دریافت: <b>@run.Fetched</b></span>
                                <span>تولید: <b>@run.Generated</b></span>
                                <span>تکراری: <b>@run.Duplicates</b></span>
                                <span>ردشده: <b>@run.Skipped</b></span>
                                <span>منتشرشده: <b>@run.Published</b></span>
                                <span>خطا: <b>@run.Failed</b></span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(run.Message))
                            {
                                <div class="cs-run__msg">@run.Message</div>
                            }
                        </div>
                    }
                }
            </div>
        }
    }
</div>

@* ================= مودال منبع ================= *@
@if (_showSourceModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title fw-bold">@(_editingSourceId.HasValue ? "ویرایش منبع" : "منبع جدید")</h5>
                        <div class="small text-muted">آدرس سایت کافی است؛ فید RSS/Atom خودکار پیدا و ثبت می‌شود. آدرس فید فقط اگر خودتان آن را می‌دانید لازم است.</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseSourceModal"></button>
                </div>
                <div class="modal-body">
                    <div class="cs-form-grid">
                        <div class="cs-field">
                            <label>نام منبع *</label>
                            <input type="text" maxlength="150" class="form-control" @bind="_sourceForm.Name" placeholder="مثلاً: زومیت" />
                        </div>
                        <div class="cs-field">
                            <label>دسته محتوا *</label>
                            <select class="form-select" @bind="_sourceForm.Category">
                                <option value="News">خبر</option>
                                <option value="Tutorial">آموزش</option>
                                <option value="Tip">ترفند</option>
                            </select>
                        </div>
                        <div class="cs-field cs-field--wide">
                            <label>آدرس سایت</label>
                            <div class="input-group">
                                <input type="url" class="form-control" dir="ltr" @bind="_sourceForm.SiteUrl" placeholder="https://example.com" />
                                <button class="btn btn-outline-secondary" @onclick="DiscoverFeed" disabled="@_discovering">
                                    @if (_discovering)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <span>کشف فید</span>
                                    }
                                </button>
                            </div>
                            <div class="cs-hint">آدرس سایت را بدهید؛ فید RSS/Atom به‌صورت خودکار از همان دامنه پیدا می‌شود.</div>
                        </div>
                        <div class="cs-field cs-field--wide">
                            <label>آدرس فید RSS/Atom <span class="text-muted small">(اختیاری)</span></label>
                            <div class="input-group">
                                <input type="url" class="form-control" dir="ltr" @bind="_sourceForm.FeedUrl" placeholder="خالی بماند تا خودکار پیدا شود" />
                                <button class="btn btn-outline-primary" @onclick="TestFeed" disabled="@_testingFeed">
                                    @if (_testingFeed)
                                    {
                                        <span class="spinner-border spinner-border-sm"></span>
                                    }
                                    else
                                    {
                                        <span>تست فید</span>
                                    }
                                </button>
                            </div>
                            <div class="cs-hint">اگر خالی بماند، هنگام ذخیره بهترین فید همان سایت پیدا و ثبت می‌شود.</div>
                        </div>
                        <div class="cs-field cs-field--wide">
                            <label>برچسب‌های پیش‌فرض</label>
                            <input type="text" class="form-control" @bind="_sourceForm.DefaultTags" placeholder="مثلاً: فناوری, اخبار فناوری" />
                        </div>
                        <div class="cs-field">
                            <label>کلمات الزامی (با کاما)</label>
                            <textarea class="form-control" rows="2" @bind="_sourceForm.IncludeKeywords" placeholder="اگر خالی باشد همه مطالب پذیرفته می‌شوند"></textarea>
                        </div>
                        <div class="cs-field">
                            <label>کلمات ممنوع (با کاما)</label>
                            <textarea class="form-control" rows="2" @bind="_sourceForm.ExcludeKeywords" placeholder="مثلاً: ورزش, سینما, قیمت دلار"></textarea>
                        </div>
                        <div class="cs-field">
                            <label>حالت انتشار</label>
                            <select class="form-select" @bind="_sourceForm.AutoPublishMode">
                                <option value="Inherit">پیروی از تنظیم کلی</option>
                                <option value="Never">هرگز خودکار منتشر نشود</option>
                            </select>
                        </div>
                        <div class="cs-field">
                            <label>سهمیه روزانه این منبع</label>
                            <input type="number" min="1" max="10" class="form-control" @bind="_sourceForm.MaxItemsPerDay" />
                        </div>
                        <div class="cs-field">
                            <label>اولویت (عدد کمتر = زودتر)</label>
                            <input type="number" min="1" max="1000" class="form-control" @bind="_sourceForm.Priority" />
                        </div>
                        <div class="cs-field">
                            <label>سیاست تصویر</label>
                            <select class="form-select" @bind="_sourceForm.ImageMode">
                                <option value="None">بدون تصویر منبع (جایگزین پیش‌فرض سایت)</option>
                                <option value="OwnFallback">تصویر اختصاصی من</option>
                                <option value="SourceHotlink">هات‌لینک تصویر منبع با ذکر منبع</option>
                            </select>
                        </div>
                        <div class="cs-switch-row cs-switch-row--inline">
                            <div>
                                <div class="fw-bold">منبع فعال باشد</div>
                            </div>
                            <input type="checkbox" class="cs-switch" @bind="_sourceForm.Enabled" />
                        </div>
                    </div>

                    @if (_sourceForm.ImageMode == "OwnFallback")
                    {
                        <div class="cs-upload mt-2">
                            <label class="small fw-bold">تصویر جایگزین (برای همه خبرهای این منبع)</label>
                            <div class="d-flex gap-2 align-items-center flex-wrap">
                                <label class="btn btn-outline-secondary rounded-3 m-0">
                                    <span class="oi oi-image me-1"></span>
                                    @(_uploadingImage ? "در حال آپلود…" : "آپلود تصویر")
                                    <InputFile OnChange="HandleFallbackUpload" accept="image/jpeg,image/png,image/webp" hidden />
                                </label>
                                @if (!string.IsNullOrWhiteSpace(_sourceForm.FallbackImageUrl))
                                {
                                    <span class="cs-thumb"><img src="@_sourceForm.FallbackImageUrl" alt="" /></span>
                                    <button class="btn btn-sm btn-outline-danger rounded-3" @onclick="() => _sourceForm.FallbackImageUrl = null">حذف تصویر</button>
                                }
                            </div>
                            <div class="cs-hint mt-1">حداکثر ۲۰۰ کیلوبایت؛ تصویر به‌صورت خودکار فشرده می‌شود.</div>
                        </div>
                    }

                    @if (_sourceForm.ImageMode == "SourceHotlink")
                    {
                        <div class="cs-hint mt-2">در این حالت تصویر اصلی منبع نمایش داده می‌شود و در متن خبر، نام و لینک منبع ذکر می‌شود. استفاده از تصاویر دارای حق نشر را خودتان بررسی کنید.</div>
                    }

                    @if (_feedTest != null)
                    {
                        <div class="cs-test-result @(_feedTest.Ok ? "is-ok" : "is-warn") mt-2">
                            @if (_feedTest.Ok)
                            {
                                <div>
                                    <span class="oi oi-check"></span>
                                    فید «@_feedTest.FeedTitle» با @_feedTest.ItemCount آیتم خوانده شد
                                    @if (_feedTest.HttpStatus.HasValue)
                                    {
                                        <span class="text-muted small">(HTTP @_feedTest.HttpStatus @_feedTest.ContentType)</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_feedTest.LatestItemTitle))
                                {
                                    <div class="small text-muted mt-1">آخرین آیتم: @_feedTest.LatestItemTitle</div>
                                }
                                @if (_feedTest.Samples.Count > 0)
                                {
                                    <ul class="mb-0 mt-1 small">
                                        @foreach (var sample in _feedTest.Samples)
                                        {
                                            <li>@sample</li>
                                        }
                                    </ul>
                                }
                            }
                            else
                            {
                                <div><span class="oi oi-warning"></span> @_feedTest.Error</div>
                                @if (!string.IsNullOrWhiteSpace(_feedTest.SuggestedFeedUrl))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-3 mt-2" @onclick="ApplySuggestedFeed">
                                        <span class="oi oi-check me-1"></span>
                                        استفاده از فید پیدا‌شده (@_feedTest.ItemCount آیتم)
                                    </button>
                                }
                            }
                        </div>
                    }

                    @if (_discover != null)
                    {
                        <div class="cs-test-result @(_discover.Ok ? "is-ok" : "is-warn") mt-2">
                            @if (_discover.Ok && _discover.Candidates.Any(c => c.Ok))
                            {
                                <div class="fw-bold mb-1">
                                    <span class="oi oi-check"></span>
                                    فیدهای معتبر پیدا شد
                                    @if (!string.IsNullOrWhiteSpace(_discover.SiteTitle))
                                    {
                                        <span class="text-muted small">— @_discover.SiteTitle</span>
                                    }
                                    <span class="text-muted small">(@_discover.Probed آدرس بررسی شد)</span>
                                </div>
                                <div class="d-flex flex-column gap-2">
                                    @foreach (var candidate in _discover.Candidates.Where(c => c.Ok))
                                    {
                                        <button type="button" class="cs-feed-candidate @(candidate.Url == _discover.Best ? "is-best" : "")"
                                                @onclick="() => UseDiscoveredFeed(candidate)">
                                            <div class="cs-feed-candidate__main">
                                                <span class="cs-feed-candidate__url" dir="ltr">@candidate.Url</span>
                                                <span class="cs-feed-candidate__meta">
                                                    <span class="cs-tag">@FeedMethodLabel(candidate.Method)</span>
                                                    @if (!string.IsNullOrWhiteSpace(candidate.Title))
                                                    {
                                                        <span>@candidate.Title</span>
                                                    }
                                                    <span>@candidate.ItemCount آیتم</span>
                                                    @if (candidate.LatestItemAt.HasValue)
                                                    {
                                                        <span>آخرین: @PersianDate.ToJalaliDate(candidate.LatestItemAt.Value)</span>
                                                    }
                                                </span>
                                                @if (!string.IsNullOrWhiteSpace(candidate.LatestItemTitle))
                                                {
                                                    <span class="cs-feed-candidate__latest">@candidate.LatestItemTitle</span>
                                                }
                                            </div>
                                            <span class="oi oi-arrow-left"></span>
                                        </button>
                                    }
                                </div>

                                @if (_discover.Candidates.Any(c => !c.Ok))
                                {
                                    <details class="mt-2">
                                        <summary class="small text-muted">آدرس‌هایی که فید نبودند (@_discover.Candidates.Count(c => !c.Ok))</summary>
                                        <ul class="mb-0 mt-1 small">
                                            @foreach (var candidate in _discover.Candidates.Where(c => !c.Ok).Take(12))
                                            {
                                                <li>
                                                    <span dir="ltr">@candidate.Url</span>
                                                    <span class="text-muted">— @candidate.Error</span>
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                }
                            }
                            else
                            {
                                <div><span class="oi oi-warning"></span> @(_discover.Error ?? "فیدی روی این سایت پیدا نشد.")</div>
                                @if (!string.IsNullOrWhiteSpace(_discover.SiteError))
                                {
                                    <div class="small text-muted mt-1">خطای خواندن صفحه سایت: @_discover.SiteError</div>
                                }
                                @if (_discover.Candidates.Count > 0)
                                {
                                    <details class="mt-2">
                                        <summary class="small text-muted">گزارش بررسی @_discover.Candidates.Count آدرس</summary>
                                        <ul class="mb-0 mt-1 small">
                                            @foreach (var candidate in _discover.Candidates.Take(15))
                                            {
                                                <li>
                                                    <span dir="ltr">@candidate.Url</span>
                                                    <span class="text-muted">— @candidate.Error</span>
                                                </li>
                                            }
                                        </ul>
                                    </details>
                                }
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(_sourceError))
                    {
                        <div class="cs-test-result is-warn mt-2"><span class="oi oi-warning"></span> @_sourceError</div>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary rounded-3" @onclick="CloseSourceModal">انصراف</button>
                    <button type="button" class="btn btn-primary rounded-3 px-4" @onclick="SaveSource" disabled="@_savingSource">
                        @if (_savingSource)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span class="oi oi-check me-1"></span> ذخیره منبع
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ================= مودال پیش‌نمایش ================= *@
@if (_showPreview)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <div class="min-w-0">
                        <h5 class="modal-title fw-bold">پیش‌نمایش محتوای تولیدشده</h5>
                        <div class="small text-muted">این خروجی نهایی است؛ HTML فقط از ساختار مجاز ساخته می‌شود.</div>
                    </div>
                    <button type="button" class="btn-close" @onclick="ClosePreview"></button>
                </div>
                <div class="modal-body">
                    @if (_previewLoading || _previewItem == null)
                    {
                        <div class="cs-empty"><div class="spinner-border text-primary border-2"></div></div>
                    }
                    else
                    {
                        <div class="cs-preview__title">@_previewItem.GeneratedTitle</div>
                        <div class="cs-metrics mb-2">
                            <span class="cs-status @StatusClass(_previewItem.Status)">@StatusLabel(_previewItem.Status)</span>
                            @if (_previewItem.IsManualDraft)
                            {
                                <span class="cs-tag cs-tag--muted">پیش‌نویس دستی</span>
                            }
                            <span class="cs-metric">منبع: @_previewItem.SourceName</span>
                            @if (_previewItem.CopyOverlapPercent.HasValue)
                            {
                                <span class="cs-metric">هم‌پوشانی: @Math.Round(_previewItem.CopyOverlapPercent.Value)٪</span>
                            }
                            @if (_previewItem.TitleSimilarity.HasValue)
                            {
                                <span class="cs-metric">تشابه عنوان: @Math.Round(_previewItem.TitleSimilarity.Value * 100)٪</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(_previewItem.GeneratedTags))
                            {
                                <span class="cs-metric">@_previewItem.GeneratedTags</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_previewItem.GeneratedSummary))
                        {
                            <div class="cs-preview__summary">@_previewItem.GeneratedSummary</div>
                        }
                        <div class="cs-preview__content cs-article">
                            @((MarkupString)HtmlSanitizer.Sanitize(_previewItem.GeneratedContent ?? ""))
                        </div>

                        <div class="cs-divider"></div>
                        <div class="cs-preview__source">
                            <div class="fw-bold small">اطلاعات منبع</div>
                            <div class="small text-muted">عنوان اصلی: @_previewItem.OriginalTitle</div>
                            @if (!string.IsNullOrWhiteSpace(_previewItem.OriginalSummary))
                            {
                                <div class="small text-muted">خلاصه اصلی: @_previewItem.OriginalSummary</div>
                            }
                            <a href="@_previewItem.SourceUrl" target="_blank" rel="noopener noreferrer" class="small" dir="ltr">@_previewItem.SourceUrl</a>
                        </div>

                        <AuthorizeView Policy="perm:admin.contentstudio.manage">
                            <div class="cs-modal-actions">
                                @if (!_previewItem.NewsId.HasValue)
                                {
                                    <button class="btn btn-outline-primary rounded-3" @onclick="() => OpenDraftEditor(_previewItem.Id)">ویرایش دستی</button>
                                }
                                @if (_previewItem.Status is "Pending" or "Failed" or "Rejected")
                                {
                                    <button class="btn btn-primary rounded-3" @onclick="() => RewriteItem(_previewItem.Id)">بازنویسی</button>
                                }
                                @if (_previewItem.Status == "Ready")
                                {
                                    <button class="btn btn-primary rounded-3" @onclick="() => PublishItem(_previewItem.Id, false)">انتشار</button>
                                    <button class="btn btn-outline-primary rounded-3" @onclick="() => PublishItem(_previewItem.Id, true)">ذخیره پیش‌نویس</button>
                                    <button class="btn btn-outline-secondary rounded-3" @onclick="() => RejectItem(_previewItem.Id)">رد آیتم</button>
                                }
                                @if (_previewItem.NewsId.HasValue)
                                {
                                    <a class="btn btn-outline-success rounded-3" href="/news/@_previewItem.NewsId" target="_blank">
                                        @(_previewItem.NewsIsPublished ? "مشاهده خبر در سایت" : "مشاهده پیش‌نویس در سایت")
                                    </a>
                                }
                            </div>
                        </AuthorizeView>
                    }
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-secondary rounded-3" @onclick="ClosePreview">بستن</button>
                </div>
            </div>
        </div>
    </div>
}

@* ================= مودال ویرایش دستی ================= *@
@if (_showDraftModal)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" dir="rtl">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable modal-xl">
            <div class="modal-content rounded-4 border-0 shadow-lg">
                <div class="modal-header border-0 pb-0">
                    <div class="min-w-0">
                        <h5 class="modal-title fw-bold">پیش‌نویس دستی</h5>
                        <div class="small text-muted">
                            متن را بنویسید یا بچسبانید؛ ستون کنار همین‌جا با استایل نهایی مقاله نشان داده می‌شود
                            (تیتر با «##»، فهرست با «-»، نقل‌قول با «>»، درشت با «**» و لینک با «[متن](آدرس)»).
                        </div>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseDraftEditor"></button>
                </div>
                <div class="modal-body">
                    @if (_draftLoading)
                    {
                        <div class="cs-empty"><div class="spinner-border text-primary border-2"></div></div>
                    }
                    else
                    {
                        @if (_draftSource != null)
                        {
                            <div class="cs-preview__source mb-3">
                                <div class="small text-muted">عنوان اصلی: @_draftSource.OriginalTitle</div>
                                <a href="@_draftSource.SourceUrl" target="_blank" rel="noopener noreferrer" class="small" dir="ltr">@_draftSource.SourceUrl</a>
                            </div>
                        }
                        <div class="cs-field mb-3">
                            <label>عنوان</label>
                            <input type="text" maxlength="200" class="form-control" @bind="_draftForm.Title" />
                        </div>
                        <div class="cs-field mb-3">
                            <label>خلاصه</label>
                            <textarea class="form-control" rows="2" maxlength="500" @bind="_draftForm.Summary"></textarea>
                        </div>
                        <div class="cs-draft-split mb-3">
                            <div class="cs-field">
                                <label>متن خبر</label>
                                <textarea class="form-control cs-draft-text" rows="16" maxlength="20000"
                                          @bind="_draftForm.Content" @bind:event="oninput"></textarea>
                                <div class="cs-hint">
                                    متن کپی‌شده از سایت‌ها یا ورد را همین‌جا بچسبانید؛ تیتر، فهرست، شماره‌دار، تصویر، درشت و لینکِ آن
                                    خودکار به نشانه‌ها تبدیل می‌شود. دستی هم می‌توانید بنویسید:
                                    <span dir="ltr">## تیتر</span>، <span dir="ltr">### زیرتیتر</span>،
                                    <span dir="ltr">- فهرست</span>، <span dir="ltr">1. شماره‌دار</span>،
                                    <span dir="ltr">&gt; نکته/نقل‌قول</span>، <span dir="ltr">---</span> خط،
                                    <span dir="ltr">**درشت**</span>، <span dir="ltr">*مورب*</span>،
                                    <span dir="ltr">[متن](لینک)</span>، <span dir="ltr">![توضیح](آدرس عکس)</span>.
                                </div>
                            </div>
                            <div class="cs-field">
                                <label>پیش‌نمایش نهایی</label>
                                <div class="cs-draft-preview cs-article">
                                    @if (string.IsNullOrWhiteSpace(_draftForm.Content))
                                    {
                                        <div class="cs-hint">متن را در ستون کنار بنویسید یا بچسبانید؛ همین‌جا با استایل نهایی مقاله نمایش داده می‌شود.</div>
                                    }
                                    else
                                    {
                                        @((MarkupString)ManualMarkup.ToHtml(_draftForm.Content))
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="cs-field mb-3">
                            <label>تگ‌ها و کلیدواژه‌ها (با کاما جدا کنید)</label>
                            <input type="text" maxlength="500" class="form-control" @bind="_draftForm.Tags" />
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_draftError))
                        {
                            <div class="alert alert-warning rounded-3 small">@_draftError</div>
                        }
                    }
                </div>
                <div class="modal-footer border-0 pt-0 d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-primary rounded-3 px-4" @onclick="SaveManualDraft" disabled="@(_draftSaving || _draftLoading)">
                        @if (_draftSaving)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        ذخیره پیش‌نویس
                    </button>
                    <button type="button" class="btn btn-outline-primary rounded-3" @onclick="RebuildDraftFromSource" disabled="@(_draftSaving || _draftLoading)">
                        بازسازی از متن منبع
                    </button>
                    <button type="button" class="btn btn-secondary rounded-3" @onclick="CloseDraftEditor">انصراف</button>
                </div>
            </div>
        </div>
    </div>
}

