    private async Task GoToPage(int page)
    {
        if (page < 1) page = 1;
        if (page > totalPages) page = totalPages;
        if (page == currentPage && products != null) return;
        currentPage = page;
        skip = (currentPage - 1) * take;
        await LoadProducts();
        SyncUrl();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
        }
        else
        {
            pages.Add(1);
            if (currentPage > 3) pages.Add(-1);
            int start = Math.Max(2, currentPage - 1);
            int end = Math.Min(totalPages - 1, currentPage + 1);
            for (int i = start; i <= end; i++) pages.Add(i);
            if (currentPage < totalPages - 2) pages.Add(-1);
            pages.Add(totalPages);
        }
        return pages;
    }

    private async Task LoadProducts()
    {
        products = null;
        var query = BuildQueryString();
        var facetsTask = Http.GetFromJsonAsync<ProductFacetsDto>($"api/products/facets?{query}");
        try
        {
            var response = await Http.GetAsync($"api/products?{query}");
            if (!response.IsSuccessStatusCode)
            {
                try { facets = await facetsTask; } catch { }
                products ??= new();
                return;
            }

            totalCount = PaginationHeaderReader.ReadTotalCount(response);
            totalPages = (int)Math.Ceiling((double)totalCount / take);
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;
            skip = (currentPage - 1) * take;

            var data = await response.Content.ReadFromJsonAsync<List<ProductDto>>();
            data ??= new();
            products = data;

            try { facets = await facetsTask; } catch { facets = null; }
            StartOrStopTimer();
        }
        catch
        {
            products ??= new();
            try { facets = await facetsTask; } catch { facets = null; }
        }
    }

    private static string FacetSuffix(int? count) => count.HasValue ? $" ({count.Value})" : "";

    private string FacetCatSuffix(int categoryId)
        => FacetSuffix(facets?.Categories?.FirstOrDefault(c => c.Id == categoryId)?.Count);

