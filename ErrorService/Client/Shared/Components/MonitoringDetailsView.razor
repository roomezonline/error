                }
            </div>
            <div class="md-flow-val" style="color:@GraphColor">@flowValue.ToString("F2")<span class="md-flow-unit"> @GraphUnit</span></div>
        </div>
        <div class="md-flow-chart">
            <svg class="md-flow-svg" viewBox="0 0 800 120" preserveAspectRatio="xMidYMid meet">
                <defs>
                    <linearGradient id="flowFill" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="@GraphColor" stop-opacity="0.2" />
                        <stop offset="100%" stop-color="@GraphColor" stop-opacity="0.01" />
                    </linearGradient>
                </defs>
                @for (var i = 0; i <= 3; i++)
                {
                    var y = 20 + i * 26;
                    <line x1="0" y1="@y" x2="800" y2="@y" stroke="#e8ecf1" stroke-width="0.5" />
                }
                <path d="@flowPath" fill="none" stroke="@GraphColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                <path d="@flowFillPath" fill="url(#flowFill)" />
                @FlowLabels
            </svg>
        </div>
    </div>

    <div class="md-temp-row">
        <div class="md-card md-card--sm @(_graphSource == "fridge" ? "selected" : "")" @onclick="SelectFridge">
            <div class="md-temp-head">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round">
                    <path d="M3 8h12a3 3 0 1 0-3-3" />
                    <path d="M5 14h10a3 3 0 1 1-3 3" />
                    <path d="M7 20h8" />
                </svg>
                <span>یخچال</span>
            </div>
            <div class="md-temp-val @GetFridgeClass(tertiaryTemp)"><span dir="ltr" class="md-temp-num">@tertiaryTemp.ToString("F1")<span class="md-temp-unit">C</span></span></div>
            <div class="md-temp-bar"><div class="md-temp-fill @GetFridgeClass(tertiaryTemp)" style="@FridgeBarWidth"></div></div>
        </div>
        <div class="md-card md-card--sm @(_graphSource == "ambient" ? "selected" : "")" @onclick="SelectAmbient">
            <div class="md-temp-head">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </svg>
                <span>دمای محیط</span>
            </div>
            <div class="md-temp-val @GetAmbientClass(secondaryTemp)"><span dir="ltr" class="md-temp-num">@secondaryTemp.ToString("F1")<span class="md-temp-unit">C</span></span></div>
            <div class="md-temp-bar"><div class="md-temp-fill @GetAmbientClass(secondaryTemp)" style="@AmbientBarWidth"></div></div>
        </div>
        <div class="md-card md-card--sm @(_graphSource == "freezer" ? "selected" : "")" @onclick="SelectFreezer">
            <div class="md-temp-head">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M12 2v4M12 18v4M2 12h4M18 12h4" />
                    <path d="M5.5 5.5l3 3M15.5 15.5l3 3M5.5 18.5l3-3M15.5 8.5l3-3" />
                    <circle cx="12" cy="12" r="2" fill="currentColor" />
                </svg>
                <span>فریزر</span>
            </div>
            <div class="md-temp-val @GetFreezerClass(ambientTemp)"><span dir="ltr" class="md-temp-num">@ambientTemp.ToString("F1")<span class="md-temp-unit">C</span></span></div>
            <div class="md-temp-bar"><div class="md-temp-fill @GetFreezerClass(ambientTemp)" style="@FreezerBarWidth"></div></div>
        </div>
    </div>

    <!-- Defrost Row - Redesigned Modern Version -->
    <div class="md-def-row">
        <div class="md-card md-card--sm md-def-card @(_graphSource == "h1" ? "selected" : "")" @onclick="SelectH1">
            <div class="md-def-badge @(h1On ? "active" : "")">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" width="12" height="12" class="md-def-badge-icon">
                    <path d="M8 1v3M8 12v3M1 8h3M12 8h3" stroke-linecap="round"/>
                    <path d="M3.5 3.5l1.5 1.5M11 11l1.5 1.5M3.5 12.5l1.5-1.5M11 5l1.5-1.5" stroke-linecap="round"/>
                    @if (h1On) { <circle cx="8" cy="8" r="1.5" fill="currentColor"/> }
                </svg>
                H1
            </div>
            <div class="md-def-status @(h1On ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" width="34" height="34" class="@(h1On ? "md-def-snowflake-spin" : "")">
                    <path d="M22 11h-4.17l3.24-3.24-1.41-1.42L15 11h-2V9l4.66-4.66-1.42-1.41L13 6.17V2h-2v4.17L7.76 2.93 6.34 4.34 11 9v2H9L4.34 6.34 2.93 7.76 6.17 11H2v2h4.17l-3.24 3.24 1.41 1.42L9 13h2v2l-4.66 4.66 1.42 1.41L11 17.83V22h2v-4.17l3.24 3.24 1.42-1.41L13 15v-2h2l4.66 4.66 1.41-1.42L17.83 13H22z"
                          stroke="@(h1On ? "#0ea5e9" : "#94a3b8")" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="12" cy="12" r="1.5" fill="@(h1On ? "#0ea5e9" : "#94a3b8")"/>
                </svg>
            </div>
            <div class="md-def-meta">
                <span class="md-def-label">@(h1On ? "دیفراست" : "غیرفعال")</span>
            </div>
                <div class="md-def-line">
                    <div class="md-def-line-item">
                        <span class="md-def-line-label">R</span>
                        <span class="md-def-line-start @GetFridgeClass(_e1StartFridge)">@(_e1StartFridge == 0 ? "---" : _e1StartFridge.ToString("F1"))</span>
                        <span class="md-def-line-sep">~</span>
                        <span class="md-def-line-stop @GetFridgeClass(_e1StopFridge)">@(_e1StopFridge == 0 ? "---" : _e1StopFridge.ToString("F1"))</span>
                    </div>
                    <div class="md-def-line-item">
                        <span class="md-def-line-label">F</span>
                        <span class="md-def-line-start @GetFreezerClass(_e1StartFreezer)">@(_e1StartFreezer == 0 ? "---" : _e1StartFreezer.ToString("F1"))</span>
                        <span class="md-def-line-sep">~</span>
                        <span class="md-def-line-stop @GetFreezerClass(_e1StopFreezer)">@(_e1StopFreezer == 0 ? "---" : _e1StopFreezer.ToString("F1"))</span>
                    </div>
                </div>
            <div class="md-def-counter">@_cntE1 بار</div>
        </div>

        <div class="md-card md-card--sm md-def-card @(_graphSource == "h2" ? "selected" : "")" @onclick="SelectH2">
            <div class="md-def-badge @(h2On ? "active" : "")">
                <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.2" width="12" height="12" class="md-def-badge-icon">
                    <path d="M8 1v3M8 12v3M1 8h3M12 8h3" stroke-linecap="round"/>
                    <path d="M3.5 3.5l1.5 1.5M11 11l1.5 1.5M3.5 12.5l1.5-1.5M11 5l1.5-1.5" stroke-linecap="round"/>
                    @if (h2On) { <circle cx="8" cy="8" r="1.5" fill="currentColor"/> }
                </svg>
                H2
            </div>
            <div class="md-def-status @(h2On ? "active" : "")">
                <svg viewBox="0 0 24 24" fill="none" width="34" height="34" class="@(h2On ? "md-def-snowflake-spin" : "")">
                    <path d="M22 11h-4.17l3.24-3.24-1.41-1.42L15 11h-2V9l4.66-4.66-1.42-1.41L13 6.17V2h-2v4.17L7.76 2.93 6.34 4.34 11 9v2H9L4.34 6.34 2.93 7.76 6.17 11H2v2h4.17l-3.24 3.24 1.41 1.42L9 13h2v2l-4.66 4.66 1.42 1.41L11 17.83V22h2v-4.17l3.24 3.24 1.42-1.41L13 15v-2h2l4.66 4.66 1.41-1.42L17.83 13H22z"
                          stroke="@(h2On ? "#0ea5e9" : "#94a3b8")" stroke-width="0.6" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="12" cy="12" r="1.5" fill="@(h2On ? "#0ea5e9" : "#94a3b8")"/>
                </svg>
            </div>
            <div class="md-def-meta">
                <span class="md-def-label">@(h2On ? "دیفراست" : "غیرفعال")</span>
            </div>
            <div class="md-def-line">
                <div class="md-def-line-item">
                    <span class="md-def-line-label">R</span>
                    <span class="md-def-line-start @GetFridgeClass(_e2StartFridge)">@(_e2StartFridge == 0 ? "---" : _e2StartFridge.ToString("F1"))</span>
                    <span class="md-def-line-sep">~</span>
                    <span class="md-def-line-stop @GetFridgeClass(_e2StopFridge)">@(_e2StopFridge == 0 ? "---" : _e2StopFridge.ToString("F1"))</span>
                </div>
                <div class="md-def-line-item">
                    <span class="md-def-line-label">F</span>
                    <span class="md-def-line-start @GetFreezerClass(_e2StartFreezer)">@(_e2StartFreezer == 0 ? "---" : _e2StartFreezer.ToString("F1"))</span>
                    <span class="md-def-line-sep">~</span>
                    <span class="md-def-line-stop @GetFreezerClass(_e2StopFreezer)">@(_e2StopFreezer == 0 ? "---" : _e2StopFreezer.ToString("F1"))</span>
                </div>
            </div>
            <div class="md-def-counter">@_cntE2 بار</div>
        </div>
    </div>
    }

    <div class="md-log-toggle" @onclick="ToggleChangeLogs">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
            <polyline points="14 2 14 8 20 8"/>
            <line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/>
        </svg>
        <span>تاریخچه تغییرات</span>
        <span class="md-log-count">@_changeLogs?.Count</span>
        <svg class="md-info-chevron @(_changeLogsOpen ? "open" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
            <polyline points="6 9 12 15 18 9"/>
        </svg>
        @if (!IsReadOnly && _changeLogsOpen && _changeLogs.Count > 0)
        {
            <button class="md-log-delete-btn" @onclick:stopPropagation @onclick="() => _showDeleteHistoryConfirm = true" title="حذف تاریخچه">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                    <path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                    <path d="M10 11v6M14 11v6"/>
                </svg>
                حذف تاریخچه
            </button>
        }
    </div>

    @if (_changeLogsOpen)
    {
        <div class="md-log-panel">
            @if (_changeLogs.Count == 0 && _changeLogTotal == 0 && !_changeLogLoadingMore)
            {
                <div class="md-log-empty">در حال بارگذاری...</div>
            }
            else if (_changeLogs.Count == 0)
            {
                <div class="md-log-empty">تاکنون تغییری ثبت نشده است</div>
            }
            else
            {
                @foreach (var log in _changeLogs)
                {
                    <div class="md-log-item @(log.Id == _expandedLogId ? "expanded" : "")">
                        <div class="md-log-item-head" @onclick="() => ToggleLogDetail(log.Id)">
                            <span class="md-log-badge md-log-badge--@log.ChangeType.ToLower()">@GetChangeTypeLabel(log.ChangeType)</span>
                            @{
                                var (statusText, statusClass) = GetChangeStatus(log);
                            }
                            @if (!string.IsNullOrEmpty(statusClass))
                            {
                                <span class="md-log-status @statusClass">
                                    <span class="md-log-status-dot"></span>
                                    @statusText
                                </span>
                            }
                            else
                            {
                                <span class="md-log-status">@statusText</span>
                            }
                            <span class="md-log-time">@SwapDateTime(log.CreatedAtFa)</span>
                            <svg class="md-log-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12">
                                <polyline points="6 9 12 15 18 9"/>
                            </svg>
                        </div>
                        @if (log.Id == _expandedLogId && !string.IsNullOrEmpty(log.DataSnapshot))
                        {
                            <div class="md-log-detail">
                                @{
                                    var snapshot = ParseSnapshot(log.DataSnapshot);
                                }
                                @if (snapshot != null && snapshot.Count > 0)
                                {
                                    <div class="md-log-groups">
                                        @* status group *@
                                        <div class="md-log-group">
                                            <div class="md-log-group__title">عملکرد تجهیزات</div>
                                            <div class="md-log-subgrid md-log-subgrid--4">
                                                @foreach (var (label, value, color, iconSvg) in snapshot.Take(4))
                                                {
                                                    <div class="md-log-field">
                                                        <span class="md-log-field__label" style="color:@color;background:rgba(0,0,0,0.03)">
                                                            @((MarkupString)iconSvg)
                                                            <span>@label</span>
                                                        </span>
                                                        <span class="md-log-field__val">@value</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                        @* temps group *@
                                        @if (snapshot.Count > 6)
                                        {
                                            var (l6, v6, c6, i6) = snapshot[6]; @* دمای محیط *@
                                            <div class="md-log-group">
                                                <div class="md-log-group__title">دماها</div>
                                                <div class="md-log-subgrid">
                                                    <div class="md-log-field md-log-field--full">
                                                        <span class="md-log-field__label" style="color:@c6;background:rgba(0,0,0,0.03)">
                                                            @((MarkupString)i6)<span>@l6</span>
                                                        </span>
                                                        <span class="md-log-field__val">@v6</span>
                                                    </div>
                                                </div>
                                                @if (snapshot.Count > 5)
                                                {
                                                    var (l4, v4, c4, i4) = snapshot[4]; @* دمای یخچال *@
                                                    var (l5, v5, c5, i5) = snapshot[5]; @* دمای فریزر *@
                                                    <div class="md-log-subgrid md-log-subgrid--2">
                                                        <div class="md-log-field">
                                                            <span class="md-log-field__label" style="color:@c4;background:rgba(0,0,0,0.03)">
                                                                @((MarkupString)i4)<span>@l4</span>
                                                            </span>
                                                            <span class="md-log-field__val">@v4</span>
                                                        </div>
                                                        <div class="md-log-field">
                                                            <span class="md-log-field__label" style="color:@c5;background:rgba(0,0,0,0.03)">
                                                                @((MarkupString)i5)<span>@l5</span>
                                                            </span>
                                                            <span class="md-log-field__val">@v5</span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        @* electrical group *@
                                        @if (snapshot.Count > 8)
                                        {
                                            var (l8, v8, c8, i8) = snapshot[8]; @* جریان *@
                                            <div class="md-log-group">
                                                <div class="md-log-group__title">الکتریکال</div>
                                                <div class="md-log-subgrid">
                                                    <div class="md-log-field md-log-field--full">
                                                        <span class="md-log-field__label" style="color:@c8;background:rgba(0,0,0,0.03)">
                                                            @((MarkupString)i8)<span>@l8</span>
                                                        </span>
                                                        <span class="md-log-field__val">@v8</span>
                                                    </div>
                                                </div>
                                                @if (snapshot.Count > 9)
                                                {
                                                    var (l7, v7, c7, i7) = snapshot[7]; @* ولتاژ *@
                                                    var (l9, v9, c9, i9) = snapshot[9]; @* توان *@
                                                    <div class="md-log-subgrid md-log-subgrid--2">
                                                        <div class="md-log-field">
                                                            <span class="md-log-field__label" style="color:@c7;background:rgba(0,0,0,0.03)">
                                                                @((MarkupString)i7)<span>@l7</span>
                                                            </span>
                                                            <span class="md-log-field__val">@v7</span>
                                                        </div>
                                                        <div class="md-log-field">
                                                            <span class="md-log-field__label" style="color:@c9;background:rgba(0,0,0,0.03)">
                                                                @((MarkupString)i9)<span>@l9</span>
                                                            </span>
                                                            <span class="md-log-field__val">@v9</span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
                @if (_changeLogs.Count < _changeLogTotal)
                {
                    <div class="md-log-more-wrap">
                        <button class="md-log-more" @onclick="LoadMoreChangeLogs" disabled="@_changeLogLoadingMore">
                            @if (_changeLogLoadingMore)
                            {
                                <span>در حال بارگذاری...</span>
                            }
                            else
                            {
                                <span>نمایش بیشتر (@(_changeLogTotal - _changeLogs.Count) مورد)</span>
                            }
                        </button>
                    </div>
                }
            }
        </div>
    }
</div>

<script>
    var mdTimer = setInterval(function() {
        var now = new Date();
        var h = String(now.getHours()).padStart(2,'0');
        var m = String(now.getMinutes()).padStart(2,'0');
        var s = String(now.getSeconds()).padStart(2,'0');
        var t = h+':'+m+':'+s;
        var d = now.toLocaleDateString('fa-IR', { year:'numeric', month:'long', day:'numeric' });
        var el = document.getElementById('mdClock');
        if (el) el.textContent = t;
        var el2 = document.getElementById('mdDate2');
        if (el2) el2.textContent = d;
    }, 1000);
</script>

<style>
    .md-bg {
        position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;
        background: linear-gradient(135deg, #f5f8fc 0%, #eff3f9 50%, #f2f5fa 100%);
        background-size: 200% 200%;
        animation: mdGradShift 40s ease-in-out infinite;
    }
    @@keyframes mdGradShift {
        0%,100%{ background-position: 0% 50%; }
        50%{ background-position: 100% 50%; }
    }

    .md-bg-blob {
        position: absolute; border-radius: 50%; filter: blur(50px);
        animation: mdBgDrift 24s ease-in-out infinite;
    }
    .md-bg-blob:nth-child(1) {
        width: 480px; height: 480px; top: -100px; right: -60px;
        background: rgba(0,168,168,0.023); animation-duration: 28s; animation-delay: -3s;
    }
    .md-bg-blob:nth-child(2) {
        width: 380px; height: 380px; bottom: -80px; left: -40px;
        background: rgba(16,185,129,0.018); animation-duration: 32s; animation-delay: -8s;
    }
    .md-bg-blob:nth-child(3) {
        width: 220px; height: 220px; top: 50%; left: 50%; transform: translate(-50%,-50%);
        background: rgba(139,92,246,0.012); animation-duration: 26s; animation-delay: -15s;
    }
    @@keyframes mdBgDrift {
        0%,100% { transform: translate(0,0) scale(1); }
        33% { transform: translate(10px,-12px) scale(1.06); }
        66% { transform: translate(-8px,8px) scale(0.96); }
    }

    /* Warning overlay */
    .md-warn-overlay {
        position: fixed; inset: 0; z-index: 9999;
        display: flex; align-items: center; justify-content: center;
        background: rgba(15,23,42,0.55);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        direction: rtl;
    }
    .md-warn-overlay.show {
        animation: mdWarnFadeIn 0.5s ease-out forwards;
    }
    .md-warn-overlay.hide {
        animation: mdWarnFadeOut 0.4s ease-in forwards;
    }
    @@keyframes mdWarnFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    @@keyframes mdWarnFadeOut {
        from { opacity: 1; }
        to { opacity: 0; }
    }

    .md-warn-card {
        background: rgba(255,255,255,0.97);
        border-radius: 24px; padding: 40px 36px 32px;
        max-width: 420px; width: 90%;
        text-align: center;
        box-shadow: 0 25px 60px rgba(0,0,0,0.2);
        animation: mdWarnCardIn 0.6s cubic-bezier(0.34,1.56,0.64,1) forwards;
    }
    .md-warn-overlay.hide .md-warn-card {
        animation: mdWarnCardOut 0.35s ease-in forwards;
    }
    @@keyframes mdWarnCardIn {
        from { opacity: 0; transform: translateY(30px) scale(0.92); }
        to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @@keyframes mdWarnCardOut {
        from { opacity: 1; transform: translateY(0) scale(1); }
        to { opacity: 0; transform: translateY(-20px) scale(0.95); }
    }

    .md-warn-icon {
        width: 64px; height: 64px; margin: 0 auto 16px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 50%;
        background: rgba(239,68,68,0.1);
        color: #ef4444;
        animation: mdWarnPulse 2s ease-in-out infinite;
    }
    @@keyframes mdWarnPulse {
        0%,100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(239,68,68,0.2); }
        50% { transform: scale(1.05); box-shadow: 0 0 0 10px rgba(239,68,68,0); }
    }

    .md-warn-title {
        font-size: 22px; font-weight: 950; color: #0f172a;
        margin-bottom: 14px;
    }

    .md-warn-text {
        font-size: 14px; font-weight: 600; color: #334155;
        line-height: 1.8; margin-bottom: 28px;
    }

    .md-warn-timer {
        display: flex; align-items: center; justify-content: center;
        margin-bottom: 24px;
    }
    .md-timer-svg { width: 80px; height: 80px; display: block; }
    .md-timer-glow {
        animation: timerGlow 1.5s ease-in-out infinite;
        pointer-events: none;
    }
    @@-webkit-keyframes timerGlow {
        0%, 100% { opacity: 0.15; stroke-width: 6; }
