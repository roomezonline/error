    private async Task DeferChatAsync()
    {
        try { await Task.Delay(2500); } catch { return; }
        if (_disposed || _showChat) return;
        _showChat = true;
        try { await InvokeAsync(StateHasChanged); } catch { }
    }

    private async Task SetupHeaderScrollBehavior()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", @"
                (function() {
                    'use strict';

                    var lastScrollTop = 0;
                    var scrollStartPoint = 0;
                    var lastDirection = 'none';
                    var touchStartY = 0;
                    var isTouching = false;
                    var currentTransform = 0;
                    var targetTransform = 0;
                    var isScrollingByNav = false;

                    var headerWrapper = document.querySelector('.app-header-group');
                    var header = document.querySelector('.app-header');
                    var scrollThreshold = 30;
                    var maxTransform = -100;

                    if (!headerWrapper || !header) return;

                    function handleScroll() {
                        if (isScrollingByNav) return;
                        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                        var scrollDirection = scrollTop > lastScrollTop ? 'down' : 'up';
                        if (scrollDirection !== lastDirection) {
                            scrollStartPoint = scrollTop;
                            lastDirection = scrollDirection;
                        }
                        var scrollDistance = Math.abs(scrollTop - scrollStartPoint);
                        if (scrollTop < 10 || isScrollingByNav) {
                            targetTransform = 0;
                        } else if (scrollDirection === 'down' && scrollDistance > scrollThreshold) {
                            var hideProgress = Math.min((scrollDistance - scrollThreshold) / 50, 1);
                            targetTransform = -hideProgress * 100;
                        } else if (scrollDirection === 'up' && scrollDistance > scrollThreshold) {
                            var showProgress = Math.min((scrollDistance - scrollThreshold) / 50, 1);
                            targetTransform = maxTransform + showProgress * 100;
                            if (targetTransform > 0) targetTransform = 0;
                        }
                        lastScrollTop = scrollTop;
                    }

                    function animateHeader() {
                        if (isScrollingByNav) {
                            currentTransform = 0;
                            targetTransform = 0;
                            headerWrapper.style.transform = 'translateY(0%)';
                            header.style.opacity = '1';
                            return;
                        }
                        var diff = targetTransform - currentTransform;
                        if (Math.abs(diff) > 0.1) {
                            currentTransform += diff * 0.15;
                            headerWrapper.style.transform = 'translateY(' + currentTransform + '%)';
                            header.style.opacity = 1 - Math.abs(currentTransform) / 100;
                            requestAnimationFrame(animateHeader);
                        } else {
                            currentTransform = targetTransform;
                            headerWrapper.style.transform = 'translateY(' + currentTransform + '%)';
                            header.style.opacity = 1 - Math.abs(currentTransform) / 100;
                        }
                    }

                    var ticking = false;
                    function throttledScroll() {
                        if (!ticking && !isScrollingByNav) {
                            window.requestAnimationFrame(function() {
                                handleScroll();
                                animateHeader();
                                ticking = false;
                            });
                            ticking = true;
                        }
                    }

                    function handleTouchStart(e) {
                        touchStartY = e.touches[0].clientY;
                        isTouching = true;
                    }

                    function handleTouchMove(e) {
                        if (!isTouching || isScrollingByNav) return;
                        var currentY = e.touches[0].clientY;
                        var deltaY = touchStartY - currentY;
                        if (Math.abs(deltaY) > 5) throttledScroll();
                    }

                    function handleTouchEnd() {
                        isTouching = false;
                        setTimeout(function() {
                            isScrollingByNav = false;
                            throttledScroll();
                        }, 100);
                    }

                    window.addEventListener('scroll', throttledScroll, { passive: true });
                    window.addEventListener('touchstart', handleTouchStart, { passive: true });
                    window.addEventListener('touchmove', handleTouchMove, { passive: true });
                    window.addEventListener('touchend', handleTouchEnd, { passive: true });

                    scrollStartPoint = window.pageYOffset || document.documentElement.scrollTop;
                    handleScroll();
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting up header scroll behavior: {ex.Message}");
        }
    }

