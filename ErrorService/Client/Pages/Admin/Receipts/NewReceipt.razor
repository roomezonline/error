    private static string CleanMobile(string raw)
    {
        var m = System.Text.RegularExpressions.Regex.Replace(raw ?? "", @"\D", "");
        if (m.StartsWith("0098")) m = m[4..];
        else if (m.StartsWith("9898")) m = m[2..];
        else if (m.StartsWith("98") && m.Length == 12) m = m[2..];
        if (m.Length == 10) m = "0" + m;
        return m;
    }
    private void NormalizeMobile() { newCustomer.Mobile = CleanMobile(newCustomer.Mobile); }
    private void NormalizeEditMobile() { editCustomer.Mobile = CleanMobile(editCustomer.Mobile); }

    private async Task CreateCustomer()
    {
        if (!CanWorkOnWorkshop)
        {
            ToastService.ShowWarning("ابتدا کارگاه را انتخاب کنید");
            return;
        }

        try
        {
            var qs = WorkshopQs();
            var content = JsonContent.Create(newCustomer);
            var resp = await Http.PostAsync($"api/workshop-customers{qs}", content);
            
            if (!resp.IsSuccessStatusCode)
            {
                if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    ToastService.ShowError("شما دسترسی لازم برای ثبت مشتری جدید را ندارید. لطفاً از مدیر سیستم بخواهید دسترسی شما را بررسی کند.");
                    return;
                }
                
                if (resp.StatusCode == System.Net.HttpStatusCode.InternalServerError)
                {
                    var serverMsg = await resp.Content.ReadAsStringAsync();
                    var errorMsg = string.IsNullOrWhiteSpace(serverMsg) 
                        ? "خطای داخلی سرور. لطفاً با پشتیبانی تماس بگیرید." 
                        : "خطای سرور: " + serverMsg.Trim('"');
                    ToastService.ShowError(errorMsg);
                    return;
                }
                
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(msg) ? "خطا در ثبت مشتری" : msg.Trim('"'));
                return;
            }

            var created = await resp.Content.ReadFromJsonAsync<WorkshopCustomerDto>();
            if (created != null)
            {
                SelectCustomer(created);
                ToastService.ShowSuccess("مشتری ثبت شد");
                newCustomer = new WorkshopCustomerUpsertRequest();
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            ToastService.ShowError("شما دسترسی لازم برای ثبت مشتری جدید را ندارید. لطفاً از مدیر سیستم بخواهید دسترسی شما را بررسی کند.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا در ارتباط با سرور: {ex.Message}");
        }
    }

