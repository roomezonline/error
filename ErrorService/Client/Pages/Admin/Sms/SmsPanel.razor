    // ─── Charge Request (Workshop submit) ───
    private void OnChargeAmountInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString()?.Replace(",", "");
        if (decimal.TryParse(raw, out var val))
        {
            _chargeRequestValue = val;
        }
        // Format with commas for display
        if (string.IsNullOrEmpty(raw))
        {
            _chargeRequestDisplay = "";
            _chargeRequestValue = 0;
        }
        else
        {
            _chargeRequestDisplay = string.Format("{0:N0}", _chargeRequestValue);
        }
    }

    private async Task OnReceiptFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || file.Size > 2 * 1024 * 1024)
        {
            ToastService.ShowError("حجم فایل باید کمتر از ۲ مگابایت باشد");
            return;
        }
        _receiptFile = file;
        _receiptFileName = file.Name;

        try
        {
            var compressed = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            _receiptPreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(compressed)}";
        }
        catch
        {
            _receiptPreviewUrl = null;
        }
    }

    private void ClearReceiptFile()
    {
        _receiptFile = null;
        _receiptFileName = null;
        _receiptPreviewUrl = null;
    }

    private async Task SubmitChargeRequest()
    {
        if (_chargeRequestValue < 1000) return;
        _submittingCharge = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/workshop-sms/charges",
                new SmsChargeSubmitRequest { Amount = _chargeRequestValue, Description = _chargeRequestDesc });
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<Dictionary<string, int>>();
                var chargeId = result?["id"] ?? 0;

                // Upload receipt if selected
                if (_receiptFile != null && chargeId > 0)
                {
                    try
                    {
                        var compressed = await ImageCompressionHelper.CompressIfNeededAsync(_receiptFile, JS);
                        using var content = new MultipartFormDataContent();
                        content.Add(new ByteArrayContent(compressed), "file", _receiptFile.Name);
                        var receiptResponse = await Http.PostAsync($"api/workshop-sms/charges/{chargeId}/receipt", content);
                        if (!receiptResponse.IsSuccessStatusCode)
                        {
                            ToastService.ShowWarning("درخواست شارژ ثبت شد اما آپلود رسید با خطا مواجه شد");
                        }
                    }
                    catch (Exception)
                    {
                        ToastService.ShowWarning("درخواست شارژ ثبت شد اما آپلود رسید با خطا مواجه شد");
                    }
                }

                ToastService.ShowSuccess("درخواست شارژ با موفقیت ثبت شد");
                _chargeRequestValue = 0;
                _chargeRequestDisplay = "";
                _chargeRequestDesc = "";
                _receiptFile = null;
                _receiptFileName = null;
                await LoadMyCharges();
                await LoadDashboard();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"خطا: {err}");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا: {ex.Message}");
        }
        finally { _submittingCharge = false; }
    }

