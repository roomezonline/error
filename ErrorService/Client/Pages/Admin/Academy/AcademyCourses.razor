@page "/admin/academy"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.academy.courses.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Services
@inject HttpClient Http
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="admin-container" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="admin-page-title m-0">مدیریت آکادمی آموزش</h3>
        <button class="btn btn-primary shadow-sm rounded-3" @onclick="NewCourse">
            <span class="oi oi-plus me-1"></span> دوره جدید
        </button>
    </div>

    @if (showEditor)
    {
        <div class="card shadow-sm border-0 rounded-4 mb-4 p-4 animate__animated animate__fadeIn">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="m-0 fw-bold">@(editingId == 0 ? "ایجاد دوره جدید" : "ویرایش دوره")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>

            <EditForm Model="model" OnValidSubmit="SaveCourse">
                <DataAnnotationsValidator />
                <div class="row g-4">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">عنوان دوره</label>
                            <InputText @bind-Value="model.Title" class="form-control rounded-3" placeholder="نام دوره آموزشی..." />
                            <ValidationMessage For="@(() => model.Title)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">خلاصه دوره</label>
                            <InputTextArea @bind-Value="model.Summary" class="form-control rounded-3" rows="3" placeholder="توضیح کوتاه درباره دوره..." />
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold">تصویر کاور</label>
                            <div class="image-upload-zone rounded-4 border-2 border-dashed d-flex flex-column align-items-center justify-content-center p-4 bg-light position-relative">
                                @if (!string.IsNullOrEmpty(model.CoverImageUrl))
                                {
                                    <img src="@model.CoverImageUrl" class="img-fluid rounded-3 mb-2" style="max-height: 150px;" />
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 rounded-circle shadow" @onclick="ClearImage">
                                        <span class="oi oi-x"></span>
                                    </button>
                                }
                                else
                                {
                                    <span class="oi oi-cloud-upload display-4 text-muted mb-2"></span>
                                    <InputFile OnChange="HandleFileUpload" class="position-absolute w-100 h-100 opacity-0" style="cursor: pointer; top: 0; left: 0;" />
                                    <span class="text-muted small text-center">برای انتخاب تصویر کاور کلیک کنید</span>
                                }
                            </div>
                            @if (isUploading)
                            {
                                <div class="progress mt-2" style="height: 6px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                                </div>
                            }
                        </div>

                        <div class="card bg-light border-0 rounded-4 p-3 mb-3">
                            <div class="form-check form-switch mb-2">
                                <InputCheckbox @bind-Value="model.IsPublished" class="form-check-input" id="isPublished" />
                                <label class="form-check-label fw-bold" for="isPublished">انتشار در سایت</label>
                            </div>
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="model.IsPremium" class="form-check-input" id="isPremium" />
                                <label class="form-check-label fw-bold text-warning" for="isPremium">دوره ویژه (VIP)</label>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">ترتیب نمایش</label>
                            <InputNumber @bind-Value="model.SortOrder" class="form-control rounded-3" />
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-light rounded-3 px-4" @onclick="CloseEditor">انصراف</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        ذخیره دوره
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4" style="width: 100px;">کاور</th>
                        <th>عنوان دوره</th>
                        <th>تعداد قسمت‌ها</th>
                        <th>وضعیت</th>
                        <th>دسترسی</th>
                        <th class="text-end pe-4">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (courses == null)
                    {
                        <tr><td colspan="6" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                    }
                    else if (!courses.Any())
                    {
                        <tr><td colspan="6" class="text-center py-5 text-muted">هیچ دوره‌ای یافت نشد.</td></tr>
                    }
                    else
                    {
                        @foreach (var course in courses)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="course-thumb rounded-3 bg-light overflow-hidden" style="width: 60px; height: 60px;">
                                        @if (!string.IsNullOrEmpty(course.CoverImageUrl))
                                        {
                                            <img src="@course.CoverImageUrl" class="w-100 h-100 object-fit-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted">
                                                <span class="oi oi-image"></span>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@course.Title</div>
                                    <div class="small text-muted text-truncate" style="max-width: 300px;">@course.Summary</div>
                                </td>
                                <td><span class="badge bg-light text-dark border rounded-pill px-3">@course.LessonsCount قسمت</span></td>
                                <td>
                                    <span class="badge @(course.IsPublished ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill px-3">
                                        @(course.IsPublished ? "منتشر شده" : "پیش‌نویس")
                                    </span>
                                </td>
                                <td>
                                    <span class="badge @(course.IsPremium ? "bg-warning-subtle text-warning" : "bg-info-subtle text-info") rounded-pill px-3">
                                        @(course.IsPremium ? "ویژه" : "رایگان")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-info border-0 rounded-circle me-1" @onclick="() => ManageLessons(course.Id)" title="مدیریت قسمت‌ها">
                                        <span class="oi oi-list"></span>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary border-0 rounded-circle me-1" @onclick="() => EditCourse(course)" title="ویرایش">
                                        <span class="oi oi-pencil"></span>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" @onclick="() => ConfirmDelete(course.Id)" title="حذف">
                                        <span class="oi oi-trash"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .image-upload-zone { min-height: 150px; transition: all 0.2s ease; border: 2px dashed #dee2e6; }
    .image-upload-zone:hover { background: #f0f4f8 !important; border-color: #0d6efd !important; }
    .object-fit-cover { object-fit: cover; }
    .bg-success-subtle { background-color: #d1e7dd; }
    .bg-warning-subtle { background-color: #fff3cd; }
    .bg-info-subtle { background-color: #cff4fc; }
    .admin-container { padding: 20px; }
</style>

@code {
    private List<TrainingCourseDto>? courses;
    private TrainingCourseUpsertRequest model = new();
    private bool showEditor;
    private int editingId;
    private bool isSaving;
    private bool isUploading;

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        courses = await Http.GetFromJsonAsync<List<TrainingCourseDto>>("api/trainings/courses");
    }

    private void NewCourse()
    {
        editingId = 0;
        model = new TrainingCourseUpsertRequest { IsPublished = true };
        showEditor = true;
    }

    private void EditCourse(TrainingCourseDto course)
    {
        editingId = course.Id;
        model = new TrainingCourseUpsertRequest
        {
            Title = course.Title,
            Summary = course.Summary,
            CoverImageUrl = course.CoverImageUrl,
            IsPublished = course.IsPublished,
            IsPremium = course.IsPremium,
            SortOrder = course.SortOrder
        };
        showEditor = true;
    }

    private void CloseEditor() => showEditor = false;

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        isUploading = true;
        try
        {
            var file = e.File;
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            using var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var resp = await Http.PostAsync("api/trainings/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                model.CoverImageUrl = await resp.Content.ReadAsStringAsync();
                model.CoverImageUrl = model.CoverImageUrl.Trim('"');
                ToastService.ShowSuccess("تصویر آپلود شد");
            }
        }
        catch (Exception ex) { ToastService.ShowError("خطا در آپلود: " + ex.Message); }
        finally { isUploading = false; }
    }

    private void ClearImage() => model.CoverImageUrl = null;

    private async Task SaveCourse()
    {
        isSaving = true;
        try
        {
            HttpResponseMessage resp;
            if (editingId == 0) resp = await Http.PostAsJsonAsync("api/trainings/courses", model);
            else resp = await Http.PutAsJsonAsync($"api/trainings/courses/{editingId}", model);

            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("دوره ذخیره شد");
                await LoadCourses();
                showEditor = false;
            }
        }
        catch (Exception ex) { ToastService.ShowError("خطا: " + ex.Message); }
        finally { isSaving = false; }
    }

    private void ManageLessons(int courseId) => Nav.NavigateTo($"/admin/academy/lessons/{courseId}");

    private async Task ConfirmDelete(int id)
    {
        // For simplicity using window.confirm, but you could use your ConfirmDialog component
        if (await Http.DeleteAsync($"api/trainings/courses/{id}") != null)
        {
            ToastService.ShowSuccess("دوره حذف شد");
            await LoadCourses();
        }
    }
}
