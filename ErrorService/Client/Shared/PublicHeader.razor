<header class="public-header" dir="rtl">
    <div class="public-header__container">
        <div class="public-header__right">
            <a class="public-header__brand" href="/">ارورسرویس</a>
        </div>

        <nav class="public-header__nav" aria-label="Main navigation">
            <a class="public-header__link" href="/">خانه</a>
            <a class="public-header__link" href="/products">لیست محصولات</a>
            <a class="public-header__link" href="/academy">آکادمی آموزش</a>
            <a class="public-header__link" href="/about">درباره ارورسرویس</a>
            <a class="public-header__link" href="/contact">تماس با ما</a>
            <a class="public-header__link" href="/order-tracking">پیگیری سفارش</a>
        </nav>

        <div class="public-header__search" aria-label="Search">
            <GlobalSearch />
        </div>

        <div class="public-header__left">
            <button type="button" class="public-header__icon" title="سبد خرید" aria-label="سبد خرید">
                <span class="oi oi-cart" aria-hidden="true"></span>
            </button>
            <button type="button" class="public-header__icon" title="جستجو" aria-label="جستجو">
                <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
            </button>

            <a class="public-header__login" href="/login">ورود به حساب کاربری</a>

            <button type="button" class="public-header__menu" @onclick="ToggleMenu" aria-label="منو" title="منو">
                <span class="oi oi-menu" aria-hidden="true"></span>
            </button>
        </div>
    </div>

    <div class="public-header__mobile-search">
        <GlobalSearch />
    </div>

    <div class="public-header__mobile" hidden="@(!isMenuOpen)">
        <a class="public-header__mobile-link" href="/">خانه</a>
        <a class="public-header__mobile-link" href="/products">لیست محصولات</a>
        <a class="public-header__mobile-link" href="/academy">آکادمی آموزش</a>
        <a class="public-header__mobile-link" href="/about">درباره ارورسرویس</a>
        <a class="public-header__mobile-link" href="/contact">تماس با ما</a>
        <a class="public-header__mobile-link" href="/order-tracking">پیگیری سفارش</a>
    </div>
</header>

@code {
    private bool isMenuOpen;

    private void ToggleMenu()
    {
        isMenuOpen = !isMenuOpen;
    }
}
