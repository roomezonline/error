        padding-right: 14px;
    }

    .wr-input:focus, .wr-select:focus, .wr-textarea:focus {
        border-color: var(--wr-primary);
        box-shadow: 0 0 0 5px rgba(79, 70, 229, 0.08);
        background: var(--wr-surface);
    }

    .wr-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .wr-actions {
        display: flex;
        gap: 10px;
        justify-content: space-between;
        margin-top: 12px;
    }

    .wr-btn {
