@using System.Net.Http.Json

<section class="tg-section home-section" dir="rtl">
    <div class="tg-container">
        @if (isLoading)
        {
            <div class="tg-grid-2">
                <div class="tg-skel-section">
                    <div class="tg-sk-head"></div>
                    <div class="tg-sk-list">@for (int i = 0; i < 4; i++) { <div class="tg-sk-row"><div class="tg-sk-icon"></div><div><div class="tg-sk-line w-50 mb-1"></div><div class="tg-sk-line w-75"></div></div></div> }</div>
                </div>
                <div class="tg-skel-section">
                    <div class="tg-sk-head"></div>
                    <div class="tg-sk-list">@for (int i = 0; i < 4; i++) { <div class="tg-sk-row"><div class="tg-sk-icon"></div><div><div class="tg-sk-line w-50 mb-1"></div><div class="tg-sk-line w-75"></div></div></div> }</div>
                </div>
            </div>
        }
        else if (hasData)
        {
            <div class="tg-grid-2">
                <!-- Error Codes -->
                <div class="tg-col">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h3 class="tg-col-title">
                            <span class="oi oi-document-text tg-col-icon tg-col-icon--blue"></span>
                            بانک کد خطا
                        </h3>
                        <a href="/technical/error-codes" class="home-more home-more--sm">مشاهده همه</a>
                    </div>
                    <div class="tg-list">
                        @foreach (var item in recentErrors)
                        {
                            <a href="@($"/technical/error-codes/{Uri.EscapeDataString(item.Brand)}/{Uri.EscapeDataString(item.DeviceType)}/{Uri.EscapeDataString(item.Code)}")" class="tg-row">
                                <span class="tg-row-icon tg-row-icon--code">
                                    @item.Code
                                </span>
                                <div class="tg-row-body">
                                    <div class="tg-row-title">
                                        <span class="tg-badge tg-badge--brand">@item.Brand</span>
                                        <span class="tg-desc-text">@item.Description</span>
                                    </div>
                                    <div class="tg-solution-text">@item.Solution</div>
                                </div>
                                <span class="oi oi-chevron-left tg-row-arrow"></span>
                            </a>
                        }
                    </div>
                </div>

                <!-- Sensors -->
                <div class="tg-col">
                    <div class="d-flex align-items-center justify-content-between mb-3">
                        <h3 class="tg-col-title">
                            <span class="oi oi-microchip tg-col-icon tg-col-icon--green"></span>
                            سنسور یاب
                        </h3>
                        <a href="/technical/sensor-finder" class="home-more home-more--sm">مشاهده همه</a>
                    </div>
                    <div class="tg-list">
                        @foreach (var item in recentSensors)
                        {
                            <a href="/technical/sensor-finder/@item.Id" class="tg-row">
                                <span class="tg-row-icon tg-row-icon--sensor">
                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                    {
                                        <img src="@ImageUrlHelper.Thumb(item.ImageUrl, 200)" loading="lazy" decoding="async" alt="@item.SensorName" />
                                    }
                                    else
                                    {
                                        <span class="oi oi-microchip"></span>
                                    }
                                </span>
                                <div class="tg-row-body">
                                    <div class="tg-row-title">
                                        <span class="tg-badge tg-badge--sensor">@item.SensorType</span>
                                        <span>@item.SensorName</span>
                                    </div>
                                    <div class="tg-row-desc">
                                        @item.DeviceName
                                        @if (!string.IsNullOrEmpty(item.SizeText))
                                        {
                                            <span class="tg-size-tag">@item.SizeText</span>
                                        }
                                    </div>
                                </div>
                                <span class="oi oi-chevron-left tg-row-arrow"></span>
                            </a>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</section>


@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private bool isLoading = true;
    private bool hasData;
    private List<ErrorCodePreview> recentErrors = new();
    private List<SensorPreview> recentSensors = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var errorsTask = Http.GetFromJsonAsync<List<ErrorCodePreview>>("api/technical/error-codes/recent?take=6");
            var sensorsTask = Http.GetFromJsonAsync<List<SensorPreview>>("api/sensor-finder/records/recent?take=6");

            await Task.WhenAll(errorsTask, sensorsTask);

            if (errorsTask.Result?.Count > 0)
                recentErrors = errorsTask.Result;
            if (sensorsTask.Result?.Count > 0)
                recentSensors = sensorsTask.Result;

            hasData = recentErrors.Count > 0 || recentSensors.Count > 0;
        }
        catch
        {
            hasData = false;
        }
        finally
        {
            isLoading = false;
        }
    }

    private sealed class ErrorCodePreview
    {
        public string Brand { get; set; } = "";
        public string DeviceType { get; set; } = "";
        public string Code { get; set; } = "";
        public string? Description { get; set; }
        public string? Solution { get; set; }
    }

    private sealed class SensorPreview
    {
        public int Id { get; set; }
        public string DeviceName { get; set; } = "";
        public string SensorName { get; set; } = "";
        public string? SensorType { get; set; }
        public string? SizeText { get; set; }
        public string? ImageUrl { get; set; }
    }
}
