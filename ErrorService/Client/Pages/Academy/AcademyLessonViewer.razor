@page "/academy/{CourseId:int}/{LessonId:int}"
@using ErrorService.Shared
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject HttpClient Http

<PageTitle>@(lesson?.Title ?? "مشاهده قسمت") - آکادمی</PageTitle>

<SeoHeader 
    Title="@($"{lesson?.Title ?? "مشاهده قسمت"} - آکادمی ارورسرویس")"
    Description="@($"{lesson?.Title ?? "مشاهده قسمت آموزشی"} - دوره آموزش تعمیرات لوازم خانگی ارورسرویس")"
    Keywords="@($"آموزش تعمیرات, {lesson?.Title ?? "قسمت آموزشی"}")"
    OgType="video.other"
    JsonLd="@lessonJsonLd" />

@if (lesson != null)
{
    <ViewTracker EntityType="lesson" EntityId="LessonId" />
}

<div class="lesson-viewer-page py-4 bg-light" dir="rtl">
    <div class="container">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (isForbidden)
        {
            <div class="alert alert-warning rounded-4 shadow-sm">
                این قسمت ویژه (VIP) است. برای مشاهده محتوا باید وارد حساب VIP شوید.
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-primary rounded-pill" href="/auth/login">ورود</a>
                <a class="btn btn-outline-primary rounded-pill" href="/academy/@CourseId">بازگشت به لیست قسمت‌ها</a>
            </div>
        }
        else if (lesson == null)
        {
            <div class="alert alert-danger rounded-4 shadow-sm">قسمت مورد نظر یافت نشد.</div>
        }
        else
        {
            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/academy">آکادمی</a></li>
                    <li class="breadcrumb-item"><a href="/academy/@CourseId">@courseTitle</a></li>
                    <li class="breadcrumb-item active">@lesson.Title</li>
                </ol>
            </nav>

            <div class="row g-4">
                <div class="col-lg-9">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                        <div class="card-body p-4 p-md-5">
                            <h1 class="fw-bold h2 mb-2">@lesson.Title</h1>
                            <div class="d-flex align-items-center gap-3 mb-4" style="font-size: 0.82rem; color: #6366f1;">
                                <span class="d-flex align-items-center gap-1">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    @lesson.ViewCount.ToString("N0") بازدید
                                </span>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(lesson.Summary))
                            {
                                <p class="text-muted fs-5 mb-5 leading-relaxed">@lesson.Summary</p>
                            }

                            <div class="lesson-content-blocks">
                                @foreach (var group in BuildBlockGroups(lesson.Blocks))
                                {
                                    var first = group.Blocks[0];
                                    <div class="content-block mb-5" @key="group.Key">
                                        @if (group.Type == TrainingBlockTypeDto.Text && !string.IsNullOrEmpty(first.Title))
                                        {
                                            <h4 class="fw-bold mb-3 content-block__title">@first.Title</h4>
                                        }

                                        @switch (group.Type)
                                        {
                                            case TrainingBlockTypeDto.Text:
                                                foreach (var block in group.Blocks)
                                                {
                                                    if (!string.IsNullOrEmpty(block.Title) && block.Id != first.Id)
                                                    {
                                                        <h4 class="fw-bold mb-3 content-block__title">@block.Title</h4>
                                                    }
                                                    <div class="text-content fs-6 leading-loose">@((MarkupString)(block.Content?.Replace("\n", "<br/>") ?? ""))</div>
                                                }
                                                break;

                                            case TrainingBlockTypeDto.Image:
                                                <div class="media-card media-card--image">
                                                    <div class="media-card__header">
                                                        <span class="media-card__badge">
                                                            <span class="oi oi-image"></span>
                                                            @(group.Blocks.Count > 1 ? $"گالری تصاویر ({group.Blocks.Count})" : "تصویر")
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(first.Title))
                                                        {
                                                            <span class="media-card__title">@first.Title</span>
                                                        }
                                                    </div>
                                                    <div class="media-card__body">
                                                        <div class="lesson-gallery">
                                                            @foreach (var block in group.Blocks)
                                                            {
                                                                <button type="button" class="lesson-gallery__item" data-lightbox-src="@block.Url" aria-label="بزرگ‌نمایی تصویر" title="برای بزرگ‌نمایی کلیک کنید">
                                                                    <img src="@block.Url" class="lesson-gallery__img" alt="@(block.Title ?? "تصویر آموزش")" loading="lazy" />
                                                                </button>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.Video:
                                                <div class="media-card media-card--video">
                                                    <div class="media-card__header">
                                                        <span class="media-card__badge">
                                                            <span class="oi oi-video"></span>
                                                            @(group.Blocks.Count > 1 ? $"ویدیوها ({group.Blocks.Count})" : "ویدیو")
                                                        </span>
                                                        @if (group.Blocks.Count == 1 && !string.IsNullOrEmpty(first.Url))
                                                        {
                                                            <a href="@first.Url" class="media-card__dl" download title="دانلود ویدیو">
                                                                <span class="oi oi-cloud-download"></span> دانلود
                                                            </a>
                                                        }
                                                    </div>
                                                    <div class="media-card__body">
                                                        <div class="media-grid @(group.Blocks.Count > 1 ? "media-grid--multi" : "")">
                                                            @foreach (var block in group.Blocks)
                                                            {
                                                                <div class="media-grid__cell">
                                                                    @if (!string.IsNullOrEmpty(block.Title))
                                                                    {
                                                                        <div class="media-cell__title">@block.Title</div>
                                                                    }
                                                                    <div class="video-content rounded-4 overflow-hidden shadow">
                                                                        <video class="js-plyr lazy-video" playsinline controls data-poster="@block.ThumbnailUrl" data-src="@GetPlayableUrl(block.Url)">
                                                                            <source src="" type="@GetVideoMime(block.Url)" />
                                                                        </video>
                                                                    </div>
                                                                    @if (!string.IsNullOrEmpty(block.Url))
                                                                    {
                                                                        <a href="@block.Url" class="media-cell__dl" download>
                                                                            <span class="oi oi-cloud-download"></span> دانلود ویدیو
                                                                        </a>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.Audio:
                                                <div class="media-card media-card--audio">
                                                    <div class="media-card__header">
                                                        <span class="media-card__badge">
                                                            <span class="oi oi-volume-high"></span>
                                                            @(group.Blocks.Count > 1 ? $"فایل‌های صوتی ({group.Blocks.Count})" : "صوت")
                                                        </span>
                                                        @if (group.Blocks.Count == 1 && !string.IsNullOrEmpty(first.Url))
                                                        {
                                                            <a href="@first.Url" class="media-card__dl" download title="دانلود صوت">
                                                                <span class="oi oi-cloud-download"></span> دانلود
                                                            </a>
                                                        }
                                                    </div>
                                                    <div class="media-card__body">
                                                        <div class="media-stack">
                                                            @foreach (var block in group.Blocks)
                                                            {
                                                                <div class="media-stack__item">
                                                                    @if (!string.IsNullOrEmpty(block.Title))
                                                                    {
                                                                        <div class="media-cell__title">@block.Title</div>
                                                                    }
                                                                    <div class="audio-content shadow-sm rounded-4">
                                                                        <audio class="js-plyr" controls>
                                                                            <source src="@GetPlayableUrl(block.Url)" type="@GetAudioMime(block.Url)" />
                                                                        </audio>
                                                                    </div>
                                                                    @if (!string.IsNullOrEmpty(block.Url))
                                                                    {
                                                                        <a href="@block.Url" class="media-cell__dl" download>
                                                                            <span class="oi oi-cloud-download"></span> دانلود صوت
                                                                        </a>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.File:
                                                <div class="media-card media-card--file">
                                                    <div class="media-card__header">
                                                        <span class="media-card__badge">
                                                            <span class="oi oi-file"></span>
                                                            @(group.Blocks.Count > 1 ? $"فایل‌ها ({group.Blocks.Count})" : "فایل")
                                                        </span>
                                                    </div>
                                                    <div class="media-card__body media-card__body--stack">
                                                        @foreach (var block in group.Blocks)
                                                        {
                                                            <a href="@block.Url" target="_blank" class="lesson-file-tile">
                                                                <span class="lesson-file-tile__icon"><span class="oi oi-data-transfer-download"></span></span>
                                                                <span class="lesson-file-tile__info">
                                                                    <strong>@(string.IsNullOrEmpty(block.Title) ? "فایل ضمیمه" : block.Title)</strong>
                                                                    <small>@(string.IsNullOrEmpty(block.Content) ? "دانلود فایل" : block.Content)</small>
                                                                </span>
                                                                <span class="lesson-file-tile__btn">دانلود</span>
                                                            </a>
                                                        }
                                                    </div>
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.Embed:
                                                <div class="media-card media-card--embed">
                                                    <div class="media-card__header">
                                                        <span class="media-card__badge">
                                                            <span class="oi oi-code"></span>
                                                            @(group.Blocks.Count > 1 ? $"کدهای جاسازی ({group.Blocks.Count})" : "کد Embed")
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(first.Url))
                                                        {
                                                            <a href="@first.Url" target="_blank" class="media-card__dl" title="باز کردن لینک">
                                                                <span class="oi oi-external-link"></span> باز کردن
                                                            </a>
                                                        }
                                                    </div>
                                                    <div class="media-card__body">
                                                        <div class="media-stack">
                                                            @foreach (var block in group.Blocks)
                                                            {
                                                                @if (!string.IsNullOrEmpty(block.Title))
                                                                {
                                                                    <div class="media-cell__title">@block.Title</div>
                                                                }
                                                                <div class="embed-content rounded-4 overflow-hidden shadow">
                                                                    @((MarkupString)(block.Content ?? ""))
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                break;
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-3">
                    @if (lesson.Attachments.Any())
                    {
                        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                            <h5 class="fw-bold mb-3 d-flex align-items-center gap-2">
                                <span class="oi oi-paperclip text-primary"></span>
                                فایل‌های ضمیمه
                            </h5>
                            <div class="list-group list-group-flush border-0">
                                @foreach (var att in lesson.Attachments.OrderBy(x => x.SortOrder))
                                {
                                    <a href="@att.FileUrl" target="_blank" class="list-group-item list-group-item-action bg-light border-0 rounded-3 mb-2 d-flex align-items-center gap-2 p-3">
                                        <span class="oi oi-data-transfer-download text-primary"></span>
                                        <div class="small text-truncate">@att.Title</div>
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    <div class="quick-access-card card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                        <div class="quick-access-card__header">
                            <span class="oi oi-speedometer"></span>
                            <h6 class="fw-bold mb-0">دسترسی سریع</h6>
                        </div>
                        <div class="quick-access-card__body">
                            <a href="/academy/@CourseId" class="quick-access-card__link">
                                <span class="oi oi-list"></span>
                                <span>لیست تمام قسمت‌ها</span>
                                <span class="oi oi-chevron-left me-auto"></span>
                            </a>
                            <a href="/academy" class="quick-access-card__link">
                                <span class="oi oi-home"></span>
                                <span>بازگشت به آکادمی</span>
                                <span class="oi oi-chevron-left me-auto"></span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

