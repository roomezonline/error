<script>
    window.__pdScrollHandler = function(dotnetRef) {
        var handler = function() {
            dotnetRef.invokeMethodAsync('OnScroll', window.scrollY > 350);
        };
        window.addEventListener('scroll', handler, { passive: true });
        handler();
        return handler;
    };
    window.__pdRemoveScrollHandler = function(handler) {
        window.removeEventListener('scroll', handler);
    };
    window.__pdFocusElement = function(id) {
        var el = document.getElementById(id);
        if (el) el.focus();
    };
</script>



@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    [Inject] private HttpClient HttpApi { get; set; } = default!;
