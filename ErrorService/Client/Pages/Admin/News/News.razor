    private void NewNews()
    {
        editingId = 0;
        model = new NewsUpsertRequest { IsPublished = true };
        createdAtInput = PersianDate.ToJalaliDateTime(DateTimeOffset.Now);
        _quillInitialized = false;
        _lastQuillEditingId = 0;
        showEditor = true;
    }

    private void EditNews(NewsDto news)
    {
        editingId = news.Id;
        model = new NewsUpsertRequest
        {
            Title = news.Title ?? string.Empty,
            Summary = news.Summary,
            Content = news.Content ?? string.Empty,
            ImageUrl = news.ImageUrl,
            Tags = news.Tags,
            AuthorName = news.AuthorName,
            IsPublished = news.IsPublished,
            CreatedAt = news.CreatedAt
        };

        createdAtInput = PersianDate.ToJalaliDateTime(news.CreatedAt);
        _quillInitialized = false;
        _lastQuillEditingId = 0;
        showEditor = true;
    }

    private async Task SaveNews()
    {
        isSaving = true;
        try
        {
            // Get content from Quill editor
            var quillContent = await JS.InvokeAsync<string>("getQuillContent", "quill-editor-container");
            if (!string.IsNullOrEmpty(quillContent))
            {
                model.Content = quillContent;
            }

            if (PersianDate.TryParseJalaliDateTime(createdAtInput, out var createdAt))
                model.CreatedAt = createdAt;
            else
                model.CreatedAt = null;

            HttpResponseMessage resp;
            if (editingId == 0) resp = await Http.PostAsJsonAsync("api/news", model);
            else resp = await Http.PutAsJsonAsync($"api/news/{editingId}", model);
            
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(editingId == 0 ? "خبر با موفقیت ثبت شد" : "تغییرات خبر ذخیره شد");
                await LoadNews();
                CloseEditor();
            }
            else
            {
                ToastService.ShowError("خطا در ذخیره‌سازی خبر");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally { isSaving = false; }
    }

    private void CloseEditor()
    {
        showEditor = false;
        _quillInitialized = false;
        _lastQuillEditingId = 0;
        _ = JS.InvokeVoidAsync("destroyQuillEditor", "quill-editor-container");
    }

    private NewsDto? itemToDelete;
    private bool showConfirm;

    private void ConfirmDelete(NewsDto news)
    {
        itemToDelete = news;
        showConfirm = true;
    }

    private async Task HandleDeleteResult(bool result)
    {
        showConfirm = false;
        if (result && itemToDelete != null)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/news/{itemToDelete.Id}");
                if (response.IsSuccessStatusCode)
                {
                    ToastService.ShowSuccess("خبر با موفقیت حذف شد");
                    await LoadNews();
                }
                else
                {
                    ToastService.ShowError("خطا در حذف خبر");
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"خطای سیستمی: {ex.Message}");
            }
        }
        itemToDelete = null;
    }
