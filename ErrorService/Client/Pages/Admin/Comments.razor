    private List<CommentItem> GetCurrentList() => _activeSection switch
    {
        SECTION_PRODUCTS => _productReviews,
        SECTION_ACADEMY => _academyComments,
        SECTION_TESTIMONIALS => _testimonials,
        _ => _newsComments
    };

    private List<FlatNode> BuildFlatList()
    {
        var flat = GetCurrentList();
        _currentTotal = flat.Count;
        _currentApproved = flat.Count(r => r.IsApproved);
        _currentPending = flat.Count(r => !r.IsApproved);
        _totalPending = _productPending + _academyPending + _testimonialPending + _newsPending;

        var roots = flat.Where(r => r.ParentId == null).OrderByDescending(r => r.Id).ToList();
        var result = new List<FlatNode>();
        foreach (var root in roots)
            FlattenTree(root, 0, result);

        var hasMatch = result.Any(n => IsVisible(n.Item));
        if (!hasMatch) return new();

        return result;
    }

    private bool IsVisible(CommentItem item)
    {
        if (_activeFilter == "approved" && !item.IsApproved) return false;
        if (_activeFilter == "pending" && item.IsApproved) return false;
        if (!string.IsNullOrEmpty(_searchText)
            && !item.Author.Contains(_searchText, StringComparison.OrdinalIgnoreCase)
            && !item.Content.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            return false;
        return true;
    }

    private void FlattenTree(CommentItem item, int depth, List<FlatNode> result)
    {
        result.Add(new FlatNode { Item = item, Depth = depth });
        if (item._children != null)
        {
            foreach (var child in item._children)
                FlattenTree(child, depth + 1, result);
        }
    }

    private void UpdateStats()
    {
        var list = GetCurrentList();
        _currentTotal = list.Count;
        _currentApproved = list.Count(r => r.IsApproved);
        _currentPending = list.Count(r => !r.IsApproved);
    }

    private async Task ToggleApproveItem(CommentItem item)
    {
        try
        {
            var resp = item.SourceType switch
            {
                SECTION_PRODUCTS => await Http.PutAsync($"api/products/{item.OwnerId}/reviews/{item.Id}/approve", null),
                SECTION_ACADEMY => await Http.PutAsync($"api/trainingarticles/comments/{item.Id}/approve", null),
                SECTION_NEWS => await Http.PutAsync($"api/news/{item.OwnerId}/comments/{item.Id}/approve", null),
                _ => await Http.PutAsync($"api/trust/admin/testimonials/{item.Id}/approve", null)
            };
            if (resp.IsSuccessStatusCode)
            {
                item.IsApproved = !item.IsApproved;
                RecalcCounts();
                ToastService.ShowSuccess(item.IsApproved ? "نظر تایید شد" : "تایید نظر لغو شد");
            }
        }
        catch { ToastService.ShowError("خطا در تغییر وضعیت"); }
    }

    private CommentItem? _deleteItem;
    private bool _showConfirm;

    private void AskDelete(CommentItem item)
    {
        _deleteItem = item;
        _showConfirm = true;
    }

    private async Task HandleDeleteResult(bool ok)
    {
        _showConfirm = false;
        if (!ok || _deleteItem == null) return;
        try
        {
            var resp = _deleteItem.SourceType switch
            {
                SECTION_PRODUCTS => await Http.DeleteAsync($"api/products/{_deleteItem.OwnerId}/reviews/{_deleteItem.Id}"),
                SECTION_ACADEMY => await Http.DeleteAsync($"api/trainingarticles/comments/{_deleteItem.Id}"),
                SECTION_NEWS => await Http.DeleteAsync($"api/news/{_deleteItem.OwnerId}/comments/{_deleteItem.Id}"),
                _ => await Http.DeleteAsync($"api/trust/admin/testimonials/{_deleteItem.Id}")
            };
            if (resp.IsSuccessStatusCode)
            {
                RemoveFromList(GetCurrentList(), _deleteItem);
                RecalcCounts();
                ToastService.ShowSuccess("نظر حذف شد");
            }
        }
        catch { ToastService.ShowError("خطا در حذف"); }
    }

    private void RemoveFromList(List<CommentItem> list, CommentItem item)
    {
        list.Remove(item);
        if (item._children != null)
        {
            foreach (var child in item._children.ToList())
                RemoveFromList(list, child);
        }
    }

    private async Task ApproveAllShown()
    {
        var pending = _flatFiltered.Where(n => !n.Item.IsApproved).Select(n => n.Item).ToList();
        foreach (var item in pending)
        {
            try
            {
                var resp = item.SourceType switch
                {
                    SECTION_PRODUCTS => await Http.PutAsync($"api/products/{item.OwnerId}/reviews/{item.Id}/approve", null),
                    SECTION_ACADEMY => await Http.PutAsync($"api/trainingarticles/comments/{item.Id}/approve", null),
                    SECTION_NEWS => await Http.PutAsync($"api/news/{item.OwnerId}/comments/{item.Id}/approve", null),
                    _ => await Http.PutAsync($"api/trust/admin/testimonials/{item.Id}/approve", null)
                };
                if (resp.IsSuccessStatusCode) item.IsApproved = true;
            }
            catch { }
        }
        RecalcCounts();
        ToastService.ShowSuccess($"{pending.Count} نظر تایید شد");
    }

    private void RecalcCounts()
    {
        _productPending = _productReviews.Count(r => !r.IsApproved);
        _academyPending = _academyComments.Count(r => !r.IsApproved);
        _testimonialPending = _testimonials.Count(r => !r.IsApproved);
        _newsPending = _newsComments.Count(r => !r.IsApproved);
    }

