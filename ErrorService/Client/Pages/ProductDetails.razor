    private async Task SubmitQuestion()
    {
        if (product == null) return;
        var text = _qnaText.Trim();
        if (text.Length < 5)
        {
            ToastService.ShowError("متن پرسش باید حداقل ۵ کاراکتر باشد");
            return;
        }
        _qnaSending = true;
        try
        {
            var resp = await HttpApi.PostAsJsonAsync($"api/products/{product.Id}/questions",
                new ProductQuestionRequest { FullName = _qnaName.Trim(), Question = text });
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("پرسش شما ثبت شد و پس از تأیید نمایش داده می‌شود");
                _qnaText = "";
                await LoadQuestions();
            }
            else
            {
                ToastService.ShowError("خطا در ثبت پرسش");
            }
        }
        catch (Exception ex) { ToastService.ShowError($"خطای سیستمی: {ex.Message}"); }
        finally { _qnaSending = false; }
    }

