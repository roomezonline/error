    private void OpenAdjustModal(WorkshopSmsCreditDto credit)
    {
        _adjustWorkshopId = credit.WorkshopId;
        _adjustWorkshopName = credit.WorkshopName;
        _adjustCurrentBalance = credit.Balance;
        _adjustAmount = 0;
        _adjustAmountDisplay = "";
        _adjustReason = "";
        _showAdjustModal = true;
    }

    private void OnAdjustAmountInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var digits = new string(raw.Where(char.IsAsciiDigit).ToArray());
        if (string.IsNullOrEmpty(digits))
        {
            _adjustAmount = 0;
            _adjustAmountDisplay = "";
            return;
        }
        _adjustAmount = decimal.Parse(digits);
        _adjustAmountDisplay = string.Format("{0:N0}", _adjustAmount);
    }

    private void CloseAdjustModal() => _showAdjustModal = false;

    private async Task ConfirmAdjust()
    {
        if (_adjustAmount <= 0) return;
        try
        {
            var url = $"api/sms-admin/credits/adjust?workshopId={_adjustWorkshopId}&amount={_adjustAmount}&reason={Uri.EscapeDataString(_adjustReason)}";
            var response = await Http.PostAsync(url, null);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess($"اعتبار {_adjustWorkshopName} با موفقیت افزایش یافت");
                _showAdjustModal = false;
                await LoadAdminCredits();
                await LoadDashboard();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ToastService.ShowError(err);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا: {ex.Message}");
        }
    }

