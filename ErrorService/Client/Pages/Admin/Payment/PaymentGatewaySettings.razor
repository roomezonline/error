    .pgs-row-btn { display: grid; place-items: center; width: 36px; height: 36px; border: 1px solid #e2e8f0; border-radius: 10px; background: #fff; color: #64748b; cursor: pointer; font-size: 0.8rem; }
    .pgs-row-btn:hover { border-color: #c7d2fe; color: #4f46e5; }
    .pgs-row-btn--danger:hover { border-color: #fecaca; color: #dc2626; }

    .pgs-switch { display: inline-flex; align-items: center; gap: 12px; cursor: pointer; margin: 6px 0; }
    .pgs-switch input { display: none; }
    .pgs-switch-track { position: relative; width: 46px; height: 26px; border-radius: 999px; background: #cbd5e1; transition: background .2s; flex-shrink: 0; }
    .pgs-switch-track::after { content: ""; position: absolute; top: 3px; right: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: right .2s; box-shadow: 0 2px 6px rgba(0,0,0,.2); }
