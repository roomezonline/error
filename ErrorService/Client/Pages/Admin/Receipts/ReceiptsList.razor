        if (!ok || _deleteReceipt == null) return;
        try
        {
            var id = _deleteReceipt.Id;
            var resp = await Http.DeleteAsync($"api/customer-receipts/{id}");
            if (resp.StatusCode == System.Net.HttpStatusCode.MethodNotAllowed)
            {
                resp = await Http.PostAsync($"api/customer-receipts/delete/{id}", null);
