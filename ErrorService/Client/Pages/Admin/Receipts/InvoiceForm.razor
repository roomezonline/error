    private void ShowSmsModal(string type)
    {
        if (receipt == null) return;
        _smsType = type;
        var customerName = $"{receipt.CustomerFirstName} {receipt.CustomerLastName}";
        var date = PersianDateHelper.ToPersianDateTimeString(receipt.RegisteredAt, false);
        var state = type == "not_repairable" ? "غیر قابل تعمیر" : "آماده تحویل";
        smsPreviewText = $"\u200Fمشتری گرامی\n{customerName}\nدستگاه {receipt.DeviceTypeName} ({receipt.DeviceBrandName ?? ""}) در تاریخ {date} در {receipt.WorkshopName}\n{state} می باشد.\nلطفا برای تحویل مراجعه بفرمایید.\nمجموعه فنی و مهندسی ارور سرویس";
        smsSent = false;
        smsError = "";
        isSendingSms = false;
        showSmsModal = true;
        StateHasChanged();
    }

    private async Task SendSms()
    {
        if (receipt == null) return;
        try
        {
            isSendingSms = true;
            smsError = "";
            StateHasChanged();

            var qs = receipt.WorkshopId > 0 ? $"?workshopId={receipt.WorkshopId}" : "";
            var endpoint = _smsType == "not_repairable"
                ? $"api/customer-receipts/{ReceiptId}/send-unrepairable-sms{qs}"
                : $"api/customer-receipts/{ReceiptId}/send-ready-for-delivery-sms{qs}";
            var resp = await Http.PostAsync(endpoint, null);

            if (resp.IsSuccessStatusCode)
            {
                smsSent = true;
            }
            else
            {
            var err = await resp.Content.ReadAsStringAsync();
            smsError = (err.Length > 200 ? err[..200] : err).Trim('"');
            }
        }
        catch (Exception ex)
        {
            smsError = "خطا در ارسال پیامک";
        }
        finally
        {
            isSendingSms = false;
            StateHasChanged();
        }
    }

