    private void AddProvider() => _aiProviders.Add(new AiProviderUi { Kind = "openrouter" });

    private void RemoveProvider(AiProviderUi p) => _aiProviders.Remove(p);

    private void MoveProvider(AiProviderUi p, int dir)
    {
        var idx = _aiProviders.IndexOf(p);
        var target = idx + dir;
        if (idx < 0 || target < 0 || target >= _aiProviders.Count) return;
        _aiProviders.RemoveAt(idx);
        _aiProviders.Insert(target, p);
    }

    private async Task SaveProvidersAsync()
    {
        if (!_aiProvidersLoaded)
        {
            _aiProvidersOk = false;
            _aiProvidersMessage = "ابتدا بارگذاری کامل شود تا ذخیره ممکن باشد.";
            return;
        }

        _aiProvidersSaving = true;
        _aiProvidersMessage = null;
        StateHasChanged();
        try
        {
            var payload = BuildPayload();
            var resp = await Http.PutAsJsonAsync("api/chat/ai-providers", payload);
            var json = await resp.Content.ReadFromJsonAsync<JsonElement>();
            _aiProvidersOk = resp.IsSuccessStatusCode && (!json.TryGetProperty("success", out var s) || s.GetBoolean());
            _aiProvidersMessage = json.TryGetProperty("message", out var m) && m.ValueKind == JsonValueKind.String
                ? m.GetString()
                : (_aiProvidersOk == true ? "ذخیره شد." : "خطا در ذخیره.");
            if (_aiProvidersOk == true) await LoadProvidersAsync();
        }
        catch
        {
            _aiProvidersOk = false;
            _aiProvidersMessage = "خطا در ارتباط با سرور.";
        }
        _aiProvidersSaving = false;
        StateHasChanged();
    }

    private List<ChatAiProviderPayload> BuildPayload() =>
        _aiProviders.Select((p, i) => new ChatAiProviderPayload
        {
            Id = p.Id,
            Name = p.Name,
            BaseUrl = p.BaseUrl,
            Kind = p.Kind,
            Enabled = p.Enabled,
            Priority = i + 1,
            UseForChat = p.UseForChat,
            UseForContentStudio = p.UseForContentStudio,
            Proxies = p.Proxies
                .Where(x => !string.IsNullOrWhiteSpace(x.Url))
                .Select((x, xi) => new ChatAiProxyPayload
                {
                    Id = x.Id,
                    Url = x.Url.Trim(),
                    Label = x.Label,
                    Enabled = x.Enabled,
                    Priority = xi + 1
                }).ToList(),
            Keys = p.Keys.Select((k, ki) => new ChatAiKeyPayload
            {
                Id = k.Id,
                KeyValue = k.KeyValue,
                Label = k.Label,
                Enabled = k.Enabled,
                Priority = ki + 1
            }).ToList(),
            Models = p.Models.Select((m, mi) => new ChatAiModelPayload
            {
                Id = m.Id,
                ModelId = m.ModelId,
                Label = m.Label,
                Enabled = m.Enabled,
                Priority = mi + 1
            }).ToList()
        }).ToList();

    private async Task LoadCatalogAsync(AiProviderUi p)
    {
        p.CatalogLoading = true;
        p.CatalogMessage = null;
        StateHasChanged();
        try
        {
            var proxyUrl = p.Proxies.FirstOrDefault(x => x.Enabled && !string.IsNullOrWhiteSpace(x.Url))?.Url;
            var url = $"api/chat/ai-models/catalog?kind={Uri.EscapeDataString(p.Kind)}&baseUrl={Uri.EscapeDataString(p.BaseUrl)}"
                      + (string.IsNullOrWhiteSpace(proxyUrl) ? "" : $"&proxyUrl={Uri.EscapeDataString(proxyUrl)}");
            var json = await Http.GetFromJsonAsync<JsonElement>(url);
            var list = new List<CatalogItemUi>();
            if (json.TryGetProperty("models", out var models) && models.ValueKind == JsonValueKind.Array)
                foreach (var m in models.EnumerateArray())
                {
                    var id = m.TryGetProperty("id", out var mid) ? mid.GetString() : null;
                    if (string.IsNullOrWhiteSpace(id)) continue;
                    if (p.Models.Any(x => string.Equals(x.ModelId, id, StringComparison.OrdinalIgnoreCase))) continue;
                    list.Add(new CatalogItemUi { Id = id!, Name = m.TryGetProperty("name", out var nm) ? nm.GetString() : null });
                }
            p.Catalog = list;
            p.CatalogMessage = json.TryGetProperty("message", out var msg) && msg.ValueKind == JsonValueKind.String
                ? msg.GetString()
                : $"{list.Count} مدل دریافت شد.";
        }
        catch
        {
            p.CatalogMessage = "خطا در دریافت فهرست.";
        }
        p.CatalogLoading = false;
        StateHasChanged();
    }

    private void AddSelectedCatalog(AiProviderUi p)
    {
        if (p.Catalog == null) return;
        foreach (var c in p.Catalog.Where(x => x.Selected))
            p.Models.Add(new AiModelUi { ModelId = c.Id, Label = c.Name, Enabled = true });
        p.Catalog = null;
        p.CatalogMessage = null;
    }

    private async Task TestChainAsync()
    {
        _chainTesting = true;
        _chainResults = null;
        _aiProvidersMessage = null;
        StateHasChanged();
        try
        {
            var payload = BuildPayload();
            var resp = await Http.PostAsJsonAsync("api/chat/ai-chain-test", payload.Count > 0 ? payload : null);
            var json = await resp.Content.ReadFromJsonAsync<JsonElement>();
            var results = new List<ChainResultUi>();
            if (json.TryGetProperty("results", out var arr) && arr.ValueKind == JsonValueKind.Array)
                foreach (var r in arr.EnumerateArray())
                    results.Add(new ChainResultUi
                    {
                        Provider = ReadString(r, "provider"),
                        Key = ReadString(r, "key"),
                        Model = ReadString(r, "model"),
                        Proxy = ReadString(r, "proxy"),
                        Ok = ReadBool(r, "ok"),
                        Message = ReadString(r, "message"),
                        Ms = ReadLong(r, "ms")
                    });
            _chainResults = results;
            _aiProvidersOk = resp.IsSuccessStatusCode && results.Any(r => r.Ok);
            _aiProvidersMessage = json.TryGetProperty("message", out var msg) && msg.ValueKind == JsonValueKind.String
                ? msg.GetString()
                : (results.Count == 0 ? "کاندیدایی برای تست وجود ندارد." : (results.Any(r => r.Ok) ? "حداقل یک کاندید سالم است." : "هیچ کاندیدی پاسخ نداد."));
        }
        catch
        {
            _aiProvidersOk = false;
            _aiProvidersMessage = "خطا در ارتباط با سرور.";
        }
        _chainTesting = false;
        StateHasChanged();
    }

