@inject HttpClient Http
@inject IJSRuntime JS

@code {
    [Parameter] public string EntityType { get; set; } = string.Empty;
    [Parameter] public int EntityId { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrEmpty(EntityType) || EntityId <= 0) return;

        try
        {
            var flagKey = $"_pv_{EntityType}_{EntityId}";
            var alreadyCounted = await JS.InvokeAsync<string?>("sessionStorage.getItem", flagKey);
            if (alreadyCounted == "1") return;

            var payload = new PageViewTrackRequest { EntityType = EntityType, EntityId = EntityId };
            var resp = await Http.PostAsJsonAsync("api/pageviews/track", payload);

            if (resp.IsSuccessStatusCode)
            {
                await JS.InvokeVoidAsync("sessionStorage.setItem", flagKey, "1");
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[ViewTracker] Error: {ex.Message}");
        }
    }

    public class PageViewTrackRequest
    {
        public string EntityType { get; set; } = string.Empty;
        public int EntityId { get; set; }
    }
}
