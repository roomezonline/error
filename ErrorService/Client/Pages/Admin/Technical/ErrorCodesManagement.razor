    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try
        {
            HttpResponseMessage response;
            if (editingItem.Id == 0)
                response = await Http.PostAsJsonAsync("api/technical/error-codes", editingItem);
            else
                response = await Http.PutAsJsonAsync($"api/technical/error-codes/{editingItem.Id}", editingItem);

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("با موفقیت ذخیره شد");
                CloseModal();
                await LoadData();
