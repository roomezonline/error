@page "/admin/bank-accounts"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.bankaccounts.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Services
@inject HttpClient Http
@inject ToastService ToastService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject AdminWorkshopSelectionService AdminWorkshopSelection

<div class="admin-container" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="admin-page-title m-0">مدیریت حساب‌های بانکی</h3>
        <button class="btn btn-primary shadow-sm rounded-pill px-4" @onclick="NewAccount">
            <span class="oi oi-plus me-1"></span> افزودن حساب
        </button>
    </div>

    @if (showEditor)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden animate__animated animate__fadeIn">
            <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h5 class="fw-black m-0 text-primary">@(editingId == 0 ? "ثبت حساب جدید" : "ویرایش حساب")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>
            <div class="card-body p-4">
                <EditForm Model="model" OnValidSubmit="SaveAccount">
                    <DataAnnotationsValidator />
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">عنوان حساب (مثلاً: حساب اصلی فروشگاه)</label>
                            <InputText @bind-Value="model.Title" class="form-control rounded-3" />
                            <ValidationMessage For="@(() => model.Title)" class="text-danger small" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">نام بانک</label>
                            <InputText @bind-Value="model.BankName" class="form-control rounded-3" placeholder="مثلاً: بانک ملت" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">نام صاحب حساب</label>
                            <InputText @bind-Value="model.OwnerName" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">شماره کارت</label>
                            <InputText @bind-Value="model.CardNumber" class="form-control rounded-3 text-center ltr" placeholder="0000-0000-0000-0000" inputmode="numeric" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">شماره حساب</label>
                            <InputText @bind-Value="model.AccountNumber" class="form-control rounded-3 text-center ltr" inputmode="numeric" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">شماره شبا</label>
                            <InputText @bind-Value="model.Iban" class="form-control rounded-3 text-center ltr" placeholder="IR00..." inputmode="numeric" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">ترتیب نمایش</label>
                            <InputNumber @bind-Value="model.SortOrder" class="form-control rounded-3" />
                        </div>
                        <div class="col-md-8 d-flex align-items-end gap-3 pb-2">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="model.ShowInGateway" id="showInGateway">
                                <label class="form-check-label small fw-bold" for="showInGateway">نمایش در درگاه</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" @bind="model.IsActive" id="isActive">
                                <label class="form-check-label small fw-bold" for="isActive">فعال</label>
                            </div>
                        </div>
                    </div>
                    <div class="text-end mt-4">
                        <button type="button" class="btn btn-light rounded-pill px-4 me-2" @onclick="CloseEditor">انصراف</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" disabled="@isSaving">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            ذخیره اطلاعات
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
            <div class="spinner-border text-primary"></div>
            <p class="text-muted mt-2">در حال بارگذاری اطلاعات...</p>
        </div>
    }
    else if (accounts == null || !accounts.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
            <div class="display-1 text-light mb-3"><span class="oi oi-credit-card"></span></div>
            <h5 class="text-muted fw-bold">هنوز حسابی تعریف نکرده‌اید.</h5>
            <button class="btn btn-primary mt-3 rounded-pill px-4" @onclick="NewAccount">افزودن اولین حساب</button>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var acc in accounts)
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="bank-card rounded-4 shadow-sm bg-white overflow-hidden @(acc.IsActive ? "" : "opacity-50")">
                        <div class="card-gradient p-3 text-white d-flex justify-content-between align-items-start">
                            <div>
                                <div class="small opacity-75">@acc.BankName</div>
                                <div class="fw-black h5 m-0">@acc.Title</div>
                            </div>
                            <div class="card-status-badges d-flex gap-1">
                                @if (acc.ShowInGateway)
                                {
                                    <span class="badge bg-white text-primary rounded-pill smaller">درگاه</span>
                                }
                                @if (!acc.IsActive)
                                {
                                    <span class="badge bg-danger text-white rounded-pill smaller">غیرفعال</span>
                                }
                            </div>
                        </div>
                        <div class="p-3">
                            @if (!string.IsNullOrEmpty(acc.CardNumber))
                            {
                                <div class="mb-2">
                                    <div class="text-muted smaller mb-1">شماره کارت:</div>
                                    <div class="fw-bold fs-5 text-center ltr">@acc.CardNumber</div>
                                </div>
                            }
                            <div class="mb-2">
                                <div class="text-muted smaller mb-1">صاحب حساب:</div>
                                <div class="fw-bold">@acc.OwnerName</div>
                            </div>
                            <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                                <button class="btn btn-light btn-sm rounded-pill px-3" @onclick="() => EditAccount(acc)">
                                    <span class="oi oi-pencil me-1"></span> ویرایش
                                </button>
                                <button class="btn btn-outline-danger btn-sm rounded-circle p-0 d-grid place-items-center" 
                                        style="width: 32px; height: 32px;" @onclick="() => ConfirmDelete(acc)">
                                    <span class="oi oi-trash"></span>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="حذف حساب"
               Message="@($"آیا از حذف حساب \"{itemToDelete?.Title}\" اطمینان دارید؟")"
               ConfirmText="بله، حذف شود"
               IsDanger="true"
               OnResult="HandleDeleteResult" />

<style>
    .fw-black { font-weight: 900; }
    .smaller { font-size: 0.7rem; }
    .ltr { direction: ltr; }
    
    .bank-card {
        border: 1px solid rgba(0,0,0,0.05);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .bank-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.08) !important;
    }
    
    .card-gradient {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
    }
    
    .bank-card:nth-child(2n) .card-gradient {
        background: linear-gradient(135deg, #059669, #047857);
    }
    
    .bank-card:nth-child(3n) .card-gradient {
        background: linear-gradient(135deg, #db2777, #be185d);
    }

    .form-control:focus, .form-select:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.1);
    }
</style>

@code {
    private List<BankAccountDto>? accounts;
    private BankAccountUpsertRequest model = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private bool showEditor = false;
    private int editingId = 0;
    private bool showDeleteConfirm = false;
    private BankAccountDto? itemToDelete;

    private bool isSuperAdmin;
    private int? selectedWorkshopId;

    protected override async Task OnInitializedAsync()
    {
        await AdminWorkshopSelection.InitializeAsync();

        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        isSuperAdmin = state.User.IsInRole("super_admin");

        if (isSuperAdmin)
        {
            selectedWorkshopId = AdminWorkshopSelection.SelectedWorkshopId;
            AdminWorkshopSelection.OnChanged += HandleWorkshopChanged;
        }

        await LoadAccounts();
    }

    private void HandleWorkshopChanged(int? workshopId)
    {
        selectedWorkshopId = workshopId;
        _ = InvokeAsync(async () =>
        {
            await LoadAccounts();
            StateHasChanged();
        });
    }

    private async Task LoadAccounts()
    {
        try
        {
            isLoading = true;
            var url = "api/bankaccounts";
            if (isSuperAdmin && selectedWorkshopId is > 0)
                url += $"?workshopId={selectedWorkshopId}";
            accounts = await Http.GetFromJsonAsync<List<BankAccountDto>>(url);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در بارگذاری لیست: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NewAccount()
    {
        model = new BankAccountUpsertRequest
        {
            WorkshopId = isSuperAdmin && selectedWorkshopId is > 0 ? selectedWorkshopId.Value : 1
        };
        editingId = 0;
        showEditor = true;
    }

    private void EditAccount(BankAccountDto acc)
    {
        model = new BankAccountUpsertRequest
        {
            WorkshopId = acc.WorkshopId,
            Title = acc.Title,
            BankName = acc.BankName,
            OwnerName = acc.OwnerName,
            CardNumber = acc.CardNumber,
            AccountNumber = acc.AccountNumber,
            Iban = acc.Iban,
            IconUrl = acc.IconUrl,
            ShowInGateway = acc.ShowInGateway,
            IsActive = acc.IsActive,
            SortOrder = acc.SortOrder
        };
        editingId = acc.Id;
        showEditor = true;
    }

    private void CloseEditor()
    {
        showEditor = false;
        editingId = 0;
    }

    private async Task SaveAccount()
    {
        isSaving = true;
        try
        {
            HttpResponseMessage response;
            if (editingId == 0)
                response = await Http.PostAsJsonAsync("api/bankaccounts", model);
            else
                response = await Http.PutAsJsonAsync($"api/bankaccounts/{editingId}", model);

            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("اطلاعات با موفقیت ذخیره شد");
                showEditor = false;
                await LoadAccounts();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                ToastService.ShowError("خطا در ذخیره اطلاعات: " + (string.IsNullOrWhiteSpace(body) ? "" : body.Trim('"')));
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDelete(BankAccountDto acc)
    {
        itemToDelete = acc;
        showDeleteConfirm = true;
    }

    private async Task HandleDeleteResult(bool confirmed)
    {
        showDeleteConfirm = false;
        if (!confirmed || itemToDelete == null) return;
        try
        {
            var response = await Http.DeleteAsync($"api/bankaccounts/{itemToDelete.Id}");
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("حساب حذف شد");
                await LoadAccounts();
            }
            else
            {
                ToastService.ShowError("خطا در حذف حساب");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
    }
}
