    private async Task LoadHistoryAsync(string src, double fallback)
    {
        try
        {
            _historyLoading = true;
            var url = IsReadOnly
                ? $"{ApiPrefix}/records-history?token={ShareToken}&field={src}&count=50"
                : $"api/monitoring/records-history?monitoringId={Id}&code={Code}&field={src}&count=50";
            var records = await Http.GetFromJsonAsync<List<MonitoringRecordPoint>>(url);
            flowData.Clear();
            if (records != null && records.Count > 0)
            {
                foreach (var r in records)
                    flowData.Add(r.Value ?? fallback);
                _historyCount = flowData.Count;
            }
            else
            {
                _historyCount = 0;
            }
            if (flowData.Count == 0)
            {
                for (var i = 0; i < FlowCount; i++) flowData.Add(fallback);
            }
            UpdateFlowPath();
        }
        catch
        {
            _historyCount = 0;
            flowData.Clear();
            for (var i = 0; i < FlowCount; i++) flowData.Add(fallback);
            UpdateFlowPath();
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private static double? ParseDouble(string? val)
    {
        if (string.IsNullOrWhiteSpace(val)) return null;
        if (val.Equals("nan", StringComparison.OrdinalIgnoreCase)) return null;
        if (double.TryParse(val, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var result))
            return result;
        return null;
    }

