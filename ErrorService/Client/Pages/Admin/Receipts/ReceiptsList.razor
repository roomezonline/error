    private async Task OpenPrintPreview()
    {
        try
        {
            var url = printBulkMode
                ? "api/print/invoice/bulk"
                : "api/print/invoice/single";

            var request = printBulkMode
                ? new BulkPrintInvoiceRequest
                    {
                        CustomerMobile = printReceipt!.CustomerMobile,
                        DateFrom = printDateFrom,
                        DateTo = printDateTo,
                        HeaderTitle = printHeaderTitle,
                        WorkshopName = printWorkshopName,
                        ShowPrintDate = printShowPrintDate,
                        ShowInvoiceNumber = printShowInvoiceNumber,
                        Address = printAddress,
                        Phone = printPhone,
                        Website = printWebsite,
                        LogoUrl = printLogoUrl
                    } as object
                : new PrintInvoiceRequest
                    {
                        ReceiptId = printReceipt!.Id,
                        HeaderTitle = printHeaderTitle,
                        WorkshopName = printWorkshopName,
                        ShowPrintDate = printShowPrintDate,
                        ShowInvoiceNumber = printShowInvoiceNumber,
                        Address = printAddress,
                        Phone = printPhone,
                        Website = printWebsite,
                        LogoUrl = printLogoUrl
                    };

            var response = await Http.PostAsJsonAsync(url, request);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<PrintPreviewResponse>();

                if (result != null && !string.IsNullOrEmpty(result.Html))
                {
                    // بررسی وجود تابع در جاوااسکریپت
                    var jsExists = await JS.InvokeAsync<bool>("eval", "typeof window.openPrintPreview === 'function'");

                    if (!jsExists)
                    {
                        ToastService.ShowError("تابع پیش‌نمایش یافت نشد، لطفا صفحه را Refresh کنید");
                        return;
                    }

                    await JS.InvokeVoidAsync("openPrintPreview", result.Html, result.Title);
                }
                else
                {
                    ToastService.ShowError("خطا در دریافت محتوای فاکتور");
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"خطا: {error}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"OpenPrintPreview error: {ex.Message}");
            ToastService.ShowError($"خطا در ارتباط با سرور: {ex.Message}");
        }
    }






