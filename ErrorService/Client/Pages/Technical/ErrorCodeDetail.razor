@page "/technical/error-codes/{Brand}/{DeviceType}/{Code}"
@using ErrorService.Shared
@using ErrorService.Shared.Models
@using System.Text.Json
@using System.Text.RegularExpressions
@inject HttpClient Http
@inject NavigationManager Navigation

<SeoHeader
    Title="@pageTitle"
    Description="@pageDescription"
    Keywords="@pageKeywords"
    OgType="article"
    OgImage="@errorCode?.ImageUrl"
    CanonicalUrl="@canonicalUrl"
    JsonLd="@jsonLd" />

<div class="ecd-page" dir="rtl">
    <!-- Breadcrumb -->
    <nav class="ecd-breadcrumb">
        <a href="/" class="ecd-bc-link">خانه</a>
        <span class="ecd-bc-sep">/</span>
        <a href="/technical/error-codes" class="ecd-bc-link">بانک کدهای خطا</a>
        <span class="ecd-bc-sep">/</span>
        <a href="/technical/error-codes?brand=@Brand" class="ecd-bc-link">@Brand</a>
        <span class="ecd-bc-sep">/</span>
        <span class="ecd-bc-current">@Code</span>
    </nav>

    @if (isLoading)
    {
        <div class="ecd-skeleton-wrap">
            <div class="ecd-skeleton ecd-skeleton--h1"></div>
            <div class="ecd-skeleton ecd-skeleton--h2"></div>
            <div class="ecd-skeleton ecd-skeleton--block"></div>
            <div class="ecd-skeleton ecd-skeleton--block"></div>
        </div>
    }
    else if (errorCode == null)
    {
        <div class="ecd-notfound">
            <span class="oi oi-warning"></span>
            <h2>کد خطا یافت نشد</h2>
            <p>کد خطا مورد نظر در پایگاه داده وجود ندارد.</p>
            <a href="/technical/error-codes" class="ecd-btn">بازگشت به بانک کدهای خطا</a>
        </div>
    }
    else
    {
        <!-- Hero -->
        <div class="ecd-hero">
            <div class="ecd-hero__badges">
                <span class="ecd-badge ecd-badge--brand">@errorCode.Brand</span>
                <span class="ecd-badge ecd-badge--device">@errorCode.DeviceType</span>
            </div>
            <div class="ecd-hero__code">@errorCode.Code</div>
            <h1 class="ecd-hero__title">@errorCode.Description</h1>
        </div>

        <!-- Image -->
        @if (!string.IsNullOrEmpty(errorCode.ImageUrl))
        {
            <div class="ecd-image-section">
                <img src="@errorCode.ImageUrl" alt="کد خطا @errorCode.Code - @errorCode.Brand @errorCode.DeviceType" class="ecd-image" loading="lazy" />
            </div>
        }

        <!-- Video -->
        @if (!string.IsNullOrEmpty(videoEmbedUrl) || !string.IsNullOrEmpty(videoExternalUrl))
        {
            <div class="ecd-section ecd-section--video">
                <div class="ecd-section__header">
                    <span class="oi oi-video ecd-section__icon"></span>
                    <h2 class="ecd-section__title">ویدیوی آموزشی</h2>
                </div>
                @if (!string.IsNullOrEmpty(videoEmbedUrl))
                {
                    <div class="ecd-video-frame">
                        <iframe src="@videoEmbedUrl"
                                title="ویدیوی آموزشی کد خطای @errorCode.Code"
                                loading="lazy"
                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                referrerpolicy="strict-origin-when-cross-origin"
                                allowfullscreen></iframe>
                    </div>
                }
                else
                {
                    <a href="@videoExternalUrl" target="_blank" rel="noopener noreferrer" class="ecd-btn ecd-btn--secondary">
                        <span class="oi oi-external-link"></span>
                        مشاهده ویدیو
                    </a>
                }
            </div>
        }

        <!-- Solution -->
        <div class="ecd-section ecd-section--solution">
            <div class="ecd-section__header">
                <span class="oi oi-check-circle ecd-section__icon"></span>
                <h2 class="ecd-section__title">راه حل پیشنهادی</h2>
            </div>
            <div class="ecd-section__content ecd-solution-text">
                @errorCode.Solution
            </div>
        </div>

        <!-- Technical Notes -->
        @if (!string.IsNullOrEmpty(errorCode.TechnicalNotes))
        {
            <div class="ecd-section ecd-section--notes">
                <div class="ecd-section__header">
                    <span class="oi oi-info ecd-section__icon"></span>
                    <h2 class="ecd-section__title">نکات فنی</h2>
                </div>
                <div class="ecd-section__content">
                    @StripUrls(errorCode.TechnicalNotes)
                </div>
                @if (ExtractUrls(errorCode.TechnicalNotes).Any())
                {
                    <div class="ecd-notes-source">
                        @foreach (var url in ExtractUrls(errorCode.TechnicalNotes))
                        {
                            <a href="@url" target="_blank" rel="noopener noreferrer" class="ecd-source-link">
                                <span class="oi oi-external-link"></span>
                                مشاهده منبع مرجع
                            </a>
                        }
                    </div>
                }
            </div>
        }

        <!-- FAQ -->
        @if (publishedFaqs.Any())
        {
            <div class="ecd-section ecd-section--faq">
                <div class="ecd-section__header">
                    <span class="oi oi-question-mark ecd-section__icon"></span>
                    <h2 class="ecd-section__title">پرسش‌های متداول</h2>
                </div>
                <div class="ecd-faq-list">
                    @foreach (var faq in publishedFaqs)
                    {
                        <details class="ecd-faq">
                            <summary class="ecd-faq__question">
                                <span>@faq.Question</span>
                                <span class="oi oi-chevron-bottom ecd-faq__chevron"></span>
                            </summary>
                            <div class="ecd-faq__answer">@faq.Answer</div>
                        </details>
                    }
                </div>
            </div>
        }

        <!-- Documents -->
        @if (errorCode.Documents != null && errorCode.Documents.Any())
        {
            <div class="ecd-section ecd-section--docs">
                <div class="ecd-section__header">
                    <span class="oi oi-document ecd-section__icon"></span>
                    <h2 class="ecd-section__title">منابع و مستندات</h2>
                </div>
                <div class="ecd-docs-list">
                    @foreach (var doc in errorCode.Documents.OrderBy(d => d.DocType == ErrorCodeDocumentType.Source ? 0 : 1).ThenBy(d => d.SortOrder))
                    {
                        <a href="@doc.Url" target="_blank" rel="noopener noreferrer" class="ecd-doc-item">
                            <span class="oi oi-document"></span>
                            <span>@doc.Title</span>
                            <span class="oi oi-external-link ecd-doc-arrow"></span>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Model Names -->
        @if (!string.IsNullOrEmpty(errorCode.ModelNames))
        {
            <div class="ecd-section ecd-section--models">
                <div class="ecd-section__header">
                    <span class="oi oi-list ecd-section__icon"></span>
                    <h2 class="ecd-section__title">مدل‌های سازگار</h2>
                </div>
                <div class="ecd-model-tags">
                    @foreach (var model in errorCode.ModelNames.Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="ecd-model-tag">@model.Trim()</span>
                    }
                </div>
            </div>
        }

        <!-- Related Error Codes -->
        @if (relatedCodes.Any())
        {
            <div class="ecd-section ecd-section--related">
                <div class="ecd-section__header">
                    <span class="oi oi-layers ecd-section__icon"></span>
                    <h2 class="ecd-section__title">کدهای خطای مرتبط</h2>
                </div>
                <div class="ecd-related-grid">
                    @foreach (var rel in relatedCodes)
                    {
                        <a href="/technical/error-codes/@Uri.EscapeDataString(rel.Brand.Trim().ToLowerInvariant())/@Uri.EscapeDataString(rel.DeviceType.Trim().ToLowerInvariant())/@Uri.EscapeDataString(rel.Code.Trim().ToLowerInvariant())" class="ecd-related-card">
                            <div class="ecd-related-code">@rel.Code</div>
                            <div class="ecd-related-desc">@Truncate(rel.Description, 60)</div>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Related Products -->
        @if (relatedProducts.Any())
        {
            <div class="ecd-section ecd-section--products">
                <div class="ecd-section__header">
                    <span class="oi oi-cart ecd-section__icon"></span>
                    <h2 class="ecd-section__title">قطعات مرتبط</h2>
                </div>
                <div class="ecd-products">
                    @foreach (var product in relatedProducts)
                    {
                        var price = DiscountHelper.GetEffectivePrice(product);
                        var hasDiscount = DiscountHelper.IsActive(product);
                        <a class="ecd-product" href="/products/@(string.IsNullOrWhiteSpace(product.Slug) ? product.Id.ToString() : product.Slug)">
                            <div class="ecd-product__image">
                                @if (!string.IsNullOrWhiteSpace(product.MainImageUrl))
                                {
                                    <img src="@product.MainImageUrl" alt="@product.Name" loading="lazy" />
                                }
                                else
                                {
                                    <span class="oi oi-image"></span>
                                }
                            </div>
                            <div class="ecd-product__body">
                                <div class="ecd-product__name">@product.Name</div>
                                <div class="ecd-product__price">
                                    @if (hasDiscount)
                                    {
                                        <span class="ecd-product__price-current">@price.ToString("N0") تومان</span>
                                        <del class="ecd-product__price-old">@product.Price.ToString("N0")</del>
                                    }
                                    else
                                    {
                                        <span class="ecd-product__price-current">@price.ToString("N0") تومان</span>
                                    }
                                </div>
                                @if (!product.IsAvailable || product.StockQuantity <= 0)
                                {
                                    <div class="ecd-product__stock">ناموجود</div>
                                }
                            </div>
                        </a>
                    }
                </div>
                <a class="ecd-products__all" href="/products">مشاهده همه قطعات</a>
            </div>
        }

        <!-- CTA -->
        <div class="ecd-cta">
            <a href="/technical/error-codes" class="ecd-btn ecd-btn--primary">
                <span class="oi oi-magnifying-glass"></span>
                جستجوی کد خطا
            </a>
            <a href="/admission/repair" class="ecd-btn ecd-btn--secondary">
                <span class="oi oi-wrench"></span>
                درخواست تعمیر
            </a>
            <a href="/workshops" class="ecd-btn ecd-btn--secondary">
                <span class="oi oi-map-marker"></span>
                کارگاه‌های نزدیک
            </a>
        </div>
    }
</div>

<style>
    .ecd-page { max-width: 800px; margin: 0 auto; padding: 20px 16px 40px; }

    .ecd-breadcrumb {
        display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
        padding: 12px 0; margin-bottom: 16px;
        font-size: 0.8rem; color: #94a3b8;
    }
    .ecd-bc-link { color: #6366f1; text-decoration: none; font-weight: 600; }
    .ecd-bc-link:hover { text-decoration: underline; }
    .ecd-bc-sep { color: #cbd5e1; }
    .ecd-bc-current { color: #475569; font-weight: 700; }

    .ecd-hero {
        background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
        border-radius: 20px; padding: 28px 24px; color: #fff; margin-bottom: 20px;
    }
    .ecd-hero__badges { display: flex; gap: 8px; margin-bottom: 12px; }
    .ecd-badge {
        padding: 4px 12px; border-radius: 8px; font-size: 0.75rem; font-weight: 700;
    }
    .ecd-badge--brand { background: rgba(99,102,241,0.25); color: #a5b4fc; }
    .ecd-badge--device { background: rgba(16,185,129,0.25); color: #6ee7b7; }
    .ecd-hero__code {
        font-family: monospace; font-size: 2.2rem; font-weight: 900;
        letter-spacing: 2px; margin-bottom: 8px;
    }
    .ecd-hero__title { font-size: 1.1rem; font-weight: 600; line-height: 1.6; opacity: 0.9; margin: 0; }

    .ecd-image-section {
        margin-bottom: 20px; border-radius: 16px; overflow: hidden;
        background: #f1f5f9; display: flex; justify-content: center;
    }
    .ecd-image { max-width: 100%; max-height: 400px; object-fit: contain; }

    .ecd-section {
        background: #fff; border-radius: 16px; padding: 20px;
        margin-bottom: 16px; border: 1px solid rgba(0,0,0,0.04);
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }
    .ecd-section__header {
        display: flex; align-items: center; gap: 8px; margin-bottom: 14px;
    }
    .ecd-section__icon { font-size: 1.1rem; color: #6366f1; }
    .ecd-section__title { font-size: 1rem; font-weight: 800; color: #1e293b; margin: 0; }

    .ecd-solution-text {
        line-height: 1.8; color: #1e293b; font-size: 0.95rem;
        padding: 16px; border-radius: 12px; background: #f0fdf4;
        border-right: 4px solid #22c55e;
    }

    .ecd-section--notes .ecd-section__content {
        line-height: 1.7; color: #475569; font-size: 0.9rem;
        padding: 14px; border-radius: 12px; background: #fefce8;
        border-right: 4px solid #eab308;
    }

    .ecd-notes-source { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .ecd-source-link {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 12px; border-radius: 10px; background: #fff;
        border: 1px solid #fde68a; color: #92400e;
        font-size: 0.8rem; font-weight: 700; text-decoration: none;
        transition: all 0.2s;
    }
    .ecd-source-link:hover { background: #fffbeb; border-color: #f59e0b; color: #78350f; }

    .ecd-model-tags { display: flex; flex-wrap: wrap; gap: 8px; }
    .ecd-model-tag {
        padding: 6px 14px; border-radius: 10px; font-size: 0.8rem;
        background: #f1f5f9; color: #475569; font-weight: 600;
        border: 1px solid #e2e8f0;
    }

    .ecd-docs-list { display: flex; flex-direction: column; gap: 8px; }
    .ecd-doc-item {
        display: flex; align-items: center; gap: 10px;
        padding: 12px 16px; border-radius: 12px; background: #f8fafc;
        border: 1px solid #e2e8f0; text-decoration: none; color: #1e293b;
        font-size: 0.85rem; font-weight: 600; transition: all 0.2s;
    }
    .ecd-doc-item:hover { background: #eff6ff; border-color: #93c5fd; }
    .ecd-doc-arrow { margin-right: auto; color: #94a3b8; font-size: 0.75rem; }

    .ecd-related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 10px; }
    .ecd-related-card {
        padding: 14px; border-radius: 12px; background: #f8fafc;
        border: 1px solid #e2e8f0; text-decoration: none; transition: all 0.2s;
    }
    .ecd-related-card:hover { border-color: #6366f1; box-shadow: 0 4px 12px rgba(99,102,241,0.12); }
    .ecd-related-code {
        font-family: monospace; font-size: 1.1rem; font-weight: 900;
        color: #6366f1; margin-bottom: 4px;
    }
    .ecd-related-desc { font-size: 0.75rem; color: #64748b; line-height: 1.4; }

    .ecd-cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
    .ecd-cta .ecd-btn { min-width: 150px; }
    .ecd-btn {
        flex: 1; display: flex; align-items: center; justify-content: center;
        gap: 8px; padding: 14px; border-radius: 14px; font-size: 0.9rem;
        font-weight: 700; text-decoration: none; transition: all 0.2s;
        border: none; cursor: pointer;
    }
    .ecd-btn--primary { background: linear-gradient(135deg, #6366f1, #818cf8); color: #fff; }
    .ecd-btn--primary:hover { box-shadow: 0 6px 20px rgba(99,102,241,0.3); }
    .ecd-btn--secondary { background: #f1f5f9; color: #475569; border: 1px solid #e2e8f0; }
    .ecd-btn--secondary:hover { background: #e2e8f0; }

    .ecd-notfound { text-align: center; padding: 60px 20px; }
    .ecd-notfound span { font-size: 3rem; color: #cbd5e1; display: block; margin-bottom: 12px; }
    .ecd-notfound h2 { font-weight: 800; color: #475569; }
    .ecd-notfound p { color: #94a3b8; margin-bottom: 20px; }
    .ecd-notfound .ecd-btn { display: inline-flex; flex: none; }

    .ecd-skeleton { border-radius: 12px; margin-bottom: 12px;
        background: linear-gradient(90deg, #f1f5f9 25%, #e2e8f0 50%, #f1f5f9 75%);
        background-size: 200% 100%; animation: ecd-shimmer 1.5s infinite;
    }
    .ecd-skeleton--h1 { height: 40px; width: 60%; }
    .ecd-skeleton--h2 { height: 24px; width: 80%; }
    .ecd-skeleton--block { height: 120px; }
    .ecd-skeleton-wrap { padding: 20px; }
    @@keyframes ecd-shimmer { 0% { background-position: -200% 0; } 100% { background-position: 200% 0; } }

    .ecd-video-frame {
        position: relative; width: 100%; aspect-ratio: 16 / 9;
        border-radius: 12px; overflow: hidden; background: #000;
    }
    .ecd-video-frame iframe { width: 100%; height: 100%; border: 0; display: block; }

    .ecd-faq-list { display: flex; flex-direction: column; gap: 8px; }
    .ecd-faq {
        border: 1px solid #e2e8f0; border-radius: 12px;
        background: #f8fafc; overflow: hidden;
    }
    .ecd-faq[open] { background: #fff; border-color: #c7d2fe; }
    .ecd-faq__question {
        display: flex; align-items: center; justify-content: space-between; gap: 10px;
        padding: 13px 16px; cursor: pointer; list-style: none;
        font-size: 0.88rem; font-weight: 700; color: #1e293b;
    }
    .ecd-faq__question::-webkit-details-marker { display: none; }
    .ecd-faq__chevron { color: #94a3b8; font-size: 0.7rem; transition: transform 0.2s; }
    .ecd-faq[open] .ecd-faq__chevron { transform: rotate(180deg); color: #6366f1; }
    .ecd-faq__answer {
        padding: 0 16px 14px; color: #475569; font-size: 0.85rem;
        line-height: 1.9; white-space: pre-line;
    }

    .ecd-products {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 10px;
    }
    .ecd-product {
        display: flex; flex-direction: column; overflow: hidden;
        border: 1px solid #e2e8f0; border-radius: 12px; background: #fff;
        text-decoration: none; color: inherit; transition: all 0.2s;
    }
    .ecd-product:hover { border-color: #6366f1; box-shadow: 0 4px 12px rgba(99,102,241,0.12); }
    .ecd-product__image {
        height: 110px; background: #f8fafc; color: #cbd5e1;
        display: flex; align-items: center; justify-content: center; font-size: 1.5rem;
    }
    .ecd-product__image img { width: 100%; height: 100%; object-fit: contain; }
    .ecd-product__body { display: flex; flex-direction: column; gap: 4px; padding: 10px; }
    .ecd-product__name {
        font-size: 0.78rem; font-weight: 700; color: #1e293b; line-height: 1.5;
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .ecd-product__price { display: flex; align-items: baseline; gap: 6px; flex-wrap: wrap; }
    .ecd-product__price-current { font-size: 0.8rem; font-weight: 800; color: #0f766e; }
    .ecd-product__price-old { font-size: 0.7rem; color: #94a3b8; }
    .ecd-product__stock { font-size: 0.68rem; font-weight: 700; color: #dc2626; }
    .ecd-products__all {
        display: block; margin-top: 12px; text-align: center;
        font-size: 0.8rem; font-weight: 700; color: #6366f1; text-decoration: none;
    }
    .ecd-products__all:hover { text-decoration: underline; }

    @@media (min-width: 768px) {
        .ecd-page { padding: 32px 24px 60px; }
        .ecd-hero { padding: 36px 32px; }
        .ecd-hero__code { font-size: 2.8rem; }
    }
</style>

@code {
    private static readonly Regex NoteUrlRegex = new(@"https?://[^\s<>""']+", RegexOptions.IgnoreCase);

    [Parameter] public string Brand { get; set; } = "";
    [Parameter] public string DeviceType { get; set; } = "";
    [Parameter] public string Code { get; set; } = "";

    private ErrorCode? errorCode;
    private List<ErrorCode> relatedCodes = new();
    private List<ProductDto> relatedProducts = new();
    private bool isLoading = true;
    private string? videoEmbedUrl;
    private string? videoExternalUrl;

    private List<ErrorCodeFaq> publishedFaqs => errorCode?.Faqs?
        .Where(f => !string.IsNullOrWhiteSpace(f.Question) && !string.IsNullOrWhiteSpace(f.Answer))
        .OrderBy(f => f.SortOrder)
        .ToList() ?? new();

    private string pageTitle = "کد خطا | ارورسرویس";
    private string pageDescription = "";
    private string pageKeywords = "";
    private string? jsonLd;
    private string? canonicalUrl;

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var brandDecoded = Uri.UnescapeDataString(Brand);
            var deviceDecoded = Uri.UnescapeDataString(DeviceType);
            var codeDecoded = Uri.UnescapeDataString(Code);

            errorCode = await Http.GetFromJsonAsync<ErrorCode>(
                $"api/technical/error-codes/detail?brand={Uri.EscapeDataString(brandDecoded)}&deviceType={Uri.EscapeDataString(deviceDecoded)}&code={Uri.EscapeDataString(codeDecoded)}"
            );

            if (errorCode == null)
            {
                isLoading = false;
                return;
            }

            pageTitle = $"کد خطای {errorCode.Code} {errorCode.Brand} {errorCode.DeviceType} - {errorCode.Description} | ارورسرویس";
            pageDescription = $"کد خطای {errorCode.Code} مربوط به {errorCode.DeviceType} برند {errorCode.Brand}: {errorCode.Description}. راه حل: {Truncate(errorCode.Solution, 150)}";
            pageKeywords = $"کد خطا {errorCode.Code}, ارور {errorCode.Brand}, {errorCode.DeviceType}, {errorCode.Description}, تعمیرات {errorCode.Brand}";

            ParseVideo(errorCode.VideoUrl);
            BuildJsonLd();
            var b = errorCode.Brand.Trim().ToLowerInvariant();
            var d = errorCode.DeviceType.Trim().ToLowerInvariant();
            var c = errorCode.Code.Trim().ToLowerInvariant();
            canonicalUrl = $"https://errorservice.ir/technical/error-codes/{Uri.EscapeDataString(b)}/{Uri.EscapeDataString(d)}/{Uri.EscapeDataString(c)}";

            try
            {
                relatedCodes = await Http.GetFromJsonAsync<List<ErrorCode>>(
                    $"api/technical/error-codes/related/{errorCode.Id}"
                ) ?? new();
            }
            catch { relatedCodes = new(); }

            await LoadRelatedProductsAsync(errorCode.RelatedProductIds);
        }
        catch
        {
            errorCode = null;
        }
        isLoading = false;
    }

    private void BuildJsonLd()
    {
        if (errorCode == null) return;

        var baseUrl = "https://errorservice.ir";
        var url = $"{baseUrl}/technical/error-codes/{Uri.EscapeDataString(errorCode.Brand.Trim().ToLowerInvariant())}/{Uri.EscapeDataString(errorCode.DeviceType.Trim().ToLowerInvariant())}/{Uri.EscapeDataString(errorCode.Code.Trim().ToLowerInvariant())}";

        var techArticle = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "TechArticle",
            ["headline"] = $"کد خطای {errorCode.Code} - {errorCode.Brand} {errorCode.DeviceType}",
            ["description"] = errorCode.Description,
            ["url"] = url,
            ["author"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = "ارورسرویس" },
            ["publisher"] = new Dictionary<string, object?> { ["@type"] = "Organization", ["name"] = "ارورسرویس", ["logo"] = new Dictionary<string, string?> { ["@type"] = "ImageObject", ["url"] = $"{baseUrl}/favicon.png" } },
            ["mainEntityOfPage"] = url,
            ["about"] = new Dictionary<string, object?>
            {
                ["@type"] = "Thing",
                ["name"] = $"کد خطا {errorCode.Code}",
                ["description"] = errorCode.Description
            }
        };

        if (!string.IsNullOrEmpty(errorCode.ImageUrl))
            techArticle["image"] = errorCode.ImageUrl;

        var breadcrumbList = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new object[]
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = baseUrl },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "بانک کدهای خطا", ["item"] = $"{baseUrl}/technical/error-codes" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = errorCode.Brand, ["item"] = $"{baseUrl}/technical/error-codes?brand={Uri.EscapeDataString(errorCode.Brand)}" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 4, ["name"] = errorCode.Code, ["item"] = url }
            }
        };

        var jsonParts = new List<string>
        {
            JsonSerializer.Serialize(techArticle),
            JsonSerializer.Serialize(breadcrumbList)
        };

        if (publishedFaqs.Any())
        {
            var faqPage = new Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "FAQPage",
                ["mainEntity"] = publishedFaqs.Select(f => new Dictionary<string, object?>
                {
                    ["@type"] = "Question",
                    ["name"] = f.Question,
                    ["acceptedAnswer"] = new Dictionary<string, object?>
                    {
                        ["@type"] = "Answer",
                        ["text"] = f.Answer
                    }
                }).ToArray()
            };
            jsonParts.Add(JsonSerializer.Serialize(faqPage));
        }

        jsonLd = $"[{string.Join(",", jsonParts)}]";
    }

    private async Task LoadRelatedProductsAsync(string? relatedProductIds)
    {
        var ids = ParseProductIds(relatedProductIds);
        if (ids.Count == 0) return;

        try
        {
            relatedProducts = await Http.GetFromJsonAsync<List<ProductDto>>(
                $"api/products/by-ids?ids={string.Join(",", ids)}") ?? new();
        }
        catch
        {
            relatedProducts = new();
        }
    }

    private static List<int> ParseProductIds(string? value) =>
        (value ?? string.Empty)
            .Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(x => int.TryParse(x.Trim(), out var id) ? id : 0)
            .Where(id => id > 0)
            .Distinct()
            .Take(6)
            .ToList();

    private void ParseVideo(string? url)
    {
        videoEmbedUrl = null;
        videoExternalUrl = null;

        if (string.IsNullOrWhiteSpace(url)) return;
        if (!Uri.TryCreate(url.Trim(), UriKind.Absolute, out var uri)) return;
        if (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps) return;

        var host = uri.Host.ToLowerInvariant();
        var path = uri.AbsolutePath.Trim('/');
        var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

        if (host == "youtu.be")
        {
            var id = segments.FirstOrDefault() ?? string.Empty;
            if (IsYouTubeId(id))
            {
                videoEmbedUrl = $"https://www.youtube-nocookie.com/embed/{id}";
                return;
            }
        }

        if (host.EndsWith("youtube.com") || host.EndsWith("youtube-nocookie.com"))
        {
            var id = path.StartsWith("watch")
                ? GetQueryValue(uri, "v")
                : segments.Length > 1 && (segments[0] is "shorts" or "embed" or "live")
                    ? segments[1]
                    : string.Empty;

            if (IsYouTubeId(id))
            {
                videoEmbedUrl = $"https://www.youtube-nocookie.com/embed/{id}";
                return;
            }
        }

        if (host.EndsWith("aparat.com"))
        {
            var index = Array.IndexOf(segments, "v");
            if (index < 0) index = Array.IndexOf(segments, "videohash");
            var hash = index >= 0 && index + 1 < segments.Length ? segments[index + 1] : string.Empty;

            if (IsSimpleVideoId(hash))
            {
                videoEmbedUrl = $"https://www.aparat.com/video/video/embed/videohash/{hash}/vt/frame";
                return;
            }
        }

        if (host.EndsWith("vimeo.com"))
        {
            var id = segments.LastOrDefault() ?? string.Empty;
            if (id.Length >= 5 && id.All(char.IsDigit))
            {
                videoEmbedUrl = $"https://player.vimeo.com/video/{id}";
                return;
            }
        }

        videoExternalUrl = uri.ToString();
    }

    private static bool IsYouTubeId(string value) =>
        value.Length is >= 6 and <= 20 && value.All(c => char.IsLetterOrDigit(c) || c is '-' or '_');

    private static bool IsSimpleVideoId(string value) =>
        value.Length is >= 5 and <= 30 && value.All(char.IsLetterOrDigit);

    private static string GetQueryValue(Uri uri, string key)
    {
        foreach (var pair in uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var parts = pair.Split('=', 2);
            if (parts.Length == 2 && parts[0].Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(parts[1]);
        }
        return string.Empty;
    }

    private static string StripUrls(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";

        var cleaned = NoteUrlRegex.Replace(text, " ");
        cleaned = Regex.Replace(cleaned, @"[\r\n]+", " ");
        cleaned = Regex.Replace(cleaned, @"[ \t]{2,}", " ");
        return cleaned.Trim();
    }

    private static List<string> ExtractUrls(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return new();

        var urls = new List<string>();
        foreach (Match match in NoteUrlRegex.Matches(text))
        {
            var url = match.Value.TrimEnd('.', ',', ';', '،', '؛', ')', ']', '}', '>', '»');
            if (url.Length > 0 && !urls.Any(u => string.Equals(u, url, StringComparison.OrdinalIgnoreCase)))
                urls.Add(url);
        }
        return urls;
    }

    private string Truncate(string? text, int max)
    {
        if (string.IsNullOrEmpty(text)) return "";
        return text.Length <= max ? text : text[..max] + "...";
    }
