@page "/cart"
@implements IDisposable
@using ErrorService.Client.Services
@using ErrorService.Shared
@inject CartService CartService
@inject NavigationManager Nav
@inject HttpClient Http
@inject AuthService AuthService
@inject ToastService ToastService
@using ErrorService.Client.Shared
@using Microsoft.AspNetCore.Components.Authorization
@using System.Net.Http.Json

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<PageTitle>سبد خرید - ارورسرویس</PageTitle>

<div class="cart-page" dir="rtl">
    <div class="container py-4">
        <div class="d-flex align-items-center gap-3 mb-5 px-1">
            <a href="/products" class="btn-back">
                <span class="oi oi-arrow-right"></span>
            </a>
            <div>
                <h1 class="page-title">سبد خرید</h1>
                <p class="page-subtitle">@CartService.GetTotalCount() کالا در سبد شماست</p>
            </div>
        </div>

        @if (FreeShippingEnabled && CartService.GetItems().Any())
        {
            var total = GetAvailableTotalAmount();
            var threshold = _shop!.FreeShippingThreshold ?? 0;
            var remaining = threshold - total;
            var pct = threshold > 0 ? (int)Math.Min(100, Math.Max(0, total * 100 / threshold)) : 0;
            <div class="fs-banner @(remaining <= 0 ? "fs-banner--done" : "")">
                <span class="oi oi-truck"></span>
                <div class="fs-banner__body">
                    @if (remaining <= 0)
                    {
                        <strong>تبریک! ارسال این سفارش رایگان است</strong>
                    }
                    else
                    {
                        <strong>تا ارسال رایگان @remaining.ToString("N0") تومان مانده است</strong>
                        <div class="fs-banner__track">
                            <span class="fs-banner__fill" style="width:@(pct)%"></span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (!CartService.GetItems().Any())
        {
            <div class="empty-state animate__animated animate__fadeIn">
                <div class="empty-icon">
                    <span class="oi oi-cart"></span>
                </div>
                <h3 class="empty-title">سبد خرید خالی است</h3>
                <p class="empty-desc">هنوز محصولی به سبد خود اضافه نکرده‌اید</p>
                <a href="/products" class="btn btn-primary-custom px-5 py-3">مشاهده محصولات</a>
            </div>
        }
        else
        {
            @if (UnavailableCount > 0)
            {
                <div class="cart-alert animate__animated animate__fadeIn">
                    <span class="oi oi-alert"></span>
                    <div>
                        <strong>@UnavailableCount کالا ناموجود شده است</strong>
                        <p>این کالاها غیرفعال شده‌اند و هنگام ادامه با تایید شما از سبد حذف می‌شوند.</p>
                    </div>
                </div>
            }

            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="d-flex justify-content-between align-items-center mb-3 px-1">
                        <span class="text-muted small">@CartService.GetItems().Count() قلم کالا</span>
                        <button class="btn btn-sm btn-link text-danger p-0" @onclick="async () => await CartService.ClearCartAsync()">
                            <span class="oi oi-trash me-1"></span> خالی کردن سبد
                        </button>
                    </div>
                    <div class="items-list">
                        @foreach (var item in CartService.GetItems())
                        {
                            var avail = GetAvailability(item.ProductId);
                            var notPurchasable = avail != null && (!avail.IsAvailable || avail.StockQuantity <= 0);
                            var overStock = avail != null && !notPurchasable && item.Quantity > avail.StockQuantity;
                            var atCap = avail != null && !notPurchasable && item.Quantity >= avail.StockQuantity;
                            var isUnavailable = notPurchasable || overStock;
                            <div class="item-card @(isUnavailable ? "item-card--unavailable" : "") animate__animated animate__fadeInUp">
                                @if (isUnavailable)
                                {
                                    <div class="item-unavailable-badge">
                                        <span class="oi oi-ban"></span>
                                        @(notPurchasable ? "ناموجود" : $"موجودی: فقط {avail!.StockQuantity} عدد")
                                    </div>
                                }
                                else if (atCap)
                                {
                                    <div class="item-unavailable-badge item-unavailable-badge--info">
                                        <span class="oi oi-info"></span>
                                        سقف موجودی: @avail!.StockQuantity عدد
                                    </div>
                                }
                                <div class="d-flex align-items-center gap-3">
                                    <div class="item-img">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder-product.svg" : ImageUrlHelper.Thumb(item.ImageUrl, 200))"
                                             loading="lazy" decoding="async" alt="@item.Name" />
                                    </div>
                                    <div class="flex-grow-1 min-w-0">
                                        <h5 class="item-name">@item.Name</h5>
                                        <div class="item-price">@item.Price.ToString("N0") <span class="currency">تومان</span></div>
                                    </div>
                                    <div class="item-qty">
                                        <QuantityControl Quantity="@item.Quantity"
                                                         Disabled="@notPurchasable"
                                                         IncreaseDisabled="@atCap"
                                                         OnAdd="() => CartService.UpdateQuantityAsync(item.ProductId, item.Quantity + 1)"
                                                         OnIncrease="() => CartService.UpdateQuantityAsync(item.ProductId, item.Quantity + 1)"
                                                         OnDecrease="() => CartService.UpdateQuantityAsync(item.ProductId, item.Quantity - 1)" />
                                    </div>
                                    <button class="btn btn-sm text-danger p-1" @onclick="() => CartService.RemoveItemAsync(item.ProductId)" title="حذف از سبد">
                                        <span class="oi oi-x" style="font-size:0.75rem;"></span>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="summary-card sticky-top">
                        <CascadingAuthenticationState>
                            <AuthorizeView>
                                <NotAuthorized>
                                    <div class="auth-banner">
                                        <div class="auth-banner-icon">
                                            <span class="oi oi-account-login"></span>
                                        </div>
                                        <div>
                                            <div class="auth-banner-title">مهمان هستید؟</div>
                                            <div class="auth-banner-desc">برای پیگیری آسان‌تر سفارش وارد شوید</div>
                                            <div class="d-flex gap-2 mt-2">
                                                <a class="btn btn-sm btn-primary-custom px-3 py-1" href="/auth/login">ورود</a>
                                                <a class="btn btn-sm btn-outline-custom px-3 py-1" href="/auth/register">ثبت‌نام</a>
                                            </div>
                                        </div>
                                    </div>
                                </NotAuthorized>
                                <Authorized>
                                    <div class="auth-banner auth-banner--ok">
                                        <span class="oi oi-check text-success"></span>
                                        <span class="small text-muted">اطلاعات در مرحله بعد خودکار پر می‌شود</span>
                                    </div>
                                </Authorized>
                            </AuthorizeView>
                        </CascadingAuthenticationState>

                        <div class="summary-row">
                            <span class="summary-label">تعداد اقلام</span>
                            <span class="summary-value">@CartService.GetTotalCount() عدد</span>
                        </div>
                        <div class="summary-row">
                            <span class="summary-label">مجموع کالاها</span>
                            <span class="summary-value">@GetAvailableTotalAmount().ToString("N0") <small>تومان</small></span>
                        </div>
                        @if (UnavailableCount > 0)
                        {
                            <div class="summary-row summary-row--warn">
                                <span class="summary-label">کالای ناموجود</span>
                                <span class="summary-value">@UnavailableCount مورد (حذف در ادامه)</span>
                            </div>
                        }
                        <div class="summary-divider"></div>
                        <div class="summary-total">
                            <span>مبلغ قابل پرداخت</span>
                            <div class="total-amount">@GetAvailableTotalAmount().ToString("N0") <span class="total-currency">تومان</span></div>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button class="btn btn-primary-custom py-3" @onclick="ProceedToCheckout">
                                ثبت سفارش و ادامه
                                <span class="oi oi-chevron-left me-1"></span>
                            </button>
                            <a href="/products" class="btn btn-ghost-custom py-3">بازگشت به فروشگاه</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<ConfirmDialog IsVisible="showRemoveUnavailableConfirm"
               Title="حذف کالاهای ناموجود"
               Message="@($"{UnavailableCount} کالا ناموجود شده و قابل خرید نیست. برای ادامه از سبد حذف شوند؟")"
               ConfirmText="حذف و ادامه"
               IsDanger="true"
               OnResult="HandleRemoveUnavailableResult" />


@code {
    private Dictionary<int, ProductAvailabilityDto> _availability = new();
    private bool showRemoveUnavailableConfirm;
    private bool _checkingAvailability;
    private SiteSettingsDto? _shop;

    private bool FreeShippingEnabled =>
        _shop != null && _shop.EnableFreeShipping && (_shop.FreeShippingThreshold ?? 0) > 0;

    private IEnumerable<int> UnavailableProductIds =>
        CartService.GetItems()
            .Where(i => _availability.TryGetValue(i.ProductId, out var a) && !a.HasSufficientStock)
            .Select(i => i.ProductId);

    private int UnavailableCount => UnavailableProductIds.Count();

    private ProductAvailabilityDto? GetAvailability(int productId)
        => _availability.TryGetValue(productId, out var a) ? a : null;

    private decimal GetAvailableTotalAmount()
        => CartService.GetItems()
            .Where(i => !_availability.TryGetValue(i.ProductId, out var a) || a.HasSufficientStock)
            .Sum(i => i.Price * i.Quantity);

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += OnCartChanged;
        _ = LoadShopSettingsAsync();
        await CheckAvailabilityAsync();
    }

    private async Task LoadShopSettingsAsync()
    {
        try
        {
            _shop = await Http.GetFromJsonAsync<SiteSettingsDto>("api/sitesettings");
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    public void Dispose()
    {
        CartService.OnChange -= OnCartChanged;
    }

    private async void OnCartChanged()
    {
        await InvokeAsync(() =>
        {
            StateHasChanged();
            _ = CheckAvailabilityAsync();
        });
    }

    private async Task CheckAvailabilityAsync()
    {
        var items = CartService.GetItems().ToList();
        if (items.Count == 0)
        {
            if (_availability.Count > 0)
            {
                _availability.Clear();
                StateHasChanged();
            }
            return;
        }

        if (_checkingAvailability) return;
        _checkingAvailability = true;
        try
        {
            var req = items.Select(i => new ProductAvailabilityCheckItem
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity
            }).ToList();

            var resp = await Http.PostAsJsonAsync("api/products/check-availability", req);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<List<ProductAvailabilityDto>>();
                if (result != null)
                {
                    var newMap = result.ToDictionary(x => x.ProductId);
                    var becameUnavailable = newMap.Count(kvp =>
                        kvp.Value.HasSufficientStock == false &&
                        (!_availability.TryGetValue(kvp.Key, out var old) || old.HasSufficientStock));

                    _availability = newMap;

                    if (becameUnavailable > 0)
                        ToastService.ShowWarning($"{becameUnavailable} کالا در سبد شما ناموجود شده است.");

                    StateHasChanged();
                }
            }
        }
        catch { }
        finally { _checkingAvailability = false; }
    }

    private async Task ProceedToCheckout()
    {
        await CheckAvailabilityAsync();

        if (UnavailableCount > 0)
        {
            showRemoveUnavailableConfirm = true;
            StateHasChanged();
            return;
        }

        await ContinueToCheckoutAsync();
    }

    private async Task HandleRemoveUnavailableResult(bool confirmed)
    {
        showRemoveUnavailableConfirm = false;
        if (!confirmed)
        {
            StateHasChanged();
            return;
        }

        foreach (var pid in UnavailableProductIds.ToList())
            await CartService.RemoveItemAsync(pid);

        ToastService.ShowSuccess("کالاهای ناموجود از سبد حذف شدند.");
        await ContinueToCheckoutAsync();
    }

    private async Task ContinueToCheckoutAsync()
    {
        var allowGuest = true;

        try
        {
            var settings = await Http.GetFromJsonAsync<SiteSettingsDto>("api/sitesettings");
            allowGuest = settings?.AllowGuestCheckout ?? true;
        }
        catch
        {
        }

        if (!allowGuest)
        {
            try
            {
                var me = await AuthService.GetMeAsync();
                if (me == null)
                {
                    Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString("/checkout")}");
                    return;
                }
            }
            catch
            {
                Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString("/checkout")}");
                return;
            }
        }

        Nav.NavigateTo("/checkout");
    }
}
