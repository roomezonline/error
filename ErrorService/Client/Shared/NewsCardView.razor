@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Utils

<div class="news-card-view" dir="rtl">
    @if (newsList == null)
    {
        <div class="row g-4">
            @for (int i = 0; i < 3; i++)
            {
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden skeleton-card">
                        <div class="skeleton-img"></div>
                        <div class="card-body p-3">
                            <div class="skeleton-text mb-2"></div>
                            <div class="skeleton-text w-75"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!newsList.Any())
    {
        <div class="text-center py-5">
            <p class="text-muted">مطلبی برای نمایش یافت نشد.</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var news in newsList)
            {
                <div class="col-md-4">
                    <a href="@SeoUrl.News(news.Id, news.Slug)" class="text-decoration-none">
                        <div class="card news-card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                            <div class="news-card__img-wrap position-relative">
                                @if (!string.IsNullOrWhiteSpace(news.ImageUrl))
                                {
                                    <img src="@news.ImageUrl" loading="lazy" class="card-img-top" alt="@news.Title" />
                                }
                                else
                                {
                                    <div class="news-placeholder-wrap card-img-top">
                                        <div class="news-placeholder-icon">
                                            <span class="oi oi-image"></span>
                                        </div>
                                        <div class="news-placeholder-text">تصویری ثبت نشده است</div>
                                    </div>
                                }
                                <div class="news-card__date position-absolute bottom-0 start-0 m-3 badge bg-primary rounded-pill px-3 shadow">
                                    <span class="small opacity-75 me-1">@PersianDate.ToTime(news.CreatedAt)</span>
                                    <span>@PersianDate.ToJalaliDate(news.CreatedAt)</span>
                                </div>
                            </div>
                            <div class="card-body p-3">
                                <h3 class="h6 fw-bold text-dark mb-2 news-card__title">@news.Title</h3>
                                <p class="text-muted small mb-0 news-card__summary">@news.Summary</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<style>
    .news-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .news-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
    }
    .news-card__img-wrap {
        height: 200px;
        overflow: hidden;
    }
    .news-card__img-wrap img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .news-card:hover img {
        transform: scale(1.1);
    }
    .news-placeholder-wrap {
        height: 100%;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        color: #94a3b8;
    }
    .news-placeholder-icon {
        font-size: 2.5rem;
        opacity: 0.5;
    }
    .news-placeholder-text {
        font-size: 0.75rem;
        font-weight: 700;
        text-align: center;
    }
    .news-card__title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.8em;
        line-height: 1.4;
    }
    .news-card__summary {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 3em;
    }

    /* Skeleton */
    .skeleton-card .skeleton-img {
        height: 200px;
        background: #f0f0f0;
        animation: skeleton-pulse 1.5s infinite;
    }
    .skeleton-text {
        height: 15px;
        background: #f0f0f0;
        border-radius: 4px;
        animation: skeleton-pulse 1.5s infinite;
    }
    @@keyframes skeleton-pulse {
        0% { opacity: 0.6; }
        50% { opacity: 1; }
        100% { opacity: 0.6; }
    }
</style>

@code {
    [Parameter] public int Count { get; set; } = 3;
    [Inject] private HttpClient Http { get; set; } = default!;
    private List<NewsDto>? newsList;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            newsList = await Http.GetFromJsonAsync<List<NewsDto>>($"api/news?onlyPublished=true&skip=0&take={Count}");
        }
        catch { newsList = new(); }
    }
}
