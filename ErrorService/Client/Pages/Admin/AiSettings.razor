@page "/admin/ai"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@attribute [Authorize(Policy = "perm:admin.ai.view")]
@using System.Text.Json
@using ErrorService.Shared
@inject HttpClient Http
@inject AuthenticationStateProvider Auth

<div class="ai-page">
    <div class="ai-head">
        <div>
            <h4 class="mb-1">تنظیمات هوش مصنوعی</h4>
            <p class="text-muted small mb-0">
                زنجیره سرویس‌دهنده ← کلید ← مدل را یک‌بار اینجا تنظیم کنید. سپس برای هر سرویس‌دهنده مشخص کنید
                در «چت» استفاده شود، در «استودیوی محتوا» یا هر دو.
            </p>
        </div>
        <div class="ai-head__actions">
            <a href="/admin/chat" class="btn btn-outline-secondary btn-sm">تنظیمات چت</a>
            <a href="/admin/content-studio" class="btn btn-outline-secondary btn-sm">استودیوی محتوا</a>
            <a href="/admin" class="btn btn-outline-secondary btn-sm">داشبورد</a>
        </div>
    </div>

    <div class="ai-status-grid">
        <div class="ai-status-card">
            <b>@_aiProviders.Count(p => p.Enabled)</b>
            <span>سرویس‌دهنده فعال</span>
        </div>
        <div class="ai-status-card">
            <b>@ChatScopeCount</b>
            <span>برای چت</span>
        </div>
        <div class="ai-status-card">
            <b>@StudioScopeCount</b>
            <span>برای استودیوی محتوا</span>
        </div>
        <div class="ai-status-card">
            <b>@ActiveModelCount</b>
            <span>مدل فعال</span>
        </div>
    </div>

    @if (!_canManage)
    {
        <div class="ai-note warn">فقط مشاهده — برای تغییر تنظیمات به مجوز «مدیریت هوش مصنوعی» نیاز دارید.</div>
    }

    @if (_aiProvidersLoading || _legacyLoading)
    {
        <div class="ai-note"><span class="spinner-border spinner-border-sm me-1"></span> در حال بارگذاری…</div>
    }
    else
    {
        <div class="ai-card">
            <div class="ai-card__head">
                <div>
                    <div class="ai-card__title"><span class="oi oi-layers"></span> زنجیره سرویس‌دهنده‌ها</div>
                    <div class="ai-hint">در صورت خطا یا اتمام سقف، به‌صورت خودکار سرویس‌دهنده/کلید/مدل بعدی استفاده می‌شود.</div>
                    <div class="ai-hint">
                        برای مدل‌های رایگان OpenRouter در
                        <a href="https://openrouter.ai/settings/privacy" target="_blank" rel="noopener">تنظیمات Privacy</a>
                        گزینه انتشار مدل‌های رایگان را فعال کنید؛ وگرنه خطای «No endpoints found» می‌گیرید.
                        سهمیه رایگان محدود است؛ چند مدل را در زنجیره نگه دارید.
                        اگر «Access denied by security policy» گرفتید، IP سرور مسدود است؛ در همان سرویس‌دهنده «Proxy خروجی» را پر کنید.
                    </div>
                </div>
                @if (_canManage)
                {
                    <div class="ai-card__actions">
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ResetCooldownsAsync" disabled="@(_aiProvidersLoading || _resettingCooldowns)" title="خطاهای قبلی را پاک می‌کند تا کلید/مدل‌ها فوراً دوباره امتحان شوند.">
                            @(_resettingCooldowns ? "در حال پاک‌سازی…" : "پاک‌کردن کول‌داون")
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="TestChainAsync" disabled="@(_aiProvidersLoading || _chainTesting)">
                            @(_chainTesting ? "در حال تست…" : "تست زنجیره")
                        </button>
                        <button type="button" class="btn btn-primary btn-sm" @onclick="SaveProvidersAsync" disabled="@(_aiProvidersLoading || _aiProvidersSaving)">
                            @(_aiProvidersSaving ? "در حال ذخیره…" : "ذخیره سرویس‌دهنده‌ها")
                        </button>
                    </div>
                }
            </div>

            @if (_aiProviders.Count == 0)
            {
                <div class="ai-empty">
                    هنوز سرویس‌دهنده‌ای ثبت نشده است. با «افزودن سرویس‌دهنده» شروع کنید یا از پیکربندی تک‌کلیدی پایین استفاده کنید.
                </div>
            }

            @foreach (var p in _aiProviders)
            {
                var pRef = p;
                <div class="ai-provider @(pRef.Enabled ? "" : "off")">
                    <div class="ai-provider__head">
                        <label class="ai-switch" title="فعال/غیرفعال">
                            <input type="checkbox" @bind="pRef.Enabled" disabled="@(!_canManage)" />
                            <span class="ai-switch__slider"></span>
                        </label>
                        <input type="text" class="form-control form-control-sm" placeholder="نام سرویس‌دهنده" @bind="pRef.Name" disabled="@(!_canManage)" />
                        <input type="text" class="form-control form-control-sm" dir="ltr" placeholder="https://openrouter.ai/api/v1" @bind="pRef.BaseUrl" disabled="@(!_canManage)" />
                        <select class="form-select form-select-sm" @bind="pRef.Kind" disabled="@(!_canManage)">
                            <option value="openrouter">OpenRouter</option>
                            <option value="openai">OpenAI</option>
                            <option value="custom">سازگار OpenAI</option>
                        </select>
                        @if (_canManage)
                        {
                            <span class="ai-provider__tools">
                                <button type="button" class="ai-icon-btn" title="بالا" @onclick="() => MoveProvider(pRef, -1)"><span class="oi oi-arrow-top"></span></button>
                                <button type="button" class="ai-icon-btn" title="پایین" @onclick="() => MoveProvider(pRef, 1)"><span class="oi oi-arrow-bottom"></span></button>
                                <button type="button" class="ai-icon-btn danger" title="حذف سرویس‌دهنده" @onclick="() => RemoveProvider(pRef)"><span class="oi oi-trash"></span></button>
                            </span>
                        }
                    </div>

                    <div class="ai-sub-title">پروکسی‌های خروجی</div>
                    <small class="ai-proxy-hint">
                        اگر خطای «Access denied by security policy» می‌گیرید، IP سرور مسدود است. چند پروکسی اضافه کنید؛
                        در صورت خطا یا کول‌داون هر پروکسی، درخواست خودکار روی پروکسی بعدی و در نهایت اتصال مستقیم امتحان می‌شود.
                    </small>
                    @foreach (var px in pRef.Proxies)
                    {
                        var xRef = px;
                        <div class="ai-row @(xRef.Enabled ? "" : "off")">
                            <input type="checkbox" @bind="xRef.Enabled" disabled="@(!_canManage)" title="فعال" />
                            <input type="text" class="form-control form-control-sm" dir="ltr"
                                   placeholder="http://host:port یا socks5://host:port" @bind="xRef.Url" disabled="@(!_canManage)" />
                            <input type="text" class="form-control form-control-sm label-input" placeholder="برچسب (اختیاری)" @bind="xRef.Label" disabled="@(!_canManage)" />
                            <span class="ai-status @(xRef.InCooldown ? "warn" : xRef.FailureCount > xRef.SuccessCount ? "bad" : "ok")" title="@(xRef.LastError ?? "")">
                                @(xRef.InCooldown ? $"کول‌داون تا {xRef.CooldownUntil:HH:mm}" : $"✓{xRef.SuccessCount} ✗{xRef.FailureCount}")
                            </span>
                            @if (_canManage)
                            {
                                <button type="button" class="ai-icon-btn danger" title="حذف پروکسی" @onclick="() => pRef.Proxies.Remove(xRef)"><span class="oi oi-trash"></span></button>
                            }
                        </div>
                    }
                    @if (_canManage)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => pRef.Proxies.Add(new AiProxyUi())">+ افزودن پروکسی</button>
                    }

                    <div class="ai-scope-row">
                        <span class="ai-scope-title">کاربرد:</span>
                        <label class="ai-scope @(pRef.UseForChat ? "on" : "")">
                            <input type="checkbox" @bind="pRef.UseForChat" disabled="@(!_canManage)" />
                            <span>چت</span>
                        </label>
                        <label class="ai-scope @(pRef.UseForContentStudio ? "on" : "")">
                            <input type="checkbox" @bind="pRef.UseForContentStudio" disabled="@(!_canManage)" />
                            <span>استودیوی محتوا</span>
                        </label>
                        @if (!pRef.UseForChat && !pRef.UseForContentStudio)
                        {
                            <span class="ai-scope-warn">هیچ کاربردی انتخاب نشده؛ این سرویس‌دهنده استفاده نمی‌شود.</span>
                        }
                    </div>

                    @if (pRef.Kind == "openrouter")
                    {
                        <div class="ai-inline">
                            <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => LoadCatalogAsync(pRef)" disabled="@(pRef.CatalogLoading || !_canManage)">
                                @(pRef.CatalogLoading ? "در حال دریافت…" : "دریافت مدل‌های رایگان OpenRouter")
                            </button>
                            @if (pRef.CatalogMessage != null)
                            {
                                <small class="text-muted">@pRef.CatalogMessage</small>
                            }
                        </div>
                        @if (pRef.Catalog is { Count: > 0 })
                        {
                            <div class="ai-catalog">
                                @foreach (var c in pRef.Catalog.Take(60))
                                {
                                    var cat = c;
                                    <label class="ai-catalog__item">
                                        <input type="checkbox" @bind="cat.Selected" />
                                        <span dir="ltr">@cat.Id</span>
                                        <small class="text-muted">@cat.Name</small>
                                    </label>
                                }
                                <button type="button" class="btn btn-primary btn-sm mt-1" @onclick="() => AddSelectedCatalog(pRef)">
                                    افزودن مدل‌های انتخاب‌شده (@pRef.Catalog.Count(x => x.Selected))
                                </button>
                            </div>
                        }
                    }

                    <div class="ai-sub-title">کلیدها (API Key)</div>
                    @foreach (var k in pRef.Keys)
                    {
                        var kRef = k;
                        <div class="ai-row @(kRef.Enabled ? "" : "off")">
                            <input type="checkbox" @bind="kRef.Enabled" disabled="@(!_canManage)" title="فعال" />
                            <input type="password" class="form-control form-control-sm" dir="ltr" placeholder="sk-..." @bind="kRef.KeyValue" disabled="@(!_canManage)" />
                            <input type="text" class="form-control form-control-sm label-input" placeholder="برچسب (اختیاری)" @bind="kRef.Label" disabled="@(!_canManage)" />
                            <span class="ai-status @(kRef.InCooldown ? "warn" : kRef.FailureCount > kRef.SuccessCount ? "bad" : "ok")" title="@(kRef.LastError ?? "")">
                                @(kRef.InCooldown ? $"کول‌داون تا {kRef.CooldownUntil:HH:mm}" : $"✓{kRef.SuccessCount} ✗{kRef.FailureCount}")
                            </span>
                            @if (_canManage)
                            {
                                <button type="button" class="ai-icon-btn danger" @onclick="() => pRef.Keys.Remove(kRef)"><span class="oi oi-trash"></span></button>
                            }
                        </div>
                    }
                    @if (_canManage)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => pRef.Keys.Add(new AiKeyUi())">+ افزودن کلید</button>
                    }

                    <div class="ai-sub-title mt-3">مدل‌ها</div>
                    @foreach (var m in pRef.Models)
                    {
                        var mRef = m;
                        <div class="ai-row @(mRef.Enabled ? "" : "off")">
                            <input type="checkbox" @bind="mRef.Enabled" disabled="@(!_canManage)" title="فعال" />
                            <input type="text" class="form-control form-control-sm" dir="ltr" placeholder="provider/model:free" @bind="mRef.ModelId" disabled="@(!_canManage)" />
                            <input type="text" class="form-control form-control-sm label-input" placeholder="نام نمایشی" @bind="mRef.Label" disabled="@(!_canManage)" />
                            <span class="ai-status @(mRef.InCooldown ? "warn" : mRef.FailureCount > mRef.SuccessCount ? "bad" : "ok")" title="@(mRef.LastError ?? "")">
                                @(mRef.InCooldown ? $"کول‌داون تا {mRef.CooldownUntil:HH:mm}" : $"✓{mRef.SuccessCount} ✗{mRef.FailureCount}")
                            </span>
                            @if (_canManage)
                            {
                                <button type="button" class="ai-icon-btn danger" @onclick="() => pRef.Models.Remove(mRef)"><span class="oi oi-trash"></span></button>
                            }
                        </div>
                    }
                    @if (_canManage)
                    {
                        <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="() => pRef.Models.Add(new AiModelUi())">+ افزودن مدل</button>
                    }
                </div>
            }

            @if (_canManage)
            {
                <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="AddProvider">
                    <span class="oi oi-plus"></span> افزودن سرویس‌دهنده
                </button>
            }

            @if (_chainResults is { Count: > 0 })
            {
                <div class="ai-chain">
                    @foreach (var r in _chainResults)
                    {
                        <div class="ai-chain__row @(r.Ok ? "ok" : "fail")">
                            <span class="fw-bold">@r.Provider</span>
                            <span class="mono" dir="ltr">@r.Model</span>
                            <span class="mono text-muted" dir="ltr">@r.Key</span>
                            @if (!string.IsNullOrWhiteSpace(r.Proxy))
                            {
                                <span class="mono text-muted" dir="ltr" title="پروکسی">@r.Proxy</span>
                            }
                            <span class="ai-chain__msg">@r.Message</span>
                            <span class="text-muted">@r.Ms ms</span>
                        </div>
                    }
                </div>
            }

            @if (_aiProvidersMessage != null)
            {
                <div class="ai-note @(_aiProvidersOk == true ? "ok" : "bad")">@_aiProvidersMessage</div>
            }
        </div>

        <div class="ai-card">
            <div class="ai-card__head">
                <div>
                    <div class="ai-card__title"><span class="oi oi-wrench"></span> پیکربندی پشتیبان (تک‌کلیدی)</div>
                    <div class="ai-hint">اگر هیچ سرویس‌دهنده‌ای برای یک کاربرد انتخاب نشده باشد، از این پیکربندی استفاده می‌شود.</div>
                </div>
                @if (_canManage)
                {
                    <button type="button" class="btn btn-primary btn-sm" @onclick="SaveLegacyAsync" disabled="@_legacySaving">
                        @(_legacySaving ? "در حال ذخیره…" : "ذخیره پیکربندی پشتیبان")
                    </button>
                }
            </div>

            <div class="ai-grid">
                <div>
                    <label class="ai-label">نام ارائه‌دهنده</label>
                    <input type="text" class="form-control form-control-sm" @bind="_legacy.Provider" placeholder="openai / openrouter / ..." disabled="@(!_canManage)" />
                </div>
                <div>
                    <label class="ai-label">آدرس API</label>
                    <input type="text" class="form-control form-control-sm" dir="ltr" @bind="_legacy.ApiUrl" placeholder="https://openrouter.ai/api/v1" disabled="@(!_canManage)" />
                </div>
                <div>
                    <label class="ai-label">کلید API</label>
                    <input type="password" class="form-control form-control-sm" dir="ltr" @bind="_legacy.ApiKey" placeholder="sk-..." disabled="@(!_canManage)" />
                </div>
                <div>
                    <label class="ai-label">نام مدل</label>
                    <input type="text" class="form-control form-control-sm" dir="ltr" @bind="_legacy.Model" placeholder="gpt-4o-mini / auto" disabled="@(!_canManage)" />
                </div>
            </div>

            @if (_canManage)
            {
                <div class="mt-2">
                    <button type="button" class="btn btn-outline-primary btn-sm" @onclick="TestLegacyAsync" disabled="@_legacyTesting">
                        @(_legacyTesting ? "در حال تست…" : "تست این پیکربندی")
                    </button>
                </div>
            }
            @if (_legacyMessage != null)
            {
                <div class="ai-note @(_legacyOk == true ? "ok" : "bad")">@_legacyMessage</div>
            }
        </div>

        <div class="ai-card">
            <div class="ai-card__head">
                <div>
                    <div class="ai-card__title"><span class="oi oi-credit-card"></span> اعتبار API</div>
                    <div class="ai-hint">در صورت پشتیبانی سرویس‌دهنده، اعتبار باقی‌مانده استعلام می‌شود.</div>
                </div>
                <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="LoadCreditsAsync" disabled="@_creditsLoading">
                    @(_creditsLoading ? "در حال استعلام…" : "استعلام")
                </button>
            </div>

            @if (_credits == null)
            {
                <div class="ai-empty">هنوز استعلام نشده است.</div>
            }
            else if (!_credits.ok)
            {
                <div class="ai-note warn">@(_credits.message ?? "استعلام اعتبار انجام نشد.")</div>
            }
            else
            {
                <div class="ai-credits">
                    <div class="ai-credit"><b dir="ltr">@_credits.remaining.ToString("0.####")</b><span>باقی‌مانده (@_credits.currency)</span></div>
                    <div class="ai-credit"><b dir="ltr">@_credits.totalUsage.ToString("0.####")</b><span>مصرف‌شده (@_credits.currency)</span></div>
                    <div class="ai-credit"><b dir="ltr">@_credits.totalCredits.ToString("0.####")</b><span>کل شارژ (@_credits.currency)</span></div>
                </div>
                <div class="ai-credit-bar"><div style="width:@(CreditsPercent)%"></div></div>
                @if (_credits.limit is > 0)
                {
                    <div class="ai-hint ok">سقف مجاز ماهانه: @_credits.limit.Value.ToString("0.####") @_credits.currency</div>
                }
            }
        </div>
    }
</div>

@code {
    private bool _canManage;
    private List<AiProviderUi> _aiProviders = new();
    private bool _aiProvidersLoading;
    private bool _aiProvidersSaving;
    private bool _aiProvidersLoaded;
    private string? _aiProvidersMessage;
    private bool? _aiProvidersOk;

    private bool _chainTesting;
    private bool _resettingCooldowns;
    private List<ChainResultUi>? _chainResults;

    private AiLegacyPayload _legacy = new();
    private bool _legacyLoading;
    private bool _legacySaving;
    private bool _legacyTesting;
    private string? _legacyMessage;
    private bool? _legacyOk;

    private AiCreditsDto? _credits;
    private bool _creditsLoading;

    private int ChatScopeCount => _aiProviders.Count(p => p.Enabled && p.UseForChat);
    private int StudioScopeCount => _aiProviders.Count(p => p.Enabled && p.UseForContentStudio);
    private int ActiveModelCount => _aiProviders.Where(p => p.Enabled)
        .SelectMany(p => p.Models).Count(m => m.Enabled && !string.IsNullOrWhiteSpace(m.ModelId));

    private double CreditsPercent =>
        _credits is not { ok: true } || _credits.totalCredits <= 0 ? 0
        : Math.Clamp(Math.Round(_credits.totalUsage / _credits.totalCredits * 100d, 1), 0, 100);

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        _canManage = state.User.IsInRole("super_admin")
                     || state.User.HasClaim("perm", "admin.ai.manage");

        await Task.WhenAll(LoadProvidersAsync(), LoadLegacyAsync());
        _ = LoadCreditsAsync();
    }

    private async Task LoadProvidersAsync()
    {
        _aiProvidersLoading = true;
        StateHasChanged();
        try
        {
            var json = await Http.GetFromJsonAsync<JsonElement>("api/chat/ai-providers");
            var list = new List<AiProviderUi>();
            if (json.TryGetProperty("providers", out var provs) && provs.ValueKind == JsonValueKind.Array)
            {
                foreach (var p in provs.EnumerateArray())
                {
                    var ui = new AiProviderUi
                    {
                        Id = ReadInt(p, "id"),
                        Name = ReadString(p, "name"),
                        BaseUrl = ReadString(p, "baseUrl"),
                        Kind = ReadString(p, "kind", "custom"),
                        Enabled = ReadBool(p, "enabled", true),
                        UseForChat = ReadBool(p, "useForChat", true),
                        UseForContentStudio = ReadBool(p, "useForContentStudio", true)
                    };
                    if (p.TryGetProperty("proxies", out var proxies) && proxies.ValueKind == JsonValueKind.Array)
                        foreach (var x in proxies.EnumerateArray())
                            ui.Proxies.Add(new AiProxyUi
                            {
                                Id = ReadInt(x, "id"),
                                Url = ReadString(x, "url"),
                                Label = x.TryGetProperty("label", out var xl) ? xl.GetString() : null,
                                Enabled = ReadBool(x, "enabled", true),
                                InCooldown = ReadBool(x, "inCooldown"),
                                CooldownUntil = ReadDate(x, "cooldownUntil"),
                                LastError = x.TryGetProperty("lastError", out var xle) ? xle.GetString() : null,
                                SuccessCount = ReadLong(x, "successCount"),
                                FailureCount = ReadLong(x, "failureCount")
                            });
                    if (p.TryGetProperty("keys", out var keys) && keys.ValueKind == JsonValueKind.Array)
                        foreach (var k in keys.EnumerateArray())
                            ui.Keys.Add(new AiKeyUi
                            {
                                Id = ReadInt(k, "id"),
                                KeyValue = ReadString(k, "keyValue"),
                                Label = k.TryGetProperty("label", out var kl) ? kl.GetString() : null,
                                Enabled = ReadBool(k, "enabled", true),
                                InCooldown = ReadBool(k, "inCooldown"),
                                CooldownUntil = ReadDate(k, "cooldownUntil"),
                                LastError = k.TryGetProperty("lastError", out var kle) ? kle.GetString() : null,
                                SuccessCount = ReadLong(k, "successCount"),
                                FailureCount = ReadLong(k, "failureCount")
                            });
                    if (p.TryGetProperty("models", out var models) && models.ValueKind == JsonValueKind.Array)
                        foreach (var m in models.EnumerateArray())
                            ui.Models.Add(new AiModelUi
                            {
                                Id = ReadInt(m, "id"),
                                ModelId = ReadString(m, "modelId"),
                                Label = m.TryGetProperty("label", out var ml) ? ml.GetString() : null,
                                Enabled = ReadBool(m, "enabled", true),
                                InCooldown = ReadBool(m, "inCooldown"),
                                CooldownUntil = ReadDate(m, "cooldownUntil"),
                                LastError = m.TryGetProperty("lastError", out var mle) ? mle.GetString() : null,
                                SuccessCount = ReadLong(m, "successCount"),
                                FailureCount = ReadLong(m, "failureCount")
                            });
                    list.Add(ui);
                }
            }
            _aiProviders = list;
            _aiProvidersLoaded = true;
        }
        catch
        {
            _aiProvidersMessage = "خطا در دریافت سرویس‌دهنده‌ها.";
            _aiProvidersOk = false;
        }
        _aiProvidersLoading = false;
