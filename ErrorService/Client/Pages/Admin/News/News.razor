@page "/admin/news"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.news.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using ErrorService.Client.Services
@using ErrorService.Client.Utils
@implements IDisposable
@inject IJSRuntime JS
@inject ToastService ToastService

<div class="admin-container" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="admin-page-title m-0">مدیریت اخبار و مقالات</h3>
        <button class="btn btn-primary shadow-sm rounded-3" @onclick="NewNews">
            <span class="oi oi-plus me-1"></span> خبر جدید
        </button>
    </div>

    <ConfirmDialog IsVisible="showConfirm" 
                   Title="حذف خبر" 
                   Message=@($"آیا از حذف خبر \"{itemToDelete?.Title}\" اطمینان دارید؟")
                   OnResult="HandleDeleteResult" />

    @if (showEditor)
    {
        <div class="card shadow-sm border-0 rounded-4 mb-4 p-4 animate__animated animate__fadeIn">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="m-0 fw-bold">@(editingId == 0 ? "ایجاد خبر جدید" : "ویرایش خبر")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>

            <EditForm Model="model" OnValidSubmit="SaveNews">
                <DataAnnotationsValidator />
                <div class="row g-4">
                    <div class="col-12">
                        <div class="mb-3">
                            <label class="form-label fw-bold">عنوان خبر</label>
                            <InputText @bind-Value="model.Title" class="form-control rounded-3" placeholder="عنوان جذاب انتخاب کنید..." />
                            <ValidationMessage For="@(() => model.Title)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">تاریخ و ساعت ایجاد</label>
                            <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="createdAtInput" />
                            <div class="text-muted small mt-1">در صورت خالی بودن، زمان فعلی ثبت می‌شود.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">خلاصه خبر (نمایش در لیست)</label>
                            <InputTextArea @bind-Value="model.Summary" class="form-control rounded-3" rows="2" placeholder="توضیح کوتاه برای جذب مخاطب..." />
                            <ValidationMessage For="@(() => model.Summary)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">نویسنده خبر</label>
                            <InputText @bind-Value="model.AuthorName" class="form-control rounded-3" placeholder="نام نویسنده..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">تگ‌ها (با کاما جدا کنید)</label>
                            <InputText @bind-Value="model.Tags" class="form-control rounded-3" placeholder="مثلاً: تکنولوژی، هوش مصنوعی، خبر" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">متن کامل خبر</label>
                            
                            <!-- Custom Formatting Buttons -->
                            <div class="d-flex flex-wrap gap-1 mb-2">
                                <button type="button" class="btn btn-sm btn-light border" @onclick='() => InsertHtml("<p>", "</p>", false)'>پاراگراف</button>
                                <select id="news-callout-selector" class="form-select form-select-sm" style="width: 170px;" @onchange="OnCalloutChanged">
                                    <option value="none">بدون باکس</option>
                                    <option value="info">باکس آبی</option>
                                    <option value="danger">باکس قرمز</option>
                                    <option value="success">باکس سبز</option>
                                    <option value="quote">نقل‌قول</option>
                                </select>
                                <button type="button" class="btn btn-sm btn-dark" @onclick='ExitBoxAndContinue'>خروج از باکس</button>
                                <label class="btn btn-sm btn-info mb-0 text-white">
                                    <span class="oi oi-image me-1"></span> عکس
                                    <InputFile OnChange="HandleInlineImageUpload" class="d-none" accept="image/*" />
                                </label>
                                <label class="btn btn-sm btn-secondary mb-0 text-white">
                                    <span class="oi oi-video me-1"></span> ویدیو
                                    <InputFile OnChange="HandleInlineVideoUpload" class="d-none" accept="video/*" />
                                </label>
                                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick='InsertVideoLink'>لینک ویدیو</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick='InsertTable'>جدول</button>
                                <div class="vr d-none d-sm-block"></div>
                                <div class="btn-group btn-group-sm" role="group" aria-label="Resize image">
                                    <button type="button" class="btn btn-outline-dark" @onclick='() => ResizeSelectedImage(25)'>25%</button>
                                    <button type="button" class="btn btn-outline-dark" @onclick='() => ResizeSelectedImage(50)'>50%</button>
                                    <button type="button" class="btn btn-outline-dark" @onclick='() => ResizeSelectedImage(75)'>75%</button>
                                    <button type="button" class="btn btn-outline-dark" @onclick='() => ResizeSelectedImage(100)'>100%</button>
                                </div>
                            </div>
                            
                            <div id="quill-editor-container" style="min-height: 400px; background: white;"></div>
                            <ValidationMessage For="@(() => model.Content)" class="text-danger small" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-4">
                            <label class="form-label fw-bold">تصویر شاخص</label>
                            <div class="image-upload-zone rounded-4 border-2 border-dashed d-flex flex-column align-items-center justify-content-center p-4 bg-light position-relative">
                                @if (!string.IsNullOrEmpty(model.ImageUrl))
                                {
                                    <img src="@model.ImageUrl" class="img-fluid rounded-3 mb-2" style="max-height: 200px;" />
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 rounded-circle shadow" @onclick="ClearImage">
                                        <span class="oi oi-x"></span>
                                    </button>
                                }
                                else
                                {
                                    <span class="oi oi-cloud-upload display-4 text-muted mb-2"></span>
                                    <InputFile OnChange="HandleFileUpload" class="position-absolute w-100 h-100 opacity-0" style="cursor: pointer; top: 0; left: 0;" />
                                    <span class="text-muted small text-center">برای انتخاب تصویر شاخص کلیک کنید</span>
                                }
                            </div>
                            @if (isUploading)
                            {
                                <div class="progress mt-2" style="height: 6px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                                </div>
                            }
                        </div>

                        <div class="card bg-light border-0 rounded-4 p-3">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="model.IsPublished" class="form-check-input" id="isPublished" />
                                <label class="form-check-label fw-bold" for="isPublished">انتشار در سایت</label>
                            </div>
                            <div class="text-muted small mt-1">در صورت غیرفعال بودن، خبر فقط در پنل ادمین نمایش داده می‌شود.</div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-light rounded-3 px-4" @onclick="CloseEditor">انصراف</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 shadow-sm" disabled="@(isSaving || isUploading)">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        ذخیره نهایی خبر
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4" style="width: 100px;">تصویر</th>
                        <th>عنوان خبر</th>
                        <th>تاریخ ایجاد</th>
                        <th>وضعیت</th>
                        <th class="text-end pe-4">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (newsList == null)
                    {
                        <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                    }
                    else if (!newsList.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">هیچ خبری یافت نشد.</td></tr>
                    }
                    else
                    {
                        @foreach (var news in newsList)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="news-thumb rounded-3 bg-light overflow-hidden" style="width: 60px; height: 60px;">
                                        @if (!string.IsNullOrEmpty(news.ImageUrl))
                                        {
                                            <img src="@news.ImageUrl" class="w-100 h-100 object-fit-cover" />
                                        }
                                        else
                                        {
                                            <div class="w-100 h-100 d-flex align-items-center justify-content-center text-muted bg-light border rounded-3">
                                                <span class="oi oi-image" style="font-size: 1.2rem; opacity: 0.5;"></span>
                                            </div>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold text-dark">@news.Title</div>
                                    <div class="small text-muted text-truncate" style="max-width: 300px;">@news.Summary</div>
                                </td>
                                <td><span class="text-muted small">@PersianDate.ToJalaliDateTime(news.CreatedAt)</span></td>
                                <td>
                                    <span class="badge @(news.IsPublished ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") rounded-pill px-3">
                                        @(news.IsPublished ? "منتشر شده" : "پیش‌نویس")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary border-0 rounded-circle me-1" @onclick="() => EditNews(news)" title="ویرایش">
                                        <span class="oi oi-pencil"></span>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" @onclick="() => ConfirmDelete(news)" title="حذف">
                                        <span class="oi oi-trash"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (newsList != null && newsList.Count < totalCount)
        {
            <div class="text-center p-3 border-top bg-light">
                <button class="btn btn-outline-primary btn-sm rounded-pill px-4" @onclick="() => LoadNews(true)" disabled="@isLoadingMore">
                    @if (isLoadingMore)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    مشاهده بیشتر (@(totalCount - newsList.Count) مورد باقی‌مانده)
                </button>
            </div>
        }
    </div>
</div>

<style>
