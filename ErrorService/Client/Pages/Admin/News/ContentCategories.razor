@page "/admin/content-categories"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.news.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>دسته‌بندی محتوا | ارورسرویس</PageTitle>

<div class="admin-container" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="admin-page-title m-0">دسته‌بندی مرکز محتوا</h3>
            <div class="text-muted small mt-1">دسته‌های مشترک بین اخبار، ترفندها و اطلاعیه‌ها یا مخصوص یک نوع محتوا.</div>
        </div>
        <div class="d-flex gap-2">
            <a href="/admin/news" class="btn btn-outline-secondary rounded-3">بازگشت به محتوا</a>
            <button class="btn btn-primary rounded-3" @onclick="NewCategory"><span class="oi oi-plus me-1"></span> دسته جدید</button>
        </div>
    </div>

    <ConfirmDialog IsVisible="showConfirm"
                   Title="حذف دسته"
                   Message=@($"آیا از حذف دسته «{itemToDelete?.Title}» اطمینان دارید؟")
                   OnResult="HandleDeleteResult" />

    @if (showEditor)
    {
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-3">
            <h5 class="fw-bold mb-3">@(editingId == 0 ? "دسته جدید" : "ویرایش دسته")</h5>
            <EditForm Model="model" OnValidSubmit="Save">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold">عنوان</label>
                        <InputText @bind-Value="model.Title" class="form-control rounded-3" />
                        <ValidationMessage For="@(() => model.Title)" class="text-danger small" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">نامک (اختیاری)</label>
                        <InputText @bind-Value="model.Slug" class="form-control rounded-3" placeholder="خودکار" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold">نوع محتوا</label>
                        <InputSelect @bind-Value="model.ContentType" class="form-select rounded-3">
                            <option value="">مشترک بین همه</option>
                            @foreach (var type in ContentTypeCatalog.All)
                            {
                                <option value="@type">@ContentTypeCatalog.PluralLabel(type)</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label small fw-bold">ترتیب</label>
                        <InputNumber @bind-Value="model.SortOrder" class="form-control rounded-3" />
                    </div>
                    <div class="col-md-1 d-flex align-items-end">
                        <div class="form-check form-switch mb-2">
                            <InputCheckbox @bind-Value="model.IsActive" class="form-check-input" id="catActive" />
                            <label class="form-check-label small" for="catActive">فعال</label>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-light rounded-3 px-4" @onclick="() => showEditor = false">انصراف</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4" disabled="@isSaving">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        ذخیره
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">عنوان</th>
                        <th>نامک</th>
                        <th>نوع</th>
                        <th>تعداد محتوا</th>
                        <th>ترتیب</th>
                        <th>وضعیت</th>
                        <th class="text-end pe-4">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (loading)
                    {
                        <tr><td colspan="7" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                    }
                    else if (!items.Any())
                    {
                        <tr><td colspan="7" class="text-center py-5 text-muted">دسته‌ای ثبت نشده است.</td></tr>
                    }
                    else
                    {
                        @foreach (var item in items)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Title</td>
                                <td><span class="small text-muted">@item.Slug</span></td>
                                <td>
                                    @if (item.ContentType.HasValue)
                                    {
                                        <span class="badge @ContentTypeCatalog.BadgeClass(item.ContentType.Value) rounded-pill">@ContentTypeCatalog.Label(item.ContentType.Value)</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill">مشترک</span>
                                    }
                                </td>
                                <td><span class="small">@item.ContentCount</span></td>
                                <td><span class="small">@item.SortOrder</span></td>
                                <td>
                                    <span class="badge @(item.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill">
                                        @(item.IsActive ? "فعال" : "غیرفعال")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <button class="btn btn-sm btn-outline-primary border-0 rounded-circle me-1" @onclick="() => Edit(item)" title="ویرایش">
                                        <span class="oi oi-pencil"></span>
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger border-0 rounded-circle" @onclick="() => ConfirmDelete(item)" title="حذف">
                                        <span class="oi oi-trash"></span>
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .admin-container { padding: 20px; }
</style>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ToastService ToastService { get; set; } = default!;

    private List<ContentCategoryDto> items = new();
    private ContentCategoryUpsertRequest model = new();
    private bool loading = true;
    private bool isSaving;
    private bool showEditor;
    private int editingId;
    private ContentCategoryDto? itemToDelete;
    private bool showConfirm;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            items = await Http.GetFromJsonAsync<List<ContentCategoryDto>>("api/content/categories/admin?includeInactive=true") ?? new();
        }
        catch
        {
            ToastService.ShowError("خطا در بارگذاری دسته‌بندی‌ها");
        }
        finally
        {
            loading = false;
        }
    }

    private void NewCategory()
    {
        editingId = 0;
        model = new ContentCategoryUpsertRequest { IsActive = true };
        showEditor = true;
    }

    private void Edit(ContentCategoryDto item)
    {
        editingId = item.Id;
        model = new ContentCategoryUpsertRequest
        {
            Title = item.Title,
            Slug = item.Slug,
            ContentType = item.ContentType,
            SortOrder = item.SortOrder,
            IsActive = item.IsActive
        };
        showEditor = true;
    }

    private async Task Save()
    {
        isSaving = true;
        try
        {
            var resp = editingId == 0
                ? await Http.PostAsJsonAsync("api/content/categories", model)
                : await Http.PutAsJsonAsync($"api/content/categories/{editingId}", model);

            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("دسته ذخیره شد");
                showEditor = false;
                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(await ReadErrorAsync(resp));
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ConfirmDelete(ContentCategoryDto item)
    {
        itemToDelete = item;
        showConfirm = true;
    }

    private async Task HandleDeleteResult(bool result)
    {
        showConfirm = false;
        if (!result || itemToDelete == null) return;

        try
        {
            var resp = await Http.DeleteAsync($"api/content/categories/{itemToDelete.Id}");
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("دسته حذف شد");
                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(await ReadErrorAsync(resp));
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally
        {
            itemToDelete = null;
        }
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage resp)
    {
        var text = await resp.Content.ReadAsStringAsync();
        return string.IsNullOrWhiteSpace(text) ? "عملیات ناموفق بود." : text.Trim('"');
    }
}
