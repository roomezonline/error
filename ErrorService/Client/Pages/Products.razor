@page "/products"
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Shared
@implements IDisposable
@inject ErrorService.Client.Services.CartService CartService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>فروشگاه ارورسرویس | لوازم الکترونیک، ابزار دقیق و تعمیرات تخصصی</PageTitle>

<SeoHeader
    Title="ارورسرویس | لوازم الکترونیک، ابزار دقیق و تعمیرات تخصصی"
    Description="فروشگاه تخصصی لوازم الکترونیک، قطعات الکترونیکی، بردهای آماده، تجهیزات ابزار دقیق، ابزارآلات تخصصی و ملزومات فنی با بهترین قیمت و ارسال سریع"
    Keywords="لوازم الکترونیک, قطعات الکترونیکی, ابزار دقیق, تجهیزات صنعتی, بردهای آماده, ابزارآلات تخصصی"
    CanonicalUrl="@BuildCanonicalUrl()"
    OgType="website" />

<section class="sp" dir="rtl">

    <nav class="sp-crumb d-none d-md-flex" aria-label="breadcrumb">
        <div class="container">
            <ol>
                <li><a href="/"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> خانه</a></li>
                <li class="active">فروشگاه</li>
            </ol>
        </div>
    </nav>

    <div class="container">

        <div class="sp-hero">
            <div class="sp-hero__slides">
                @for (int i = 0; i < heroSlides.Count; i++)
                {
                    var slide = heroSlides[i];
                    if (slide.Product != null)
                    {
                        var prod = slide.Product;
                        var heroDiscount = DiscountHelper.IsActive(prod);
                        <div class="sp-hero__slide sp-hero__slide--product @(currentSlide == i ? "is-active" : "")">
                            <div class="sp-hero__slide-bg" style="background:linear-gradient(135deg,@slide.Color1 0%,@slide.Color2 50%,@slide.Color3 100%)"></div>
                            <svg class="sp-hero__svg-deco sp-hero__svg-deco--1" viewBox="0 0 200 200" fill="none" stroke="white" stroke-width="1.5"><circle cx="100" cy="100" r="80"/><circle cx="100" cy="100" r="50"/><circle cx="100" cy="100" r="20"/><line x1="100" y1="20" x2="100" y2="180"/><line x1="20" y1="100" x2="180" y2="100"/></svg>
                            <svg class="sp-hero__svg-deco sp-hero__svg-deco--2" viewBox="0 0 120 120" fill="none" stroke="white" stroke-width="1.5"><rect x="20" y="20" width="80" height="80" rx="8"/><rect x="35" y="35" width="50" height="50" rx="4"/><circle cx="60" cy="60" r="12"/></svg>
                            <svg class="sp-hero__svg-deco sp-hero__svg-deco--3" viewBox="0 0 60 60" fill="none" stroke="white" stroke-width="1.5"><polygon points="30,5 55,20 55,50 30,55 5,50 5,20"/></svg>
                            <div class="sp-hero__slide-content">
                                <span class="sp-hero__badge">
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink:0"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
                                    @slide.Badge
                                </span>
                                <h1 class="sp-hero__title">@prod.Name</h1>
                                <p class="sp-hero__sub">@prod.CategoryName@(!string.IsNullOrWhiteSpace(prod.Sku) ? $" — کد: {prod.Sku}" : "")</p>
                                <div class="sp-hero__price">
                                    @if (heroDiscount)
                                    {
                                        <span class="sp-hero__chip"><svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>@DiscountHelper.CalculatePercent(prod)٪ تخفیف</span>
                                        <span class="sp-hero__price-old">@prod.Price.ToString("N0")</span>
                                        <span class="sp-hero__price-new">@DiscountHelper.GetEffectivePrice(prod).ToString("N0") <small>تومان</small></span>
                                    }
                                    else
                                    {
                                        <span class="sp-hero__price-new">@prod.Price.ToString("N0") <small>تومان</small></span>
                                    }
                                </div>
                                <div class="sp-hero__actions">
                                    <a class="sp-hero__btn sp-hero__btn--primary" href="@SeoUrl.Product(prod.Id, prod.Slug)">
                                        مشاهده محصول
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                                    </a>
                                    @if (prod.IsAvailable)
                                    {
                                        <button type="button" class="sp-hero__btn sp-hero__btn--ghost" @onclick="() => AddToCart(prod)">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                            افزودن به سبد
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="sp-hero__product">
                                <img class="sp-hero__product-img" src="@(string.IsNullOrEmpty(prod.MainImageUrl) ? "/images/placeholder-product.svg" : prod.MainImageUrl)" alt="@prod.Name" loading="lazy" />
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="sp-hero__slide @(currentSlide == i ? "is-active" : "")">
                            <div class="sp-hero__slide-bg" style="background:linear-gradient(135deg,@slide.Color1 0%,@slide.Color2 50%,@slide.Color3 100%)"></div>
                            <svg class="sp-hero__svg-deco sp-hero__svg-deco--1" viewBox="0 0 200 200" fill="none" stroke="white" stroke-width="1.5"><circle cx="100" cy="100" r="80"/><circle cx="100" cy="100" r="50"/><circle cx="100" cy="100" r="20"/><line x1="100" y1="20" x2="100" y2="180"/><line x1="20" y1="100" x2="180" y2="100"/></svg>
                            <svg class="sp-hero__svg-deco sp-hero__svg-deco--2" viewBox="0 0 120 120" fill="none" stroke="white" stroke-width="1.5"><rect x="20" y="20" width="80" height="80" rx="8"/><rect x="35" y="35" width="50" height="50" rx="4"/><circle cx="60" cy="60" r="12"/></svg>
                            <svg class="sp-hero__svg-deco sp-hero__svg-deco--3" viewBox="0 0 60 60" fill="none" stroke="white" stroke-width="1.5"><polygon points="30,5 55,20 55,50 30,55 5,50 5,20"/></svg>
                            <div class="sp-hero__slide-content">
                                <span class="sp-hero__badge">@((MarkupString)slide.Icon) @slide.Badge</span>
                                <h1 class="sp-hero__title">@slide.Title</h1>
                                <p class="sp-hero__sub">@slide.Sub</p>
                                <div class="sp-hero__tags">
                                    @foreach (var tag in slide.Tags)
                                    {
                                        <span class="sp-hero__tag">@((MarkupString)tag)</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="sp-hero__dots">
                @for (int i = 0; i < heroSlides.Count; i++)
                {
                    var idx = i;
                    <button class="sp-hero__dot @(currentSlide == idx ? "is-active" : "")" @onclick="() => GoToSlide(idx)" aria-label="اسلاید @(idx+1)"></button>
                }
            </div>
            <button class="sp-hero__nav sp-hero__nav--prev" @onclick="PrevSlide" aria-label="قبلی">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="sp-hero__nav sp-hero__nav--next" @onclick="NextSlide" aria-label="بعدی">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
        </div>

        @if (categories != null && categories.Any())
        {
            <div class="sp-subcats-wrap">
            <div class="sp-subcats">
                @foreach (var cat in categories.Take(10))
                {
                    <a href="/products?categoryId=@cat.Id" @key="cat.Id" class="sp-subcat @(selectedCategoryId == cat.Id ? "is-active" : "")" @onclick.preventsDefault="() => SelectCategory(cat.Id)">
                        <div class="sp-subcat__icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        </div>
                        <span class="sp-subcat__name">@cat.Name@(FacetCatSuffix(cat.Id))</span>
                    </a>
                }
                @if (selectedCategoryId.HasValue)
                {
                    <a href="/products" class="sp-subcat" @onclick.preventsDefault="() => SelectCategory(null)">
                        <div class="sp-subcat__icon sp-subcat__icon--all">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </div>
                        <span class="sp-subcat__name">حذف فیلتر</span>
                    </a>
                }
            </div>
            </div>
        }

        <div class="sp-filters">
            <button class="sp-filters__toggle d-lg-none" @onclick="() => showFilters = !showFilters">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                @(showFilters ? "پنهان کردن فیلترها" : "نمایش فیلترها")
            </button>
            <div class="sp-filters__body @(showFilters ? "" : "d-none d-lg-block")">
                <div class="sp-filters__top">
                    <div class="sp-search">
                        <svg class="sp-search__ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input class="sp-search__input" placeholder="جستجو در محصولات..." @bind="search" @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <button type="button" class="sp-search__clear" @onclick="ClearFilters" aria-label="پاک کردن">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        }
                    </div>
                    <div class="sp-tools">
                        <select class="sp-sort" @bind="sort">
                            <option value="">جدیدترین</option>
                            <option value="price_asc">ارزان‌ترین</option>
                            <option value="price_desc">گران‌ترین</option>
                            <option value="discount_desc">بیشترین تخفیف</option>
                            <option value="featured">ویژه و محبوب</option>
                            <option value="bestselling">پرفروش‌ترین</option>
                            <option value="manual">ترتیب دلخواه مدیر</option>
                        </select>
                        <label class="sp-toggle">
                            <input type="checkbox" @bind="onlyAvailable" />
                            <span>فقط موجود@(FacetSuffix(facets?.AvailableCount))</span>
                        </label>
                        <label class="sp-toggle">
                            <input type="checkbox" @bind="onlyDiscounted" />
                            <span>فقط تخفیف‌دار@(FacetSuffix(facets?.DiscountedCount))</span>
                        </label>
                        <button class="sp-btn-apply" @onclick="ApplyFilters">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                            اعمال
                        </button>
                        <button class="sp-btn-clear" @onclick="ClearFilters">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            پاک کردن
                        </button>
                    </div>
                </div>
                <div class="sp-price">
                    <div class="sp-price__box">
                        <label>حداقل قیمت (تومان)</label>
                        <div class="sp-price__input">
                            <input type="text" inputmode="numeric" value="@minPriceText" @oninput="OnMinPriceInput" placeholder="0" />
                            <span class="sp-price__unit">تومان</span>
                        </div>
                    </div>
                    <div class="sp-price__sep">تا</div>
                    <div class="sp-price__box">
                        <label>حداکثر قیمت (تومان)</label>
                        <div class="sp-price__input">
                            <input type="text" inputmode="numeric" value="@maxPriceText" @oninput="OnMaxPriceInput" placeholder="..." />
                            <span class="sp-price__unit">تومان</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="sp-meta">
            <div class="sp-meta__count">
                <span class="sp-meta__count-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                </span>
                <b>@totalCount</b> محصول
            </div>
            <div class="sp-meta__hint">برای یافتن سریع‌تر، از جستجو یا دسته‌بندی استفاده کنید</div>
        </div>

        @if (products == null)
        {
            <div class="row g-3 g-lg-4">
                @for (int i = 0; i < 12; i++)
                {
                    <div class="col-6 col-md-4 col-lg-3 col-xxl-2">
                        <div class="sp-sk">
                            <div class="sp-sk__img"></div>
                            <div class="sp-sk__line w40"></div>
                            <div class="sp-sk__line w80"></div>
                            <div class="sp-sk__line w50"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!products.Any())
        {
            <div class="sp-empty">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 15s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                <h4>محصولی یافت نشد</h4>
                <p>هیچ قطعه یا تجهیزاتی با فیلترهای انتخابی مطابقت ندارد.</p>
                <button class="sp-empty__btn" @onclick="ClearFilters">پاک کردن فیلترها</button>
            </div>
        }
        else
        {
            <div class="row g-3 g-lg-4">
                @for (int _i = 0; _i < products.Count; _i++)
                {
                    var prod = products[_i];
                    <div class="col-6 col-md-4 col-lg-3 col-xxl-2" @key="prod.Id">
                        <ProductCard Product="prod" Index="_i" ShowNewBadge="true"
                                     CountdownText="@(DiscountHelper.IsTimedActive(prod) ? GetCountdown(prod.Id) : null)" />
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="sp-pager" aria-label="صفحه‌بندی">
                    <button class="sp-pager__btn sp-pager__btn--nav" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                        قبلی
                    </button>
                    <div class="sp-pager__pages">
                        @foreach (var p in GetPageNumbers())
                        {
                            if (p == -1)
                            {
                                <span class="sp-pager__ellipsis">...</span>
                            }
                            else
                            {
                                <button class="sp-pager__btn @(p == currentPage ? "is-active" : "")" @onclick="() => GoToPage(p)">@p</button>
                            }
                        }
                    </div>
                    <button class="sp-pager__btn sp-pager__btn--nav" disabled="@(currentPage >= totalPages)" @onclick="() => GoToPage(currentPage + 1)">
                        بعدی
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                </nav>
            }
        }
    </div>
</section>


@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private List<ProductDto>? products;
    private List<CategoryDto>? categories;
    private int skip = 0;
    private int take = 50;
    private int totalCount = 0;
    private int currentPage = 1;
    private int totalPages = 1;

    private int? selectedCategoryId = null;
    private bool onlyAvailable = false;
    private ProductFacetsDto? facets;
    private bool onlyDiscounted = false;
    private string? search;
    private decimal? minPrice;
    private decimal? maxPrice;
    private string? sort;
    private bool showFilters = true;

    private static readonly string[] QueryKeys =
        ["categoryId", "search", "sort", "minPrice", "maxPrice", "onlyAvailable", "onlyDiscounted", "page"];
    private bool _initialized;

    private string minPriceText = "";
    private string maxPriceText = "";

    private System.Threading.Timer? timer;
    private Dictionary<int, string> countDowns = new();

    // Hero carousel
    private int currentSlide = 0;
    private System.Threading.Timer? slideTimer;
    private List<ProductDto> _featuredHero = new();
    private record HeroSlide(string Icon, string Badge, string Title, string Sub, string[] Tags, string Color1, string Color2, string Color3, ProductDto? Product = null);
    private List<HeroSlide> heroSlides = new();
    private static readonly List<HeroSlide> _defaultHeroSlides = new()
    {
        new("<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\"/></svg>",
            "فروشگاه تخصصی",
            "لوازم الکترونیک و تجهیزات صنعتی",
            "قطعات، بردهای آماده، ابزار دقیق و ابزارآلات تخصصی",
            new[] { "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"/><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/></svg> ارسال سریع",
            "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg> گارانتی اصالت",
            "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M22 11.08V12a10 10 0 11-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg> مشاوره تخصصی" },
            "#1e40af", "#1e3a8a", "#172554"),
        new("<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z\"/></svg>",
            "تعمیر تخصصی",
            "تعمیر برد و لوازم خانگی",
            "برد الکترونیکی، لوازم خانگی و تجهیزات صنعتی",
            new[] { "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M22 11.08V12a10 10 0 11-5.93-9.14\"/><polyline points=\"22 4 12 14.01 9 11.01\"/></svg> ضمانت تعمیر",
            "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg> سرعت بالا",
            "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg> قیمت منصفانه" },
            "#0f172a", "#1e293b", "#334155"),
        new("<svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z\"/><line x1=\"7\" y1=\"7\" x2=\"7.01\" y2=\"7\"/></svg>",
            "تخفیف‌های ویژه",
            "پیشنهادات ویژه",
            "فرصت محدود خرید قطعات و تجهیزات",
            new[] { "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><polyline points=\"12 6 12 12 16 14\"/></svg> فرصت محدود",
            "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z\"/></svg> ارسال سریع",
            "<svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\"><rect x=\"1\" y=\"4\" width=\"22\" height=\"16\" rx=\"2\" ry=\"2\"/><line x1=\"1\" y1=\"10\" x2=\"23\" y2=\"10\"/></svg> پرداخت امن" },
            "#1e40af", "#2563eb", "#3b82f6")
    };

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += HandleCartChanged;
        await LoadCategories();

        ApplyQueryToState();
        _initialized = true;

        await LoadProducts();
        await LoadFeaturedHeroAsync();
        BuildHeroSlides();
        currentSlide = 0;
        StartSlideTimer();
    }

    private async Task LoadFeaturedHeroAsync()
    {
        try
        {
            var items = await Http.GetFromJsonAsync<List<ProductDto>>(
                "api/products?featuredOnly=true&onlyAvailable=true&take=6");
            _featuredHero = items ?? new();
        }
        catch
        {
            _featuredHero = new();
        }
    }

    private void BuildHeroSlides()
    {
        if (_featuredHero.Count == 0)
        {
            heroSlides = new List<HeroSlide>(_defaultHeroSlides);
            return;
        }

        (string C1, string C2, string C3)[] palettes =
        [
            ("#1e3a8a", "#2563eb", "#60a5fa"),
            ("#0f172a", "#1e293b", "#475569"),
            ("#065f46", "#059669", "#34d399"),
            ("#581c87", "#7c3aed", "#a78bfa"),
            ("#b91c1c", "#dc2626", "#f87171")
        ];

        heroSlides = new List<HeroSlide>();
        for (int i = 0; i < _featuredHero.Count; i++)
        {
            var prod = _featuredHero[i];
            var palette = palettes[i % palettes.Length];
            heroSlides.Add(new HeroSlide(
                string.Empty,
                "محصول مهم فروشگاه",
                prod.Name,
                prod.CategoryName ?? string.Empty,
                Array.Empty<string>(),
                palette.C1,
                palette.C2,
                palette.C3,
                prod));
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // فقط وقتی ناوبری بیرونی رخ داده (لینک مستقیم، back/forward) فیلترها را
        // از URL می‌خوانیم؛ اگر با وضعیت فعلی یکسان باشد هیچ درخواستی نمی‌فرستیم.
        if (!_initialized || QueryMatchesState()) return;

        ApplyQueryToState();
        await LoadProducts();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("observeNewReveals"); } catch { }
        }
    }

    private void HandleCartChanged() => InvokeAsync(StateHasChanged);

    private void StartSlideTimer()
    {
        slideTimer?.Dispose();
        slideTimer = null;
        if (heroSlides.Count <= 1) return;

        slideTimer = new System.Threading.Timer(_ =>
        {
            if (heroSlides.Count == 0) return;
            currentSlide = (currentSlide + 1) % heroSlides.Count;
            InvokeAsync(StateHasChanged);
        }, null, 5000, 5000);
    }

    private void GoToSlide(int idx)
    {
        if (heroSlides.Count == 0) return;
        currentSlide = idx;
        StartSlideTimer();
    }

    private void PrevSlide()
    {
        if (heroSlides.Count == 0) return;
        currentSlide = (currentSlide - 1 + heroSlides.Count) % heroSlides.Count;
        StartSlideTimer();
    }

    private void NextSlide()
    {
        if (heroSlides.Count == 0) return;
        currentSlide = (currentSlide + 1) % heroSlides.Count;
        StartSlideTimer();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");
            categories ??= new();
        }
        catch
