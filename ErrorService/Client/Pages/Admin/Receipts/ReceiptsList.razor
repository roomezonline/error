    // متدهای کمکی برای تاریخ سال جاری شمسی
    private string GetCurrentYearStartDate()
    {
        // گرفتن سال جاری شمسی
        var persianCalendar = new System.Globalization.PersianCalendar();
        var now = DateTime.Now;
        int currentYear = persianCalendar.GetYear(now);

        // تنظیم printDateFrom به ابتدای سال جاری
        printDateFrom = $"{currentYear}/01/01";
        return printDateFrom;
    }

    private string GetCurrentYearEndDate()
    {
        // گرفتن سال جاری شمسی
        var persianCalendar = new System.Globalization.PersianCalendar();
        var now = DateTime.Now;
        int currentYear = persianCalendar.GetYear(now);

        // محاسبه آخرین روز سال (تشخیص کبیسه)
        int lastDay = (currentYear % 33 == 1 || currentYear % 33 == 2 || currentYear % 33 == 3 || currentYear % 33 == 29) ? 30 : 29;

        // تنظیم printDateTo به پایان سال جاری
        printDateTo = $"{currentYear}/12/{lastDay}";
        return printDateTo;
    }


