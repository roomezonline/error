@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using ErrorService.Shared
@using System.Text.Json
@using ErrorService.Client.Pages
@inject NavigationManager Nav
@inject HttpClient Http
@inject ErrorService.Client.Services.CartService CartService
@inject ErrorService.Client.Services.NotificationCenterService Notif
@inject ErrorService.Client.Services.ToastService ToastService
@inject ErrorService.Client.Services.ThemeService Theme
@inject ErrorService.Client.Services.LocalStorageService SearchStorage
@inject ErrorService.Client.Services.AuthService Auth
@inject ErrorService.Client.Services.CheckoutRecoveryService Recovery
@inject ErrorService.Client.Services.JwtAuthStateProvider AuthStateProvider
@inject IJSRuntime JS
@implements IDisposable

<div class="app-wrapper">
    <a href="#main-content" class="skip-link visually-hidden-focusable">پرش به محتوای اصلی</a>
    @if (!_isOnline && !_dismissedOfflineBanner)
    {
        <div class="offline-banner" @onclick="() => _dismissedOfflineBanner = true" role="alert">
            <span class="oi oi-warning me-2"></span>
            اتصال اینترنت قطع شده است. برخی امکانات ممکن است در دسترس نباشند.
            <button class="offline-banner-close" @onclick="() => _dismissedOfflineBanner = true" aria-label="بستن">×</button>
        </div>
    }
    @if (ResumeOrder is { } ro && ShowResume($"o:{ro.Id}:{ro.Status}"))
    {
        <div class="resume-banner" role="alert">
            <span class="resume-banner__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
            </span>
            <span class="resume-banner__text">
                <strong class="resume-banner__title">سفارش شما هنوز تکمیل نشده است</strong>
                <span class="resume-banner__sub">
                    سفارش <span dir="ltr">@ro.OrderNumber</span>
                    · @ro.TotalAmount.ToString("N0") تومان
                    · @ro.StatusLabel
                </span>
            </span>
            @if (ro.NeedsPayment && ro.MinutesToAutoCancel > 0)
            {
                <span class="resume-banner__timer">
                    <span class="oi oi-clock"></span>
                    تا لغو خودکار @ro.MinutesToAutoCancel دقیقه
                </span>
            }
            <a class="resume-banner__cta" href="@ro.ResumeUrl">
                @(ro.NeedsPayment ? "پرداخت و ادامه سفارش" : "مشاهده سفارش")
                <span class="oi oi-arrow-left"></span>
            </a>
            <button class="resume-banner__close" @onclick="() => DismissResume(ResumeOrderKey(ro))" aria-label="بستن">×</button>
        </div>
    }
    else if (ResumeCartCount > 0 && ShowResume($"c:{ResumeCartCount}"))
    {
        <div class="resume-banner" role="alert">
            <span class="resume-banner__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </span>
            <span class="resume-banner__text">
                <strong class="resume-banner__title">@ResumeCartCount کالا در سبد خرید شما مانده است</strong>
                <span class="resume-banner__sub">اطلاعات تکمیل سفارش ذخیره شده؛ از همان‌جا ادامه دهید.</span>
            </span>
            <a class="resume-banner__cta" href="/checkout">
                ادامه خرید
                <span class="oi oi-arrow-left"></span>
            </a>
            <button class="resume-banner__close" @onclick="() => DismissResume(ResumeCartKey(ResumeCartCount))" aria-label="بستن">×</button>
        </div>
    }
    @if (ShowInstallBanner)
    {
        <div class="pwa-banner" role="region" aria-label="نصب اپلیکیشن">
            <span class="pwa-banner__icon" aria-hidden="true">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12" /><path d="m7 10 5 5 5-5" /><path d="M5 21h14" /></svg>
            </span>
            <span class="pwa-banner__text">
                <strong class="pwa-banner__title">نصب اپ ارورسرویس روی گوشی</strong>
                <span class="pwa-banner__sub">
                    @if (_pwaIos && !_pwaInstallable)
                    {
                        <text>در سافاری دکمهٔ اشتراک‌گذاری و سپس «افزودن به صفحه اصلی» را بزنید.</text>
                    }
                    else
                    {
                        <text>سریع‌تر باز می‌شود و مثل یک اپ واقعی روی صفحه‌نما نصب می‌شود.</text>
                    }
                </span>
            </span>
            @if (!(_pwaIos && !_pwaInstallable))
            {
                <button type="button" class="pwa-banner__cta" @onclick="InstallPublicApp">
                    <span class="oi oi-download"></span> نصب
                </button>
            }
            <button type="button" class="pwa-banner__close" @onclick="DismissPublicInstall" aria-label="بستن">×</button>
        </div>
    }
    <div class="app-header-group">
    <header class="app-header">
        <div class="app-header-wrapper">
        @if (isNavigating)
        {
            <div class="nav-progress-bar"></div>
        }
        <div class="container app-header-inner px-3">
            <button class="hdr-menu-btn" @onclick="ToggleDrawer" aria-label="منوی اصلی">
                <span class="hdr-menu-icon"></span>
            </button>

            <span class="hdr-title" @onclick="GoHome">
                <span class="hdr-title__glow"></span>
                <span class="hdr-title__text">
                    ارورسرویس
                    <span class="hdr-title__snow">
                        <i></i><i></i><i></i><i></i><i></i><i></i><i></i><i></i>
                    </span>
                </span>
            </span>

            <button type="button" class="hdr-theme" @onclick="ToggleThemeAsync"
                    aria-label="@(Theme.IsDarkMode ? "روشن کردن نمایش" : "تاریک کردن نمایش")"
                    aria-pressed="@Theme.IsDarkMode"
                    title="@(Theme.IsDarkMode ? "حالت روشن" : "حالت تاریک")">
                @if (Theme.IsDarkMode)
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="4" />
                        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
                    </svg>
                }
                else
                {
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
                    </svg>
                }
            </button>

            <a href="/cart" class="hdr-cart" aria-label="سبد خرید">
                <svg class="hdr-cart__icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
                @if (CartService.GetTotalCount() > 0)
                {
                    <span class="hdr-cart__badge">@CartService.GetTotalCount()</span>
                }
            </a>

            <AuthorizeView>
                <Authorized>
                    <div class="hdr-bell-wrap">
                        <button type="button" class="hdr-bell" @onclick="ToggleNotifPanel" @onclick:stopPropagation aria-label="اعلان‌ها">
                            <span class="oi oi-bell"></span>
                            @if (Notif.UnreadCount > 0)
                            {
                                <span class="hdr-bell__badge">@(Notif.UnreadCount > 99 ? "99+" : Notif.UnreadCount.ToString())</span>
                            }
                        </button>
                        @if (showNotifPanel)
                        {
                            <div class="notif-overlay" @onclick="CloseNotifPanel"></div>
                            <div class="notif-panel" @onclick:stopPropagation>
                                <div class="notif-panel__head">
                                    <span class="notif-panel__title"><span class="oi oi-bell"></span> اعلان‌ها</span>
                                    @if (Notif.UnreadCount > 0)
                                    {
                                        <button type="button" class="notif-panel__readall" @onclick="MarkAllReads">خواندن همه</button>
                                    }
                                </div>
                                <div class="notif-panel__list">
                                    @if (Notif.Recent.Count == 0)
                                    {
                                        <div class="notif-panel__empty">اعلانی وجود ندارد.</div>
                                    }
                                    else
                                    {
                                        @foreach (var item in Notif.Recent)
                                        {
                                            <button type="button" class="notif-mini @(item.IsRead ? "is-read" : "")" @onclick="() => OpenNotif(item)">
                                                <span class="notif-mini__dot" style="@SeverityDotStyle(item.Severity)"></span>
                                                <span class="notif-mini__body">
                                                    <span class="notif-mini__title">@item.Title</span>
                                                    <span class="notif-mini__desc">@item.Body</span>
                                                    <span class="notif-mini__time">@ErrorService.Client.Services.NotificationCenterService.RelativeTime(item.CreatedAt)</span>
                                                </span>
                                            </button>
                                        }
                                    }
                                </div>
                                <div class="notif-panel__foot">
                                    <a href="/profile#notifications" @onclick="CloseNotifPanel">مشاهده همه اعلان‌ها</a>
                                </div>
                            </div>
                        }
                    </div>
                    <div class="hdr-avatar-wrap">
                        <div class="hdr-avatar" @onclick="ToggleUserMenu" @onclick:stopPropagation>
                            @context.User.Identity?.Name?[0]
                        </div>
                    </div>
                    @if (showUserMenu)
                    {
                        <div class="hdr-usermenu" @onclick:stopPropagation>
                            <div class="hdr-usermenu__head">
                                <div class="hdr-usermenu__avatar">@context.User.Identity?.Name?[0]</div>
                                <div>
                                    <div class="hdr-usermenu__name">@context.User.Identity?.Name</div>
                                </div>
                            </div>
                            <div class="hdr-usermenu__body">
                                <a class="hdr-usermenu__item" href="/profile" @onclick="ToggleUserMenu">
                                    <span class="oi oi-person"></span> پروفایل
                                </a>
                                <AuthorizeView Policy="perm:admin.access" Context="adminCtx">
                                    <a class="hdr-usermenu__item" href="/admin" @onclick="ToggleUserMenu">
                                        <span class="oi oi-dashboard"></span> پنل مدیریت
                                    </a>
                                </AuthorizeView>
                                <div class="hdr-usermenu__divider"></div>
                                <button class="hdr-usermenu__item hdr-usermenu__item--danger" @onclick="HandleLogout">
                                    <span class="oi oi-account-logout"></span> خروج
                                </button>
                            </div>
                        </div>
                    }
                </Authorized>
                <NotAuthorized>
                    <a href="/auth/login" class="hdr-login-btn">ورود</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>
        </div>
    </header>

    <MegaMenu />

    <div class="app-search-bar">
        <div class="search-input-wrapper position-relative">
            <span class="oi oi-magnifying-glass search-icon position-absolute top-50 translate-middle-y" aria-hidden="true"></span>
            <input type="text" class="form-control app-search-input" 
                   placeholder="جستجو در محصولات، کدهای خطا و آموزش‌ها..." 
                   aria-label="جستجو"
                   value="@searchQuery"
                   @oninput="HandleSearchInput"
                   @onkeyup="HandleSearchKeyUp"
                   @onfocus="ShowSuggestions" />

            @if (showSuggestions)
            {
                <div class="search-suggest shadow-lg">
                    @if (string.IsNullOrWhiteSpace(searchQuery) || searchQuery.Trim().Length < 2)
                    {
                        <div class="search-discovery">
                            <div class="search-discovery__head">
                                <span class="search-discovery__title"><span class="oi oi-magnifying-glass"></span> جست‌وجوهای پیشنهادی</span>
                                @if (recentSearches.Count > 0)
                                {
                                    <button type="button" class="search-clear-btn" @onclick="ClearRecentSearches">پاک کردن سابقه</button>
                                }
                            </div>
                            @if (recentSearches.Count > 0)
                            {
                                <div class="search-chip-section">
                                    <div class="search-chip-title"><span class="oi oi-clock"></span> جست‌وجوهای اخیر</div>
                                    <div class="search-chips">
                                        @foreach (var item in recentSearches)
                                        {
                                            <button type="button" class="search-chip search-chip--recent" @onclick="() => SearchFromChip(item)">
                                                <span>@item</span><span class="oi oi-arrow-top-right"></span>
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                            <div class="search-chip-section">
                                <div class="search-chip-title"><span class="oi oi-fire"></span> برترین جست‌وجوها</div>
                                <div class="search-chips">
                                    @foreach (var item in popularSearches)
                                    {
                                        <button type="button" class="search-chip" @onclick="() => SearchFromChip(item)">
                                            <span>@item</span><span class="oi oi-arrow-top-right"></span>
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="search-discovery__hint">برای جست‌وجوی دقیق‌تر، نام محصول، برند یا کد خطا را وارد کنید.</div>
                        </div>
                    }
                    else if (isSearching && suggestions == null)
                    {
                        <div class="p-3 text-center text-muted small">
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            در حال جستجو...
                        </div>
                    }
                    else if (suggestions == null || !HasAnySuggestions)
                    {
                        <div class="p-3 text-center text-muted small">نتیجه‌ای یافت نشد</div>
                    }
                    else
                    {
                        @if (isSearching)
                        {
                            <div class="suggest-progress"></div>
                        }

                        @if (suggestions.Products.Any())
                        {
                            <div class="suggest-section">
                                <div class="suggest-title">محصولات</div>
                                @foreach (var item in suggestions.Products.Take(5))
                                {
                                    <button type="button" class="suggest-item" @onclick="() => NavigateToSuggestion(item.Url)">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img class="suggest-thumb" src="@item.ImageUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="oi oi-box suggest-ico text-success"></span>
                                        }
                                        <span class="suggest-meta">
                                            <span class="suggest-item-title">@item.Title</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                            {
                                                <span class="suggest-item-sub">@item.Subtitle</span>
                                            }
                                        </span>
                                        <span class="oi oi-chevron-left text-muted" style="font-size:0.75rem;flex-shrink:0;"></span>
                                    </button>
                                }
                            </div>
                        }

                        @if (suggestions.ErrorCodes.Any())
                        {
                            <div class="suggest-section">
                                <div class="suggest-title">کدهای خطا</div>
                                @foreach (var item in suggestions.ErrorCodes.Take(5))
                                {
                                    <button type="button" class="suggest-item" @onclick="() => NavigateToSuggestion(item.Url)">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img class="suggest-thumb" src="@item.ImageUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="oi oi-warning suggest-ico text-warning"></span>
                                        }
                                        <span class="suggest-meta">
                                            <span class="suggest-item-title">@item.Title</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                            {
                                                <span class="suggest-item-sub">@item.Subtitle</span>
                                            }
                                        </span>
                                        <span class="oi oi-chevron-left text-muted" style="font-size:0.75rem;flex-shrink:0;"></span>
                                    </button>
                                }
                            </div>
                        }

                        @if (suggestions.Courses.Any())
                        {
                            <div class="suggest-section">
                                <div class="suggest-title">آموزش‌ها</div>
                                @foreach (var item in suggestions.Courses.Take(5))
                                {
                                    <button type="button" class="suggest-item" @onclick="() => NavigateToSuggestion(item.Url)">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img class="suggest-thumb" src="@item.ImageUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="oi oi-book suggest-ico text-primary"></span>
                                        }
                                        <span class="suggest-meta">
                                            <span class="suggest-item-title">@item.Title</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                            {
                                                <span class="suggest-item-sub">@item.Subtitle</span>
                                            }
                                        </span>
                                        <span class="oi oi-chevron-left text-muted" style="font-size:0.75rem;flex-shrink:0;"></span>
                                    </button>
                                }
                            </div>
                        }

                        @if (suggestions.News.Any())
                        {
                            <div class="suggest-section">
                                <div class="suggest-title">اخبار</div>
                                @foreach (var item in suggestions.News.Take(5))
                                {
                                    <button type="button" class="suggest-item" @onclick="() => NavigateToSuggestion(item.Url)">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img class="suggest-thumb" src="@item.ImageUrl" alt="" loading="lazy" />
                                        }
                                        else
                                        {
                                            <span class="oi oi-news suggest-ico text-danger"></span>
                                        }
                                        <span class="suggest-meta">
                                            <span class="suggest-item-title">@item.Title</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                            {
                                                <span class="suggest-item-sub">@item.Subtitle</span>
                                            }
                                        </span>
                                        <span class="oi oi-chevron-left text-muted" style="font-size:0.75rem;flex-shrink:0;"></span>
                                    </button>
                                }
                            </div>
                        }

                        <div class="suggest-footer">
                            <div class="small text-muted">برای نتایج بیشتر Enter بزنید</div>
                            <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" @onclick="GoToFullSearch">مشاهده همه</button>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (showSuggestions)
    {
        <div class="search-suggest-overlay" @onclick="HideSuggestions"></div>
    }

    </div> @* app-header-group *@

    <main class="app-main" id="main-content">
        <div class="page-content">
            <GlobalBreadcrumb />
            @Body
        </div>
    </main>

    <nav class="app-bottom-nav @(_hideBottomNav ? "d-none" : "")">
        <NavLink href="/" class="nav-item" Match="NavLinkMatch.All" ActiveClass="active">
            <span class="oi oi-home"></span>
            <span class="nav-label">خانه</span>
        </NavLink>
        <NavLink href="/products" class="nav-item" ActiveClass="active">
            <span class="oi oi-box"></span>
            <span class="nav-label">فروشگاه</span>
        </NavLink>
        <NavLink href="/academy" class="nav-item" ActiveClass="active">
            <span class="oi oi-book"></span>
            <span class="nav-label">آکادمی</span>
        </NavLink>
        <NavLink href="/profile" class="nav-item" ActiveClass="active">
            <span class="oi oi-person"></span>
            <span class="nav-label">پروفایل</span>
        </NavLink>
    </nav>

    <QuickViewModal />
    <MiniCartDrawer />
    <CompareBar />

    @if (_showChat)
    {
        <ChatWidget />
    }

    @if (showDrawer)
    {
        <div class="drawer-overlay" @onclick="ToggleDrawer"></div>
        <div class="app-drawer animate__animated animate__slideInRight">
            <div class="drawer-header p-4 border-bottom d-flex justify-content-between align-items-center">
                <h5 class="m-0 fw-bold">منوی دسترسی</h5>
                <button class="btn-close" @onclick="ToggleDrawer"></button>
            </div>
            <div class="drawer-body p-0">
                <div class="drawer-theme">
                    <span class="drawer-theme__label"><span class="oi oi-contrast" aria-hidden="true"></span> حالت نمایش</span>
                    <button type="button" class="theme-switch @(Theme.IsDarkMode ? "is-on" : "")"
                            @onclick="ToggleThemeAsync" role="switch" aria-checked="@Theme.IsDarkMode"
                            aria-label="تغییر حالت تاریک و روشن">
                        <span class="theme-switch__knob"></span>
                    </button>
                </div>
                <div class="list-group list-group-flush py-2">
                    <AuthorizeView Policy="perm:admin.access">
                        <div class="px-4 py-2 small fw-bold text-primary">بخش مدیریت</div>
                        <a href="/admin" class="list-group-item list-group-item-action border-0 py-3 px-4 d-flex align-items-center gap-3" @onclick="ToggleDrawer">
                            <div class="drawer-icon text-primary bg-primary-subtle"><span class="oi oi-dashboard"></span></div>
                            <span class="fw-bold">پنل مدیریت (داشبورد)</span>
                        </a>

                        <AuthorizeView Policy="perm:security.roles.manage" Context="inner">
                            <a href="/admin/roles" class="list-group-item list-group-item-action border-0 py-3 px-4 d-flex align-items-center gap-3" @onclick="ToggleDrawer">
                                <div class="drawer-icon text-dark bg-light border"><span class="oi oi-shield"></span></div>
                                <span class="fw-bold">مدیریت نقش‌ها</span>
                            </a>
                        </AuthorizeView>
                        <hr class="mx-4 opacity-10" />
                    </AuthorizeView>

                    <div class="px-4 pt-3 pb-2">
                        <a href="/commitment" class="rl-commitment-drawer-btn" @onclick="ToggleDrawer">
                            <span class="rl-commitment-drawer-icon"><span class="oi oi-document-text"></span></span>
                            <div>
                                <div class="rl-commitment-drawer-title">تعهدنامه دیجیتال</div>
                                <div class="rl-commitment-drawer-desc">امضای دیجیتال تعهدنامه</div>
                            </div>
                            <span class="rl-commitment-drawer-arrow"><span class="oi oi-chevron-left"></span></span>
                        </a>
                    </div>
                    <hr class="mx-4 opacity-10" />

                    <AuthorizeView Context="auth">
