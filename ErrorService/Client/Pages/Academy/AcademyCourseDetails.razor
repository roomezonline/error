@page "/academy/{CourseId:int}"
@page "/academy/{Slug}"
@using ErrorService.Shared
@using System.Net.Http.Json
@using System.Text.Json
@inject NavigationManager NavigationManager

<PageTitle>@(course?.Title ?? "دوره آموزشی") - ارورسرویس</PageTitle>

<div class="course-details-page py-5 bg-white" dir="rtl">
    <div class="container">
        @if (course == null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else
        {
            <SeoHeader 
                Title="@($"{course.Title} | دوره آموزشی | ارور سرویس")" 
                Description="@(string.IsNullOrEmpty(course.Summary) ? $"شرکت در دوره آموزشی {course.Title} در آکادمی ارور سرویس" : (course.Summary.Length > 160 ? course.Summary.Substring(0, 157) + "..." : course.Summary))"
                OgType="video.movie"
                OgImage="@(course.CoverImageUrl ?? "/images/og-default.jpg")"
                JsonLd="@courseJsonLd" />

            <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/academy">آکادمی</a></li>
                    <li class="breadcrumb-item active">@course.Title</li>
                </ol>
            </nav>

            <div class="row g-5">
                <div class="col-lg-8">
                    <div class="course-hero rounded-5 overflow-hidden shadow-sm mb-5 position-relative">
                        <img src="@(string.IsNullOrEmpty(course.CoverImageUrl) ? "/images/placeholder-product.svg" : course.CoverImageUrl)" 
                             class="img-fluid w-100" style="max-height: 400px; object-fit: cover;" alt="@course.Title" />
                        @if (course.IsPremium)
                        {
                            <div class="position-absolute top-0 end-0 m-4">
                                <span class="badge bg-warning text-dark rounded-pill px-4 py-2 fs-6 shadow">ویژه (VIP)</span>
                            </div>
                        }
                    </div>

                    <h1 class="fw-bold mb-4">@course.Title</h1>
                    <div class="course-description fs-5 text-muted mb-5 leading-relaxed">
                        @course.Summary
                    </div>

                    <div class="lessons-section mt-5">
                        <h2 class="fw-bold h4 mb-4 d-flex align-items-center gap-2">
                            <span class="oi oi-list text-primary"></span>
                            سرفصل‌های آموزشی
                        </h2>
                        
                        @if (lessons == null)
                        {
                            <div class="text-center p-4">
                                <div class="spinner-border spinner-border-sm text-primary"></div>
                            </div>
                        }
                        else if (!lessons.Any())
                        {
                            <div class="alert alert-info rounded-4 border-0 shadow-sm">
                                هنوز قسمتی برای این دوره منتشر نشده است.
                            </div>
                        }
                        else
                        {
                            <div class="list-group list-group-flush border-0 shadow-sm rounded-4 overflow-hidden">
                                @foreach (var lesson in lessons)
                                {
                                    <a href="@SeoUrl.Lesson(course.Id, lesson.Id)" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between p-4 border-0 @(lesson.IsPremium ? "bg-light-premium" : "")">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="lesson-number d-flex align-items-center justify-content-center rounded-circle bg-primary text-white fw-bold shadow-sm" style="width: 32px; height: 32px; font-size: 0.9rem;">
                                                @lesson.SortOrder
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark fs-6">@lesson.Title</div>
                                                @if (!string.IsNullOrEmpty(lesson.Summary))
                                                {
                                                    <div class="small text-muted mt-1">@lesson.Summary</div>
                                                }
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-3">
                                            @if (course?.IsPremium == true)
                                            {
                                                if (lesson.IsPremium)
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-3">ویژه</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-info-subtle text-info border border-info rounded-pill px-3">رایگان</span>
                                                }
                                            }
                                            else if (lesson.IsPremium)
                                            {
                                                <span class="badge bg-warning-subtle text-warning border border-warning rounded-pill px-3">ویژه</span>
                                            }
                                            <span class="oi oi-chevron-left text-muted small"></span>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="sticky-top" style="top: 100px;">
                        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4 bg-light">
                            <h5 class="fw-bold mb-4">ویژگی‌های این دوره</h5>
                            <ul class="list-unstyled mb-0 d-grid gap-3">
                                <li class="d-flex align-items-center gap-2">
                                    <span class="oi oi-circle-check text-success"></span>
                                    <span>دسترسی دائمی به محتوا</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <span class="oi oi-circle-check text-success"></span>
                                    <span>فایل‌های ضمیمه آموزشی</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <span class="oi oi-circle-check text-success"></span>
                                    <span>پشتیبانی توسط مدرس</span>
                                </li>
                                <li class="d-flex align-items-center gap-2">
                                    <span class="oi oi-clock text-primary"></span>
                                    <span>@lessons?.Count قسمت آموزشی</span>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .breadcrumb-item + .breadcrumb-item::before { content: "\e014"; font-family: 'Icons'; font-size: 0.7rem; color: #adb5bd; }
    .list-group-item { transition: background-color 0.2s ease; border-bottom: 1px solid rgba(0,0,0,0.05) !important; }
    .list-group-item:last-child { border-bottom: 0 !important; }
    .list-group-item:hover { background-color: rgba(13,110,253,0.04); }
    .bg-light-premium { background-color: rgba(255,193,7,0.03); }
    .bg-warning-subtle { background-color: #fff3cd; }
    .leading-relaxed { line-height: 1.8; }
</style>

@code {
    [Parameter] public int? CourseId { get; set; }
    [Parameter] public string? Slug { get; set; }
    [Inject] private HttpClient HttpApi { get; set; } = default!;
    private TrainingCourseDto? course;
    private List<TrainingLessonDto>? lessons;
    private string? courseJsonLd;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            TrainingCourseDto? loaded = null;
            var effectiveId = CourseId;

            if (!string.IsNullOrEmpty(Slug))
            {
                loaded = await HttpApi.GetFromJsonAsync<TrainingCourseDto>($"api/trainings/courses/slug/{Uri.EscapeDataString(Slug)}");
            }
            else if (CourseId.HasValue)
            {
                loaded = await HttpApi.GetFromJsonAsync<TrainingCourseDto>($"api/trainings/courses/{CourseId}");
                if (loaded != null && !string.IsNullOrEmpty(loaded.Slug))
                {
                    NavigationManager.NavigateTo(SeoUrl.Course(loaded.Id, loaded.Slug), replace: true);
                }
            }

            course = loaded;
            effectiveId = course?.Id ?? CourseId;
            lessons = effectiveId.HasValue
                ? await HttpApi.GetFromJsonAsync<List<TrainingLessonDto>>($"api/trainings/courses/{effectiveId}/lessons?onlyPublished=true")
                : null;

            if (course != null)
            {
                courseJsonLd = BuildCourseJsonLd(course);
            }
        }
        catch { }
    }

    private string BuildCourseJsonLd(TrainingCourseDto course)
    {
        var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
        var courseSchema = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Course",
            ["name"] = course.Title,
            ["description"] = course.Summary ?? course.Title,
            ["url"] = $"{baseUrl}{SeoUrl.Course(course.Id, course.Slug)}",
            ["provider"] = new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = "ارور سرویس",
                ["url"] = baseUrl
            },
            ["isAccessibleForFree"] = !course.IsPremium
        };

        if (!string.IsNullOrEmpty(course.CoverImageUrl))
        {
            courseSchema["image"] = course.CoverImageUrl;
        }

        if (course.LessonsCount > 0)
        {
            courseSchema["numberOfLessons"] = course.LessonsCount;
        }

        var breadcrumb = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new List<object>
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = baseUrl },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "آکادمی", ["item"] = $"{baseUrl}/academy" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = course.Title }
            }
        };

        return JsonSerializer.Serialize(new object[] { courseSchema, breadcrumb });
    }
}
