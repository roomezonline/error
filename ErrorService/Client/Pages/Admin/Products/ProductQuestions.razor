@page "/admin/product-questions"
@page "/admin/product-questions/{ProductId:int}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.products.manage")]
@using System.Net.Http.Json
@using ErrorService.Shared
@using ErrorService.Client.Services
@inject HttpClient Http
@inject ToastService ToastService

<PageTitle>پرسش و پاسخ محصولات | ارورسرویس</PageTitle>

<ConfirmDialog IsVisible="_showConfirm"
               Title="@(_deleteReplyId is not null ? "حذف پاسخ" : "حذف پرسش")"
               Message="@(_deleteReplyId is not null ? "این پاسخ کاربر برای همیشه حذف شود؟" : "این پرسش برای همیشه حذف شود؟")"
               OnResult="HandleDeleteResult" />

<div class="qp-page" dir="rtl">
    @* ======================== HEADER ======================== *@
    <div class="qp-header">
        <div class="qp-head-main">
            @if (IsDetail)
            {
                <a class="qp-back" href="/admin/product-questions">
                    <span class="oi oi-arrow-right"></span> بازگشت به فهرست محصولات
                </a>
                <h1 class="qp-title">@(string.IsNullOrWhiteSpace(_detailTitle) ? "پرسش‌های محصول" : _detailTitle)</h1>
                <p class="qp-sub">پرسش‌های ثبت‌شده توسط مشتریان برای همین محصول.</p>
            }
            else
            {
                <h1 class="qp-title">پرسش و پاسخ محصولات</h1>
                <p class="qp-sub">پرسش‌های مشتریان دسته‌بندی‌شده بر اساس محصول؛ روی هر محصول کلیک کنید تا پرسش‌های همان محصول باز شود.</p>
            }
        </div>

        <div class="qp-header-actions">
            @if (IsIndex)
            {
                <span class="qp-badge qp-badge--indigo">@IndexTotal پرسش</span>
                @if (IndexUnread > 0)
                {
                    <span class="qp-badge qp-badge--blue">@IndexUnread خوانده‌نشده</span>
                }
                <button class="qp-btn qp-btn--ghost" @onclick="MarkAllRead" disabled="@_busy || IndexUnread == 0">
                    <span class="oi oi-check"></span> همه خوانده‌شدند
                </button>
            }
            else
            {
                @if (_detailTotal.HasValue)
                {
                    <span class="qp-badge qp-badge--indigo">@(_items.Count) از @(_detailTotal) پرسش</span>
                }
                else
                {
                    <span class="qp-badge qp-badge--indigo">@(_items.Count) پرسش</span>
                }
                <a class="qp-btn qp-btn--ghost" href="@ProductSiteUrl" target="_blank" rel="noopener">
                    <span class="oi oi-external-link"></span> مشاهده در سایت
                </a>
            }

            <button class="qp-btn qp-btn--primary" @onclick="Refresh" disabled="@(_loadingIndex || _loadingDetail)">
                @if (_loadingIndex || _loadingDetail)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <span class="oi oi-reload"></span>
                }
                بروزرسانی
            </button>
        </div>
    </div>

    @if (IsIndex)
    {
        @* ======================== INDEX : KPI ======================== *@
        <div class="qp-kpis">
            <div class="qp-kpi">
                <div class="qp-kpi__ic qp-kpi__ic--indigo"><span class="oi oi-chat"></span></div>
                <div class="qp-kpi__b">
                    <div class="qp-kpi__v">@IndexTotal</div>
                    <div class="qp-kpi__l">کل پرسش‌ها</div>
                </div>
            </div>
            <div class="qp-kpi">
                <div class="qp-kpi__ic qp-kpi__ic--amber"><span class="oi oi-hourglass"></span></div>
                <div class="qp-kpi__b">
                    <div class="qp-kpi__v">@IndexUnanswered</div>
                    <div class="qp-kpi__l">بدون پاسخ</div>
                </div>
            </div>
            <div class="qp-kpi">
                <div class="qp-kpi__ic qp-kpi__ic--rose"><span class="oi oi-eye-off"></span></div>
                <div class="qp-kpi__b">
                    <div class="qp-kpi__v">@IndexPending</div>
                    <div class="qp-kpi__l">تاییدنشده</div>
                </div>
            </div>
            <div class="qp-kpi">
                <div class="qp-kpi__ic qp-kpi__ic--sky"><span class="oi oi-envelope-closed"></span></div>
                <div class="qp-kpi__b">
                    <div class="qp-kpi__v">@IndexUnread</div>
                    <div class="qp-kpi__l">خوانده‌نشده</div>
                </div>
            </div>
        </div>

        @* ======================== INDEX : TOOLBAR ======================== *@
        <div class="qp-toolbar">
            <div class="qp-chips">
                <button class="qp-chip @(_filter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>
                    همه محصولات <span class="qp-chip-count">@(_products.Count)</span>
                </button>
                <button class="qp-chip @(_filter == "unread" ? "active" : "")" @onclick='() => SetFilter("unread")'>
                    دارای جدید <span class="qp-chip-count">@_products.Count(p => p.UnreadCount > 0)</span>
                </button>
                <button class="qp-chip @(_filter == "unanswered" ? "active" : "")" @onclick='() => SetFilter("unanswered")'>
                    دارای بدون پاسخ <span class="qp-chip-count">@_products.Count(p => p.UnansweredCount > 0)</span>
                </button>
                <button class="qp-chip @(_filter == "pending" ? "active" : "")" @onclick='() => SetFilter("pending")'>
                    دارای تاییدنشده <span class="qp-chip-count">@_products.Count(p => p.PendingCount > 0)</span>
                </button>
            </div>
            <div class="qp-search-wrap">
                <span class="oi oi-magnifying-glass qp-search-ic"></span>
                <input type="text" class="qp-search" placeholder="جستجوی نام محصول یا متن پرسش..."
                       value="@_search" @oninput="OnIndexSearchInput" />
            </div>
        </div>

        @* ======================== INDEX : BODY ======================== *@
        @if (_loadingIndex)
        {
            <div class="qp-loading">
                <div class="spinner-border text-primary"></div>
                <p>در حال دریافت محصولات...</p>
            </div>
        }
        else if (!ProductList.Any())
        {
            <div class="qp-empty">
                <div class="qp-empty-icon"><span class="oi oi-package"></span></div>
                <h5>محصولی یافت نشد</h5>
                <p>@(!string.IsNullOrWhiteSpace(_search) ? "جستجوی دیگری امتحان کنید." : "هنوز پرسشی برای هیچ محصولی ثبت نشده است.")</p>
            </div>
        }
        else
        {
            <div class="qp-products">
                @foreach (var p in ProductList)
                {
                    <a class="qp-pcard" href="/admin/product-questions/@p.ProductId">
                        <div class="qp-pcard__media">
                            @if (!string.IsNullOrWhiteSpace(p.ProductImageUrl))
                            {
                                <img src="@p.ProductImageUrl" alt="@p.ProductTitle" loading="lazy" decoding="async" />
                            }
                            else
                            {
                                <div class="qp-pcard__ph">@GetInitials(p.ProductTitle)</div>
                            }
                            @if (p.UnreadCount > 0)
                            {
                                <span class="qp-pcard__dot" title="@p.UnreadCount پرسش خوانده‌نشده"></span>
                            }
                        </div>

                        <div class="qp-pcard__body">
                            <div class="qp-pcard__title">@p.ProductTitle</div>

                            <div class="qp-pcard__stats">
                                <span class="qp-st qp-st--total"><b>@p.TotalCount</b> پرسش</span>
                                @if (p.UnansweredCount > 0)
                                {
                                    <span class="qp-st qp-st--warn"><b>@p.UnansweredCount</b> بدون پاسخ</span>
                                }
                                @if (p.PendingCount > 0)
                                {
                                    <span class="qp-st qp-st--danger"><b>@p.PendingCount</b> پنهان</span>
                                }
                                @if (p.UnreadCount > 0)
                                {
                                    <span class="qp-st qp-st--info"><b>@p.UnreadCount</b> جدید</span>
                                }
                            </div>

                            <div class="qp-pcard__foot">
                                <span class="qp-pcard__date"><span class="oi oi-clock"></span> @p.LastCreatedAtFa</span>
                                <span class="qp-pcard__go">مشاهده پرسش‌ها <span class="oi oi-arrow-left"></span></span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    }
    else
    {
        @* ======================== DETAIL : PRODUCT BAR ======================== *@
        <div class="qp-pbar">
            <div class="qp-pbar__media">
                @if (!string.IsNullOrWhiteSpace(_detailImage))
                {
                    <img src="@_detailImage" alt="@_detailTitle" loading="eager" decoding="async" />
                }
                else
                {
                    <div class="qp-pbar__ph">@GetInitials(_detailTitle)</div>
                }
            </div>
            <div class="qp-pbar__body">
                <div class="qp-pbar__name">@(!string.IsNullOrWhiteSpace(_detailTitle) ? _detailTitle : "محصول")</div>
                <div class="qp-pbar__stats">
                    <span class="qp-st qp-st--total"><b>@All.Count</b> پرسش</span>
                    <span class="qp-st qp-st--warn"><b>@All.Count(i => !i.IsAnswered)</b> بدون پاسخ</span>
                    <span class="qp-st qp-st--danger"><b>@All.Count(i => !i.IsApproved)</b> پنهان</span>
                    <span class="qp-st qp-st--info"><b>@All.Count(i => !i.IsAdminRead)</b> جدید</span>
                </div>
            </div>
        </div>

        @* ======================== DETAIL : TOOLBAR ======================== *@
        <div class="qp-toolbar">
            <div class="qp-chips">
                <button class="qp-chip @(_filter == "all" ? "active" : "")" @onclick='() => SetFilter("all")'>
                    همه <span class="qp-chip-count">@All.Count</span>
                </button>
                <button class="qp-chip @(_filter == "pending" ? "active" : "")" @onclick='() => SetFilter("pending")'>
                    بدون پاسخ <span class="qp-chip-count">@All.Count(i => !i.IsAnswered)</span>
                </button>
                <button class="qp-chip @(_filter == "answered" ? "active" : "")" @onclick='() => SetFilter("answered")'>
                    پاسخ‌دار <span class="qp-chip-count">@All.Count(i => i.IsAnswered)</span>
                </button>
                <button class="qp-chip @(_filter == "hidden" ? "active" : "")" @onclick='() => SetFilter("hidden")'>
                    تاییدنشده <span class="qp-chip-count">@All.Count(i => !i.IsApproved)</span>
                </button>
                <button class="qp-chip @(_filter == "unread" ? "active" : "")" @onclick='() => SetFilter("unread")'>
                    خوانده‌نشده <span class="qp-chip-count">@All.Count(i => !i.IsAdminRead)</span>
                </button>
            </div>
            <div class="qp-search-wrap">
                <span class="oi oi-magnifying-glass qp-search-ic"></span>
                <input type="text" class="qp-search" placeholder="جستجو در پرسش، پاسخ یا نام کاربر..."
                       value="@_search" @oninput="OnDetailSearchInput" />
            </div>
        </div>

        @* ======================== DETAIL : BODY ======================== *@
        @if (_loadingDetail)
        {
            <div class="qp-loading">
                <div class="spinner-border text-primary"></div>
                <p>در حال دریافت پرسش‌های این محصول...</p>
            </div>
        }
        else if (!Filtered.Any())
        {
            <div class="qp-empty">
                <div class="qp-empty-icon"><span class="oi oi-chat"></span></div>
                <h5>پرسشی یافت نشد</h5>
                <p>@(_search != "" ? "جستجوی دیگری امتحان کنید." : "هنوز پرسشی برای این محصول ثبت نشده است.")</p>
            </div>
        }
        else
        {
            <div class="qp-list">
                @foreach (var q in Filtered)
                {
                    var editing = _editId == q.Id;
                    <div class="qp-card @(!q.IsApproved ? "qp-card--pending" : "") @(!q.IsAdminRead ? "qp-card--unread" : "")">
                        <div class="qp-card-top">
                            <div class="qp-meta">
                                <span class="qp-user"><span class="oi oi-person"></span> @q.FullName</span>
                                <span class="qp-dot"></span>
                                <span class="qp-date"><span class="oi oi-clock"></span> @q.CreatedAtFa</span>
                                @if (q.UpVotes > 0)
                                {
                                    <span class="qp-dot"></span>
                                    <span class="qp-votes"><span class="oi oi-thumb-up"></span> @q.UpVotes</span>
                                }
                            </div>
                            <div class="qp-actions">
                                <button class="qp-act @(q.IsApproved ? "qp-act--on" : "")"
                                        title="تایید / عدم تایید نمایش" @onclick="() => ToggleApprove(q)" disabled="@_busy">
                                    <span class="oi @(q.IsApproved ? "oi-check" : "oi-x")"></span>
                                </button>
                                <button class="qp-act qp-act--danger" title="حذف" @onclick="() => AskDelete(q.Id)" disabled="@_busy">
                                    <span class="oi oi-trash"></span>
                                </button>
                            </div>
                        </div>

                        <div class="qp-question">@q.Question</div>

                        <div class="qp-status">
                            @if (q.IsAnswered)
                            {
                                <span class="qp-pill qp-pill--ok">پاسخ‌دار</span>
                            }
                            else
                            {
                                <span class="qp-pill qp-pill--warn">بدون پاسخ</span>
                            }
                            @if (q.IsApproved)
                            {
                                <span class="qp-pill qp-pill--ok">نمایش عمومی</span>
                            }
                            else
                            {
                                <span class="qp-pill qp-pill--danger">پنهان</span>
                            }
                            @if (!q.IsAdminRead)
                            {
                                <span class="qp-pill qp-pill--info">جدید</span>
                            }
                        </div>

                        @if (q.IsAnswered && !editing && !string.IsNullOrEmpty(q.Answer))
                        {
                            <div class="qp-answer-view">
                                <div class="qp-answer-label"><span class="oi oi-bubble"></span> پاسخ فروشگاه</div>
                                <p class="qp-answer-text">@q.Answer</p>
                            </div>
                        }

                        @if (editing)
                        {
                            <div class="qp-answer-edit">
                                <textarea class="qp-textarea" rows="3" maxlength="500"
                                          placeholder="پاسخ خود را بنویسید..." @bind="_answerText"></textarea>
                                <div class="qp-answer-actions">
                                    <span class="qp-hint">با ثبت پاسخ، پرسش تایید و نمایش داده می‌شود.</span>
                                    <div class="qp-answer-btns">
                                        <button class="qp-btn qp-btn--ghost" @onclick="CancelEdit">انصراف</button>
                                        <button class="qp-btn qp-btn--primary" @onclick="() => SaveAnswer(q.Id)" disabled="@_busy">
                                            @if (_busy) { <span class="spinner-border spinner-border-sm"></span> }
                                            ثبت پاسخ
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="qp-card-footer">
                                <button class="qp-btn qp-btn--soft" @onclick="() => StartEdit(q)">
                                    <span class="oi oi-pencil"></span> @(q.IsAnswered ? "ویرایش پاسخ" : "پاسخ دادن")
                                </button>
                                <a class="qp-btn qp-btn--ghost" href="/products/@q.ProductId#qna" target="_blank" rel="noopener">
                                    <span class="oi oi-external-link"></span> مشاهده در سایت
                                </a>
                            </div>
                        }

                        @if (q.Replies != null && q.Replies.Any())
                        {
                            <div class="qp-replies">
                                <div class="qp-replies-head"><span class="oi oi-people"></span> پاسخ‌های کاربران (@q.Replies.Count)</div>
                                @foreach (var r in q.Replies)
                                {
                                    <div class="qp-reply @(!r.IsApproved ? "qp-reply--pending" : "") @(r.IsAdmin ? "qp-reply--admin" : "")">
                                        <div class="qp-reply-head">
                                            <b>@r.FullName</b>
                                            @if (r.IsAdmin)
                                            {
                                                <span class="qp-reply-badge">کارشناس فروشگاه</span>
                                            }
                                            @if (!r.IsApproved)
                                            {
                                                <span class="qp-pill qp-pill--warn">پنهان</span>
                                            }
                                            <span class="qp-date">@r.CreatedAtFa</span>
                                        </div>
                                        <p class="qp-reply-body">@r.Body</p>
                                        <div class="qp-reply-actions">
                                            <button class="qp-act @(r.IsApproved ? "qp-act--on" : "")"
                                                    title="تایید / عدم تایید نمایش" @onclick="() => ToggleReply(r)" disabled="@_busy">
                                                <span class="oi @(r.IsApproved ? "oi-check" : "oi-x")"></span>
                                            </button>
                                            <button class="qp-act qp-act--danger" title="حذف پاسخ" @onclick="() => AskDeleteReply(r.Id)" disabled="@_busy">
                                                <span class="oi oi-trash"></span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @if (_hasMore)
            {
                <div class="qp-more">
                    <button class="qp-btn qp-btn--soft" @onclick="LoadMore" disabled="@_loadingDetail">
                        @if (_loadingDetail) { <span class="spinner-border spinner-border-sm"></span> }
                        نمایش پرسش‌های بیشتر
                    </button>
                </div>
            }
        }
    }
</div>

<style>
    .qp-page { max-width: 1180px; margin: 0 auto; padding: 1.4rem 1rem 3rem; }

    .qp-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.15rem; }
    .qp-head-main { min-width: 0; }
    .qp-back { display: inline-flex; align-items: center; gap: .35rem; font-size: .8rem; font-weight: 700; color: #4f46e5; text-decoration: none; background: #eef2ff; padding: .3rem .75rem; border-radius: 999px; margin-bottom: .55rem; transition: background .15s; }
    .qp-back:hover { background: #e0e7ff; }
    .qp-title { font-size: 1.3rem; font-weight: 900; margin: 0; line-height: 1.7; word-break: break-word; }
    .qp-sub { color: #64748b; font-size: .84rem; margin: .3rem 0 0; line-height: 1.9; }
    .qp-header-actions { display: flex; align-items: center; gap: .45rem; flex-wrap: wrap; }
    .qp-badge { font-size: .75rem; font-weight: 800; padding: .35rem .7rem; border-radius: 999px; white-space: nowrap; }
    .qp-badge--indigo { background: #eef2ff; color: #4338ca; }
    .qp-badge--blue { background: #dbeafe; color: #1d4ed8; }

    .qp-btn { display: inline-flex; align-items: center; justify-content: center; gap: .4rem; font-size: .8rem; font-weight: 700; padding: .5rem .95rem; border-radius: 999px; border: 1px solid transparent; cursor: pointer; text-decoration: none; white-space: nowrap; transition: all .15s ease; background: #fff; color: #334155; }
    .qp-btn:disabled { opacity: .55; cursor: not-allowed; }
    .qp-btn--primary { background: #4f46e5; border-color: #4f46e5; color: #fff; }
    .qp-btn--primary:hover:not(:disabled) { background: #4338ca; border-color: #4338ca; }
    .qp-btn--ghost { background: #fff; border-color: #e2e8f0; color: #475569; }
    .qp-btn--ghost:hover:not(:disabled) { border-color: #c7d2fe; color: #4338ca; }
    .qp-btn--soft { background: #eef2ff; border-color: #e0e7ff; color: #4338ca; }
    .qp-btn--soft:hover:not(:disabled) { background: #e0e7ff; }

    .qp-kpis { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: .75rem; margin-bottom: 1.1rem; }
    .qp-kpi { display: flex; align-items: center; gap: .7rem; background: #fff; border: 1px solid #e9edf3; border-radius: 1rem; padding: .85rem .9rem; box-shadow: 0 1px 2px rgba(15,23,42,.04); }
    .qp-kpi__ic { width: 40px; height: 40px; border-radius: .75rem; display: inline-flex; align-items: center; justify-content: center; font-size: 1.1rem; color: #fff; flex: 0 0 40px; }
    .qp-kpi__ic--indigo { background: linear-gradient(140deg, #6366f1, #4338ca); }
    .qp-kpi__ic--amber { background: linear-gradient(140deg, #f59e0b, #d97706); }
    .qp-kpi__ic--rose { background: linear-gradient(140deg, #f43f5e, #e11d48); }
    .qp-kpi__ic--sky { background: linear-gradient(140deg, #0ea5e9, #0284c7); }
    .qp-kpi__v { font-size: 1.25rem; font-weight: 900; color: #0f172a; line-height: 1.2; }
    .qp-kpi__l { font-size: .74rem; color: #64748b; font-weight: 700; margin-top: .15rem; }

    .qp-toolbar { display: flex; align-items: center; justify-content: space-between; gap: .75rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .qp-chips { display: flex; gap: .4rem; flex-wrap: wrap; min-width: 0; }
    .qp-chip { border: 1px solid #e2e8f0; background: #fff; color: #475569; font-size: .78rem; font-weight: 700; padding: .42rem .8rem; border-radius: 999px; cursor: pointer; transition: all .15s ease; white-space: nowrap; }
    .qp-chip:hover { border-color: #c7d2fe; color: #4338ca; }
    .qp-chip.active { background: #4f46e5; border-color: #4f46e5; color: #fff; }
    .qp-chip-count { display: inline-block; min-width: 1.2rem; text-align: center; background: rgba(0,0,0,.08); border-radius: 999px; font-size: .68rem; padding: 0 .35rem; margin-right: .2rem; }
    .qp-chip.active .qp-chip-count { background: rgba(255,255,255,.25); }

    .qp-search-wrap { position: relative; flex: 0 1 300px; min-width: 0; }
    .qp-search-ic { position: absolute; right: .85rem; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: .85rem; pointer-events: none; }
    .qp-search { width: 100%; border: 1px solid #e2e8f0; border-radius: 999px; padding: .5rem 2.3rem .5rem 1rem; font-size: .84rem; outline: none; transition: border-color .15s, box-shadow .15s; background: #fff; }
    .qp-search:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.15); }

    .qp-loading, .qp-empty { text-align: center; padding: 3.2rem 1rem; color: #64748b; background: #fff; border: 1px solid #e9edf3; border-radius: 1.1rem; }
    .qp-loading p, .qp-empty p { margin-top: .8rem; font-size: .87rem; }
    .qp-empty-icon { font-size: 2.6rem; color: #cbd5e1; margin-bottom: .5rem; }
