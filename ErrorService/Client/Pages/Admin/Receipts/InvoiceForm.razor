    /* SMS Badge on status section title */
    /* SMS History Badge — Section Title */
    .iv-sms-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 14px 4px 10px;
        border-radius: 100px;
        font-size: 0.7rem;
        font-weight: 800;
        cursor: pointer;
        line-height: 1.4;
        user-select: none;
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        box-shadow: 0 2px 12px rgba(245,158,11,0.35);
        transition: transform 0.2s, box-shadow 0.2s;
        animation: ivSmsBadgePulse 2s ease-in-out infinite;
    }

    .iv-sms-badge::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.25), transparent);
        transform: translateX(-100%);
        animation: ivSmsBadgeShine 2.5s ease-in-out infinite;
    }

    .iv-sms-badge:hover {
        transform: scale(1.1);
        box-shadow: 0 4px 20px rgba(245,158,11,0.5);
        animation: none;
    }

    .iv-sms-badge:hover::before {
        animation: ivSmsBadgeShine 0.8s ease-in-out infinite;
    }

    .iv-sms-badge--empty {
        background: linear-gradient(135deg, #94a3b8, #64748b);
        box-shadow: 0 2px 8px rgba(148,163,184,0.3);
        cursor: default;
        animation: none;
        opacity: 0.7;
    }

    .iv-sms-badge--empty::before { display: none; }

    .iv-sms-badge__icon {
        display: inline-flex;
        align-items: center;
