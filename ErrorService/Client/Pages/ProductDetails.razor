                    }
                    else if (_cartBtnState == CartBtnState.Done)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    }
                    <span>@_cartBtnText</span>
                </button>
                }
            </div>
        </div>
        @if (IsProductOutOfStock)
        {
            <button class="pd-sticky-notify @(_stockAlertSubscribed ? "pd-notify-subscribed" : "")"
                    @onclick="HandleStockAlertClick" disabled="@_stockAlertBusy">
                @if (_stockAlertBusy)
                {
                    <span class="pd-cart-spinner"></span>
                }
                else if (_stockAlertSubscribed)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                }
                else
