    [Parameter] public string MonitoringDeviceTitle { get; set; } = "";
    [Parameter] public string WorkshopName { get; set; } = "";
    [Parameter] public string CreatedAtFa { get; set; } = "";
    [Parameter] public string CreatedByUserName { get; set; } = "";
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public string? ShareToken { get; set; }
    private string ApiPrefix => IsReadOnly ? "api/monitoring/share" : "api/monitoring";
    private string TokenQuery => IsReadOnly && !string.IsNullOrEmpty(ShareToken) ? $"&token={ShareToken}" : "";
    private bool _infoOpen;
    private bool _changeLogsOpen;
    private int? _expandedLogId;
    private List<ChangeLogItem> _changeLogs = new();
    private int _changeLogPage = 1;
    private int _changeLogTotal;
    private bool _changeLogLoadingMore;

    private void ToggleInfo() { _infoOpen = !_infoOpen; }

    private async Task LoadChangeLogs(int page, bool append = false)
    {
        if (string.IsNullOrWhiteSpace(Code)) return;
        try
        {
            var url = IsReadOnly
                ? $"{ApiPrefix}/change-log?token={ShareToken}&page={page}&pageSize=20"
                : $"api/monitoring/change-log?monitoringId={Id}&code={Code}&page={page}&pageSize=20";
            var result = await Http.GetFromJsonAsync<ChangeLogResponse>(url);
            if (result == null) return;
            _changeLogTotal = result.Total;
            _changeLogPage = result.Page;
            if (append)
                _changeLogs.AddRange(result.Items);
            else
                _changeLogs = result.Items;
        }
        catch { }
    }

    private async Task ToggleChangeLogs()
    {
        _changeLogsOpen = !_changeLogsOpen;
        if (!_changeLogsOpen)
            _expandedLogId = null;
        if (_changeLogsOpen && _changeLogs.Count == 0)
        {
            await LoadChangeLogs(1);
        }
    }

    private async Task LoadMoreChangeLogs()
    {
        if (_changeLogLoadingMore) return;
        _changeLogLoadingMore = true;
        await LoadChangeLogs(_changeLogPage + 1, append: true);
        _changeLogLoadingMore = false;
    }

    private async Task RefreshChangeLogs()
    {
        if (!_changeLogsOpen || !_connected || _changeLogs.Count == 0) return;
        try
        {
            var url = IsReadOnly
                ? $"{ApiPrefix}/change-log?token={ShareToken}&page=1&pageSize=20"
                : $"api/monitoring/change-log?monitoringId={Id}&code={Code}&page=1&pageSize=20";
            var result = await Http.GetFromJsonAsync<ChangeLogResponse>(url);
            if (result == null || result.Items.Count == 0) return;
            _changeLogTotal = result.Total;
            var existingIds = new HashSet<int>(_changeLogs.Select(x => x.Id));
            var newItems = result.Items.Where(x => !existingIds.Contains(x.Id)).ToList();
            if (newItems.Count > 0)
            {
                _changeLogs.InsertRange(0, newItems);
                _changeLogPage = 1;
            }
        }
        catch { }
    }

    private void ToggleLogDetail(int id)
    {
        _expandedLogId = _expandedLogId == id ? null : id;
    }

    private static string GetChangeTypeLabel(string type) => type switch
    {
        "Priz" => "برق", "MotorState" => "موتور", "Element1" => "المنت ۱", "Element2" => "المنت ۲", _ => type
    };

    private static string SwapDateTime(string fa)
    {
        if (string.IsNullOrEmpty(fa)) return fa;
        var parts = fa.Split(' ', 2);
        return parts.Length == 2 ? $"{parts[1]} {parts[0]}" : fa;
    }

    private static (string text, string cssClass) GetChangeStatus(ChangeLogItem log)
    {
        if (string.IsNullOrEmpty(log.DataSnapshot)) return ("—", "");
        try
        {
            using var doc = JsonDocument.Parse(log.DataSnapshot);
            var root = doc.RootElement;

            string? rawValue = null;
            foreach (var prop in root.EnumerateObject())
            {
                if (string.Equals(prop.Name, log.ChangeType, StringComparison.OrdinalIgnoreCase))
                {
                    rawValue = prop.Value.GetRawText().Trim('"');
                    break;
                }
            }

            if (rawValue == null) return ("—", "");

            var isBoolType = log.ChangeType.Equals("Priz", StringComparison.OrdinalIgnoreCase)
                || log.ChangeType.Equals("MotorState", StringComparison.OrdinalIgnoreCase)
                || log.ChangeType.Equals("Element1", StringComparison.OrdinalIgnoreCase)
                || log.ChangeType.Equals("Element2", StringComparison.OrdinalIgnoreCase);

            if (isBoolType)
            {
                if (rawValue == "on" || rawValue == "ON" || rawValue == "On" || rawValue == "True" || rawValue == "true" || rawValue == "1") return ("روشن", "on");
                if (rawValue == "off" || rawValue == "OFF" || rawValue == "Off" || rawValue == "False" || rawValue == "false" || rawValue == "0") return ("خاموش", "off");
            }
            else
            {
                if (!string.IsNullOrEmpty(rawValue) && rawValue != "null") return (rawValue, "");
            }
        }
        catch { }
        return ("—", "");
    }

    private static string SnapshotIcon(string key) => key switch
    {
        "Priz" => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" width=\"12\" height=\"12\"><path d=\"M13 2L3 14h9l-1 8 10-12h-9l1-8z\" stroke-linejoin=\"round\"/></svg>",
        "MotorState" => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" width=\"12\" height=\"12\"><circle cx=\"12\" cy=\"12\" r=\"3.5\" stroke-width=\"2\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3M5.5 5.5l2 2M16.5 16.5l2 2M5.5 18.5l2-2M16.5 7.5l2-2\"/></svg>",
        "Element1" or "Element2" => "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" width=\"12\" height=\"12\"><path d=\"M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5\"/></svg>",
