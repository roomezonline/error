@inherits LayoutComponentBase
@implements IDisposable
@using ErrorService.Client.Services
@using ErrorService.Shared
@using System.Net.Http.Json
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime
@inject AuthService Auth
@inject HttpClient Http
@inject AdminWorkshopSelectionService AdminWorkshopSelection
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject NotificationCenterService Notif

<PageTitle>پنل مدیریت | ارورسرویس</PageTitle>

@code {
    private bool showUserMenu = false;
    private bool showNotifPanel = false;
    private bool _pendingNotifPos;
    private ElementReference NotifPanelRef;
    private DotNetObjectReference<AdminLayout>? _dotNetRef;
    private System.Threading.Timer? _notifTimer;

    private async Task ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
        if (showUserMenu)
        {
            showNotifPanel = false;
            await JSRuntime.InvokeVoidAsync("__um_addHandler", _dotNetRef);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("__um_removeHandler");
        }
    }

    private async Task ToggleNotifPanel()
    {
        showNotifPanel = !showNotifPanel;
        if (showNotifPanel)
        {
            if (showUserMenu)
            {
                showUserMenu = false;
                await JSRuntime.InvokeVoidAsync("__um_removeHandler");
            }
            _pendingNotifPos = true;
            await Notif.RefreshAsync();
        }
    }

    private void CloseNotifPanel() => showNotifPanel = false;

    private async Task MarkAllReads() => await Notif.MarkAllReadAsync();

    private async Task OpenNotif(NotificationDto item)
    {
        showNotifPanel = false;
        if (!item.IsRead)
            await Notif.MarkReadAsync(item.Id);
        if (!string.IsNullOrWhiteSpace(item.ActionUrl))
            Nav.NavigateTo(item.ActionUrl);
    }

    private static string SeverityDotStyle(int severity) => severity switch
    {
        1 => "background:#16a34a",
        2 => "background:#f59e0b",
        3 => "background:#dc2626",
        _ => "background:#0d6efd"
    };

    // در پنل کارگاه، نام پرسنل کارگاه نمایش داده می‌شود؛ روی سایت اصلی نام کاربر سایت حفظ می‌شود.
    private static string? DisplayName(System.Security.Claims.ClaimsPrincipal user)
    {
        var wsName = user.FindFirst("workshop_name")?.Value;
        return !string.IsNullOrWhiteSpace(wsName) ? wsName : user.Identity?.Name;
    }

    private async Task RefreshNotifsIfAuthenticatedAsync()
    {
        try
        {
            var token = await Auth.GetTokenAsync() ?? await Auth.GetWorkshopTokenAsync();
            if (string.IsNullOrEmpty(token)) return;
            await Notif.RefreshAsync();
        }
        catch { }
    }

    [JSInvokable]
    public void CloseUserMenuFromOutside()
    {
        showUserMenu = false;
        StateHasChanged();
    }
    private bool showNavDrawer = false;
    private void ToggleNavDrawer() => showNavDrawer = !showNavDrawer;

    private void GoDashboard() => Nav.NavigateTo("/admin");
    private void GoNewReceipt() => Nav.NavigateTo("/admin/receipts/new");
    private void GoReceipts() => Nav.NavigateTo("/admin/receipts");
    private void GoSettings() => Nav.NavigateTo("/admin/settings");
    private int? currentWorkshopId;
    private string? currentWorkshopName;
    private string? currentWorkshopOwner;
    private bool isSuperAdmin;
    private bool _hasAnySmsPerm;
    private bool _hasNotificationPerm;

    private List<WorkshopDto>? workshops;
    private string? selectedWorkshopId;

    protected override async Task OnInitializedAsync()
    {
        var workshopToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "workshop_token");
        var authToken = await JSRuntime.InvokeAsync<string>("localStorage.getItem", "auth_token");

        if (string.IsNullOrEmpty(workshopToken) && string.IsNullOrEmpty(authToken))
        {
            Nav.NavigateTo("/auth/login");
            return;
        }

        await AdminWorkshopSelection.InitializeAsync();
        await LoadWorkshopContext();

        Notif.OnChange += StateHasChanged;
        _ = RefreshNotifsIfAuthenticatedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("eval", @"
                window.__um_addHandler = function(dotNetRef) {
                    if (window.__um_handler) {
                        document.removeEventListener('click', window.__um_handler, true);
                    }
                    window.__um_handler = function(e) {
                        var m = document.querySelector('.user-dropdown-menu');
                        var b = document.querySelector('.dropdown-modern > button');
                        if (m && !m.contains(e.target) && b && !b.contains(e.target)) {
                            document.removeEventListener('click', window.__um_handler, true);
                            window.__um_handler = null;
                            dotNetRef.invokeMethodAsync('CloseUserMenuFromOutside');
                        }
                    };
                    document.addEventListener('click', window.__um_handler, true);
                };
                window.__um_removeHandler = function() {
                    if (window.__um_handler) {
                        document.removeEventListener('click', window.__um_handler, true);
                        window.__um_handler = null;
                    }
                };
                window.__notif_pos = function(el) {
                    if (!el) return;
                    var bell = document.querySelector('.hdr-bell');
                    if (!bell) return;
                    var b = bell.getBoundingClientRect();
                    var w = el.offsetWidth;
                    el.style.top = (b.bottom + 10) + 'px';
                    el.style.left = Math.min(Math.max(12, b.left + b.width / 2 - w / 2), window.innerWidth - w - 12) + 'px';
                    el.style.right = 'auto';
                };
            ");
            await SetupHeaderScrollBehavior();
            await SetupHeaderPaddingSync();
            _notifTimer = new System.Threading.Timer(async _ =>
            {
                try { await InvokeAsync(RefreshNotifsIfAuthenticatedAsync); } catch { }
            }, null, 45000, 45000);
        }

        if (_pendingNotifPos)
        {
            _pendingNotifPos = false;
            try { await JSRuntime.InvokeVoidAsync("__notif_pos", NotifPanelRef); }
            catch { }
        }
    }

    private async Task SetupHeaderPaddingSync()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    'use strict';
                    var header = document.querySelector('.admin-header-wrapper');
                    var main = document.querySelector('.admin-main-wrapper');
                    if (!header || !main) return;

                    function sync() {
                        var h = header.offsetHeight;
                        main.style.paddingTop = (h + 16) + 'px';
                    }

                    sync();
                    window.addEventListener('resize', sync);

                    if (window.ResizeObserver) {
                        new ResizeObserver(sync).observe(header);
                    }

                    if (window.MutationObserver) {
                        new MutationObserver(sync).observe(header, { childList: true, subtree: true, characterData: true });
                    }
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting up header padding sync: {ex.Message}");
        }
    }

    private async Task SetupHeaderScrollBehavior()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                (function() {
                    'use strict';

                    var lastScrollTop = 0;
                    var scrollStartPoint = 0;
                    var lastDirection = 'none';
                    var touchStartY = 0;
                    var isTouching = false;
                    var currentTransform = 0;
                    var targetTransform = 0;
                    var isScrollingByNav = false;

                    var headerWrapper = document.querySelector('.admin-header-wrapper');
                    var header = document.querySelector('.admin-header');
                    var scrollThreshold = 30;
                    var maxTransform = -100;

                    if (!headerWrapper || !header) return;

                    function handleScroll() {
                        if (isScrollingByNav) return;
                        var scrollTop = window.pageYOffset || document.documentElement.scrollTop;
                        var scrollDirection = scrollTop > lastScrollTop ? 'down' : 'up';
                        if (scrollDirection !== lastDirection) {
                            scrollStartPoint = scrollTop;
                            lastDirection = scrollDirection;
                        }
                        var scrollDistance = Math.abs(scrollTop - scrollStartPoint);
                        if (scrollTop < 10 || isScrollingByNav) {
                            targetTransform = 0;
                        } else if (scrollDirection === 'down' && scrollDistance > scrollThreshold) {
                            var hideProgress = Math.min((scrollDistance - scrollThreshold) / 50, 1);
                            targetTransform = -hideProgress * 100;
                        } else if (scrollDirection === 'up' && scrollDistance > scrollThreshold) {
                            var showProgress = Math.min((scrollDistance - scrollThreshold) / 50, 1);
                            targetTransform = maxTransform + showProgress * 100;
                            if (targetTransform > 0) targetTransform = 0;
                        }
                        lastScrollTop = scrollTop;
                    }

                    function animateHeader() {
                        if (isScrollingByNav) {
                            currentTransform = 0;
                            targetTransform = 0;
                            headerWrapper.style.transform = 'translateY(0%)';
                            header.style.opacity = '1';
                            return;
                        }
                        var diff = targetTransform - currentTransform;
                        if (Math.abs(diff) > 0.1) {
                            currentTransform += diff * 0.15;
                            headerWrapper.style.transform = 'translateY(' + currentTransform + '%)';
                            header.style.opacity = 1 - Math.abs(currentTransform) / 100;
                            requestAnimationFrame(animateHeader);
                        } else {
                            currentTransform = targetTransform;
                            headerWrapper.style.transform = 'translateY(' + currentTransform + '%)';
                            header.style.opacity = 1 - Math.abs(currentTransform) / 100;
                        }
                    }

                    var ticking = false;
                    function throttledScroll() {
                        if (!ticking && !isScrollingByNav) {
                            window.requestAnimationFrame(function() {
                                handleScroll();
                                animateHeader();
                                ticking = false;
                            });
                            ticking = true;
                        }
                    }

                    function handleTouchStart(e) {
                        touchStartY = e.touches[0].clientY;
                        isTouching = true;
                    }

                    function handleTouchMove(e) {
                        if (!isTouching || isScrollingByNav) return;
                        var currentY = e.touches[0].clientY;
                        var deltaY = touchStartY - currentY;
                        if (Math.abs(deltaY) > 5) throttledScroll();
                    }

                    function handleTouchEnd() {
                        isTouching = false;
                        setTimeout(function() {
                            isScrollingByNav = false;
                            throttledScroll();
                        }, 100);
                    }

                    window.addEventListener('scroll', throttledScroll, { passive: true });
                    window.addEventListener('touchstart', handleTouchStart, { passive: true });
                    window.addEventListener('touchmove', handleTouchMove, { passive: true });
                    window.addEventListener('touchend', handleTouchEnd, { passive: true });

                    scrollStartPoint = window.pageYOffset || document.documentElement.scrollTop;
                    handleScroll();
                })();
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error setting up header scroll behavior: {ex.Message}");
        }
    }

    private async Task LoadWorkshopContext()
    {
        try
        {
            var state = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = state.User;

            isSuperAdmin = user.IsInRole("super_admin");

            _hasAnySmsPerm = isSuperAdmin ||
                user.HasClaim("perm", "admin.sms.view") ||
                user.HasClaim("perm", "admin.sms.manage") ||
                user.HasClaim("perm", "admin.sms.charges.manage") ||
                user.HasClaim("perm", "admin.sms.credits.view") ||
                user.HasClaim("perm", "admin.sms.credits.manage") ||
                user.HasClaim("perm", "admin.sms.charges.view") ||
                user.HasClaim("perm", "admin.sms.charges.approve") ||
                user.HasClaim("perm", "admin.sms.logs.view") ||
                user.HasClaim("perm", "workshop.sms.manage") ||
                user.HasClaim("perm", "workshop.sms.settings.manage") ||
                user.HasClaim("perm", "workshop.sms.credit.view") ||
                user.HasClaim("perm", "workshop.sms.charge.request") ||
                user.HasClaim("perm", "workshop.sms.charge.history") ||
                user.HasClaim("perm", "workshop.sms.logs.view");

            _hasNotificationPerm = isSuperAdmin ||
                user.HasClaim("perm", "admin.notifications.view") ||
                user.HasClaim("perm", "admin.notifications.manage");

            if (isSuperAdmin)
            {
                workshops = await Http.GetFromJsonAsync<List<WorkshopDto>>("api/workshops");
                if (workshops == null || workshops.Count == 0)
                {
                    workshops = new List<WorkshopDto>();
                }
                selectedWorkshopId = AdminWorkshopSelection.SelectedWorkshopId?.ToString();
            }

            var wsIdStr = user.Claims.FirstOrDefault(x => x.Type == "workshop_id")?.Value;
            if (!string.IsNullOrWhiteSpace(wsIdStr) && int.TryParse(wsIdStr, out var wsId))
            {
                currentWorkshopId = wsId;
                var dto = await Http.GetFromJsonAsync<WorkshopDto>($"api/workshops/{wsId}");
                currentWorkshopName = dto?.WorkshopName;
                currentWorkshopOwner = dto?.OwnerFullName;
            }
            else
            {
                currentWorkshopId = null;
                currentWorkshopName = null;
                currentWorkshopOwner = null;
            }
        }
        catch
        {
            currentWorkshopId = null;
            currentWorkshopName = null;
            currentWorkshopOwner = null;

            if (isSuperAdmin)
            {
                workshops = new List<WorkshopDto>();
            }
        }
    }

    private async Task OnAdminWorkshopChanged()
    {
        if (string.IsNullOrWhiteSpace(selectedWorkshopId))
        {
            await AdminWorkshopSelection.SetSelectedWorkshopIdAsync(null);
        }
        else if (int.TryParse(selectedWorkshopId, out var id))
        {
            await AdminWorkshopSelection.SetSelectedWorkshopIdAsync(id);
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleLogout()
    {
        await Auth.LogoutAsync();
        if (AuthStateProvider is JwtAuthStateProvider jwtProvider)
        {
            jwtProvider.NotifyAuthStateChanged();
        }
        Nav.NavigateTo("/");
    }

    public void Dispose()
    {
        Notif.OnChange -= StateHasChanged;
        _notifTimer?.Dispose();
        _dotNetRef?.Dispose();
        try { JSRuntime.InvokeVoidAsync("__um_removeHandler"); } catch { }
    }
}

<div class="admin-shell" dir="rtl">
    <header class="admin-header">
        <div class="admin-header-wrapper shadow-sm">
            <div class="container-fluid admin-header__inner px-3">
                <div class="admin-header__top">
                    <div class="d-flex align-items-center gap-2">
                        <button class="btn btn-icon rounded-circle d-lg-none" @onclick="ToggleNavDrawer" title="منوی مدیریت">
                            <span class="oi oi-menu"></span>
                        </button>
                        <div class="admin-logo-circle shadow-sm">
                            <svg viewBox="0 0 128 128" width="22" height="22" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <defs>
                                    <linearGradient id="adG" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#2563eb"/>
                                        <stop offset="100%" stop-color="#1d4ed8"/>
                                    </linearGradient>
                                    <linearGradient id="adA" x1="0" y1="0" x2="1" y2="1">
                                        <stop offset="0%" stop-color="#f59e0b"/>
                                        <stop offset="100%" stop-color="#d97706"/>
                                    </linearGradient>
                                </defs>
                                <path d="M64 6L110 27v49c0 23-18 43-46 51-28-8-46-28-46-51V27L64 6z" fill="url(#adG)"/>
                                <path d="M42 45h44v9H55v11h28v9H55v12h31v9H42V45z" fill="white"/>
                                <circle cx="94" cy="45" r="5" fill="url(#adA)"/>
                                <rect x="92" y="52" width="4" height="14" rx="2" fill="url(#adA)"/>
                            </svg>
                        </div>
                        <span class="admin-brand fw-black text-dark">پنل مدیریت</span>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="hdr-bell-wrap">
                            <button type="button" class="hdr-bell" @onclick="ToggleNotifPanel" @onclick:stopPropagation aria-label="اعلان‌ها">
                                <span class="oi oi-bell"></span>
                                @if (Notif.UnreadCount > 0)
                                {
                                    <span class="hdr-bell__badge">@(Notif.UnreadCount > 99 ? "99+" : Notif.UnreadCount.ToString())</span>
                                }
                            </button>
                        </div>
                        <AuthorizeView>
                            <Authorized>
                                <div class="dropdown-modern">
                                    <button class="btn btn-icon rounded-circle bg-white shadow-sm border p-0 overflow-hidden" type="button" @onclick="ToggleUserMenu" @onclick:stopPropagation>
                                        <div class="user-avatar-header bg-primary text-white fw-black">
                                            @DisplayName(context.User)?[0]
                                        </div>
                                    </button>
                                    @if (showUserMenu)
                                    {
                                        <ul class="user-dropdown-menu shadow-lg border-0 rounded-4 mt-2 p-3 animate__animated animate__fadeInUp" @onclick:stopPropagation>
                                            <li class="user-info-section mb-3">
                                                <div class="d-flex align-items-center gap-3 p-2 bg-light rounded-4">
                                                    <div class="user-avatar-large bg-primary text-white fw-black">
                                                        @DisplayName(context.User)?[0]
                                                    </div>
                                                    <div class="overflow-hidden">
                                                        <div class="fw-black text-dark text-truncate">@DisplayName(context.User)</div>
                                                        <div class="text-muted small">@context.User.Claims.FirstOrDefault(c => c.Type == System.Security.Claims.ClaimTypes.MobilePhone)?.Value</div>
                                                    </div>
                                                </div>
                                            </li>

                                            <li class="mb-2">
                                                <div class="px-2 mb-1 x-small fw-bold text-muted text-uppercase">دسترسی ها</div>
                                                <div class="d-flex flex-wrap gap-1 px-2">
                                                    @foreach (var role in context.User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role))
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill fw-bold" style="font-size: 0.65rem;">@role.Value</span>
                                                    }
                                                </div>
                                            </li>

                                            <li><hr class="dropdown-divider opacity-10"></li>

                                            <li>
                                                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" href="/" @onclick="ToggleUserMenu">
                                                    <div class="menu-icon bg-light text-muted"><span class="oi oi-globe"></span></div>
                                                    <span class="fw-bold small">نمایش سایت</span>
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" href="/profile" @onclick="ToggleUserMenu">
                                                    <div class="menu-icon bg-light text-muted"><span class="oi oi-person"></span></div>
                                                    <span class="fw-bold small">پروفایل کاربری</span>
                                                </a>
                                            </li>

                                            <li>
                                                <a class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2" href="/admin/release-history" @onclick="ToggleUserMenu">
                                                    <div class="menu-icon bg-info-subtle text-info"><span class="oi oi-history"></span></div>
                                                    <span class="fw-bold small">تاریخچه تغییرات</span>
                                                </a>
                                            </li>

                                            <li><hr class="dropdown-divider opacity-10"></li>

                                            <li>
                                                <button class="dropdown-item rounded-3 py-2 d-flex align-items-center gap-2 text-danger w-100 border-0 bg-transparent" @onclick="HandleLogout">
                                                    <div class="menu-icon bg-danger-subtle text-danger"><span class="oi oi-account-logout"></span></div>
                                                    <span class="fw-bold small">خروج از حساب</span>
                                                </button>
                                            </li>
                                        </ul>
                                    }
                                </div>
                            </Authorized>
                        </AuthorizeView>
                    </div>
                </div>

                @if (isSuperAdmin || (currentWorkshopId.HasValue && !string.IsNullOrWhiteSpace(currentWorkshopName)))
                {
                    <div class="admin-header__bottom">
                        @if (isSuperAdmin)
                        {
                            <div class="admin-workshop-help">
                                <span class="oi oi-info admin-workshop-help__icon" aria-hidden="true"></span>
                                <span>کارگاه فعال برای پنل مدیریت را انتخاب کنید</span>
                            </div>
                            <div class="admin-workshop-picker admin-workshop-picker--full" title="انتخاب کارگاه">
                                <span class="oi oi-wrench admin-workshop-picker__icon" aria-hidden="true"></span>
                                <select class="admin-workshop-picker__select" @bind="selectedWorkshopId" @bind:after="OnAdminWorkshopChanged">
                                    <option value="">همه کارگاه‌ها</option>
                                    @if (workshops != null)
                                    {
                                        @foreach (var ws in workshops)
                                        {
                                            <option value="@ws.Id">@ws.WorkshopName (@ws.OwnerFullName)</option>
                                        }
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="admin-workshop-help">
                                <span class="oi oi-briefcase admin-workshop-help__icon" aria-hidden="true"></span>
                                <span>کارگاه فعال شما</span>
                            </div>
                            <div class="admin-workshop-picker admin-workshop-picker--full" title="کارگاه فعال">
                                <span class="oi oi-wrench admin-workshop-picker__icon" aria-hidden="true"></span>
                                <span class="admin-workshop-picker__static-text">
                                    @currentWorkshopName
                                    @if (!string.IsNullOrWhiteSpace(currentWorkshopOwner))
                                    {
                                        <span class="admin-workshop-picker__sub">(@currentWorkshopOwner)</span>
                                    }
                                </span>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </header>

    @if (showNotifPanel)
    {
        <div class="notif-overlay" @onclick="CloseNotifPanel"></div>
        <div class="notif-panel" @ref="NotifPanelRef" @onclick:stopPropagation>
            <div class="notif-panel__head">
                <span class="notif-panel__title"><span class="oi oi-bell"></span> اعلان‌ها</span>
                @if (Notif.UnreadCount > 0)
                {
                    <button type="button" class="notif-panel__readall" @onclick="MarkAllReads">خواندن همه</button>
                }
            </div>
            <div class="notif-panel__list">
                @if (Notif.Recent.Count == 0)
                {
                    <div class="notif-panel__empty">اعلانی وجود ندارد.</div>
                }
                else
                {
                    @foreach (var item in Notif.Recent)
                    {
                        <button type="button" class="notif-mini @(item.IsRead ? "is-read" : "")" @onclick="() => OpenNotif(item)">
                            <span class="notif-mini__dot" style="@SeverityDotStyle(item.Severity)"></span>
                            <span class="notif-mini__body">
                                <span class="notif-mini__title">@item.Title</span>
                                <span class="notif-mini__desc">@item.Body</span>
                                <span class="notif-mini__time">@ErrorService.Client.Services.NotificationCenterService.RelativeTime(item.CreatedAt)</span>
                            </span>
                        </button>
                    }
                }
            </div>
            <div class="notif-panel__foot">
                <a href="/profile#notifications" @onclick="CloseNotifPanel">مشاهده همه اعلان‌ها</a>
            </div>
        </div>
    }

    <main class="admin-main-wrapper">
        <div class="admin-content-container p-3 p-md-4">
            @Body
        </div>
        <ToastContainer />
        <PwaUpdateDialog />
    </main>

    <nav class="admin-bottom-nav" role="navigation" aria-label="Main navigation">
        <button type="button" class="bnav-itm" @onclick="GoDashboard">
            <span class="bnav-ico">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em">
                    <rect x="3" y="3" width="8" height="8" rx="1.5"/>
                    <rect x="13" y="3" width="8" height="8" rx="1.5"/>
                    <rect x="3" y="13" width="8" height="8" rx="1.5"/>
                    <rect x="13" y="13" width="8" height="8" rx="1.5"/>
                </svg>
            </span>
            <span class="bnav-lbl">داشبورد</span>
        </button>
        <AuthorizeView Policy="perm:admin.receipts.manage">
            <button type="button" class="bnav-itm" @onclick="GoNewReceipt">
                <span class="bnav-ico">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="1em" height="1em">
                        <circle cx="12" cy="12" r="9.5"/>
                        <path d="M12 7v10M7 12h10"/>
                    </svg>
                </span>
                <span class="bnav-lbl">ثبت رسید</span>
