        "shipment_created" or "reship_created" => "od-event-icon-blue",
        "shipment_status_changed" => "od-event-icon-amber",
        "return_created" => "od-event-icon-amber",
        "return_refunded" => "od-event-icon-green",
        "return_deleted" => "od-event-icon-red",
        "info_updated" => "od-event-icon-blue",
        _ => "od-event-icon-gray"
    };

    private string GetEventIcon(string type) => type switch
    {
        "created" => "oi-plus",
        "status_changed" => "oi-loop",
        "stage_changed" => "oi-arrow-right",
        "deleted" => "oi-trash",
        "shipment_created" or "reship_created" => "oi-package",
        "shipment_status_changed" => "oi-transfer",
        "info_updated" => "oi-pencil",
        "shipment_deleted" => "oi-x",
        "return_created" => "oi-action-undo",
        "return_refunded" => "oi-credit-card",
        "return_deleted" => "oi-x",
        _ => "oi-record"
    };

    private List<OrderStep> GetSteps()
    {
        var steps = new List<OrderStep>
        {
            new("ثبت سفارش", true),
            new("پرداخت", order.Status is OrderStatus.ReceiptUploaded or OrderStatus.Approved or OrderStatus.Completed),
            new("بررسی رسید", order.Status is OrderStatus.Approved or OrderStatus.Completed),
            new("ارسال و تحویل", order.Status == OrderStatus.Completed)
        };
        var activeIdx = order.Status switch
        {
            OrderStatus.PendingPayment => 1,
            OrderStatus.ReceiptUploaded => 2,
            OrderStatus.Approved => 3,
            _ => -1
        };
        if (activeIdx >= 0 && activeIdx < steps.Count && !steps[activeIdx].IsDone)
            steps[activeIdx].IsActive = true;
        return steps;
    }

    private HashSet<string> collapsedSections = new();

    private void ToggleSection(string section)
    {
        if (!collapsedSections.Remove(section))
            collapsedSections.Add(section);
        StateHasChanged();
    }

    private bool IsSectionVisible(string section) => !collapsedSections.Contains(section);

    private void ToggleC() => ToggleSection("c");
    private void ToggleP() => ToggleSection("p");
    private void ToggleI() => ToggleSection("i");
    private void ToggleS() => ToggleSection("s");
    private void ToggleU() => ToggleSection("u");
    private void ToggleN() => ToggleSection("n");
    private void ToggleR() => ToggleSection("r");
    private void ToggleT() => ToggleSection("t");

    private List<OrderStatus> GetValidTransitions() => order?.Status switch
    {
        OrderStatus.PendingPayment => new() { OrderStatus.ReceiptUploaded, OrderStatus.Approved, OrderStatus.Rejected, OrderStatus.Cancelled },
        OrderStatus.ReceiptUploaded => new() { OrderStatus.Approved, OrderStatus.Rejected, OrderStatus.Cancelled },
        OrderStatus.Approved => new() { OrderStatus.Completed, OrderStatus.Rejected, OrderStatus.Cancelled },
        _ => new()
    };

    private bool CanShowShipments() => order?.Status is OrderStatus.Approved or OrderStatus.Completed or OrderStatus.ReceiptUploaded;
    private bool CanShowNewShipmentButton() => order?.Status is OrderStatus.Approved;
    private bool CanShowReturns() => order?.Status is OrderStatus.Completed || order?.Returns.Any() == true;
    private bool CanShowStatusChange() => GetValidTransitions().Count > 0;
    private bool CanShowDangerZone() => order != null;

    private async Task QuickApprove()
    {
        if (order == null || isSaving) return;
        isSaving = true;
        try
        {
            var req = new OrderStatusUpdateDto { Status = OrderStatus.Approved };
            var resp = await Http.PutAsJsonAsync($"api/orders/admin/{order.Id}/status", req);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("سفارش تایید شد.");
                await LoadOrder();
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrEmpty(msg) ? msg : "خطا در تایید.");
            }
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private async Task QuickReject()
    {
        if (order == null || isSaving) return;
        isSaving = true;
        try
        {
            var req = new OrderStatusUpdateDto { Status = OrderStatus.Rejected, AdminNotes = "رد توسط مدیر" };
            var resp = await Http.PutAsJsonAsync($"api/orders/admin/{order.Id}/status", req);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("سفارش رد شد.");
                await LoadOrder();
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrEmpty(msg) ? msg : "خطا در رد.");
            }
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private class OrderStep(string label, bool isDone)
    {
        public string Label { get; } = label;
        public bool IsDone { get; } = isDone;
        public bool IsActive { get; set; }
    }
}
