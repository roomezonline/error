@code {
    [Parameter] public int ReceiptId { get; set; }
    private CustomerReceiptDto? receipt;
    private bool isLoading = true;
    private List<WorkshopUserDto>? technicians;

    // Invoice Logic
    private List<InvoiceItem> invoiceItems = new();
    private string newItemTitle = "";
    private int newItemQuantity = 1;
    private long newItemUnitPrice = 0;

    // Receipt Status
    private string receiptStatus = CustomerReceiptStatuses.Pending;

    // Billing (Receipt Billing)
    private long billDiscount = 0;
    private long billPrepaid = 0;
    private long billPaid = 0;

    // Bank Accounts
    private List<BankAccountDto>? bankAccounts;
    private int? selectedBankAccountId;

    private async Task LoadBankAccounts(int workshopId)
    {
        try
        {
            bankAccounts = await Http.GetFromJsonAsync<List<BankAccountDto>>($"api/bankaccounts?workshopId={workshopId}&onlyActive=true");
        }
        catch
        {
            bankAccounts = new();
        }
    }

    // Bad Payer Toggle
    private bool isBadPayer = false;

    // Catalog Logic
    private bool showSelector;
    private string catalogSearch = "";
    private List<CatalogItemDto> catalog = new();
    private HashSet<int> tempSelectedCatalogIds = new();
    private bool showCatalogModal;
    private string newCatalogTitle = "";
    private bool newCatalogIsActive = true;
    private bool newCatalogSendSms = true;
    private int? newCatalogDeviceTypeId;

    // SMS Ready-for-Delivery / Unrepairable Modal
    private bool showSmsModal;
    private bool isSendingSms;
    private bool smsSent;
    private string smsPreviewText = "";
    private string smsError = "";
    private string _smsType = ""; // "repaired" or "not_repairable"

    // SMS History for status card badge
    private int smsLogCount;
    private List<SmsLogDto> smsLogs = new();
    private bool showSmsHistoryModal;
    private bool includeAllCatalogs;
    private List<DeviceTypeDto>? deviceTypes;
    private CatalogItemDto? editingCatalogItem;
    private bool canManageCatalog;

    private sealed class CatalogGroup
    {
        public string Title { get; set; } = "";
        public List<CatalogItemDto> Items { get; set; } = new();
    }

    private IEnumerable<CatalogGroup> groupedCatalog =>
      catalog
          .Where(x => !newCatalogDeviceTypeId.HasValue || newCatalogDeviceTypeId.Value == 0 || x.DeviceTypeId == newCatalogDeviceTypeId.Value || x.DeviceTypeId == null)
          .OrderByDescending(x => x.DeviceTypeId.HasValue)
          .ThenBy(x => x.DeviceTypeId)
          .ThenBy(x => x.Title)
          .GroupBy(x => x.DeviceTypeId)
          .Select(g => new CatalogGroup
              {
                  Title = g.Key.HasValue
                      ? (deviceTypes?.FirstOrDefault(d => d.Id == g.Key.Value)?.Name ?? $"دستگاه {g.Key.Value}")
                      : "عمومی",
                  Items = g.ToList()
              });

    private async Task LoadCatalog(bool forceIncludeAll = false)
    {
        try
        {
            var isIncludeAll = forceIncludeAll || includeAllCatalogs;
            var url = receipt != null
                ? $"api/invoice-catalog?workshopId={receipt.WorkshopId}&deviceTypeId={receipt.DeviceTypeId}&includeAll={isIncludeAll.ToString().ToLowerInvariant()}"
                : "api/invoice-catalog";
            catalog = await Http.GetFromJsonAsync<List<CatalogItemDto>>(url) ?? new();
        }
        catch { }
    }

    private async Task LoadDeviceTypesForReceipt()
    {
        try
        {
            if (receipt == null) return;
            deviceTypes = await Http.GetFromJsonAsync<List<DeviceTypeDto>>("api/device-types") ?? new();
        }
        catch { }
    }

    private async Task OnIncludeAllCatalogsChanged(ChangeEventArgs e)
    {
        includeAllCatalogs = e.Value is bool b && b;
        await LoadCatalog();
    }

    private async Task CreateCatalogItem()
    {
        if (string.IsNullOrWhiteSpace(newCatalogTitle)) return;
        try
        {
            Console.WriteLine("Creating catalog item: " + newCatalogTitle);
            var url = receipt != null
                ? $"api/invoice-catalog?workshopId={receipt.WorkshopId}"
                : "api/invoice-catalog";

            var res = await Http.PostAsJsonAsync(url, new
            {
                Title = newCatalogTitle.Trim(),
                IsActive = newCatalogIsActive,
                SendSms = newCatalogSendSms,
                DeviceTypeId = newCatalogDeviceTypeId
            });
            
            if (res.IsSuccessStatusCode)
            {
                Console.WriteLine("Catalog item created successfully");
                newCatalogTitle = "";
                newCatalogIsActive = true;
                newCatalogSendSms = true;
                // Don't reset newCatalogDeviceTypeId to make it easier to add multiple for same device
                await LoadCatalog(showCatalogModal); // Force load all if modal is open
                ToastService.ShowSuccess("به کاتالوگ اضافه شد");
                StateHasChanged();
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                Console.WriteLine("Error creating catalog item: " + error);
                ToastService.ShowError("خطا در ثبت: " + error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Exception in CreateCatalogItem: " + ex.Message);
            ToastService.ShowError("خطای سیستمی در ثبت");
        }
    }

    private async Task DeleteCatalogItem(int id)
    {
        try
        {
            // Check if item is used in any invoice
            var checkUrl = receipt != null
                ? $"api/invoice-catalog/{id}/check-usage?workshopId={receipt.WorkshopId}"
                : $"api/invoice-catalog/{id}/check-usage";
            var checkRes = await Http.GetAsync(checkUrl);
            
            if (checkRes.IsSuccessStatusCode)
            {
                var isUsed = await checkRes.Content.ReadFromJsonAsync<bool>();
                if (isUsed)
                {
                    ToastService.ShowError("این آیتم در فاکتوری استفاده شده و نمی‌تواند حذف شود");
                    return;
                }
            }

            // Show confirmation dialog
            var confirmed = await ShowConfirmDialog("حذف آیتم کاتالوگ", "آیا مطمئن هستید که می‌خواهید این آیتم را حذف کنید؟");
            if (!confirmed) return;

            var url = receipt != null
                ? $"api/invoice-catalog/{id}?workshopId={receipt.WorkshopId}"
                : $"api/invoice-catalog/{id}";
            var res = await Http.DeleteAsync(url);
            if (res.IsSuccessStatusCode)
            {
                await LoadCatalog(showCatalogModal); // Force load all if modal is open
                ToastService.ShowInfo("از کاتالوگ حذف شد");
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                ToastService.ShowError("خطا در حذف: " + error);
            }
        }
        catch { }
    }

    private void EditCatalogItem(CatalogItemDto item)
    {
        editingCatalogItem = item;
        newCatalogTitle = item.Title;
        newCatalogIsActive = item.IsActive;
        newCatalogSendSms = item.SendSms;
        newCatalogDeviceTypeId = item.DeviceTypeId;
        StateHasChanged();
    }

    private async Task UpdateCatalogItem()
    {
        if (editingCatalogItem == null || string.IsNullOrWhiteSpace(newCatalogTitle)) return;
        try
        {
            // Check if item is used in any invoice
            var checkUrl = receipt != null
                ? $"api/invoice-catalog/{editingCatalogItem.Id}/check-usage?workshopId={receipt.WorkshopId}"
                : $"api/invoice-catalog/{editingCatalogItem.Id}/check-usage";
            var checkRes = await Http.GetAsync(checkUrl);
            
            bool isUsed = false;
            if (checkRes.IsSuccessStatusCode)
            {
                isUsed = await checkRes.Content.ReadFromJsonAsync<bool>();
                if (isUsed)
                {
                    var confirmed = await ShowConfirmDialog("ویرایش آیتم کاتالوگ", "این آیتم در فاکتورهای ثبت شده استفاده شده است. تغییر عنوان آن ممکن است بر فاکتورهای قبلی تأثیر بگذارد. آیا مطمئن هستید که می‌خواهید ادامه دهید؟", false);
                    if (!confirmed) return;
                }
            }

            // Show confirmation dialog
            var editConfirmed = await ShowConfirmDialog("ویرایش آیتم کاتالوگ", "عنوان آیتم تغییر خواهد کرد. آیا ادامه می‌دهید؟", false);
            if (!editConfirmed) return;

            // Update using PUT to keep the same ID
            var url = receipt != null
                ? $"api/invoice-catalog/{editingCatalogItem.Id}?workshopId={receipt.WorkshopId}"
                : $"api/invoice-catalog/{editingCatalogItem.Id}";
            
            var res = await Http.PutAsJsonAsync(url, new
            {
                Title = newCatalogTitle.Trim(),
                IsActive = newCatalogIsActive,
                SendSms = newCatalogSendSms,
                DeviceTypeId = newCatalogDeviceTypeId
            });

            if (res.IsSuccessStatusCode)
            {
                await LoadCatalog(showCatalogModal);
                CancelEditCatalogItem();
                ToastService.ShowSuccess("تغییرات ذخیره شد");
            }
            else
            {
                var error = await res.Content.ReadAsStringAsync();
                Console.WriteLine($"UpdateCatalogItem error: {res.StatusCode} - {error}");
                ToastService.ShowError("خطا در ذخیره: " + (error.Length > 100 ? error.Substring(0, 100) + "..." : error));
            }
        }
        catch (HttpRequestException ex)
        {
            Console.WriteLine($"UpdateCatalogItem HttpRequestException: {ex.Message}");
            ToastService.ShowError("خطا در ارتباط با سرور");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"UpdateCatalogItem Exception: {ex.Message}");
            ToastService.ShowError("خطای سیستمی در ذخیره");
        }
    }

    private void CancelEditCatalogItem()
    {
        editingCatalogItem = null;
        newCatalogTitle = "";
        newCatalogIsActive = true;
        newCatalogSendSms = true;
        // Don't reset newCatalogDeviceTypeId
        StateHasChanged();
    }

    private IEnumerable<CatalogItemDto> filteredCatalog => 
        string.IsNullOrWhiteSpace(catalogSearch) 
        ? catalog.Where(x => x.IsActive) 
        : catalog.Where(x => x.IsActive && x.Title.Contains(catalogSearch, StringComparison.OrdinalIgnoreCase));

    private void ToggleSelector()
    {
        showSelector = !showSelector;
        if (showSelector)
        {
            // Sync tempSelectedCatalogIds with current invoiceItems (by Title)
            tempSelectedCatalogIds.Clear();
            if (catalog != null)
            {
                foreach (var item in invoiceItems)
                {
                    var catMatch = catalog.FirstOrDefault(c => c.Title == item.Title);
                    if (catMatch != null)
                    {
                        tempSelectedCatalogIds.Add(catMatch.Id);
                    }
                }
            }
        }
    }

    private void ToggleCatalogSelection(CatalogItemDto item)
    {
        if (tempSelectedCatalogIds.Contains(item.Id))
            tempSelectedCatalogIds.Remove(item.Id);
        else
            tempSelectedCatalogIds.Add(item.Id);
    }

    private void AddSelectedFromCatalog()
    {
        foreach (var id in tempSelectedCatalogIds)
        {
            var cat = catalog.FirstOrDefault(c => c.Id == id);
            if (cat != null)
            {
                // Check if already exists in invoiceItems to prevent duplicates
                if (!invoiceItems.Any(i => i.Title == cat.Title))
                {
                    invoiceItems.Add(new InvoiceItem
                    {
                        Title = cat.Title,
                        UnitPrice = 0, // Default to 0 since BasePrice is missing in DTO
                        Quantity = 1
                    });
                }
            }
        }
        tempSelectedCatalogIds.Clear();
        showSelector = false;
        ToastService.ShowSuccess("موارد انتخابی اضافه شدند");
    }

    private long BillTotalLive => invoiceItems.Sum(x => x.UnitPrice * x.Quantity);
    private long BillPayable => BillTotalLive - billDiscount - billPrepaid;
    private long BillRemaining => BillPayable - billPaid;

    private string DiscountPercentText
    {
        get
        {
            var total = BillTotalLive;
            if (total <= 0 || billDiscount <= 0) return "تخفیف: 0%";
            var pct = (decimal)billDiscount * 100m / total;
            return $"درصد تخفیف: {pct:0.#}%";
        }
    }

    private string CustomerBalanceChipText =>
        BillRemaining > 0 ? "بدهکار" : BillRemaining < 0 ? "بستانکار" : "تسویه";

    private string CustomerBalanceChipClass =>
        BillRemaining > 0 ? "iv-chip-status--neg" : BillRemaining < 0 ? "iv-chip-status--pos" : "iv-chip-status--ok";

    private void OnBillDiscountInput(ChangeEventArgs e)
