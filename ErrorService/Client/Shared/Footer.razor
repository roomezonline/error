@code {
    private FooterSettingsDto? footer;
    private string newsletterEmail = "";
    private string? newsletterMsg;
    private bool newsletterIsError;
    private bool newsletterBusy;

    private bool HasSocial =>
        footer != null && (!string.IsNullOrEmpty(footer.InstagramUrl) ||
                           !string.IsNullOrEmpty(footer.TelegramUrl) ||
                           !string.IsNullOrEmpty(footer.YouTubeUrl) ||
                           !string.IsNullOrEmpty(footer.LinkedInUrl) ||
                           !string.IsNullOrEmpty(footer.WhatsAppNumber));

    private bool HasAnyBadge =>
        footer != null && (!string.IsNullOrEmpty(footer.EnamadCode) ||
                           !string.IsNullOrEmpty(footer.SamandehiCode) ||
                           !string.IsNullOrEmpty(footer.EtaCode));

    private bool HasContact =>
        footer != null && (!string.IsNullOrEmpty(footer.PhoneNumber1) ||
                           !string.IsNullOrEmpty(footer.WhatsAppNumber) ||
                           !string.IsNullOrEmpty(footer.Email) ||
                           !string.IsNullOrEmpty(footer.Address));

    private readonly HashSet<int> _closedGroups = new();

    private bool IsOpen(int id) => !_closedGroups.Contains(id);

    private void ToggleGroup(int id)
    {
        if (!_closedGroups.Remove(id)) _closedGroups.Add(id);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            footer = await Http.GetFromJsonAsync<FooterSettingsDto>("api/footer");
        }
        catch
        {
            footer = GetDefaultFooter();
        }
    }

    private async Task ScrollTop()
    {
        await JSRuntime.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    private async Task SubscribeNewsletter()
    {
        var email = newsletterEmail?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(email)) { newsletterIsError = true; newsletterMsg = "لطفاً ایمیل خود را وارد کنید."; return; }
        var emailRegex = new System.Text.RegularExpressions.Regex(@"^[^@\s]+@[^@\s]+\.[^@\s]+$");
        if (!emailRegex.IsMatch(email)) { newsletterIsError = true; newsletterMsg = "فرمت ایمیل صحیح نیست."; return; }
        newsletterBusy = true;
        newsletterIsError = false;
        newsletterMsg = null;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/newsletter/subscribe", new { email });
            var result = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (resp.IsSuccessStatusCode)
            {
                newsletterIsError = false;
                newsletterMsg = result?.GetValueOrDefault("message") ?? "با موفقیت ثبت شد.";
                newsletterEmail = "";
            }
            else
            {
                newsletterIsError = true;
                newsletterMsg = result?.GetValueOrDefault("message") ?? "خطا در ثبت‌نام";
            }
        }
        catch
        {
            newsletterIsError = true;
            newsletterMsg = "خطا در ارتباط با سرور.";
        }
        finally
        {
            newsletterBusy = false;
        }
    }

