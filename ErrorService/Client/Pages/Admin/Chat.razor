    private async Task LoadSiteChatSettings()
    {
        _settingsLoading = true;
        try
        {
            var s = await Http.GetFromJsonAsync<JsonElement>("api/chat/site-settings");
            _siteEnableBale = s.TryGetProperty("enableBaleChat", out var eb) && eb.GetBoolean();
            _siteEnableTelegram = s.TryGetProperty("enableTelegramChat", out var et) && et.GetBoolean();
            _siteTelegramToken = s.TryGetProperty("telegramBotToken", out var tt) ? tt.GetString() ?? "" : "";
            _siteTelegramGroupId = s.TryGetProperty("telegramGroupId", out var tg) ? tg.GetString() ?? "" : "";
            _siteEnableEitaa = s.TryGetProperty("enableEitaaChat", out var ee) && ee.GetBoolean();
            _siteEitaaToken = s.TryGetProperty("eitaaBotToken", out var etk) ? etk.GetString() ?? "" : "";
            _siteEitaaGroupId = s.TryGetProperty("eitaaGroupId", out var eg) ? eg.GetString() ?? "" : "";
            _siteNotifyBale = !s.TryGetProperty("enableBaleNotifications", out var enb) || enb.GetBoolean();
            _siteNotifyTelegram = !s.TryGetProperty("enableTelegramNotifications", out var ent) || ent.GetBoolean();
            _siteNotifyEitaa = !s.TryGetProperty("enableEitaaNotifications", out var ene) || ene.GetBoolean();
            _siteBaleSafirKey = s.TryGetProperty("baleSafirApiKey", out var skb) ? skb.GetString() ?? "" : "";
            _siteWelcomeMessage = s.TryGetProperty("welcomeMessage", out var wm) ? wm.GetString() ?? "" : "";
            _siteEnableAutoMessage = s.TryGetProperty("enableAutoMessage", out var am) && am.GetBoolean();
            _siteAutoMessageSeconds = s.TryGetProperty("autoMessageSeconds", out var aSec) ? aSec.GetInt32() : 60;
            _sitePhoneRequired = s.TryGetProperty("phoneRequired", out var pr) && pr.GetBoolean();
            _siteEnableAi = s.TryGetProperty("enableAiAssistant", out var ai) && ai.GetBoolean();
            _siteAiProvider = s.TryGetProperty("aiProvider", out var aip) ? aip.GetString() ?? "" : "";
            _siteAiApiUrl = s.TryGetProperty("aiApiUrl", out var aiu) ? aiu.GetString() ?? "" : "";
            _siteAiModel = s.TryGetProperty("aiModel", out var aim) ? aim.GetString() ?? "" : "";
            _siteAiApiKey = s.TryGetProperty("aiApiKey", out var aik) ? aik.GetString() ?? "" : "";
            _siteAiSystemPrompt = s.TryGetProperty("aiSystemPrompt", out var asp) ? asp.GetString() ?? "" : "";
            _siteAiTopics = s.TryGetProperty("aiSuggestedTopics", out var ait) ? ait.GetString() ?? "" : "";
            _siteAiGuestEnabled = s.TryGetProperty("aiGuestEnabled", out var ag) && ag.GetBoolean();
            _siteAiDailyLimit = s.TryGetProperty("aiDailyLimit", out var adl) ? adl.GetInt32() : 3;
            _siteAiMaxQuestionChars = s.TryGetProperty("aiMaxQuestionChars", out var amqc) ? amqc.GetInt32() : 300;
            _siteAiMaxTokens = s.TryGetProperty("aiMaxTokens", out var amt) ? amt.GetInt32() : 450;
            _siteAiSessionLimit = s.TryGetProperty("aiSessionLimit", out var asl) ? asl.GetInt32() : 12;
            _siteAiTemperature = s.TryGetProperty("aiTemperature", out var at) && at.ValueKind == JsonValueKind.Number ? at.GetDouble() : 0.6;
            _siteAiBlockKeywords = s.TryGetProperty("aiBlockKeywords", out var abk) ? abk.GetString() : null;

            var modelVal = _siteAiModel;
            _siteAiModelChoice = AiModelOptions.Any(o => o.Id == modelVal) ? modelVal : "__custom__";
        }
        catch { }
        _settingsLoading = false;
    }

    private async Task SaveChatSiteSettings()
    {
        _savingSiteSettings = true;
        _siteSettingsMessage = null;
        try
        {
            var resp = await Http.PutAsJsonAsync("api/chat/site-settings", new
            {
                enableBaleChat = _siteEnableBale,
                baleBotToken = _baleToken,
                baleBotGroupId = _baleGroupId,
                enableTelegramChat = _siteEnableTelegram,
                telegramBotToken = _siteTelegramToken,
                telegramGroupId = _siteTelegramGroupId,
                enableEitaaChat = _siteEnableEitaa,
                eitaaBotToken = _siteEitaaToken,
                eitaaGroupId = _siteEitaaGroupId,
                enableBaleNotifications = _siteNotifyBale,
                enableTelegramNotifications = _siteNotifyTelegram,
                enableEitaaNotifications = _siteNotifyEitaa,
                baleSafirApiKey = _siteBaleSafirKey,
                welcomeMessage = _siteWelcomeMessage,
                enableAutoMessage = _siteEnableAutoMessage,
                autoMessageSeconds = _siteAutoMessageSeconds,
                phoneRequired = _sitePhoneRequired,
                enableAiAssistant = _siteEnableAi,
                aiProvider = _siteAiProvider,
                aiApiUrl = _siteAiApiUrl,
                aiModel = ResolveModelValue(),
                aiApiKey = _siteAiApiKey,
                aiSystemPrompt = _siteAiSystemPrompt,
                aiSuggestedTopics = _siteAiTopics,
                aiGuestEnabled = _siteAiGuestEnabled,
                aiDailyLimit = _siteAiDailyLimit,
                aiMaxQuestionChars = _siteAiMaxQuestionChars,
                aiMaxTokens = _siteAiMaxTokens,
                aiSessionLimit = _siteAiSessionLimit,
                aiTemperature = _siteAiTemperature,
                aiBlockKeywords = _siteAiBlockKeywords
            });
            _siteSettingsSuccess = resp.IsSuccessStatusCode;
            _siteSettingsMessage = _siteSettingsSuccess ? "تنظیمات چت ذخیره شد." : "خطا در ذخیره تنظیمات.";
        }
        catch
        {
            _siteSettingsSuccess = false;
            _siteSettingsMessage = "خطا در ارتباط با سرور.";
        }
        _savingSiteSettings = false;
    }

    private string ResolveModelValue()
    {
        if (_siteAiModelChoice == "__custom__") return _siteAiModel?.Trim() ?? "";
        return _siteAiModelChoice;
    }

    private async Task SaveAllSettings()
    {
        await SaveChatSiteSettings();
        var siteOk = _siteSettingsSuccess;

        await SaveBaleSettings();
