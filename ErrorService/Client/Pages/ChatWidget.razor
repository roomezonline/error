    private void PickEmojiMenu()
    {
        CloseAttach();
        _emojiOpen = !_emojiOpen;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnFilePicked(string payload)
    {
        if (string.IsNullOrEmpty(payload))
        {
            if (_pendingTempIds.TryDequeue(out var failedId))
                _messages.RemoveAll(m => m.Id == failedId);
            StateHasChanged();
            return;
        }
        if (_hub != null)
        {
            var fileInfo = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(payload);
            var url = fileInfo.GetProperty("url").GetString() ?? "";
            var fileName = fileInfo.GetProperty("fileName").GetString() ?? "فایل";
            var tempId = _nextTempId--;
            _pendingTempIds.Enqueue(tempId);
            _messages.Add(new ChatMessageDto
            {
                Id = tempId,
                SessionId = _sessionId,
                SenderType = ChatSenderTypeDto.User,
                Content = fileName,
                MessageType = ChatMessageTypeDto.File,
                MediaUrl = url,
                CreatedAt = DateTime.UtcNow,
                Status = ChatMessageStatusDto.Sending
            });
            ScrollToBottom();
            StateHasChanged();
            if (_hub?.State != HubConnectionState.Connected)
            {
                if (!await SendViaRestAsync(_sessionId, fileName, ChatMessageTypeDto.File, url))
                    await QueueOffline(_sessionId, fileName, ChatMessageTypeDto.File, url);
                return;
            }
            try { await _hub.InvokeAsync("SendMessage", _sessionId, fileName, ChatMessageTypeDto.File, url); }
            catch
            {
                if (!await SendViaRestAsync(_sessionId, fileName, ChatMessageTypeDto.File, url))
                    await QueueOffline(_sessionId, fileName, ChatMessageTypeDto.File, url);
            }
        }
    }

