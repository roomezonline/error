@code {
    private bool showDrawer = false;
    private bool showUserMenu = false;
    private bool showNotifPanel = false;
    private bool isNavigating = false;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private System.Threading.Timer? _notifTimer;
    private bool _showChat;
    private bool _disposed;

    private bool _hideBottomNav => Nav.Uri.Contains("/products/");
    private bool _isOnline = true;
    private bool _dismissedOfflineBanner;
    private string? _resumeDismissedKey;

    private bool _pwaInstallable;
    private bool _pwaStandalone;
    private bool _pwaIos;
    private bool _pwaMobile;
    private bool _pwaBannerDismissed;
    private const long PwaPublicReminderWindowMs = 7L * 24 * 60 * 60 * 1000; // 7 روز

    private bool ShowInstallBanner =>
        _pwaMobile && !_pwaStandalone && !_pwaBannerDismissed && (_pwaInstallable || _pwaIos)
        && !IsCheckoutFlowRoute();

    private UnfinishedOrderDto? ResumeOrder => Recovery.Resume.Order;
    private int ResumeCartCount => Recovery.Resume.Order != null ? 0 : CartService.GetTotalCount();

    private bool ShowResume(string key) => !IsCheckoutFlowRoute() && _resumeDismissedKey != key;

    private void DismissResume(string key) => _resumeDismissedKey = key;
    private string ResumeOrderKey(UnfinishedOrderDto o) => $"o:{o.Id}:{o.Status}";
    private string ResumeCartKey(int count) => $"c:{count}";

    private bool IsCheckoutFlowRoute()
    {
        var path = Nav.ToBaseRelativePath(Nav.Uri).ToLowerInvariant();
        return path.StartsWith("checkout")
            || path.StartsWith("cart")
            || path.StartsWith("payment/")
            || path.StartsWith("auth/")
            || path.StartsWith("profile")
            || path.StartsWith("admin/");
    }
    private DotNetObjectReference<MainLayout>? _onlineRef;

    private async Task ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
        if (showUserMenu)
        {
            showNotifPanel = false;
            await JS.InvokeVoidAsync("__um_addHandler", _dotNetRef);
        }
        else
        {
            await JS.InvokeVoidAsync("__um_removeHandler");
        }
    }

    private async Task ToggleNotifPanel()
    {
        showNotifPanel = !showNotifPanel;
        if (showNotifPanel)
        {
            if (showUserMenu)
            {
                showUserMenu = false;
                await JS.InvokeVoidAsync("__um_removeHandler");
            }
            await Notif.RefreshAsync();
        }
    }

    private void CloseNotifPanel() => showNotifPanel = false;

    private async Task InitPwaInstallAsync()
    {
        try
        {
            // ابتدا listener را وصل می‌کنیم تا رویداد زودهنگام beforeinstallprompt از دست نرود.
            if (_dotNetRef != null)
                await JS.InvokeVoidAsync("initPublicInstallHandler", _dotNetRef);

            _pwaStandalone = await JS.InvokeAsync<bool>("pwaIsStandalone")
                || await JS.InvokeAsync<bool>("pwaPublicIsInstalled");
            _pwaIos = await JS.InvokeAsync<bool>("pwaIsIos");
            _pwaMobile = await JS.InvokeAsync<bool>("pwaIsMobile");
            _pwaInstallable = await JS.InvokeAsync<bool>("getPwaInstallStatus");

            var dismissedAtRaw = await JS.InvokeAsync<string>("pwaPublicGetDismissedAt");
            if (!string.IsNullOrEmpty(dismissedAtRaw) && long.TryParse(dismissedAtRaw, out var ts))
            {
                var elapsed = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds() - ts;
                _pwaBannerDismissed = elapsed >= 0 && elapsed < PwaPublicReminderWindowMs;
            }

            StateHasChanged();
        }
        catch { }
    }

    [JSInvokable]
    public async Task NotifyPublicInstallAvailable()
    {
        try { _pwaInstallable = await JS.InvokeAsync<bool>("getPwaInstallStatus"); } catch { }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task NotifyPublicInstalled()
    {
        _pwaStandalone = true;
        _pwaBannerDismissed = true;
        try { await JS.InvokeVoidAsync("pwaPublicMarkInstalled"); } catch { }
        StateHasChanged();
    }

    private async Task InstallPublicApp()
    {
        try
        {
            if (await JS.InvokeAsync<bool>("installPWA"))
            {
                _pwaStandalone = true;
                await JS.InvokeVoidAsync("pwaPublicMarkInstalled");
            }
            else
            {
                // پرامپت مصرف شده (قبول یا رد) — وضعیت را تازه می‌کنیم تا دکمه بلااثر نماند.
                _pwaInstallable = await JS.InvokeAsync<bool>("getPwaInstallStatus");
            }
        }
        catch { }
        StateHasChanged();
    }

    private async Task DismissPublicInstall()
    {
        _pwaBannerDismissed = true;
        try { await JS.InvokeVoidAsync("pwaPublicSetDismissedAt", DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()); } catch { }
        StateHasChanged();
    }

    private async Task MarkAllReads() => await Notif.MarkAllReadAsync();

    private async Task OpenNotif(NotificationDto item)
    {
        showNotifPanel = false;
        if (!item.IsRead)
            await Notif.MarkReadAsync(item.Id);
        if (!string.IsNullOrWhiteSpace(item.ActionUrl))
            Nav.NavigateTo(item.ActionUrl);
