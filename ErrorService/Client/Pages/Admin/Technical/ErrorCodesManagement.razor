    }
</style>

@code {
    private List<ErrorCode> errorCodes = new();
    private List<ErrorCode> filteredCodes = new();
    private ErrorCode editingItem = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isSubmitting = false;
    private bool isImporting = false;
    private IBrowserFile? selectedFile;
    private string searchQuery = "";
    private string[]? existingBrands;

    private int brandCount => filteredCodes.Select(x => x.Brand).Distinct().Count();
    private int deviceCount => filteredCodes.Select(x => x.DeviceType).Distinct().Count();

    protected override async Task OnInitializedAsync() => await LoadData();

    private string TruncateText(string text, int max) =>
        text.Length <= max ? text : text[..max] + "...";

    private void FilterList()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredCodes = errorCodes;
        }
        else
        {
            var q = searchQuery.Trim().ToLower();
            filteredCodes = errorCodes.Where(x =>
                (x.Brand != null && x.Brand.ToLower().Contains(q)) ||
                (x.DeviceType != null && x.DeviceType.ToLower().Contains(q)) ||
                (x.Code != null && x.Code.ToLower().Contains(q)) ||
                (x.Description != null && x.Description.ToLower().Contains(q))
            ).ToList();
        }
    }

    private void OnBrandSelected(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        if (!string.IsNullOrEmpty(val))
        {
            editingItem.Brand = val;
        }
    }

    private void ClearSearch()
    {
        searchQuery = "";
        FilterList();
    }

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
    }

    private async Task ImportJson()
    {
        if (selectedFile == null) return;

        isImporting = true;
        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 10);
            var items = await System.Text.Json.JsonSerializer.DeserializeAsync<List<ErrorCodeImportModel>>(stream, new System.Text.Json.JsonSerializerOptions
            {
                PropertyNameCaseInsensitive = true
            });

            if (items == null || !items.Any())
            {
                Toast.ShowError("فایل انتخابی خالی است یا فرمت اشتباه دارد");
                return;
            }

            var response = await Http.PostAsJsonAsync("api/technical/error-codes/import", items);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ErrorCodeImportResult>();
                Toast.ShowSuccess($"عملیات با موفقیت انجام شد. جدید: {result?.InsertedCount}، بروزرسانی: {result?.UpdatedCount}");
                selectedFile = null;
                await LoadData();
            }
            else
            {
                Toast.ShowError("خطا در ارسال اطلاعات به سرور");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"خطا در پردازش فایل: {ex.Message}");
        }
        finally
        {
            isImporting = false;
        }
    }

    private async Task LoadData()
    {
        isLoading = true;
        try {
            var codesTask = Http.GetFromJsonAsync<List<ErrorCode>>("api/technical/error-codes");
            var brandsTask = Http.GetFromJsonAsync<string[]>("api/technical/error-codes/brands");
            await Task.WhenAll(codesTask, brandsTask);
            errorCodes = codesTask.Result ?? new();
            existingBrands = brandsTask.Result;
            FilterList();
        } catch {
            Toast.ShowError("خطا در بارگذاری اطلاعات");
        }
        isLoading = false;
    }

    private void OpenModal(ErrorCode? item = null)
    {
        editingItem = item != null ? new ErrorCode {
            Id = item.Id, Brand = item.Brand, DeviceType = item.DeviceType,
            Code = item.Code, Description = item.Description,
            Solution = item.Solution, TechnicalNotes = item.TechnicalNotes,
            ImageUrl = item.ImageUrl
        } : new ErrorCode();
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try {
            if (editingItem.Id == 0)
                await Http.PostAsJsonAsync("api/technical/error-codes", editingItem);
            else
                await Http.PutAsJsonAsync($"api/technical/error-codes/{editingItem.Id}", editingItem);

            Toast.ShowSuccess("با موفقیت ذخیره شد");
            CloseModal();
            await LoadData();
        } catch {
            Toast.ShowError("خطا در عملیات ذخیره‌سازی");
        }
        isSubmitting = false;
    }

    private async Task DeleteErrorCode(int id)
    {
        var response = await Http.DeleteAsync($"api/technical/error-codes/{id}");
        if (response.IsSuccessStatusCode) {
            Toast.ShowSuccess("با موفقیت حذف شد");
            await LoadData();
        } else {
            Toast.ShowError("خطا در حذف");
        }
    }
}
