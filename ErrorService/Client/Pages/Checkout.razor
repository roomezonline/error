@page "/checkout"
@using ErrorService.Client.Services
@using ErrorService.Shared
@using System.Net.Http.Json
@inject CartService CartService
@inject HttpClient Http
@inject NavigationManager Nav
@inject ToastService ToastService
@inject ErrorService.Client.Services.CheckoutRecoveryService Recovery
@inject AuthService AuthService
@inject IJSRuntime JS

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<PageTitle>ثبت سفارش - ارورسرویس</PageTitle>

<div class="checkout-page" dir="rtl">
    <div class="container py-4">
        <div class="d-flex align-items-center gap-3 mb-5 px-1">
            <a href="/cart" class="btn-back">
                <span class="oi oi-arrow-right"></span>
            </a>
            <h1 class="page-title">تکمیل سفارش</h1>
        </div>

        @if (!CartService.GetItems().Any() && !isProcessing)
        {
            <div class="empty-state animate__animated animate__fadeIn">
                <div class="empty-icon"><span class="oi oi-warning"></span></div>
                <h3 class="empty-title">سبد خرید خالی شده</h3>
                <p class="empty-desc">محصولی در سبد شما وجود ندارد</p>
                <a href="/products" class="btn btn-primary-custom px-5 py-3">بازگشت به فروشگاه</a>
            </div>
        }
        else
        {
            <div class="checkout-grid">
                <div class="checkout-main">
                    @if (_resumedDraft)
                    {
                        <div class="co-resume-note" role="status">
                            <span class="oi oi-reload"></span>
                            اطلاعات قبلی شما بازیابی شد؛ از همان‌جا ادامه دهید.
                        </div>
                    }
                    <div class="section-card animate__animated animate__fadeInUp" id="co-step-receiver">
                        <div class="section-header">
                            <div class="step-num">۱</div>
                            <div>
                                <h2 class="section-title">اطلاعات تحویل‌گیرنده</h2>
                                <p class="section-desc">مشخصات گیرنده سفارش را وارد کنید</p>
                            </div>
                        </div>

                        <EditForm EditContext="editContext">
                            <DataAnnotationsValidator />
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="field-group">
                                        <label class="field-label">نام و نام خانوادگی</label>
                                        <InputText @bind-Value="request.FullName" class="field-input" placeholder="مثال: علی رضایی" />
                                        <ValidationMessage For="@(() => request.FullName)" class="field-error" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="field-group">
                                        <label class="field-label">شماره موبایل</label>
                                        <InputText @bind-Value="request.PhoneNumber" class="field-input" placeholder="09123456789" inputmode="numeric" />
                                        <ValidationMessage For="@(() => request.PhoneNumber)" class="field-error" />
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="field-group">
                                        <label class="field-label">ایمیل <span class="optional">(اختیاری)</span></label>
                                        <InputText @bind-Value="request.Email" class="field-input" placeholder="mail@example.com" />
                                    </div>
                                </div>
                                @if (StructuredAddressEnabled)
                                {
                                    <div class="col-md-6">
                                        <div class="field-group">
                                            <label class="field-label">استان @if (RequireProvinceCity) { <span class="req">*</span> }</label>
                                            <select class="field-input" value="@(request.ProvinceId?.ToString() ?? "")" @onchange="OnProvinceChanged">
                                                <option value="">انتخاب استان</option>
                                                @foreach (var p in _provinces)
                                                {
                                                    <option value="@p.Id">@p.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="field-group">
                                            <label class="field-label">شهر @if (RequireProvinceCity) { <span class="req">*</span> }</label>
                                            <select class="field-input" value="@(request.CityId?.ToString() ?? "")" @onchange="OnCityChanged" disabled="@(!request.ProvinceId.HasValue || _citiesLoading)">
                                                <option value="">@(request.ProvinceId.HasValue ? "انتخاب شهر" : "ابتدا استان را انتخاب کنید")</option>
                                                @foreach (var c in _cities)
                                                {
                                                    <option value="@c.Id">@c.Name</option>
                                                }
                                            </select>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="field-group">
                                            <label class="field-label">کد پستی @if (RequirePostalCode) { <span class="req">*</span> } else { <span class="optional">(اختیاری)</span> }</label>
                                            <InputText @bind-Value="request.PostalCode" class="field-input" placeholder="مثال: 1234567890" inputmode="numeric" maxlength="10" dir="ltr" />
                                        </div>
                                        <div class="field-hint">کد پستی ۱۰ رقمی بدون خط تیره یا فاصله.</div>
                                    </div>
                                }
                                <div class="col-12">
                                    <div class="field-group">
                                        <label class="field-label">آدرس پستی</label>
                                        <InputTextArea @bind-Value="request.Address" class="field-input" style="height: 110px" placeholder="@(StructuredAddressEnabled ? "خیابان، کوچه، پلاک، واحد و نشانه‌های محلی" : "آدرس دقیق شامل استان، شهر، خیابان و...")" />
                                        <ValidationMessage For="@(() => request.Address)" class="field-error" />
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="field-group">
                                        <label class="field-label">روش ارسال</label>
                                        <div class="ship-grid" id="co-step-shipping">
                                            @foreach (var m in _shippingMethods)
                                            {
                                                <button type="button" class="ship-option @(_selectedShippingMethodId == m.Id ? "ship-option--active" : "")" @onclick="() => SelectShippingMethod(m.Id)">
                                                    <div class="ship-option__body">
                                                        <span class="ship-option__name">@m.Name</span>
                                                        @if (!string.IsNullOrEmpty(m.EstimatedDays))
                                                        {
                                                            <span class="ship-option__days">@m.EstimatedDays</span>
                                                        }
                                                    </div>
                                                    <span class="ship-option__price">
                                                        @if (m.IsFree)
                                                        {
                                                            <span class="text-success fw-bold">رایگان</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@m.Price.ToString("N0") <small>تومان</small></span>
                                                        }
                                                    </span>
                                                    <span class="ship-option__check @(_selectedShippingMethodId == m.Id ? "ship-option__check--on" : "")"><span class="oi oi-check"></span></span>
                                                </button>
                                            }
                                        </div>
                                        @if (!_shippingMethods.Any())
                                        {
                                            <div class="field-hint">روش ارسالی فعال نیست</div>
                                        }
                                        @if (FreeShippingEnabled)
                                        {
                                            var _fsTotal = CartService.GetTotalAmount();
                                            var _fsThreshold = _shop!.FreeShippingThreshold ?? 0;
                                            var _fsRemaining = _fsThreshold - _fsTotal;
                                            var _fsPct = _fsThreshold > 0 ? (int)Math.Min(100, Math.Max(0, _fsTotal * 100 / _fsThreshold)) : 0;
                                            <div class="co-fs @(_fsRemaining <= 0 ? "co-fs--done" : "")">
                                                <span class="oi oi-truck"></span>
                                                <div class="co-fs__body">
                                                    @if (_fsRemaining <= 0)
                                                    {
                                                        <strong>تبریک! ارسال این سفارش رایگان است</strong>
                                                    }
                                                    else
                                                    {
                                                        <strong>تا ارسال رایگان @_fsRemaining.ToString("N0") تومان مانده است</strong>
                                                        <div class="co-fs__track"><span class="co-fs__fill" style="width:@(_fsPct)%"></span></div>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="checkout-form-end-spacer"></div>
                        </EditForm>
                    </div>

                    <!-- Payment method (outside form) -->
                    <div class="section-card animate__animated animate__fadeInUp checkout-section-payment" id="co-step-payment">
                        <div class="field-group">
                            <label class="field-label">روش پرداخت</label>
                            <div class="pm-grid">
                                <button type="button" class="pm-option pm-option--active" @onclick="SelectManual">
                                    <span class="oi oi-credit-card pm-option__ico"></span>
                                    <span>
                                        <span class="pm-option__title d-block">کارت‌به‌کارت</span>
                                        <span class="pm-option__desc d-block">واریز و آپلود رسید</span>
                                    </span>
                                    <span class="pm-option__check pm-option__check--on"><span class="oi oi-check"></span></span>
                                </button>
                                @foreach (var g in _gateways)
                                {
                                    <button type="button" class="pm-option @(_selectedGatewayId == g.Id ? "pm-option--active" : "")" @onclick="() => SelectGateway(g.Id)">
                                        <span class="oi oi-globe pm-option__ico pm-option__ico--online"></span>
                                        <span>
                                            <span class="pm-option__title d-block">@g.Title</span>
                                            <span class="pm-option__desc d-block">پرداخت آنلاین</span>
                                        </span>
                                        <span class="pm-option__check @(_selectedGatewayId == g.Id ? "pm-option__check--on" : "")"><span class="oi oi-check"></span></span>
                                    </button>
                                }
                            </div>
                            @if (_gateways.Count == 0)
                            {
                                <div class="field-hint">در حال حاضر درگاه پرداخت آنلاین فعال نیست.</div>
                            }
                        </div>
                    </div>

                    <!-- Submit button (always last) -->
                    <div class="checkout-submit-section">
                        <button type="button" class="btn btn-primary-custom py-3 w-100" @onclick="TriggerFormSubmit" disabled="@isProcessing">
                            @if (isProcessing) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            تایید و پرداخت نهایی
                        </button>
                    </div>
                </div>

                <div class="checkout-sidebar">
                    <div class="summary-card animate__animated animate__fadeInRight">
                        <div class="section-header">
                            <div class="step-num step-num--ok">۲</div>
                            <h2 class="section-title">خلاصه سفارش</h2>
                        </div>

                        <div class="order-items">
                            @foreach (var item in CartService.GetItems())
                            {
                                <div class="order-item">
                                    <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                                        <span class="qty-badge">@item.Quantity</span>
                                        <span class="order-item-name">@item.Name</span>
                                    </div>
                                    <span class="order-item-price">@((item.Price * item.Quantity).ToString("N0")) <small>ت</small></span>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(request.FullName) || !string.IsNullOrWhiteSpace(request.PhoneNumber))
                        {
                            <div class="summary-info">
                                @if (!string.IsNullOrWhiteSpace(request.FullName))
                                {
                                    <div class="summary-info-row">
                                        <span class="summary-info-label"><span class="oi oi-person"></span> نام</span>
                                        <span class="summary-info-val">@request.FullName</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(request.PhoneNumber))
                                {
                                    <div class="summary-info-row">
                                        <span class="summary-info-label"><span class="oi oi-phone"></span> موبایل</span>
                                        <span class="summary-info-val ltr" dir="ltr">@request.PhoneNumber</span>
                                    </div>
                                }
                                @if (StructuredAddressEnabled && !string.IsNullOrWhiteSpace(AddressRegionText))
                                {
                                    <div class="summary-info-row">
                                        <span class="summary-info-label"><span class="oi oi-map-marker"></span> استان/شهر</span>
                                        <span class="summary-info-val">@AddressRegionText</span>
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(request.Address) && request.Address.Length > 5)
                                {
                                    <div class="summary-info-row">
                                        <span class="summary-info-label"><span class="oi oi-location"></span> آدرس</span>
                                        <span class="summary-info-val summary-info-val--addr">@request.Address</span>
                                    </div>
                                }
                                @if (StructuredAddressEnabled && !string.IsNullOrWhiteSpace(request.PostalCode))
                                {
                                    <div class="summary-info-row">
                                        <span class="summary-info-label"><span class="oi oi-home"></span> کد پستی</span>
                                        <span class="summary-info-val ltr" dir="ltr">@request.PostalCode</span>
                                    </div>
                                }
                                @if (_selectedShippingMethodId.HasValue)
                                {
                                    <div class="summary-info-row">
                                        <span class="summary-info-label"><span class="oi oi-truck"></span> ارسال</span>
                                        <span class="summary-info-val">@_shippingName</span>
                                    </div>
                                }
                                <div class="summary-info-row">
                                    <span class="summary-info-label"><span class="oi oi-credit-card"></span> پرداخت</span>
                                    <span class="summary-info-val">@(_selectedGatewayId.HasValue ? "پرداخت آنلاین" : "کارت‌به‌کارت")</span>
                                </div>
                            </div>
                        }

                        <div class="price-breakdown">
                            <div class="price-row">
                                <span>جمع کل</span>
                                <span>@CartService.GetTotalAmount().ToString("N0") <small>تومان</small></span>
                            </div>
                            <div class="price-row price-row--ship">
                                <span>ارسال (@_shippingName)</span>
                                @if (_selectedShippingMethodId.HasValue && EffectiveShippingCost <= 0)
                                {
                                    <span class="text-success">رایگان</span>
                                }
                                else
                                {
                                    <span>@EffectiveShippingCost.ToString("N0") <small>تومان</small></span>
                                }
                            </div>
                            @if (_couponDiscount > 0)
                            {
                                <div class="price-row price-row--discount">
                                    <span>تخفیف (<span class="ltr">@_couponCode</span>)</span>
                                    <span class="text-danger">-@_couponDiscount.ToString("N0") <small>تومان</small></span>
                                </div>
                                @if (_couponPercent.HasValue && _couponPercent.Value > 0)
                                {
                                    <div class="price-row" style="font-size:0.72rem;color:#94a3b8;">
                                        <span>@($"(%{_couponPercent.Value} درصد)")</span>
                                    </div>
                                }
                            }
                        </div>

                        <div class="coupon-section" id="co-step-coupon">
                            <div class="coupon-row">
                                <input type="text" class="coupon-input" placeholder="کد تخفیف دارید؟" value="@_couponInput"
                                       @oninput="OnCouponInputChanged" disabled="@(_couponApplied || _couponLoading)" />
                                @if (_couponApplied)
                                {
                                    <button type="button" class="coupon-btn coupon-btn--remove" @onclick="RemoveCoupon">
                                        <span class="oi oi-x"></span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="coupon-btn @(_couponLoading ? "coupon-btn--loading" : "")"
                                            @onclick="ApplyCoupon" disabled="@(_couponLoading || string.IsNullOrWhiteSpace(_couponInput))">
                                        @if (_couponLoading)
                                        {
                                            <span class="coupon-spinner"></span> <span>در حال بررسی...</span>
                                        }
                                        else
                                        {
                                            <span>اعمال</span>
                                        }
                                    </button>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(_couponMessage))
                            {
                                <div class="coupon-message @(_couponApplied ? "coupon-ok" : "coupon-err")">@_couponMessage</div>
                            }
                            @if (_couponApplied && _couponDiscount > 0)
                            {
                                <div class="coupon-applied-detail">
                                    <span class="coupon-applied-check"><span class="oi oi-circle-check"></span></span>
                                    <div class="coupon-applied-info">
                                        <span class="coupon-applied-code ltr">@_couponCode</span>
                                        @if (_couponPercent.HasValue && _couponPercent.Value > 0)
                                        {
                                            <span class="coupon-applied-desc">@_couponPercent.Value٪ تخفیف — @(_couponDiscount.ToString("N0")) تومان</span>
                                        }
                                        else
                                        {
                                            <span class="coupon-applied-desc">@(_couponDiscount.ToString("N0")) تومان تخفیف</span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="price-total">
                            <span>مبلغ نهایی</span>
                            <span class="price-total-amount">@((CartService.GetTotalAmount() + EffectiveShippingCost - _couponDiscount).ToString("N0")) <small>تومان</small></span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .checkout-page { background: var(--shop-bg, #f8fafc); min-height: 100vh; }

    .btn-back {
        width: 42px; height: 42px; display: grid; place-items: center; flex-shrink: 0;
        background: var(--shop-surface, #fff); color: var(--shop-text, #1e293b);
        text-decoration: none; border: 1px solid var(--shop-border, #e2e8f0); border-radius: 12px;
    }
    .btn-back:active { transform: scale(0.95); }

    .page-title { font-size: 1.25rem; font-weight: 800; margin: 0; color: var(--shop-text, #0f172a); }

    .empty-state {
        text-align: center; padding: 60px 24px;
        background: var(--shop-surface, #fff); border: 1px solid var(--shop-border, #e2e8f0); border-radius: 24px;
    }
    .empty-icon { width: 80px; height: 80px; margin: 0 auto 20px; background: #fef3c7; border-radius: 24px; display: grid; place-items: center; font-size: 2rem; color: #f59e0b; }
    .empty-title { font-size: 1.1rem; font-weight: 800; margin-bottom: 8px; }
    .empty-desc { font-size: 0.85rem; color: #94a3b8; margin-bottom: 28px; }

    .checkout-grid {
        display: flex; flex-direction: column; gap: 16px;
    }

    .checkout-main { display: flex; flex-direction: column; gap: 16px; }
    .checkout-sidebar { order: -1; }
    .checkout-section-payment { margin: 0; }
    .checkout-form-end-spacer { height: 0; }
    .checkout-submit-section { margin-top: 0; }

    .section-card {
        background: var(--shop-surface, #fff); border: 1px solid var(--shop-border, #f1f5f9);
        border-radius: 20px; padding: 28px;
    }

    .co-resume-note {
        display: flex; align-items: center; gap: 8px;
        background: #eef2ff; color: #1e3a8a; border: 1px solid #c7d2fe;
        border-radius: 14px; padding: 10px 14px;
        font-size: 0.82rem; font-weight: 700;
    }
    .co-resume-note .oi { color: #1d4ed8; }
    .co-highlight {
        animation: coHighlightPulse 1.4s ease-in-out 3;
        border-color: var(--shop-primary, #4f46e5) !important;
        box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.18);
    }
    @@keyframes coHighlightPulse {
        0%, 100% { box-shadow: 0 0 0 3px rgba(79, 70, 229, 0.18); }
        50% { box-shadow: 0 0 0 8px rgba(79, 70, 229, 0.10); }
    }

    .section-header { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 28px; }
    .step-num {
        width: 36px; height: 36px; flex-shrink: 0; display: grid; place-items: center;
        background: #f1f5f9; color: var(--shop-primary, #4f46e5); border-radius: 12px;
        font-size: 0.8rem; font-weight: 800;
    }
    .step-num--ok { background: #dcfce7; color: #16a34a; }
    .section-title { font-size: 1rem; font-weight: 800; margin: 0 0 2px; }
    .section-desc { font-size: 0.78rem; color: #94a3b8; margin: 0; }

    .field-group { margin-bottom: 4px; }
    .field-label { display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 6px; }
    .field-label .optional { font-weight: 500; color: #cbd5e1; }
    .field-label .req { color: #dc2626; }
    .field-hint { font-size: 0.72rem; color: #94a3b8; margin-top: 4px; }
    select.field-input { cursor: pointer; padding-inline-end: 34px; }
    select.field-input:disabled { background: #f1f5f9; color: #94a3b8; cursor: not-allowed; }
    .field-input {
        width: 100%; padding: 13px 16px; font-size: 0.88rem;
        border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc;
        color: var(--shop-text, #1e293b); transition: border-color 0.15s, box-shadow 0.15s;
        outline: none;
    }
    .field-input:focus { border-color: var(--shop-primary, #4f46e5); box-shadow: 0 0 0 3px rgba(79,70,229,0.08); background: #fff; }
    .field-input::placeholder { color: #cbd5e1; }

    .form-control.modified.invalid { border-color: #ef4444 !important; background-color: rgba(239,68,68,0.03) !important; }
    .form-control.modified.valid { border-color: #10b981 !important; background-color: rgba(16,185,129,0.03) !important; }
    .form-control.invalid:focus { box-shadow: 0 0 0 3px rgba(239,68,68,0.1) !important; }
    .form-control.valid:focus { box-shadow: 0 0 0 3px rgba(16,185,129,0.1) !important; }
    .validation-message { font-size: 0.75rem; color: #ef4444; margin-top: 4px; font-weight: 600; }

    .summary-card {
        background: var(--shop-surface, #fff); border: 1px solid var(--shop-border, #f1f5f9);
        border-radius: 20px; padding: 24px; top: 90px;
    }

    .order-items { display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px; }
    .order-item {
        display: flex; align-items: center; justify-content: space-between; gap: 6px;
        padding: 8px 10px; background: #f8fafc; border-radius: 10px;
    }
    .qty-badge {
        width: 24px; height: 24px; flex-shrink: 0; display: grid; place-items: center;
        background: #fff; border: 1px solid #e2e8f0; border-radius: 6px;
        font-size: 0.7rem; font-weight: 800; color: var(--shop-primary, #4f46e5);
    }
    .order-item-name { font-size: 0.8rem; font-weight: 600; color: var(--shop-text, #1e293b); overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.4; }
    .order-item-price { font-size: 0.8rem; font-weight: 800; color: var(--shop-primary, #4f46e5); white-space: nowrap; flex-shrink: 0; }

    .price-breakdown { display: flex; flex-direction: column; gap: 8px; padding: 14px 0; border-top: 1px solid #f1f5f9; }
    .price-row { display: flex; justify-content: space-between; font-size: 0.82rem; color: #64748b; }
    .price-row--ship { font-size: 0.78rem; }
