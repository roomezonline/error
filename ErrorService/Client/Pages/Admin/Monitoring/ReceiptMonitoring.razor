@code {
    [Parameter] public int ReceiptId { get; set; }

    private bool isLoading = true;
    private bool isSubmitting = false;
    private CustomerReceiptDto? receipt;
    private List<MonitoringDeviceDto>? activeMonitoringDevices;
    private int selectedDeviceId;
    private bool isSuperAdmin;
    private int? selectedWorkshopId;
    private int _workshopUsed;
    private int _workshopMax;
    private bool _capacityFull;
    private int _targetWorkshopId;

    protected override async Task OnInitializedAsync()
    {
        // بررسی نقش کاربر
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        isSuperAdmin = state.User.IsInRole("super_admin");

        if (isSuperAdmin)
        {
            await AdminWorkshopSelection.InitializeAsync();
            selectedWorkshopId = AdminWorkshopSelection.SelectedWorkshopId;
            AdminWorkshopSelection.OnChanged += HandleWorkshopChanged;
        }

        await LoadData();
    }

    // متد بروزرسانی دستی
    private async Task RefreshData()
    {
        if (isSuperAdmin)
        {
            selectedWorkshopId = AdminWorkshopSelection.SelectedWorkshopId;
        }
        await LoadData();
        StateHasChanged();
        ToastService.ShowSuccess($"لیست دستگاه‌ها برای کارگاه {selectedWorkshopId} بروزرسانی شد");
    }

    private void HandleWorkshopChanged(int? workshopId)
    {
        selectedWorkshopId = workshopId;
        _ = InvokeAsync(async () =>
        {
            await LoadData();
            StateHasChanged();
        });
    }

    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            selectedDeviceId = 0;

            // دریافت اطلاعات رسید
            receipt = await Http.GetFromJsonAsync<CustomerReceiptDto>($"api/customer-receipts/{ReceiptId}");

            if (receipt == null)
            {
                ToastService.ShowError("رسید مورد نظر یافت نشد");
                return;
            }

            // تعیین کارگاه هدف
            // اولویت: receipt.WorkshopId > selectedWorkshopId
            // (همانند ReceiptsList و WorkshopApiHelper.ResolveWorkshopId)

            if (receipt.WorkshopId > 0)
            {
                _targetWorkshopId = receipt.WorkshopId;
            }
            else if (isSuperAdmin && selectedWorkshopId.HasValue && selectedWorkshopId.Value > 0)
            {
                _targetWorkshopId = selectedWorkshopId.Value;
            }
            else
            {
                activeMonitoringDevices = new List<MonitoringDeviceDto>();
                return;
            }

            // دریافت ظرفیت مانیتورینگ کارگاه
            try
            {
                var cap = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/monitoring-receipts/workshop-capacity?workshopId={_targetWorkshopId}");
                _workshopUsed = cap.GetProperty("used").GetInt32();
                _workshopMax = cap.GetProperty("max").GetInt32();
                _capacityFull = !cap.GetProperty("canConnect").GetBoolean();
            }
            catch { _capacityFull = false; }

            // دریافت دستگاه‌های آماده اتصال برای کارگاه (حذف دستگاه‌های مشغول)
            activeMonitoringDevices = await Http.GetFromJsonAsync<List<MonitoringDeviceDto>>($"api/monitoring-devices/workshop-devices?workshopId={_targetWorkshopId}") ?? new();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ConfirmConnection()
    {
        if (selectedDeviceId == 0) return;

        try
        {
            isSubmitting = true;

            var req = new MonitoringReceiptConnectRequest
                {
                    CustomerReceiptId = ReceiptId,
                    MonitoringDeviceId = selectedDeviceId
                };

            var resp = await Http.PostAsJsonAsync("api/monitoring-receipts/connect", req);
            if (!resp.IsSuccessStatusCode)
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(msg) ? "خطا در ثبت اتصال" : msg);
                return;
            }

            ToastService.ShowSuccess("اتصال با موفقیت ثبت شد");
            Navigation.NavigateTo("/admin/monitoring/active-receipts");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در ثبت اتصال");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    public void Dispose()
    {
        if (isSuperAdmin)
        {
            AdminWorkshopSelection.OnChanged -= HandleWorkshopChanged;
        }
    }
}