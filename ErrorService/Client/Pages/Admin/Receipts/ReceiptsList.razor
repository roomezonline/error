@page "/admin/receipts"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.receipts.view")]
@using ErrorService.Shared
@using ErrorService.Client.Helpers
@using Microsoft.AspNetCore.Components.Forms
@using System.Net.Http.Json
@inject NavigationManager Navigation
@inject HttpClient Http
@inject IJSRuntime JS
@inject ErrorService.Client.Services.ToastService ToastService
@inject ErrorService.Client.Services.AdminWorkshopSelectionService AdminWorkshopSelection
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>لیست رسیدها</PageTitle>

<script src="/js/intersection-observer.js"></script>

<ConfirmDialog IsVisible="showConfirmDelete"
               Title="حذف رسید"
               Message="آیا از حذف این رسید اطمینان دارید؟"
               ConfirmText="حذف"
               OnResult="HandleDeleteResult" />

<ConfirmDialog IsVisible="showConfirmDeleteCommitment"
               Title="حذف تعهدنامه"
               Message="آیا از حذف این تعهدنامه اطمینان دارید؟"
               ConfirmText="حذف"
               OnResult="HandleDeleteCommitmentResult" />

@if (_showCommitmentModal)
{
    <div class="rl-modal-overlay rl-modal-overlay--commitment" @onclick="CloseCommitmentModal">
        <div class="rl-modal rl-modal--commitment" @onclick:stopPropagation>
            <div class="rl-modal__head">
                <div class="rl-modal__title">
                    <span class="oi oi-document-text" style="margin-left: 8px;"></span>
                    @(_isNewCommitment ? "ایجاد تعهد نامه" : "مشاهده تعهد نامه")
                </div>
                @if (!_isNewCommitment && _commitmentDto != null)
                {
                    <div class="rl-modal__actions">
                        <button type="button" class="rl-btn-icon" title="دانلود PDF" @onclick="ExportPdf">
                            <span class="oi oi-file"></span>
                        </button>
                        <button type="button" class="rl-btn-icon" title="دانلود عکس" @onclick="ExportImage">
                            <span class="oi oi-image"></span>
                        </button>
                        <button type="button" class="rl-btn-icon" title="اشتراک‌گذاری" @onclick="ExportShare">
                            <span class="oi oi-share"></span>
                        </button>
                    </div>
                }
                <button type="button" class="rl-modal__close" @onclick="CloseCommitmentModal"><span class="oi oi-x"></span></button>
            </div>
            <div class="rl-modal__body">
                @if (_commitmentLoading)
                {
                    <div class="rl-loading-inline"><div class="spinner-border spinner-border-sm text-primary"></div> در حال بارگذاری...</div>
                }
                else if (_commitmentDto != null)
                {
                    <div class="rl-commitment-preview">
                        <div class="rl-commitment-header">
                            <div class="rl-commitment-title-group">
                                <div class="rl-commitment-workshop">@_commitmentDto.WorkshopName</div>
                                <div class="rl-commitment-title">تعهدنامه</div>
                            </div>
                            <div class="rl-commitment-meta">
                                <div>شماره پذیرش: @_commitmentDto.ReceiptNumber</div>
                                <div>تاریخ: @_commitmentDto.RegisteredAtFa</div>
                            </div>
                        </div>
                        <div class="rl-commitment-body">
                            @if (_isNewCommitment && _isEditing)
                            {
                                <div class="rl-commitment-body-text rl-commitment-body-text--full">
                                    @_commitmentPreviewBodyBefore
                                    متعهد می‌شوم
                                    <span class="rl-commitment-typed-text">@(string.IsNullOrWhiteSpace(CommitmentExtraText) ? "...." : CommitmentExtraText)</span>
                                    @_commitmentPreviewBodyAfter
                                </div>
                                <textarea class="rl-commitment-extra-text" @bind="CommitmentExtraText" @bind:event="oninput"
                                          placeholder="متن اضافی را اینجا تایپ کنید..." rows="3"></textarea>
                            }
                            else
                            {
                                <div class="rl-commitment-body-text" style="white-space: pre-line;">@_commitmentDto.FullBodyText</div>
                            }
                        </div>
                        <div class="rl-commitment-signature">
                            <div class="rl-commitment-signature-line"></div>
                            <div class="rl-commitment-signature-name">@_commitmentDto.CustomerFullName</div>
                        </div>
                        @if (!_isNewCommitment)
                        {
                            <div class="rl-commitment-status-bar">
                                @if (_commitmentDto.Status == "signed")
                                {
                                    <span class="rl-badge rl-badge--settled" style="font-size:0.85rem;">
                                        <span class="oi oi-check" style="margin-left:4px;"></span> امضا شده در @_commitmentDto.SignedAtFa
                                    </span>
                                }
                                else
                                {
                                    <span class="rl-badge rl-badge--pending">
                                        <span class="oi oi-time" style="margin-left:4px;"></span> در انتظار امضا
                                    </span>
                                }
                            </div>
                        }
                        @if (_commitmentDto.Status == "signed" && (!string.IsNullOrEmpty(_commitmentDto.SenderLineNumber) || !string.IsNullOrEmpty(_commitmentDto.VerificationCode)))
                        {
                            <div class="rl-commitment-footer-note">
                                <strong>تذکر:</strong>
                                @if (!string.IsNullOrEmpty(_commitmentDto.SenderLineNumber))
                                {
                                    <span>شماره خط ارسال‌کننده: @_commitmentDto.SenderLineNumber</span>
                                }
                                @if (!string.IsNullOrEmpty(_commitmentDto.VerificationCode))
                                {
                                    <span>کد فعال‌سازی: @_commitmentDto.VerificationCode</span>
                                }
                            </div>
                        }
                    </div>
                }
                else if (!_isNewCommitment)
                {
                    <div class="rl-empty-sm">تعهدنامه‌ای برای این رسید یافت نشد</div>
                }
            </div>
            <div class="rl-modal__foot">
                @if (_isNewCommitment && _isEditing)
                {
                    <button type="button" class="rl-btn rl-btn--primary" @onclick="CreateCommitment" disabled="@_commitmentSaving">
                        @if (_commitmentSaving)
                        {
                            <span class="spinner-border spinner-border-sm" style="margin-left:6px;"></span>
                        }
                        ثبت تعهدنامه
                    </button>
                }
                @if (!_isNewCommitment && _commitmentDto != null)
                {
                    <button type="button" class="rl-btn rl-btn--danger-outline" @onclick="ConfirmDeleteCommitment">
                        <span class="oi oi-trash" style="margin-left:4px;"></span> حذف تعهدنامه
                    </button>
                }
                <button type="button" class="rl-btn rl-btn--ghost" @onclick="CloseCommitmentModal">بستن</button>
            </div>
        </div>
    </div>
}

<div class="rl-page" dir="rtl">
    <div class="rl-header">
        <div class="rl-header__row">
            <a class="rl-back" href="/admin"><span class="oi oi-arrow-right"></span></a>
            <div class="rl-header__title">
                <div class="rl-header__kicker">رسیدهای مشتری</div>
                <div class="rl-header__main">لیست درخواست‌ها</div>
            </div>
            <a class="rl-new" href="/admin/receipts/new">ثبت جدید</a>
        </div>
        <button type="button" class="rl-filter-toggle-full @(showFilters ? "rl-filter-toggle-full--open" : "")" @onclick="() => showFilters = !showFilters">
            <span class="oi oi-filter"></span>
            <span>@(!showFilters ? "نمایش فیلترها و آمار" : "بستن فیلترها و آمار")</span>
            <span class="rl-filter-arrow @(showFilters ? "rl-filter-arrow--open" : "")">
                <span class="oi oi-chevron-top"></span>
            </span>
        </button>
        @if (isSuperAdmin && !selectedWorkshopId.HasValue)
        {
            <div class="rl-alert">برای مشاهده لیست، ابتدا کارگاه را از هدر انتخاب کنید.</div>
        }

        @if (showFilters)
        {
            <div class="rl-filters-section">
                <div class="rl-filters">
                    <div class="rl-filter">
                        <span class="rl-filter__label">وضعیت</span>
                        <button class="rl-status-trigger" @onclick="ToggleStatusSheet">
                            <span class="rl-status-trigger__text">@GetStatusFilterText()</span>
                            <span class="oi oi-chevron-bottom"></span>
                        </button>
                    </div>

                    <div class="rl-filter rl-filter--date">
                        <span class="rl-filter__label">بازه تاریخ ثبت</span>
                        <div class="rl-date-row">
                            <input class="rl-input ltr" data-jdp autocomplete="off" placeholder="از" @bind="dateFrom" @bind:event="oninput" @bind:after="ApplyFilter" style="text-align: center;" />
                            <input class="rl-input ltr" data-jdp autocomplete="off" placeholder="تا" @bind="dateTo" @bind:event="oninput" @bind:after="ApplyFilter" style="text-align: center;"  />
                        </div>
                    </div>
                </div>

                <div class="rl-stats">
                    <div class="rl-stat-item">
                        <span class="rl-stat-label">همه</span>
                        <span class="rl-stat-value">@allCount</span>
                    </div>
                    <div class="rl-stat-item rl-stat--pending">
                        <span class="rl-stat-label">در انتظار</span>
                        <span class="rl-stat-value">@pendingCount</span>
                    </div>
                    <div class="rl-stat-item rl-stat--not">
                        <span class="rl-stat-label">غیر قابل تعمیر</span>
                        <span class="rl-stat-value">@notRepairableCount</span>
                    </div>
                    <div class="rl-stat-item rl-stat--repaired">
                        <span class="rl-stat-label">تعمیر شده</span>
                        <span class="rl-stat-value">@repairedCount</span>
                    </div>
                    <div class="rl-stat-item rl-stat--delivered">
                        <span class="rl-stat-label">تحویل شده</span>
                        <span class="rl-stat-value">@deliveredCount</span>
                    </div>
                </div>

                <div class="rl-paybar">
                    <div class="rl-paybar__meta">
                        <span class="rl-paybar__title">تعداد رسیدها</span>
                        <span class="rl-paybar__count">@filteredCountForHeader.ToString("N0")</span>
                    </div>

                    <div class="rl-paychips">
                        <button type="button" class="rl-paychip @(paymentFilter == "" ? "rl-paychip--active" : "")" @onclick='() => SetPaymentFilter("")'>
                            <span class="rl-paychip__t">همه</span>
                        </button>
                        <button type="button" class="rl-paychip rl-paychip--settled @(paymentFilter == "settled" ? "rl-paychip--active" : "")" @onclick='() => SetPaymentFilter("settled")'>
                            <span class="rl-paychip__t">تسویه</span>
                            <span class="rl-paychip__n">@paySettledCount</span>
                        </button>
                        <button type="button" class="rl-paychip rl-paychip--debtor @(paymentFilter == "debtor" ? "rl-paychip--active" : "")" @onclick='() => SetPaymentFilter("debtor")'>
                            <span class="rl-paychip__t">بدهکار</span>
                            <span class="rl-paychip__n">@payDebtorCount</span>
                        </button>
                        <button type="button" class="rl-paychip rl-paychip--creditor @(paymentFilter == "creditor" ? "rl-paychip--active" : "")" @onclick='() => SetPaymentFilter("creditor")'>
                            <span class="rl-paychip__t">بستانکار</span>
                            <span class="rl-paychip__n">@payCreditorCount</span>
                        </button>
                    </div>

                    @if (isLoadingPaymentPrefetch)
                    {
                        <div class="rl-paybar__loading">در حال آماده‌سازی وضعیت پرداخت...</div>
                    }
                </div>
            </div>
           
        }
    </div>

    @if (showContextMenu && contextMenuItem != null)
    {
        <div class="rl-context-overlay" @onclick="CloseContextMenu"></div>
        <div class="rl-context-menu" style="left: @(contextMenuX)px; top: @(contextMenuY)px;" @onclick:stopPropagation>
            <div class="rl-cm-header">
                <span class="rl-cm-customer">@contextMenuItem.CustomerFirstName @contextMenuItem.CustomerLastName</span>
                <span class="rl-cm-device">
                    <span class="oi oi-monitor"></span>
                    @contextMenuItem.DeviceTypeName @(string.IsNullOrWhiteSpace(contextMenuItem.DeviceBrandName) ? "" : " - " + contextMenuItem.DeviceBrandName)
                </span>
            </div>
            <div class="rl-cm-item" @onclick='() => HandleContextAction("edit_invoice")'>
                <span class="rl-cm-icon oi oi-document"></span>
                صدور فاکتور
            </div>
            <div class="rl-cm-item" @onclick='() => HandleContextAction("edit_receipt")'>
                <span class="rl-cm-icon oi oi-pencil"></span>
                ویرایش رسید
            </div>
            <div class="rl-cm-item" @onclick='() => HandleContextAction("monitoring")'>
                <span class="rl-cm-icon oi oi-pulse"></span>
                اتصال مانیتورینگ
            </div>
            <div class="rl-cm-item" @onclick='() => HandleContextAction("customer_summary")'>
                <span class="rl-cm-icon oi oi-person"></span>
                خلاصه وضعیت
            </div>
            <div class="rl-cm-item" @onclick='() => HandleContextAction("print_invoice")'>
                <span class="rl-cm-icon oi oi-print"></span>
                پرینت فاکتور
            </div>
            @if (contextMenuItem?.WorkshopId == 1)
            {
                <div class="rl-cm-item" @onclick='() => HandleContextAction("commitment")'>
                    <span class="rl-cm-icon oi oi-document-text"></span>
                    @(contextMenuItem?.CommitmentStatus != null ? "مشاهده تعهد نامه" : "ایجاد تعهد نامه")
                </div>
            }
            <div class="rl-cm-divider"></div>
            <div class="rl-cm-item rl-cm-item--delete" @onclick='() => HandleContextAction("delete")'>
                <span class="rl-cm-icon oi oi-trash"></span>
                حذف
            </div>
        </div>
    }

    <div class="rl-shell" @onclick="CloseContextMenu">

 <div class="rl-search-box" style="position: sticky; top: 16px; background: inherit; z-index: 100; padding: 0 16px 16px 16px;">
    <style>
        .rl-search-box * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        /* استایل sticky با فاصله از لبه‌ها */
        .rl-search-box {
            position: sticky !important;
            top: 16px !important;
            z-index: 100 !important;
            backdrop-filter: blur(12px) !important;
            padding: 16px 16px 16px 16px !important;
            margin: -8px -16px 0 -16px !important;
        }
        
        /* کانتینر اصلی باکس */
        .search-container {
            position: relative;
            width: 100%;
            max-width: 100%;
            margin: 0 auto;
        }
        
        /* انیمیشن شاین (shine) */
        @@keyframes shine {
            0% {
                background-position: -200% 0;
            }
            100% {
                background-position: 200% 0;
            }
        }
        
        .modern-search-input {
            width: 100%;
            padding: 14px 50px 14px 20px;
            font-size: 14px;
            font-family: inherit;
            color: #1e293b;
            background: linear-gradient(135deg, #ffffff 0%, #f8fafc 100%);
            border: 2px solid #e2e8f0;
            border-radius: 44px;
            outline: none;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
            position: relative;
            overflow: hidden;
        }
        
        /* افکت شاین روی باکس */
        .modern-search-input::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, 
                transparent, 
                rgba(255, 255, 255, 0.4), 
                transparent);
            transition: left 0.5s ease;
            pointer-events: none;
        }
        
        .modern-search-input:hover::before {
            left: 100%;
            transition: left 0.6s ease;
        }
        
        /* انیمیشن شاین مداوم (اختیاری) */
        .modern-search-input.shine-animate::before {
            animation: shine 3s infinite;
        }
        
        .modern-search-input::placeholder {
            color: #94a3b8;
            font-weight: 400;
            transition: color 0.3s ease;
        }
        
        .modern-search-input:hover {
            border-color: #94a3b8;
            background: #ffffff;
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
        }
        
        .modern-search-input:focus {
            border-color: #3b82f6;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.12), 0 8px 24px rgba(0, 0, 0, 0.1);
            transform: translateY(-2px);
        }
        
        .modern-search-input:focus::placeholder {
            color: #cbd5e1;
        }
        
        .modern-search-icon {
            position: absolute;
            right: 18px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 20px;
            pointer-events: none;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            display: flex;
            align-items: center;
            justify-content: center;
        }
        
        .modern-search-input:focus + .modern-search-icon {
            transform: translateY(-50%) scale(1.15);
        }
        
        /* افکت ریپل */
        @@keyframes ripple {
            0% {
                box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.3);
            }
            100% {
                box-shadow: 0 0 0 8px rgba(59, 130, 246, 0);
            }
        }
        
        .modern-search-input:active {
            animation: ripple 0.4s ease-out;
        }
        
        /* انیمیشن focus با گرادیان */
        .modern-search-input:focus {
            background: linear-gradient(135deg, #ffffff 0%, #eff6ff 100%);
        }
        
        /* ریسپانسیو برای موبایل */
        @@media (max-width: 768px) {
            .rl-search-box {
                padding: 12px 12px 12px 12px !important;
                top: 8px !important;
            }
            
            .modern-search-input {
                padding: 12px 45px 12px 16px;
                font-size: 13px;
                border-radius: 36px;
            }
            
            .modern-search-icon {
                right: 14px;
                font-size: 18px;
            }
        }
        
        /* دارک مود */
        @@media (prefers-color-scheme: dark) {
            .rl-search-box {
                background: rgba(15, 23, 42, 0.96) !important;
            }
            
            .modern-search-input {
                background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
                border-color: #334155;
                color: #f1f5f9;
            }
            
            .modern-search-input::placeholder {
                color: #64748b;
            }
            
            .modern-search-input:hover {
                border-color: #64748b;
                background: #1e293b;
            }
            
            .modern-search-input:focus {
                border-color: #3b82f6;
                background: #1e293b;
            }
            
            .modern-search-icon svg path {
                stroke: #94a3b8;
            }
            
            .modern-search-input::before {
                background: linear-gradient(90deg, 
                    transparent, 
                    rgba(255, 255, 255, 0.1), 
                    transparent);
            }
        }
    </style>
    
    <div class="search-container">
        <input type="text" 
               class="modern-search-input shine-animate" 
               placeholder="جستجوی رسیدها..." 
               @bind="q" 
               @bind:event="oninput" 
               @bind:after="ApplyFilter" />
        
        <span class="modern-search-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M21 21L16.65 16.65M19 11C19 15.4183 15.4183 19 11 19C6.58172 19 3 15.4183 3 11C3 6.58172 6.58172 3 11 3C15.4183 3 19 6.58172 19 11Z" 
                      stroke="#94a3b8" 
                      stroke-width="2" 
                      stroke-linecap="round" 
                      stroke-linejoin="round" 
                      fill="none"/>
            </svg>
        </span>
    </div>
</div>

        @if (isLoading)
        {
            <div class="rl-card">
                <div class="rl-loading">
                    <div class="spinner-border text-primary"></div>
                    <div class="rl-loading__text">در حال دریافت لیست...</div>
                </div>
            </div>
        }
        else if (!CanWorkOnWorkshop)
        {
            <div class="rl-card">
                <div class="rl-empty">برای مشاهده لیست، ابتدا کارگاه را انتخاب کنید.</div>
            </div>
        }
        else if (filtered == null || filtered.Count == 0)
        {
            <div class="rl-card">
                <div class="rl-empty">موردی برای نمایش وجود ندارد.</div>
            </div>
        }
        else
        {
            <div class="rl-list">
                @foreach (var item in filtered.Take(displayCount))
                {
                    <div class="rl-acc @(expandedReceiptId == item.Id ? "rl-acc--open" : "") @(contextMenuItem?.Id == item.Id ? "rl-item--selected" : "") @(HasActiveMonitoring(item.Id) ? "rl-acc--monitoring" : "") @(item.CustomerIsBadPayer ? "rl-acc--bad-payer" : "") @StatusBgClass(item.Status)">
                        <button type="button" class="rl-item" 
                                @onclick="() => ToggleExpand(item)" 
                                @oncontextmenu="e => ShowContextMenu(e, item)"
                                @oncontextmenu:preventDefault
                                @ontouchstart="e => HandleTouchStart(e, item)"
                                @ontouchend="e => HandleTouchEnd(e)"
                                @ontouchmove="e => HandleTouchMove(e)">
                            @if (item.CustomerIsBadPayer)
                            {
                                <div class="rl-bad-payer-banner">مشتری بدحساب</div>
                            }
                            <div class="rl-item__top">
                                <div class="rl-item__name">
                                    @if (item.WorkshopId == 1 && item.CommitmentStatus != null)
                                    {
                                        <span class="rl-commit-icon @(item.CommitmentStatus == "signed" ? "rl-commit-icon--signed" : "rl-commit-icon--pending")" 
                                              title="@(item.CommitmentStatus == "signed" ? "تعهدنامه امضا شده" : "تعهدنامه در انتظار امضا")">
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/>
                                                <path d="m15 5 4 4"/>
                                            </svg>
                                        </span>
                                    }
                                    @item.CustomerFirstName @item.CustomerLastName
                                </div>
                                <div class="rl-item__top-left">
                                    @if (billingCache.TryGetValue(item.Id, out var b))
                                    {
                                        var remaining = b.BillTotal - b.Discount - b.Prepaid - b.Paid;
                                        <span class="rl-chip @(remaining > 0 ? "rl-chip--debtor" : remaining < 0 ? "rl-chip--creditor" : "rl-chip--settled")">@(remaining > 0 ? "بدهکار" : remaining < 0 ? "بستانکار" : "تسویه")</span>
                                    }
                                    <div class="rl-badge @BadgeClass(item.Status)">@StatusFa(item.Status)</div>
                                </div>
                            </div>
                            <div class="rl-item__bottom-row">
                                <div class="rl-item__device">
                                    <span class="oi oi-monitor @(HasMonitoringHistory(item.Id) && !HasActiveMonitoring(item.Id) ? "rl-monitor--history" : "")"></span>
                                    <span class="rl-item__device-text">@item.DeviceTypeName@if (!string.IsNullOrWhiteSpace(item.DeviceBrandName)) { <text> - @item.DeviceBrandName</text> }</span>
                                    @if (HasActiveMonitoring(item.Id))
                                    {
                                        <span class="rl-dot rl-dot--active" title="مانیتورینگ فعال"></span>
                                    }
                                    else if (HasMonitoringHistory(item.Id))
                                    {
                                        <span class="rl-dot rl-dot--history" title="سابقه مانیتورینگ"></span>
                                    }
                                </div>
                                <div class="rl-item__actions">
                                    <span class="rl-item__date">@PersianDateHelper.ToPersianDateTimeString(item.RegisteredAt, true)</span>
                                    <span class="rl-item__more @(expandedReceiptId == item.Id ? "rl-item__more--open" : "")">@(expandedReceiptId == item.Id ? "بستن" : "جزئیات")</span>
                                </div>
                            </div>
                        </button>

                        @if (expandedReceiptId == item.Id)
                        {
                            <div class="rl-details">
                                @if (isLoadingDetails && !billingCache.ContainsKey(item.Id))
                                {
                                    <div class="rl-details-loading">
                                        <span class="oi oi-loop-circular rl-spin"></span>
                                        در حال بارگذاری جزئیات...
                                    </div>
                                }
                                else
                                {
                                    <div class="rl-details-grid">

                                        <div class="rl-detail-card">
                                            @if (!string.IsNullOrWhiteSpace(item.ReceiptImageUrl))
                                            {
                                                <a href="@item.ReceiptImageUrl" target="_blank" @onclick:stopPropagation>
                                                    <img src="@item.ReceiptImageUrl" class="rl-detail-img" alt="عکس رسید" />
                                                </a>
                                            }
                                            <div class="rl-detail-kv">
                                                <div class="rl-kv-row"><span class="rl-kv-k">موبایل</span><span class="rl-kv-v ltr">@item.CustomerMobile</span></div>
                                                <div class="rl-kv-row"><span class="rl-kv-k">تکنیسین</span><span class="rl-kv-v">@(item.TechnicianName ?? "نامشخص")</span></div>
                                                <div class="rl-kv-row"><span class="rl-kv-k">پذیرش توسط</span><span class="rl-kv-v">@(string.IsNullOrWhiteSpace(item.CreatedByUserName) ? "-" : item.CreatedByUserName)</span></div>
                                                <div class="rl-kv-row"><span class="rl-kv-k">آدرس</span><span class="rl-kv-v">@(item.CustomerAddress ?? "-")</span></div>
                                            </div>
                                            <div class="rl-detail-problem">
                                                <div class="rl-detail-problem-label">شرح مشکل</div>
                                                @{
                                                    var lines = item.ProblemDescription.Split(new[] { "\n\n---\n" }, StringSplitOptions.None);
                                                    if (lines.Length > 1)
                                                    {
                                                        <div class="mb-2">
                                                            <div class="text-muted small fw-bold mb-1">توضیحات مشتری:</div>
                                                            <div>@lines[0]</div>
                                                        </div>
                                                        <div class="mt-2 pt-2" style="border-top: 1px dashed #fee2e2;">
                                                            <div class="text-danger small fw-bold mb-1">توضیحات مدیر:</div>
                                                            <div class="text-danger fw-bold">@lines[1].Replace("یادداشت ارجاع 2:", "").Trim()</div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="text-muted small fw-bold mb-1">توضیحات مشتری:</div>
                                                        @item.ProblemDescription
                                                    }
                                                }
                                            </div>
                                        </div>

                                        @if (billingCache.TryGetValue(item.Id, out var billing))
                                        {
                                            <div class="rl-detail-card">
                                                <div class="rl-card-header rl-card-header--finance">
                                                    <span class="oi oi-calculator"></span>
                                                    <span>فاکتور و وضعیت مالی</span>
                                                </div>
                                                @if (billing.Items != null && billing.Items.Any())
                                                {
                                                    <div class="rl-table-container">
                                                        <table class="rl-table">
                                                            <thead>
                                                                <tr>
                                                                    <th>ردیف</th>
                                                                    <th>عنوان</th>
                                                                    <th class="text-right">مبلغ</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @{ int idx = 1; }
                                                                @foreach (var inv in billing.Items)
                                                                {
                                                                    <tr>
                                                                        <td class="text-center">@(idx++)</td>
                                                                        <td style="color:crimson;font-weight:bold;">@inv.Title</td>
                                                                        <td class="text-left ltr rl-price">@inv.UnitPrice.ToString("N0")</td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                    <div class="rl-finance-divider"></div>
                                                }
                                                @{
                                                    var payable = billing.BillTotal - billing.Discount;
                                                    var remaining = payable - billing.Prepaid - billing.Paid;
                                                }
                                                <div class="rl-finance-rows">
                                                    <div class="rl-f-row"><span class="rl-f-label">مبلغ کل</span><span class="rl-f-val ltr">@billing.BillTotal.ToString("N0")</span></div>
                                                    @if (billing.Discount > 0)
                                                    {
                                                        <div class="rl-f-row rl-f-row--discount"><span class="rl-f-label">تخفیف</span><span class="rl-f-val ltr">@billing.Discount.ToString("N0")</span></div>
                                                    }
                                                    <div class="rl-f-row rl-f-row--total"><span class="rl-f-label">قابل پرداخت</span><span class="rl-f-val ltr">@payable.ToString("N0")</span></div>
                                                    <div class="rl-f-row rl-f-row--paid"><span class="rl-f-label">پرداختی</span><span class="rl-f-val ltr">@((billing.Prepaid + billing.Paid).ToString("N0"))</span></div>
                                                    <div class="rl-f-row @(remaining > 0 ? "rl-f-row--debtor" : remaining < 0 ? "rl-f-row--creditor" : "")">
                                                        <span class="rl-f-label">@(remaining >= 0 ? "مانده" : "طلب مشتری")</span>
                                                        <span class="rl-f-val ltr">@Math.Abs(remaining).ToString("N0")</span>
                                                    </div>
                                                </div>
                                            </div>
                                        }

                                        @if (monitoringHistoryCache.TryGetValue(item.Id, out var monitoringHistory) && monitoringHistory != null && monitoringHistory.Any())
                                        {
                                            <div class="rl-detail-card" id="monitoring-section-@item.Id">
                                                <div class="rl-card-header rl-card-header--monitoring">
                                                    <span class="oi oi-pulse"></span>
                                                    <span>سابقه مانیتورینگ</span>
                                                </div>
                                                <div class="rl-monitoring-list">
                                                    @foreach (var conn in monitoringHistory.OrderByDescending(x => x.CreatedAt))
                                                    {
                                                        <div class="rl-monitoring-item @(conn.IsActive ? "rl-monitoring-item--active" : "")" @onclick="() => GoToMonitoringDetails(conn)" @onclick:stopPropagation>
                                                            <div class="rl-monitoring-item__main">
                                                                <div class="rl-monitoring-item__device">
                                                                    <span class="oi oi-hard-drive"></span>
                                                                    @conn.MonitoringDeviceTitle
                                                                </div>
                                                                <div class="rl-monitoring-item__date">@conn.CreatedAtFa</div>
                                                            </div>
                                                            <div class="rl-monitoring-item__status">
                                                                <span class="rl-monitoring-badge @(conn.IsActive ? "rl-monitoring-badge--active" : "rl-monitoring-badge--ended")">
                                                                    @(conn.IsActive ? "فعال" : "پایان یافته")
                                                                </span>
                                                            </div>
                                                            @if (!conn.IsActive && !string.IsNullOrWhiteSpace(conn.EndReason))
                                                            {
                                                                <div class="rl-monitoring-end-reason" title="دلیل پایان">@conn.EndReason</div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        }

                                        <div class="rl-details-actions">
                                            <AuthorizeView Policy="perm:admin.receipts.manage">
                                                <button class="rl-btn-edit" @onclick="() => EditReceipt(item)">
                                                    <span class="oi oi-pencil"></span> ویرایش رسید
                                                </button>
                                                <button class="rl-btn-invoice" @onclick='() => Navigation.NavigateTo($"/admin/receipts/invoice/{item.Id}")'>
                                                    <span class="oi oi-spreadsheet"></span> مدیریت فاکتور
                                                </button>
                                            </AuthorizeView>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            @if (filtered.Count > displayCount)
            {
                <div class="rl-load-more" @onclick="async () => await LoadMore()" disabled="@isLoadingMore">
                    @if (isLoadingMore)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <span>در حال بارگذاری...</span>
                    }
                    else
                    {
                        <span class="oi oi-chevron-bottom"></span>
                        <span>نمایش موارد بیشتر (@((filtered.Count - displayCount).ToString("N0")) مورد باقی‌مانده)</span>
                    }
                </div>
            }
            <div @ref="loadMoreTrigger" style="height: 1px;"></div>
        }
    </div>
</div>


@if (showModal && selected != null)
{
    <div class="rl-modal-overlay" @onclick="Close"></div>
    <div class="rl-modal">
        <div class="rl-modal__header">
            <div>
                <div class="rl-modal__title">@selected.CustomerFirstName @selected.CustomerLastName</div>
                <div class="rl-modal__sub ltr">@selected.CustomerMobile</div>
            </div>
            <div style="display:flex; gap:8px; align-items:center;">
                <AuthorizeView Policy="perm:admin.receipts.manage">
                    <button class="rl-x" @onclick="ToggleEdit" title="ویرایش"><span class="oi oi-pencil"></span></button>
                </AuthorizeView>
                <button class="rl-x" @onclick="Close"><span class="oi oi-x"></span></button>
            </div>
        </div>
        <div class="rl-modal__body">
            @if (!isEditMode)
            {
                <div class="rl-receipt">
                    <div class="rl-r-row">
                        <span class="rl-r-k">تاریخ ثبت</span>
                        <span class="rl-r-dots"></span>
                        <span class="rl-r-v ltr">@PersianDateHelper.ToPersianDateTimeString(selected.RegisteredAt, includeTime: true)</span>
                    </div>
                    <div class="rl-r-row">
                        <span class="rl-r-k">وضعیت</span>
                        <span class="rl-r-dots"></span>
                        <span class="rl-r-v"><span class="rl-chip @ChipClass(selected.Status)">@StatusFa(selected.Status)</span></span>
                    </div>
                    <div class="rl-r-row">
                        <span class="rl-r-k">دستگاه</span>
                        <span class="rl-r-dots"></span>
                        <span class="rl-r-v"><span class="rl-chip rl-chip--primary">@selected.DeviceTypeName@if (!string.IsNullOrWhiteSpace(selected.DeviceBrandName)) { <span> - @selected.DeviceBrandName</span> }</span></span>
                    </div>
                    <div class="rl-r-row">
                        <span class="rl-r-k">پذیرش توسط</span>
                        <span class="rl-r-dots"></span>
                        <span class="rl-r-v">@(string.IsNullOrWhiteSpace(selected.CreatedByUserName) ? "-" : selected.CreatedByUserName)</span>
                    </div>
                    <div class="rl-r-row">
                        <span class="rl-r-k">تکنسین</span>
                        <span class="rl-r-dots"></span>
                        <span class="rl-r-v">@(string.IsNullOrWhiteSpace(selected.TechnicianName) ? "نامشخص" : selected.TechnicianName)</span>
                    </div>
                    <div class="rl-r-row">
                        <span class="rl-r-k">آدرس</span>
                        <span class="rl-r-dots"></span>
                        <span class="rl-r-v">@(string.IsNullOrWhiteSpace(selected.CustomerAddress) ? "-" : selected.CustomerAddress)</span>
                    </div>

                    <div class="rl-r-chip-title">شرح مشکل</div>
                    <div class="rl-r-chip">@selected.ProblemDescription</div>
                </div>
            }
            else
            {
                <div class="rl-kv">
                    <div class="rl-k">تاریخ ثبت</div>
                    <div class="rl-v">
                        <input @ref="editDateInput" class="rl-input ltr" data-jdp autocomplete="off" @bind="editRegDateString" placeholder="انتخاب تاریخ..." @onclick:stopPropagation />
                    </div>
                </div>

                <div class="rl-kv">
                    <div class="rl-k">وضعیت</div>
                    <div class="rl-v">
                        <button class="rl-edit-status-trigger" @onclick="ToggleEditStatusSheet">
                            <span class="rl-chip @ChipClass(editStatus)">@StatusFa(editStatus)</span>
                            <span class="oi oi-chevron-bottom"></span>
                        </button>
                    </div>
                </div>

                <div class="rl-kv">
                    <div class="rl-k">نوع دستگاه</div>
                    <div class="rl-v">
                        <select class="rl-select" @bind="editDeviceTypeId" @bind:after="EditDeviceTypeChanged">
                            <option value="0">انتخاب کنید...</option>
                            @if (deviceTypes != null)
                            {
                                @foreach (var dt in deviceTypes)
                                {
                                    <option value="@dt.Id">@dt.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="rl-kv">
                    <div class="rl-k">برند</div>
                    <div class="rl-v">
                        <select class="rl-select" @bind="editDeviceBrandId" disabled="@(editDeviceTypeId <= 0)">
                            <option value="">(اختیاری) انتخاب کنید...</option>
                            @if (deviceBrands != null)
                            {
                                @foreach (var b in deviceBrands)
                                {
                                    <option value="@b.Id">@b.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="rl-kv">
                    <div class="rl-k">ارجاع به تکنسین</div>
                    <div class="rl-v">
                        <select class="rl-select" @bind="editTechnicianId">
                            <option value="">-- انتخاب تکنسین --</option>
                            @if (technicians != null)
                            {
                                @foreach (var tech in technicians)
                                {
                                    <option value="@tech.Id">@tech.FullName</option>
                                }
                            }
                        </select>
                    </div>
                </div>

                <div class="rl-kv">
                    <div class="rl-k">شرح مشکل</div>
                    <div class="rl-v">
                        <textarea class="rl-input" style="min-height:110px;" @bind="editProblem"></textarea>
                    </div>
                </div>

                <div class="rl-kv">
                    <div class="rl-k">تعویض عکس</div>
                    <div class="rl-v">
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted mb-2">تصویر رسید</label>
                            <ImageUploader @bind-ImageUrl="editPreviewUrl"
                                           UploadUrl="api/customer-receipts/upload"
                                           WorkshopId="@editUploadWorkshopId"
                                           RequireWorkshopId="@isSuperAdmin" />
                        </div>
                    </div>
                </div>
            }
        </div>
        <div class="rl-modal__footer">
            @if (!isEditMode)
            {
                <button class="rl-btn" @onclick="Close">بستن</button>
            }
            else
            {
                <div style="display:flex; gap:10px;">
                    <button class="rl-btn" style="background:#fff; color:rgba(15,23,42,0.85); border:1px solid rgba(2,6,23,0.10); box-shadow:none;" @onclick="CancelEdit" disabled="@isSaving">انصراف</button>
                    <button class="rl-btn" @onclick="SaveEdit" disabled="@isSaving">ذخیره</button>
                </div>
            }
        </div>
    </div>
}

@if (showPhotoModal && !string.IsNullOrEmpty(photoUrl))
{
    <div class="rl-photo-overlay" @onclick="ClosePhoto">
        <div class="rl-photo-zoom-wrap" id="receipt-photo-wrap" @onclick:stopPropagation>
            <img src="@photoUrl" id="receipt-photo-img" class="rl-photo-fullscreen" />
            <button class="rl-photo-close" @onclick="ClosePhoto"><span class="oi oi-x"></span></button>
        </div>
    </div>
}











@if (showPrintModal && printReceipt != null)
{
    <style>
        /* ========================================
                   BOTTOM SHEET - طراحی روشن و مدرن
                   ======================================== */

        @@keyframes slideUp {
            from {
                transform: translateY(100%);
            }

            to {
                transform: translateY(0);
            }
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .print-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.4);
            backdrop-filter: blur(4px);
            z-index: 10000;
            animation: fadeIn 0.25s ease;
        }

        .print-sheet {
            position: fixed;
            bottom: 0;
            left: 0;
            right: 0;
            background: #ffffff;
            border-radius: 28px 28px 0 0;
            box-shadow: 0 -5px 25px rgba(0, 0, 0, 0.08);
            z-index: 10001;
            max-height: 85vh;
            display: flex;
            flex-direction: column;
            animation: slideUp 0.35s ease;
            overflow: hidden;
        }

        .print-handle {
            display: flex;
            justify-content: center;
            padding: 12px 0 6px;
            cursor: grab;
        }

        .print-handle-bar {
            width: 45px;
            height: 4px;
            background: #e2e8f0;
            border-radius: 999px;
        }

        .print-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 20px 12px;
            border-bottom: 1px solid #f1f5f9;
        }

        .print-title {
            font-weight: 800;
            font-size: 1.2rem;
            color: #0f172a;
            margin-bottom: 2px;
        }

        .print-sub {
            font-size: 0.75rem;
            color: #64748b;
            display: flex;
            align-items: center;
            gap: 6px;
            flex-wrap: wrap;
        }

        .print-close {
            width: 38px;
            height: 38px;
            border-radius: 12px;
            border: none;
            background: #f1f5f9;
            color: #64748b;
            display: grid;
            place-items: center;
            cursor: pointer;
            transition: 0.2s;
        }

            .print-close:hover {
                background: #fee2e2;
                color: #ef4444;
            }

        .print-tabs {
            display: flex;
            gap: 10px;
            padding: 12px 20px 0;
        }

        .print-tab {
            flex: 1;
            padding: 10px 16px;
            background: #f1f5f9;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            font-weight: 700;
            font-size: 0.8rem;
            color: #64748b;
            cursor: pointer;
            transition: 0.2s;
            text-align: center;
        }

            .print-tab:hover {
                background: #e2e8f0;
                border-color: #cbd5e1;
                color: #334155;
            }

            /* استایل تب فعال - با اولویت بالا */
            .print-tab--active,
            .print-tab.print-tab--active {
                background: #4f46e5 !important;
                border-color: #4f46e5 !important;
                color: #ffffff !important;
                box-shadow: 0 2px 8px rgba(79, 70, 229, 0.3);
            }

                .print-tab--active:hover,
                .print-tab.print-tab--active:hover {
                    background: #4338ca !important;
                    color: #ffffff !important;
                }

        .print-body {
            flex: 1;
            overflow-y: auto;
            padding: 16px 20px;
        }

        .print-form {
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .print-field {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .print-label {
            font-weight: 700;
            font-size: 0.75rem;
            color: #475569;
        }

        .print-input {
            padding: 12px 14px;
            border: 1px solid #e2e8f0;
            border-radius: 14px;
            font-size: 0.85rem;
            width: 100%;
            background: #fff;
            color: #1e293b;
        }

            .print-input:focus {
                outline: none;
                border-color: #4f46e5;
                box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.1);
            }

            .print-input[readonly] {
                background: #f8fafc;
                color: #64748b;
            }

        .print-checkbox {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            padding: 6px 0;
        }

            .print-checkbox input {
                width: 18px;
                height: 18px;
                accent-color: #4f46e5;
            }

            .print-checkbox span {
                font-size: 0.8rem;
                color: #334155;
            }

        .print-type-group {
            display: flex;
            gap: 12px;
            margin-bottom: 20px;
        }

        .print-type-card {
            flex: 1;
            padding: 14px;
            border: 1px solid #e2e8f0;
            border-radius: 18px;
            background: #fff;
            font-weight: 700;
            font-size: 0.8rem;
            color: #475569;
            cursor: pointer;
            transition: 0.2s;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .print-type-card:hover {
                border-color: #4f46e5;
                background: #f8fafc;
            }

        .print-type-card--active {
            background: #4f46e5 !important;
            border-color: #4f46e5 !important;
            color: #fff !important;
        }

        .date-range-box {
            background: #f8fafc;
            border-radius: 20px;
            padding: 16px;
            margin-top: 12px;
        }

        .date-range-title {
            font-weight: 800;
            font-size: 0.8rem;
            color: #1e293b;
            margin-bottom: 12px;
            padding-bottom: 6px;
            border-bottom: 1px solid #e2e8f0;
            display: inline-block;
        }

        .date-fields {
            display: flex;
            gap: 12px;
        }

        .date-field {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

            .date-field label {
                font-weight: 600;
                font-size: 0.7rem;
                color: #64748b;
            }

            .date-field input {
                padding: 10px 12px;
                border: 1px solid #e2e8f0;
                border-radius: 12px;
                font-size: 0.85rem;
                font-family: monospace;
                text-align: center;
                background: #fff;
                direction: ltr;
            }

                .date-field input:focus {
                    outline: none;
                    border-color: #4f46e5;
                    box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.1);
                }

        .date-hint {
            margin-top: 10px;
            font-size: 0.65rem;
            color: #94a3b8;
            text-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        .logo-upload {
            position: relative;
            min-height: 100px;
            border: 1px dashed #cbd5e1;
            border-radius: 16px;
            background: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .logo-placeholder {
            text-align: center;
            padding: 20px;
            cursor: pointer;
            color: #94a3b8;
            font-size: 0.75rem;
        }

        .logo-input {
            position: absolute;
            inset: 0;
            opacity: 0;
            cursor: pointer;
        }

        .logo-preview {
            position: relative;
            padding: 12px;
            text-align: center;
        }

            .logo-preview img {
                max-height: 60px;
                border-radius: 10px;
            }

        .logo-remove-btn {
            position: absolute;
            top: -8px;
            right: -8px;
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: #ef4444;
            color: #fff;
            border: none;
            cursor: pointer;
            display: grid;
            place-items: center;
        }

        .print-footer {
            display: flex;
            gap: 12px;
            padding: 12px 20px 20px;
            border-top: 1px solid #f1f5f9;
        }

        .print-btn {
            flex: 1;
            padding: 12px;
            border-radius: 14px;
            font-weight: 800;
            font-size: 0.85rem;
            cursor: pointer;
            text-align: center;
        }

        .print-btn--primary {
            background: #4f46e5;
            color: #fff;
            border: none;
        }

            .print-btn--primary:hover {
                background: #4338ca;
            }

        .print-btn--secondary {
            background: #f1f5f9;
            color: #475569;
            border: none;
        }

            .print-btn--secondary:hover {
                background: #e2e8f0;
            }

        .section-title {
            font-weight: 800;
            font-size: 0.85rem;
            color: #1e293b;
            margin-bottom: 12px;
            display: inline-block;
        }

        /* جابجایی جی‌آ‌ی‌آ‌ی‌آ‌ی‌آ‌ی‌آ‌ی‌آ‌ی‌آ‌ی datepicker بالای مودال */
        jdp-container {
            z-index: 10002 !important;
        }

        @@media (max-width: 640px) {
            .print-body {
                padding: 12px 16px;
            }

            .print-tabs {
                padding: 10px 16px 0;
            }

            .print-type-group {
                flex-direction: column;
                gap: 8px;
            }

            .date-fields {
                flex-direction: column;
            }

            .print-footer {
                padding: 10px 16px 18px;
            }
        }
    </style>

    <div class="print-overlay" @onclick="ClosePrintModal"></div>

    <div class="print-sheet">
        <div class="print-handle">
            <div class="print-handle-bar"></div>
        </div>

        <div class="print-header">
            <div>
                <div class="print-title">پرینت فاکتور</div>
                <div class="print-sub">
                    <span class="oi oi-person"></span> @printReceipt.CustomerFirstName @printReceipt.CustomerLastName
                    <span class="oi oi-mobile"></span> @printReceipt.CustomerMobile
                </div>
            </div>
            <button class="print-close" @onclick="ClosePrintModal">
                <span class="oi oi-x"></span>
            </button>
        </div>

        <div class="print-tabs">
            <button class="print-tab @(printSettingsTab ? "print-tab--active" : "")" @onclick="() => printSettingsTab = true">
                <span class="oi oi-cog"></span> تنظیمات سربرگ
            </button>
            <button class="print-tab @(!printSettingsTab ? "print-tab--active" : "")" @onclick="() => printSettingsTab = false">
                <span class="oi oi-print"></span> پرینت
            </button>
        </div>

        <div class="print-body">
            @if (printSettingsTab)
            {
                <div class="print-form">
                    <div class="print-field">
                        <label class="print-label">نام کارگاه</label>
                        <input class="print-input" value="@printWorkshopName" readonly />
                    </div>
                    <div class="print-field">
                        <label class="print-label">عنوان سربرگ</label>
                        <input class="print-input" @bind="printHeaderTitle" placeholder="نام شرکت/فروشگاه" />
                    </div>
                    <div class="print-field">
                        <label class="print-checkbox">
                            <input type="checkbox" @bind="printShowPrintDate" />
                            <span>نمایش تاریخ پرینت در فاکتور</span>
                        </label>
                    </div>
                    <div class="print-field">
                        <label class="print-checkbox">
                            <input type="checkbox" @bind="printShowInvoiceNumber" />
                            <span>نمایش شماره فاکتور در فاکتور</span>
                        </label>
                    </div>
                    <div class="print-field">
                        <label class="print-label">لوگو</label>
                        <div class="logo-upload">
                            @if (string.IsNullOrEmpty(printLogoUrl))
                            {
                                <div class="logo-placeholder">
                                    <span class="oi oi-image"></span><br />
                                    انتخاب لوگو
                                    <InputFile OnChange="HandlePrintLogoUpload" class="logo-input" accept="image/*" />
                                </div>
                            }
                            else
                            {
                                <div class="logo-preview">
                                    <img src="@printLogoUrl" alt="لوگو" />
                                    <button type="button" class="logo-remove-btn" @onclick="() => printLogoUrl = null">
                                        <span class="oi oi-x"></span>
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="print-field">
                        <label class="print-label">آدرس</label>
                        <input class="print-input" @bind="printAddress" placeholder="آدرس کامل" />
                    </div>
                    <div class="print-field">
                        <label class="print-label">شماره تلفن</label>
                        <input class="print-input ltr" @bind="printPhone" placeholder="021-12345678" />
                    </div>
                    <div class="print-field">
                        <label class="print-label">آدرس وب</label>
                        <input class="print-input ltr" @bind="printWebsite" placeholder="www.example.com" />
                    </div>
                </div>
            }
            else
            {
                <div>
                    <div class="section-title">نوع پرینت</div>
                    <div class="print-type-group">
                        <button class="print-type-card @(!printBulkMode ? "print-type-card--active" : "")" @onclick="async () => await SetPrintBulkMode(false)">
                            <span class="oi oi-document"></span> پرینت این فاکتور
                        </button>
                        <button class="print-type-card @(printBulkMode ? "print-type-card--active" : "")" @onclick="async () => await SetPrintBulkMode(true)">
                            <span class="oi oi-list"></span> پرینت همه فاکتورها
                        </button>
                    </div>

                    @if (printBulkMode)
                    {
                        <div class="date-range-box rl-print-date-range">
                            <div class="date-range-title">بازه زمانی (شمسی)</div>
                            <div class="date-fields">
                                <div class="date-field">
                                    <label>از تاریخ</label>
                                    <input type="text" class="ltr" placeholder="مثال: 1400/01/01" data-jdp autocomplete="off"
                                           @bind="printDateFrom" @bind:event="oninput" />
                                </div>
                                <div class="date-field">
                                    <label>تا تاریخ</label>
                                    <input type="text" class="ltr" placeholder="مثال: 1400/12/29" data-jdp autocomplete="off"
                                           @bind="printDateTo" @bind:event="oninput" />
                                </div>
                            </div>
                            <div class="date-hint">
                                <span class="oi oi-info"></span>
                                تاریخ را به صورت دستی وارد کنید (مثال: 1403/01/01)
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="print-footer">
            <button class="print-btn print-btn--secondary" @onclick="ClosePrintModal">انصراف</button>
            @if (printSettingsTab)
            {
                <button class="print-btn print-btn--primary" @onclick="SavePrintSettings">
                    <span class="oi oi-check"></span> ذخیره
                </button>
            }
            else
            {
                <button class="print-btn print-btn--primary" @onclick="PrintInvoice">
                    <span class="oi oi-print"></span> پرینت
                </button>
            }
        </div>
    </div>
}














<!-- Status Filter Bottom Sheet -->
@if (showStatusSheet)
{
    <div class="rl-sheet-overlay" @onclick="ToggleStatusSheet"></div>
    <div class="rl-sheet rl-sheet--status">
        <div class="rl-sheet__handle"></div>
        <div class="rl-sheet__header">
            <h3 class="rl-sheet__title">فیلتر وضعیت</h3>
            <button class="rl-sheet__close" @onclick="ToggleStatusSheet"><span class="oi oi-x"></span></button>
        </div>
        <div class="rl-sheet__body">
            <div class="rl-status-options">
                <button class="rl-status-option @(string.IsNullOrEmpty(status) ? "rl-status-option--active" : "")" @onclick="@(() => SelectStatusFilter(""))">
                    <span class="rl-status-option__icon oi oi-list"></span>
                    <span class="rl-status-option__text">همه</span>
                </button>
                <button class="rl-status-option rl-status-option--pending @(status == "pending" ? "rl-status-option--active" : "")" @onclick="@(() => SelectStatusFilter("pending"))">
                    <span class="rl-status-option__icon oi oi-clock"></span>
                    <span class="rl-status-option__text">در انتظار</span>
                </button>
                <button class="rl-status-option rl-status-option--not @(status == "not_repairable" ? "rl-status-option--active" : "")" @onclick="@(() => SelectStatusFilter("not_repairable"))">
                    <span class="rl-status-option__icon oi oi-x"></span>
                    <span class="rl-status-option__text">غیر قابل تعمیر</span>
                </button>
                <button class="rl-status-option rl-status-option--repaired @(status == "repaired" ? "rl-status-option--active" : "")" @onclick="@(() => SelectStatusFilter("repaired"))">
                    <span class="rl-status-option__icon oi oi-check"></span>
                    <span class="rl-status-option__text">تعمیر شده</span>
                </button>
                <button class="rl-status-option rl-status-option--delivered @(status == "delivered" ? "rl-status-option--active" : "")" @onclick="@(() => SelectStatusFilter("delivered"))">
                    <span class="rl-status-option__icon oi oi-circle-check"></span>
                    <span class="rl-status-option__text">تحویل داده شده</span>
                </button>
            </div>
        </div>
    </div>
}

