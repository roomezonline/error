    private void ResetValues()
    {
        mainPowerOn = false;
        motorOn = false;
        h1On = false;
        h2On = false;
        sendOn = false;
        receiveOn = false;
        _sendBlink = false;
        _receiveBlink = false;
        voltageCurrent = 0;
        powerCurrent = 0;
        ringCurrent = 0;
        ambientTemp = 0;
        secondaryTemp = 0;
        tertiaryTemp = 0;
        flowValue = 0;
        _historyCount = 0;
        flowData.Clear();
        for (var i = 0; i < FlowCount; i++) flowData.Add(0);
        UpdateFlowPath();
        _e1StartFridge = 0; _e1StopFridge = 0; _e1StartFreezer = 0; _e1StopFreezer = 0;
        _e2StartFridge = 0; _e2StopFridge = 0; _e2StartFreezer = 0; _e2StopFreezer = 0;
    }

    private void UpdateGraphRange()
    {
        if (_graphSource is "h1" or "h2" or "motor")
        {
            _graphFlowMax = 1;
            _graphFlowMin = 0;
            return;
        }
        if (flowData.Count == 0) return;
        var dataMax = flowData.Max();
        var dataMin = flowData.Min();
        var range = dataMax - dataMin;
        if (range < 0.5) range = 0.5;
        _graphFlowMax = dataMax + range * 0.3;
        _graphFlowMin = _graphSource is "freezer" or "ambient" ? dataMin - range * 0.2 : 0;
    }

    private void UpdateFlowPath()
    {
        UpdateGraphRange();
        var n = flowData.Count;
        if (n < 2)
        {
            if (flowData.Count == 0) flowData.Add(0);
            if (flowData.Count < 2) flowData.Add(flowData[0]);
            n = flowData.Count;
        }
        var w = 780.0; var h = 110.0; var pt = 12.0; var pb = 10.0;
        var sx = w / (n - 1); var yr = _graphFlowMax - _graphFlowMin;
        var pts = new (double x, double y)[n];
        for (var i = 0; i < n; i++)
            pts[i] = (i * sx, pt + ((_graphFlowMax - (flowData[i] < _graphFlowMin ? _graphFlowMin : flowData[i] > _graphFlowMax ? _graphFlowMax : flowData[i])) / yr) * (h - pt - pb));
        var d = $"M {pts[0].x:F1},{pts[0].y:F1}";
        for (var i = 0; i < n - 1; i++)
        {
            var cx = (pts[i].x + pts[i + 1].x) / 2;
            var cy = (pts[i].y + pts[i + 1].y) / 2;
            d += $" Q {pts[i].x:F1},{pts[i].y:F1} {cx:F1},{cy:F1}";
        }
        d += $" L {pts[n - 1].x:F1},{pts[n - 1].y:F1}";
        flowPath = d;
        flowFillPath = d + $" L {pts[n - 1].x:F1},{h - pb} L {pts[0].x:F1},{h - pb} Z";
    }

    private void ToggleMainPower()
    {
        if (_pendingCommandValue != null) return;
        if (mainPowerOn)
            _showPowerOffConfirm = true;
        else
            _showPowerConfirm = true;
    }

    private async Task ConfirmPowerToggle()
    {
        try
        {
            var newValue = mainPowerOn ? "off" : "on";
            var sensorType = _sensorType switch
            {
                "clamp" => "clamp",
                _ => "loop"
            };
            var motorType = _motorType switch
            {
                "inverter" => "inverter",
                _ => "simple"
            };
            var resp = await Http.PostAsJsonAsync("api/monitoring/server/command", new { code = Code, value = newValue, sensorType, motorType });
            if (resp.IsSuccessStatusCode)
            {
                _pendingCommandValue = newValue;
                _pendingCommandTime = DateTime.UtcNow;
                StartProgressTimer();
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Console.Error.WriteLine($"Command failed: {err}");
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Command error: {ex.Message}");
        }
        _showPowerConfirm = false;
        _showPowerOffConfirm = false;
    }

