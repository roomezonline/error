    private async Task OnOperatorImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || settings == null) return;

        isUploadingOperator = true;
        try
        {
            using var content = new MultipartFormDataContent();
            using var fs = new MemoryStream();
            await file.OpenReadStream(512 * 1024).CopyToAsync(fs);
            var byteContent = new ByteArrayContent(fs.ToArray());
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var resp = await Http.PostAsync("api/sitesettings/upload-operator-image", content);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<OperatorUploadResult>();
                if (result != null && !string.IsNullOrEmpty(result.Url))
                {
                    settings.ChatOperatorImageUrl = result.Url;
                    ToastService.ShowSuccess("تصویر اپراتور آپلود شد؛ فراموش نکنید ذخیره تغییرات را بزنید");
                }
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(err) ? "خطا در آپلود تصویر" : err);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در آپلود تصویر: " + ex.Message);
        }
        isUploadingOperator = false;
    }

    private class OperatorUploadResult
    {
        public string? Url { get; set; }
    }

    protected override async Task OnInitializedAsync()
    {
        settings = await Http.GetFromJsonAsync<SiteSettingsDto>("api/sitesettings/admin");

        calcDisabled.Clear();
        foreach (var key in CalculatorCatalog.ParseDisabled(settings?.CalculatorsDisabled))
            calcDisabled.Add(key);

        if (settings != null && (settings.HomeModules == null || settings.HomeModules.Count == 0))
        {
            settings.HomeModules = new List<SiteHomeModuleDto>
            {
                new() { Key = SiteHomeModuleKey.SpecialOffers, IsEnabled = settings.ShowSpecialOffers, SortOrder = 10 },
                new() { Key = SiteHomeModuleKey.LatestNews, IsEnabled = settings.ShowLatestNews, SortOrder = 20 },
                new() { Key = SiteHomeModuleKey.LatestProducts, IsEnabled = settings.ShowLatestProducts, SortOrder = 30 },
                new() { Key = SiteHomeModuleKey.LatestAcademy, IsEnabled = settings.ShowLatestAcademy, SortOrder = 40 },
                new() { Key = SiteHomeModuleKey.TeamMembers, IsEnabled = settings.ShowTeamMembers, SortOrder = 50 },
                new() { Key = SiteHomeModuleKey.HomeCategories, IsEnabled = settings.ShowHomeCategories, SortOrder = 5 },
                new() { Key = SiteHomeModuleKey.FeatureCards, IsEnabled = settings.ShowFeatureCards, SortOrder = 18 },
                new() { Key = SiteHomeModuleKey.PopularBrands, IsEnabled = true, SortOrder = 19 },
                new() { Key = SiteHomeModuleKey.SomeCustomers, IsEnabled = true, SortOrder = 21 },
                new() { Key = SiteHomeModuleKey.Stories, IsEnabled = true, SortOrder = 3 }
            };
        }
    }

    private async Task SaveSettings()
    {
        if (settings == null) return;
        isSaving = true;
        try
        {
            settings.CalculatorsDisabled = calcDisabled.Count == 0 ? null : string.Join(",", calcDisabled);
            var resp = await Http.PutAsJsonAsync("api/sitesettings", settings);
            if (resp.IsSuccessStatusCode)
            {
                ImageCompressionHelper.DefaultMaxBytes = (settings.MaxImageUploadSizeKb > 0 ? settings.MaxImageUploadSizeKb : 200) * 1024;
                ToastService.ShowSuccess("تنظیمات با موفقیت ذخیره شد");
            }
            else
            {
                ToastService.ShowError("خطا در ذخیره تنظیمات");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError(ex.Message);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ToggleCalculator(string key, ChangeEventArgs e)
    {
        var enabled = e.Value is bool enabledValue && enabledValue;
        if (enabled) calcDisabled.Remove(key);
        else calcDisabled.Add(key);
    }

    private void EnableAllCalculators() => calcDisabled.Clear();

