    private void SwitchTab(int tab)
    {
        if (_activeTab != tab)
        {
            _activeTab = tab;
        }
    }

    [JSInvokable]
    public void OnScroll(bool isVisible)
    {
        _showScrollTop = isVisible;
        StateHasChanged();
    }

    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    private async Task CopyProductCode()
    {
        if (product == null) return;
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        try
        {
            await JS.InvokeVoidAsync("__copyToClipboard", $"#{product.Id:D6}");
            if (token.IsCancellationRequested) return;
            sharedText = "کد محصول کپی شد";
            StateHasChanged();
            await Task.Delay(2000, token);
            sharedText = null;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch
        {
            if (token.IsCancellationRequested) return;
            sharedText = "خطا در کپی کد";
            StateHasChanged();
            await Task.Delay(2000, token);
            sharedText = null;
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _quantity = 1;
        _activeTab = 0;
        _suggestTab = 0;
        currentImageIndex = 0;
        _lightboxIndex = 0;
        showLightbox = false;
        showShareModal = false;
        _cartBtnState = CartBtnState.Default;
        _cartBtnText = "افزودن به سبد خرید";
        _isAddingToCart = false;
        reviewSummary = null;
        _productCommentDtos = new();
        await LoadProduct();
        _cachedImages = null;
        await InitActionStates();
        await LoadReviews();
        await LoadShopExtras();
    }

    private async Task LoadShopExtras()
    {
        if (_shop == null)
        {
            try { _shop = await HttpApi.GetFromJsonAsync<SiteSettingsDto>("api/sitesettings"); } catch { _shop = new SiteSettingsDto(); }
        }
        if (product == null) return;

        if (Flag("specs"))
        {
            try { _serverSpecs = await HttpApi.GetFromJsonAsync<List<ProductSpecDto>>($"api/products/{product.Id}/specs") ?? new(); }
            catch { _serverSpecs = new(); }
        }

        if (Flag("chart"))
        {
            try { _pricePoints = await HttpApi.GetFromJsonAsync<List<ProductPricePointDto>>($"api/products/{product.Id}/price-history") ?? new(); }
            catch { _pricePoints = new(); }
            // پیش‌فرض روی جدیدترین ثبت قیمت (سمت راست نمودار)
            _chartIndex = _pricePoints.Count - 1;
        }

        if (Flag("qna"))
        {
            await LoadQuestions();
        }
    }

    private async Task LoadQuestions()
    {
        if (product == null) return;
        _qnaLoading = true;
        try
        {
            _questions = await HttpApi.GetFromJsonAsync<List<ProductQuestionDto>>($"api/products/{product.Id}/questions") ?? new();
        }
        catch { _questions = new(); }
        finally { _qnaLoading = false; }
    }

    private async Task SubmitQuestion()
    {
        if (product == null) return;
        var text = _qnaText.Trim();
        if (text.Length < 5)
        {
            ToastService.ShowError("متن پرسش باید حداقل ۵ کاراکتر باشد");
            return;
        }
        _qnaSending = true;
        try
        {
            var resp = await HttpApi.PostAsJsonAsync($"api/products/{product.Id}/questions",
                new ProductQuestionRequest { FullName = _qnaName.Trim(), Question = text });
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("پرسش شما ثبت شد و پس از تأیید نمایش داده می‌شود");
                _qnaText = "";
                await LoadQuestions();
            }
            else
            {
                ToastService.ShowError("خطا در ثبت پرسش");
            }
        }
        catch (Exception ex) { ToastService.ShowError($"خطای سیستمی: {ex.Message}"); }
        finally { _qnaSending = false; }
    }

    private async Task VoteQuestion(int questionId)
    {
        if (product == null) return;
        try
        {
            var resp = await HttpApi.PostAsync($"api/products/{product.Id}/questions/{questionId}/vote", null);
            if (resp.IsSuccessStatusCode) await LoadQuestions();
        }
        catch { }
    }

    private IEnumerable<ProductQuestionDto> FilteredQuestions
    {
        get
        {
            IEnumerable<ProductQuestionDto> list = _questions;
            if (_qnaFilter == "answered") list = list.Where(x => x.IsAnswered);
            else if (_qnaFilter == "pending") list = list.Where(x => !x.IsAnswered);

            if (!string.IsNullOrWhiteSpace(_qnaSearch))
            {
                var s = _qnaSearch.Trim();
                list = list.Where(x =>
                    (x.Question?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (x.FullName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (x.Answer?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return list.ToList();
        }
    }

    private void StartReply(int questionId)
    {
        _replyFor = questionId;
        _replyText = "";
    }

    private void CancelReply()
    {
        _replyFor = null;
        _replyText = "";
    }

    private async Task SubmitReply(int questionId)
    {
        if (product == null || _replySending) return;
        var text = _replyText.Trim();
        if (text.Length < 3) return;

        if (!_isAuthenticated)
        {
            Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}");
            return;
        }

        _replySending = true;
        try
        {
            var resp = await HttpApi.PostAsJsonAsync($"api/products/{product.Id}/questions/{questionId}/reply",
                new ProductQuestionReplyRequest { Body = text });
            if (resp.IsSuccessStatusCode)
            {
                string message = "پاسخ شما ثبت شد";
                try
                {
                    var payload = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    if (payload.TryGetProperty("message", out var m) && m.ValueKind == System.Text.Json.JsonValueKind.String)
                        message = m.GetString() ?? message;
                }
                catch { }

                ToastService.ShowSuccess(message);
                CancelReply();
                await LoadQuestions();
            }
            else
            {
                ToastService.ShowError("خطا در ثبت پاسخ");
            }
        }
        catch (Exception ex) { ToastService.ShowError($"خطای سیستمی: {ex.Message}"); }
        finally { _replySending = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotnetRef = DotNetObjectReference.Create(this);
            _scrollHandlerRef = await JS.InvokeAsync<object>("__pdScrollHandler", dotnetRef);
        }
    }

    private async Task LoadProduct()
    {
        try
        {
            isLoading = true;
            ProductDto? loaded = null;

            if (!string.IsNullOrEmpty(Slug))
            {
                loaded = await HttpApi.GetFromJsonAsync<ProductDto>($"api/products/slug/{Uri.EscapeDataString(Slug)}");
            }
            else if (Id.HasValue)
            {
                loaded = await HttpApi.GetFromJsonAsync<ProductDto>($"api/products/{Id}");
                if (loaded != null && !string.IsNullOrEmpty(loaded.Slug))
                {
                    Nav.NavigateTo(SeoUrl.Product(loaded.Id, loaded.Slug), replace: true);
                    return;
                }
            }

            product = loaded;
            if (product != null)
            {
                productJsonLd = BuildProductJsonLd(product);
                StartCountdown();
                _ = LoadRelatedProducts(product);
                _ = LoadSubstitutes(product);
                _ = TrackRecentlyViewed(product);
            }
        }
        catch { product = null; }
        finally { isLoading = false; }
    }

    private async Task TrackRecentlyViewed(ProductDto p)
    {
        await RecentSvc.AddAsync(new RecentlyViewedItem
        {
            Id = p.Id,
            Slug = p.Slug,
            Name = p.Name,
            ImageUrl = p.MainImageUrl,
            Price = p.Price,
            DiscountPrice = IsDiscountActive(p) ? p.DiscountPrice : null,
            DiscountStartDate = p.DiscountStartDate,
            DiscountExpiryDate = p.DiscountExpiryDate
        });
        _recentItems = await RecentSvc.GetItemsAsync();
        StateHasChanged();
    }

    private async Task LoadRelatedProducts(ProductDto product)
    {
        try
        {
            var excludeIds = new HashSet<int> { product.Id };
            var results = new List<ProductDto>();

            if (!string.IsNullOrWhiteSpace(product.RelatedProductIds))
            {
                var ids = product.RelatedProductIds
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Select(id => int.TryParse(id, out var n) ? n : -1)
                    .Where(id => id > 0)
                    .Distinct()
                    .ToList();

                var tasks = ids
                    .Where(id => !excludeIds.Contains(id))
                    .Select(async pid =>
                    {
                        try
                        {
                            var p = await HttpApi.GetFromJsonAsync<ProductDto>($"api/products/{pid}");
                            if (p != null)
                            {
                                lock (excludeIds) { excludeIds.Add(pid); }
                                return p;
                            }
                        }
                        catch { }
                        return null;
                    });

                var responses = await Task.WhenAll(tasks);
                foreach (var p in responses)
                {
                    if (p != null) results.Add(p);
                }
            }

            if (results.Count < 6)
            {
                var need = 6 - results.Count;
                var query = $"api/products?categoryId={product.CategoryId}&take={need + 1}";
                var categoryProducts = await HttpApi.GetFromJsonAsync<List<ProductDto>>(query);
                if (categoryProducts != null)
                {
                    foreach (var p in categoryProducts)
                    {
                        if (excludeIds.Contains(p.Id)) continue;
                        results.Add(p);
                        excludeIds.Add(p.Id);
                        if (results.Count >= 6) break;
                    }
                }
            }

            relatedProducts = results;
        }
        catch { }
    }

    private async Task LoadSubstitutes(ProductDto current)
    {
        try
        {
            if (current.IsAvailable && current.StockQuantity > 0)
            {
                return;
            }

            var list = await HttpApi.GetFromJsonAsync<List<ProductDto>>(
                $"api/products?categoryId={current.CategoryId}&onlyAvailable=true&take=8");

            var subs = (list ?? new List<ProductDto>())
                .Where(p => p.Id != current.Id && p.IsAvailable && p.StockQuantity > 0)
                .Take(4)
                .ToList();

            substitutes = subs.Count > 0 ? subs : null;
            await InvokeAsync(StateHasChanged);
        }
        catch { substitutes = null; }
    }

    private string BuildProductJsonLd(ProductDto product)
    {
        var price = DiscountHelper.GetEffectivePrice(product);
        var images = GetAllImages();
        var baseUrl = Nav.BaseUri.TrimEnd('/');

        var productSchema = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org/",
            ["@type"] = "Product",
            ["name"] = product.Name,
            ["image"] = images.Count == 1 ? images[0] : images.ToArray(),
            ["description"] = TruncateText(StripHtml(product.Description ?? product.FailureSymptoms ?? product.Name), 500),
            ["url"] = $"{baseUrl}{SeoUrl.Product(product.Id, product.Slug)}",
            ["sku"] = $"ES-{product.Id:D6}",
            ["brand"] = new Dictionary<string, object?> { ["@type"] = "Brand", ["name"] = "ErrorService" },
            ["category"] = product.CategoryName ?? "قطعات یدکی",
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["url"] = $"{baseUrl}{SeoUrl.Product(product.Id, product.Slug)}",
                ["priceCurrency"] = "IRT",
                ["price"] = price.ToString("F0"),
                ["availability"] = product.IsAvailable ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
                ["itemCondition"] = "https://schema.org/NewCondition"
            }
        };

        if (product.DiscountExpiryDate.HasValue)
        {
            var offers = productSchema["offers"] as Dictionary<string, object?>;
            offers!["priceValidUntil"] = product.DiscountExpiryDate.Value.ToString("yyyy-MM-dd");
            if (product.DiscountStartDate.HasValue)
                offers!["priceValidFrom"] = product.DiscountStartDate.Value.ToString("yyyy-MM-dd");
        }

        var breadcrumb = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new List<object>
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = baseUrl },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "محصولات", ["item"] = $"{baseUrl}/products" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = product.CategoryName ?? "محصولات", ["item"] = $"{baseUrl}/products?categoryId={product.CategoryId}" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 4, ["name"] = product.Name }
            }
        };

        var schemaList = new List<object> { productSchema, breadcrumb };

        if (reviewSummary != null && reviewSummary.TotalCount > 0)
        {
            productSchema["aggregateRating"] = new Dictionary<string, object?>
            {
                ["@type"] = "AggregateRating",
                ["ratingValue"] = reviewSummary.AverageRating.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
                ["reviewCount"] = reviewSummary.TotalCount,
                ["bestRating"] = 5,
                ["worstRating"] = 1
            };

            var reviewObjs = new List<object>();
            void CollectReviews(List<ProductReviewDto> items)
            {
                foreach (var r in items)
                {
                    reviewObjs.Add(new Dictionary<string, object?>
                    {
                        ["@type"] = "Review",
                        ["author"] = new Dictionary<string, object?> { ["@type"] = "Person", ["name"] = r.FullName },
                        ["reviewBody"] = r.Content,
                        ["reviewRating"] = new Dictionary<string, object?>
                        {
                            ["@type"] = "Rating",
                            ["ratingValue"] = r.Rating,
                            ["bestRating"] = 5,
                            ["worstRating"] = 1
                        }
                    });
                    if (r.Replies != null && r.Replies.Count > 0) CollectReviews(r.Replies);
                }
            }
            CollectReviews(reviewSummary.Reviews);
            if (reviewObjs.Count > 0)
                productSchema["review"] = reviewObjs;
        }

        return JsonSerializer.Serialize(schemaList);
    }

    private async Task AddToCart()
    {
        if (product == null || _isAddingToCart) return;
        _isAddingToCart = true;
        _cartBtnState = CartBtnState.Spinner;
        _cartBtnText = "در حال افزودن...";
        StateHasChanged();
        await Task.Delay(400);
        await CartService.AddToCartAsync(product, _quantity);
        _cartBtnState = CartBtnState.Done;
        _cartBtnText = "افزوده شد";
        StateHasChanged();
        await Task.Delay(1500);
        _cartBtnState = CartBtnState.Default;
        _cartBtnText = "افزودن به سبد خرید";
        _isAddingToCart = false;
        StateHasChanged();
        ToastService.ShowSuccess($"تعداد {_quantity} عدد از محصول \"{product.Name}\" به سبد خرید اضافه شد.");
    }

    private List<string> GetAllImages()
    {
        if (_cachedImages != null) return _cachedImages;
        var list = new List<string>();
        if (!string.IsNullOrEmpty(product?.MainImageUrl)) list.Add(product.MainImageUrl);
        if (!string.IsNullOrEmpty(product?.ImageUrl2)) list.Add(product.ImageUrl2);
        if (!string.IsNullOrEmpty(product?.ImageUrl3)) list.Add(product.ImageUrl3);
        if (!string.IsNullOrEmpty(product?.ImageUrl4)) list.Add(product.ImageUrl4);
        if (list.Count == 0) list.Add("/images/placeholder-product.svg");
        _cachedImages = list;
        return _cachedImages;
    }

    private void StartCountdown()
    {
        timer?.Dispose();
        if (product?.DiscountExpiryDate == null) return;
        timer = new Timer(_ =>
        {
            var diff = product.DiscountExpiryDate.Value - DateTimeOffset.Now;
            if (diff.TotalSeconds <= 0)
            {
                countdownText = "پایان یافت";
                timer?.Dispose();
            }
            else
            {
                int days = (int)diff.TotalDays;
                countdownText = days > 0
                    ? $"{days} روز و {diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}"
                    : $"{diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}";
            }
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    private static string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength) return text ?? "";
        return text.Substring(0, maxLength - 3) + "...";
    }

    private static string StripHtml(string html)
    {
        return System.Text.RegularExpressions.Regex.Replace(html, @"<[^>]+>", " ").Trim();
    }

    public void Dispose()
    {
        timer?.Dispose();
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        if (_scrollHandlerRef != null)
        {
            _ = JS.InvokeVoidAsync("__pdRemoveScrollHandler", _scrollHandlerRef);
        }
    }

    private enum CartBtnState
    {
        Default,
        Spinner,
        Done
    }
