        }
        catch
        {
            // در صورت خطا همان داده فهرست کافی است؛ متن در ویرایشگر خالی می‌ماند.
        }

        editingId = news.Id;
        currentSlug = news.Slug;
        model = new NewsUpsertRequest
        {
            Title = news.Title ?? string.Empty,
            Summary = news.Summary,
            Content = news.Content ?? string.Empty,
            ImageUrl = news.ImageUrl,
            Tags = news.Tags,
            AuthorName = news.AuthorName,
            IsPublished = news.IsPublished,
            CreatedAt = news.CreatedAt,
            ContentType = news.ContentType,
            CategoryId = news.CategoryId,
            PublishAt = news.PublishAt,
            ExpireAt = news.ExpireAt,
            IsFeatured = news.IsFeatured,
            PinnedUntil = news.PinnedUntil,
            SeoTitle = news.SeoTitle,
            SeoDescription = news.SeoDescription,
            CanonicalUrl = news.CanonicalUrl,
            SourceName = news.SourceName,
            SourceUrl = news.SourceUrl
        };

        createdAtInput = PersianDate.ToJalaliDateTime(news.CreatedAt);
        _publishAtInput = news.PublishAt.HasValue ? PersianDate.ToJalaliDateTime(news.PublishAt.Value) : string.Empty;
        _expireAtInput = news.ExpireAt.HasValue ? PersianDate.ToJalaliDateTime(news.ExpireAt.Value) : string.Empty;
        _pinnedUntilInput = news.PinnedUntil.HasValue ? PersianDate.ToJalaliDateTime(news.PinnedUntil.Value) : string.Empty;
        _seoOpen = !string.IsNullOrWhiteSpace(news.SeoTitle)
                   || !string.IsNullOrWhiteSpace(news.SeoDescription)
                   || !string.IsNullOrWhiteSpace(news.CanonicalUrl)
                   || !string.IsNullOrWhiteSpace(news.SourceName)
                   || !string.IsNullOrWhiteSpace(news.SourceUrl);
        _quillInitialized = false;
        _lastQuillEditingId = 0;
        showEditor = true;
    }

