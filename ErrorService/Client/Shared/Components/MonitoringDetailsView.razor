                        </div>
                    </div>
                </div>
                <div class="md-info-chip md-info-chip--receipt">
                    <div class="md-info-chip__head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                            <rect x="3" y="3" width="18" height="18" rx="2"/>
                            <path d="M9 3v18M15 3v18M3 9h18M3 15h18"/>
                        </svg>
                        <span>رسید</span>
                    </div>
                    <div class="md-info-chip__body">
                        <div class="md-info-field">
                            <span class="md-info-field__label">شماره</span>
                            <span class="md-info-field__val">#@CustomerReceiptId</span>
                        </div>
                        <div class="md-info-field">
                            <span class="md-info-field__label">کارگاه</span>
                            <span class="md-info-field__val">@WorkshopName</span>
                        </div>
                    </div>
                </div>
                <div class="md-info-chip md-info-chip--device">
                    <div class="md-info-chip__head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                            <rect x="2" y="3" width="20" height="14" rx="2"/>
                            <path d="M8 21h8M12 17v4"/>
                        </svg>
                        <span>دستگاه</span>
                    </div>
                    <div class="md-info-chip__body">
                        <div class="md-info-field">
                            <span class="md-info-field__label">نام دستگاه</span>
                            <span class="md-info-field__val">@DeviceTitle</span>
                        </div>
                        <div class="md-info-field">
                            <span class="md-info-field__label">کد مانیتورینگ</span>
                            <span class="md-info-field__val md-info-field__val--code">@MonitoringDeviceTitle</span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="md-info-row">
                <div class="md-info-chip md-info-chip--problem">
                    <div class="md-info-chip__head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                        </svg>
                        <span>شرح مشکل</span>
                    </div>
                    <div class="md-info-chip__body">
                        <span class="md-info-problem">@ProblemDescription</span>
                    </div>
                </div>
                <div class="md-info-chip md-info-chip--meta">
                    <div class="md-info-chip__head">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="16" height="16">
                            <circle cx="12" cy="12" r="10"/>
                            <polyline points="12 6 12 12 16 14"/>
                        </svg>
                        <span>زمان و ثبت</span>
                    </div>
                    <div class="md-info-chip__body">
                        <div class="md-info-field">
                            <span class="md-info-field__label">تاریخ ثبت</span>
                            <span class="md-info-field__val">@CreatedAtFa</span>
                        </div>
                        <div class="md-info-field">
                            <span class="md-info-field__label">ثبت‌کننده</span>
                            <span class="md-info-field__val">@CreatedByUserName</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }



    @if (!IsReadOnly && !_monitoringEnded)
    {
    <div class="md-power-row">
        <div class="md-power-card @(mainPowerOn ? "on" : "off") @(_pendingCommandValue != null ? "pending" : "")">
            <div class="md-power-main">
                <div class="md-power-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" stroke-linejoin="round"/>
                    </svg>
                </div>
                <div class="md-power-info">
                    <div class="md-power-title">برق اصلی</div>
                    <div class="md-power-badge @(mainPowerOn ? "on" : "off")">
                        @if (_pendingCommandValue != null)
                        {
                            <span class="md-power-spinner"></span>
                            <span>در انتظار...</span>
                        }
                        else
                        {
                            <span class="md-power-dot"></span>
                            <span>@(mainPowerOn ? "روشن" : "خاموش")</span>
                        }
                    </div>
                </div>
            </div>
            <div class="md-power-actions">
                <div class="md-power-switch @(mainPowerOn ? "on" : "off") @(_pendingCommandValue != null ? "disabled" : "")" @onclick="ToggleMainPower">
                    <div class="md-power-knob"></div>
                </div>
                <button class="md-power-settings" @onclick="OpenSettings" title="تنظیمات برق">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="15" height="15">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                </button>
            </div>
            @if (_pendingCommandValue != null)
            {
                <div class="md-progress-wrap">
                    <div class="md-progress-bar" style="width:@(_pendingProgress)%"></div>
                </div>
            }
        </div>
    </div>
    }

    @if (!IsReadOnly && _showPowerOffConfirm)
    {
        <div class="md-modal-overlay" @onclick="() => _showPowerOffConfirm = false">
            <div class="md-modal md-modal--danger" @onclick:stopPropagation="true">
                <div class="md-modal-head md-modal-head--danger">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                    <span>قطع برق اصلی</span>
                    <button class="md-modal-close" @onclick="() => _showPowerOffConfirm = false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <div class="md-modal-body" style="text-align:center; padding:30px 20px;">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="1.5" width="48" height="48" style="margin-bottom:12px;">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="12" y1="8" x2="12" y2="13"/>
                        <line x1="12" y1="16" x2="12.01" y2="16"/>
                    </svg>
                    <div style="font-size:15px; font-weight:700; color:#1E2A3A; margin-bottom:6px;">آیا مطمئن هستید؟</div>
                    <div style="font-size:12px; color:#6B7A8A;">دستگاه از برق اصلی جدا خواهد شد</div>
                </div>
                <div class="md-modal-footer">
                    <button class="md-modal-cancel" @onclick="() => _showPowerOffConfirm = false">انصراف</button>
                    <button class="md-modal-confirm md-modal-confirm--danger" @onclick="ConfirmPowerToggle">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        قطع کن
                    </button>
                </div>
            </div>
        </div>
    }

    @if (!IsReadOnly && _showPowerConfirm)
    {
        <div class="md-modal-overlay" @onclick="() => _showPowerConfirm = false">
            <div class="md-modal" @onclick:stopPropagation="true">
                <div class="md-modal-head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" style="vertical-align:middle; margin-left:6px;">
                        <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
                    </svg>
                    <span>تنظیمات قبل از روشن کردن</span>
                    <button class="md-modal-close" @onclick="() => _showPowerConfirm = false">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <div class="md-modal-body">
                    <div class="md-settings-group">
                        <div class="md-settings-label md-label-sensor">نوع سنسور</div>
                        <div class="md-settings-options">
                            <button class="md-settings-btn md-btn-sensor @(_sensorType == "loop" ? "active" : "")" @onclick="SetSensorLoop">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                    <circle cx="12" cy="12" r="3"/>
                                    <path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>
                                </svg>
                                حلقه‌ای
                            </button>
                            <button class="md-settings-btn md-btn-sensor @(_sensorType == "clamp" ? "active" : "")" @onclick="SetSensorClamp">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                    <path d="M6 15V9a4 4 0 118 0v6"/>
                                    <path d="M10 15V9a2 2 0 114 0v6"/>
                                </svg>
                                کلمپی
                            </button>
                        </div>
                    </div>
                    <div class="md-settings-group">
                        <div class="md-settings-label md-label-motor">نوع موتور</div>
                        <div class="md-settings-options">
                            <button class="md-settings-btn md-btn-sensor @(_motorType != "inverter" ? "active" : "")" @onclick="SetMotorSimple">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                    <circle cx="12" cy="12" r="3"/>
                                    <line x1="12" y1="2" x2="12" y2="7"/>
                                    <line x1="12" y1="17" x2="12" y2="22"/>
                                </svg>
                                ساده
                            </button>
                            <button class="md-settings-btn md-btn-sensor @(_motorType == "inverter" ? "active" : "")" @onclick="SetMotorInverter">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                    <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                                </svg>
                                اینورتر
                            </button>
                        </div>
                    </div>
                </div>
                <div class="md-modal-footer">
                    <button class="md-modal-cancel" @onclick="() => _showPowerConfirm = false">انصراف</button>
                    <button class="md-modal-confirm" @onclick="ConfirmPowerToggle">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        روشن کن
                    </button>
                </div>
            </div>
        </div>
    }

    @if (!IsReadOnly && _showAlertModal)
{
    <div class="md-modal-overlay md-modal-overlay--alert" @onclick="() => _showAlertModal = false">
        <div class="md-alert-modal" @onclick:stopPropagation="true">
            <div class="md-alert-modal-head">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="20" height="20">
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                    <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                </svg>
                <span>سیستم اخطارها و هشدارها</span>
                <button class="md-alert-modal-close" @onclick="() => _showAlertModal = false">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M18 6L6 18M6 6l12 12"/>
                    </svg>
                </button>
            </div>
            <div class="md-alert-modal-body">
                <div class="md-alert-tabs">
                    <button class="md-alert-tab @(_alertFilter == "all" ? "active" : "")" @onclick="@(() => SetAlertFilter("all"))">همه</button>
                    <button class="md-alert-tab @(_alertFilter == "active" ? "active" : "")" @onclick="@(() => SetAlertFilter("active"))">فعال</button>
                    <button class="md-alert-tab @(_alertFilter == "resolved" ? "active" : "")" @onclick="@(() => SetAlertFilter("resolved"))">حل شده</button>
                </div>
                @if (_alerts.Count == 0)
                {
                    <div class="md-alert-empty">هیچ پیامی یافت نشد</div>
                }
                else
                {
                    <div class="md-alert-list">
                        @foreach (var alert in _alerts)
                        {
                            <div class="md-alert-card @(alert.State ? "active" : "resolved")">
                                <div class="md-alert-card-head">
                                    <span class="md-alert-type md-alert-type--@alert.Type.ToLower()">
                                        @(alert.Type == "motor" ? "موتور" : alert.Type == "ambient_temp" ? "دمای محیط" : "موتور و المنت")
                                    </span>
                                    <span class="md-alert-state @(alert.State ? "active" : "")">
                                        <span class="md-alert-state-dot"></span>
                                        @(alert.State ? "فعال" : "حل شده")
                                    </span>
                                    <div class="md-alert-actions">
                                        @if (alert.State)
                                        {
                                            <button class="md-alert-action md-alert-action--resolve" @onclick="@(() => ResolveAlert(alert.Id))" title="علامت به عنوان حل شده">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                                                    <polyline points="20 6 9 17 4 12"/>
                                                </svg>
                                            </button>
                                        }
                                        <button class="md-alert-action md-alert-action--delete" @onclick="@(() => DeleteAlert(alert.Id))" title="حذف پیام">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                                <path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                                <div class="md-alert-card-body">
                                    <div class="md-alert-msg">@alert.Message</div>
                                    <div class="md-alert-meta">
                                        <span class="md-alert-time">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12">
                                                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                                            </svg>
                                            @GetAlertTimeFa(alert.Time)
                                        </span>
                                        <span class="md-alert-cmd @GetAlertCmdClass(alert.Command)">
                                            @alert.Command
                                        </span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (_alerts.Count < _alertTotal && _alertFilter == "all")
                {
                    <div class="md-alert-more-wrap">
                        <button class="md-alert-more" @onclick="LoadMoreAlerts" disabled="@_alertLoadingMore">
                            @if (_alertLoadingMore)
                            {
                                <span>در حال بارگذاری...</span>
                            }
                            else
                            {
                                <span>نمایش بیشتر (@(_alertTotal - _alerts.Count) مورد)</span>
                            }
                        </button>
                    </div>
                }
            </div>
            <div class="md-alert-modal-foot">
