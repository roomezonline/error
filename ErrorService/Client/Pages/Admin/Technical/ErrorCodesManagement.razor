    private async Task SaveCatalogItem()
    {
        var name = catalogModalName?.Trim() ?? "";
        if (name.Length == 0) return;

        // Resolve real Id for edit mode (client-merged items may have Id=0)
        var id = catalogModalId;
        var isEdit = id != 0 || !string.IsNullOrEmpty(catalogModalOriginalName);
        if (isEdit && id == 0)
        {
            var existing = FindCatalogItem(catalogModalKind, catalogModalOriginalName)
                ?? FindCatalogItem(catalogModalKind, name);
            if (existing != null && existing.Id != 0)
            {
                id = existing.Id;
                catalogModalId = id;
            }
        }

        isCatalogSaving = true;
        try
        {
            HttpResponseMessage response;
            if (id == 0)
            {
                response = await Http.PostAsJsonAsync("api/technical/error-codes/catalog",
                    new ErrorCodeCatalogItem { Kind = catalogModalKind, Name = name });
            }
            else
            {
                response = await Http.PutAsJsonAsync($"api/technical/error-codes/catalog/{id}",
                    new ErrorCodeCatalogUpsertRequest { Id = id, Name = name });
            }

            if (response.IsSuccessStatusCode || response.StatusCode == System.Net.HttpStatusCode.NoContent)
            {
                Toast.ShowSuccess(id == 0 ? "با موفقیت اضافه شد" : "نام با موفقیت تغییر کرد");
                CloseCatalogModal();
                await LoadData();
            }
            else
            {
                var message = await ReadErrorMessage(response, "خطا در ذخیره");
                Toast.ShowError(message);
            }
        }
        catch
        {
            Toast.ShowError("خطا در ذخیره");
        }
        isCatalogSaving = false;
    }

    private void AskDeleteCatalog(ErrorCodeCatalogKind kind, string name)
    {
        if (string.IsNullOrWhiteSpace(name)) return;
        var item = FindCatalogItem(kind, name.Trim());
        if (item == null)
        {
            Toast.ShowError($"«{name}» در لیست یافت نشد");
            return;
        }

        catalogDeleteKind = kind;
        catalogDeleteName = item.Name;

        if (item.UsageCount > 0)
        {
            Toast.ShowError($"«{item.Name}» در {item.UsageCount} مورد استفاده شده و قابل حذف نیست.");
            return;
        }

        catalogDeleteMessage = $"آیا از حذف «{item.Name}» از لیست {CatalogKindLabel(kind)} مطمئن هستید؟ فقط زمانی ممکن است که در هیچ کد خطا استفاده نشده باشد.";
        showCatalogDeleteConfirm = true;
    }

    private async Task HandleCatalogDeleteResult(bool confirmed)
    {
        showCatalogDeleteConfirm = false;
        if (!confirmed) return;

        var item = FindCatalogItem(catalogDeleteKind, catalogDeleteName);
        if (item == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/technical/error-codes/catalog/{item.Id}");
            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("با موفقیت حذف شد");
                if (catalogDeleteKind == ErrorCodeCatalogKind.Brand && filterBrand == item.Name) filterBrand = "";
                if (catalogDeleteKind == ErrorCodeCatalogKind.DeviceType && filterDevice == item.Name) filterDevice = "";
                if (catalogDeleteKind == ErrorCodeCatalogKind.Category && filterCategory == item.Name) filterCategory = "";
                await LoadData();
            }
            else
            {
                var message = await ReadErrorMessage(response, "خطا در حذف");
                Toast.ShowError(message);
            }
        }
        catch
        {
            Toast.ShowError("خطا در حذف");
        }
    }

    private void OpenModal(ErrorCode? item = null)
    {
        editingItem = item != null
            ? new ErrorCode
            {
                Id = item.Id,
                Brand = item.Brand,
                DeviceType = item.DeviceType,
                Code = item.Code,
                Description = item.Description,
                Solution = item.Solution,
                TechnicalNotes = item.TechnicalNotes,
                ImageUrl = item.ImageUrl,
                Category = item.Category,
                ModelNames = item.ModelNames,
                RelatedProductIds = item.RelatedProductIds,
                Documents = item.Documents != null
                    ? item.Documents.Select(d => new ErrorCodeDocument
                    {
                        Id = d.Id,
                        ErrorCodeId = d.ErrorCodeId,
                        Title = d.Title,
                        Url = d.Url,
                        DocType = d.DocType,
                        SortOrder = d.SortOrder
                    }).ToList()
                    : new List<ErrorCodeDocument>()
            }
            : new ErrorCode();
        showModal = true;
    }

    private void EditDuplicate(ErrorCode item)
    {
        OpenModal(item);
    }

