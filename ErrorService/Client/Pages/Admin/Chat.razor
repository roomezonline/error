    private async Task TestAiConnection()
    {
        _aiTestBusy = true;
        _aiTestMessage = null;
        _aiTestOk = null;
        StateHasChanged();
        var sw = System.Diagnostics.Stopwatch.StartNew();
        try
        {
            var resp = await Http.PostAsJsonAsync("api/chat/ai-test", new
            {
                model = ResolveModelValue(),
                apiUrl = _siteAiApiUrl,
                apiKey = _siteAiApiKey,
                temperature = _siteAiTemperature,
                maxTokens = _siteAiMaxTokens
            });
            var json = await resp.Content.ReadFromJsonAsync<JsonElement>();
            sw.Stop();
            _aiTestOk = json.TryGetProperty("success", out var s) && s.GetBoolean();
            var msg = json.TryGetProperty("message", out var m) ? m.GetString() ?? "" : "";
            var model = json.TryGetProperty("model", out var md) ? md.GetString() ?? "" : "";
            if (!string.IsNullOrEmpty(model)) msg += $" | مدل: {model}";
            if (json.TryGetProperty("elapsedMs", out var ems) && ems.ValueKind == JsonValueKind.Number)
                msg += $" | زمان پاسخ: {ToFaNum(ems.GetInt64())} میلی‌ثانیه";
            if (_aiTestOk == true && json.TryGetProperty("reply", out var r))
                msg += "\nنمونه پاسخ: " + (r.GetString() ?? "");
            _aiTestMessage = msg;
            if (_aiTestOk == true) _ = LoadAiCredits();
        }
        catch
        {
            sw.Stop();
            _aiTestOk = false;
            _aiTestMessage = $"خطا در ارتباط با سرور ({ToFaNum(sw.ElapsedMilliseconds)} میلی‌ثانیه).";
        }
        finally
        {
            _aiTestBusy = false;
        }
    }

