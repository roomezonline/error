            var url = WsSettingsUrl("api/workshop-sms/settings");
            var response = await Http.PutAsJsonAsync(url, _wsSettingsEdit);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("تنظیمات کارگاه با موفقیت ذخیره شد");
                await LoadWorkshopSettings();
