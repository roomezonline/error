    private IEnumerable<ProductQuestionDto> FilteredQuestions
    {
        get
        {
            IEnumerable<ProductQuestionDto> list = _questions;
            if (_qnaFilter == "answered") list = list.Where(x => x.IsAnswered);
            else if (_qnaFilter == "pending") list = list.Where(x => !x.IsAnswered);

            if (!string.IsNullOrWhiteSpace(_qnaSearch))
            {
                var s = _qnaSearch.Trim();
                list = list.Where(x =>
                    (x.Question?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (x.FullName?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (x.Answer?.Contains(s, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return list.ToList();
        }
    }

