<ErrorBoundaryLogger>
<CascadingAuthenticationState>
@using ErrorService.Shared
@using ErrorService.Client.Helpers
@using ErrorService.Client.Services
@implements IDisposable
@inject HttpClient Http
    @inject NavigationManager NavigationManager
    @inject IJSRuntime JS
    @inject LocalStorageService LocalStorage

    @if (isMaintenance && !IsAdminPath())
    {
        <StatusPage Type="maintenance" Title="سایت در حال بروزرسانی است" Message="ما در حال بهبود خدمات برای شما هستیم. لطفاً دقایقی دیگر دوباره مراجعه کنید." ShowBackButton="false" />
    }
    else
    {
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        <StatusPage Type="403" Title="دسترسی غیرمجاز" Message="شما اجازه دسترسی به این بخش را ندارید. لطفاً وارد حساب کاربری خود شوید." />
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>404 - یافت نشد</PageTitle>
                <StatusPage Type="404" Title="صفحه یافت نشد" Message="متاسفانه صفحه مورد نظر شما وجود ندارد یا جابجا شده است." />
            </NotFound>
        </Router>
    }

    @code {
        private bool isMaintenance = false;
        private string _lastTrackedPath = "";
        private string _firstReferrer = "";
        private bool _initialTrackDone = false;

        protected override async Task OnInitializedAsync()
        {
            try
            {
                var settings = await Http.GetFromJsonAsync<SiteSettingsDto>("api/sitesettings");
                isMaintenance = settings?.IsMaintenanceMode ?? false;
                ImageCompressionHelper.DefaultMaxBytes = (settings?.MaxImageUploadSizeKb ?? 200) * 1024;
                var gaTag = settings?.GoogleAnalyticsTag;
                if (!string.IsNullOrWhiteSpace(gaTag))
                {
                    await JS.InvokeVoidAsync("loadGoogleAnalytics", gaTag);
                }
            }
            catch
            {
                isMaintenance = false;
            }

            try
            {
                _firstReferrer = await JS.InvokeAsync<string>("getDocReferrer") ?? "";
            }
            catch
            {
                _firstReferrer = "";
            }

            // ثبت بازدید صفحه اول بارگذاری
            if (!_initialTrackDone)
            {
                _initialTrackDone = true;
                _ = TrackVisitAsync(NavigationManager.Uri, isFirst: true);
            }

            NavigationManager.LocationChanged += OnLocationChanged;
        }

        private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        {
            _ = TrackVisitAsync(e.Location, isFirst: false);
        }

        public void Dispose()
        {
            NavigationManager.LocationChanged -= OnLocationChanged;
        }

        private async Task TrackVisitAsync(string uri, bool isFirst)
        {
            try
            {
                if (isMaintenance) return;

                var baseUri = NavigationManager.BaseUri;
                if (!uri.StartsWith(baseUri, StringComparison.OrdinalIgnoreCase)) return;

                var path = uri.Substring(baseUri.Length);
                if (string.IsNullOrEmpty(path)) path = "/";

                // حذف پارامتر کوئری/هش — یک صفحه با query متفاوت نباید چند بار شمرده شود
                var queryStart = path.IndexOfAny(new[] { '?', '#' });
                if (queryStart >= 0) path = path[..queryStart];
                if (string.IsNullOrEmpty(path)) path = "/";

                if (path[0] != '/') path = "/" + path;
                if (path.StartsWith("/admin") || path.StartsWith("/login") || path.StartsWith("/api")) return;
                if (path == _lastTrackedPath) return;
                _lastTrackedPath = path;

                var visitorId = await LocalStorage.GetAsync("es_vid");
                if (string.IsNullOrWhiteSpace(visitorId))
                {
                    visitorId = Guid.NewGuid().ToString("N");
                    await LocalStorage.SetAsync("es_vid", visitorId);
                }

                var referrer = isFirst ? _firstReferrer : "";

                // ارسال بدون انتظارِ ناوبری — ردیابی هرگز نباید کاربر را معطل کند
                await Http.PostAsJsonAsync("api/visits/track", new VisitTrackRequest
                {
                    Path = path,
                    Referrer = referrer ?? "",
                    VisitorId = visitorId
                });
            }
            catch
            {
                // ردیابی سکوت‌محور است
            }
        }

        private bool IsAdminPath()
        {
            var uri = NavigationManager.Uri.ToLower();
            var baseUri = NavigationManager.BaseUri.ToLower();
            var relativePath = uri.Replace(baseUri, "");
            return relativePath.StartsWith("admin") || relativePath.StartsWith("login");
        }
    }
</CascadingAuthenticationState>
</ErrorBoundaryLogger>
