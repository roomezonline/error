    private void CloseCustomerSummary()
    {
        showCustomerSummaryModal = false;
        customerSummaryReceipt = null;
        customerAllReceipts = null;
        customerFinancialSummary = null;
        csExpandedReceiptId = null;
        csLoadingDetailsReceiptId = null;
