    /* تبلت: ستون «بازدید» حذف و عرض ستون‌ها جمع‌وجور می‌شود تا ردیف‌ها به‌هم نریزند */
    @@media (max-width: 991.98px) {
        .ptable__head, .ptable__row {
            grid-template-columns: minmax(170px, 2fr) minmax(90px, 1fr) 120px 74px 92px 92px;
            gap: 8px;
            padding: 10px 12px;
        }
        .ptable__head span:nth-child(6),
        .ptable__row > .ptable__cell:nth-child(6) { display: none; }
