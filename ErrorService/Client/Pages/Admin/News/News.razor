    private async Task LoadLinkTabAsync(string tab)
    {
        var alreadyLoaded = tab switch
        {
            "news" => _linkNewsLoaded,
            "article" => _linkArticlesLoaded,
            "course" => _linkCoursesLoaded,
            "product" => _linkProductsLoaded,
            "errorcode" => _linkErrorCodesLoaded,
            _ => true
        };
        if (alreadyLoaded) return;

        _linkPickerLoading = true;
        _linkPickerError = null;
        StateHasChanged();

        try
        {
            switch (tab)
            {
                case "news":
                {
                    var news = await Http.GetFromJsonAsync<List<NewsDto>>("api/news?onlyPublished=true&take=100") ?? new();
                    _linkNews = news
                        .Where(x => x.Id != editingId && !string.IsNullOrWhiteSpace(x.Title))
                        .Select(x => new LinkPickerItem(
                            "news",
                            "خبر مرتبط",
                            x.Title!,
                            $"/news/{(string.IsNullOrWhiteSpace(x.Slug) ? x.Id.ToString() : x.Slug!)}",
                            Short(x.Summary, 90)))
                        .ToList();
                    _linkNewsLoaded = true;
                    break;
                }
                case "article":
                {
                    var articles = await Http.GetFromJsonAsync<List<TrainingArticleDto>>("api/trainingarticles?onlyPublished=true") ?? new();
                    _linkArticles = articles
                        .Where(x => !string.IsNullOrWhiteSpace(x.Title))
                        .Select(x => new LinkPickerItem(
                            "article",
                            "مقاله آموزشی",
                            x.Title,
                            $"/academy/articles/{(string.IsNullOrWhiteSpace(x.Slug) ? x.Id.ToString() : x.Slug!)}",
                            Short(x.Summary, 90)))
                        .ToList();
                    _linkArticlesLoaded = true;
                    break;
                }
                case "course":
                {
                    var courses = await Http.GetFromJsonAsync<List<TrainingCourseDto>>("api/trainings/courses?onlyPublished=true") ?? new();
                    _linkCourses = courses
                        .Where(x => !string.IsNullOrWhiteSpace(x.Title))
                        .Select(x => new LinkPickerItem(
                            "course",
                            "دوره آموزشی",
                            x.Title,
                            $"/academy/{(string.IsNullOrWhiteSpace(x.Slug) ? x.Id.ToString() : x.Slug!)}",
                            Short(x.Summary, 90)))
                        .ToList();
                    _linkCoursesLoaded = true;
                    break;
                }
                case "product":
                {
                    var products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products?take=100") ?? new();
                    _linkProductsBase = MapProducts(products);
                    _linkProducts = _linkProductsBase;
                    _linkProductsLoaded = true;
                    break;
                }
                case "errorcode":
                {
                    var recent = await Http.GetFromJsonAsync<List<ErrorCodeQuickSearchItem>>("api/technical/error-codes/recent?take=60") ?? new();
                    _linkErrorCodesBase = MapErrorCodes(recent);
                    _linkErrorCodes = _linkErrorCodesBase;
                    _linkErrorCodesLoaded = true;
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            _linkPickerError = "دریافت فهرست این بخش ناموفق بود.";
            Console.Error.WriteLine($"Link picker load error: {ex.Message}");
        }
        finally
        {
            _linkPickerLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnLinkQueryChanged()
    {
        _linkPickerSelected = null;

        if (_linkPickerTab is not ("product" or "errorcode"))
        {
            StateHasChanged();
            return;
        }

        _linkQueryCts?.Cancel();
        var cts = new CancellationTokenSource();
        _linkQueryCts = cts;

        try { await Task.Delay(320, cts.Token); }
        catch (OperationCanceledException) { return; }

        var q = _linkPickerQuery.Trim();
        if (q.Length < 2)
        {
            if (_linkPickerTab == "product") _linkProducts = _linkProductsBase;
            else _linkErrorCodes = _linkErrorCodesBase;
            StateHasChanged();
            return;
        }

        _linkPickerLoading = true;
        StateHasChanged();

        try
        {
            if (_linkPickerTab == "product")
            {
                var products = await Http.GetFromJsonAsync<List<ProductDto>>($"api/products?take=60&search={Uri.EscapeDataString(q)}", cts.Token) ?? new();
                _linkProducts = MapProducts(products);
            }
            else
            {
                var result = await Http.GetFromJsonAsync<ErrorCodeQuickSearchResult>(
                    $"api/technical/error-codes/quick-search?q={Uri.EscapeDataString(q)}&take=20", cts.Token) ?? new();
                _linkErrorCodes = MapErrorCodes(result.Items);
            }
        }
        catch (OperationCanceledException)
        {
            return;
        }
        catch (Exception ex)
        {
            _linkPickerError = "جستجو ناموفق بود.";
            Console.Error.WriteLine($"Link picker search error: {ex.Message}");
        }
        finally
        {
            if (!cts.IsCancellationRequested)
            {
                _linkPickerLoading = false;
                StateHasChanged();
            }
        }
    }

    private static List<LinkPickerItem> MapProducts(IEnumerable<ProductDto> items) =>
        items
            .Where(p => !p.IsDraft && !string.IsNullOrWhiteSpace(p.Name))
            .Select(p => new LinkPickerItem(
                "product",
                "محصول",
                p.Name,
                $"/products/{(string.IsNullOrWhiteSpace(p.Slug) ? p.Id.ToString() : p.Slug!)}",
                p.CategoryName ?? string.Empty))
            .ToList();

    private static List<LinkPickerItem> MapErrorCodes(IEnumerable<ErrorCodeQuickSearchItem> items) =>
        items
            .Where(e => !string.IsNullOrWhiteSpace(e.Code))
            .Select(e => new LinkPickerItem(
                "errorcode",
                "کد خطا",
                string.IsNullOrWhiteSpace(e.Description) ? $"کد خطای {e.Code}" : $"کد خطای {e.Code} – {Short(e.Description, 70)}",
                $"/technical/error-codes/{Uri.EscapeDataString(e.Brand)}/{Uri.EscapeDataString(e.DeviceType)}/{Uri.EscapeDataString(e.Code)}",
                string.Join(" • ", new[] { e.Brand, e.DeviceType }.Where(x => !string.IsNullOrWhiteSpace(x)))))
            .ToList();

