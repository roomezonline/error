                                    <tr style="background:#f3f4f6;">
                                        <th style="padding:4px 6px; border:1px solid #d1d5db; text-align:center;">فیلد</th>
                                        <th style="padding:4px 6px; border:1px solid #d1d5db; text-align:center;">فایل CSV</th>
                                        <th style="padding:4px 6px; border:1px solid #d1d5db; text-align:center;">مانیتورینگ جاری</th>
                                    </tr>
                                    <tr style="@(_csvDiagnostics.CsvDetails.ConnectionId != _csvDiagnostics.CurrentDetails.ConnectionId ? "background:#fef2f2;" : "")">
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-weight:600;">ConnectionId</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-family:monospace;">@_csvDiagnostics.CsvDetails.ConnectionId</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-family:monospace;">@_csvDiagnostics.CurrentDetails.ConnectionId</td>
                                    </tr>
                                    <tr style="@(_csvDiagnostics.CsvDetails.CustomerReceiptId != _csvDiagnostics.CurrentDetails.CustomerReceiptId ? "background:#fef2f2;" : "")">
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-weight:600;">CustomerReceiptId</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-family:monospace;">@_csvDiagnostics.CsvDetails.CustomerReceiptId</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-family:monospace;">@_csvDiagnostics.CurrentDetails.CustomerReceiptId</td>
                                    </tr>
                                    <tr style="@(_csvDiagnostics.CsvDetails.CustomerName != _csvDiagnostics.CurrentDetails.CustomerName ? "background:#fef2f2;" : "")">
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-weight:600;">CustomerName</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db;">@_csvDiagnostics.CsvDetails.CustomerName</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db;">@_csvDiagnostics.CurrentDetails.CustomerName</td>
                                    </tr>
                                    <tr style="@(_csvDiagnostics.CsvDetails.DeviceTitle != _csvDiagnostics.CurrentDetails.DeviceTitle ? "background:#fef2f2;" : "")">
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-weight:600;">DeviceTitle</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db;">@_csvDiagnostics.CsvDetails.DeviceTitle</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db;">@_csvDiagnostics.CurrentDetails.DeviceTitle</td>
                                    </tr>
                                    <tr style="@(_csvDiagnostics.CsvDetails.DeviceNumber != _csvDiagnostics.CurrentDetails.DeviceNumber ? "background:#fef2f2;" : "")">
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-weight:600;">DeviceNumber</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-family:monospace;">@_csvDiagnostics.CsvDetails.DeviceNumber</td>
                                        <td style="padding:3px 6px; border:1px solid #d1d5db; font-family:monospace;">@_csvDiagnostics.CurrentDetails.DeviceNumber</td>
                                    </tr>
                                </table>
                            </div>
                        }
                    }

                    <div style="border:2px dashed #d1d5db; border-radius:10px; padding:20px; margin-bottom:12px; background:#f9fafb;">
                        <div style="font-size:12px; color:#6B7A8A; margin-bottom:8px;">فایل CSV دانلود شده از آرشیو را انتخاب کنید</div>
                        <InputFile OnChange="UploadCsvAndViewChart" accept=".csv" disabled="@_csvUploading" style="display:block; margin:0 auto; font-size:13px;" />
                    </div>

                    @if (_csvUploading)
                    {
                        <div style="display:flex; align-items:center; justify-content:center; gap:8px; font-size:12px; color:#6B7A8A;">
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>در حال آپلود و پردازش فایل...</span>
                        </div>
                    }
                </div>
                <div class="md-modal-footer">
                    <button class="md-modal-cancel" @onclick="CloseCsvUpload">انصراف</button>
                </div>
            </div>
        </div>
    }

    @if (_monitoringEnded)
    {
