@page "/academy/articles/{ArticleId:int}"
@page "/academy/articles/{Slug}"
@using ErrorService.Shared
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using ErrorService.Client.Utils
@implements IDisposable

<PageTitle>@(article?.Title ?? "مشاهده آموزش") - آکادمی</PageTitle>

<div class="article-viewer-page py-4 bg-light" dir="rtl">
    <div class="container">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (loadError)
        {
            <SeoHeader Title="خطا | ارور سرویس" Description="متاسفانه در دریافت اطلاعات خطایی رخ داد." />
            <div class="alert alert-danger text-center py-5 rounded-4 shadow-sm">
                <h3 class="fw-bold">خطا در دریافت اطلاعات</h3>
                <p class="text-muted mb-3">امکان ارتباط با سرور وجود ندارد. لطفاً بعداً تلاش کنید.</p>
                <button class="btn btn-primary rounded-pill px-4" @onclick="Reload">تلاش مجدد</button>
                <a href="/academy" class="btn btn-outline-secondary rounded-pill px-4 me-2">بازگشت به آکادمی</a>
            </div>
        }
        else if (article == null)
        {
            <SeoHeader Title="مقاله یافت نشد | ارور سرویس" Description="متاسفانه مقاله مورد نظر یافت نشد." />
            <div class="alert alert-warning text-center py-5 rounded-4 shadow-sm">
                <h3 class="fw-bold">مقاله مورد نظر یافت نشد!</h3>
                <a href="/academy" class="btn btn-primary mt-3 rounded-pill px-4">بازگشت به آکادمی</a>
            </div>
        }
        else
        {
            <SeoHeader 
                Title="@($"{article.Title} | مقاله آموزشی | ارور سرویس")" 
                Description="@(string.IsNullOrEmpty(article.Summary) ? $"مطالعه مقاله آموزشی {article.Title} در آکادمی ارور سرویس" : (article.Summary.Length > 160 ? article.Summary.Substring(0, 157) + "..." : article.Summary))"
                OgType="article"
                OgImage="@(article.CoverImageUrl ?? "/images/og-default.jpg")"
                JsonLd="@articleJsonLd" />

            <div class="article-header-sticky d-lg-none shadow-sm">
                <div class="container d-flex align-items-center justify-content-between h-100 px-2">
                    <a href="/academy" class="nav-btn-mobile" title="بازگشت به آکادمی" aria-label="بازگشت به آکادمی">
                        <span class="oi oi-arrow-right nav-btn-mobile__icon ms-0"></span>
                    </a>
                    <div class="header-title-text text-truncate px-2">@article.Title</div>
                    <button class="nav-btn-mobile" @onclick="OpenShareModal" title="اشتراک‌گذاری" aria-label="اشتراک‌گذاری">
                        <span class="oi oi-share nav-btn-mobile__icon me-0"></span>
                    </button>
                </div>
            </div>

            <div class="d-none d-lg-flex align-items-center justify-content-between mb-3">
                <a href="/academy" class="btn btn-outline-secondary rounded-pill px-3">
                    <span class="oi oi-arrow-right me-1"></span> بازگشت به آکادمی
                </a>
            </div>

            <nav aria-label="breadcrumb" class="d-none d-lg-block mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/academy">آکادمی</a></li>
                    <li class="breadcrumb-item active">@article.Title</li>
                </ol>
            </nav>

            <div class="row g-4 justify-content-center">
                <div class="col-lg-8">
                    <article class="card border-0 shadow-sm overflow-hidden mb-4" style="border-radius: 1.25rem;">
                        @if (!string.IsNullOrEmpty(article.CoverImageUrl))
                        {
                            <img src="@article.CoverImageUrl" class="article-hero-img" alt="@article.Title" />
                        }
                        
                        <div class="card-body p-4 p-md-5">
                            <h1 class="fw-black display-6 mb-4">@article.Title</h1>
                            
                            <div class="d-flex flex-wrap align-items-center gap-3 mb-5 pb-4 border-bottom">
                                <div class="badge bg-primary text-white rounded-pill px-3 py-2">@(article.IsPremium ? "آموزش ویژه" : "آموزش رایگان")</div>
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <span class="oi oi-person"></span>
                                    ارسال کننده: تیم ارور سرویس
                                </div>
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <span class="oi oi-calendar"></span>
                                    @PersianDate.ToJalaliDate(article.CreatedAt)
                                </div>
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <span class="oi oi-clock"></span>
                                    @PersianDate.ToTime(article.CreatedAt)
                                </div>
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <span class="oi oi-timer"></span>
                                    زمان مطالعه: @readingTime دقیقه
                                </div>
                                @if (article.Blocks.Count > 0)
                                {
                                    <div class="text-muted small d-flex align-items-center gap-1">
                                        <span class="oi oi-layers"></span>
                                        @article.Blocks.Count بخش
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(article.Summary))
                            {
                                <div class="article-summary p-4 rounded-4 mb-5 border-right-primary">
                                    <p class="text-muted mb-0 italic">@article.Summary</p>
                                </div>
                            }

                            @if (tocItems.Count > 0)
                            {
                                <div class="toc-mobile d-lg-none mb-5">
                                    <div class="toc-mobile-header" @onclick="ToggleMobileToc">
                                        <span class="oi oi-list me-2"></span>
                                        فهرست مطالب
                                        <span class="toc-mobile-arrow @(mobileTocOpen ? "open" : "")">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                                        </span>
                                    </div>
                                    @if (mobileTocOpen)
                                    {
                                        <div class="toc-mobile-body">
                                            @foreach (var toc in tocItems)
                                            {
                                                <a href="#@toc.Id" class="toc-mobile-link @(toc.Level == 3 ? "toc-mobile-link--h3" : "")" @onclick:preventDefault="true" @onclick="@(() => ScrollToToc(toc.Id))">@toc.Title</a>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <div class="article-content-blocks">
                                @foreach (var block in article.Blocks.OrderBy(x => x.SortOrder))
                                {
                                    <div class="content-block mb-5" @key="block.Id">
                                        @if (!string.IsNullOrEmpty(block.Title))
                                        {
                                            <h4 class="fw-bold mb-3 h4">@block.Title</h4>
                                        }

                                        @switch (block.BlockType)
                                        {
                                            case TrainingBlockTypeDto.Text:
                                                var textHtml = _processedContent.TryGetValue(block.Id, out var p) ? p : (block.Content ?? "");
                                                <div class="text-content">@((MarkupString)HtmlSanitizer.Sanitize(textHtml))</div>
                                                break;

                                            case TrainingBlockTypeDto.Image:
                                                <div class="image-block text-center">
                                                    <img src="@block.Url" alt="@(block.Title ?? "تصویر آموزش")" class="img-fluid rounded-4 shadow-sm" loading="lazy" @onclick="@(() => OpenImageLightbox(block.Url ?? ""))" style="cursor: zoom-in;" />
                                                    @if (!string.IsNullOrEmpty(block.Content))
                                                    {
                                                        <p class="text-muted small mt-2">@block.Content</p>
                                                    }
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.Video:
                                                <div class="video-block">
                                                    <div class="plyr-wrapper rounded-4 overflow-hidden shadow-sm">
                                                        @if (!string.IsNullOrEmpty(block.ThumbnailUrl))
                                                        {
                                                            <video controls class="js-plyr" poster="@block.ThumbnailUrl" preload="metadata">
                                                                <source src="@block.Url" type="@GetVideoMime(block.Url)" />
                                                            </video>
                                                        }
                                                        else
                                                        {
                                                            <video controls class="js-plyr" preload="metadata">
                                                                <source src="@block.Url" type="@GetVideoMime(block.Url)" />
                                                            </video>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(block.Content))
                                                    {
                                                        <p class="text-muted small mt-2">@block.Content</p>
                                                    }
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.Audio:
                                                <div class="audio-block">
                                                    <div class="plyr-wrapper rounded-4 overflow-hidden shadow-sm bg-dark p-4">
                                                        <audio controls class="js-plyr" preload="metadata">
                                                            <source src="@block.Url" type="audio/mpeg" />
                                                        </audio>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(block.Content))
                                                    {
                                                        <p class="text-muted small mt-2">@block.Content</p>
                                                    }
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.File:
                                                <div class="download-box-wrapper my-5">
                                                    <div class="download-box">
                                                        <div class="download-box__shine"></div>
                                                        <div class="download-box__content">
                                                            <div class="download-box__icon">
                                                                <span class="oi oi-data-transfer-download"></span>
                                                            </div>
                                                            <div class="download-box__info">
                                                                <h5 class="download-box__title">@(string.IsNullOrEmpty(block.Title) ? "فایل ضمیمه آموزش" : block.Title)</h5>
                                                                <div class="download-box__meta">
                                                                    <span class="download-box__tag"><span class="oi oi-paperclip"></span> فایل آموزشی</span>
                                                                    @if (!string.IsNullOrEmpty(block.Url))
                                                                    {
                                                                        <span class="download-box__tag"><span class="oi oi-link-intact"></span> لینک مستقیم</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                            <a href="@block.Url" target="_blank" class="download-box__btn">
                                                                <span class="download-box__btn-text">دانلود فایل</span>
                                                                <span class="oi oi-cloud-download download-box__btn-icon"></span>
                                                            </a>
                                                        </div>
                                                    </div>
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.Embed:
                                                <div class="embed-block">
                                                    <div class="embed-wrapper rounded-4 overflow-hidden shadow-sm">
                                                        @((MarkupString)HtmlSanitizer.Sanitize(block.Content ?? ""))
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(block.Url))
                                                    {
                                                        <p class="text-muted small mt-2">@block.Url</p>
                                                    }
                                                </div>
                                                break;
                                        }
                                    </div>
                                }
                            </div>

                            <div class="d-flex align-items-center justify-content-center mt-5 pt-4 border-top">
                                <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenShareModal">
                                    <span class="oi oi-share me-2"></span> اشتراک‌گذاری
                                </button>
                            </div>

                            <div class="mt-5 pt-5 border-top">
                                <CommentSection HeaderTitle="نظرات کاربران"
                                                FormTitle="ارسال نظر جدید"
                                                ShowRating="true"
                                                ShowStarSummary="true"
                                                RequireEmail="false"
                                                SubmitEndpoint="@($"api/trainingarticles/{(ArticleId ?? article?.Id ?? 0)}/comments")"
                                                AverageRating="@article.AverageRating"
                                                TotalCount="@(article.Comments?.Count ?? 0)"
                                                Comments="@_academyCommentDtos"
                                                SubmitComment="@HandleAcademyCommentSubmit" />
                            </div>
                        </div>
                    </article>
                </div>

                <div class="col-lg-4">
                    <div class="position-sticky" style="top: 1.5rem;">
                        <div class="card border-0 shadow-sm overflow-hidden mb-4 d-none d-lg-block" style="border-radius: 1.25rem;">
                            <div class="card-header bg-white border-0 py-3 px-4">
                                <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                                    <span class="oi oi-list"></span>
                                    فهرست مطالب
                                </h5>
                            </div>
                            <div class="card-body p-3">
                                @if (tocItems.Count > 0)
                                {
                                        <nav class="toc-nav">
                                            @foreach (var toc in tocItems)
                                            {
                                                <a href="#@toc.Id" class="toc-link @(toc.Level == 3 ? "toc-link--h3" : "")" @onclick:preventDefault="true" @onclick="@(() => ScrollToToc(toc.Id))">@toc.Title</a>
                                            }
                                        </nav>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0 px-2">این آموزش فهرست جداگانه‌ای ندارد.</p>
                                }
                            </div>
                        </div>

                        @if (article.Blocks.Any(b => b.BlockType == TrainingBlockTypeDto.Video || b.BlockType == TrainingBlockTypeDto.Audio || b.BlockType == TrainingBlockTypeDto.File || b.BlockType == TrainingBlockTypeDto.Embed))
                        {
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden d-none d-lg-block">
                                <div class="card-header bg-white border-0 py-3 px-4">
                                    <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                                        <span class="oi oi-layers"></span>
                                        بخش‌های آموزش
                                    </h5>
                                </div>
                                <div class="card-body p-3">
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var block in article.Blocks.Where(b => b.BlockType == TrainingBlockTypeDto.Video || b.BlockType == TrainingBlockTypeDto.Audio || b.BlockType == TrainingBlockTypeDto.File || b.BlockType == TrainingBlockTypeDto.Embed))
                                        {
                                            <div class="block-sidebar-item d-flex align-items-center gap-2 p-2 rounded-3">
                                                <span class="block-sidebar-icon">
                                                    @switch (block.BlockType)
                                                    {
                                                        case TrainingBlockTypeDto.Video:
                                                            <span class="oi oi-video"></span>
                                                            break;
                                                        case TrainingBlockTypeDto.Audio:
                                                            <span class="oi oi-volume-high"></span>
                                                            break;
                                                        case TrainingBlockTypeDto.File:
                                                            <span class="oi oi-file"></span>
                                                            break;
                                                        case TrainingBlockTypeDto.Embed:
                                                            <span class="oi oi-code"></span>
                                                            break;
                                                    }
                                                </span>
                                                <span class="small">@(string.IsNullOrEmpty(block.Title) ? GetBlockTypeName(block.BlockType) : block.Title)</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (showImageLightbox && !string.IsNullOrEmpty(lightboxImageUrl))
{
    <div class="pd-lightbox" @onclick="CloseImageLightbox">
        <div class="pd-lightbox-content" @onclick:stopPropagation>
            <button class="pd-lightbox-close" @onclick="CloseImageLightbox" aria-label="بستن">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <div class="pd-lightbox-img-wrap">
                <img src="@lightboxImageUrl" alt="تصویر" class="pd-lightbox-img" />
            </div>
        </div>
    </div>
}

<ShareModal Visible="_showShareModal"
    OnClose="CloseShareModal"
    HeaderTitle="اشتراک‌گذاری آموزش"
    LinkLabel="آموزش"
    ImageUrl="@article?.CoverImageUrl"
    PreviewTitle="@(article?.Title ?? "")"
    PreviewDescription="@(article?.Summary ?? "")"
    ShareUrl="@Nav.Uri"
    GetShareText="@(() => GetShareText())"
    GetShareTelegramText="@(() => GetShareTextForTelegram())" />

@if (toastText != null)
{
    <div class="article-toast" role="status" aria-live="polite">@toastText</div>
}

<button class="article-scroll-top @scrollTopClass" @onclick="ScrollToTop" aria-label="بالا">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<script>
    window.__scrollToElement = function(id) {
        var el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    window.__initLightboxKeyboard = function(dotnetRef) {
        var handler = function(e) {
            if (e.key === 'Escape') dotnetRef.invokeMethodAsync('CloseImageLightbox');
        };
        document.addEventListener('keydown', handler);
        return handler;
    };
    window.__removeLightboxKeyboard = function(handler) {
        document.removeEventListener('keydown', handler);
    };
    window.__initCodeCopy = function() {
        document.querySelectorAll('.text-content pre').forEach(function(pre) {
            var btn = document.createElement('button');
            btn.className = 'code-copy-btn';
            btn.textContent = 'کپی';
            btn.addEventListener('click', function() {
                var code = pre.querySelector('code');
                var text = code ? code.textContent : pre.textContent;
                __copyToClipboard(text).then(function() {
                    btn.textContent = 'کپی شد!';
                    setTimeout(function() { btn.textContent = 'کپی'; }, 2000);
                });
            });
            pre.appendChild(btn);
        });
    };
    window.__articleScrollHandler = function(dotnetRef) {
        var ticking = false;
        var handler = function() {
            if (!ticking) {
                ticking = true;
                window.requestAnimationFrame(function() {
                    dotnetRef.invokeMethodAsync('OnPageScroll', window.scrollY > 400);
                    ticking = false;
                });
            }
        };
        window.addEventListener('scroll', handler, { passive: true });
        handler();
        return handler;
    };
    window.__articleRemoveScrollHandler = function(handler) {
        window.removeEventListener('scroll', handler);
    };
    window.__initArticlePlyr = function(selector) {
        if (typeof Plyr !== 'undefined') {
            var players = document.querySelectorAll(selector);
            players.forEach(function(el) { new Plyr(el); });
        }
    };
</script>

<style>
    .fw-black { font-weight: 900; }
    .italic { font-style: italic; }
    .article-hero-img { width: 100%; height: auto; max-height: 500px; object-fit: contain; background-color: #000; }
    .article-summary { border-right: 5px solid var(--bs-primary); background-color: #f8f9fa; }
    .article-summary p { text-align: justify; font-size: 1rem; line-height: 2; }
    .text-content { font-size: 1rem; line-height: 2; text-align: justify; }
    .text-content p { margin-bottom: 1rem; }
    @@media (min-width: 768px) {
        .article-summary p { font-size: 1.05rem; }
        .text-content { font-size: 1.05rem; line-height: 2.05; }
    }
    
    .download-box-wrapper { position: relative; }
    .download-box {
        position: relative; overflow: hidden;
        background: linear-gradient(135deg, #fff 0%, #f0f7ff 100%);
        border: 1.5px solid #dbeafe; border-radius: 1rem;
        box-shadow: 0 2px 12px rgba(37, 99, 235, 0.06);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .download-box:hover {
        border-color: #93c5fd;
        box-shadow: 0 8px 30px rgba(37, 99, 235, 0.12);
        transform: translateY(-2px);
    }
    .download-box__shine {
        position: absolute; top: 0; left: 0; right: 0; height: 3px;
        background: linear-gradient(90deg, #3b82f6, #06b6d4, #3b82f6);
        background-size: 200% 100%;
        animation: dl-shine 3s linear infinite;
    }
    @@keyframes dl-shine { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
    .download-box__content {
        padding: 1.25rem; display: flex; align-items: center; gap: 1rem;
    }
    .download-box__icon {
        width: 56px; height: 56px; flex-shrink: 0;
        background: linear-gradient(135deg, #dbeafe 0%, #bfdbfe 100%);
        border-radius: 0.875rem; display: grid; place-items: center;
        color: #2563eb; font-size: 1.5rem;
        box-shadow: 0 2px 8px rgba(37, 99, 235, 0.1);
    }
    .download-box__info { flex: 1; min-width: 0; }
    .download-box__title {
        font-size: 0.95rem; font-weight: 800; color: #0f172a;
        margin: 0 0 0.35rem; line-height: 1.4;
    }
    .download-box__meta { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .download-box__tag {
        display: inline-flex; align-items: center; gap: 0.3rem;
        font-size: 0.75rem; color: #64748b; background: #f1f5f9;
        padding: 0.2rem 0.6rem; border-radius: 1rem; font-weight: 500;
    }
    .download-box__tag .oi { font-size: 0.7rem; }
    .download-box__btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
        color: #fff; border: none; border-radius: 0.75rem;
        padding: 0.65rem 1.25rem; font-size: 0.85rem; font-weight: 700;
        text-decoration: none; white-space: nowrap; flex-shrink: 0;
        box-shadow: 0 2px 10px rgba(37, 99, 235, 0.25);
        transition: all 0.25s ease; cursor: pointer;
    }
    .download-box__btn:hover {
        background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
        box-shadow: 0 4px 16px rgba(37, 99, 235, 0.35);
        transform: translateY(-1px);
    }
    .download-box__btn:active { transform: translateY(0); }
    .download-box__btn-icon { font-size: 1.1rem; }
    
    .content-block video, .content-block iframe { max-width: 100%; aspect-ratio: 16/9; }
    .embed-wrapper iframe { width: 100% !important; aspect-ratio: 16/9; border-radius: 12px; }
    .plyr-wrapper { background: #000; }

    .text-content table { width: 100%; border-collapse: collapse; margin: 20px 0; }
    .text-content th, .text-content td { border: 1px solid #dee2e6; padding: 12px; text-align: right; }
    .text-content th { background-color: #f8f9fa; }
    .text-content pre { background: #1e293b; color: #e2e8f0; padding: 1.25rem; border-radius: 0.75rem; overflow-x: auto; direction: ltr; text-align: left; position: relative; }
    .text-content .code-copy-btn { position: absolute; top: 0.5rem; left: 0.5rem; background: rgba(255,255,255,0.15); border: none; color: #fff; border-radius: 0.4rem; padding: 0.25rem 0.6rem; font-size: 0.75rem; cursor: pointer; transition: background 0.2s; }
    .text-content .code-copy-btn:hover { background: rgba(255,255,255,0.3); }

    .image-block img { max-width: 100%; height: auto; border-radius: 1rem; }

    .embed-wrapper { position: relative; overflow: hidden; border-radius: 1rem; }
    .embed-wrapper iframe { border: 0; }

    .cs-wrapper { margin-top: 1.5rem; }



    .toc-nav { display: flex; flex-direction: column; gap: 0.125rem; counter-reset: toc-counter; }
    .toc-link { display: block; padding: 0.3rem 0.75rem; border-radius: 0.35rem; font-size: 0.82rem; color: #334155; text-decoration: none; transition: all 0.12s; border-right: 3px solid transparent; font-weight: 500; counter-increment: toc-counter; }
