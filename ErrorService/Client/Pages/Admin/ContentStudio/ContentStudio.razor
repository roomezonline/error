    private static async Task<string?> ReadErrorAsync(HttpResponseMessage resp)
    {
        string body;
        try
        {
            body = (await resp.Content.ReadAsStringAsync()).Trim();
        }
        catch
        {
            return null;
        }

        if (body.Length == 0) return null;

        try
        {
            var start = JsonSerializer.Deserialize<ContentStudioRunStartDto>(body, JsonOpts);
            if (!string.IsNullOrWhiteSpace(start?.Message)) return start.Message;
        }
        catch
        {
            // بدنه JSON دیگری است
        }

        try
        {
            var item = JsonSerializer.Deserialize<ContentStudioItemDto>(body, JsonOpts);
            if (!string.IsNullOrWhiteSpace(item?.StatusDetail)) return item.StatusDetail;
        }
        catch
        {
            // متن ساده است
        }

        return body.Trim('"');
    }

