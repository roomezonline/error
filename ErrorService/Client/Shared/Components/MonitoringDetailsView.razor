                            <circle cx="12" cy="12" r="3.5" stroke-width="2" />
                            <path d="M12 2v3M12 19v3M2 12h3M19 12h3M5.5 5.5l2 2M16.5 16.5l2 2M5.5 18.5l2-2M16.5 7.5l2-2" />
