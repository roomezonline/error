@page "/admin"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.dashboard.view")]
@using ErrorService.Shared
@using ErrorService.Shared.Models
@using System.Net.Http.Json
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@inject ErrorService.Client.Services.AdminWorkshopSelectionService AdminWorkshopSelection

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private bool CanSeeWorkshopAndReceiptsSection;
    private bool CanSeeShopSection;
    private bool CanSeeContentSection;
    private bool CanSeeTechnicalAndUsersSection;
    private bool CanSeeSecurityAndSettingsSection;
    private bool CanSeeMonitoringView;
    private bool CanSeeSmsSection;
    private bool IsSuperAdmin;

    private int pendingCommentsCount = 0;
    private int pendingProductReviewsCount = 0;
    private int pendingTestimonialsCount = 0;
    private int totalPendingComments => pendingCommentsCount + pendingProductReviewsCount + pendingTestimonialsCount;
    private int newOrdersCount = 0;
    private int pendingTicketsCount = 0;
    private int _pendingArchiveCount = 0;
    private decimal _smsBalance;
    private int? _smsWarningThreshold;
    private int _monitoringAlertCount;
    private ExpiringSummaryDto? _expiringSummary;

    private class CommentAdminDto
    {
        public int Id { get; set; }
        public bool IsApproved { get; set; }
    }

    private int pendingAdmissionsCount = 0;
    private int _activeChatSessions = 0;
    private int _unreadChatCount = 0;
    private int _pendingSmsChargeCount = 0;
    private int _pendingRenewalCount = 0;
    private bool _baleConfigured;
    private class ChatSessionListResponse { public List<ChatSessionDto> items { get; set; } = new(); public int total { get; set; } }
    private class BaleSettingsDto { public bool baleConfigured { get; set; } public string baleToken { get; set; } = ""; public string baleGroupId { get; set; } = ""; }
    private SystemHealthSummaryDto? healthSummary;
    private string currentVersion = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        IsSuperAdmin = user.IsInRole("super_admin");

        CanSeeWorkshopAndReceiptsSection =
            IsSuperAdmin ||
            user.HasClaim("perm", "admin.receipts.view") ||
            user.HasClaim("perm", "admin.receipts.manage") ||
            user.HasClaim("perm", "admin.workshops.manage") ||
            user.HasClaim("perm", "workshop.users.manage") ||
            user.HasClaim("perm", "admin.monitoring.view") ||
            user.HasClaim("perm", "admin.monitoring.devices.manage") ||
            user.HasClaim("perm", "admin.monitoring.assignments.manage") ||
            user.HasClaim("perm", "admin.monitoring.connections.manage");

        CanSeeShopSection =
            user.HasClaim("perm", "admin.products.manage") ||
            user.HasClaim("perm", "admin.categories.view") ||
            user.HasClaim("perm", "admin.orders.view") ||
            user.HasClaim("perm", "admin.bankaccounts.manage");

        CanSeeContentSection =
            user.HasClaim("perm", "admin.academy.view") ||
            user.HasClaim("perm", "admin.news.view") ||
            user.HasClaim("perm", "admin.stories.view") ||
            user.HasClaim("perm", "admin.sliders.view") ||
            user.HasClaim("perm", "admin.popularbrands.manage") ||
            user.HasClaim("perm", "admin.team.view") ||
            user.HasClaim("perm", "admin.trust.view");

        CanSeeTechnicalAndUsersSection =
            user.HasClaim("perm", "admin.users.manage") ||
            user.HasClaim("perm", "admin.technical.devices.view") ||
            user.HasClaim("perm", "admin.technical.brands.view") ||
            user.HasClaim("perm", "admin.technical.errorcodes.view") ||
            user.HasClaim("perm", "admin.technical.sensorfinder.view") ||
            user.HasClaim("perm", "admin.consultation.view");

        CanSeeSecurityAndSettingsSection =
            user.HasClaim("perm", "security.roles.manage") ||
            user.HasClaim("perm", "admin.settings.manage");

        CanSeeMonitoringView =
            IsSuperAdmin ||
            user.HasClaim("perm", "admin.monitoring.view");

        CanSeeSmsSection =
            IsSuperAdmin ||
            user.HasClaim("perm", "admin.sms.view") ||
            user.HasClaim("perm", "admin.sms.manage") ||
            user.HasClaim("perm", "admin.sms.charges.manage") ||
            user.HasClaim("perm", "admin.sms.credits.view") ||
            user.HasClaim("perm", "admin.sms.credits.manage") ||
            user.HasClaim("perm", "admin.sms.charges.view") ||
            user.HasClaim("perm", "admin.sms.charges.approve") ||
            user.HasClaim("perm", "admin.sms.logs.view") ||
            user.HasClaim("perm", "workshop.sms.manage") ||
            user.HasClaim("perm", "workshop.sms.settings.manage") ||
            user.HasClaim("perm", "workshop.sms.credit.view") ||
            user.HasClaim("perm", "workshop.sms.charge.request") ||
            user.HasClaim("perm", "workshop.sms.charge.history") ||
            user.HasClaim("perm", "workshop.sms.logs.view");



        try
        {
            // Load current version from releases.json
            var cacheBuster = $"?v={DateTimeOffset.UtcNow.Ticks}";
            var releases = await Http.GetFromJsonAsync<List<ReleaseNote>>($"releases.json{cacheBuster}");
            if (releases != null && releases.Any())
            {
                currentVersion = releases.First().Version;
            }
        }
        catch { }

        try
        {
            var tasks = new List<Task>();

            Task<SystemHealthSummaryDto?>? healthTask = null;
            if (IsSuperAdmin)
            {
                healthTask = Http.GetFromJsonAsync<SystemHealthSummaryDto>("api/systemevents/summary");
                tasks.Add(healthTask);
            }

            Task<List<CommentAdminDto>?>? commentsTask = null;
            if (user.HasClaim("perm", "admin.news.view"))
            {
                commentsTask = Http.GetFromJsonAsync<List<CommentAdminDto>>("api/trainingarticles/all-comments");
                tasks.Add(commentsTask);
            }

            Task<List<OrderDto>?>? ordersTask = null;
            if (user.HasClaim("perm", "admin.orders.view"))
            {
                ordersTask = Http.GetFromJsonAsync<List<OrderDto>>("api/orders/admin/all");
                tasks.Add(ordersTask);
            }

            Task<List<ConsultationTicket>?>? ticketsTask = null;
            if (user.HasClaim("perm", "admin.consultation.view"))
            {
                ticketsTask = Http.GetFromJsonAsync<List<ConsultationTicket>>("api/technical/tickets/admin");
                tasks.Add(ticketsTask);
            }

            Task<List<TestimonialAdminDto>?>? testimonialsTask = null;
            if (user.HasClaim("perm", "admin.trust.view"))
            {
                testimonialsTask = Http.GetFromJsonAsync<List<TestimonialAdminDto>>("api/trust/admin/testimonials");
                tasks.Add(testimonialsTask);
            }

            Task<List<ProductReviewDto>?>? productReviewsTask = null;
            if (user.HasClaim("perm", "admin.settings.manage"))
            {
                productReviewsTask = Http.GetFromJsonAsync<List<ProductReviewDto>>("api/products/0/reviews/all");
                tasks.Add(productReviewsTask);
            }

            Task<ChatSessionListResponse?>? chatTask = null;
            Task<BaleSettingsDto?>? baleSettingsTask = null;
            if (user.HasClaim("perm", "admin.chat.manage"))
            {
                chatTask = Http.GetFromJsonAsync<ChatSessionListResponse>("api/chat/sessions?take=10000");
                tasks.Add(chatTask);
                baleSettingsTask = Http.GetFromJsonAsync<BaleSettingsDto>("api/chat/settings");
                tasks.Add(baleSettingsTask);
            }

            Task<List<OnlineAdmissionDto>?>? admissionsTask = null;
            if (IsSuperAdmin || user.HasClaim("perm", "admin.onlineadmission.manage"))
            {
                admissionsTask = Http.GetFromJsonAsync<List<OnlineAdmissionDto>>("api/online-admission/admin/list?status=pending");
                tasks.Add(admissionsTask);
            }

            Task<PendingArchiveCountDto?>? archiveCountTask = null;
            if (IsSuperAdmin || user.HasClaim("perm", "admin.monitoring.view"))
            {
                archiveCountTask = Http.GetFromJsonAsync<PendingArchiveCountDto>("api/monitoring/archives/count-pending");
                tasks.Add(archiveCountTask);
            }

            Task<SmsDashboardDto?>? smsDashboardTask = null;
            Task<WorkshopSmsDashboardDto?>? wsSmsDashboardTask = null;
            if (CanSeeSmsSection)
            {
                if (IsSuperAdmin)
                {
                    smsDashboardTask = Http.GetFromJsonAsync<SmsDashboardDto>("api/sms-admin/dashboard");
                    tasks.Add(smsDashboardTask);
                }
                else
                {
                    wsSmsDashboardTask = Http.GetFromJsonAsync<WorkshopSmsDashboardDto>("api/workshop-sms/dashboard");
                    tasks.Add(wsSmsDashboardTask);
                }
            }

            Task<System.Text.Json.JsonElement>? monitoringAlertTask = null;
            Task<ExpiringSummaryDto?>? expiringSummaryTask = null;
            if (CanSeeMonitoringView)
            {
                await AdminWorkshopSelection.InitializeAsync();
                var wsId = IsSuperAdmin ? AdminWorkshopSelection.SelectedWorkshopId : null;
                var qs = wsId.HasValue ? $"?workshopId={wsId}" : "";
                monitoringAlertTask = Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/monitoring/alert/workshop-count{qs}");
                tasks.Add(monitoringAlertTask);
                expiringSummaryTask = Http.GetFromJsonAsync<ExpiringSummaryDto>($"api/monitoring-devices/expiring-summary{qs}");
                tasks.Add(expiringSummaryTask);
            }

            Task<List<RenewalRequestDto>?>? renewalTask = null;
            if (IsSuperAdmin)
            {
                renewalTask = Http.GetFromJsonAsync<List<RenewalRequestDto>>("api/monitoring/renewal-requests?status=Pending");
                tasks.Add(renewalTask);
            }

            if (tasks.Any())
            {
                await Task.WhenAll(tasks);

                if (commentsTask != null)
                {
                    var comments = await commentsTask;
                    pendingCommentsCount = comments?.Count(x => !x.IsApproved) ?? 0;
                }

                if (ordersTask != null)
                {
                    var orders = await ordersTask;
                    newOrdersCount = orders?.Count(x => x.Status == OrderStatus.PendingPayment || x.Status == OrderStatus.ReceiptUploaded) ?? 0;
                }

                if (ticketsTask != null)
                {
                    var tickets = await ticketsTask;
                    pendingTicketsCount = tickets?.Count(x => !x.IsAdminRead) ?? 0;
                }

                if (testimonialsTask != null)
                {
                    var testimonials = await testimonialsTask;
                    pendingTestimonialsCount = testimonials?.Count(x => !x.IsApproved) ?? 0;
                }

                if (productReviewsTask != null)
                {
                    var reviews = await productReviewsTask;
                    pendingProductReviewsCount = reviews?.Count(x => !x.IsApproved) ?? 0;
                }

                if (admissionsTask != null)
                {
                    var admissions = await admissionsTask;
                    pendingAdmissionsCount = admissions?.Count ?? 0;
                }

                if (healthTask != null)
                {
                    healthSummary = await healthTask;
                }

                if (archiveCountTask != null)
                {
                    var ac = await archiveCountTask;
                    _pendingArchiveCount = ac?.Count ?? 0;
                }

                if (smsDashboardTask != null)
                {
                    var d = await smsDashboardTask;
                    _smsBalance = d?.TotalBalance ?? 0;
                    _pendingSmsChargeCount = d?.PendingChargeCount ?? 0;
                }
                if (wsSmsDashboardTask != null)
                {
                    var d = await wsSmsDashboardTask;
                    _smsBalance = d?.Balance ?? 0;
                    _smsWarningThreshold = d?.WarningThreshold;
                    _pendingSmsChargeCount = d?.PendingChargeCount ?? 0;
                }

                if (monitoringAlertTask != null)
                {
                    var r = await monitoringAlertTask;
                    _monitoringAlertCount = r.GetProperty("count").GetInt32();
                }

                if (expiringSummaryTask != null)
                    _expiringSummary = await expiringSummaryTask;

                if (renewalTask != null)
                {
                    var list = await renewalTask;
                    _pendingRenewalCount = list?.Count ?? 0;
                }

                if (CanSeeMonitoringView && IsSuperAdmin)
                {
                    AdminWorkshopSelection.OnChanged += async (wsId) =>
                    {
                        var qs = wsId.HasValue ? $"?workshopId={wsId}" : "";
                        try
                        {
                            var r = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/monitoring/alert/workshop-count{qs}");
                            _monitoringAlertCount = r.GetProperty("count").GetInt32();
                            StateHasChanged();
                        }
                        catch { _monitoringAlertCount = 0; StateHasChanged(); }
                    };
                }

                if (chatTask != null)
                {
                    var response = await chatTask;
                    _activeChatSessions = response?.items?.Count(s => s.Status == ChatSessionStatusDto.Active) ?? 0;
                    _unreadChatCount = response?.items?.Count(s => s.HasUnread) ?? 0;
                }

                if (baleSettingsTask != null)
                {
                    var settings = await baleSettingsTask;
                    if (settings != null)
                    {
                        _baleConfigured = settings.baleConfigured;
                    }
                }
            }
        }
        catch { }
    }

    private class OnlineAdmissionDto { public int Id { get; set; } }


    private class TestimonialAdminDto
    {
        public int Id { get; set; }
        public bool IsApproved { get; set; }
    }
}

<div class="dash-wrapper" dir="rtl">

    @{
        var totalPending = _pendingRenewalCount + _pendingSmsChargeCount + _unreadChatCount;
    }
    @if (IsSuperAdmin && totalPending > 0)
    {
        <div class="admin-alerts">
            <div class="admin-alerts__inner">
                <div class="admin-alerts__header">
                    <span class="admin-alerts__icon"><span class="oi oi-bell"></span></span>
                    <span class="admin-alerts__title">اعلان‌های مدیریتی</span>
                    <span class="admin-alerts__count">@totalPending</span>
                </div>
                <div class="admin-alerts__list">
                    @if (_pendingRenewalCount > 0)
                    {
                        <a href="/admin/monitoring/renewal-requests" class="admin-alerts__item admin-alerts__item--renewal">
                            <span class="admin-alerts__dot"></span>
                            <span class="admin-alerts__text">@_pendingRenewalCount درخواست تمدید مانیتورینگ</span>
                            <span class="admin-alerts__arrow"><span class="oi oi-chevron-left"></span></span>
                        </a>
                    }
                    @if (_pendingSmsChargeCount > 0)
                    {
                        <a href="/admin/sms?tab=charges" class="admin-alerts__item admin-alerts__item--sms">
                            <span class="admin-alerts__dot"></span>
                            <span class="admin-alerts__text">@_pendingSmsChargeCount درخواست شارژ پیامک</span>
                            <span class="admin-alerts__arrow"><span class="oi oi-chevron-left"></span></span>
                        </a>
                    }
                    @if (_unreadChatCount > 0)
                    {
                        <a href="/admin/chat" class="admin-alerts__item admin-alerts__item--chat">
                            <span class="admin-alerts__dot"></span>
                            <span class="admin-alerts__text">@_unreadChatCount پیام چت خوانده نشده</span>
                            <span class="admin-alerts__arrow"><span class="oi oi-chevron-left"></span></span>
                        </a>
                    }
                </div>
            </div>
        </div>
    }

    @if (CanSeeSmsSection && !IsSuperAdmin && _smsWarningThreshold.HasValue && _smsWarningThreshold > 0 && _smsBalance < _smsWarningThreshold)
    {
        <div class="sms-credit-warn">
            <div class="sms-credit-warn__inner">
                <div class="sms-credit-warn__icon">
                    <span class="oi oi-warning"></span>
                </div>
                <div class="sms-credit-warn__body">
                    <div class="sms-credit-warn__title">اعتبار پیامک شما رو به اتمام است</div>
                    <div class="sms-credit-warn__desc">موجودی: @($"{_smsBalance:N0}") تومان — کمتر از آستانه هشدار (@(_smsWarningThreshold?.ToString("N0") ?? "—") تومان)</div>
                </div>
                <a href="/admin/sms" class="sms-credit-warn__btn">
                    <span class="oi oi-credit-card"></span>
                    شارژ اعتبار
                </a>
            </div>
        </div>
    }

    @if (CanSeeMonitoringView && _monitoringAlertCount > 0)
    {
        <div class="monitoring-alert-warn">
            <div class="monitoring-alert-warn__inner">
                <div class="monitoring-alert-warn__icon">
                    <span class="oi oi-warning"></span>
                </div>
                <div class="monitoring-alert-warn__body">
                    <div class="monitoring-alert-warn__title">@_monitoringAlertCount اخطار فعال در مانیتورینگ</div>
                    <div class="monitoring-alert-warn__desc">@_monitoringAlertCount رسید دارای قطعی یا اخطار — برای مدیریت کلیک کنید</div>
                </div>
                <a href="/admin/monitoring/active-receipts" class="monitoring-alert-warn__btn">
                    <span class="oi oi-pulse"></span>
                    مشاهده
                </a>
            </div>
        </div>
    }

    @if (CanSeeMonitoringView && _expiringSummary != null && (_expiringSummary.ExpiringSoonCount > 0 || _expiringSummary.ExpiredCount > 0))
    {
        <div class="dev-expire-warn">
            <div class="dev-expire-warn__inner">
                <div class="dev-expire-warn__icon">
                    <span class="oi oi-clock"></span>
                </div>
                <div class="dev-expire-warn__body">
                    <div class="dev-expire-warn__title">
                        @if (_expiringSummary.ExpiredCount > 0 && _expiringSummary.ExpiringSoonCount > 0)
                        {
                            <span>@_expiringSummary.ExpiredCount دستگاه منقضی و @_expiringSummary.ExpiringSoonCount دستگاه در حال انقضا</span>
                        }
                        else if (_expiringSummary.ExpiredCount > 0)
                        {
                            <span>@_expiringSummary.ExpiredCount دستگاه مانیتورینگ منقضی شده</span>
                        }
                        else
                        {
                            <span>@_expiringSummary.ExpiringSoonCount دستگاه در حال انقضا</span>
                        }
                    </div>
                    <div class="dev-expire-warn__desc">
                        @if (_expiringSummary.ExpiredCount > 0)
                        {
                            var first = _expiringSummary.ExpiredDevices.FirstOrDefault();
                            <span>منقضی: @string.Join("، ", _expiringSummary.ExpiredDevices.Take(2).Select(d => $"{d.DeviceTitle}" ))@(_expiringSummary.ExpiredDevices.Count > 2 ? $" +{_expiringSummary.ExpiredDevices.Count - 2}" : "")</span>
                        }
                        @if (_expiringSummary.ExpiringSoonCount > 0)
                        {
                            var items = _expiringSummary.ExpiringSoonDevices.OrderBy(d => d.RemainingDays).Take(2).ToList();
                            <span>در شرف انقضا: @string.Join("، ", items.Select(d => $"{d.DeviceTitle} ({d.RemainingDays} روز)"))@(_expiringSummary.ExpiringSoonDevices.Count > 2 ? $" +{_expiringSummary.ExpiringSoonDevices.Count - 2}" : "")</span>
                        }
                    </div>
                </div>
                <a href="/admin/monitoring/my-devices" class="dev-expire-warn__btn">
                    <span class="oi oi-hard-drive"></span>
                    مشاهده دستگاه‌ها
                </a>
            </div>
        </div>
    }

    <!-- Quick Stats -->
    <div class="stats-grid mb-4">

      <AuthorizeView Policy="perm:admin.onlineadmission.manage">
            <div class="stat-card stats-admission shadow-sm p-3 animate__animated animate__fadeIn animate__delay-4s">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-bg bg-danger-subtle text-danger">
                        <span class="oi oi-wrench"></span>
                    </div>
                    <div>
                        <div class="stat-value fw-black">@pendingAdmissionsCount</div>
                        <div class="stat-label">پذیرش‌های معلق</div>
                    </div>
                </div>
                <a href="/admin/online-admission" class="btn btn-danger btn-sm rounded-pill w-100 mt-3 fw-bold border-0 shadow-none">مدیریت پذیرش‌ها</a>
            </div>
        </AuthorizeView>

        @if (CanSeeMonitoringView)
        {
            <div class="stat-card stats-archives shadow-sm p-3 animate__animated animate__fadeIn animate__delay-4s">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-bg bg-info-subtle text-info">
                        <span class="oi oi-pulse"></span>
                    </div>
                    <div>
                        <div class="stat-value fw-black">@_pendingArchiveCount</div>
                        <div class="stat-label">در انتظار دانلود</div>
                    </div>
                </div>
                <a href="/admin/monitoring/archives" class="btn btn-info btn-sm rounded-pill w-100 mt-3 fw-bold border-0 shadow-none text-white">مشاهده و دانلود</a>
            </div>

            <div class="stat-card shadow-sm p-3 animate__animated animate__fadeIn animate__delay-4s">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-bg" style="background:rgba(245,158,11,0.1);color:#d97706;">
                        <span class="oi oi-clock"></span>
                    </div>
                    <div>
                        <div class="stat-value fw-black">
                            @if (_expiringSummary != null)
                            {
                                <span>@(_expiringSummary.ExpiringSoonCount + _expiringSummary.ExpiredCount)</span>
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </div>
                        <div class="stat-label">در انتظار تمدید</div>
                        @if (_expiringSummary != null && (_expiringSummary.ExpiringSoonCount > 0 || _expiringSummary.ExpiredCount > 0))
                        {
                            <div class="x-small text-muted mt-1">
                                @(_expiringSummary.ExpiredCount > 0 ? $"منقضی: {_expiringSummary.ExpiredCount}" : "")
                                @(_expiringSummary.ExpiredCount > 0 && _expiringSummary.ExpiringSoonCount > 0 ? " • " : "")
                                @(_expiringSummary.ExpiringSoonCount > 0 ? $"در حال انقضا: {_expiringSummary.ExpiringSoonCount}" : "")
                            </div>
                        }
                    </div>
                </div>
                <a href="/admin/monitoring/my-devices" class="btn btn-sm rounded-pill w-100 mt-3 fw-bold border-0 shadow-none" style="background:#d97706;color:#fff;">مشاهده دستگاه‌ها</a>
            </div>
        }

            <AuthorizeView Policy="perm:admin.orders.view">
            <div class="stat-card stats-orders shadow-sm p-3 animate__animated animate__fadeIn animate__delay-1s">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-bg bg-primary-subtle text-primary">
                        <span class="oi oi-cart"></span>
                    </div>
                    <div>
                        <div class="stat-value fw-black">@newOrdersCount</div>
                        <div class="stat-label">سفارشات جدید</div>
                    </div>
                </div>
                <a href="/admin/orders" class="btn btn-primary btn-sm rounded-pill w-100 mt-3 fw-bold border-0 shadow-none">مدیریت سفارشات</a>
            </div>
        </AuthorizeView>

        <AuthorizeView Policy="perm:admin.news.view">
            <div class="stat-card stats-comments shadow-sm p-3 animate__animated animate__fadeIn">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-bg bg-warning-subtle text-warning">
                        <span class="oi oi-chat"></span>
                    </div>
                    <div>
                        <div class="stat-value fw-black">@totalPendingComments</div>
                        <div class="stat-label">نظرات در انتظار تایید</div>
                        <div class="x-small text-muted mt-1">
                            @(pendingCommentsCount > 0 ? $"مقالات: {pendingCommentsCount}" : "")@(pendingCommentsCount > 0 && pendingProductReviewsCount > 0 ? " • " : "")@(pendingProductReviewsCount > 0 ? $"محصولات: {pendingProductReviewsCount}" : "")@((pendingCommentsCount > 0 || pendingProductReviewsCount > 0) && pendingTestimonialsCount > 0 ? " • " : "")@(pendingTestimonialsCount > 0 ? $"مشتریان: {pendingTestimonialsCount}" : "")
                        </div>
                    </div>
                </div>
                <a href="/admin/comments" class="btn btn-warning btn-sm rounded-pill w-100 mt-3 fw-bold border-0 shadow-none">
                    مدیریت نظرات
                </a>
            </div>
        </AuthorizeView>

        @if (CanSeeSmsSection)
        {
            <div class="stat-card shadow-sm p-3 animate__animated animate__fadeIn animate__delay-2s">
                <div class="d-flex align-items-center gap-3">
                    <div class="stat-icon-bg" style="background:rgba(79,70,229,0.1);color:#4f46e5;">
                        <span class="oi oi-envelope-closed"></span>
                    </div>
                    <div>
                        <div class="stat-value fw-black">@($"{_smsBalance:N0}")</div>
                        <div class="stat-label">اعتبار پیامک (تومان)</div>
                    </div>
                </div>
