@code {
    [Parameter] public int? ProductId { get; set; }

    private List<ProductQuestionProductSummaryDto> _products = new();
    private List<ProductQuestionAdminDto> _items = new();

    private bool _loadingIndex = true;
    private bool _loadingDetail;
    private bool _busy;

    private string _filter = "all";
    private string _search = "";
    private int? _editId;
    private string _answerText = "";

    private bool _showConfirm;
    private int? _deleteId;
    private int? _deleteReplyId;

    private int _detailPage = 1;
    private bool _hasMore;
    private int? _detailTotal;
    private string? _detailTitle;
    private string? _detailImage;

    private CancellationTokenSource? _searchCts;

    private bool IsDetail => ProductId.HasValue;
    private bool IsIndex => !ProductId.HasValue;

    private string ProductSiteUrl => $"/products/{ProductId ?? 0}";

    private List<ProductQuestionAdminDto> All => _items;

    private string? DetailTitle => _detailTitle;

    // ---------- index ----------
    private int IndexTotal => _products.Sum(p => p.TotalCount);
    private int IndexUnanswered => _products.Sum(p => p.UnansweredCount);
    private int IndexPending => _products.Sum(p => p.PendingCount);
    private int IndexUnread => _products.Sum(p => p.UnreadCount);

    private IEnumerable<ProductQuestionProductSummaryDto> ProductList
    {
        get
        {
            var q = _products.AsEnumerable();
            q = _filter switch
            {
                "unread" => q.Where(p => p.UnreadCount > 0),
                "unanswered" => q.Where(p => p.UnansweredCount > 0),
                "pending" => q.Where(p => p.PendingCount > 0),
                _ => q
            };
            return q.OrderByDescending(p => p.UnreadCount)
                    .ThenByDescending(p => p.UnansweredCount)
                    .ThenByDescending(p => p.TotalCount);
        }
    }

    // ---------- detail ----------
    private IEnumerable<ProductQuestionAdminDto> Filtered
    {
        get
        {
            var q = All.AsEnumerable();
            q = _filter switch
            {
                "pending" => q.Where(i => !i.IsAnswered),
                "answered" => q.Where(i => i.IsAnswered),
                "hidden" => q.Where(i => !i.IsApproved),
                "unread" => q.Where(i => !i.IsAdminRead),
                _ => q
            };

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var s = _search.Trim();
                q = q.Where(i => i.Question.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || i.FullName.Contains(s, StringComparison.OrdinalIgnoreCase)
                              || (i.Answer != null && i.Answer.Contains(s, StringComparison.OrdinalIgnoreCase))
                              || (i.Replies != null && i.Replies.Any(r => r.Body.Contains(s, StringComparison.OrdinalIgnoreCase))));
            }

            return q.OrderByDescending(i => i.IsAdminRead).ThenByDescending(i => i.Id);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _filter = "all";
        _search = "";
        _editId = null;
        _answerText = "";

        if (IsDetail) await LoadDetailAsync(first: true);
        else await LoadIndexAsync();
    }

    private async Task LoadIndexAsync(bool showSpinner = true)
    {
        if (showSpinner) _loadingIndex = true;
        try
        {
            var url = string.IsNullOrWhiteSpace(_search)
                ? "api/questions/admin/summary"
                : $"api/questions/admin/summary?search={Uri.EscapeDataString(_search.Trim())}";
            _products = await Http.GetFromJsonAsync<List<ProductQuestionProductSummaryDto>>(url) ?? new();
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا در دریافت پرسش‌ها: {ex.Message}");
        }
        _loadingIndex = false;
    }

    private async Task OnIndexSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        try { await Task.Delay(350, token); }
        catch (TaskCanceledException) { return; }

        await LoadIndexAsync(showSpinner: false);
        StateHasChanged();
    }

    private async Task OnDetailSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? "";
        _editId = null;
        StateHasChanged();
    }

    private async Task LoadDetailAsync(bool first)
    {
        if (first)
        {
            _loadingDetail = true;
            _items = new();
            _detailPage = 1;
            _hasMore = false;
            _detailTotal = null;
        }

        try
        {
            var url = $"api/questions/admin/all?productId={ProductId}&page={_detailPage}&pageSize=100";
            var resp = await Http.GetAsync(url);

            if (resp.IsSuccessStatusCode)
            {
                if (resp.Headers.TryGetValues("X-Total-Count", out var vals)
                    && int.TryParse(vals.FirstOrDefault(), out var total))
                {
                    _detailTotal = total;
                }

                var batch = await resp.Content.ReadFromJsonAsync<List<ProductQuestionAdminDto>>() ?? new();

                if (first) _items = batch;
                else _items.AddRange(batch);

                _hasMore = batch.Count >= 100;

                if (first && batch.Count > 0)
                {
                    _detailTitle = batch[0].ProductTitle;
                    _detailImage = batch[0].ProductImageUrl;
                }
            }
            else
            {
                ToastService.ShowError("دریافت پرسش‌های این محصول ممکن نشد");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا در دریافت پرسش‌ها: {ex.Message}");
        }

        _loadingDetail = false;
    }

    private async Task LoadMore()
    {
        _detailPage++;
        await LoadDetailAsync(first: false);
    }

    private async Task Refresh()
    {
        if (IsDetail) await LoadDetailAsync(first: true);
        else await LoadIndexAsync();
    }

    private void SetFilter(string f)
    {
        _filter = f;
        _editId = null;
    }

    private static string GetInitials(string? title)
    {
        var t = (title ?? "").Trim();
        if (t.Length == 0) return "WS";
        return t.Length <= 2 ? t : t[..2];
    }

    // ---------- answer ----------
    private void StartEdit(ProductQuestionAdminDto q)
    {
        _editId = q.Id;
        _answerText = q.Answer ?? "";
    }

    private void CancelEdit()
    {
        _editId = null;
        _answerText = "";
    }

    private async Task SaveAnswer(int id)
    {
        var text = (_answerText ?? "").Trim();
        if (text.Length > 0 && text.Length < 5)
        {
            ToastService.ShowError("پاسخ باید حداقل ۵ کاراکتر باشد");
            return;
        }

        _busy = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/questions/{id}", new ProductQuestionAnswerRequest { Answer = text });
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(text.Length == 0 ? "پاسخ حذف شد" : "پاسخ ثبت شد");
                var item = _items.FirstOrDefault(i => i.Id == id);
                if (item != null)
                {
                    item.Answer = text.Length == 0 ? null : text;
                    item.IsAnswered = text.Length > 0;
                    item.IsApproved = true;
                    item.IsAdminRead = true;
                }
                CancelEdit();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "ثبت پاسخ ممکن نشد" : body.Trim('"'));
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ToggleApprove(ProductQuestionAdminDto q)
    {
        _busy = true;
        try
        {
            var resp = await Http.PostAsync($"api/questions/{q.Id}/approve", null);
            if (resp.IsSuccessStatusCode)
            {
                q.IsApproved = !q.IsApproved;
                q.IsAdminRead = true;
                StateHasChanged();
            }
            else
            {
                ToastService.ShowError("تغییر وضعیت تایید انجام نشد");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task MarkAllRead()
    {
        _busy = true;
        try
        {
            var resp = await Http.PostAsync("api/questions/admin/read-all", null);
            if (resp.IsSuccessStatusCode)
            {
                foreach (var q in _products) q.UnreadCount = 0;
                foreach (var q in _items) q.IsAdminRead = true;
                ToastService.ShowSuccess("همه پرسش‌ها خوانده شدند");
            }
        }
        catch { }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    // ---------- delete / replies ----------
    private void AskDelete(int id)
    {
        _deleteId = id;
        _deleteReplyId = null;
        _showConfirm = true;
    }

    private void AskDeleteReply(int id)
    {
        _deleteReplyId = id;
        _deleteId = null;
        _showConfirm = true;
    }

    private async Task ToggleReply(ProductQuestionReplyDto r)
    {
        _busy = true;
        try
        {
            var resp = await Http.PostAsync($"api/questions/reply/{r.Id}/approve", null);
            if (resp.IsSuccessStatusCode)
            {
                r.IsApproved = !r.IsApproved;
                ToastService.ShowSuccess(r.IsApproved ? "پاسخ تایید و نمایش داده شد" : "پاسخ از حالت نمایش خارج شد");
            }
            else
            {
                ToastService.ShowError("تغییر وضعیت پاسخ انجام نشد");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private async Task HandleDeleteResult(bool confirmed)
    {
        _showConfirm = false;

        if (confirmed && _deleteReplyId is not null)
        {
            var rid = _deleteReplyId.Value;
            _busy = true;
            try
            {
                var resp = await Http.DeleteAsync($"api/questions/reply/{rid}");
                if (resp.IsSuccessStatusCode)
                {
                    foreach (var q in _items)
                        q.Replies?.RemoveAll(r => r.Id == rid);
                    ToastService.ShowSuccess("پاسخ حذف شد");
                }
                else
                {
                    ToastService.ShowError("حذف پاسخ انجام نشد");
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"خطای سیستمی: {ex.Message}");
            }
            finally
            {
                _busy = false;
                _deleteReplyId = null;
                StateHasChanged();
            }
            return;
        }

        if (!confirmed || _deleteId is null) { _deleteId = null; return; }

        var id = _deleteId.Value;
        _busy = true;
        try
        {
            var resp = await Http.DeleteAsync($"api/questions/{id}");
            if (resp.IsSuccessStatusCode)
            {
                _items.RemoveAll(i => i.Id == id);
                ToastService.ShowSuccess("پرسش حذف شد");
            }
            else
            {
                ToastService.ShowError("حذف پرسش انجام نشد");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally
        {
            _busy = false;
            _deleteId = null;
            StateHasChanged();
        }
    }
}
