<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Client\ErrorService.Client.csproj" />
    <ProjectReference Include="..\Shared\ErrorService.Shared.csproj" />
  </ItemGroup>

  <Target Name="CopyServiceWorkerToPublishRoot" AfterTargets="Publish">
    <ItemGroup>
      <ServiceWorkerFile Include="$(MSBuildProjectDirectory)\..\Client\wwwroot\service-worker.js" />
    </ItemGroup>
    <Copy SourceFiles="@(ServiceWorkerFile)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="false" />
  </Target>

  <!--
    هر بار publish، نام فایل‌های _framework (wasm/js/dat) به‌خاطر هش محتوا عوض می‌شود.
    اگر در پوشه‌ای قبلاً منتشرشده publish کنیم، فایل‌های هش قدیمی باقی می‌مانند
    (مثلاً ۷.۹ مگابایت wasm یتیم) و بی‌دلیل بارگذاری/آپلود می‌شوند.
    پس قبل از کپی، خروجی _framework موجود در مقصد را خالی می‌کنیم.
  -->
  <Target Name="CleanStaleFrameworkAssetsBeforePublish" BeforeTargets="PrepareForPublish">
    <RemoveDir Directories="$(PublishDir)wwwroot\_framework" Condition="Exists('$(PublishDir)wwwroot\_framework')" />
  </Target>

</Project>
