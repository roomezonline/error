@using ErrorService.Shared
@using ErrorService.Client.Services
@implements IDisposable
@inject QuickViewService QuickView
@inject HttpClient Http
@inject CartService CartService
@inject WishlistService Ws
@inject ToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Nav
@if (QuickView.IsOpen)
{
    <div class="qv-overlay" @onclick="Close" role="presentation">
        <div class="qv-dialog" role="dialog" aria-modal="true" aria-label="نمایش سریع محصول" @onclick:stopPropagation>
            <button type="button" class="qv-close" @onclick="Close" aria-label="بستن">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>

            @if (_loading)
            {
                <div class="qv-loading">
                    <div class="qv-skeleton qv-skeleton--img"></div>
                    <div class="qv-loading__lines">
                        <div class="qv-skeleton qv-skeleton--line"></div>
                        <div class="qv-skeleton qv-skeleton--line short"></div>
                        <div class="qv-skeleton qv-skeleton--line"></div>
                    </div>
                </div>
            }
            else if (_product == null)
            {
                <div class="qv-empty">
                    <span class="oi oi-warning" aria-hidden="true"></span>
                    <p>اطلاعات این محصول در دسترس نیست.</p>
                    <button type="button" class="qv-btn qv-btn--ghost" @onclick="Close">بستن</button>
                </div>
            }
            else
            {
                <div class="qv-grid">
                    <div class="qv-media">
                        @if (DiscountHelper.IsTimedActive(_product))
                        {
                            <span class="qv-badge qv-badge--sale">@(DiscountHelper.CalculatePercent(_product))٪ تخفیف</span>
                        }
                        else if (DiscountHelper.IsPermanentActive(_product))
                        {
                            <span class="qv-badge qv-badge--perm">تخفیف ویژه</span>
                        }

                        <img src="@(string.IsNullOrEmpty(_activeImage) ? "/images/placeholder-product.svg" : ImageUrlHelper.Thumb(_activeImage, 800))"
                             srcset="@ImageUrlHelper.SrcSet(_activeImage, new[] { 400, 800 })"
                             sizes="(max-width: 768px) 90vw, 420px"
                             loading="eager" fetchpriority="high" decoding="async"
                             class="qv-img" alt="@_product.Name" />

                        @if (_product.ImageUrl2 is not null || _product.ImageUrl3 is not null || _product.ImageUrl4 is not null)
                        {
                            <div class="qv-thumbs">
                                @foreach (var img in ExtraImages())
                                {
                                    <button type="button" class="qv-thumb @(_activeImage == img ? "is-active" : "")"
                                            @onclick="() => _activeImage = img" aria-label="تغییر تصویر">
                                        <img src="@ImageUrlHelper.Thumb(img, 200)" loading="lazy" decoding="async" alt="" />
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <div class="qv-info">
                        @if (!string.IsNullOrWhiteSpace(_product.CategoryName))
                        {
                            <span class="qv-cat">@_product.CategoryName</span>
                        }
                        <h3 class="qv-title">@_product.Name</h3>

                        <div class="qv-meta">
                            @if (_product.IsAvailable && _product.StockQuantity > 0)
                            {
                                <span class="qv-stock qv-stock--in"><span class="qv-dot"></span> موجود در انبار</span>
                            }
                            else
                            {
                                <span class="qv-stock qv-stock--out"><span class="qv-dot"></span> ناموجود</span>
                            }
                            @if (_product.StockQuantity is > 0 and <= 5)
                            {
                                <span class="qv-stock qv-stock--low">تنها @_product.StockQuantity عدد</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(ShortDescription))
                        {
                            <p class="qv-desc">@ShortDescription</p>
                        }

                        <div class="qv-price">
                            @if (DiscountHelper.IsActive(_product))
                            {
                                <span class="qv-now">@DiscountHelper.GetEffectivePrice(_product).ToString("N0") <small>تومان</small></span>
                                <span class="qv-was">@_product.Price.ToString("N0")</span>
                            }
                            else
                            {
                                <span class="qv-now">@_product.Price.ToString("N0") <small>تومان</small></span>
                            }
                        </div>

                        <div class="qv-actions">
                            @if (_product.IsAvailable && _product.StockQuantity > 0)
                            {
                                <div class="qv-qty" role="group" aria-label="تعداد">
                                    <button type="button" class="qv-qty__btn" @onclick="DecreaseQty" disabled="@(_qty <= 1)" aria-label="کم کردن تعداد">
                                        <span class="oi oi-minus"></span>
                                    </button>
                                    <span class="qv-qty__val">@_qty</span>
                                    <button type="button" class="qv-qty__btn" @onclick="IncreaseQty" disabled="@(_product.StockQuantity > 0 && _qty >= _product.StockQuantity)" aria-label="زیاد کردن تعداد">
                                        <span class="oi oi-plus"></span>
                                    </button>
                                </div>

                                <button type="button" class="qv-btn qv-btn--primary" @onclick="AddToCartAsync" disabled="@_adding">
                                    @if (_adding)
                                    {
                                        <span class="qv-spinner" aria-hidden="true"></span>
                                    }
                                    else
                                    {
                                        <span class="oi oi-cart" aria-hidden="true"></span>
                                    }
                                    افزودن به سبد خرید
                                </button>
                            }
                            else
                            {
                                <span class="qv-oos">این محصول فعلاً موجود نیست</span>
                            }

                            <button type="button" class="qv-btn qv-btn--wish @(_inWishlist ? "is-on" : "")" @onclick="ToggleWishlist">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="@(_inWishlist ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" aria-hidden="true">
                                    <path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z" />
                                </svg>
                                @(_inWishlist ? "در علاقه‌مندی‌ها" : "علاقه‌مندی")
                            </button>

                            <a class="qv-link" href="@SeoUrl.Product(_product.Id, _product.Slug)" @onclick="Close">
                                مشاهده صفحه کامل
                                <span class="oi oi-arrow-left" aria-hidden="true"></span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<style>
    .qv-overlay {
        position: fixed;
        inset: 0;
        z-index: 1200;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 1rem;
        background: rgba(2, 6, 23, 0.55);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        animation: qv-fade 0.18s ease;
    }

    .qv-dialog {
        position: relative;
        width: min(860px, 100%);
        max-height: calc(100vh - 2rem);
        overflow-y: auto;
        background: var(--app-surface, #fff);
        color: var(--app-text, #0f172a);
        border-radius: 22px;
        box-shadow: 0 30px 70px rgba(2, 6, 23, 0.4);
        animation: qv-pop 0.2s ease;
    }

    @@keyframes qv-fade { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes qv-pop { from { opacity: 0; transform: translateY(14px) scale(0.98); } to { opacity: 1; transform: none; } }

    .qv-close {
        position: absolute;
        top: 0.7rem;
        left: 0.7rem;
        z-index: 4;
        width: 36px;
        height: 36px;
        display: grid;
        place-items: center;
        border: none;
        border-radius: 50%;
        background: var(--app-bg, #f1f5f9);
        color: var(--app-text-secondary, #334155);
        cursor: pointer;
    }

    .qv-close:hover { background: rgba(239, 68, 68, 0.12); color: #dc2626; }

    .qv-grid {
        display: grid;
        grid-template-columns: 1fr;
    }

    .qv-media {
        position: relative;
        background: linear-gradient(135deg, #fafafa, #f1f5f9);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 1.25rem;
    }

    .qv-badge {
        position: absolute;
        top: 0.8rem;
        right: 0.8rem;
        padding: 0.22rem 0.6rem;
        border-radius: 999px;
        font-size: 0.7rem;
        font-weight: 800;
        color: #fff;
    }

    .qv-badge--sale { background: linear-gradient(135deg, #ef4444, #f97316); }
    .qv-badge--perm { background: linear-gradient(135deg, #8b5cf6, #6366f1); }

    .qv-img {
        width: 100%;
        max-width: 340px;
        max-height: 300px;
        object-fit: contain;
    }

    .qv-thumbs {
        display: flex;
        gap: 0.4rem;
        margin-top: 0.75rem;
    }

    .qv-thumb {
        width: 48px;
        height: 48px;
        padding: 3px;
        border: 1px solid var(--app-border, rgba(15, 23, 42, 0.1));
        border-radius: 10px;
        background: #fff;
        cursor: pointer;
    }

    .qv-thumb.is-active { border-color: var(--app-primary, #2563eb); }

    .qv-thumb img { width: 100%; height: 100%; object-fit: contain; }

    .qv-info {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        padding: 1.35rem 1.25rem 1.5rem;
    }

    .qv-cat {
        font-size: 0.75rem;
        color: var(--app-text-muted, #64748b);
    }

    .qv-title {
        margin: 0;
        font-size: 1.15rem;
        font-weight: 900;
        line-height: 1.8;
        color: var(--app-text, #0f172a);
    }

    .qv-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }

    .qv-stock {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.74rem;
        font-weight: 700;
        padding: 0.2rem 0.6rem;
        border-radius: 999px;
    }

    .qv-dot { width: 7px; height: 7px; border-radius: 50%; background: currentColor; }
    .qv-stock--in { color: #047857; background: rgba(16, 185, 129, 0.12); }
    .qv-stock--out { color: #b91c1c; background: rgba(239, 68, 68, 0.12); }
    .qv-stock--low { color: #b45309; background: rgba(245, 158, 11, 0.14); }

    .qv-desc {
        margin: 0;
        font-size: 0.82rem;
        line-height: 2;
        color: var(--app-text-secondary, #334155);
    }

    .qv-price {
        display: flex;
        align-items: baseline;
        gap: 0.6rem;
        padding: 0.65rem 0;
        border-top: 1px dashed var(--app-border, rgba(15, 23, 42, 0.1));
        border-bottom: 1px dashed var(--app-border, rgba(15, 23, 42, 0.1));
    }

    .qv-now { font-size: 1.35rem; font-weight: 900; color: var(--app-primary, #2563eb); }
    .qv-now small { font-size: 0.75rem; font-weight: 700; }
    .qv-was { font-size: 0.82rem; color: var(--app-text-muted, #94a3b8); text-decoration: line-through; }

    .qv-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.55rem;
        margin-top: 0.2rem;
    }

    .qv-qty {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.2rem 0.4rem;
        border: 1px solid var(--app-border-strong, rgba(15, 23, 42, 0.15));
        border-radius: 999px;
    }

    .qv-qty__btn {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border: none;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        cursor: pointer;
        font-size: 0.7rem;
    }

    .qv-qty__btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .qv-qty__val { min-width: 24px; text-align: center; font-weight: 900; color: #2563eb; }

    .qv-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.4rem;
        padding: 0.6rem 1.1rem;
        border-radius: 999px;
        border: 1px solid transparent;
        font-size: 0.85rem;
        font-weight: 800;
        cursor: pointer;
        transition: transform 0.15s ease, background 0.15s ease;
    }

    .qv-btn:active { transform: scale(0.97); }

    .qv-btn--primary {
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #fff;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.3);
    }

    .qv-btn--primary:hover { background: linear-gradient(135deg, #1d4ed8, #4338ca); }
    .qv-btn--primary:disabled { opacity: 0.7; cursor: wait; }

    .qv-btn--wish {
        background: transparent;
        border-color: var(--app-border-strong, rgba(15, 23, 42, 0.15));
        color: var(--app-text-secondary, #334155);
    }

    .qv-btn--wish.is-on { color: #dc2626; border-color: rgba(220, 38, 38, 0.35); }

    .qv-btn--ghost { background: var(--app-bg, #f1f5f9); color: var(--app-text, #0f172a); }

    .qv-link {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        margin-inline-start: auto;
        font-size: 0.8rem;
        font-weight: 800;
        color: var(--app-primary, #2563eb);
        text-decoration: none;
    }

    .qv-link:hover { text-decoration: underline; }

    .qv-oos { font-size: 0.82rem; font-weight: 800; color: #b91c1c; }

    .qv-spinner {
        width: 14px;
        height: 14px;
        border: 2px solid rgba(255, 255, 255, 0.4);
        border-top-color: #fff;
        border-radius: 50%;
        animation: qv-spin 0.7s linear infinite;
    }

    @@keyframes qv-spin { to { transform: rotate(360deg); } }

    .qv-loading { display: grid; grid-template-columns: 1fr; gap: 1rem; padding: 1.25rem; }
    .qv-skeleton { background: linear-gradient(90deg, #eef2f7 25%, #f8fafc 50%, #eef2f7 75%); background-size: 200% 100%; animation: qv-shimmer 1.4s infinite; border-radius: 14px; }
    .qv-skeleton--img { height: 240px; }
    .qv-skeleton--line { height: 14px; margin-bottom: 0.6rem; }
    .qv-skeleton--line.short { width: 60%; }
    @@keyframes qv-shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }

    .qv-empty { display: flex; flex-direction: column; align-items: center; gap: 0.75rem; padding: 3rem 1.5rem; text-align: center; }
    .qv-empty .oi { font-size: 2rem; color: #f59e0b; }

    @@media (min-width: 768px) {
        .qv-grid { grid-template-columns: 0.9fr 1.1fr; }
        .qv-media { min-height: 100%; padding: 1.75rem; }
        .qv-info { padding: 1.75rem 1.6rem 1.9rem; }
        .qv-title { font-size: 1.3rem; }
    }

    [data-theme="dark"] .qv-media {
        background: linear-gradient(135deg, #172033, #1e293b);
    }

    [data-theme="dark"] .qv-thumb { background: #1e293b; }

    [data-theme="dark"] .qv-desc { color: #cbd5e1; }

    [data-theme="dark"] .qv-now { color: #60a5fa; }

    [data-theme="dark"] .qv-qty__val { color: #93c5fd; }

    [data-theme="dark"] .qv-skeleton {
        background: linear-gradient(90deg, #1e293b 25%, #273449 50%, #1e293b 75%);
        background-size: 200% 100%;
    }

    @@media (prefers-reduced-motion: reduce) {
        .qv-overlay, .qv-dialog, .qv-spinner, .qv-skeleton { animation: none; }
    }
</style>

@code {
    private ProductDto? _product;
    private bool _loading;
    private bool _adding;
    private bool _inWishlist;
    private int _qty = 1;
    private string? _activeImage;
    private DotNetObjectReference<QuickViewModal>? _selfRef;
    private readonly string _escOwner = "quickview";
    private bool _disposed;

    protected override void OnInitialized()
    {
        QuickView.OnChange += HandleChange;
        Nav.LocationChanged += HandleNavigation;
        if (QuickView.IsOpen)
            HandleChange();
    }

    private void HandleNavigation(object? sender, LocationChangedEventArgs e)
    {
        if (QuickView.IsOpen) Close();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            _ = JS.InvokeVoidAsync("esSetScrollLock", _escOwner, QuickView.IsOpen);
            if (QuickView.IsOpen)
                _ = JS.InvokeVoidAsync("esOnEsc", _escOwner, _selfRef);
        }
    }

    private void HandleChange() => _ = InvokeAsync(async () =>
    {
        if (QuickView.IsOpen)
        {
            await LoadAsync(QuickView.ProductId!.Value);
            _selfRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("esSetScrollLock", _escOwner, true); } catch { }
            try { await JS.InvokeVoidAsync("esOnEsc", _escOwner, _selfRef); } catch { }
        }
        else
        {
            try { await JS.InvokeVoidAsync("esSetScrollLock", _escOwner, false); } catch { }
            try { await JS.InvokeVoidAsync("esOffEsc", _escOwner); } catch { }
            _product = null;
        }

        if (_disposed) return;
        StateHasChanged();
    });

    private async Task LoadAsync(int productId)
    {
        _loading = true;
        _qty = 1;
        _inWishlist = false;
        _adding = false;
        _activeImage = null;
        _product = null;
        StateHasChanged();

        try
        {
            var product = await Http.GetFromJsonAsync<ProductDto>($"api/products/{productId}");
            if (QuickView.ProductId != productId) return;
            _product = product;
            _activeImage = product?.MainImageUrl;
            if (product != null)
            {
                try { _inWishlist = await Ws.HasItemAsync(product.Id); } catch { }
            }
        }
        catch
        {
            _product = null;
        }
        finally
        {
            _loading = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private IEnumerable<string> ExtraImages()
    {
        if (_product == null) yield break;
        if (!string.IsNullOrWhiteSpace(_product.MainImageUrl)) yield return _product.MainImageUrl!;
        if (!string.IsNullOrWhiteSpace(_product.ImageUrl2)) yield return _product.ImageUrl2!;
        if (!string.IsNullOrWhiteSpace(_product.ImageUrl3)) yield return _product.ImageUrl3!;
        if (!string.IsNullOrWhiteSpace(_product.ImageUrl4)) yield return _product.ImageUrl4!;
    }

    private string? ShortDescription
    {
        get
        {
            var text = StripHtml(_product?.Description);
            if (string.IsNullOrWhiteSpace(text)) text = StripHtml(_product?.CompatibilityInfo);
            if (string.IsNullOrWhiteSpace(text)) return null;
            return text.Length <= 150 ? text : text.Substring(0, 147) + "...";
        }
    }

    private void IncreaseQty()
    {
        if (_product == null) return;
        if (_product.StockQuantity > 0 && _qty >= _product.StockQuantity) return;
        _qty++;
    }

    private void DecreaseQty()
    {
        if (_qty > 1) _qty--;
    }

    private async Task AddToCartAsync()
    {
        if (_product == null || _adding) return;
        _adding = true;
        try
        {
            var buyQty = _product.StockQuantity > 0 ? Math.Min(_qty, _product.StockQuantity) : _qty;
            await CartService.AddToCartAsync(_product, buyQty);
            Toast.ShowSuccess($"{_product.Name} به سبد خرید اضافه شد.");
            Close();
        }
        catch
        {
            Toast.ShowError("خطا در افزودن به سبد خرید");
        }
        finally
        {
            _adding = false;
        }
    }

    private async Task ToggleWishlist()
    {
        if (_product == null) return;
        try
        {
            await Ws.ToggleAsync(_product.Id, _product.Name, _product.MainImageUrl, _product.Price,
                _product.DiscountPrice, _product.DiscountStartDate, _product.DiscountExpiryDate);
            _inWishlist = await Ws.HasItemAsync(_product.Id);
            Toast.ShowSuccess(_inWishlist ? "به علاقه‌مندی‌ها اضافه شد" : "از علاقه‌مندی‌ها حذف شد");
        }
        catch
        {
            Toast.ShowError("خطا در به‌روزرسانی علاقه‌مندی‌ها");
        }
    }

    private void Close() => QuickView.Close();

    [JSInvokable]
    public void CloseFromJs() => Close();

    private static string StripHtml(string? html)
        => string.IsNullOrWhiteSpace(html)
            ? ""
            : System.Text.RegularExpressions.Regex.Replace(html, @"<[^>]+>", " ").Replace("&nbsp;", " ").Trim();

    public void Dispose()
    {
        _disposed = true;
        QuickView.OnChange -= HandleChange;
        Nav.LocationChanged -= HandleNavigation;
        _ = JS.InvokeVoidAsync("esSetScrollLock", _escOwner, false);
        _ = JS.InvokeVoidAsync("esOffEsc", _escOwner);
        _selfRef?.Dispose();
    }
}
