    .ptable {
        background: #fff;
        border: 1px solid #e8edf3;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 20px;
        box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
    }
