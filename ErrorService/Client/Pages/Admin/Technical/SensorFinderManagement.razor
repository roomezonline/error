@code {
    private string activeTab = "devices";

    private List<SensorFinderDeviceDto> devices = new();
    private List<SensorFinderRecordDto> records = new();
    private List<SensorFinderRecordDto> filteredRecords = new();
    private string searchQuery = "";

    private bool isLoading;

    private SensorFinderDeviceUpsertRequest deviceModel = new();
    private int editingDeviceId;
    private bool isSavingDevice;

    private SensorFinderRecordUpsertRequest recordModel = new();
    private int editingRecordId;
    private bool isSavingRecord;

    private int selectedDeviceId;

    private bool showImagesModal;
    private SensorFinderRecordDto? selectedRecord;
    private string? newImageTitle;
    private string? imageError;

    private void ShowDevicesTab() => activeTab = "devices";
    private void ShowSensorsTab() => activeTab = "sensors";

    protected override async Task OnInitializedAsync()
    {
        await ReloadAll();
    }

    private async Task ReloadAll()
    {
        isLoading = true;
        try
        {
            devices = await Http.GetFromJsonAsync<List<SensorFinderDeviceDto>>("api/sensor-finder/admin/devices") ?? new();
            records = await Http.GetFromJsonAsync<List<SensorFinderRecordDto>>("api/sensor-finder/admin/records") ?? new();

            if (selectedDeviceId > 0)
            {
                records = records.Where(x => x.DeviceId == selectedDeviceId).ToList();
            }

            if (recordModel.DeviceId == 0 && selectedDeviceId > 0)
            {
                recordModel.DeviceId = selectedDeviceId;
            }

            filteredRecords = records;
            ApplyFilter();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SelectDevice(int deviceId)
    {
        selectedDeviceId = deviceId;
        recordModel.DeviceId = deviceId;
        _ = ReloadAll();
    }

    private void ResetDeviceForm()
    {
        editingDeviceId = 0;
        deviceModel = new SensorFinderDeviceUpsertRequest();
    }

    private async Task SaveDevice()
    {
        isSavingDevice = true;
        try
        {
            HttpResponseMessage resp;
            if (editingDeviceId == 0)
                resp = await Http.PostAsJsonAsync("api/sensor-finder/admin/devices", deviceModel);
            else
                resp = await Http.PutAsJsonAsync($"api/sensor-finder/admin/devices/{editingDeviceId}", deviceModel);

            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(editingDeviceId == 0 ? "دستگاه اضافه شد" : "دستگاه ویرایش شد");
                ResetDeviceForm();
                await ReloadAll();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                Toast.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا" : body.Trim('"'));
            }
        }
        finally
        {
            isSavingDevice = false;
        }
    }

    private void EditDevice(SensorFinderDeviceDto d)
    {
        editingDeviceId = d.Id;
        deviceModel = new SensorFinderDeviceUpsertRequest { Name = d.Name };
    }

    private async Task DeleteDevice(int id)
    {
        var resp = await Http.DeleteAsync($"api/sensor-finder/admin/devices/{id}");
        if (resp.IsSuccessStatusCode)
        {
            Toast.ShowSuccess("حذف شد");
            if (selectedDeviceId == id) selectedDeviceId = 0;
            await ReloadAll();
        }
        else
        {
            var body = await resp.Content.ReadAsStringAsync();
            Toast.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا" : body.Trim('"'));
        }
    }

    private void ResetRecordForm()
    {
        editingRecordId = 0;
        recordModel = new SensorFinderRecordUpsertRequest { DeviceId = selectedDeviceId };
    }

    private async Task SaveRecord()
    {
        isSavingRecord = true;
        try
        {
            HttpResponseMessage resp;
            if (editingRecordId == 0)
                resp = await Http.PostAsJsonAsync("api/sensor-finder/admin/records", recordModel);
            else
                resp = await Http.PutAsJsonAsync($"api/sensor-finder/admin/records/{editingRecordId}", recordModel);

            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(editingRecordId == 0 ? "سنسور اضافه شد" : "سنسور ویرایش شد");
                ResetRecordForm();
                await ReloadAll();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                Toast.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا" : body.Trim('"'));
            }
        }
        finally
        {
            isSavingRecord = false;
        }
    }

    private void EditRecord(SensorFinderRecordDto r)
    {
        editingRecordId = r.Id;
        recordModel = new SensorFinderRecordUpsertRequest
        {
            DeviceId = r.DeviceId,
            SensorName = r.SensorName,
            SensorType = r.SensorType,
            SizeText = r.SizeText,
            Notes = r.Notes
        };
    }

    private async Task DeleteRecord(int id)
    {
        var resp = await Http.DeleteAsync($"api/sensor-finder/admin/records/{id}");
        if (resp.IsSuccessStatusCode)
        {
            Toast.ShowSuccess("حذف شد");
            await ReloadAll();
        }
        else
        {
            var body = await resp.Content.ReadAsStringAsync();
            Toast.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا" : body.Trim('"'));
        }
    }

    private void FilterRecords() => ApplyFilter();

    private void ClearSearch()
    {
        searchQuery = "";
        ApplyFilter();
    }

    private void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredRecords = records;
        }
        else
        {
            var q = searchQuery.Trim().ToLower();
            filteredRecords = records.Where(x =>
                (x.SensorName != null && x.SensorName.ToLower().Contains(q)) ||
                (x.DeviceName != null && x.DeviceName.ToLower().Contains(q)) ||
                (x.SensorType != null && x.SensorType.ToLower().Contains(q)) ||
                (x.SizeText != null && x.SizeText.ToLower().Contains(q)) ||
                (x.Notes != null && x.Notes.ToLower().Contains(q))
            ).ToList();
        }
    }

    private void OpenImagesModal(SensorFinderRecordDto r)
    {
        selectedRecord = r;
        showImagesModal = true;
        newImageTitle = null;
        imageError = null;
    }

    private void CloseImagesModal()
    {
        showImagesModal = false;
        selectedRecord = null;
        newImageTitle = null;
        imageError = null;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        imageError = null;
        var file = e.File;

        if (selectedRecord == null || file == null) return;
        if (selectedRecord.Images != null && selectedRecord.Images.Count >= 5)
        {
            imageError = "حداکثر 5 عکس مجاز است";
            return;
        }

        try
        {
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            var content = new MultipartFormDataContent();

            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            if (!string.IsNullOrWhiteSpace(newImageTitle))
            {
                content.Add(new StringContent(newImageTitle), "title");
            }

            var resp = await Http.PostAsync($"api/sensor-finder/admin/records/{selectedRecord.Id}/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("عکس اضافه شد");
                await ReloadAll();
                var updated = records.FirstOrDefault(x => x.Id == selectedRecord.Id);
                if (updated != null) selectedRecord = updated;
                newImageTitle = null;
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                imageError = string.IsNullOrWhiteSpace(body) ? "آپلود ناموفق" : body.Trim('"');
            }
        }
        catch (Exception ex)
        {
            imageError = ex.Message;
        }
    }

    private async Task DeleteImage(int id)
    {
        var resp = await Http.DeleteAsync($"api/sensor-finder/admin/images/{id}");
        if (resp.IsSuccessStatusCode)
        {
            Toast.ShowSuccess("حذف شد");
            await ReloadAll();
            if (selectedRecord != null)
            {
                var updated = records.FirstOrDefault(x => x.Id == selectedRecord.Id);
                if (updated != null) selectedRecord = updated;
            }
        }
        else
        {
            var body = await resp.Content.ReadAsStringAsync();
            Toast.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا" : body.Trim('"'));
        }
    }
}
