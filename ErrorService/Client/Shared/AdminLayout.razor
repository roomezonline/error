<style>
    :root {
        --admin-bg: #f8fafc;
        --admin-surface: #ffffff;
        --admin-primary: #2563eb;
        --admin-text: #0f172a;
        --admin-text-muted: #64748b;
    }

    .admin-shell {
        min-height: 100vh;
        background-color: var(--admin-bg);
        font-family: 'Vazirmatn', sans-serif;
    }

    .user-avatar-header {
        width: 100%;
        height: 100%;
        display: grid;
        place-items: center;
        font-size: 1.1rem;
        font-weight: 900;
        text-transform: uppercase;
    }

    .admin-header {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        min-height: 64px;
        background: transparent;
        z-index: 1030;
        will-change: opacity;
    }

    .admin-header-wrapper {
        background: rgba(255, 255, 255, 0.9);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border-bottom: 1px solid rgba(0,0,0,0.05);
        will-change: transform;
        isolation: isolate;
    }

    .admin-header__inner {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
    }

    .admin-header__top {
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .dropdown-modern { position: relative; }
    .user-dropdown-menu {
        position: absolute !important;
        left: 0 !important;
        right: auto !important;
        top: 100% !important;
        z-index: 1060 !important;
        min-width: 260px;
        background: #fff;
        list-style: none;
        margin-top: 8px !important;
    }

    .admin-header__bottom {
        display: flex;
        flex-direction: column;
        gap: 8px;
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(15, 23, 42, 0.06);
        border-radius: 18px;
        padding: 10px 10px;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
        margin-top: 10px;
    }

    .admin-logo-circle {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        font-size: 1.1rem;
    }

    .workshop-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(37, 99, 235, 0.14);
        background: rgba(37, 99, 235, 0.08);
        color: #1d4ed8;
        font-weight: 900;
        font-size: 0.75rem;
        max-width: 520px;
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .workshop-badge__icon {
        font-size: 0.85rem;
        opacity: 0.9;
    }

    .workshop-badge__text {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .workshop-badge__sub {
        opacity: 0.75;
        font-weight: 800;
        font-size: 0.72rem;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .workshop-badge--super {
        border-color: rgba(2, 132, 199, 0.18);
        background: rgba(2, 132, 199, 0.08);
        color: #0369a1;
    }

    .admin-workshop-picker {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 10px;
        border-radius: 999px;
        border: 1px solid rgba(37, 99, 235, 0.14);
        background: rgba(37, 99, 235, 0.08);
        max-width: 560px;
    }

    .admin-workshop-picker--full {
        width: 100%;
        max-width: none;
        padding: 10px 12px;
        border-radius: 16px;
        box-shadow: 0 10px 24px rgba(37, 99, 235, 0.08);
    }

    .admin-workshop-picker__icon {
        color: #1d4ed8;
        font-size: 0.9rem;
    }

    .admin-workshop-picker__select {
        border: 0;
        background: transparent;
        color: #1d4ed8;
        font-weight: 900;
        font-size: 0.78rem;
        outline: none;
        padding: 0;
        max-width: 520px;
    }

    .admin-workshop-picker__static-text {
        color: #1d4ed8;
        font-weight: 900;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
