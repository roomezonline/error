@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>

@code {
    [Parameter] public string Title { get; set; } = "ارورسرویس | تعمیر و سرویس لوازم خانگی، کد خطا و قطعات یدکی";
    [Parameter] public string Description { get; set; } = "ارورسرویس، مرجع تخصصی کدهای خطای لوازم خانگی، آموزش تعمیرات، قطعات یدکی و سرویس در منزل. بانک جامع ارور ماشین لباسشویی، یخچال، ظرفشویی و ماکروفر.";
    [Parameter] public string? Keywords { get; set; }
    [Parameter] public string? CanonicalUrl { get; set; }
    [Parameter] public string OgType { get; set; } = "website";
    [Parameter] public string? OgImage { get; set; }
    [Parameter] public string? JsonLd { get; set; }

    private string _canonical = "";

    protected override void OnParametersSet()
    {
        if (string.IsNullOrEmpty(CanonicalUrl))
        {
            var uri = new Uri(NavigationManager.Uri);
            _canonical = uri.GetLeftPart(UriPartial.Path);
        }
        else
        {
            _canonical = CanonicalUrl;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Run JS to update head tags in-place (no duplication)
        try
        {
            await JS.InvokeVoidAsync("seoHelper.replaceAll",
                Title,
                Description,
                Keywords ?? "",
                _canonical,
                OgType,
                OgImage ?? "",
                JsonLd ?? "");
        }
        catch
        {
            // JS interop fails silently (e.g., prerendering)
        }
    }
}
