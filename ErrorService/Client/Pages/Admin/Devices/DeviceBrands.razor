@page "/admin/devices/brands"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.technical.brands.view")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Services
@inject ToastService ToastService

<div class="admin-container" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="admin-page-title m-0">مدیریت برندها</h3>
        <a href="/admin/devices/types" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm">
            <span class="oi oi-clipboard me-1"></span> مدیریت نوع دستگاه‌ها
        </a>
    </div>

    <ConfirmDialog IsVisible="showConfirm"
                   Title="حذف برند"
                   Message=@($"آیا از حذف برند \"{itemToDelete?.Name}\" اطمینان دارید؟")
                   OnResult="HandleDeleteResult" />

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 rounded-4 p-3">
                <h5 class="card-title mb-3">@(editingId == 0 ? "ایجاد" : "ویرایش") برند</h5>
                <EditForm Model="model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">نوع دستگاه</label>
                        <InputSelect @bind-Value="model.DeviceTypeId" class="form-select rounded-3">
                            <option value="0">انتخاب کنید</option>
                            @if (deviceTypes != null)
                            {
                                @foreach (var dt in deviceTypes)
                                {
                                    <option value="@dt.Id">@dt.Name</option>
                                }
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => model.DeviceTypeId)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">نام برند</label>
                        <InputText @bind-Value="model.Name" class="form-control rounded-3" placeholder="مثلاً: Samsung" />
                        <ValidationMessage For="@(() => model.Name)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">ترتیب نمایش</label>
                        <InputNumber @bind-Value="model.SortOrder" class="form-control rounded-3" />
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-success rounded-3" disabled="@isSaving">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            ذخیره
                        </button>
                        @if (editingId != 0)
                        {
                            <button type="button" class="btn btn-light rounded-3" @onclick="ResetForm">انصراف</button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="p-3 border-bottom bg-white">
                    <div class="d-flex flex-column flex-md-row gap-2 align-items-stretch align-items-md-center">
                        <input class="form-control rounded-3" placeholder="جستجو..." value="@searchQuery" @oninput="OnSearchInput" />
                        <select class="form-select rounded-3" @bind="filterDeviceTypeId" @bind:after="OnFilterDeviceTypeChanged">
                            <option value="">همه نوع دستگاه‌ها</option>
                            @if (deviceTypes != null)
                            {
                                @foreach (var dt in deviceTypes)
                                {
                                    <option value="@dt.Id">@dt.Name</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">برند</th>
                                <th>نوع دستگاه</th>
                                <th>ترتیب</th>
                                <th class="text-end pe-4">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (items == null)
                            {
                                <tr><td colspan="4" class="text-center py-4">در حال بارگذاری...</td></tr>
                            }
                            else if (!items.Any())
                            {
                                <tr><td colspan="4" class="text-center py-4 text-muted">موردی ثبت نشده است.</td></tr>
                            }
                            else
                            {
                                @foreach (var group in items
                                   .GroupBy(x => new { x.DeviceTypeId, x.DeviceTypeName })
                                   .OrderBy(g => g.Key.DeviceTypeName))
                                {
                                    <tr class="table-secondary">
                                        <td colspan="4" class="ps-4 fw-bold">@group.Key.DeviceTypeName</td>
                                    </tr>

                                    @foreach (var it in group.OrderBy(x => x.SortOrder).ThenBy(x => x.Name))
                                    {
                                        <tr>
                                            <td class="ps-4 fw-bold">@it.Name</td>
                                            <td>@it.DeviceTypeName</td>
                                            <td>@it.SortOrder</td>
                                            <td class="text-end pe-4">
                                                <button class="btn btn-sm btn-outline-primary border-0" @onclick="() => Edit(it)">
                                                    <span class="oi oi-pencil"></span>
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => AskDelete(it)">
                                                    <span class="oi oi-trash"></span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;

    private string? searchQuery;
    private string? filterDeviceTypeId;

    private List<DeviceBrandDto>? items;
    private List<DeviceTypeDto>? deviceTypes;

    private DeviceBrandUpsertRequest model = new();
    private int editingId;
    private bool isSaving;

    private DeviceBrandDto? itemToDelete;
    private bool showConfirm;

    protected override async Task OnInitializedAsync()
    {
        await LoadDeviceTypes();
        await Load();
        ResetForm();
    }

    private async Task LoadDeviceTypes()
    {
        deviceTypes = await Http.GetFromJsonAsync<List<DeviceTypeDto>>("api/device-types") ?? new();
    }

    private async Task Load()
    {
        var url = "api/device-brands";

        if (!string.IsNullOrWhiteSpace(filterDeviceTypeId))
            url += $"?deviceTypeId={Uri.EscapeDataString(filterDeviceTypeId)}";

        if (!string.IsNullOrWhiteSpace(searchQuery))
            url += (url.Contains('?') ? "&" : "?") + $"q={Uri.EscapeDataString(searchQuery.Trim())}";

        items = await Http.GetFromJsonAsync<List<DeviceBrandDto>>(url);
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString();
        _ = InvokeAsync(async () =>
        {
            await Load();
            ResetForm();
            StateHasChanged();
        });
    }

    private void OnFilterDeviceTypeChanged()
    {
        _ = InvokeAsync(async () =>
        {
            await Load();
            ResetForm();
            StateHasChanged();
        });
    }

    private void NewItem() => ResetForm();

    private void Edit(DeviceBrandDto dto)
    {
        editingId = dto.Id;
        model = new DeviceBrandUpsertRequest
        {
            DeviceTypeId = dto.DeviceTypeId,
            Name = dto.Name,
            SortOrder = dto.SortOrder
        };
    }

    private void ResetForm()
    {
        editingId = 0;
        model = new DeviceBrandUpsertRequest
        {
            DeviceTypeId = deviceTypes?.FirstOrDefault()?.Id ?? 0,
            SortOrder = (items != null && items.Any() ? items.Max(x => x.SortOrder) : 0) + 1
        };
    }

    private async Task Save()
    {
        isSaving = true;
        try
        {
            HttpResponseMessage resp;
            if (editingId == 0)
                resp = await Http.PostAsJsonAsync("api/device-brands", model);
            else
                resp = await Http.PutAsJsonAsync($"api/device-brands/{editingId}", model);

            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(editingId == 0 ? "برند ایجاد شد" : "تغییرات ذخیره شد");
                await Load();
                ResetForm();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا در ذخیره" : body.Trim('"'));
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AskDelete(DeviceBrandDto dto)
    {
        itemToDelete = dto;
        showConfirm = true;
    }

    private async Task HandleDeleteResult(bool ok)
    {
        showConfirm = false;
        if (!ok || itemToDelete == null) return;

        try
        {
            var resp = await Http.DeleteAsync($"api/device-brands/{itemToDelete.Id}");
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("حذف شد");
                await Load();
                ResetForm();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "حذف ناموفق" : body.Trim('"'));
            }
        }
        catch
        {
            ToastService.ShowError("خطا در حذف");
        }
    }
}
