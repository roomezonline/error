@page "/academy/articles/{ArticleId:int}"
@page "/academy/articles/{Slug}"
@using ErrorService.Shared
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using ErrorService.Client.Utils
@implements IDisposable

<PageTitle>@(article?.Title ?? "مشاهده آموزش") - آکادمی</PageTitle>

<div class="article-viewer-page py-4 bg-light" dir="rtl">
    <div class="container">
        @if (isLoading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (loadError)
        {
            <SeoHeader Title="خطا | ارور سرویس" Description="متاسفانه در دریافت اطلاعات خطایی رخ داد." />
            <div class="alert alert-danger text-center py-5 rounded-4 shadow-sm">
                <h3 class="fw-bold">خطا در دریافت اطلاعات</h3>
                <p class="text-muted mb-3">امکان ارتباط با سرور وجود ندارد. لطفاً بعداً تلاش کنید.</p>
                <button class="btn btn-primary rounded-pill px-4" @onclick="Reload">تلاش مجدد</button>
                <a href="/academy" class="btn btn-outline-secondary rounded-pill px-4 me-2">بازگشت به آکادمی</a>
            </div>
        }
        else if (article == null)
        {
            <SeoHeader Title="مقاله یافت نشد | ارور سرویس" Description="متاسفانه مقاله مورد نظر یافت نشد." />
            <div class="alert alert-warning text-center py-5 rounded-4 shadow-sm">
                <h3 class="fw-bold">مقاله مورد نظر یافت نشد!</h3>
                <a href="/academy" class="btn btn-primary mt-3 rounded-pill px-4">بازگشت به آکادمی</a>
            </div>
        }
        else
        {
            <SeoHeader 
                Title="@($"{article.Title} | مقاله آموزشی | ارور سرویس")" 
                Description="@(string.IsNullOrEmpty(article.Summary) ? $"مطالعه مقاله آموزشی {article.Title} در آکادمی ارور سرویس" : (article.Summary.Length > 160 ? article.Summary.Substring(0, 157) + "..." : article.Summary))"
                OgType="article"
                OgImage="@(article.CoverImageUrl ?? "/images/og-default.jpg")"
                JsonLd="@articleJsonLd" />

            <ViewTracker EntityType="article" EntityId="article.Id" />

            <div class="article-header-sticky d-lg-none shadow-sm">
                <div class="container d-flex align-items-center justify-content-between h-100 px-2">
                    <a href="/academy" class="nav-btn-mobile" title="بازگشت به آکادمی" aria-label="بازگشت به آکادمی">
                        <span class="oi oi-arrow-right nav-btn-mobile__icon ms-0"></span>
                    </a>
                    <div class="header-title-text text-truncate px-2">@article.Title</div>
                    <button class="nav-btn-mobile" @onclick="OpenShareModal" title="اشتراک‌گذاری" aria-label="اشتراک‌گذاری">
                        <span class="oi oi-share nav-btn-mobile__icon me-0"></span>
                    </button>
                </div>
            </div>

            <div class="d-none d-lg-flex align-items-center justify-content-between mb-3">
                <a href="/academy" class="btn btn-outline-secondary rounded-pill px-3">
                    <span class="oi oi-arrow-right me-1"></span> بازگشت به آکادمی
                </a>
            </div>

            <nav aria-label="breadcrumb" class="d-none d-lg-block mb-4">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/academy">آکادمی</a></li>
                    <li class="breadcrumb-item active">@article.Title</li>
                </ol>
            </nav>

            <div class="row g-4 justify-content-center">
                <div class="col-lg-8">
                    <article class="card border-0 shadow-sm overflow-hidden mb-4" style="border-radius: 1.25rem;">
                        @if (!string.IsNullOrEmpty(article.CoverImageUrl))
                        {
                            <img src="@article.CoverImageUrl" class="article-hero-img" alt="@article.Title"
                                 fetchpriority="high" decoding="async" />
                        }
                        
                        <div class="card-body p-4 p-md-5">
                            <h1 class="fw-black display-6 mb-2">@article.Title</h1>
                            <div class="d-flex align-items-center gap-3 mb-4" style="font-size: 0.82rem; color: #6366f1;">
                                <span class="d-flex align-items-center gap-1">
                                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                                    @article.ViewCount.ToString("N0") بازدید
                                </span>
                            </div>
                            
                            <div class="d-flex flex-wrap align-items-center gap-3 mb-5 pb-4 border-bottom">
                                <div class="badge bg-primary text-white rounded-pill px-3 py-2">@(article.IsPremium ? "آموزش ویژه" : "آموزش رایگان")</div>
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <span class="oi oi-person"></span>
                                    ارسال کننده: تیم ارور سرویس
                                </div>
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <span class="oi oi-calendar"></span>
                                    @PersianDate.ToJalaliDate(article.CreatedAt)
                                </div>
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <span class="oi oi-clock"></span>
                                    @PersianDate.ToTime(article.CreatedAt)
                                </div>
                                <div class="text-muted small d-flex align-items-center gap-1">
                                    <span class="oi oi-timer"></span>
                                    زمان مطالعه: @readingTime دقیقه
                                </div>
                                @if (article.Blocks.Count > 0)
                                {
                                    <div class="text-muted small d-flex align-items-center gap-1">
                                        <span class="oi oi-layers"></span>
                                        @article.Blocks.Count بخش
                                    </div>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(article.Summary))
                            {
                                <div class="article-summary p-4 rounded-4 mb-5 border-right-primary">
                                    <p class="text-muted mb-0 italic">@article.Summary</p>
                                </div>
                            }

                            @if (tocItems.Count > 0)
                            {
                                <div class="toc-mobile d-lg-none mb-5">
                                    <div class="toc-mobile-header" @onclick="ToggleMobileToc">
                                        <span class="oi oi-list me-2"></span>
                                        فهرست مطالب
                                        <span class="toc-mobile-arrow @(mobileTocOpen ? "open" : "")">
                                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
                                        </span>
                                    </div>
                                    @if (mobileTocOpen)
                                    {
                                        <div class="toc-mobile-body">
                                            @foreach (var toc in tocItems)
                                            {
                                                <a href="#@toc.Id" class="toc-mobile-link @(toc.Level == 3 ? "toc-mobile-link--h3" : "")" @onclick:preventDefault="true" @onclick="@(() => ScrollToToc(toc.Id))">@toc.Title</a>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            <div class="article-content-blocks">
                                @foreach (var group in BuildBlockGroups(article.Blocks))
                                {
                                    var first = group.Blocks[0];
                                    <div class="content-block mb-5" @key="group.Key">
                                        @if (group.Type == TrainingBlockTypeDto.Text && !string.IsNullOrEmpty(first.Title))
                                        {
                                            <h4 class="fw-bold mb-3 h4">@first.Title</h4>
                                        }

                                        @switch (group.Type)
                                        {
                                            case TrainingBlockTypeDto.Text:
                                                foreach (var block in group.Blocks)
                                                {
                                                    var textHtml = _processedContent.TryGetValue(block.Id, out var p) ? p : (block.Content ?? "");
                                                    if (!string.IsNullOrEmpty(block.Title) && block.Id != first.Id)
                                                    {
                                                        <h4 class="fw-bold mb-3 h4">@block.Title</h4>
                                                    }
                                                    <div class="text-content">@((MarkupString)HtmlSanitizer.Sanitize(textHtml))</div>
                                                }
                                                break;

                                            case TrainingBlockTypeDto.Image:
                                                <div class="media-card media-card--image">
                                                    <div class="media-card__header">
                                                        <span class="media-card__badge">
                                                            <span class="oi oi-image"></span>
                                                            @(group.Blocks.Count > 1 ? $"گالری تصاویر ({group.Blocks.Count})" : "تصویر")
                                                        </span>
                                                        @if (!string.IsNullOrEmpty(first.Title))
                                                        {
                                                            <span class="media-card__title">@first.Title</span>
                                                        }
                                                    </div>
                                                    <div class="media-card__body">
                                                        <div class="article-gallery">
                                                            @foreach (var block in group.Blocks)
                                                            {
                                                                var caption = !string.IsNullOrEmpty(block.Content) ? block.Content : (!string.IsNullOrEmpty(block.Title) ? block.Title : null);
                                                                <figure class="article-gallery__item">
                                                                    <button type="button" class="article-gallery__btn" @onclick="@(() => OpenImageLightbox(block.Url ?? ""))" title="برای بزرگ‌نمایی کلیک کنید">
                                                                        <img src="@block.Url" alt="@(block.Title ?? "تصویر آموزش")" class="article-gallery__img" loading="lazy" />
                                                                        <span class="article-gallery__zoom"><span class="oi oi-magnifying-glass"></span></span>
                                                                    </button>
                                                                    <figcaption class="article-gallery__caption">
                                                                        <span class="article-gallery__caption-text">@(caption ?? $"تصویر {block.Id}")</span>
                                                                        <a href="@block.Url" class="article-gallery__dl" download title="دانلود تصویر" @onclick:stopPropagation>
                                                                            <span class="oi oi-cloud-download"></span>
                                                                        </a>
                                                                    </figcaption>
                                                                </figure>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.Video:
                                                <div class="media-card media-card--video">
                                                    <div class="media-card__header">
                                                        <span class="media-card__badge">
                                                            <span class="oi oi-video"></span>
                                                            @(group.Blocks.Count > 1 ? $"ویدیوها ({group.Blocks.Count})" : "ویدیو")
                                                        </span>
                                                        @if (group.Blocks.Count == 1 && !string.IsNullOrEmpty(first.Url))
                                                        {
                                                            <a href="@first.Url" class="media-card__dl" download title="دانلود ویدیو">
                                                                <span class="oi oi-cloud-download"></span> دانلود
                                                            </a>
                                                        }
                                                    </div>
                                                    <div class="media-card__body">
                                                        <div class="media-grid @(group.Blocks.Count > 1 ? "media-grid--multi" : "")">
                                                            @foreach (var block in group.Blocks)
                                                            {
                                                                <div class="media-grid__cell">
                                                                    @if (!string.IsNullOrEmpty(block.Title) && (group.Blocks.Count > 1 || block.Title != first.Title))
                                                                    {
                                                                        <div class="media-cell__title">@block.Title</div>
                                                                    }
                                                                    <div class="plyr-wrapper rounded-4 overflow-hidden shadow-sm">
                                                                        @if (!string.IsNullOrEmpty(block.ThumbnailUrl))
                                                                        {
                                                                            <video controls class="js-plyr" poster="@block.ThumbnailUrl" preload="metadata">
                                                                                <source src="@block.Url" type="@GetVideoMime(block.Url)" />
                                                                            </video>
                                                                        }
                                                                        else
                                                                        {
                                                                            <video controls class="js-plyr" preload="metadata">
                                                                                <source src="@block.Url" type="@GetVideoMime(block.Url)" />
                                                                            </video>
                                                                        }
                                                                    </div>
                                                                    @if (!string.IsNullOrEmpty(block.Content))
                                                                    {
                                                                        <p class="text-muted small mt-2 mb-0">@block.Content</p>
                                                                    }
                                                                    @if (group.Blocks.Count > 1 && !string.IsNullOrEmpty(block.Url))
                                                                    {
                                                                        <a href="@block.Url" class="media-cell__dl" download>
                                                                            <span class="oi oi-cloud-download"></span> دانلود ویدیو
                                                                        </a>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.Audio:
                                                <div class="media-card media-card--audio">
                                                    <div class="media-card__header">
                                                        <span class="media-card__badge">
                                                            <span class="oi oi-volume-high"></span>
                                                            @(group.Blocks.Count > 1 ? $"فایل‌های صوتی ({group.Blocks.Count})" : "صوت")
                                                        </span>
                                                        @if (group.Blocks.Count == 1 && !string.IsNullOrEmpty(first.Url))
                                                        {
                                                            <a href="@first.Url" class="media-card__dl" download title="دانلود صوت">
                                                                <span class="oi oi-cloud-download"></span> دانلود
                                                            </a>
                                                        }
                                                    </div>
                                                    <div class="media-card__body">
                                                        <div class="media-stack">
                                                            @foreach (var block in group.Blocks)
                                                            {
                                                                <div class="media-stack__item">
                                                                    @if (!string.IsNullOrEmpty(block.Title))
                                                                    {
                                                                        <div class="media-cell__title">@block.Title</div>
                                                                    }
                                                                    <div class="plyr-wrapper rounded-4 overflow-hidden shadow-sm bg-dark p-4">
                                                                        <audio controls class="js-plyr" preload="metadata">
                                                                            <source src="@block.Url" type="audio/mpeg" />
                                                                        </audio>
                                                                    </div>
                                                                    @if (!string.IsNullOrEmpty(block.Content))
                                                                    {
                                                                        <p class="text-muted small mt-2 mb-0">@block.Content</p>
                                                                    }
                                                                    @if (!string.IsNullOrEmpty(block.Url))
                                                                    {
                                                                        <a href="@block.Url" class="media-cell__dl" download>
                                                                            <span class="oi oi-cloud-download"></span> دانلود صوت
                                                                        </a>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                break;

                                            case TrainingBlockTypeDto.File:
                                                @if (group.Blocks.Count == 1)
                                                {
                                                    <div class="download-box-wrapper my-2">
                                                        <div class="download-box">
                                                            <div class="download-box__shine"></div>
                                                            <div class="download-box__content">
                                                                <div class="download-box__icon">
                                                                    <span class="oi oi-data-transfer-download"></span>
                                                                </div>
                                                                <div class="download-box__info">
                                                                    <h5 class="download-box__title">@(string.IsNullOrEmpty(first.Title) ? "فایل ضمیمه آموزش" : first.Title)</h5>
                                                                    <div class="download-box__meta">
                                                                        <span class="download-box__tag"><span class="oi oi-paperclip"></span> فایل آموزشی</span>
                                                                        @if (!string.IsNullOrEmpty(first.Url))
                                                                        {
                                                                            <span class="download-box__tag"><span class="oi oi-link-intact"></span> لینک مستقیم</span>
                                                                        }
                                                                    </div>
                                                                </div>
                                                                <a href="@first.Url" target="_blank" class="download-box__btn">
                                                                    <span class="download-box__btn-text">دانلود فایل</span>
                                                                    <span class="oi oi-cloud-download download-box__btn-icon"></span>
                                                                </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="media-card media-card--file">
                                                        <div class="media-card__header">
                                                            <span class="media-card__badge">
                                                                <span class="oi oi-file"></span>
                                                                فایل‌ها (@group.Blocks.Count)
                                                            </span>
                                                        </div>
                                                        <div class="media-card__body media-card__body--stack">
                                                            @foreach (var block in group.Blocks)
                                                            {
                                                                <div class="download-box-wrapper">
                                                                    <div class="download-box">
                                                                        <div class="download-box__shine"></div>
                                                                        <div class="download-box__content">
                                                                            <div class="download-box__icon">
                                                                                <span class="oi oi-data-transfer-download"></span>
                                                                            </div>
                                                                            <div class="download-box__info">
                                                                                <h5 class="download-box__title">@(string.IsNullOrEmpty(block.Title) ? "فایل ضمیمه آموزش" : block.Title)</h5>
                                                                                <div class="download-box__meta">
                                                                                    <span class="download-box__tag"><span class="oi oi-paperclip"></span> فایل آموزشی</span>
                                                                                </div>
                                                                            </div>
                                                                            <a href="@block.Url" target="_blank" class="download-box__btn">
                                                                                <span class="download-box__btn-text">دانلود فایل</span>
                                                                                <span class="oi oi-cloud-download download-box__btn-icon"></span>
                                                                            </a>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                break;

                                            case TrainingBlockTypeDto.Embed:
                                                <div class="media-card media-card--embed">
                                                    <div class="media-card__body">
                                                        <div class="media-stack">
                                                            @foreach (var block in group.Blocks)
                                                            {
                                                                @if (!string.IsNullOrEmpty(block.Title))
                                                                {
                                                                    <div class="media-cell__title">@block.Title</div>
                                                                }
                                                                <div class="embed-wrapper rounded-4 overflow-hidden shadow-sm">
                                                                    @((MarkupString)HtmlSanitizer.Sanitize(EmbedHtml.Fix(block.Content)))
                                                                </div>
                                                                @if (!string.IsNullOrEmpty(block.Url))
                                                                {
                                                                    <p class="text-muted small mt-2 mb-0">@block.Url</p>
                                                                }
                                                            }
                                                        </div>
                                                    </div>
                                                </div>
                                                break;
                                        }
                                    </div>
                                }
                            </div>

                            <div class="d-flex align-items-center justify-content-center mt-5 pt-4 border-top">
                                <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="OpenShareModal">
                                    <span class="oi oi-share me-2"></span> اشتراک‌گذاری
                                </button>
                            </div>

                            <div class="mt-5 pt-5 border-top">
                                <CommentSection HeaderTitle="نظرات کاربران"
                                                FormTitle="ارسال نظر جدید"
                                                ShowRating="true"
                                                ShowStarSummary="true"
                                                RequireEmail="false"
                                                SubmitEndpoint="@($"api/trainingarticles/{(ArticleId ?? article?.Id ?? 0)}/comments")"
                                                AverageRating="@article.AverageRating"
                                                TotalCount="@(article.Comments?.Count ?? 0)"
                                                Comments="@_academyCommentDtos"
                                                SubmitComment="@HandleAcademyCommentSubmit" />
                            </div>
                        </div>
                    </article>
                </div>

                <div class="col-lg-4">
                    <div class="position-sticky" style="top: 1.5rem;">
                        <div class="card border-0 shadow-sm overflow-hidden mb-4 d-none d-lg-block" style="border-radius: 1.25rem;">
                            <div class="card-header bg-white border-0 py-3 px-4">
                                <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                                    <span class="oi oi-list"></span>
                                    فهرست مطالب
                                </h5>
                            </div>
                            <div class="card-body p-3">
                                @if (tocItems.Count > 0)
                                {
                                        <nav class="toc-nav">
                                            @foreach (var toc in tocItems)
                                            {
                                                <a href="#@toc.Id" class="toc-link @(toc.Level == 3 ? "toc-link--h3" : "")" @onclick:preventDefault="true" @onclick="@(() => ScrollToToc(toc.Id))">@toc.Title</a>
                                            }
                                        </nav>
                                }
                                else
                                {
                                    <p class="text-muted small mb-0 px-2">این آموزش فهرست جداگانه‌ای ندارد.</p>
                                }
                            </div>
                        </div>

                                                @if (article.Blocks.Any(b => b.BlockType is TrainingBlockTypeDto.Video or TrainingBlockTypeDto.Audio or TrainingBlockTypeDto.File or TrainingBlockTypeDto.Embed)
                                                    || article.Blocks.Count(b => b.BlockType == TrainingBlockTypeDto.Image) > 1)
                                                {
                                                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden d-none d-lg-block">
                                                        <div class="card-header bg-white border-0 py-3 px-4">
                                                            <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                                                                <span class="oi oi-layers"></span>
                                                                بخش‌های آموزش
                                                            </h5>
                                                        </div>
                                                        <div class="card-body p-3">
                                                            <div class="d-flex flex-column gap-2">
                                                                @foreach (var group in BuildBlockGroups(article.Blocks).Where(g => g.Type != TrainingBlockTypeDto.Text))
                                                                {
                                                                    <div class="block-sidebar-item d-flex align-items-center gap-2 p-2 rounded-3">
                                                                        <span class="block-sidebar-icon">
                                                                            @switch (group.Type)
                                                                            {
                                                                                case TrainingBlockTypeDto.Image:
                                                                                    <span class="oi oi-image"></span>
                                                                                    break;
                                                                                case TrainingBlockTypeDto.Video:
                                                                                    <span class="oi oi-video"></span>
                                                                                    break;
                                                                                case TrainingBlockTypeDto.Audio:
                                                                                    <span class="oi oi-volume-high"></span>
                                                                                    break;
                                                                                case TrainingBlockTypeDto.File:
                                                                                    <span class="oi oi-file"></span>
                                                                                    break;
                                                                                case TrainingBlockTypeDto.Embed:
                                                                                    <span class="oi oi-code"></span>
                                                                                    break;
                                                                            }
                                                                        </span>
                                                                        <span class="small">@(group.Blocks.Count > 1 ? $"{GetBlockTypeName(group.Type)} ({group.Blocks.Count})" : (string.IsNullOrEmpty(group.Blocks[0].Title) ? GetBlockTypeName(group.Type) : group.Blocks[0].Title))</span>
                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@if (showImageLightbox && !string.IsNullOrEmpty(lightboxImageUrl))
{
    <div class="pd-lightbox" @onclick="CloseImageLightbox">
        <div class="pd-lightbox-content" @onclick:stopPropagation>
            <button class="pd-lightbox-close" @onclick="CloseImageLightbox" aria-label="بستن">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <div class="pd-lightbox-img-wrap">
                <img src="@lightboxImageUrl" alt="تصویر" class="pd-lightbox-img" decoding="async" />
            </div>
        </div>
    </div>
}

<ShareModal Visible="_showShareModal"
    OnClose="CloseShareModal"
    HeaderTitle="اشتراک‌گذاری آموزش"
    LinkLabel="آموزش"
    ImageUrl="@article?.CoverImageUrl"
    PreviewTitle="@(article?.Title ?? "")"
    PreviewDescription="@(article?.Summary ?? "")"
    ShareUrl="@Nav.Uri"
    GetShareText="@(() => GetShareText())"
    GetShareTelegramText="@(() => GetShareTextForTelegram())" />

@if (toastText != null)
{
    <div class="article-toast" role="status" aria-live="polite">@toastText</div>
}

<button class="article-scroll-top @scrollTopClass" @onclick="ScrollToTop" aria-label="بالا">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<script>
    window.__scrollToElement = function(id) {
        var el = document.getElementById(id);
        if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    window.__initLightboxKeyboard = function(dotnetRef) {
        var handler = function(e) {
            if (e.key === 'Escape') dotnetRef.invokeMethodAsync('CloseImageLightbox');
        };
        document.addEventListener('keydown', handler);
        return handler;
    };
    window.__removeLightboxKeyboard = function(handler) {
        document.removeEventListener('keydown', handler);
    };
    window.__initCodeCopy = function() {
        document.querySelectorAll('.text-content pre').forEach(function(pre) {
            var btn = document.createElement('button');
            btn.className = 'code-copy-btn';
            btn.textContent = 'کپی';
            btn.addEventListener('click', function() {
                var code = pre.querySelector('code');
                var text = code ? code.textContent : pre.textContent;
                __copyToClipboard(text).then(function() {
                    btn.textContent = 'کپی شد!';
                    setTimeout(function() { btn.textContent = 'کپی'; }, 2000);
                });
            });
            pre.appendChild(btn);
        });
    };
    window.__articleScrollHandler = function(dotnetRef) {
        var ticking = false;
        var handler = function() {
            if (!ticking) {
                ticking = true;
                window.requestAnimationFrame(function() {
                    dotnetRef.invokeMethodAsync('OnPageScroll', window.scrollY > 400);
                    ticking = false;
                });
            }
        };
        window.addEventListener('scroll', handler, { passive: true });
        handler();
        return handler;
    };
    window.__articleRemoveScrollHandler = function(handler) {
        window.removeEventListener('scroll', handler);
    };
    window.__initArticlePlyr = function(selector) {
        if (typeof Plyr !== 'undefined') {
            var players = document.querySelectorAll(selector);
            players.forEach(function(el) { new Plyr(el); });
        }
    };
</script>


@code {
    [Parameter] public int? ArticleId { get; set; }
    [Parameter] public string? Slug { get; set; }
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private HttpClient HttpApi { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private TrainingArticleDto? article;
    private bool isLoading = true;
    private bool loadError;
    private bool plyrInitialized;
    private string? articleJsonLd;
    private string? toastText;
    private CancellationTokenSource? _toastCts;

    private List<CommentDto> _academyCommentDtos = new();

    private bool showImageLightbox;
    private string? lightboxImageUrl;

    private bool _showScrollTop;
    private string scrollTopClass => _showScrollTop ? "scroll-visible" : "";
    private object? _scrollHandlerRef;
    private object? _lightboxKeyHandler;

    private List<TocItem> tocItems = new();
    private Dictionary<int, string> _processedContent = new();
    private int _headingCounter;
    private bool mobileTocOpen;
    private bool _showShareModal;
    private int readingTime => CalculateReadingTime();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotnetRef = DotNetObjectReference.Create(this);
            _scrollHandlerRef = await JS.InvokeAsync<object>("__articleScrollHandler", dotnetRef);
            _lightboxKeyHandler = await JS.InvokeAsync<object>("__initLightboxKeyboard", dotnetRef);
            await JS.InvokeVoidAsync("__initCodeCopy");
        }

        if (article != null && !isLoading && !plyrInitialized)
        {
            var hasMedia = article.Blocks.Any(b => b.BlockType == TrainingBlockTypeDto.Video || b.BlockType == TrainingBlockTypeDto.Audio);
            if (hasMedia)
            {
                await Task.Delay(300);
                await JS.InvokeVoidAsync("__initArticlePlyr", ".js-plyr");
            }
            plyrInitialized = true;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        RemoveOldToast();
        await LoadArticle();
    }

    [JSInvokable]
    public void OnPageScroll(bool isVisible)
    {
        _showScrollTop = isVisible;
        StateHasChanged();
    }

    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    private async Task ScrollToToc(string id)
    {
        try
        {
            await JS.InvokeVoidAsync("__scrollToElement", id);
        }
        catch { }
    }

    private async Task LoadArticle()
    {
        try
        {
            isLoading = true;
            loadError = false;

            TrainingArticleDto? loaded;
            if (!string.IsNullOrEmpty(Slug))
            {
                loaded = await HttpApi.GetFromJsonAsync<TrainingArticleDto>($"api/trainingarticles/slug/{Uri.EscapeDataString(Slug)}?onlyApprovedComments=true");
            }
            else if (ArticleId.HasValue)
            {
                loaded = await HttpApi.GetFromJsonAsync<TrainingArticleDto>($"api/trainingarticles/{ArticleId}?onlyApprovedComments=true");
                if (loaded != null && !string.IsNullOrEmpty(loaded.Slug))
                {
                    Nav.NavigateTo(SeoUrl.Article(loaded.Id, loaded.Slug), replace: true);
                }
            }
            else
            {
                loaded = null;
            }

            article = loaded;
            if (article != null)
            {
                articleJsonLd = BuildArticleJsonLd(article);
                ProcessArticleContent();
                _academyCommentDtos = ConvertComments(article.Comments);
            }
        }
        catch
        {
            loadError = true;
            article = null;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Reload()
    {
        RemoveOldToast();
        await LoadArticle();
    }

    private string BuildArticleJsonLd(TrainingArticleDto article)
    {
        var baseUrl = Nav.BaseUri.TrimEnd('/');
        var articleSchema = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Article",
            ["headline"] = article.Title,
            ["description"] = TruncateText(article.Summary ?? article.Title, 500),
            ["image"] = string.IsNullOrEmpty(article.CoverImageUrl) ? Array.Empty<string>() : new[] { article.CoverImageUrl },
            ["datePublished"] = article.CreatedAt.ToString("yyyy-MM-ddTHH:mm:sszzz"),
            ["dateModified"] = article.CreatedAt.ToString("yyyy-MM-ddTHH:mm:sszzz"),
            ["url"] = $"{baseUrl}{SeoUrl.Article(article.Id, article.Slug)}",
            ["author"] = new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = "ارور سرویس",
                ["url"] = baseUrl
            },
            ["publisher"] = new Dictionary<string, object?>
            {
                ["@type"] = "Organization",
                ["name"] = "ارور سرویس",
                ["logo"] = new Dictionary<string, object?>
                {
                    ["@type"] = "ImageObject",
                    ["url"] = $"{baseUrl}/favicon.png"
                }
            },
            ["mainEntityOfPage"] = new Dictionary<string, object?>
            {
                ["@type"] = "WebPage",
                ["@id"] = $"{baseUrl}{SeoUrl.Article(article.Id, article.Slug)}"
            }
        };

        var breadcrumb = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new List<object>
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = baseUrl },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "آکادمی", ["item"] = $"{baseUrl}/academy" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = article.Title }
            }
        };

        return JsonSerializer.Serialize(new object[] { articleSchema, breadcrumb });
    }

    private void ProcessArticleContent()
    {
        _headingCounter = 0;
        _processedContent.Clear();
        tocItems.Clear();

        if (article?.Blocks == null) return;

        foreach (var block in article.Blocks.OrderBy(x => x.SortOrder))
        {
            if (block.BlockType == TrainingBlockTypeDto.Text && !string.IsNullOrEmpty(block.Content))
            {
                var processed = System.Text.RegularExpressions.Regex.Replace(block.Content,
                    @"<(h[23])([^>]*)>(.*?)</\1>",
                    match =>
                    {
                        var tag = match.Groups[1].Value;
                        var attrs = match.Groups[2].Value;
                        var oldContent = match.Groups[3].Value;

                        // Extract text for TOC
                        var title = System.Text.RegularExpressions.Regex.Replace(oldContent, @"<.*?>", "");
                        title = System.Text.RegularExpressions.Regex.Replace(title, @"&nbsp;|&zwnj;|&zwj;", " ").Trim();
                        if (!string.IsNullOrEmpty(title))
                        {
                            tocItems.Add(new TocItem
                            {
                                Id = $"toc-{_headingCounter}",
                                Title = title,
                                Level = tag.Equals("h3", System.StringComparison.OrdinalIgnoreCase) ? 3 : 2
                            });
                        }

                        // Inject id attribute if not already present
                        if (attrs.Contains(" id=", System.StringComparison.OrdinalIgnoreCase))
                            return match.Value;

                        var id = $"toc-{_headingCounter++}";
                        return $"<{tag} id=\"{id}\"{attrs}>{oldContent}</{tag}>";
                    });

                _processedContent[block.Id] = processed;
            }
        }
    }

    private int CalculateReadingTime()
    {
        var wordCount = 0;
        foreach (var block in article?.Blocks ?? new())
        {
            if (block.BlockType == TrainingBlockTypeDto.Text && !string.IsNullOrEmpty(block.Content))
            {
                var cleaned = System.Text.RegularExpressions.Regex.Replace(block.Content, @"<.*?>", " ");
                wordCount += cleaned.Split(new[] { ' ', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries).Length;
            }
        }
        return Math.Max(1, (int)Math.Ceiling(wordCount / 180.0));
    }

    private async Task HandleAcademyCommentSubmit(CommentRequest req)
    {
        var tacReq = new TrainingArticleCommentRequest
        {
            FullName = req.FullName ?? "",
            Email = req.Email,
            Content = req.Content ?? "",
            Rating = req.Rating,
            ParentId = req.ParentId
        };
        var articleId = ArticleId ?? article?.Id ?? 0;
        if (articleId <= 0)
            throw new InvalidOperationException("مقاله یافت نشد. صفحه را تازه‌سازی کنید و دوباره تلاش کنید.");

        HttpResponseMessage response;
        try
        {
            response = await HttpApi.PostAsJsonAsync($"api/trainingarticles/{articleId}/comments", tacReq);
        }
        catch (Exception ex)
        {
            throw new InvalidOperationException(string.IsNullOrWhiteSpace(ex.Message)
                ? "خطا در ارتباط با سرور"
                : ex.Message, ex);
        }

        if (!response.IsSuccessStatusCode)
        {
            var body = await response.Content.ReadAsStringAsync();
            string? serverMsg = null;
            if (!string.IsNullOrWhiteSpace(body))
            {
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(body);
                    if (doc.RootElement.ValueKind == System.Text.Json.JsonValueKind.String)
                        serverMsg = doc.RootElement.GetString();
                    else if (doc.RootElement.TryGetProperty("title", out var t))
                        serverMsg = t.GetString();
                    else if (doc.RootElement.TryGetProperty("detail", out var d))
                        serverMsg = d.GetString();
                    else if (doc.RootElement.TryGetProperty("message", out var m))
                        serverMsg = m.GetString();
                    else if (doc.RootElement.TryGetProperty("errors", out var errs)
                             && errs.ValueKind == System.Text.Json.JsonValueKind.Object)
                    {
                        var parts = new List<string>();
                        foreach (var prop in errs.EnumerateObject())
                        {
                            if (prop.Value.ValueKind == System.Text.Json.JsonValueKind.Array)
                            {
                                foreach (var item in prop.Value.EnumerateArray())
                                {
                                    var s = item.GetString();
                                    if (!string.IsNullOrWhiteSpace(s)) parts.Add(s);
                                }
                            }
                        }
                        if (parts.Count > 0) serverMsg = string.Join(" | ", parts);
                    }
                }
                catch { /* ignore parse errors */ }
            }

            if (string.IsNullOrWhiteSpace(serverMsg))
            {
                serverMsg = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.BadRequest => "اطلاعات ارسالی نامعتبر است",
                    System.Net.HttpStatusCode.NotFound => "مقاله یا نظر والد یافت نشد",
                    System.Net.HttpStatusCode.Unauthorized => "برای ثبت نظر وارد شوید",
                    System.Net.HttpStatusCode.TooManyRequests => "تعداد درخواست‌ها زیاد است. کمی صبر کنید",
                    _ => $"خطا در ثبت نظر ({(int)response.StatusCode})"
                };
            }
            throw new InvalidOperationException(serverMsg);
        }

        try
        {
            var fresh = await HttpApi.GetFromJsonAsync<TrainingArticleDto>($"api/trainingarticles/{articleId}?onlyApprovedComments=true");
            if (fresh != null)
            {
                article!.Comments = fresh.Comments;
                _academyCommentDtos = ConvertComments(fresh.Comments);
                StateHasChanged();
            }
        }
        catch
        {
            // ثبت موفق بود؛ فقط بازخوانی فهرست نظرات شکست خورد
        }
    }

    private static List<CommentDto> ConvertComments(List<TrainingArticleCommentDto> source)
    {
        return source.Select(c => new CommentDto
        {
            Id = c.Id,
            ParentId = c.ParentId,
            FullName = c.FullName,
            Content = c.Content,
            Rating = c.Rating,
            CreatedAtFa = c.CreatedAtFa,
            Replies = c.Replies != null ? ConvertComments(c.Replies) : new()
        }).ToList();
    }

    private void OpenImageLightbox(string url)
    {
        lightboxImageUrl = url;
        showImageLightbox = true;
    }

    [JSInvokable]
    public void CloseImageLightbox()
    {
        showImageLightbox = false;
        lightboxImageUrl = null;
    }

    private string GetShareText()
    {
        if (article == null) return Nav.Uri;
        var summary = string.IsNullOrEmpty(article.Summary) ? "" : $"\n{TruncateText(article.Summary, 100)}";
        return $"📖 {article.Title}{summary}\n🔗 {Nav.Uri}";
    }

    private string GetShareTextForTelegram()
    {
        if (article == null) return "";
        return article.Title;
    }

    private void RemoveOldToast()
    {
        _toastCts?.Cancel();
        toastText = null;
    }

    private void OpenShareModal()
    {
        _showShareModal = true;
    }

    private void CloseShareModal()
    {
        _showShareModal = false;
    }

    private static string GetVideoMime(string? url)
    {
        if (string.IsNullOrEmpty(url)) return "video/mp4";
        var ext = System.IO.Path.GetExtension(url).ToLower();
        return ext switch
        {
            ".m3u8" => "application/vnd.apple.mpegurl",
            ".ts" => "video/mp2t",
            ".webm" => "video/webm",
            ".ogg" => "video/ogg",
            _ => "video/mp4"
        };
    }

    private static string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength) return text ?? "";
        return text.Substring(0, maxLength - 3) + "...";
    }

    private void ToggleMobileToc()
    {
        mobileTocOpen = !mobileTocOpen;
    }

    private static string GetBlockTypeName(TrainingBlockTypeDto type) => type switch
    {
        TrainingBlockTypeDto.Text => "متن",
        TrainingBlockTypeDto.Image => "تصویر",
        TrainingBlockTypeDto.Video => "ویدیو",
        TrainingBlockTypeDto.Audio => "صوت",
        TrainingBlockTypeDto.File => "فایل",
        TrainingBlockTypeDto.Embed => "کد Embed",
        _ => ""
    };

    private static List<BlockGroup> BuildBlockGroups(IEnumerable<TrainingArticleBlockDto> blocks)
    {
        var groups = new List<BlockGroup>();
        foreach (var block in blocks.OrderBy(x => x.SortOrder))
        {
            if (block.BlockType == TrainingBlockTypeDto.Text
                || groups.Count == 0
                || groups[^1].Type != block.BlockType)
            {
                groups.Add(new BlockGroup
                {
                    Type = block.BlockType,
                    Blocks = new List<TrainingArticleBlockDto> { block }
                });
            }
            else
            {
                groups[^1].Blocks.Add(block);
            }
        }
        return groups;
    }

    private sealed class BlockGroup
    {
        public TrainingBlockTypeDto Type { get; set; }
        public List<TrainingArticleBlockDto> Blocks { get; set; } = new();
        public int Key => Blocks.Count > 0 ? Blocks[0].Id : 0;
    }

    public void Dispose()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        if (_scrollHandlerRef != null)
        {
            _ = JS.InvokeVoidAsync("__articleRemoveScrollHandler", _scrollHandlerRef);
        }
        if (_lightboxKeyHandler != null)
        {
            _ = JS.InvokeVoidAsync("__removeLightboxKeyboard", _lightboxKeyHandler);
        }
    }

    private class TocItem
    {
        public string Id { get; set; } = "";
        public string Title { get; set; } = "";
        public int Level { get; set; }
    }
}
