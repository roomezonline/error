    private async Task Submit()
    {
        if (isSubmitting) return;
        if (!CanWorkOnWorkshop)
        {
            ToastService.ShowWarning("ابتدا کارگاه را انتخاب کنید");
            return;
        }

        if (selectedCustomer == null)
        {
            ToastService.ShowError("مشتری انتخاب نشده است");
            return;
        }

        if (deviceTypeId <= 0)
        {
            ToastService.ShowError("نوع دستگاه انتخاب نشده است");
            return;
        }

        if (string.IsNullOrWhiteSpace(problemDescription) || problemDescription.Trim().Length < 5)
        {
            ToastService.ShowError("توضیحات مشکل کافی نیست");
            return;
        }

        isSubmitting = true;
        try
        {
            DateTimeOffset registeredAtDate;
            try
            {
                if (string.IsNullOrWhiteSpace(registeredAtPersian)) throw new Exception();
                var parts = registeredAtPersian.Split('/');
                if (parts.Length != 3) throw new Exception();

                var jy = int.Parse(parts[0]);
                var jm = int.Parse(parts[1]);
                var jd = int.Parse(parts[2]);
                registeredAtDate = PersianDateHelper.FromPersianDate(jy, jm, jd);
            }
            catch
            {
                ToastService.ShowError("تاریخ ثبت نامعتبر است");
                return;
            }

            // Auto-capture current time
            var now = DateTimeOffset.Now;
            var registeredAt = new DateTimeOffset(
                registeredAtDate.Year, registeredAtDate.Month, registeredAtDate.Day,
                now.Hour, now.Minute, now.Second, now.Offset);

            var content = new MultipartFormDataContent();
            content.Add(new StringContent(selectedCustomer.Id.ToString()), "customerId");
            content.Add(new StringContent(deviceTypeId.ToString()), "deviceTypeId");
            if (deviceBrandId.HasValue)
                content.Add(new StringContent(deviceBrandId.Value.ToString()), "deviceBrandId");
            content.Add(new StringContent(problemDescription.Trim()), "problemDescription");
            content.Add(new StringContent(status), "status");
            if (technicianId.HasValue)
                content.Add(new StringContent(technicianId.Value.ToString()), "technicianId");
            content.Add(new StringContent(registeredAt.ToString("O")), "registeredAt");

            if (!string.IsNullOrWhiteSpace(previewUrl))
            {
                content.Add(new StringContent(previewUrl), "receiptImageUrl");
            }

            var qs = WorkshopQs();
            var resp = await Http.PostAsync($"api/customer-receipts{qs}", content);
            if (!resp.IsSuccessStatusCode)
            {
                if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    ToastService.ShowError("شما دسترسی لازم برای ثبت رسید را ندارید. لطفاً از مدیر سیستم بخواهید دسترسی شما را بررسی کند.");
                    return;
                }
                
                if (resp.StatusCode == System.Net.HttpStatusCode.InternalServerError)
                {
                    var serverMsg = await resp.Content.ReadAsStringAsync();
                    var errorMsg = string.IsNullOrWhiteSpace(serverMsg) 
                        ? "خطای داخلی سرور. لطفاً با پشتیبانی تماس بگیرید." 
                        : "خطای سرور: " + serverMsg.Trim('"');
                    ToastService.ShowError(errorMsg);
                    return;
                }
                
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(msg) ? "خطا در ثبت رسید" : msg.Trim('"'));
                return;
            }

            createdReceipt = await resp.Content.ReadFromJsonAsync<CustomerReceiptDto>();
            if (createdReceipt != null)
            {
                var smsAllowed = false;
                if (createdReceipt.WorkshopId > 0)
                {
                    try
                    {
                        var moduleResp = await Http.GetAsync($"api/workshop-sms/module-status?workshopId={createdReceipt.WorkshopId}&moduleType=1");
                        if (moduleResp.IsSuccessStatusCode)
                            smsAllowed = await moduleResp.Content.ReadFromJsonAsync<bool>();
                    }
                    catch { }
                }
                if (smsAllowed)
                {
                    var customerName = $"{createdReceipt.CustomerFirstName} {createdReceipt.CustomerLastName}";
                    var date = PersianDateHelper.ToPersianDateTimeString(createdReceipt.RegisteredAt, false);
                    smsPreviewText = $"\u200Fمشتری گرامی\n{customerName}\nدستگاه {createdReceipt.DeviceTypeName} ({createdReceipt.DeviceBrandName ?? ""}) در تاریخ {date} در {createdReceipt.WorkshopName}\nبا موفقیت ثبت گردید.\nشماره پذیرش: {createdReceipt.Id}\nمجموعه فنی و مهندسی ارور سرویس";
                    smsSent = false;
                    showSmsModal = true;
                }
                else
                {
                    ToastService.ShowSuccess("رسید با موفقیت ثبت شد");
                    NavToList();
                }
            }
            else
            {
                ToastService.ShowSuccess("رسید با موفقیت ثبت شد");
                NavToList();
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            ToastService.ShowError("شما دسترسی لازم برای ثبت رسید را ندارید. لطفاً از مدیر سیستم بخواهید دسترسی شما را بررسی کند.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا در ارتباط با سرور: {ex.Message}");
        }
        finally
        {
            isSubmitting = false;
        }
    }

