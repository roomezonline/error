        catch (Exception ex)
        {
            allDeviceBrands = new List<DeviceBrandDto>();
        }
    }

    private void EditDeviceBrand(DeviceBrandDto db)
    {
        isEditingDeviceBrand = true;
        editingDeviceBrandId = db.Id;
        newDeviceBrand = new DeviceBrandUpsertRequest { Name = db.Name, DeviceTypeId = db.DeviceTypeId, SortOrder = db.SortOrder };
    }

    private async Task DeleteDeviceBrand(int id)
    {
        if (!CanWorkOnWorkshop)
        {
            ToastService.ShowWarning("ابتدا کارگاه را انتخاب کنید");
            return;
        }

        deviceBrandIdToDelete = id;
        showDeleteDeviceBrandConfirm = true;
    }

    private async Task HandleDeleteDeviceBrandConfirm(bool confirmed)
    {
        showDeleteDeviceBrandConfirm = false;
        if (!confirmed || deviceBrandIdToDelete == null) return;

        try
        {
            var resp = await Http.DeleteAsync($"api/device-brands/{deviceBrandIdToDelete}");

            if (!resp.IsSuccessStatusCode)
            {
                if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    ToastService.ShowError("شما دسترسی لازم برای حذف برند را ندارید.");
                    return;
                }

                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(msg) ? "خطا در حذف برند" : msg.Trim('"'));
                return;
            }

            ToastService.ShowSuccess("برند با موفقیت حذف شد");
            await LoadAllDeviceBrands();
            await LoadBrandsForType();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            ToastService.ShowError("شما دسترسی لازم برای حذف برند را ندارید.");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا در حذف برند: {ex.Message}");
        }
    }

    private void ResetDeviceBrandForm()
    {
        isEditingDeviceBrand = false;
        editingDeviceBrandId = null;
        newDeviceBrand = new DeviceBrandUpsertRequest();
    }

    public void Dispose()
    {
        if (isSuperAdmin)
            AdminWorkshopSelection.OnChanged -= HandleWorkshopChanged;
    }
}
