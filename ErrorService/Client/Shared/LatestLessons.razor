@using ErrorService.Shared
@using System.Net.Http.Json
@inject IJSRuntime JS

@if (settings != null && settings.ShowLatestAcademy)
{
    @if (items == null)
    {
        <section class="academy-section py-5 position-relative" dir="rtl">
            <div class="container-fluid px-3 px-md-4">
                <div class="d-flex gap-3 overflow-hidden px-2">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="academy-item-skeleton rounded-4 bg-white p-3 shadow-sm" style="flex: 0 0 320px;">
                            <div class="skeleton-thumb rounded-3 mb-3"></div>
                            <div class="skeleton-line mb-2"></div>
                            <div class="skeleton-line w-50"></div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (items.Any())
    {
        <section class="academy-section py-5 position-relative" dir="rtl">
            <div class="container-fluid px-3 px-md-4">
                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 px-2 gap-3 gap-sm-0">
                    <div class="text-end">
                        <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 mb-2 fw-bold">آکادمی آموزش</span>
                        <h2 class="fw-black h4 h3-sm mb-0">جدیدترین دوره‌ها و مقالات</h2>
                    </div>
                    <div class="d-flex align-items-center gap-2 align-self-start">
                        <a href="/academy" class="btn btn-outline-primary rounded-pill px-4 btn-sm">مشاهده آکادمی</a>
                        <CarouselControls TrackId="latest-lessons-track" />
                    </div>
                </div>

                <div class="academy-scroll-container" id="latest-lessons-track" @ref="scrollContainer">
                    @foreach (var item in items)
                    {
                        <div class="academy-scroll-item">
                            <a href="@(item.IsCourse ? SeoUrl.Course(item.Id, item.Slug) : SeoUrl.Article(item.Id, item.Slug))" class="text-decoration-none">
                                <div class="academy-card rounded-4 overflow-hidden h-100 shadow-sm border-0">
                                    <div class="academy-card__thumb position-relative">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder-academy.svg" : ImageUrlHelper.Thumb(item.ImageUrl, 400))"
                                             srcset="@ImageUrlHelper.SrcSet(item.ImageUrl)"
                                             sizes="(max-width: 576px) 70vw, 260px"
                                             loading="lazy" decoding="async" alt="@(string.IsNullOrWhiteSpace(item.Title) ? "Technical lesson" : item.Title)" />
                                        <div class="academy-card__badge @(item.IsCourse ? "academy-card__badge--course" : "academy-card__badge--article")">
                                            <span class="oi @(item.IsCourse ? "oi-layers" : "oi-document") me-1"></span>
                                            @(item.IsCourse ? "دوره آموزشی" : "آموزش تکی")
                                        </div>
                                    </div>
                                    <div class="academy-card__content p-4">
                                        <h3 class="academy-card__title h6 fw-bold text-dark mb-3">@item.Title</h3>
                                        <div class="academy-card__desc text-muted small line-clamp-2">@item.Summary</div>
                                        <div class="academy-card__footer mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                                            <div class="text-primary small fw-bold">مشاهده محتوا</div>
                                            <span class="oi oi-arrow-left text-primary small"></span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}


@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ErrorService.Client.Services.SiteSettingsService SettingsService { get; set; } = default!;
    private List<AcademyUnifiedDto>? items;
    private SiteSettingsDto? settings;
    private ElementReference scrollContainer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            settings = await SettingsService.GetAsync();
            if (settings != null && !settings.ShowLatestAcademy) return;

            var courses = await Http.GetFromJsonAsync<List<TrainingCourseDto>>("api/trainings/courses?onlyPublished=true");
            var articles = await Http.GetFromJsonAsync<List<TrainingArticleDto>>("api/trainingarticles?onlyPublished=true");

            var list = new List<AcademyUnifiedDto>();
            
            if (courses != null)
            {
                list.AddRange(courses.Select(c => new AcademyUnifiedDto 
                { 
                    Id = c.Id, 
                    Title = c.Title, 
                    Slug = c.Slug, 
                    Summary = c.Summary, 
                    ImageUrl = c.CoverImageUrl,
                    CreatedAt = c.CreatedAt,
                    IsCourse = true 
                }));
            }

            if (articles != null)
            {
                list.AddRange(articles.Select(a => new AcademyUnifiedDto 
                { 
                    Id = a.Id, 
                    Title = a.Title, 
                    Slug = a.Slug, 
                    Summary = a.Summary, 
                    ImageUrl = a.CoverImageUrl,
                    CreatedAt = a.CreatedAt,
                    IsCourse = false 
                }));
            }

            items = list.OrderByDescending(x => x.CreatedAt).Take(8).ToList();
        }
        catch { items = new(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && items != null && items.Any())
        {
            await JS.InvokeVoidAsync("initDragScroll", scrollContainer);
        }
    }

    public class AcademyUnifiedDto
    {
        public int Id { get; set; }
        public string? Slug { get; set; }
        public string Title { get; set; } = "";
        public string? Summary { get; set; }
        public string? ImageUrl { get; set; }
        public DateTimeOffset CreatedAt { get; set; }
        public bool IsCourse { get; set; }
    }
}
