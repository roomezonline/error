    private async Task UploadCsvAndViewChart(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _csvUploading = true;
        _csvUploadError = null;

        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 50_000_000).CopyToAsync(ms);
            ms.Position = 0;

            using var content = new MultipartFormDataContent();
            content.Add(new ByteArrayContent(ms.ToArray()), "file", file.Name);

            var resp = await Http.PostAsync($"api/monitoring-receipts/upload-csv?connectionId={Id}", content);
            var body = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
            {
                try
                {
                    var diag = System.Text.Json.JsonSerializer.Deserialize<CsvDiagnosticInfo>(body, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (diag != null && !string.IsNullOrEmpty(diag.Error))
                    {
                        _csvDiagnostics = diag;
                        _csvUploadError = diag.Error;
                        return;
                    }
                }
                catch { }
                var err = string.IsNullOrWhiteSpace(body) ? "خطا در آپلود فایل" : body.Trim('"');
                _csvUploadError = err;
                return;
            }

            var result = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(body);
            _csvKey = result.GetProperty("csvKey").GetString();

            // Navigate to chart1 with csvKey
            var baseUri = (_chartBaseUrl ?? Navigation.BaseUri.TrimEnd('/'));
            await JS.InvokeVoidAsync("open", $"{baseUri}/chart1.aspx?csvKey={_csvKey}", "_blank");
            _showCsvUpload = false;
        }
        catch (Exception ex)
        {
            _csvUploadError = $"خطا: {ex.Message}";
        }
        finally
        {
            _csvUploading = false;
        }
    }

