@code {
    private int step = 1;
    private ElementReference admissionCard;
    private ElementReference submitButton;
    private bool isLoading = true;
    private bool isUploading;
    private bool isDeviceUploading;
    private bool isSubmitting;

    private OnlineAdmissionCreateRequest request = new() { Type = OnlineAdmissionTypes.Expertise };
    private AdmissionExpertiseSettingsDto? settings;
    private List<DeviceTypeDto>? deviceTypes;
    private List<DeviceBrandDto>? deviceBrands;
    private List<ProvinceDto>? provinces;
    private List<CityDto>? cities;

    private string[] otpDigits = new string[6];
    private int otpTimerSeconds = 120;
    private System.Timers.Timer? otpTimer;
    private string otpStatusClass = "";
    private string otpStatusMessage = "";
    private bool isOtpVerified = false;
    private int otpErrorVersion = 0;
    [Inject] private IJSRuntime JSRuntime { get; set; } = default!;

    private void StartOtpTimer()
    {
        otpTimer?.Stop();
        otpTimer?.Dispose();
        otpTimerSeconds = 120;
        otpStatusClass = "";
        otpStatusMessage = "";
        isOtpVerified = false;
        otpDigits = new string[6];
        otpTimer = new System.Timers.Timer(1000);
        otpTimer.Elapsed += (s, e) =>
        {
            if (otpTimerSeconds > 0)
            {
                otpTimerSeconds--;
                InvokeAsync(StateHasChanged);
            }
            else
            {
                otpTimer?.Stop();
            }
        };
        otpTimer.AutoReset = true;
        otpTimer.Start();
    }

    private string FormatTime(int seconds)
    {
        var mins = seconds / 60;
        var secs = seconds % 60;
        return $"{mins:D2}:{secs:D2}";
    }

    private async Task ResendOtp()
    {
        try
        {
            var result = await Http.PostAsJsonAsync("api/online-admission/send-otp", new { mobile = request.CustomerMobile });
            var data = await result.Content.ReadFromJsonAsync<OtpResultDto>();
            if (data?.Success == true)
            {
                StartOtpTimer();
                ToastService.ShowSuccess("کد تایید جدید ارسال شد");
            }
            else
            {
                ToastService.ShowError(data?.Message ?? "خطا در ارسال کد تایید");
            }
        }
        catch
        {
            ToastService.ShowError("سرویس پیامک بصورت موقت غیرفعال شده است. لطفاً بعداً تلاش کنید یا با پشتیبانی تماس بگیرید.");
        }
    }

    private async Task HandleOtpInput(ChangeEventArgs e, int index)
    {
        var value = e.Value?.ToString();
        if (string.IsNullOrEmpty(value))
        {
            otpDigits[index] = "";
            request.VerificationCode = string.Join("", otpDigits);
            return;
        }

        if (!isOtpVerified && (otpStatusClass == "error" || otpStatusClass == "success"))
        {
            otpStatusClass = "";
            otpStatusMessage = "";
        }

        otpDigits[index] = value.Last().ToString();
        request.VerificationCode = string.Join("", otpDigits);

        if (index < 5)
        {
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('otp-{index + 1}').focus()");
        }
        else
        {
            // Last digit entered, auto-verify
            await VerifyOtpAsync();
        }
    }

    private async Task VerifyOtpAsync()
    {
        if (otpDigits.All(d => !string.IsNullOrEmpty(d)))
        {
            try
            {
                var result = await Http.PostAsJsonAsync("api/online-admission/verify-otp", new { mobile = request.CustomerMobile, code = request.VerificationCode });
                var data = await result.Content.ReadFromJsonAsync<OtpResultDto>();
                if (data?.Success == true)
                {
                    otpErrorVersion++;
                    otpStatusClass = "success";
                    otpStatusMessage = "کد صحیح است";
                    isOtpVerified = true;
                    await ScrollToSubmitButtonAsync();
                }
                else
                {
                    var myVersion = ++otpErrorVersion;
                    otpStatusClass = "error";
                    otpStatusMessage = "کد اشتباه است";
                    otpDigits = new string[6];
                    request.VerificationCode = "";
                    await ClearOtpDomAsync();
                    await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('otp-0').focus()");
                    await InvokeAsync(StateHasChanged);

                    await Task.Delay(4000);
                    if (otpErrorVersion == myVersion && !isOtpVerified && otpStatusClass == "error")
                    {
                        otpStatusClass = "";
                        otpStatusMessage = "";
                        await InvokeAsync(StateHasChanged);
                    }
                }
            }
            catch
            {
                var myVersion = ++otpErrorVersion;
                otpStatusClass = "error";
                otpStatusMessage = "خطا در ارتباط با سرور";
                await InvokeAsync(StateHasChanged);
                await Task.Delay(4000);
                if (otpErrorVersion == myVersion && !isOtpVerified && otpStatusClass == "error")
                {
                    otpStatusClass = "";
                    otpStatusMessage = "";
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
    }

    private async Task HandleOtpKeyDown(KeyboardEventArgs e, int index)
    {
        if (e.Key != "Backspace" || isOtpVerified) return;

        if (otpStatusClass == "error" || otpStatusClass == "success")
        {
            otpErrorVersion++;
            otpStatusClass = "";
            otpStatusMessage = "";
        }

        // If current cell has a digit, clear it.
        if (!string.IsNullOrEmpty(otpDigits[index]))
        {
            otpDigits[index] = "";
            request.VerificationCode = string.Join("", otpDigits);
            await JSRuntime.InvokeVoidAsync("eval", $"var el=document.getElementById('otp-{index}'); if(el) el.value='';");
            await InvokeAsync(StateHasChanged);
            return;
        }

        // If current cell is empty, move to previous and clear it.
        if (index > 0)
        {
            otpDigits[index - 1] = "";
            request.VerificationCode = string.Join("", otpDigits);
            await JSRuntime.InvokeVoidAsync("eval", $"var el=document.getElementById('otp-{index - 1}'); if(el) el.value='';");
            await JSRuntime.InvokeVoidAsync("eval", $"document.getElementById('otp-{index - 1}').focus()");
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ClearOtpDomAsync()
    {
        await JSRuntime.InvokeVoidAsync(
            "eval",
            "for(let i=0;i<6;i++){ const el=document.getElementById('otp-'+i); if(el) el.value=''; }"
        );
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadInitialData();
        await PreFillUserInfo();
        isLoading = false;
    }

    private async Task LoadInitialData()
    {
        try
        {
            // Load settings (amounts, accounts)
            settings = await Http.GetFromJsonAsync<AdmissionExpertiseSettingsDto>("api/online-admission/settings");
            
            // Load device types from Workshop 1
            deviceTypes = await Http.GetFromJsonAsync<List<DeviceTypeDto>>("api/device-types");

            provinces = await Http.GetFromJsonAsync<List<ProvinceDto>>("api/locations/provinces");
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            // Even if it fails, we don't want to show error to user if they are not logged in but it should work with workshopId=1
            // Error was likely due to authentication requirements on some endpoints or missing WorkshopId
        }
    }

    private async Task PreFillUserInfo()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            request.CustomerFullName = authState.User.Identity.Name ?? "";
            request.CustomerMobile = authState.User.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value 
                                    ?? authState.User.FindFirst("phone")?.Value ?? "";
        }
    }

    private async Task OnDeviceTypeChanged()
    {
        deviceBrands = null;
        request.DeviceBrandId = null;
        if (request.DeviceTypeId > 0)
        {
            deviceBrands = await Http.GetFromJsonAsync<List<DeviceBrandDto>>($"api/device-brands?deviceTypeId={request.DeviceTypeId}");
        }
    }

    private async Task OnProvinceChanged(int provinceId)
    {
        request.ProvinceId = provinceId;
        request.CityId = 0;
        cities = null;
        if (provinceId > 0)
        {
            cities = await Http.GetFromJsonAsync<List<CityDto>>($"api/locations/cities/{provinceId}");
        }
    }

    private void OnCityChanged(int cityId)
    {
        request.CityId = cityId;
    }

    private void HandleNext()
    {
        bool isValid = false;
        if (step == 1)
        {
            isValid = request.ProvinceId > 0 && request.CityId > 0 && request.DeviceTypeId > 0;
            if (!isValid)
            {
                if (request.ProvinceId <= 0)
                    ToastService.ShowWarning("لطفاً استان خود را انتخاب کنید");
                else if (request.CityId <= 0)
                    ToastService.ShowWarning("لطفاً شهر خود را انتخاب کنید");
                else
                    ToastService.ShowWarning("لطفاً نوع دستگاه را انتخاب کنید");
                return;
            }
        }
        else if (step == 2)
        {
            isValid = !string.IsNullOrWhiteSpace(request.ProblemDescription);
            if (!isValid)
            {
                ToastService.ShowWarning("لطفاً شرح مشکل را وارد کنید");
                return;
            }
        }
        else if (step == 3)
        {
            isValid = !string.IsNullOrWhiteSpace(request.CustomerFullName) && 
                      request.CustomerFullName.Length >= 3 &&
                      !string.IsNullOrWhiteSpace(request.CustomerMobile) &&
                      System.Text.RegularExpressions.Regex.IsMatch(request.CustomerMobile, @"^09\d{9}$") &&
                      !string.IsNullOrWhiteSpace(request.CustomerAddress) &&
                      request.CustomerAddress.Length >= 10;

            if (!isValid)
            {
                if (string.IsNullOrWhiteSpace(request.CustomerFullName) || request.CustomerFullName.Length < 3)
                    ToastService.ShowWarning("نام معتبر نیست (حداقل ۳ حرف)");
                else if (string.IsNullOrWhiteSpace(request.CustomerMobile) || !System.Text.RegularExpressions.Regex.IsMatch(request.CustomerMobile, @"^09\d{9}$"))
                    ToastService.ShowWarning("شماره موبایل معتبر نیست (۱۱ رقم با ۰۹)");
                else if (string.IsNullOrWhiteSpace(request.CustomerAddress) || request.CustomerAddress.Length < 10)
                    ToastService.ShowWarning("آدرس معتبر نیست (حداقل ۱۰ حرف)");
                return;
            }
        }
        else if (step == 4)
        {
            isValid = !string.IsNullOrEmpty(request.ReceiptImageUrl);
            if (!isValid)
            {
                ToastService.ShowWarning("لطفاً تصویر رسید را آپلود کنید");
                return;
            }
        }

        if (step < 5) {
            step++;
            if (step == 5 && settings?.OtpEnabled != false) _ = ResendOtp();
            // Scroll to top of form after step change
            _ = ScrollToTopAsync();
        }
    }

    private async Task HandlePrev()
    {
        if (step > 1) {
            step--;
            // Scroll to top of form after step change
            await ScrollToTopAsync();
        }
    }

    private async Task HandleDeviceImageUpload(InputFileChangeEventArgs e)
    {
        isDeviceUploading = true;
        try
        {
            var file = e.File;
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JSRuntime);
            using var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "\"file\"", file.Name);

            var resp = await Http.PostAsync("api/online-admission/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                request.DeviceImageUrl = (await resp.Content.ReadAsStringAsync()).Trim('"');
                ToastService.ShowSuccess("تصویر دستگاه آپلود شد");
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("خطا در آپلود تصویر");
        }
        finally { isDeviceUploading = false; }
    }

