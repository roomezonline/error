@if (IsVisible)
{
    <div class="cd-backdrop" @onclick="Cancel">
        <div class="cd-modal" @onclick:stopPropagation>
            <div class="cd-header @(IsDanger ? "cd-header--danger" : "cd-header--success")">
                <div class="cd-icon @(IsDanger ? "cd-icon--danger" : "cd-icon--success")">
                    @if (IsDanger)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 6h18"></path>
                            <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                            <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                    }
                </div>
                <div class="cd-title">@Title</div>
            </div>
            <div class="cd-body">
                <p class="cd-msg">@Message</p>
                @if (Details is not null)
                {
                    <div class="cd-details">
                        @Details
                    </div>
                }
            </div>
            <div class="cd-footer">
                <button type="button" class="cd-btn cd-btn--ghost" @onclick="Cancel">انصراف</button>
                <button type="button" class="cd-btn @(IsDanger ? "cd-btn--danger" : "cd-btn--success")" @onclick="Confirm">
                    @if (IsDanger)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <polyline points="9 11 12 14 22 4"></polyline>
                            <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path>
                        </svg>
                    }
                    @ConfirmText
                </button>
            </div>
        </div>
    </div>
}

<style>
    .cd-backdrop {
        position: fixed; inset: 0; z-index: 3000;
        background: rgba(2,6,23,0.62); backdrop-filter: blur(10px);
        display: grid; place-items: center; padding: 18px;
        animation: cdFadeIn 0.16s ease; direction: rtl;
    }
    .cd-modal {
        width: min(460px, 94vw); border-radius: 30px; overflow: hidden;
        background: #fff; border: 1px solid rgba(2,6,23,0.08);
        box-shadow: 0 40px 90px rgba(0,0,0,0.45);
        transform-origin: 50% 70%;
        animation: cdPop 0.22s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @@keyframes cdPop {
        from { transform: translateY(14px) scale(0.94); opacity: 0; }
        to { transform: translateY(0) scale(1); opacity: 1; }
    }
    @@keyframes cdFadeIn {
        from { opacity: 0; } to { opacity: 1; }
    }

    .cd-header {
        padding: 18px 18px 10px; text-align: center;
        background: radial-gradient(circle at 25% 20%, rgba(244,63,94,0.20), transparent 55%),
                    radial-gradient(circle at 80% 60%, rgba(79,70,229,0.14), transparent 55%),
                    linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,255,255,0.86));
        border-bottom: 1px solid rgba(2,6,23,0.06);
    }
    .cd-header--success {
        background: radial-gradient(circle at 25% 20%, rgba(16,185,129,0.20), transparent 55%),
                    radial-gradient(circle at 80% 60%, rgba(79,70,229,0.14), transparent 55%),
                    linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,255,255,0.86));
    }
    .cd-header--danger {
        background: radial-gradient(circle at 25% 20%, rgba(244,63,94,0.20), transparent 55%),
                    radial-gradient(circle at 80% 60%, rgba(79,70,229,0.14), transparent 55%),
                    linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,255,255,0.86));
    }

    .cd-icon {
        width: 58px; height: 58px; border-radius: 22px;
        display: grid; place-items: center;
        margin: 2px auto 10px; font-size: 1.6rem;
        background: rgba(244,63,94,0.12); color: rgba(190,18,60,1);
        border: 1px solid rgba(244,63,94,0.22);
        box-shadow: 0 16px 34px rgba(244,63,94,0.16);
    }
    .cd-icon svg { width: 28px; height: 28px; }
    .cd-header--success .cd-icon {
        background: rgba(16,185,129,0.12); color: rgba(5,150,105,1);
        border: 1px solid rgba(16,185,129,0.22);
        box-shadow: 0 16px 34px rgba(16,185,129,0.16);
    }
    .cd-header--danger .cd-icon {
        background: rgba(244,63,94,0.12); color: rgba(190,18,60,1);
        border: 1px solid rgba(244,63,94,0.22);
        box-shadow: 0 16px 34px rgba(244,63,94,0.16);
    }

    .cd-title { font-size: 1.15rem; font-weight: 950; color: rgba(15,23,42,1); }

    .cd-body { padding: 14px 18px 16px; color: rgba(71,85,105,1); font-weight: 850; }
    .cd-body p { margin: 0; text-align: center; line-height: 1.8; }

    .cd-details {
        margin-top: 12px; padding: 12px; border-radius: 20px;
        background: rgba(15,23,42,0.03); border: 1px dashed rgba(2,6,23,0.10);
        display: grid; gap: 10px;
    }
    .cd-details ::deep .cd-detail-item {
        display: flex; align-items: center; gap: 10px;
        color: rgba(15,23,42,0.9); font-weight: 900; font-size: 0.86rem;
    }
    .cd-details ::deep .cd-detail-item .oi { color: rgba(100,116,139,1); }

    .cd-footer {
        padding: 14px 18px 18px; display: grid;
        grid-template-columns: 1fr 1fr; gap: 12px;
        border-top: 1px solid rgba(2,6,23,0.06);
        background: rgba(255,255,255,0.88);
    }

    .cd-btn {
        height: 46px; border-radius: 16px; border: 0;
        font-weight: 950; font-size: 0.92rem; cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center;
        gap: 8px; transition: transform 0.18s ease, filter 0.18s ease;
    }
    .cd-btn svg { flex-shrink: 0; }
    .cd-btn--ghost { background: rgba(15,23,42,0.06); color: rgba(51,65,85,1); }
    .cd-btn--danger {
        background: linear-gradient(135deg, rgba(244,63,94,1), rgba(225,29,72,1));
        color: #fff; box-shadow: 0 18px 36px rgba(244,63,94,0.28);
    }
    .cd-btn--success {
        background: linear-gradient(135deg, rgba(16,185,129,1), rgba(5,150,105,1));
        color: #fff; box-shadow: 0 18px 36px rgba(16,185,129,0.28);
    }
    .cd-btn:hover { transform: translateY(-1px); filter: brightness(1.02); }
    .cd-btn:active { transform: translateY(0px) scale(0.99); }

    @@media (max-width: 640px) {
        .cd-backdrop { align-items: flex-end; padding: 0; }
        .cd-modal {
            width: 100%; border-radius: 30px 30px 0 0;
            animation: cdPopMobile 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        @@keyframes cdPopMobile {
            from { transform: translateY(100%); } to { transform: translateY(0); }
        }
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "تایید عملیات";
    [Parameter] public string Message { get; set; } = "آیا از انجام این عملیات اطمینان دارید؟";
    [Parameter] public string ConfirmText { get; set; } = "تایید";
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool IsDanger { get; set; } = true;
    [Parameter] public RenderFragment? Details { get; set; }
    [Parameter] public EventCallback<bool> OnResult { get; set; }

    private async Task Confirm() => await OnResult.InvokeAsync(true);
    private async Task Cancel() => await OnResult.InvokeAsync(false);
}
