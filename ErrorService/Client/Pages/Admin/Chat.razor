    private async Task ConnectHub()
    {
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri("/hubs/chat"), options =>
            {
                options.AccessTokenProvider = async () =>
                {
                    var token = await Auth.GetTokenAsync();
                    _ = JS.InvokeVoidAsync("console.log", "AT provider token:", token?.Substring(0, Math.Min(20, token?.Length ?? 0)) + "..." + " (len=" + (token?.Length ?? 0) + ")");
                    return token;
                };
            })
            .WithAutomaticReconnect()
            .Build();

        _hub.On<ChatMessageDto>("NewMessage", msg =>
        {
            if (_selectedSessionId == msg.SessionId && !_messages.Any(m => m.Id == msg.Id))
            {
                if (_pendingTempIds.TryDequeue(out var tempId))
                    _messages.RemoveAll(m => m.Id == tempId);
                _messages.Add(msg);
                _messages.Sort((a, b) => a.CreatedAt.CompareTo(b.CreatedAt));
                if (msg.SenderType == ChatSenderTypeDto.User)
                    _userTyping = false;
                _ = ScrollToBottom();
                if (msg.SenderType == ChatSenderTypeDto.User)
                    _ = _hub.InvokeAsync("MarkAsRead", msg.SessionId, new List<int> { msg.Id });
            }
            var session = _allSessions.FirstOrDefault(s => s.Id == msg.SessionId);
            if (session != null && _selectedSessionId != msg.SessionId)
            {
                if (msg.SenderType == ChatSenderTypeDto.User || msg.SenderId?.Contains('(') == true)
                {
                    session.HasUnread = true;
                    var isMessenger = msg.SenderType == ChatSenderTypeDto.Operator;
                    _ = PlayNotifyAsync(isMessenger ? "پیام از پیام‌رسان" : "مکالمه جدید",
                        $"{session.UserName ?? ""}: {msg.Content ?? ""}");
                }
            }
            else if (session != null && msg.SenderType == ChatSenderTypeDto.User && _selectedSessionId == msg.SessionId)
            {
                _ = PlayNotifyAsync("پیام جدید", msg.Content ?? "");
            }
            InvokeAsync(StateHasChanged);
        });

        _hub.On<ChatSessionDto>("NewSession", session =>
        {
            if (_allSessions.Any(s => s.Id == session.Id)) return;
            _allSessions.Insert(0, session);
            _newSessionCount++;
            if (_selectedSessionId == 0 || _selectedSessionId != session.Id)
            {
                _ = PlayNotifyAsync("مکالمه جدید", $"کاربر {session.UserName ?? ""} گفتگو را شروع کرد");
            }
            InvokeAsync(StateHasChanged);
        });

        _hub.On<ChatSessionDto>("SessionUpdated", session =>
        {
            var s = _allSessions.FirstOrDefault(x => x.Id == session.Id);
            if (s != null)
            {
                s.OperatorId = session.OperatorId;
                s.OperatorName = session.OperatorName;
            }
            if (_selectedSessionId == session.Id && _selectedSession != null)
            {
                _selectedSession.OperatorId = session.OperatorId;
                _selectedSession.OperatorName = session.OperatorName;
            }
            InvokeAsync(StateHasChanged);
        });

        _hub.On<int>("OperatorRequested", sessionId =>
        {
            _ = PlayNotifyAsync("درخواست اپراتور", "کاربر درخواست گفتگو با اپراتور انسانی دارد");
            _ = LoadSessions();
            InvokeAsync(StateHasChanged);
        });

        _hub.On<ChatMessageDto>("MessageEdited", msg =>
        {
            var existing = _messages.FirstOrDefault(m => m.Id == msg.Id);
            if (existing != null)
            {
                existing.Content = msg.Content;
                existing.EditedAt = msg.EditedAt;
            }
            InvokeAsync(StateHasChanged);
        });

        _hub.On<int, int>("MessageDeleted", (sessionId, messageId) =>
        {
            var existing = _messages.FirstOrDefault(m => m.Id == messageId);
            if (existing != null) existing.IsDeleted = true;
            InvokeAsync(StateHasChanged);
        });

        _hub.On<int, bool>("UserTyping", (sessionId, isTyping) =>
        {
            if (_selectedSessionId == sessionId)
            {
                _userTyping = isTyping;
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.On<int, List<int>>("MessagesRead", (sessionId, messageIds) =>
        {
            if (_selectedSessionId == sessionId)
            {
                foreach (var msg in _messages.Where(m => messageIds.Contains(m.Id)))
                {
                    msg.IsRead = true;
                    msg.Status = ChatMessageStatusDto.Read;
                }
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.On<int>("SessionClosed", sessionId =>
        {
            var s = _allSessions.FirstOrDefault(x => x.Id == sessionId);
            if (s != null) s.Status = ChatSessionStatusDto.Closed;
            if (_selectedSessionId == sessionId && _selectedSession != null)
                _selectedSession.Status = ChatSessionStatusDto.Closed;
            InvokeAsync(StateHasChanged);
        });

        _hub.Reconnecting += _ =>
        {
            _hubStatus = "در حال اتصال مجدد...";
            _pendingTempIds.Clear();
            _messages.RemoveAll(m => m.Id < 0);
            InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };
        _hub.Reconnected += async _ =>
        {
            _hubStatus = "متصل";
            _pendingTempIds.Clear();
            _messages.RemoveAll(m => m.Id < 0);
            await LoadSessions();
            if (_selectedSessionId > 0)
                await _hub.InvokeAsync("JoinSession", _selectedSessionId);
            InvokeAsync(StateHasChanged);
        };
        _hub.Closed += async _ =>
        {
            _hubStatus = "قطع";
            InvokeAsync(StateHasChanged);
            await Task.Delay(5000);
            try
            {
                if (!_disposed && _hub?.State != HubConnectionState.Connected)
                {
                    await _hub.StartAsync();
                    _hubStatus = "متصل";
                    InvokeAsync(StateHasChanged);
                }
            }
            catch { }
        };

        await _hub.StartAsync();
        _hubStatus = _hub.State == HubConnectionState.Connected ? "متصل" : "قطع";
    }

