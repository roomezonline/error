@page "/profile"
@implements IDisposable
@using ErrorService.Shared
@using ErrorService.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ErrorService.Client.Utils
@using ErrorService.Client.Services
@attribute [Authorize]
@inject ErrorService.Client.Services.AuthService Auth
@inject ErrorService.Client.Services.JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject HttpClient Http
@inject ErrorService.Client.Services.ToastService Toast
@inject ErrorService.Client.Services.WishlistService Ws
@inject ErrorService.Client.Services.RecentlyViewedService RecentSvc
@inject ErrorService.Client.Services.CartService Cart
@inject ErrorService.Client.Services.NotificationCenterService Notifs
@inject ErrorService.Client.Services.CheckoutRecoveryService Recovery
@inject IJSRuntime JS

<PageTitle>پروفایل کاربری | ارورسرویس</PageTitle>

<div class="profile-page" dir="rtl">
    <div class="container py-4">
        <div class="row g-4 align-items-start">

            <!-- ═══════════════ SIDEBAR ═══════════════ -->
            <div class="col-lg-3 @(showMobileSidebar ? "show-mobile-sidebar" : "")">
                <div class="pf-sidebar">
                    <!-- Mobile close button -->
                    <button class="pf-sidebar-close d-lg-none" @onclick="() => showMobileSidebar = false">
                        <span class="oi oi-x"></span>
                    </button>

                    <!-- Sidebar Header -->
                    <div class="pf-sidebar-header">
                        <div class="pf-sidebar-avatar">
                            @if (user != null)
                            {
                                @user.FullName[0]
                            }
                        </div>
                        @if (user != null)
                        {
                            <div class="pf-sidebar-name">@user.FullName</div>
                            <div class="pf-sidebar-phone">@user.PhoneNumber</div>
                        }
                        <button class="pf-sidebar-edit" @onclick='() => SwitchTab("edit")'>
                            <span class="oi oi-pencil"></span>
                        </button>
                    </div>

                    <!-- Sidebar Menu -->
                    <div class="pf-sidebar-menu">
                        <button class="pf-menu-item @(activeTab == "overview" ? "active" : "")" @onclick='() => SwitchTab("overview")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-grid-large"></span>
                            </span>
                            <span class="pf-menu-text">پیشخوان</span>
                        </button>

                        <button class="pf-menu-item @(activeTab == "orders" ? "active" : "")" @onclick='() => SwitchTab("orders")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-cart"></span>
                            </span>
                            <span class="pf-menu-text">سفارشات من</span>
                            @if (ActiveOrdersCount > 0)
                            {
                                <span class="pf-menu-badge pf-badge-red">@ActiveOrdersCount</span>
                            }
                        </button>

                        <button class="pf-menu-item @(activeTab == "tickets" ? "active" : "")" @onclick='() => SwitchTab("tickets")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-chat"></span>
                            </span>
                            <span class="pf-menu-text">تیکت‌ها</span>
                @if (UnreadTicketsCount > 0)
                {
                    <span class="pf-menu-badge pf-badge-red">@UnreadTicketsCount</span>
                }
                        </button>

                        <button class="pf-menu-item @(activeTab == "wishlist" ? "active" : "")" @onclick='() => SwitchTab("wishlist")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-heart"></span>
                            </span>
                            <span class="pf-menu-text">علاقمندی‌ها</span>
                        </button>

                        <button class="pf-menu-item @(activeTab == "cart" ? "active" : "")" @onclick='() => SwitchTab("cart")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-basket"></span>
                            </span>
                            <span class="pf-menu-text">سبد خرید</span>
                            @if (Cart.GetTotalCount() > 0)
                            {
                                <span class="pf-menu-badge pf-badge-red">@Cart.GetTotalCount()</span>
                            }
                        </button>

                        <button class="pf-menu-item @(activeTab == "edit" ? "active" : "")" @onclick='() => SwitchTab("edit")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-person"></span>
                            </span>
                            <span class="pf-menu-text">ویرایش پروفایل</span>
                        </button>

                        <button class="pf-menu-item @(activeTab == "password" ? "active" : "")" @onclick='() => SwitchTab("password")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-lock-locked"></span>
                            </span>
                            <span class="pf-menu-text">تغییر رمز عبور</span>
                        </button>

                        <button class="pf-menu-item @(activeTab == "coupons" ? "active" : "")" @onclick='() => SwitchTab("coupons")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-badge"></span>
                            </span>
                            <span class="pf-menu-text">کدهای تخفیف</span>
                            @if (ActiveCouponsCount > 0)
                            {
                                <span class="pf-menu-badge pf-badge-red">@ActiveCouponsCount</span>
                            }
                        </button>

                        <button class="pf-menu-item @(activeTab == "bale" ? "active" : "")" @onclick='() => SwitchTab("bale")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-bell"></span>
                            </span>
                            <span class="pf-menu-text">اتصال به بله</span>
                            @if (baleStatus?.Connected == true)
                            {
                                <span class="pf-menu-badge" style="background:#16a34a; color:#fff;"><span class="oi oi-check" style="font-size:.65rem;"></span></span>
                            }
                        </button>
                    </div>

                    <!-- Logout -->
                    <div class="pf-sidebar-footer">
                        <button class="pf-logout-btn" @onclick="HandleLogout">
                            <span class="oi oi-account-logout"></span>
                            خروج از حساب
                        </button>
                    </div>
                </div>
            </div>

            <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
            <div class="col-lg-9">
                <!-- Mobile top bar -->
                <div class="pf-mobile-topbar d-lg-none">
                    <button class="pf-mobile-menu-btn" @onclick="() => showMobileSidebar = true">
                        <span class="oi oi-menu"></span>
                    </button>
                    <div class="pf-mobile-title">پنل کاربری</div>
                    <button class="pf-mobile-avatar" @onclick='() => SwitchTab("edit")'>
                        @if (user != null) { @user.FullName[0] }
                    </button>
                </div>

                <div class="pf-content-card">

                    @if (user == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-danger"></div>
                        </div>
                    }
                    else
                    {
                        <!-- Unfinished order / abandoned cart resume -->
                        @if (Recovery.Resume.Order is { } uo)
                        {
                            <div class="resume-banner resume-banner--card animate__animated animate__fadeInDown">
                                <span class="resume-banner__icon" aria-hidden="true">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 9v4"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z"/></svg>
                                </span>
                                <span class="resume-banner__text">
                                    <strong class="resume-banner__title">سفارش شما هنوز تکمیل نشده است</strong>
                                    <span class="resume-banner__sub">
                                        سفارش <span dir="ltr">@uo.OrderNumber</span>
                                        · @uo.TotalAmount.ToString("N0") تومان
                                        · @uo.StatusLabel
                                    </span>
                                </span>
                                @if (uo.NeedsPayment && uo.MinutesToAutoCancel > 0)
                                {
                                    <span class="resume-banner__timer">
                                        <span class="oi oi-clock"></span>
                                        تا لغو خودکار @uo.MinutesToAutoCancel دقیقه
                                    </span>
                                }
                                <a class="resume-banner__cta" href="@uo.ResumeUrl">
                                    @(uo.NeedsPayment ? "پرداخت و ادامه سفارش" : "مشاهده سفارش")
                                    <span class="oi oi-arrow-left"></span>
                                </a>
                            </div>
                        }
                        else if (Recovery.Resume.HasAbandonedCart || Cart.GetTotalCount() > 0)
                        {
                            var _rc = Cart.GetTotalCount();
                            if (_rc > 0)
                            {
                                <div class="resume-banner resume-banner--card animate__animated animate__fadeInDown">
                                    <span class="resume-banner__icon" aria-hidden="true">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    </span>
                                    <span class="resume-banner__text">
                                        <strong class="resume-banner__title">@_rc کالا در سبد خرید شما مانده است</strong>
                                        <span class="resume-banner__sub">اطلاعات تکمیل سفارش ذخیره شده؛ از همان‌جا ادامه دهید.</span>
                                    </span>
                                    <a class="resume-banner__cta" href="/checkout">
                                        ادامه خرید
                                        <span class="oi oi-arrow-left"></span>
                                    </a>
                                </div>
                            }
                        }

                        <!-- Bale connect banner -->
                        @if (!hideBaleBanner && activeTab != "bale" && baleStatus != null && !baleStatus.Connected && baleStatus.BotConfigured)
                        {
                            <div class="pf-bale-banner animate__animated animate__fadeInDown">
                                <div class="pf-bale-banner__icon">
                                    <span class="oi oi-bell"></span>
                                </div>
                                <div class="pf-bale-banner__text">
                                    <div class="pf-bale-banner__title">به ربات بله متصل نشده‌اید</div>
                                    <div class="pf-bale-banner__sub">با اتصال، اعلان‌های مهم سایت (وضعیت سفارش، پیام مدیران و…) را فوراً در بله دریافت کنید.</div>
                                </div>
                                <button type="button" class="pf-bale-banner__close" title="بستن" @onclick="() => hideBaleBanner = true">
                                    <span class="oi oi-x"></span>
                                </button>
                                <button type="button" class="pf-bale-banner__cta" @onclick='() => SwitchTab("bale")'>
                                    اتصال به بله
                                    <span class="oi oi-arrow-left"></span>
                                </button>
                            </div>
                        }

                        <!-- ══════════ OVERVIEW ══════════ -->
                        @if (activeTab == "overview")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <!-- Profile Completion Banner -->
                                @if (MissingProfileFields.Any())
                                {
                                    <div class="pf-alert-banner mb-4">
                                        <div class="pf-alert-icon">
                                            <span class="oi oi-info"></span>
                                        </div>
                                        <div class="pf-alert-text">
                                            <div class="pf-alert-title">تکمیل پروفایل</div>
                                            <div class="pf-alert-sub">@MissingProfileFields.Count مورد باقی‌مانده: @string.Join("، ", MissingProfileFields)</div>
                                        </div>
                                        <button class="pf-alert-btn" @onclick='() => SwitchTab("edit")'>تکمیل</button>
                                    </div>
                                }

                                <!-- Stat Cards -->
                                <div class="pf-stats-grid">
                                    <div class="pf-stat-card pf-stat-clickable" @onclick='() => SwitchTab("orders")'>
                                        <div class="pf-stat-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                            <span class="oi oi-cart"></span>
                                        </div>
                                        <div class="pf-stat-info">
                                            <div class="pf-stat-number">@myOrders.Count</div>
                                            <div class="pf-stat-label">سفارش‌ها</div>
                                        </div>
                                    </div>
                                    <div class="pf-stat-card pf-stat-clickable" @onclick='() => SwitchTab("orders")'>
                                        <div class="pf-stat-icon" style="background: rgba(255,193,7,0.15); color: #e67700;">
                                            <span class="oi oi-credit-card"></span>
                                        </div>
                                        <div class="pf-stat-info">
                                            <div class="pf-stat-number">@myOrders.Count(o => o.Status == OrderStatus.PendingPayment)</div>
                                            <div class="pf-stat-label">در انتظار پرداخت</div>
                                        </div>
                                    </div>
                                    <div class="pf-stat-card pf-stat-clickable" @onclick='() => SwitchTab("tickets")'>
                                        <div class="pf-stat-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                            <span class="oi oi-chat"></span>
                                        </div>
                                        <div class="pf-stat-info">
                                            <div class="pf-stat-number">@myTickets.Count</div>
                                            <div class="pf-stat-label">تیکت‌ها</div>
                                        </div>
                                    </div>
                                    <div class="pf-stat-card pf-stat-clickable" @onclick='() => SwitchTab("wishlist")'>
                                        <div class="pf-stat-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                            <span class="oi oi-heart"></span>
                                        </div>
                                        <div class="pf-stat-info">
                                            <div class="pf-stat-number">@wishlistItems.Count</div>
                                            <div class="pf-stat-label">علاقه‌مندی‌ها</div>
                                        </div>
                                    </div>
                                    <div class="pf-stat-card pf-stat-clickable" @onclick='() => SwitchTab("cart")'>
                                        <div class="pf-stat-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                            <span class="oi oi-basket"></span>
                                        </div>
                                        <div class="pf-stat-info">
                                            <div class="pf-stat-number">@Cart.GetTotalCount()</div>
                                            <div class="pf-stat-label">سبد خرید</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Notifications -->
                                <div class="pf-section mt-4" id="notifications">
                                    <div class="pf-section-header">
                                        <div class="pf-section-title">
                                            <span class="oi oi-bell" style="color: #dc3545;"></span>
                                            اعلان‌ها
                                            @if (notifUnreadCount > 0)
                                            {
                                                <span class="pf-section-badge">@notifUnreadCount خوانده‌نشده</span>
                                            }
                                        </div>
                                        @if (notifUnreadCount > 0)
                                        {
                                            <button type="button" class="pf-notif-readall" @onclick="MarkAllNotificationsReadAsync">خواندن همه</button>
                                        }
                                    </div>
                                    <div class="pf-notifications-list">
                                        @if (notifsLoading)
                                        {
                                            <div class="pf-notif-empty">در حال بارگذاری اعلان‌ها...</div>
                                        }
                                        else if (notifications.Count == 0)
                                        {
                                            <div class="pf-notif-empty">اعلانی برای نمایش وجود ندارد.</div>
                                        }
                                        else
                                        {
                                            @foreach (var n in notifications)
                                            {
                                                <div class="pf-notification-item @(n.IsRead ? "is-read" : "")" @onclick="() => OpenNotificationAsync(n)">
                                                    <div class="pf-notif-dot" style="@NotifDotStyle(n.Severity)"></div>
                                                    <div class="pf-notif-content">
                                                        <div class="pf-notif-title">@n.Title</div>
                                                        <div class="pf-notif-desc">@n.Body</div>
                                                        <div class="pf-notif-date">@ErrorService.Client.Services.NotificationCenterService.RelativeTime(n.CreatedAt)</div>
                                                    </div>
                                                    <div class="pf-notif-actions">
                                                        <button type="button" class="pf-notif-btn" title="مشاهده" @onclick:stopPropagation @onclick="() => OpenNotificationAsync(n)">
                                                            <span class="oi oi-external-link"></span>
                                                        </button>
                                                        <button type="button" class="pf-notif-btn" title="بستن" @onclick:stopPropagation @onclick="() => HideNotificationAsync(n)">
                                                            <span class="oi oi-x"></span>
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>

                                <!-- Products the user follows: wishlist, recently viewed and stock alerts -->
                                <div class="pf-section mt-4 pf-product-watch-section">
                                    <div class="pf-section-header pf-product-watch-header">
                                        <div>
                                            <div class="pf-section-title">
                                                <span class="oi oi-heart" style="color:#dc3545;"></span>
                                                محصولات مورد توجه شما
                                            </div>
                                            <div class="pf-product-watch-subtitle">علاقه‌مندی‌ها، بازدیدهای اخیر و کالاهایی که برای موجود شدن دنبال می‌کنید</div>
                                        </div>
                                        @if (trackedProductCards.Any())
                                        {
                                            <span class="pf-product-watch-count">@trackedProductCards.Count کالا</span>
                                        }
                                    </div>
                                    @if (isLoadingTrackedProducts)
                                    {
                                        <div class="pf-product-watch-loading"><span class="spinner-border spinner-border-sm text-danger"></span> در حال آماده‌سازی فهرست محصولات...</div>
                                    }
                                    else if (!trackedProductCards.Any())
                                    {
                                        <div class="pf-product-watch-empty">
                                            <span class="oi oi-eye"></span>
                                            <div><strong>هنوز محصولی برای نمایش ندارید</strong><small>با افزودن محصول به علاقه‌مندی‌ها یا مشاهده جزئیات آن، اینجا سریع‌تر به آن دسترسی خواهید داشت.</small></div>
                                            <a href="/products" class="pf-product-watch-link">مشاهده فروشگاه</a>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pf-product-watch-list">
                                            @foreach (var item in trackedProductCards)
                                            {
                                                <article class="pf-product-watch-card">
                                                    <a href="/products/@item.ProductId" class="pf-product-watch-image" aria-label="مشاهده @item.Name">
                                                        @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                                        {
                                                            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" />
                                                        }
                                                        else
                                                        {
                                                            <span class="oi oi-image"></span>
                                                        }
                                                    </a>
                                                    <div class="pf-product-watch-main">
                                                        <div class="pf-product-watch-tags">
                                                            @if (item.IsFavorite) { <span class="pf-product-tag pf-product-tag--favorite"><span class="oi oi-heart"></span> علاقه‌مندی</span> }
                                                            @if (item.IsRecentlyViewed) { <span class="pf-product-tag pf-product-tag--recent"><span class="oi oi-clock"></span> بازدید اخیر</span> }
                                                            @if (item.StockAlertActive) { <span class="pf-product-tag pf-product-tag--alert"><span class="oi oi-bell"></span> اعلان فعال</span> }
                                                        </div>
                                                        <a href="/products/@item.ProductId" class="pf-product-watch-name">@item.Name</a>
                                                        <div class="pf-product-watch-status @(item.IsInStock ? "is-stocked" : "is-unavailable")">
                                                            <span class="pf-stock-dot"></span>
                                                            @(item.IsInStock ? $"موجود · {item.StockQuantity:N0} عدد" : "فعلاً ناموجود")
                                                        </div>
                                                    </div>
                                                    <div class="pf-product-watch-actions">
                                                        <a href="/products/@item.ProductId" class="pf-product-watch-view"><span class="oi oi-external-link"></span> مشاهده</a>
                                                        @if (!item.IsInStock)
                                                        {
                                                            @if (item.StockAlertActive)
                                                            {
                                                                <button type="button" class="pf-product-watch-alert active" @onclick="() => ToggleStockAlertAsync(item)" disabled="@item.IsAlertBusy"><span class="oi oi-bell"></span> @(item.IsAlertBusy ? "..." : "فعال")</button>
                                                            }
                                                            else
                                                            {
                                                                <button type="button" class="pf-product-watch-alert" @onclick="() => ToggleStockAlertAsync(item)" disabled="@item.IsAlertBusy"><span class="oi oi-bell"></span> @(item.IsAlertBusy ? "..." : "خبرم کن")</button>
                                                            }
                                                        }
                                                    </div>
                                                </article>
                                            }
                                        </div>
                                    }
                                </div>

                                <!-- Latest Order -->
                                @if (myOrders.Any())
                                {
                                    var latest = myOrders.First();
                                    <div class="pf-section mt-4">
                                        <div class="pf-section-header">
                                            <div class="pf-section-title">
                                                <span class="oi oi-document" style="color: #dc3545;"></span>
                                                وضعیت آخرین سفارش شما
                                            </div>
                                            <span class="pf-order-number">#@latest.OrderNumber</span>
                                            @if (OrderDisplayHelper.IsReturned(latest))
                                            {
                                                <span class="pf-status-badge" style="@OrderDisplayHelper.SoftBadgeStyle(latest)">@OrderDisplayHelper.Label(latest)</span>
                                            }
                                        </div>
                                        <div class="pf-order-progress">
                                            <OrderStageStepper Status="latest.Status"
                                                               Stage="latest.Stage"
                                                               StageDates="latest.StageDates"
                                                               CreatedAt="latest.CreatedAt"
                                                               PaymentDate="latest.PaymentDate"
                                                               UpdatedAt="latest.UpdatedAt" />
                                        </div>
                                    </div>
                                }

                                <!-- Recent Orders Table -->
                                <div class="pf-section mt-4">
                                    <div class="pf-section-header">
                                        <div class="pf-section-title">
                                            <span class="oi oi-clock" style="color: #dc3545;"></span>
                                            آخرین سفارشات
                                        </div>
                                        <button class="pf-section-link" @onclick='() => SwitchTab("orders")'>مشاهده همه</button>
                                    </div>
                                    @if (!myOrders.Any())
                                    {
                                        <div class="pf-empty-state">
                                            <span class="oi oi-cart"></span>
                                            <p>هنوز سفارشی ثبت نکرده‌اید.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pf-table-responsive">
                                            <table class="pf-table">
                                                <thead>
                                                    <tr>
                                                        <th>شماره سفارش</th>
                                                        <th>تاریخ ثبت</th>
                                                        <th>وضعیت</th>
                                                        <th>مبلغ</th>
                                                        <th>جزئیات</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var o in myOrders.Take(3))
                                                    {
                                                        <tr>
                                                            <td class="fw-bold">#@o.OrderNumber</td>
                                                            <td>@PersianDate.ToJalaliDate(o.CreatedAt)</td>
                                                            <td><span class="pf-status-badge" style="@OrderDisplayHelper.SoftBadgeStyle(o)">@OrderDisplayHelper.Label(o)</span></td>
                                                            <td class="fw-bold">@o.TotalAmount.ToString("N0") تومان</td>
                                                            <td><button class="pf-view-btn" @onclick="() => GoToOrderDetail(o.Id)">مشاهده</button></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ══════════ ORDERS ══════════ -->
                        else if (activeTab == "orders")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <div class="pf-tab-header">
                                    <h5 class="pf-tab-title">
                                        <span class="oi oi-clock"></span>
                                        تاریخچه سفارشات
                                    </h5>
                                    <button class="pf-refresh-btn" @onclick="LoadOrdersAsync">
                                        <span class="oi oi-reload"></span>
                                    </button>
                                </div>

                                <!-- Filter Tabs -->
                                <div class="pf-filter-tabs">
                                    <button class="pf-filter-tab @(orderFilter == "all" ? "active" : "")" @onclick='() => orderFilter = "all"'>
                                        <span class="oi oi-grid-large"></span>
                                        همه (@myOrders.Count)
                                    </button>
                                    <button class="pf-filter-tab @(orderFilter == "pending" ? "active" : "")" @onclick='() => orderFilter = "pending"'>
                                        <span class="oi oi-credit-card"></span>
                                        پرداخت نشده (@myOrders.Count(o => o.Status == OrderStatus.PendingPayment))
                                    </button>
                                    <button class="pf-filter-tab @(orderFilter == "cancelled" ? "active" : "")" @onclick='() => orderFilter = "cancelled"'>
                                        <span class="oi oi-ban"></span>
                                        لغو شده (@myOrders.Count(o => o.Status == OrderStatus.Cancelled))
                                    </button>
                                    <button class="pf-filter-tab @(orderFilter == "completed" ? "active" : "")" @onclick='() => orderFilter = "completed"'>
                                        <span class="oi oi-check"></span>
                                        تکمیل شده (@myOrders.Count(o => o.Status == OrderStatus.Completed))
                                    </button>
                                </div>

                                @if (isLoadingOrders)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border spinner-border-sm text-danger"></div>
                                    </div>
                                }
                                else
                                {
                                    var filteredOrders = orderFilter switch
                                    {
                                        "pending" => myOrders.Where(o => o.Status == OrderStatus.PendingPayment).ToList(),
                                        "cancelled" => myOrders.Where(o => o.Status == OrderStatus.Cancelled).ToList(),
                                        "completed" => myOrders.Where(o => o.Status == OrderStatus.Completed).ToList(),
                                        _ => myOrders
                                    };

                                    @if (!filteredOrders.Any())
                                    {
                                        <div class="pf-empty-state">
                                            <span class="oi oi-cart"></span>
                                            <p>سفارشی یافت نشد</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pf-table-responsive">
                                            <table class="pf-table pf-table-full">
                                                <thead>
                                                    <tr>
                                                        <th>شماره سفارش</th>
                                                        <th>تاریخ ثبت</th>
                                                        <th>وضعیت</th>
                                                        <th>مبلغ</th>
                                                        <th>جزئیات</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var o in filteredOrders)
                                                    {
                                                        <tr class="cursor-pointer" @onclick="() => ToggleOrder(o.Id)">
                                                            <td class="fw-bold">#@o.OrderNumber</td>
                                                            <td>@PersianDate.ToJalaliDate(o.CreatedAt)</td>
                                                            <td><span class="pf-status-badge" style="@OrderDisplayHelper.SoftBadgeStyle(o)">@OrderDisplayHelper.Label(o)</span></td>
                                                            <td class="fw-bold">@o.TotalAmount.ToString("N0") تومان</td>
                                                            <td><button class="pf-view-btn" @onclick="() => GoToOrderDetail(o.Id)" @onclick:stopPropagation>مشاهده</button></td>
                                                        </tr>

                                                        @if (expandedOrders.Contains(o.Id))
                                                        {
                                                            <tr>
                                                                <td colspan="5" class="pf-order-expanded">
                                                                    <div class="pf-order-details">
                                                                        <div class="pf-detail-grid">
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">روش پرداخت</div>
                                                                                <div class="pf-detail-value">کارت به کارت</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">شماره پیگیری</div>
                                                                                <div class="pf-detail-value">@(string.IsNullOrWhiteSpace(o.TrackingNumber) ? "---" : o.TrackingNumber)</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">تاریخ پرداخت</div>
                                                                                <div class="pf-detail-value">@(o.PaymentDate.HasValue ? PersianDate.ToJalaliDateTime(o.PaymentDate.Value) : "---")</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">نام خریدار</div>
                                                                                <div class="pf-detail-value">@o.FullName</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">موبایل</div>
                                                                                <div class="pf-detail-value" dir="ltr">@o.PhoneNumber</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">ایمیل</div>
                                                                                <div class="pf-detail-value">@(string.IsNullOrWhiteSpace(o.Email) ? "---" : o.Email)</div>
                                                                            </div>
                                                                        </div>

                                                                        @if (o.PaymentDate.HasValue || (o.ReceiptImageUrls?.Count ?? 0) > 0 || (o.Returns?.Count ?? 0) > 0)
                                                                        {
                                                                            <div class="pf-detail-box" style="grid-column:1/-1;background:#f8fafc;border-left:3px solid #2563eb;">
                                                                                <div class="pf-detail-label" style="color:#2563eb;">اطلاعات واریزی و مرجوعی</div>

                                                                                <div style="display:flex;flex-wrap:wrap;gap:8px 24px;margin-top:8px;">
                                                                                    <div><span class="text-muted">تاریخ واریز:</span> <span class="fw-bold">@(o.PaymentDate.HasValue ? PersianDate.ToJalaliDateTime(o.PaymentDate.Value) : "---")</span></div>
                                                                                    <div><span class="text-muted">مبلغ کل:</span> <span class="fw-bold">@o.TotalAmount.ToString("N0") تومان</span></div>
                                                                                    <div><span class="text-muted">وضعیت پرداخت:</span> <span class="fw-bold">@OrderDisplayHelper.Label(o)</span></div>
                                                                                </div>

                                                                                @if ((o.ReceiptImageUrls?.Count ?? 0) > 0)
                                                                                {
                                                                                    <div style="margin-top:10px;">
                                                                                        <div class="pf-detail-label mb-2">تصاویر رسید واریز</div>
                                                                                        <div style="display:flex;gap:8px;flex-wrap:wrap;">
                                                                                            @foreach (var img in o.ReceiptImageUrls)
                                                                                            {
                                                                                                <a href="@img" target="_blank" rel="noopener">
                                                                                                    <img src="@ImageUrlHelper.Thumb(img, 200)" class="pf-receipt-img" loading="lazy" decoding="async" alt="رسید پرداخت" />
                                                                                                </a>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                                                                                }

                                                                                @if ((o.Returns?.Count ?? 0) > 0)
                                                                                {
                                                                                    <div style="margin-top:12px;border-top:1px dashed #cbd5e1;padding-top:10px;">
                                                                                        <div class="pf-detail-label mb-2" style="color:#dc2626;">اطلاعات مرجوعی ثبت شده</div>
                                                                                        @foreach (var r in o.Returns)
                                                                                        {
                                                                                            <div style="background:#fef2f2;border-radius:8px;padding:10px 12px;margin-bottom:8px;">
                                                                                                <div style="display:flex;flex-wrap:wrap;gap:6px 18px;font-size:0.85rem;">
                                                                                                    <div><span class="text-muted">مبلغ مرجوعی:</span> <span class="fw-bold text-danger">@r.RefundAmount.ToString("N0") تومان</span></div>
                                                                                                    @if (!string.IsNullOrWhiteSpace(r.RefundCardNumber))
                                                                                                    {
                                                                                                        <div><span class="text-muted">به کارت:</span> <span class="fw-bold" dir="ltr">@r.RefundCardNumber</span></div>
                                                                                                    }
                                                                                                    @if (!string.IsNullOrWhiteSpace(r.RefundBankName))
                                                                                                    {
                                                                                                        <div><span class="text-muted">بانک:</span> <span class="fw-bold">@r.RefundBankName</span></div>
                                                                                                    }
                                                                                                    @if (r.RefundDate.HasValue)
                                                                                                    {
                                                                                                        <div><span class="text-muted">تاریخ واریز:</span> <span class="fw-bold">@PersianDate.ToJalaliDateTime(r.RefundDate.Value)</span></div>
                                                                                                    }
                                                                                                    <div><span class="text-muted">وضعیت:</span> <span class="fw-bold" style="color:@(r.IsRefunded ? "#16a34a" : "#f59e0b");">@(r.IsRefunded ? "واریز شده" : "در انتظار واریز")</span></div>
                                                                                                </div>
                                                                                                @if (!string.IsNullOrWhiteSpace(r.ReturnReason))
                                                                                                {
                                                                                                    <div style="margin-top:6px;font-size:0.8rem;color:#64748b;">دلیل مرجوعی: @r.ReturnReason</div>
                                                                                                }
                                                                                                @if (!string.IsNullOrEmpty(r.RefundReceiptImageUrl))
                                                                                                {
                                                                                                    <div style="margin-top:8px;">
                                                                                                        <span class="text-muted" style="font-size:0.8rem;">رسید واریز مرجوعی:</span>
                                                                                                        <a href="@r.RefundReceiptImageUrl" target="_blank" rel="noopener" style="margin-inline-start:8px;color:#2563eb;font-weight:700;font-size:0.85rem;">
                                                                                                            <span class="oi oi-external-link"></span> مشاهده تصویر
                                                                                                        </a>
                                                                                                    </div>
                                                                                                }
                                                                                            </div>
                                                                                        }
                                                                                    </div>
                                                                                }
                                                                            </div>
                                                                        }

                                                                        @if (!string.IsNullOrWhiteSpace(o.Address))
                                                                        {
                                                                            <div class="pf-detail-address">
                                                                                <span class="oi oi-map-marker"></span>
                                                                                @o.Address
                                                                            </div>
                                                                        }

                                                                         @if (!string.IsNullOrWhiteSpace(o.AdminNotes))
                                                                         {
                                                                             <div class="pf-detail-note" dir="rtl">
                                                                                 <span class="oi oi-info"></span>
                                                                                 <strong>یادداشت مدیر:</strong>
                                                                                 <div class="pf-detail-note-text" style="margin-top:8px">
                                                                                     <AdminNotesList Notes="@o.AdminNotes" />
                                                                                 </div>
                                                                             </div>
                                                                         }

                                                                         @if (!string.IsNullOrEmpty(o.ShippingMethodName))
                                                                         {
                                                                             <div class="pf-detail-box" style="grid-column:1/-1;background:#f0fdf4;border-left:3px solid #16a34a;">
                                                                                 <div class="pf-detail-label" style="color:#059669;">روش ارسال</div>
                                                                                 <div class="pf-detail-value">
                                                                                     @o.ShippingMethodName
                                                                                     @if (o.ShippingCost == 0)
                                                                                     {
                                                                                         <span class="badge bg-success ms-2">رایگان</span>
                                                                                     }
                                                                                     else
                                                                                     {
                                                                                         <span class="text-muted ms-2">— هزینه: @o.ShippingCost.ToString("N0") تومان</span>
                                                                                     }
                                                                                 </div>
                                                                             </div>
                                                                         }

                                                                         @if (!string.IsNullOrEmpty(o.ReceiptImageUrl))
                                                                         {
                                                                             <div class="pf-detail-receipt">
                                                                                 <div class="pf-detail-label mb-2">رسید پرداخت</div>
                                                                                 <a href="@o.ReceiptImageUrl" target="_blank">
                                                                                     <img src="@ImageUrlHelper.Thumb(o.ReceiptImageUrl, 200)" class="pf-receipt-img" loading="lazy" decoding="async" alt="رسید پرداخت" />
                                                                                 </a>
                                                                             </div>
                                                                         }

                                                                         @if (o.Shipments.Any())
                                                                         {
                                                                             <div style="grid-column:1/-1;">
                                                                                 <div class="pf-detail-label mb-2">مرسولات پستی</div>
                                                                                 @foreach (var s in o.Shipments)
                                                                                 {
                                                                                     <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;background:#f8fafc;border-radius:8px;margin-bottom:6px;flex-wrap:wrap;">
                                                                                         <span class="fw-bold small">@s.Carrier</span>
                                                                                         @if (!string.IsNullOrEmpty(s.TrackingNumber))
                                                                                         {
                                                                                             <span class="text-muted small">کد رهگیری:</span>
                                                                                             <span class="fw-bold small ltr" dir="ltr">@s.TrackingNumber</span>
                                                                                             <a href="@GetTrackingUrl(s.Carrier, s.TrackingNumber)" target="_blank" rel="noopener"
                                                                                                style="display:inline-flex;align-items:center;gap:4px;background:#eff6ff;color:#2563eb;padding:2px 10px;border-radius:16px;font-size:0.72rem;font-weight:700;text-decoration:none;">
                                                                                                 <span class="oi oi-external-link"></span> رهگیری
                                                                                             </a>
                                                                                         }
                                                                                     </div>
                                                                                 }
                                                                             </div>
                                                                         }

                                                                        <div class="pf-order-items">
                                                                            @foreach (var it in o.Items)
                                                                            {
                                                                                <a href="/products/@it.ProductId" class="pf-order-item">
                                                                                    <div class="pf-order-item-img">
                                                                                        @if (!string.IsNullOrEmpty(it.ImageUrl))
                                                                                        {
                                                                                            <img src="@ImageUrlHelper.Thumb(it.ImageUrl, 200)" loading="lazy" decoding="async" alt="@it.ProductName" />
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <img src="/images/placeholder-product.svg" loading="lazy" decoding="async" alt="@it.ProductName" />
                                                                                        }
                                                                                    </div>
                                                                                    <div class="pf-order-item-body">
                                                                                        <div class="pf-item-name">@it.ProductName</div>
                                                                                        <div class="pf-item-meta">
                                                                                            <span class="pf-item-qty">@it.Quantity × @it.Price.ToString("N0") تومان</span>
                                                                                            <span class="pf-item-line-total">@((it.Price * it.Quantity).ToString("N0")) تومان</span>
                                                                                        </div>
                                                                                    </div>
                                                                                    <span class="oi oi-chevron-right pf-order-item-arrow"></span>
                                                                                </a>
                                                                            }
                                                                        </div>

                                                                        <div class="pf-order-total">
                                                                            <span>جمع کل پرداختی</span>
                                                                            <span class="fw-bold text-danger">@o.TotalAmount.ToString("N0") تومان</span>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <!-- ══════════ TICKETS ══════════ -->
                        else if (activeTab == "tickets")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                @if (selectedTicketForProfile == null && !isCreatingNewTicket)
                                {
                                    <div class="pf-tab-header">
                                        <h5 class="pf-tab-title">
                                            <span class="oi oi-chat"></span>
                                            تیکت‌های پشتیبانی
                                        </h5>
                                        <button class="pf-primary-btn" @onclick="() => isCreatingNewTicket = true">
                                            <span class="oi oi-plus"></span>
                                            ثبت تیکت جدید
                                        </button>
                                    </div>

                                    @if (isLoadingTickets)
                                    {
                                        <div class="text-center py-4">
                                            <div class="spinner-border spinner-border-sm text-danger"></div>
                                        </div>
                                    }
                                    else if (!myTickets.Any())
                                    {
                                        <div class="pf-empty-state">
                                            <span class="oi oi-chat"></span>
                                            <p>هنوز تیکتی ثبت نکرده‌اید</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pf-tickets-list">
                                            @foreach (var t in myTickets)
                                            {
                                                var isUnread = !t.IsUserRead;
                                                <div class="pf-ticket-card @(isUnread ? "unread" : "")" @onclick="() => SelectTicketForProfile(t)">
                                                    <div class="pf-ticket-header">
                                                        <div class="pf-ticket-info">
                                                            @if (isUnread)
                                                            {
                                                                <span class="pf-ticket-new">پاسخ جدید</span>
                                                            }
                                                            <h6 class="pf-ticket-title">@t.Title</h6>
                                                            <span class="pf-ticket-date">@FormatJalaliDateTime(t.CreatedAt)</span>
                                                        </div>
                                                        <span class="pf-status-badge @GetTicketStatusClass(t)">@GetTicketStatusLabel(t)</span>
                                                    </div>
                                                    <p class="pf-ticket-desc">@t.Description</p>
                                                    <div class="pf-ticket-footer">
                                                        <div class="pf-ticket-avatars">
                                                            <span class="pf-avatar-mini user">شما</span>
                                                            @if (t.Replies.Any(r => r.IsAdmin))
                                                            {
                                                                <span class="pf-avatar-mini admin">تیم</span>
                                                            }
                                                        </div>
                                                        <span class="pf-ticket-replies">@t.Replies.Count پاسخ</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else if (isCreatingNewTicket)
                                {
                                    <div class="pf-tab-header">
                                        <button class="pf-back-btn" @onclick="() => isCreatingNewTicket = false">
                                            <span class="oi oi-chevron-right"></span>
                                        </button>
                                        <h5 class="pf-tab-title">ثبت تیکت جدید</h5>
                                    </div>
                                    <div class="pf-form-card">
                                        <EditForm Model="newTicket" OnValidSubmit="HandleSubmitTicket">
                                            <DataAnnotationsValidator />
                                            <div class="pf-form-group">
                                                <label class="pf-form-label">موضوع</label>
                                                <InputText class="pf-form-input" @bind-Value="newTicket.Title" placeholder="عنوان کوتاه موضوع" />
                                                <ValidationMessage For="@(() => newTicket.Title)" class="text-danger smaller" />
                                            </div>
                                            <div class="pf-form-group">
                                                <label class="pf-form-label">شرح دقیق مشکل</label>
                                                <InputTextArea class="pf-form-input" @bind-Value="newTicket.Description" rows="4" placeholder="علائم خرابی را بنویسید..." />
                                                <ValidationMessage For="@(() => newTicket.Description)" class="text-danger smaller" />
                                            </div>
                                            <div class="pf-form-group">
                                                <label class="pf-form-label">آپلود مستندات (اختیاری)</label>
                                                <div class="pf-upload-zone">
                                                    <InputFile OnChange="OnAttachmentSelected" class="pf-upload-input" />
                                                    @if (!string.IsNullOrEmpty(newTicket.ImageUrl) || !string.IsNullOrEmpty(newTicket.FileUrl))
                                                    {
                                                        <span class="oi oi-check text-success display-6"></span>
                                                        <div class="small fw-bold mt-2">فایل انتخاب شد</div>
                                                    }
                                                    else
                                                    {
                                                        <span class="oi oi-paperclip text-danger display-6"></span>
                                                        <div class="small text-muted mt-2">برای انتخاب تصویر یا فایل کلیک کنید</div>
                                                    }
                                                </div>
                                            </div>
                                            <button type="submit" class="pf-primary-btn w-100" disabled="@isBusy">
                                                @if (isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                ارسال تیکت پشتیبانی
                                            </button>
                                        </EditForm>
                                    </div>
                                }
                                else if (selectedTicketForProfile != null)
                                {
                                    <div class="pf-tab-header">
                                        <button class="pf-back-btn" @onclick="() => selectedTicketForProfile = null">
                                            <span class="oi oi-chevron-right"></span>
                                        </button>
                                        <div class="overflow-hidden">
                                            <h6 class="pf-tab-title mb-0 text-truncate">@selectedTicketForProfile.Title</h6>
                                            <span class="pf-status-badge @GetTicketStatusClass(selectedTicketForProfile) smaller">@GetTicketStatusLabel(selectedTicketForProfile)</span>
                                        </div>
                                    </div>

                                    <div class="pf-chat-area">
                                        <!-- Ticket starter message -->
                                        <div class="pf-tmsg pf-tmsg--user">
                                            <div class="pf-tmsg__head">
                                                <div class="pf-tmsg__who">
                                                    <span class="pf-tmsg__role">کاربر</span>
                                                    <div class="pf-tmsg__ident">
                                                        <b>@(string.IsNullOrWhiteSpace(selectedTicketForProfile.UserFullName) ? "شما" : selectedTicketForProfile.UserFullName)</b>
                                                        @if (!string.IsNullOrWhiteSpace(selectedTicketForProfile.UserEmail))
                                                        {
                                                            <i>@selectedTicketForProfile.UserEmail</i>
                                                        }
                                                    </div>
                                                </div>
                                                <span class="pf-tmsg__date">@FormatJalaliDateTime(selectedTicketForProfile.CreatedAt)</span>
                                            </div>
                                            <div class="pf-tmsg__body">
                                                <p class="mb-0">@selectedTicketForProfile.Description</p>
                                            </div>
                                            @if (!string.IsNullOrEmpty(selectedTicketForProfile.ImageUrl) || !string.IsNullOrEmpty(selectedTicketForProfile.FileUrl))
                                            {
                                                <div class="pf-tmsg__files">
                                                    <div class="pf-tmsg__files-label"><span class="oi oi-paperclip"></span> پیوست‌ها</div>
                                                    @if (!string.IsNullOrEmpty(selectedTicketForProfile.ImageUrl))
                                                    {
                                                        <a class="pf-tmsg__file" href="@selectedTicketForProfile.ImageUrl" target="_blank">
                                                            <span class="oi oi-image"></span>
                                                            <span>تصویر پیوستی</span>
                                                            <span class="oi oi-cloud-download"></span>
                                                        </a>
                                                    }
                                                    @if (!string.IsNullOrEmpty(selectedTicketForProfile.FileUrl))
                                                    {
                                                        <a class="pf-tmsg__file" href="@selectedTicketForProfile.FileUrl" target="_blank">
                                                            <span class="oi oi-file"></span>
                                                            <span class="text-truncate">@selectedTicketForProfile.FileName</span>
                                                            <span class="oi oi-cloud-download"></span>
                                                        </a>
                                                    }
                                                </div>
                                            }
                                        </div>

                                        @foreach (var reply in selectedTicketForProfile.Replies)
                                        {
                                            <div class="pf-tmsg @(reply.IsAdmin ? "pf-tmsg--admin" : "pf-tmsg--user")">
                                                <div class="pf-tmsg__head">
                                                    <div class="pf-tmsg__who">
                                                        <span class="pf-tmsg__role">@(reply.IsAdmin ? "پشتیبانی" : "کاربر")</span>
                                                        <div class="pf-tmsg__ident">
                                                            <b>@(reply.IsAdmin ? "کارشناس پشتیبانی فنی" : (string.IsNullOrWhiteSpace(selectedTicketForProfile.UserFullName) ? "شما" : selectedTicketForProfile.UserFullName))</b>
                                                        </div>
                                                    </div>
                                                    <span class="pf-tmsg__date">@FormatJalaliDateTime(reply.RepliedAt)</span>
                                                </div>
                                                <div class="pf-tmsg__body">
                                                    <p class="mb-0">@reply.Message</p>
                                                </div>
                                                @if (!string.IsNullOrEmpty(reply.AttachmentUrl))
                                                {
                                                    <div class="pf-tmsg__files">
                                                        <div class="pf-tmsg__files-label"><span class="oi oi-paperclip"></span> پیوست‌ها</div>
                                                        <a class="pf-tmsg__file" href="@reply.AttachmentUrl" target="_blank">
                                                            <span class="oi @(reply.AttachmentContentType?.StartsWith("image/") == true ? "oi-image" : "oi-file")"></span>
                                                            <span class="text-truncate">@reply.AttachmentName</span>
                                                            <span class="oi oi-cloud-download"></span>
                                                        </a>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>

                                    <div class="pf-reply-attach-bar">
                                        <label class="pf-reply-clip" title="پیوست مستندات">
                                            <span class="oi oi-paperclip"></span>
                                            <InputFile OnChange="OnReplyAttachmentSelected" class="pf-reply-clip-input" accept="image/*,.pdf,.zip,.rar,.doc,.docx,.xls,.xlsx,.txt" />
                                        </label>
                                        <input type="text" class="pf-form-input" placeholder="متن پاسخ..." @bind="replyMessage" @bind:event="oninput" @onkeydown="OnReplyKeyDown" />
                                        <button class="pf-reply-send" @onclick="HandleReplySubmit" disabled="@(isBusy || (string.IsNullOrWhiteSpace(replyMessage) && string.IsNullOrEmpty(replyAttachmentUrl)))" title="ارسال پاسخ">
                                            @if (isBusy)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
                                                    <path d="M3.4 20.4 21.85 12 3.4 3.6 3.4 10.15 15.4 12 3.4 13.85Z" fill="currentColor"/>
                                                </svg>
                                            }
                                        </button>
                                    </div>
                                    @if (!string.IsNullOrEmpty(replyAttachmentUrl))
                                    {
                                        <div class="pf-reply-file">
                                            <span class="oi @(replyAttachmentType?.StartsWith("image/") == true ? "oi-image" : "oi-file")"></span>
                                            <span class="pf-reply-file__name">@replyAttachmentName</span>
                                            <button type="button" class="pf-reply-file__remove" title="حذف پیوست" @onclick="RemoveReplyAttachment"><span class="oi oi-x"></span></button>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <!-- ══════════ EDIT PROFILE ══════════ -->
                        else if (activeTab == "edit")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <div class="pf-tab-header">
                                    <h5 class="pf-tab-title">
                                        <span class="oi oi-person"></span>
                                        ویرایش اطلاعات شخصی
                                    </h5>
                                </div>
                                <div class="pf-form-card">
                                    <EditForm Model="updateModel" OnValidSubmit="HandleUpdateProfile">
                                        <DataAnnotationsValidator />
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">نام و نام خانوادگی</label>
                                                    <InputText class="pf-form-input" @bind-Value="updateModel.FullName" />
                                                    <ValidationMessage For="@(() => updateModel.FullName)" class="text-danger smaller" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">شماره موبایل (غیرقابل تغییر)</label>
                                                    <input type="text" class="pf-form-input readonly" value="@user.PhoneNumber" readonly />
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">آدرس ایمیل</label>
                                                    <InputText class="pf-form-input" @bind-Value="updateModel.Email" placeholder="example@mail.com" />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">کد پستی</label>
                                                    <InputText class="pf-form-input" @bind-Value="updateModel.PostalCode" placeholder="۱۰ رقم" />
                                                </div>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">آدرس کامل پستی</label>
                                                    <InputTextArea class="pf-form-input" @bind-Value="updateModel.Address" rows="2" placeholder="استان، شهر، خیابان..." />
                                                </div>
                                            </div>
                                            <div class="col-12 mt-4">
                                                <button type="submit" class="pf-primary-btn px-5" disabled="@isBusy">
                                                    @if (isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                    ذخیره تغییرات
                                                </button>
                                            </div>
                                        </div>
                                    </EditForm>
                                </div>
                            </div>
                        }

                        <!-- ══════════ CHANGE PASSWORD ══════════ -->
                        else if (activeTab == "password")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <div class="pf-tab-header">
                                    <h5 class="pf-tab-title">
                                        <span class="oi oi-lock-locked"></span>
                                        تغییر رمز عبور
                                    </h5>
                                </div>
                                <div class="pf-form-card" style="max-width: 500px;">
                                    <EditForm Model="passwordModel" OnValidSubmit="HandleChangePassword">
                                        <DataAnnotationsValidator />
                                        <div class="pf-form-group">
                                            <label class="pf-form-label">رمز عبور فعلی</label>
                                            <InputText type="password" class="pf-form-input" @bind-Value="passwordModel.CurrentPassword" />
                                            <ValidationMessage For="@(() => passwordModel.CurrentPassword)" class="text-danger smaller" />
                                        </div>
                                        <div class="pf-form-group">
                                            <label class="pf-form-label">رمز عبور جدید</label>
                                            <InputText type="password" class="pf-form-input" @bind-Value="passwordModel.NewPassword" />
                                            <ValidationMessage For="@(() => passwordModel.NewPassword)" class="text-danger smaller" />
                                        </div>
                                        <div class="mt-4">
                                            <button type="submit" class="pf-outline-btn px-4" disabled="@isBusy">
                                                @if (isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                تغییر رمز عبور
                                            </button>
                                        </div>
                                    </EditForm>
                                </div>
                            </div>
                        }

                        <!-- ══════════ COUPONS ══════════ -->
                        else if (activeTab == "coupons")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <div class="pf-tab-header">
                                    <h5 class="pf-tab-title">
                                        <span class="oi oi-badge"></span>
                                        کدهای تخفیف من
                                    </h5>
                                    <button class="pf-refresh-btn" @onclick="LoadCouponsAsync">
                                        <span class="oi oi-reload"></span>
                                    </button>
                                </div>

                                @if (isLoadingCoupons)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border spinner-border-sm text-danger"></div>
                                    </div>
                                }
                                else if (!myCoupons.Any())
                                {
                                    <div class="pf-empty-state">
                                        <span class="oi oi-badge"></span>
                                        <p>هنوز کد تخفیفی ندارید.</p>
                                    </div>
                                }
                                else
                                {
                                    <div class="pf-coupons-grid">
                                        @foreach (var c in myCoupons)
                                        {
                                            var isExpired = c.ExpiryDate.HasValue && c.ExpiryDate < DateTimeOffset.UtcNow;
                                            var isExhausted = c.MaxUsageCount.HasValue && c.CurrentUsageCount >= c.MaxUsageCount.Value;
                                            var isUsed = c.IsUsedByMe;
                                            var effectiveStatus = isUsed ? "used" : isExpired ? "expired" : isExhausted ? "exhausted" : c.IsActive ? "active" : "inactive";

                                            <div class="pf-coupon-card @(effectiveStatus)">
                                                <div class="pf-coupon-top">
                                                    <div class="pf-coupon-badge @(effectiveStatus)">
                                                        @if (effectiveStatus == "active")
                                                        {
                                                            <span class="oi oi-check"></span>
                                                        }
                                                        else if (effectiveStatus == "used")
                                                        {
                                                            <span class="oi oi-circle-check"></span>
                                                        }
                                                        else if (effectiveStatus == "expired")
                                                        {
                                                            <span class="oi oi-clock"></span>
                                                        }
                                                        else if (effectiveStatus == "exhausted")
                                                        {
                                                            <span class="oi oi-ban"></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="oi oi-x"></span>
                                                        }
                                                    </div>
                                                    <div class="pf-coupon-info">
                                                        <div class="pf-coupon-code" dir="ltr">@c.Code</div>
                                                        @if (!string.IsNullOrWhiteSpace(c.Description))
                                                        {
                                                            <div class="pf-coupon-desc">@c.Description</div>
                                                        }
                                                    </div>
                                                </div>
                                                <div class="pf-coupon-value">
                                                    @if (c.DiscountPercent.HasValue)
                                                    {
                                                        <span class="pf-coupon-discount">@c.DiscountPercent% تخفیف</span>
                                                    }
                                                    else if (c.DiscountAmount.HasValue)
                                                    {
                                                        <span class="pf-coupon-discount">@c.DiscountAmount.Value.ToString("N0") تومان تخفیف</span>
                                                    }
                                                </div>
                                                <div class="pf-coupon-meta">
                                                    @if (c.ExpiryDate.HasValue)
                                                    {
                                                        <span>انقضا: @PersianDate.ToJalaliDate(c.ExpiryDate.Value)</span>
                                                    }
                                                    else
                                                    {
                                                        <span>بدون انقضا</span>
                                                    }
                                                    <span class="pf-coupon-status @(effectiveStatus)">
                                                        @(effectiveStatus switch {
                                                            "active" => "قابل استفاده",
                                                            "used" => "استفاده شده",
                                                            "expired" => "منقضی شده",
                                                            "exhausted" => "تمام شده",
                                                            _ => "غیرفعال"
                                                        })
                                                    </span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <!-- ══════════ BALE CONNECTION ══════════ -->
                        else if (activeTab == "bale")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <div class="pf-tab-header">
                                    <h5 class="pf-tab-title">
                                        <span class="oi oi-bell"></span>
                                        اتصال به بله (دریافت اعلان‌ها)
                                    </h5>
                                    <button class="pf-refresh-btn" disabled="@baleLoading" @onclick="LoadBaleStatusAsync">
                                        <span class="oi oi-reload"></span>
                                    </button>
                                </div>

                                @if (baleLoading && baleStatus == null)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border spinner-border-sm text-danger"></div>
                                    </div>
                                }
                                else if (baleStatus == null)
                                {
                                    <div class="pf-empty-state">
                                        <span class="oi @(baleSessionExpired ? "oi-lock-unlocked" : "oi-warning")"></span>
                                        <p>@(baleSessionExpired
                                            ? "جلسه شما منقضی شده است؛ برای مشاهدهٔ وضعیت اتصال دوباره وارد حساب کاربری شوید."
                                            : "دریافت وضعیت اتصال ممکن نشد؛ دکمهٔ بازخوانی را بزنید.")</p>
                                        @if (baleSessionExpired)
                                        {
                                            <button class="pf-primary-btn" @onclick='() => Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString("/profile")}")'>ورود مجدد</button>
                                        }
                                        else
                                        {
                                            <button class="pf-refresh-btn" disabled="@baleLoading" @onclick="LoadBaleStatusAsync"><span class="oi oi-reload"></span> تلاش دوباره</button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="pf-bale-card @(baleStatus.Connected ? "on" : "")">
                                        <div class="pf-bale-status">
                                            <span class="oi @(baleStatus.Connected ? "oi-circle-check" : "oi-circle-x")"></span>
                                            <div>
                                                <b>@(baleStatus.Connected ? "اتصال برقرار است" : "هنوز متصل نشده‌اید")</b>
                                                <p>
                                                    @(baleStatus.Connected && baleStatus.ConnectedAt.HasValue
                                                        ? $"از تاریخ {PersianDate.ToJalaliDate(baleStatus.ConnectedAt.Value)} اعلان‌های سایت به‌صورت خودکار در بله برای شما ارسال می‌شود."
                                                        : "با ارسال شمارهٔ خود از داخل ربات بله، اعلان‌های سایت را در بله دریافت کنید.")
                                                </p>
                                            </div>
                                        </div>
                                        @if (baleStatus.Connected && !string.IsNullOrWhiteSpace(baleStatus.Phone))
                                        {
                                            <div class="pf-bale-phone">
                                                شماره ثبت‌شده: <b dir="ltr">@baleStatus.Phone</b>
                                            </div>
                                        }
                                        @if (baleStatus.Connected && !baleStatus.NotificationsEnabled)
                                        {
                                            <div class="pf-bale-warn">
                                                <span class="oi oi-warning"></span>
                                                دریافت اعلان در حال حاضر توسط مدیر سایت خاموش است؛ اتصال شما حفظ می‌شود و پس از فعال‌سازی، ارسال آغاز می‌شود.
                                            </div>
                                        }
                                    </div>

                                    <div class="pf-bale-steps">
                                        <div class="pf-bale-steps__title"><span class="oi oi-info"></span> راهنمای اتصال (۴ مرحلهٔ ساده)</div>
                                        <ol>
                                            <li><b>۱.</b> روی دکمهٔ «باز کردن ربات بله» در پایین همین صفحه بزنید تا ربات در بله باز شود.</li>
                                            <li><b>۲.</b> داخل ربات یک پیام متنی کوتاه بفرستید (مثلاً «سلام») تا راهنما نمایش داده شود.</li>
                                            <li>
                                                <b>۳.</b> دکمهٔ «ارسال شمارهٔ من» را بزنید تا شماره‌تان برای ما ارسال شود.
                                                <div class="pf-bale-note">شماره باید دقیقاً همان شماره‌ای باشد که با آن در سایت ثبت‌نام کرده‌اید؛ در غیر این صورت پیام «شماره یافت نشد» می‌گیرید.</div>
                                            </li>
                                            <li><b>۴.</b> تا پیام «شماره شما ثبت شد ✓» صبر کنید — از این پس اعلان‌های سایت در بله برای شما ارسال می‌شود.</li>
                                        </ol>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(baleStatus.BotUrl))
                                    {
                                        <a class="pf-bale-open" href="@baleStatus.BotUrl" target="_blank" rel="noopener">
                                            <span class="oi oi-external-link"></span>
                                            باز کردن ربات بله
                                        </a>
                                    }
                                    else if (baleStatus.BotConfigured)
                                    {
                                        <div class="pf-empty-state">
                                            <span class="oi oi-info"></span>
                                            <p>نشانی ربات بله در دسترس نیست؛ چند لحظه بعد دوباره تلاش کنید.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pf-empty-state">
                                            <span class="oi oi-info"></span>
                                            <p>ربات بله هنوز توسط مدیر سایت فعال نشده است؛ پس از فعال‌سازی، این بخش در دسترس قرار می‌گیرد.</p>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <!-- ══════════ WISHLIST ══════════ -->
                        else if (activeTab == "wishlist")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <div class="pf-tab-header">
                                    <h5 class="pf-tab-title">
                                        <span class="oi oi-heart"></span>
                                        علاقمندی‌ها
                                    </h5>
                                    @if (wishlistItems.Any())
                                    {
                                        <button class="pf-refresh-btn text-danger" @onclick="ClearWishlist" title="حذف همه">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    }
                                </div>

                                @if (!wishlistItems.Any())
                                {
                                    <div class="pf-empty-state">
                                        <span class="oi oi-heart"></span>
                                        <p>لیست علاقمندی‌ها خالی است</p>
                                        <a href="/products" class="btn btn-primary btn-sm rounded-pill px-4 mt-2">مشاهده محصولات</a>
                                    </div>
                                }
                                else
                                {
                                    <div class="pf-wishlist-grid">
                                        @foreach (var item in wishlistItems)
                                        {
                                            <div class="pf-wishlist-card">
                                                <a href="/products/@item.ProductId" class="pf-wishlist-img">
                                                    @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                    {
                                                        <img src="@ImageUrlHelper.Thumb(item.ImageUrl, 200)" loading="lazy" decoding="async" alt="@item.Name" />
                                                    }
                                                    else
                                                    {
                                                        <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                                            <span class="oi oi-image fs-3"></span>
                                                        </div>
                                                    }
                                                </a>
                                                <div class="pf-wishlist-body">
                                                    <a href="/products/@item.ProductId" class="pf-wishlist-name">@item.Name</a>
                                                    <div class="pf-wishlist-price">
                                                        @{
                                                            var displayPrice = item.DiscountPrice.HasValue && item.DiscountPrice.Value > 0 ? item.DiscountPrice.Value : item.Price;
                                                        }
                                                        <span class="fw-bold">@displayPrice.ToString("N0")</span>
                                                        <small class="text-muted">تومان</small>
                                                    </div>
                                                    <div class="pf-wishlist-actions">
                                                        <a href="/products/@item.ProductId" class="pf-wishlist-btn-view">
                                                            <span class="oi oi-eye"></span> مشاهده
                                                        </a>
                                                        <button class="pf-wishlist-btn-remove" @onclick="() => RemoveFromWishlist(item.ProductId)">
                                                            <span class="oi oi-heart"></span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                </div>
                            }
                        </div>
                    }

                    <!-- ══════════ CART ══════════ -->
                    @if (activeTab == "cart")
                    {
                        <div class="pf-tab-content animate__animated animate__fadeIn">
                            <div class="pf-tab-header">
                                <h5 class="pf-tab-title">
                                    <span class="oi oi-basket"></span>
                                    سبد خرید
                                </h5>
                                @if (cartItems.Any())
                                {
                                    <button class="pf-refresh-btn text-danger" @onclick="ClearCart" title="خالی کردن سبد">
                                        <span class="oi oi-trash"></span>
                                    </button>
                                }
                            </div>

                            @if (isCartLoading)
                            {
                                <div class="text-center py-4">
                                    <div class="spinner-border spinner-border-sm text-danger"></div>
                                </div>
                            }
                            else if (!cartItems.Any())
                            {
                                <div class="pf-empty-state">
                                    <span class="oi oi-basket"></span>
                                    <p>سبد خرید شما خالی است</p>
                                    <a href="/products" class="btn btn-primary btn-sm rounded-pill px-4 mt-2">مشاهده محصولات</a>
                                </div>
                            }
                            else
                            {
                                @if (UnavailableCartCount > 0)
                                {
                                    <div class="pf-cart-alert">
                                        <span class="oi oi-alert"></span>
                                        <div>
                                            <strong>@UnavailableCartCount کالا ناموجود شده است</strong>
                                            <p>این کالاها قابل خرید نیستند و هنگام تکمیل خرید با تایید شما حذف می‌شوند.</p>
                                        </div>
                                    </div>
                                }

                                <div class="pf-cart-list">
                                    @foreach (var item in cartItems)
                                    {
                                        var avail = GetCartAvailability(item.ProductId);
                                        var isUnavailable = avail != null && !avail.HasSufficientStock;
                                        <div class="pf-cart-card @(isUnavailable ? "pf-cart-card--unavailable" : "")">
                                            @if (isUnavailable)
                                            {
                                                <div class="pf-cart-unavailable-badge">
                                                    <span class="oi oi-ban"></span>
                                                    @(avail!.StockQuantity <= 0 || !avail.IsAvailable ? "ناموجود" : $"موجودی: فقط {avail.StockQuantity} عدد")
                                                </div>
                                            }
                                            <a href="/products/@item.ProductId" class="pf-cart-img">
                                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                                {
                                                    <img src="@ImageUrlHelper.Thumb(item.ImageUrl, 200)" loading="lazy" decoding="async" alt="@item.Name" />
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center justify-content-center h-100 text-muted">
                                                        <span class="oi oi-image fs-3"></span>
                                                    </div>
                                                }
                                            </a>
                                            <div class="pf-cart-body">
                                                <a href="/products/@item.ProductId" class="pf-cart-name">@item.Name</a>
                                                <div class="pf-cart-price">@item.Price.ToString("N0") تومان</div>
                                                <div class="pf-cart-qty-row">
                                                    <div class="pf-cart-qty-controls">
                                                        <button class="pf-cart-qty-btn" @onclick="() => DecreaseQty(item.ProductId)" disabled="@(item.Quantity <= 1 || isUnavailable)">
                                                            <span class="oi oi-minus"></span>
                                                        </button>
                                                        <span class="pf-cart-qty-val">@item.Quantity</span>
                                                        <button class="pf-cart-qty-btn" @onclick="() => IncreaseQty(item.ProductId)" disabled="@isUnavailable">
                                                            <span class="oi oi-plus"></span>
                                                        </button>
                                                    </div>
                                                    <button class="pf-cart-remove-btn" @onclick="() => RemoveCartItem(item.ProductId)">
                                                        <span class="oi oi-trash"></span>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="pf-cart-summary">
                                    <div class="pf-cart-summary-row">
                                        <span>تعداد اقلام</span>
                                        <span class="fw-bold">@cartItems.Count</span>
                                    </div>
                                    <div class="pf-cart-summary-row">
                                        <span>جمع تعداد</span>
                                        <span class="fw-bold">@cartItems.Sum(x => x.Quantity)</span>
                                    </div>
                                    @if (UnavailableCartCount > 0)
                                    {
                                        <div class="pf-cart-summary-row pf-cart-summary-warn">
                                            <span>کالای ناموجود</span>
                                            <span class="fw-bold">@UnavailableCartCount مورد (حذف در ادامه)</span>
                                        </div>
                                    }
                                    <div class="pf-cart-summary-row pf-cart-summary-total">
                                        <span>جمع کل</span>
                                        <span class="fw-bold">@AvailableCartTotal.ToString("N0") تومان</span>
                                    </div>
                                </div>

                                <div class="pf-cart-actions">
                                    <a href="/products" class="pf-outline-btn">
                                        <span class="oi oi-plus"></span>
                                        ادامه خرید
                                    </a>
                                    <button type="button" class="pf-primary-btn" @onclick="ProceedFromProfileCart">
                                        <span class="oi oi-credit-card"></span>
                                        تکمیل خرید
                                    </button>
                                </div>
                            }
                        </div>
                    }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@if (showMobileSidebar)
{
    <div class="pf-sidebar-overlay" @onclick="() => showMobileSidebar = false"></div>
}

<ConfirmDialog IsVisible="showRemoveUnavailableConfirm"
               Title="حذف کالاهای ناموجود"
               Message="@($"{UnavailableCartCount} کالا ناموجود شده و قابل خرید نیست. برای ادامه از سبد حذف شوند؟")"
