@using ErrorService.Shared
@using System.Net.Http.Json
@inject IJSRuntime JS

@if (settings != null && settings.ShowLatestArticles)
{
    @if (items == null)
    {
        <section class="academy-section home-section position-relative bg-light" dir="rtl">
            <div class="container-fluid px-3 px-md-4">
                <div class="d-flex gap-3 overflow-hidden px-2">
                    @for (int i = 0; i < 3; i++)
                    {
                        <div class="academy-item-skeleton rounded-4 bg-white p-3 shadow-sm" style="flex: 0 0 320px;">
                            <div class="skeleton-thumb rounded-3 mb-3"></div>
                            <div class="skeleton-line mb-2"></div>
                            <div class="skeleton-line w-50"></div>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
    else if (items.Any())
    {
        <section class="academy-section home-section position-relative bg-light" dir="rtl">
            <div class="container-fluid px-3 px-md-4">
                <div class="home-head px-2">
                    <h2 class="home-head__title">جدیدترین آموزش‌ها</h2>
                    <div class="home-head__actions">
                        <a href="/academy" class="home-more">مشاهده همه <span class="oi oi-arrow-left" aria-hidden="true"></span></a>
                        <CarouselControls TrackId="latest-articles-track" />
                    </div>
                </div>

                <div class="academy-scroll-container" id="latest-articles-track" @ref="scrollContainer">
                    @foreach (var item in items)
                    {
                        <div class="academy-scroll-item">
                            <a href="@SeoUrl.Article(item.Id, item.Slug)" class="text-decoration-none">
                                <div class="academy-card rounded-4 overflow-hidden h-100 shadow-sm border-0">
                                    <div class="academy-card__thumb position-relative">
                                        <img src="@(string.IsNullOrEmpty(item.CoverImageUrl) ? "/images/placeholder-academy.svg" : ImageUrlHelper.Thumb(item.CoverImageUrl, 400))"
                                             srcset="@ImageUrlHelper.SrcSet(item.CoverImageUrl)"
                                             sizes="(max-width: 576px) 70vw, 260px"
                                             loading="lazy" decoding="async" alt="@(string.IsNullOrWhiteSpace(item.Title) ? "Technical article" : item.Title)" />
                                        <div class="academy-card__badge academy-card__badge--article">
                                            <span class="oi oi-document me-1"></span>
                                            آموزش
                                        </div>
                                    </div>
                                    <div class="academy-card__content p-4">
                                        <h3 class="academy-card__title h6 fw-bold text-dark mb-3">@item.Title</h3>
                                        <div class="academy-card__desc text-muted small line-clamp-2">@item.Summary</div>
                                        <div class="academy-card__footer mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                                            <div class="text-success small fw-bold">مطالعه آموزش</div>
                                            <span class="oi oi-arrow-left text-success small"></span>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}


@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private ErrorService.Client.Services.SiteSettingsService SettingsService { get; set; } = default!;
    private List<TrainingArticleDto>? items;
    private SiteSettingsDto? settings;
    private ElementReference scrollContainer;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            settings = await SettingsService.GetAsync();
            if (settings != null && !settings.ShowLatestArticles) return;

            items = await Http.GetFromJsonAsync<List<TrainingArticleDto>>("api/trainingarticles?onlyPublished=true&take=4");
        }
        catch { items = new(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && items != null && items.Any())
        {
            try { await JS.InvokeVoidAsync("initDragScroll", scrollContainer); } catch { }
        }
    }
}
