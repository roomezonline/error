@code {
    private static readonly (string Key, string Label)[] Presets =
    {
        ("today", "امروز"),
        ("7d", "۷ روز اخیر"),
        ("30d", "۳۰ روز اخیر"),
        ("month", "این ماه"),
        ("year", "امسال"),
        ("all", "همه")
    };

    private ShopAccountingDto? report;
    private bool loading = true;
    private string preset = "30d";
    private string dateFrom = string.Empty;
    private string dateTo = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        try { await JS.InvokeVoidAsync("initJalali"); } catch { }
    }

    private async Task SetPreset(string key)
    {
        preset = key;
        await Load();
    }

    private async Task ApplyCustom()
    {
        preset = "custom";
        await Load();
    }

    private async Task OnDateChanged()
    {
        preset = "custom";
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            var url = $"api/orders/admin/accounting?preset={Uri.EscapeDataString(preset)}";

            if (preset == "custom")
            {
                if (!string.IsNullOrWhiteSpace(dateFrom) && PersianDate.TryParseJalaliDateTime(dateFrom, out var df))
                    url += $"&dateFrom={df:yyyy-MM-dd}";
                if (!string.IsNullOrWhiteSpace(dateTo) && PersianDate.TryParseJalaliDateTime(dateTo, out var dt))
                    url += $"&dateTo={dt:yyyy-MM-dd}";
            }

            report = await Http.GetFromJsonAsync<ShopAccountingDto>(url);
        }
        catch (Exception ex)
        {
            report = null;
            ToastService.ShowError("خطا در ساخت گزارش: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private int BarPct(decimal value)
    {
        if (report?.Daily == null || report.Daily.Count == 0) return 0;
        var max = report.Daily.Max(d => d.Amount);
        if (max <= 0) return 0;
        return (int)Math.Round(value / max * 100m);
    }

    private ShopAccountingDayDto? selectedDay;
    private ShopAccountingDayDetailDto? dayDetail;
    private bool dayLoading;

    private async Task OpenDay(ShopAccountingDayDto day)
    {
        if (dayLoading || selectedDay != null) return;

        selectedDay = day;
        dayDetail = null;
        dayLoading = true;
        try
        {
            dayDetail = await Http.GetFromJsonAsync<ShopAccountingDayDetailDto>(
                $"api/orders/admin/accounting/day?date={Uri.EscapeDataString(day.Date)}");
        }
        catch (Exception ex)
        {
            selectedDay = null;
            dayDetail = null;
            ToastService.ShowError("خطا در دریافت جزئیات روز: " + ex.Message);
        }
        finally
        {
            dayLoading = false;
        }
    }

    private void CloseDay()
    {
        if (dayLoading) return;
        selectedDay = null;
        dayDetail = null;
    }

    private async Task OnDayKey(KeyboardEventArgs e, ShopAccountingDayDto day)
    {
        if (e.Key is "Enter" or " " or "Spacebar") await OpenDay(day);
    }

    private static string StatusTone(string key) => key switch
    {
        "Approved" or "Completed" => "ac-order__status--ok",
        "Rejected" or "Cancelled" => "ac-order__status--bad",
        "ReceiptUploaded" => "ac-order__status--info",
        "PendingPayment" => "ac-order__status--wait",
        _ => ""
    };
}
