@page "/products/{Id:int}"
@page "/products/{Slug}"
@using ErrorService.Shared
@using ErrorService.Client.Services
@using System.Net.Http.Json
@using ErrorService.Client.Utils
@using System.Text.Json
@using System.Threading
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>ارورسرویس - @(product?.Name ?? "جزئیات محصول")</PageTitle>

<div class="pd-wrap" dir="rtl">
    <div class="pd-container">
        @if (isLoading)
        {
            <div class="pd-skeleton">
                <div class="pd-sk-grid">
                    <div class="pd-sk-gallery"></div>
                    <div class="pd-sk-info">
                        <div class="pd-sk-line w-25"></div>
                        <div class="pd-sk-line w-75 h2"></div>
                        <div class="pd-sk-line w-50"></div>
                        <div class="pd-sk-line w-100 h4" style="height:80px; border-radius:1rem;"></div>
                        <div class="pd-sk-line w-100" style="height:48px; border-radius:0.85rem;"></div>
                    </div>
                </div>
                <div class="pd-sk-details">
                    <div class="pd-sk-line w-100" style="height:200px; border-radius:1rem;"></div>
                </div>
            </div>
        }
        else if (product == null)
        {
            <SeoHeader Title="محصول یافت نشد | ارور سرویس" Description="متاسفانه محصول مورد نظر یافت نشد." />
            <div class="pd-notfound">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#dc3545" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <h3>محصول مورد نظر یافت نشد!</h3>
                <a href="/products" class="pd-back-btn">بازگشت به فروشگاه</a>
            </div>
        }
        else
        {
            <SeoHeader 
                Title="@($"{product.Name} | قیمت و مشخصات | ارور سرویس")" 
                Description="@(string.IsNullOrEmpty(product.Description) ? $"خرید و مشاهده مشخصات فنی {product.Name} در دسته {product.CategoryName}" : TruncateText(StripHtml(product.Description), 160))"
                OgType="product"
                OgImage="@(product.MainImageUrl ?? "/images/og-default.jpg")"
                CanonicalUrl="@($"https://errorservice.ir{SeoUrl.Product(product.Id, product.Slug)}")"
                JsonLd="@productJsonLd" />

            <ViewTracker EntityType="product" EntityId="product.Id" />

            <!-- Mobile header sticky -->
            <div class="pd-header-sticky d-lg-none shadow-sm">
                <div class="pd-header-inner">
                    <a href="/products" class="pd-header-back" title="بازگشت به فروشگاه">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                    </a>
                    <div class="pd-header-title text-truncate px-2">@product.Name</div>
                    <button class="pd-header-action" @onclick="OpenShareModal" title="اشتراک‌گذاری">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                    </button>
                </div>
            </div>

            <nav class="pd-breadcrumb d-none d-lg-flex">
                <ol>
                    <li><a href="/">خانه</a></li>
                    <li><a href="/products">محصولات</a></li>
                    <li><a href="/products?categoryId=@product.CategoryId">@product.CategoryName</a></li>
                </ol>
            </nav>

            <div class="pd-main">
                <div class="pd-gallery">
                    <div class="pd-gallery-view"
                         @onmousedown="HandleMouseDown"
                         @onmouseup="HandleMouseUp"
                         @ontouchstart="HandleTouchStart"
                         @ontouchend="HandleTouchEnd">
                        <div class="pd-gallery-track" style="transform: translateX(@(currentImageIndex * 100)%)">
                            @for (int i = 0; i < GetAllImages().Count; i++)
                            {
                                var img = GetAllImages()[i];
                                <div class="pd-gallery-slide">
                                    <div class="pd-img-wrap">
                                        <img src="@ImageUrlHelper.Thumb(img, 800)"
                                             srcset="@ImageUrlHelper.SrcSet(img, new[] { 400, 800 })"
                                             sizes="(max-width: 768px) 100vw, 520px"
                                             alt="@product.Name"
                                             loading="@(i == 0 ? "eager" : "lazy")"
                                             fetchpriority="@(i == 0 ? "high" : "auto")"
                                             decoding="async" draggable="false" class="pd-main-img"
                                             @onclick="() => OpenLightbox(i)" @onerror="() => HandleImageError(i)" />
                                    </div>
                                </div>
                            }
                        </div>

                        @if (IsDiscountActive(product))
                        {
                            <div class="pd-discount-ribbon">
                                <span class="pd-discount-label">@(IsTimedActive(product) ? "پیشنهاد ویژه" : "تخفیف ویژه")</span>
                                @if (IsTimedActive(product))
                                {
                                    <span class="pd-discount-timer">@countdownText</span>
                                }
                            </div>
                        }

                        @if (GetAllImages().Count > 1)
                        {
                            <div class="pd-dots">
                                @for (int i = 0; i < GetAllImages().Count; i++)
                                {
                                    <button class="pd-dot @(currentImageIndex == i ? "pd-dot--active" : "")"
                                            @onclick="() => currentImageIndex = i"
                                            aria-label="تصویر @(i + 1)"></button>
                                }
                            </div>
                        }
                    </div>

                    @if (GetAllImages().Count > 1)
                    {
                        <div class="pd-thumbs">
                            @for (int i = 0; i < GetAllImages().Count; i++)
                            {
                                var idx = i;
                                var img = GetAllImages()[i];
                                <button class="pd-thumb @(currentImageIndex == idx ? "pd-thumb--active" : "")"
                                        @onclick="() => currentImageIndex = idx"
                                        aria-label="تصویر کوچک @(i + 1)">
                                    <img src="@ImageUrlHelper.Thumb(img, 200)" alt="" loading="lazy" decoding="async" @onerror="() => HandleThumbError(idx)" />
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="pd-info">
                    <div class="pd-head">
                        <span class="pd-category">@product.CategoryName</span>
                        <h1 class="pd-title">@product.Name</h1>
                        @if (Flag("badges"))
                        {
                            <div class="pd-badges">
                                @if ((DateTimeOffset.Now - product.CreatedAt).TotalDays <= 14)
                                {
                                    <span class="pd-badge pd-badge--new">جدید</span>
                                }
                                @if (IsDiscountActive(product))
                                {
                                    <span class="pd-badge pd-badge--sale">تخفیف‌دار</span>
                                }
                                @if (product.StockQuantity > 0 && product.StockQuantity <= 5 && product.IsAvailable)
                                {
                                    <span class="pd-badge pd-badge--low">کم‌موجود</span>
                                }
                                @if (product.IsFeatured)
                                {
                                    <span class="pd-badge pd-badge--hot">پرفروش</span>
                                }
                            </div>
                        }
                    </div>

                    <div class="pd-extra">
                        <span class="pd-extra-item pd-code-copy" @onclick="CopyProductCode" title="کلیک برای کپی">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                            کد محصول: #@product.Id.ToString("D6")
                        </span>
                        <span class="pd-extra-item">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            @product.ViewCount.ToString("N0") بازدید
                        </span>
                        @if (product.IsAvailable && product.StockQuantity > 0)
                        {
                            <span class="pd-extra-item pd-instock">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                                @if (product.StockQuantity <= 5)
                                {
                                    <span>تنها @product.StockQuantity عدد در انبار</span>
                                }
                                else
                                {
                                    <span>موجود در انبار</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="pd-extra-item pd-outstock">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                                ناموجود
                            </span>
                        }
                    </div>

                    <div class="pd-statcard">
                        <div class="pd-stat">
                            <div class="pd-stat-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    var fill = reviewSummary != null && i <= Math.Round(reviewSummary.AverageRating, MidpointRounding.AwayFromZero) ? "#f59e0b" : "none";
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="@fill" stroke="#f59e0b" stroke-width="2">
                                        <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
                                    </svg>
                                }
                            </div>
                            <b>@(reviewSummary == null ? "—" : reviewSummary.AverageRating.ToString("F1"))</b>
                            <span>امتیاز کاربران</span>
                        </div>
                        <div class="pd-stat">
                            <b>@(reviewSummary?.TotalCount ?? 0)</b>
                            <span>امتیاز ثبت‌شده</span>
                        </div>
                        <div class="pd-stat">
                            <b>@_questions.Count</b>
                            <span>پرسش و پاسخ</span>
                        </div>
                    </div>

                    <div class="pd-buy">
                        <div class="pd-pricebox">
                            @if (IsDiscountActive(product))
                            {
                                <div class="pd-price-row">
                                    <span class="pd-price-old">@product.Price.ToString("N0") تومان</span>
                                    <span class="pd-price-badge">تخفیف ویژه</span>
                                </div>
                                <div class="pd-price-current">
                                    <span class="pd-price-num">@product.DiscountPrice!.Value.ToString("N0")</span>
                                    <span class="pd-price-unit">تومان</span>
                                </div>
                            }
                            else
                            {
                                <div class="pd-price-current">
                                    <span class="pd-price-num">@product.Price.ToString("N0")</span>
                                    <span class="pd-price-unit">تومان</span>
                                </div>
                            }
                        </div>

                        <div class="pd-actions">
                            <div class="pd-qty">
                                <span class="pd-qty-label">تعداد:</span>
                                <div class="pd-qty-box">
                                    <button class="pd-qty-btn" @onclick="DecrementQty" disabled="@(_quantity <= 1)" aria-label="کاهش">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    </button>
                                    <span class="pd-qty-val">@_quantity</span>
                                    <button class="pd-qty-btn" @onclick="IncrementQty" disabled="@(_quantity >= QtyMax)" aria-label="افزایش">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                                    </button>
                                </div>
                            </div>
                            <div class="pd-actions-tools">
                                <button class="pd-share" @onclick="OpenShareModal" title="اشتراک‌گذاری" aria-label="اشتراک‌گذاری">
                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v6a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-6"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
                                    <span>اشتراک</span>
                                </button>
                                @if (Flag("wishlist"))
                                {
                                    <button class="pd-share @(isInWishlist ? "pd-wishlist-active" : "")" @onclick="ToggleWishlist" title="علاقمندی" aria-label="افزودن به علاقمندی‌ها">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="@(isInWishlist ? "currentColor" : "none")" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                                        <span>علاقمندی</span>
                                    </button>
                                }
                            </div>
                        </div>

                        @if (Flag("stockalert") && IsProductOutOfStock)
                        {
                            <button class="pd-notify-btn @(_stockAlertSubscribed ? "pd-notify-subscribed" : "")"
                                    @onclick="HandleStockAlertClick" disabled="@_stockAlertBusy">
                                @if (_stockAlertBusy)
                                {
                                    <span class="pd-cart-spinner"></span>
                                }
                                else if (_stockAlertSubscribed)
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                }
                                else
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                                }
                                <span>@(_stockAlertSubscribed ? "یادآوری ثبت شد — برای لغو بزنید" : "خبرم کن وقتی موجود شد")</span>
                            </button>
                        }
                        else
                        {
                            <button class="pd-add-cart @_cartBtnClass" @onclick="AddToCart" disabled="@(!product.IsAvailable || product.StockQuantity <= 0 || _isAddingToCart)">
                                @if (_cartBtnState == CartBtnState.Spinner)
                                {
                                    <span class="pd-cart-spinner"></span>
                                }
                                else if (_cartBtnState == CartBtnState.Done)
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                                }
                                else
                                {
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                }
                                <span>@_cartBtnText</span>
                            </button>
                        }
                    </div>

                    @if (Flag("chart"))
                    {
                        @if (_pricePoints.Count > 1)
                        {
                            <div class="pd-chart">
                                <div class="pd-chart__head">
                                    <div class="pd-chart__title">
                                        <b>تاریخچه قیمت</b>
                                        <small>@_pricePoints.Count ثبت — از قدیمی‌ترین (چپ) تا جدیدترین (راست)</small>
                                    </div>
                                    <span class="pd-chart__legend"><i aria-hidden="true"></i> قیمت (تومان)</span>
                                </div>
                                <div class="pd-chart__body">
                                    @{
                                        var n = _pricePoints.Count;
                                        var minP = _pricePoints.Min(p => p.DiscountPrice ?? p.Price);
                                        var maxP = _pricePoints.Max(p => p.DiscountPrice ?? p.Price);
                                        var range = maxP > minP ? maxP - minP : 1m;
                                        var isFlat = maxP == minP;
                                        var inv = System.Globalization.CultureInfo.InvariantCulture;
                                        var lineSb = new System.Text.StringBuilder();
                                        var areaSb = new System.Text.StringBuilder();
                                        for (var i = 0; i < n; i++)
                                        {
                                            var v = _pricePoints[i].DiscountPrice ?? _pricePoints[i].Price;
                                            var x = 100m * i / (n - 1);
                                            var y = isFlat ? 50m : 88m - 76m * (v - minP) / range;
                                            var xs = x.ToString("0.####", inv);
                                            var ys = y.ToString("0.####", inv);
                                            if (i == 0)
                                            {
                                                lineSb.Append(xs).Append(',').Append(ys);
                                                areaSb.Append('M').Append(xs).Append(",100 L").Append(xs).Append(',').Append(ys);
                                            }
                                            else
                                            {
                                                lineSb.Append(' ').Append(xs).Append(',').Append(ys);
                                                areaSb.Append(" L").Append(xs).Append(',').Append(ys);
                                            }
                                        }
                                        areaSb.Append(" L100,100 Z");
                                        var lineS = lineSb.ToString();
                                        var areaS = areaSb.ToString();
                                    }
                                    <div class="pd-chart__plot">
                                        <svg class="pd-chart__svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                                            <defs>
                                                <linearGradient id="pdPriceGrad" x1="0" y1="0" x2="0" y2="1">
                                                    <stop offset="0%" stop-color="#2563eb" stop-opacity="0.30" />
                                                    <stop offset="100%" stop-color="#2563eb" stop-opacity="0.02" />
                                                </linearGradient>
                                            </defs>
                                            <path d="@areaS" fill="url(#pdPriceGrad)" />
                                            <polyline points="@lineS" fill="none" stroke="#2563eb" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke" />
                                        </svg>
                                        <div class="pd-chart__cols">
                                            @for (var i = 0; i < n; i++)
                                            {
                                                var idx = i;
                                                var pt = _pricePoints[i];
                                                var v = pt.DiscountPrice ?? pt.Price;
                                                var yVal = isFlat ? 50m : 88m - 76m * (v - minP) / range;
                                                var yPct = yVal.ToString("0.##", inv);
                                                var xPct = (100m * i / (n - 1)).ToString("0.####", inv);
                                                var tipB = Math.Clamp(104m - yVal, 0m, 64m).ToString("0.##", inv);
                                                var label = $"قیمت {v:N0} تومان در تاریخ {pt.DateFa}";
                                                <button type="button"
                                                        class="pd-chart__col @(idx == _chartIndex ? "is-active" : "")"
                                                        style="left:@(xPct)%"
                                                        @onclick="() => _chartIndex = idx"
                                                        aria-label="@label"
                                                        aria-pressed="@(idx == _chartIndex ? "true" : "false")">
                                                    <span class="pd-chart__xline"></span>
                                                    <span class="pd-chart__dot" style="top:@(yPct)%"></span>
                                                    <span class="pd-chart__tip" style="bottom:@(tipB)%">
                                                        <b>@v.ToString("N0") تومان</b>
                                                        <i>@pt.DateFa</i>
                                                    </span>
                                                </button>
                                            }
                                        </div>
                                    </div>
                                </div>
                                @{
                                    var si = Math.Clamp(_chartIndex, 0, n - 1);
                                    var sel = _pricePoints[si];
                                    var selV = sel.DiscountPrice ?? sel.Price;
                                }
                                <div class="pd-chart__summary">
                                    <div class="pd-chart__sum">
                                        <span class="pd-chart__sum-label">@(si == n - 1 ? "آخرین قیمت ثبت‌شده" : "قیمت ثبت‌شده")</span>
                                        <b>@selV.ToString("N0") <small>تومان</small></b>
                                        <span class="pd-chart__sum-date">@sel.DateFa</span>
                                    </div>
                                </div>
                                <div class="pd-chart__foot">
                                    <span>@_pricePoints.First().DateFa</span>
                                    <span>@_pricePoints.Last().DateFa</span>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="pd-chart pd-chart--empty">
                                <div class="pd-chart__head">
                                    <b>تاریخچه قیمت</b>
                                    <span>@_pricePoints.Count ثبت</span>
                                </div>
                                <div class="pd-chart__empty">
                                    <span class="oi oi-graph"></span>
                                    <b>هنوز تغییر قیمتی ثبت نشده است</b>
                                </div>
                            </div>
                        }
                    }

                    @if (Flag("trust") || Flag("eta"))
                    {
                        <div class="pd-highlights">
                            @if (Flag("trust"))
                            {
                                <div class="pd-hl">
                                    <span class="pd-hl-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
                                    <span class="pd-hl-text"><b>ضمانت اصالت</b><small>تضمین اصل بودن کالا</small></span>
                                </div>
                                <div class="pd-hl">
                                    <span class="pd-hl-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg></span>
                                    <span class="pd-hl-text"><b>ارسال سریع</b><small>ارسال به سراسر کشور</small></span>
                                </div>
                                <div class="pd-hl">
                                    <span class="pd-hl-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
                                    <span class="pd-hl-text"><b>پشتیبانی</b><small>پاسخگویی کارشناسان فروشگاه</small></span>
                                </div>
                            }
                            @if (Flag("eta"))
                            {
                                <div class="pd-hl">
                                    <span class="pd-hl-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></span>
                                    <span class="pd-hl-text">
                                        <b>زمان تقریبی تحویل</b>
                                        <small>@(string.IsNullOrWhiteSpace(product.EstimatedDeliveryText) ? StoreDefaults.DeliveryEta : product.EstimatedDeliveryText)@(IsProductOutOfStock ? " — پس از موجود شدن" : "")</small>
                                    </span>
                                </div>
                            }
                        </div>
                    }

                </div>
            </div>

            @if (IsProductOutOfStock && substitutes != null && substitutes.Any())
            {
                <div class="pd-subs">
                    <div class="pd-subs__head">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                        <b>جایگزین‌های موجود از همین دسته</b>
                    </div>
                    <div class="pd-subs__list">
                        @foreach (var s in substitutes)
                        {
                            <a href="@SeoUrl.Product(s.Id, s.Slug)" class="pd-subs__item" @key="s.Id">
                                <div class="pd-subs__img">
                                    @if (!string.IsNullOrEmpty(s.MainImageUrl))
                                    {
                                        <img src="@s.MainImageUrl" alt="@s.Name" loading="lazy" />
                                    }
                                </div>
                                <span class="pd-subs__name">@s.Name</span>
                                <div class="pd-subs__price">
                                    @if (IsDiscountActive(s))
                                    {
                                        <span class="pd-subs__old">@s.Price.ToString("N0")</span>
                                    }
                                    <b>@DiscountHelper.GetEffectivePrice(s).ToString("N0")</b>
                                    <span>تومان</span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="pd-tabs-wrap">
                <div class="pd-tabs-header" role="tablist" aria-label="اطلاعات محصول">
                    <button type="button" role="tab" aria-selected="@(_activeTab == 0)" class="pd-tab-btn @(_activeTab == 0 ? "pd-tab-active" : "")" @onclick="() => SwitchTab(0)">
                        <span class="pd-tab-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></span>
                        <span>توضیحات</span>
                    </button>
                    <button type="button" role="tab" aria-selected="@(_activeTab == 1)" class="pd-tab-btn @(_activeTab == 1 ? "pd-tab-active" : "")" @onclick="() => SwitchTab(1)">
                        <span class="pd-tab-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></span>
                        <span>مشخصات فنی</span>
                    </button>
                    @if (Flag("qna"))
                    {
                        <button type="button" role="tab" aria-selected="@(_activeTab == 2)" class="pd-tab-btn @(_activeTab == 2 ? "pd-tab-active" : "")" @onclick="() => SwitchTab(2)">
                            <span class="pd-tab-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
                            <span>پرسش و پاسخ</span>
                            <span class="pd-tab-count">@_questions.Count</span>
                        </button>
                    }
                    @if (Flag("reviews"))
                    {
                        <button type="button" role="tab" aria-selected="@(_activeTab == 3)" class="pd-tab-btn @(_activeTab == 3 ? "pd-tab-active" : "")" @onclick="() => SwitchTab(3)">
                            <span class="pd-tab-ico"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg></span>
                            <span>نظرات کاربران</span>
                            <span class="pd-tab-count">@(reviewSummary?.TotalCount ?? 0)</span>
                        </button>
                    }
                </div>

                <div class="pd-tab-content @(_activeTab == 0 ? "pd-tab-fade-in" : "pd-tab-fade-out")">
                    @if (_activeTab == 0)
                    {
                        @if (!string.IsNullOrEmpty(product.Description))
                        {
                            <div class="pd-tab-panel pd-desc">
                                @((MarkupString)HtmlSanitizer.Sanitize(product.Description!))
                            </div>
                        }
                        else
                        {
                            <div class="pd-tab-empty">هنوز توضیحاتی برای این محصول ثبت نشده است.</div>
                        }
                    }
                    else if (_activeTab == 1)
                    {
                        <div class="pd-specs pd-specs--sheet">
                            @{
                                var orderedSpecs = _serverSpecs.OrderBy(s => s.SortOrder).ThenBy(s => s.Id).ToList();
                            }
                            @if (Flag("specs") && orderedSpecs.Count > 0)
                            {
                                @foreach (var sp in orderedSpecs)
                                {
                                    <div class="pd-spec">
                                        <span class="pd-spec-chip">@sp.SpecKey</span>
                                        <span class="pd-spec-val">@sp.SpecValue</span>
                                    </div>
                                }
                            }
                            <div class="pd-spec">
                                <span class="pd-spec-chip pd-spec-chip--0">دسته‌بندی</span>
                                <span class="pd-spec-val">@product.CategoryName</span>
                            </div>
                            <div class="pd-spec">
                                <span class="pd-spec-chip pd-spec-chip--1">شناسه کالا</span>
                                <span class="pd-spec-val pd-spec-val--mono">#@product.Id.ToString("D10")</span>
                            </div>
                            <div class="pd-spec">
                                <span class="pd-spec-chip pd-spec-chip--2">قیمت</span>
                                <span class="pd-spec-val pd-spec-val--price">@product.Price.ToString("N0") تومان</span>
                            </div>
                            <div class="pd-spec">
                                <span class="pd-spec-chip pd-spec-chip--3">وضعیت موجودی</span>
                                <span class="pd-spec-status @((product.IsAvailable && product.StockQuantity > 0) ? "is-ok" : "is-no")">
                                    <i></i>@((product.IsAvailable && product.StockQuantity > 0) ? "موجود" : "ناموجود")
                                </span>
                            </div>
                            @if (!string.IsNullOrEmpty(product.CompatibilityInfo))
                            {
                                <div class="pd-tech-card">
                                    <div class="pd-tech-icon"><span class="oi oi-wrench"></span></div>
                                    <div class="pd-tech-body">
                                        <div class="pd-tech-label">سازگاری</div>
                                        <div class="pd-tech-text">@product.CompatibilityInfo</div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(product.FailureSymptoms))
                            {
                                <div class="pd-tech-card">
                                    <div class="pd-tech-icon"><span class="oi oi-warning"></span></div>
                                    <div class="pd-tech-body">
                                        <div class="pd-tech-label">علائم خرابی</div>
                                        <div class="pd-tech-text">@product.FailureSymptoms</div>
                                    </div>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(product.DatasheetUrl))
                            {
                                <a href="@product.DatasheetUrl" target="_blank" rel="noopener" class="pd-tech-card pd-tech-link">
                                    <div class="pd-tech-icon"><span class="oi oi-file"></span></div>
                                    <div class="pd-tech-body">
                                        <div class="pd-tech-label">دیتاشیت محصول</div>
                                        <div class="pd-tech-text pd-tech-text--link">مشاهده و دانلود برگه مشخصات فنی</div>
                                    </div>
                                    <span class="oi oi-external-link pd-tech-ext"></span>
                                </a>
                            }
                        </div>
                    }
                    else if (_activeTab == 2)
                    {
                        <div class="pd-qna">
                            <div class="pd-qna-topbar">
                                <div class="pd-qna-stats">
                                    <span class="pd-qna-stat pd-qna-stat--q">@_questions.Count پرسش ثبت‌شده</span>
                                    <span class="pd-qna-stat pd-qna-stat--a">@_questions.Count(x => x.IsAnswered) پاسخ‌دار</span>
                                    <span class="pd-qna-stat pd-qna-stat--w">@_questions.Count(x => !x.IsAnswered) بدون پاسخ</span>
                                </div>
                                <div class="pd-qna-filters">
                                    <button class="pd-qna-chip @(_qnaFilter == "all" ? "pd-qna-chip--on" : "")" @onclick='() => _qnaFilter = "all"'>همه</button>
                                    <button class="pd-qna-chip @(_qnaFilter == "answered" ? "pd-qna-chip--on" : "")" @onclick='() => _qnaFilter = "answered"'>با پاسخ</button>
                                    <button class="pd-qna-chip @(_qnaFilter == "pending" ? "pd-qna-chip--on" : "")" @onclick='() => _qnaFilter = "pending"'>بدون پاسخ</button>
                                    <input class="pd-qna-search" placeholder="جستجو در پرسش‌ها..." @bind="_qnaSearch" @bind:event="oninput" />
                                </div>
                            </div>

                            <div class="pd-qna-form">
                                <div class="pd-qna-form-head">
                                    <b>پرسش خود را ثبت کنید</b>
                                    <span>پرسش شما پس از بررسی و تأیید نمایش داده می‌شود و کارشناسان فروشگاه یا خریداران دیگر می‌توانند پاسخ دهند.</span>
                                </div>
                                <div class="pd-qna-fields">
                                    <input class="pd-qna-input" placeholder="نام شما" maxlength="200" @bind="_qnaName" />
                                    <textarea class="pd-qna-input pd-qna-textarea" placeholder="متن پرسش (حداقل ۵ کاراکتر)" maxlength="1000" @bind="_qnaText"></textarea>
                                    <button class="pd-qna-submit" @onclick="SubmitQuestion" disabled="@(_qnaSending || _qnaName.Trim().Length == 0)">
                                        @if (_qnaSending) { <span class="pd-cart-spinner"></span> }
                                        ثبت پرسش
                                    </button>
                                </div>
                            </div>

                            @if (_qnaLoading)
                            {
                                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
                            }
                            else if (!FilteredQuestions.Any())
                            {
                                <div class="pd-qna-empty">
                                    <span class="oi oi-question-mark"></span>
                                    <b>@(string.IsNullOrWhiteSpace(_qnaSearch) && _qnaFilter == "all" ? "هنوز پرسشی ثبت نشده است — اولین نفر باشید!" : "پرسشی با این فیلتر پیدا نشد.")</b>
                                    <span>@(string.IsNullOrWhiteSpace(_qnaSearch) ? "می‌توانید پرسش خود را از فرم بالا بپرسید." : "عبارت دیگری را جستجو کنید.")</span>
                                </div>
                            }
                            else
                            {
                                <div class="pd-qna-list">
                                    @foreach (var q in FilteredQuestions)
                                    {
                                        <div class="pd-qna-item @(q.IsAnswered ? "pd-qna-item--answered" : "")">
                                            <div class="pd-qna-avatar" aria-hidden="true">؟</div>
                                            <div class="pd-qna-item-main">
                                                <div class="pd-qna-item-head">
                                                    <b>@q.FullName</b>
                                                    <span class="pd-qna-date">@q.CreatedAtFa</span>
                                                    @if (q.IsAnswered)
                                                    {
                                                        <span class="pd-qna-tag pd-qna-tag--ok">پاسخ رسمی</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="pd-qna-tag pd-qna-tag--wait">در انتظار پاسخ</span>
                                                    }
                                                </div>
                                                <p class="pd-qna-q">@q.Question</p>

                                                @if (q.IsAnswered && !string.IsNullOrEmpty(q.Answer))
                                                {
                                                    <div class="pd-qna-answer">
                                                        <div class="pd-qna-answer-head">
                                                            <span class="pd-qna-answer-label"><span class="oi oi-check"></span> پاسخ رسمی فروشگاه</span>
                                                            @if (!string.IsNullOrEmpty(q.AnsweredAtFa))
                                                            {
                                                                <span class="pd-qna-date">@q.AnsweredAtFa</span>
                                                            }
                                                        </div>
                                                        <p>@q.Answer</p>
                                                    </div>
                                                }

                                                @if (q.Replies != null && q.Replies.Any())
                                                {
                                                    <div class="pd-qna-replies">
                                                        @foreach (var r in q.Replies)
                                                        {
                                                            <div class="pd-qna-reply @(r.IsAdmin ? "pd-qna-reply--admin" : "")">
                                                                <div class="pd-qna-reply-avatar">@(string.IsNullOrEmpty(r.FullName) ? "؟" : r.FullName.Substring(0, 1))</div>
                                                                <div class="pd-qna-reply-body">
                                                                    <div class="pd-qna-reply-head">
                                                                        <b>@r.FullName</b>
                                                                        @if (r.IsAdmin)
                                                                        {
                                                                            <span class="pd-qna-badge-admin">کارشناس فروشگاه</span>
                                                                        }
                                                                        <span class="pd-qna-date">@r.CreatedAtFa</span>
                                                                    </div>
                                                                    <p>@r.Body</p>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }

                                                @if (_isAuthenticated)
                                                {
                                                    @if (_replyFor == q.Id)
                                                    {
                                                        <div class="pd-qna-reply-form">
                                                            <textarea class="pd-qna-input pd-qna-textarea" placeholder="پاسخ خود را بنویسید (حداقل ۳ کاراکتر)..." maxlength="1000" @bind="_replyText"></textarea>
                                                            <div class="pd-qna-reply-actions">
                                                                <button class="pd-qna-submit pd-qna-submit--sm" disabled="@(_replySending || _replyText.Trim().Length < 3)" @onclick="() => SubmitReply(q.Id)">
                                                                    @if (_replySending) { <span class="pd-cart-spinner"></span> }
                                                                    ثبت پاسخ
                                                                </button>
                                                                <button type="button" class="pd-qna-link" @onclick="CancelReply">انصراف</button>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="pd-qna-reply-btn" @onclick="() => StartReply(q.Id)">
                                                            <span class="oi oi-bubble me-1"></span> پاسخ دهید
                                                        </button>
                                                    }
                                                }
                                            </div>
                                            <button class="pd-qna-vote @(q.HasVoted ? "pd-qna-vote--on" : "")" @onclick="() => VoteQuestion(q.Id)" title="مفید بود">
                                                <span class="oi oi-thumb-up"></span>
                                                <span>@q.UpVotes</span>
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else if (_activeTab == 3 && Flag("reviews"))
                    {
                        <div class="pd-reviews">
                            @if (reviewSummary == null)
                            {
                                <div class="text-center py-4">
                                    <div class="spinner-border text-primary" role="status"></div>
                                </div>
                            }
                            else
                            {
                                <CommentSection ShowStarSummary="false"
                                                ShowRating="true"
                                                RequireEmail="true"
                                                AllowMedia="@Flag("media")"
                                                ShowVerifiedBadge="@Flag("verified")"
                                                EnableGallery="@Flag("gallery")"
                                                SubmitEndpoint="@($"api/products/{(product?.Id ?? 0)}/reviews")"
                                                AverageRating="@reviewSummary.AverageRating"
                                                TotalCount="@reviewSummary.TotalCount"
                                                Comments="@_productCommentDtos"
                                                SubmitComment="@HandleProductReviewSubmit" />
                            }
                        </div>
                    }
                </div>
            </div>

            var recentList = _recentItems.Where(r => product == null || r.Id != product.Id).ToList();
            var hasRelated = Flag("related") && relatedProducts != null && relatedProducts.Any();
            var hasRecent = Flag("recent") && recentList.Count > 0;
            var showRelated = hasRelated && (_suggestTab == 0 || !hasRecent);
            var suggestCards = new List<(int Id, string? Slug, string Name, string? Image, decimal Price, bool HasDiscount, decimal Effective)>();
            if (showRelated)
            {
                foreach (var rp in relatedProducts!)
                    suggestCards.Add((rp.Id, rp.Slug, rp.Name, rp.MainImageUrl, rp.Price, IsDiscountActive(rp), DiscountHelper.GetEffectivePrice(rp)));
            }
            else if (hasRecent)
            {
                foreach (var ri in recentList)
                    suggestCards.Add((ri.Id, ri.Slug, ri.Name, ri.ImageUrl, ri.Price, IsDiscountActive(ri), DiscountHelper.GetEffectivePrice(ri)));
            }
            @if (hasRelated || hasRecent)
            {
                <section class="pd-sug" aria-label="پیشنهاد محصولات">
                    <div class="pd-sug-head">
                        <div class="pd-sug-title">
                            <span class="pd-sug-ico" aria-hidden="true">
                                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.9 4.6L18.5 9.5 13.9 11.4 12 16l-1.9-4.6L5.5 9.5l4.6-1.9L12 3z"/><path d="M19 15l.8 2.2L22 18l-2.2.8L19 21l-.8-2.2L16 18l2.2-.8L19 15z"/></svg>
                            </span>
                            <div class="pd-sug-title-text">
                                <b>@(showRelated ? "محصولات مرتبط" : "بازدیدهای اخیر شما")</b>
                                <small>@(showRelated ? "گزینه‌های نزدیک به این محصول برای مقایسه" : "محصولاتی که اخیراً دیده‌اید")</small>
                            </div>
                        </div>
                        @if (hasRelated && hasRecent)
                        {
                            <div class="pd-sug-tabs" role="tablist" aria-label="انتخاب فهرست پیشنهادها">
                                <button type="button" role="tab" aria-selected="@showRelated" class="pd-sug-tab @(showRelated ? "pd-sug-tab--on" : "")" @onclick="() => _suggestTab = 0">
                                    مرتبط
                                    <span class="pd-sug-count">@relatedProducts!.Count</span>
                                </button>
                                <button type="button" role="tab" aria-selected="@(!showRelated)" class="pd-sug-tab @(!showRelated ? "pd-sug-tab--on" : "")" @onclick="() => _suggestTab = 1">
                                    بازدیدهای اخیر
                                    <span class="pd-sug-count">@recentList.Count</span>
                                </button>
                            </div>
                        }
                    </div>
                    <div class="pd-sug-track">
                        @foreach (var c in suggestCards)
                        {
                            <a href="@SeoUrl.Product(c.Id, c.Slug)" class="pd-sug-card">
                                <span class="pd-sug-media">
                                    @if (!string.IsNullOrEmpty(c.Image))
                                    {
                                        <img src="@c.Image" alt="@c.Name" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="pd-sug-placeholder">
                                            <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                                        </span>
                                    }
                                    @if (c.HasDiscount && c.Price > 0 && c.Effective < c.Price)
                                    {
                                        var off = (int)Math.Round((1 - (double)(c.Effective / c.Price)) * 100);
                                        if (off > 0)
                                        {
                                            <span class="pd-sug-off">@off٪</span>
                                        }
                                    }
                                </span>
                                <span class="pd-sug-body">
                                    <span class="pd-sug-name">@c.Name</span>
                                    <span class="pd-sug-price">
                                        <b>@c.Effective.ToString("N0")</b>
                                        <small>تومان</small>
                                        @if (c.HasDiscount && c.Effective < c.Price)
                                        {
                                            <del>@c.Price.ToString("N0")</del>
                                        }
                                    </span>
                                </span>
                            </a>
                        }
                    </div>
                </section>
            }

        }
    </div>
</div>

@if (showLightbox)
{
    <div class="pd-lightbox" @onkeydown="HandleLightboxKey" @onclick="CloseLightbox" tabindex="0" id="pd-lightbox-el">
        <div class="pd-lightbox-content" @onclick:stopPropagation>
            <button class="pd-lightbox-close" @onclick="CloseLightbox" aria-label="بستن">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>
            <div class="pd-lightbox-img-wrap">
                <img src="@GetAllImages()[_lightboxIndex]" alt="@product?.Name" class="pd-lightbox-img" decoding="async" />
            </div>
            <div class="pd-lightbox-counter">@(_lightboxIndex + 1) از @GetAllImages().Count</div>
            @if (GetAllImages().Count > 1)
            {
                <button class="pd-lightbox-nav pd-lightbox-prev" @onclick="PrevLightbox" @onclick:stopPropagation aria-label="قبلی">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                </button>
                <button class="pd-lightbox-nav pd-lightbox-next" @onclick="NextLightbox" @onclick:stopPropagation aria-label="بعدی">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                </button>
            }
        </div>
    </div>
}

<ShareModal Visible="showShareModal"
    OnClose="CloseShareModal"
    HeaderTitle="اشتراک‌گذاری محصول"
    LinkLabel="محصول"
    ImageUrl="@product?.MainImageUrl"
    PreviewTitle="@(product?.Name ?? "")"
    PreviewDescription="@(product != null ? TruncateText(StripHtml(product.Description ?? ""), 120) : "")"
    ShareUrl="@Nav.Uri"
    GetShareText="@(() => GetShareText())"
    GetShareTelegramText="@(() => GetShareTextForTelegram())" />

@if (_showConnectModal)
{
    <div class="pd-connect-overlay" @onclick="CloseConnectModal">
        <div class="pd-connect-modal" role="dialog" aria-modal="true" @onclick:stopPropagation="true">
            <button class="pd-connect-close" @onclick="CloseConnectModal" aria-label="بستن">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
            </button>

            <div class="pd-connect-head">
                <div class="pd-connect-icon">
                    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                </div>
                <h3>یادآوری شما ثبت شد!</h3>
                <p>برای دریافت پیام «موجود شدن کالا»، پیام‌رسان زیر را به حساب خود وصل کنید:</p>
