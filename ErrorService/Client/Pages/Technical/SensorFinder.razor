@page "/technical/sensor-finder"
@using ErrorService.Shared
@using ErrorService.Client.Services
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject LocalStorageService LocalStorage

<SeoHeader
    Title="سنسور یاب هوشمند | ارورسرویس"
    Description="سنسور یاب هوشمند ارورسرویس، جستجو و شناسایی سنسورهای لوازم خانگی با مشخصات فنی کامل"
    Keywords="سنسور لوازم خانگی, سنسور یاب, شناسایی سنسور, سنسور ماشین لباسشویی, سنسور یخچال"
    OgType="website" />

<div class="sf-page" dir="rtl">
    <section class="sf-hero">
        <div class="sf-container">
            <span class="sf-hero__eyebrow">
                <span class="oi oi-pulse" aria-hidden="true"></span>
                بانک اطلاعاتی سنسورها
            </span>
            <h1>سنسور یاب هوشمند</h1>
            <p>سنسورهای لوازم خانگی را بر اساس دستگاه پیدا کنید؛ همراه با نوع، اندازه، یادداشت‌های فنی و تصاویر.</p>
        </div>
    </section>

    <div class="sf-container sf-shell">
        <aside class="sf-panel">
            <div class="sf-panel__head">
                <span class="sf-panel__icon"><span class="oi oi-magnifying-glass" aria-hidden="true"></span></span>
                <div>
                    <h2 class="sf-panel__title">جستجوی سنسور</h2>
                    <p class="sf-panel__sub">دستگاه مورد نظر را انتخاب کنید</p>
                </div>
            </div>

            <label class="sf-label" for="sf-device">دستگاه</label>
            <div class="sf-select-wrap">
                <select id="sf-device" class="sf-select" @bind="selectedDeviceId" disabled="@isLoading">
                    <option value="0">انتخاب دستگاه (برند و مدل)</option>
                    @foreach (var d in devices)
                    {
                        <option value="@d.Id">@d.Name</option>
                    }
                </select>
                <span class="oi oi-chevron-bottom sf-select__chev" aria-hidden="true"></span>
            </div>

            <button type="button" class="sf-btn" @onclick="Search" disabled="@(selectedDeviceId <= 0 || isLoading)">
                @if (isLoading)
                {
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span>در حال جستجو...</span>
                }
                else
                {
                    <span class="oi oi-magnifying-glass" aria-hidden="true"></span>
                    <span>نمایش سنسورها</span>
                }
            </button>

            <p class="sf-panel__hint">
                <span class="oi oi-info" aria-hidden="true"></span>
                فهرست دستگاه‌ها از بانک سنسور ارورسرویس خوانده می‌شود.
            </p>

            @if (recentDevices.Any())
            {
                <div class="sf-recent">
                    <span class="sf-recent__label">
                        <span class="oi oi-clock" aria-hidden="true"></span>
                        آخرین جستجوها
                    </span>
                    <div class="sf-recent__list">
                        @foreach (var item in recentDevices)
                        {
                            <button type="button" class="sf-recent__chip" @onclick="() => QuickSearchAsync(item.Id)">
                                @item.Name
                            </button>
                        }
                    </div>
                </div>
            }
        </aside>

        <section class="sf-results" aria-live="polite" aria-busy="@(isLoading ? "true" : "false")">
            @if (isLoading)
            {
                <div class="sf-skel-list" aria-hidden="true">
                    @for (var i = 0; i < 3; i++)
                    {
                        <div class="sf-skel">
                            <span class="sf-skel__icon"></span>
                            <span class="sf-skel__lines">
                                <span class="sf-skel__line"></span>
                                <span class="sf-skel__line sf-skel__line--short"></span>
                            </span>
                        </div>
                    }
                </div>
            }
            else if (!hasSearched)
            {
                <div class="sf-state">
                    <span class="sf-state__icon"><span class="oi oi-pulse" aria-hidden="true"></span></span>
                    <div class="sf-state__body">
                        <h2>آماده جستجو</h2>
                        <p>دستگاه را از فهرست انتخاب کنید تا سنسورهای مرتبط با آن نمایش داده شود.</p>
                    </div>
                </div>
            }
            else if (records.Count == 0)
            {
                <div class="sf-state">
                    <span class="sf-state__icon sf-state__icon--warn"><span class="oi oi-warning" aria-hidden="true"></span></span>
                    <div class="sf-state__body">
                        <h2>نتیجه‌ای یافت نشد</h2>
                        <p>هنوز سنسوری برای این دستگاه ثبت نشده است. دستگاه دیگری را امتحان کنید.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="sf-head">
                    <div>
                        <h2 class="sf-head__title">سنسورهای دستگاه</h2>
                        @if (!string.IsNullOrWhiteSpace(searchedDeviceName))
                        {
                            <p class="sf-head__sub">@searchedDeviceName</p>
                        }
                    </div>
                    <span class="sf-count">@records.Count مورد</span>
                </div>

                <div class="sf-list">
                    @foreach (var r in records)
                    {
                        var isOpen = openRecordId == r.Id;
                        <article class="sf-item @(isOpen ? "is-open" : "")">
                            <button type="button" class="sf-item__head"
                                    @onclick="() => ToggleRow(r.Id)"
                                    aria-expanded="@(isOpen ? "true" : "false")">
                                <span class="sf-item__icon"><span class="oi oi-pulse" aria-hidden="true"></span></span>
                                <span class="sf-item__body">
                                    <span class="sf-item__name">@r.SensorName</span>
                                    @if (!string.IsNullOrWhiteSpace(r.SensorType) || !string.IsNullOrWhiteSpace(r.SizeText))
                                    {
                                        <span class="sf-item__meta">
                                            @if (!string.IsNullOrWhiteSpace(r.SensorType))
                                            {
                                                <span class="sf-chip">@r.SensorType</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(r.SizeText))
                                            {
                                                <span class="sf-chip sf-chip--size">@r.SizeText</span>
                                            }
                                        </span>
                                    }
                                </span>
                                <span class="sf-item__chev">
                                    <span class="oi @(isOpen ? "oi-chevron-top" : "oi-chevron-bottom")" aria-hidden="true"></span>
                                </span>
                            </button>

                            @if (isOpen)
                            {
                                var hasNote = !string.IsNullOrWhiteSpace(r.Notes);
                                var hasImages = r.Images != null && r.Images.Any();
                                <div class="sf-details @(hasNote && hasImages ? "" : "sf-details--single")">
                                    @if (hasNote)
                                    {
                                        <div class="sf-note">
                                            <span class="sf-note__label">
                                                <span class="oi oi-document" aria-hidden="true"></span>
                                                یادداشت‌های فنی
                                            </span>
                                            <p>@r.Notes</p>
                                        </div>
                                    }

                                    @if (hasImages)
                                    {
                                        <div class="sf-gallery">
                                            @foreach (var img in r.Images!.OrderBy(x => x.SortOrder))
                                            {
                                                <button type="button" class="sf-gallery__item" @onclick="() => OpenImage(img.Url, img.Title)" aria-label="بزرگ‌نمایی تصویر">
                                                    <img src="@ImageUrlHelper.Thumb(img.Url, 400)" loading="lazy" decoding="async" alt="@img.Title" />
                                                    <span class="sf-gallery__zoom"><span class="oi oi-zoom-in" aria-hidden="true"></span></span>
                                                </button>
                                            }
                                        </div>
                                    }

                                    <a href="@($"/technical/sensor-finder/{r.Id}")" class="sf-more">
                                        <span>مشاهده صفحه اختصاصی</span>
                                        <span class="oi oi-external-link" aria-hidden="true"></span>
                                    </a>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>
    </div>
</div>

@if (showImageModal)
{
    <div class="sf-modal" @onclick="CloseImage">
        <div class="sf-modal__box" @onclick:stopPropagation>
            <div class="sf-modal__head">
                <span class="sf-modal__title">@selectedImageTitle</span>
                <button type="button" class="sf-modal__close" @onclick="CloseImage" aria-label="بستن">&times;</button>
            </div>
            <div class="sf-modal__body">
                <img src="@selectedImageUrl" alt="@selectedImageTitle" class="sf-modal__img" decoding="async" />
            </div>
        </div>
    </div>
}

@code {
    private const string RecentKey = "es_sensor_recent";
    private const int RecentLimit = 5;

    private List<SensorFinderDeviceDto> devices = new();
    private List<SensorFinderRecordDto> records = new();
    private int selectedDeviceId;
    private bool isLoading;
    private bool hasSearched;
    private int? openRecordId;
    private string searchedDeviceName = "";
    private List<RecentDevice> recentDevices = new();
    private int? _lastAutoDeviceId;

    [SupplyParameterFromQuery(Name = "deviceId")]
    public int? DeviceId { get; set; }

    public sealed record RecentDevice(int Id, string Name);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            devices = await Http.GetFromJsonAsync<List<SensorFinderDeviceDto>>("api/sensor-finder/devices") ?? new();
        }
        catch { }

        await LoadRecentAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (DeviceId is null or <= 0 || DeviceId == _lastAutoDeviceId)
            return;

        if (!devices.Any(d => d.Id == DeviceId.Value))
            return;

        _lastAutoDeviceId = DeviceId;
        selectedDeviceId = DeviceId.Value;
        await Search();
    }

    private async Task Search()
    {
        if (selectedDeviceId <= 0) return;

        isLoading = true;
        hasSearched = true;
        openRecordId = null;
        searchedDeviceName = devices.FirstOrDefault(d => d.Id == selectedDeviceId)?.Name ?? "";

        try
        {
            records = await Http.GetFromJsonAsync<List<SensorFinderRecordDto>>($"api/sensor-finder/records?deviceId={selectedDeviceId}") ?? new();
        }
        catch
        {
            records = new();
        }

        isLoading = false;

        if (!string.IsNullOrWhiteSpace(searchedDeviceName))
            await RecordRecentAsync(selectedDeviceId, searchedDeviceName);
    }

    private async Task QuickSearchAsync(int deviceId)
    {
        selectedDeviceId = deviceId;
        await Search();
    }

    private async Task LoadRecentAsync()
    {
        try
        {
            var json = await LocalStorage.GetAsync(RecentKey);
            recentDevices = string.IsNullOrWhiteSpace(json)
                ? new()
                : JsonSerializer.Deserialize<List<RecentDevice>>(json) ?? new();

            recentDevices = recentDevices
                .Where(r => devices.Any(d => d.Id == r.Id))
                .Take(RecentLimit)
                .ToList();
        }
        catch
        {
            recentDevices = new();
        }
    }

    private async Task RecordRecentAsync(int deviceId, string name)
    {
        recentDevices.RemoveAll(r => r.Id == deviceId);
        recentDevices.Insert(0, new RecentDevice(deviceId, name));
        if (recentDevices.Count > RecentLimit)
            recentDevices = recentDevices.Take(RecentLimit).ToList();

        try
        {
            await LocalStorage.SetAsync(RecentKey, JsonSerializer.Serialize(recentDevices));
        }
        catch
        {
        }
    }

    private void ToggleRow(int id) => openRecordId = openRecordId == id ? null : id;

    private bool showImageModal;
    private string? selectedImageUrl;
    private string? selectedImageTitle;

    private void OpenImage(string url, string title)
    {
        selectedImageUrl = url;
        selectedImageTitle = title;
        showImageModal = true;
    }

    private void CloseImage() => showImageModal = false;
}
