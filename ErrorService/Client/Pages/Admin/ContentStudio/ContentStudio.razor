    // ===== پایش اجرا =====

    private void StartPolling()
    {
        if (_polling) return;
        _polling = true;
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    private async Task PollLoopAsync(CancellationToken token)
    {
        try
        {
            for (var i = 0; i < 400 && !token.IsCancellationRequested; i++)
            {
                await Task.Delay(2500, token);

                var overview = await Http.GetFromJsonAsync<ContentStudioOverviewDto>($"{ApiBase}/overview", token);
                if (overview == null) break;

                _overview = overview;
                if (_activeTab != "settings") _settings = overview.Settings;

                await LoadItems(true);
                if (_activeTab == "sources") await LoadSources();
                if (_activeTab == "runs") await LoadRuns();

                StateHasChanged();

                if (!overview.Progress.IsRunning) break;
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception ex)
        {
            Toast.ShowError("خطا در پایش اجرا: " + ex.Message);
        }
        finally
        {
            _polling = false;
            await InvokeAsync(StateHasChanged);
        }
    }

