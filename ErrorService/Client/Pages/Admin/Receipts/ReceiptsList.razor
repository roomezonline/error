    private async Task HandleContextAction(string action)
    {
        var item = contextMenuItem;
        CloseContextMenu();
        if (item == null) return;

        var elapsed = (DateTime.UtcNow - _contextMenuOpenedAt).TotalMilliseconds;
        if (elapsed < 250)
            await Task.Delay((int)(250 - elapsed));

        switch (action)
        {
            case "edit_invoice":
                Navigation.NavigateTo($"/admin/receipts/invoice/{item.Id}");
                break;
            case "edit_receipt":
                selected = item;
                showModal = true;
                isEditMode = true;
                Open(item);
                await ToggleEdit();
                break;
            case "monitoring":
                Navigation.NavigateTo($"/admin/receipts/monitoring/{item.Id}");
                break;
            case "customer_summary":
                await OpenCustomerSummary(item);
                break;
            case "print_invoice":
                OpenPrintModal(item);
                break;
            case "delete":
                _deleteReceipt = item;
                showConfirmDelete = true;
                break;
            case "commitment":
                await OpenCommitmentModal(item);
                break;
        }
    }

    private async Task OpenCommitmentModal(CustomerReceiptDto item)
    {
        _showCommitmentModal = true;
        _commitmentLoading = true;
        _commitmentDto = null;
        _commitmentSaving = false;
        StateHasChanged();

        try
        {
            var resp = await Http.GetAsync($"api/digital-commitments/by-receipt/{item.Id}");
            if (resp.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                _isNewCommitment = true;
                _isEditing = true;
                CommitmentExtraText = string.Empty;
                var customerName = $"{item.CustomerFirstName} {item.CustomerLastName}";
                var deviceBrand = item.DeviceBrandName;
                var registeredAtFa = PersianDateHelper.ToPersianDateTimeString(item.RegisteredAt, false);
                _commitmentPreviewBodyBefore = $"اینجانب {customerName} بابت یک دستگاه {item.DeviceTypeName}{(deviceBrand != null ? $" برند {deviceBrand}" : "")} به شماره پذیرش {item.Id} در تاریخ {registeredAtFa} در {item.WorkshopName}";
                _commitmentPreviewBodyAfter = " موافقت خود را اعلام میکنم";
                _commitmentDto = new DigitalCommitmentDto
                {
                    CustomerReceiptId = item.Id,
                    WorkshopName = item.WorkshopName,
                    CustomerFullName = customerName,
                    CustomerMobile = item.CustomerMobile,
                    DeviceTypeName = item.DeviceTypeName,
                    DeviceBrandName = item.DeviceBrandName,
                    ReceiptNumber = item.Id,
                    RegisteredAtFa = registeredAtFa,
                    Status = "pending"
                };
            }
            else if (resp.IsSuccessStatusCode)
            {
                var existing = await resp.Content.ReadFromJsonAsync<DigitalCommitmentDto>();
                if (existing != null)
                {
                    _isNewCommitment = false;
                    _isEditing = false;
                    _commitmentDto = existing;
                }
            }
            else
            {
                ToastService.ShowError("خطا در دریافت اطلاعات");
            }
        }
        catch
        {
            ToastService.ShowError("خطا در دریافت اطلاعات");
        }
        finally
        {
            _commitmentLoading = false;
            StateHasChanged();
        }
    }

    private async Task CreateCommitment()
    {
        _commitmentSaving = true;
        StateHasChanged();

        try
        {
            var request = new DigitalCommitmentCreateRequest
            {
                CustomerReceiptId = _commitmentDto!.CustomerReceiptId,
                ExtraBodyText = string.IsNullOrWhiteSpace(CommitmentExtraText) ? null : CommitmentExtraText
            };

            var resp = await Http.PostAsJsonAsync("api/digital-commitments", request);
            if (resp.IsSuccessStatusCode)
            {
                _commitmentDto = await resp.Content.ReadFromJsonAsync<DigitalCommitmentDto>();
                _isEditing = false;
                _isNewCommitment = false;

                var receipt = all?.FirstOrDefault(x => x.Id == _commitmentDto.CustomerReceiptId);
                if (receipt != null)
                    receipt.CommitmentStatus = "pending";

                ToastService.ShowSuccess("تعهدنامه با موفقیت ایجاد شد");
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(err);
            }
        }
        catch
        {
            ToastService.ShowError("خطا در ایجاد تعهدنامه");
        }
        finally
        {
            _commitmentSaving = false;
            StateHasChanged();
        }
    }

