    private bool ShouldShowDateSeparator(ChatMessageDto msg)
    {
        var idx = _messages.IndexOf(msg);
        if (idx <= 0) return true;
        return _messages[idx - 1].CreatedAt.ToLocalTime().Date != msg.CreatedAt.ToLocalTime().Date;
    }

    private static string DateSeparatorText(DateTime dt)
    {
        var local = dt.ToLocalTime();
        if (local.Date == DateTime.Today) return "امروز";
        if (local.Date == DateTime.Today.AddDays(-1)) return "دیروز";
        return local.ToString("yyyy/MM/dd");
    }

    private static string LinkifyContent(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";
        var escaped = System.Net.WebUtility.HtmlEncode(content);
        return System.Text.RegularExpressions.Regex.Replace(
            escaped,
            @"(https?://[^\s<>""']+)",
            "<a href=\"$1\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:inherit;text-decoration:underline;\">$1</a>");
    }

    private void SetRating(int val)
    {
        _ratingValue = val;
