@code {
    private const string ApiBase = "api/admin/content-studio";
    private static readonly JsonSerializerOptions JsonOpts = new(JsonSerializerDefaults.Web);

    private static readonly (string Value, string Label)[] QueueStatuses =
    {
        ("all", "همه"),
        ("Ready", "آماده"),
        ("Pending", "در انتظار"),
        ("Published", "منتشرشده"),
        ("Duplicate", "تکراری"),
        ("Failed", "خطا"),
        ("Skipped", "فیلترشده"),
        ("Rejected", "ردشده")
    };

    private ContentStudioOverviewDto? _overview;
    private ContentStudioSettingsDto? _settings;
    private ContentStudioItemListDto? _items;
    private List<ContentStudioSourceDto>? _sources;
    private List<ContentStudioRunDto>? _runs;
    private ContentStudioItemDto? _previewItem;

    private string _activeTab = "queue";
    private string _statusFilter = "all";
    private string _searchQuery = "";
    private int _page = 1;
    private int _pageSize = 20;

    private bool _loadingItems;
    private bool _savingSettings;
    private bool _testingAi;
    private bool _runStarting;
    private int? _actionBusyId;
    private int? _sourceBusyId;
    private ContentStudioAiTestResultDto? _aiTest;

    private bool _showSourceModal;
    private int? _editingSourceId;
    private ContentStudioSourceRequest _sourceForm = new();
    private string? _sourceError;
    private bool _savingSource;
    private bool _addingSuggested;
    private bool _testingFeed;
    private bool _discovering;
    private bool _uploadingImage;
    private ContentStudioTestFeedResultDto? _feedTest;
    private ContentStudioFeedDiscoverResultDto? _discover;

    private bool _showPreview;
    private bool _previewLoading;

    private bool _showDraftModal;
    private bool _draftLoading;
    private bool _draftSaving;
    private string? _draftError;
    private int? _draftItemId;
    private ContentStudioItemDto? _draftSource;
    private ContentStudioDraftRequest _draftForm = new();
    private DotNetObjectReference<ContentStudio>? _draftPasteRef;

    private bool _showSourceDeleteConfirm;
    private ContentStudioSourceDto? _sourceToDelete;
    private bool _showItemDeleteConfirm;
    private int? _itemToDelete;

    private CancellationTokenSource? _searchCts;
    private CancellationTokenSource? _pollCts;
    private bool _polling;

    private int QueueBadge => (_overview?.Stats.Ready ?? 0) + (_overview?.Stats.Pending ?? 0);
    private int TotalPages => _items == null || _items.PageSize <= 0
        ? 1
        : Math.Max(1, (int)Math.Ceiling(_items.Total / (double)_items.PageSize));
    private int ProgressPercent => _overview?.Progress is { Total: > 0 } p
        ? Math.Clamp((int)Math.Round(p.Processed * 100d / p.Total), 0, 100)
        : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadOverview();
        await LoadSources();
        await LoadItems();
        if (_overview?.Progress.IsRunning == true) StartPolling();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (_overview?.Progress.IsRunning == true) StartPolling();

        _draftPasteRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("csSetDraftPasteConverter", _draftPasteRef);
    }

    /// <summary>متن کپی‌شده (HTML سایت/ورد) را به نشانه‌های قابل ویرایش تبدیل می‌کند.</summary>
    [JSInvokable]
    public string ConvertPastedHtml(string? html)
    {
        var text = ManualMarkup.FromHtml(html);
        return text.Length > 20000 ? text[..20000] : text;
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _pollCts?.Cancel();
        _searchCts?.Dispose();
        _pollCts?.Dispose();
        _draftPasteRef?.Dispose();
    }

    private async Task SwitchTab(string tab)
    {
        _activeTab = tab;
        if (tab == "sources" && _sources == null) await LoadSources();
        if (tab == "runs") await LoadRuns();
    }

    // ===== بارگذاری =====

    private async Task LoadOverview()
    {
        try
        {
            _overview = await Http.GetFromJsonAsync<ContentStudioOverviewDto>($"{ApiBase}/overview");
            if (_overview != null && (_settings == null || _activeTab != "settings"))
                _settings = _overview.Settings;
        }
        catch (Exception ex)
        {
            Toast.ShowError("خطا در دریافت وضعیت استودیو: " + ex.Message);
        }
    }

    private async Task LoadSources()
    {
        try
        {
            _sources = await Http.GetFromJsonAsync<List<ContentStudioSourceDto>>($"{ApiBase}/sources");
        }
        catch (Exception ex)
        {
            Toast.ShowError("خطا در دریافت منابع: " + ex.Message);
        }
    }

    private async Task LoadItems(bool silent = false)
    {
        if (!silent) _loadingItems = true;
        try
        {
            var url = $"{ApiBase}/items?page={_page}&pageSize={_pageSize}";
            if (!string.IsNullOrWhiteSpace(_statusFilter) && _statusFilter != "all")
                url += $"&status={Uri.EscapeDataString(_statusFilter)}";
            if (!string.IsNullOrWhiteSpace(_searchQuery))
                url += $"&q={Uri.EscapeDataString(_searchQuery.Trim())}";

            _items = await Http.GetFromJsonAsync<ContentStudioItemListDto>(url);
            if (_items != null)
            {
                var maxPage = Math.Max(1, (int)Math.Ceiling(_items.Total / (double)_pageSize));
                if (_page > maxPage) _page = maxPage;
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError("خطا در دریافت صف بازبینی: " + ex.Message);
        }
        finally
        {
            if (!silent) _loadingItems = false;
        }
    }

    private async Task LoadRuns()
    {
        try
        {
            _runs = await Http.GetFromJsonAsync<List<ContentStudioRunDto>>($"{ApiBase}/runs?take=30");
        }
        catch (Exception ex)
        {
            Toast.ShowError("خطا در دریافت گزارش اجرا: " + ex.Message);
        }
    }

    // ===== فیلتر و صفحه =====

    private async Task FilterStatus(string status)
    {
        _statusFilter = status;
        _page = 1;
        await LoadItems();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(400, token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (token.IsCancellationRequested) return;
        _page = 1;
        await LoadItems();
    }

    private async Task PrevPage()
    {
        if (_page <= 1) return;
        _page--;
        await LoadItems();
    }

    private async Task NextPage()
    {
        if (_page >= TotalPages) return;
        _page++;
        await LoadItems();
    }

    private int CountFor(string status) => _items?.Counts.TryGetValue(status, out var count) == true
        ? count
        : status == "all" ? _items?.Counts.Values.Sum() ?? 0 : 0;

    // ===== اجرا و آیتم‌ها =====

    private async Task RunNow()
    {
        _runStarting = true;
        try
        {
            var resp = await Http.PostAsync($"{ApiBase}/run", null);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("اجرای دستی در پس‌زمینه شروع شد.");
                await LoadOverview();
                StartPolling();
            }
            else
            {
                Toast.ShowWarning(await ReadErrorAsync(resp) ?? "اجرا شروع نشد.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError("خطا در شروع اجرا: " + ex.Message);
        }
        finally
        {
            _runStarting = false;
        }
    }

    private async Task RewriteItem(int id)
    {
        _actionBusyId = id;
        try
        {
            var resp = await Http.PostAsync($"{ApiBase}/items/{id}/rewrite", null);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("بازنویسی در پس‌زمینه شروع شد.");
                ClosePreview();
                await LoadOverview();
                StartPolling();
            }
            else
            {
                Toast.ShowWarning(await ReadErrorAsync(resp) ?? "بازنویسی شروع نشد.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError("خطا در بازنویسی: " + ex.Message);
        }
        finally
        {
            _actionBusyId = null;
        }
    }

    private async Task PublishItem(int id, bool asDraft)
    {
        _actionBusyId = id;
        try
        {
            var resp = await Http.PostAsJsonAsync($"{ApiBase}/items/{id}/publish",
                new ContentStudioPublishRequest { AsDraft = asDraft });
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess(asDraft ? "پیش‌نویس خبر ساخته شد." : "خبر منتشر شد.");
                ClosePreview();
                await LoadOverview();
                await LoadItems();
                await LoadSources();
            }
            else
            {
                Toast.ShowWarning(await ReadErrorAsync(resp) ?? "انتشار انجام نشد.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError("خطا در انتشار: " + ex.Message);
        }
        finally
        {
            _actionBusyId = null;
        }
    }

    private async Task RejectItem(int id)
    {
        _actionBusyId = id;
        try
        {
            var resp = await Http.PostAsync($"{ApiBase}/items/{id}/reject", null);
            if (resp.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("آیتم رد شد.");
                ClosePreview();
                await LoadOverview();
                await LoadItems();
            }
            else
            {
                Toast.ShowWarning(await ReadErrorAsync(resp) ?? "رد آیتم انجام نشد.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError("خطا در رد آیتم: " + ex.Message);
        }
        finally
        {
            _actionBusyId = null;
        }
    }

    private void AskDeleteItem(int id)
