@page "/admin/faq"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using ErrorService.Shared
@using ErrorService.Client.Services
@attribute [Authorize(Policy = "perm:admin.faq.manage")]
@inject HttpClient Http
@inject ToastService Toast

<PageTitle>مدیریت سوالات متداول | ارورسرویس</PageTitle>

<div class="admin-container">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h3 class="admin-page-title m-0">مدیریت سوالات متداول</h3>
            <p class="text-muted small mb-0 mt-1">سوالات این بخش در صفحه <a href="/faq" target="_blank">/faq</a> و نتایج جستجوی سایت نمایش داده می‌شوند.</p>
        </div>
        <button type="button" class="btn btn-primary shadow-sm" @onclick="NewItem">
            <span class="oi oi-plus me-1"></span> سوال جدید
        </button>
    </div>

    <ConfirmDialog IsVisible="showConfirm"
                   Title="حذف سوال"
                   Message="@($"آیا از حذف سوال «{itemToDelete?.Question}» اطمینان دارید؟")"
                   OnResult="HandleDeleteResult" />

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <h5 class="fw-bold mb-3">@(editingId == 0 ? "افزودن سوال" : "ویرایش سوال")</h5>

                <EditForm Model="model" OnValidSubmit="SaveAsync">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label small fw-bold">سوال</label>
                        <InputText class="form-control" @bind-Value="model.Question" placeholder="متن سوال..." />
                        <ValidationMessage For="() => model.Question" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">پاسخ</label>
                        <InputTextArea class="form-control" rows="5" @bind-Value="model.Answer" placeholder="پاسخ کامل..." />
                        <ValidationMessage For="() => model.Answer" class="text-danger small" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-bold">دسته‌بندی</label>
                            <select class="form-select" @bind="model.CategoryKey">
                                @foreach (var cat in SiteFaqCatalog.Categories)
                                {
                                    <option value="@cat.Key">@cat.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-bold">ترتیب نمایش</label>
                            <InputNumber class="form-control" @bind-Value="model.SortOrder" />
                            <ValidationMessage For="() => model.SortOrder" class="text-danger small" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-bold">کلیدواژه‌ها (اختیاری)</label>
                        <InputText class="form-control" @bind-Value="model.Keywords" placeholder="با کاما جدا کنید" />
                        <div class="form-text">برای بهتر دیده‌شدن در جستجو؛ مثلاً: ارسال، پست، تیپاکس</div>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <InputCheckbox class="form-check-input" id="faqEnabled" @bind-Value="model.IsEnabled" />
                        <label class="form-check-label fw-bold small" for="faqEnabled">فعال و قابل نمایش در سایت</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1" disabled="@saving">
                            @(saving ? "در حال ذخیره..." : "ذخیره")
                        </button>
                        @if (editingId != 0)
                        {
                            <button type="button" class="btn btn-light" @onclick="NewItem">انصراف</button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 p-4">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h6 class="fw-bold mb-0">سوالات ثبت‌شده (@items.Count)</h6>
                    <input type="search" class="form-control form-control-sm" style="max-width:220px"
                           placeholder="جستجو در سوالات..." @bind="filter" @bind:event="oninput" />
                </div>

                @if (loading)
                {
                    <div class="text-center py-5 text-muted">
                        <span class="spinner-border spinner-border-sm"></span>
                    </div>
                }
                else if (FilteredItems.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <p class="mb-0">@(items.Count == 0 ? "هنوز سوالی ثبت نشده است." : "سوالی با این عبارت یافت نشد.")</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr class="small text-muted">
                                    <th>سوال</th>
                                    <th>دسته</th>
                                    <th>ترتیب</th>
                                    <th>وضعیت</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var x in FilteredItems)
                                {
                                    <tr class="@(x.IsEnabled ? "" : "opacity-75")">
                                        <td style="max-width:320px">
                                            <div class="fw-bold small text-truncate">@x.Question</div>
                                            <div class="text-muted text-truncate" style="font-size:.74rem">@x.Answer</div>
                                        </td>
                                        <td><span class="badge bg-light text-dark border">@SiteFaqCatalog.TitleOf(x.CategoryKey)</span></td>
                                        <td class="small">@x.SortOrder</td>
                                        <td>
                                            <button type="button" class="btn btn-sm @(x.IsEnabled ? "btn-success" : "btn-outline-secondary")"
                                                    @onclick="() => ToggleAsync(x)" title="تغییر وضعیت">
                                                @(x.IsEnabled ? "فعال" : "غیرفعال")
                                            </button>
                                        </td>
                                        <td class="text-nowrap">
                                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Edit(x)" title="ویرایش">
                                                <span class="oi oi-pencil"></span>
                                            </button>
                                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => AskDelete(x)" title="حذف">
                                                <span class="oi oi-trash"></span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<SiteFaqEntryDto> items = new();
    private bool loading = true;
    private bool saving;
    private string filter = "";

    private int editingId;
    private FaqFormModel model = new();

    private bool showConfirm;
    private SiteFaqEntryDto? itemToDelete;

    private List<SiteFaqEntryDto> FilteredItems
    {
        get
        {
            var q = SearchNormalizer.Normalize(filter);
            if (q.Length == 0) return items;

            return items.Where(x =>
                SearchNormalizer.Normalize($"{x.Question} {x.Answer} {x.Keywords} {SiteFaqCatalog.TitleOf(x.CategoryKey)}")
                    .Contains(q)).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            items = await Http.GetFromJsonAsync<List<SiteFaqEntryDto>>("api/admin/faq") ?? new();
        }
        catch
        {
            items = new();
            Toast.ShowError("خطا در دریافت سوالات متداول.");
        }
        loading = false;
    }

    private void NewItem()
    {
        editingId = 0;
        model = new FaqFormModel
        {
            SortOrder = items.Count == 0 ? 1 : items.Max(x => x.SortOrder) + 1,
            IsEnabled = true,
            CategoryKey = SiteFaqCatalog.DefaultCategoryKey
        };
    }

    private void Edit(SiteFaqEntryDto item)
    {
        editingId = item.Id;
        model = new FaqFormModel
        {
            Question = item.Question,
            Answer = item.Answer,
            CategoryKey = SiteFaqCatalog.Find(item.CategoryKey)?.Key ?? SiteFaqCatalog.DefaultCategoryKey,
            Keywords = item.Keywords,
            SortOrder = item.SortOrder,
            IsEnabled = item.IsEnabled
        };
    }

    private async Task SaveAsync()
    {
        saving = true;
        try
        {
            var payload = new SiteFaqUpsertRequest
            {
                Question = model.Question,
                Answer = model.Answer,
                CategoryKey = model.CategoryKey,
                Keywords = model.Keywords,
                SortOrder = model.SortOrder,
                IsEnabled = model.IsEnabled
            };

            var response = editingId == 0
                ? await Http.PostAsJsonAsync("api/admin/faq", payload)
                : await Http.PutAsJsonAsync($"api/admin/faq/{editingId}", payload);

            if (!response.IsSuccessStatusCode)
            {
                var message = await response.Content.ReadAsStringAsync();
                Toast.ShowError(string.IsNullOrWhiteSpace(message) ? "ذخیره سوال انجام نشد." : message);
                return;
            }

            Toast.ShowSuccess(editingId == 0 ? "سوال جدید ثبت شد." : "سوال به‌روزرسانی شد.");
            NewItem();
            await LoadAsync();
        }
        catch
        {
            Toast.ShowError("خطا در ارتباط با سرور.");
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ToggleAsync(SiteFaqEntryDto item)
    {
        try
        {
            var payload = new SiteFaqUpsertRequest
            {
                Question = item.Question,
                Answer = item.Answer,
                CategoryKey = item.CategoryKey,
                Keywords = item.Keywords,
                SortOrder = item.SortOrder,
                IsEnabled = !item.IsEnabled
            };

            var response = await Http.PutAsJsonAsync($"api/admin/faq/{item.Id}", payload);
            if (!response.IsSuccessStatusCode)
            {
                Toast.ShowError("تغییر وضعیت انجام نشد.");
                return;
            }

            item.IsEnabled = !item.IsEnabled;
            Toast.ShowSuccess(item.IsEnabled ? "سوال فعال شد." : "سوال غیرفعال شد.");
        }
        catch
        {
            Toast.ShowError("خطا در ارتباط با سرور.");
        }
    }

    private void AskDelete(SiteFaqEntryDto item)
    {
        itemToDelete = item;
        showConfirm = true;
    }

    private async Task HandleDeleteResult(bool confirmed)
    {
        showConfirm = false;
        if (!confirmed || itemToDelete == null) return;

        try
        {
            var response = await Http.DeleteAsync($"api/admin/faq/{itemToDelete.Id}");
            if (!response.IsSuccessStatusCode)
            {
                Toast.ShowError("حذف سوال انجام نشد.");
                return;
            }

            Toast.ShowSuccess("سوال حذف شد.");
            itemToDelete = null;
            await LoadAsync();
        }
        catch
        {
            Toast.ShowError("خطا در ارتباط با سرور.");
        }
    }

    public sealed class FaqFormModel
    {
        [Required(ErrorMessage = "متن سوال الزامی است.")]
        [StringLength(300, ErrorMessage = "متن سوال حداکثر ۳۰۰ کاراکتر است.")]
        public string Question { get; set; } = "";

        [Required(ErrorMessage = "متن پاسخ الزامی است.")]
        [StringLength(4000, ErrorMessage = "متن پاسخ حداکثر ۴۰۰۰ کاراکتر است.")]
        public string Answer { get; set; } = "";

        [Required]
        public string CategoryKey { get; set; } = SiteFaqCatalog.DefaultCategoryKey;

        [StringLength(500, ErrorMessage = "کلیدواژه‌ها حداکثر ۵۰۰ کاراکتر است.")]
        public string? Keywords { get; set; }

        [Range(0, 9999, ErrorMessage = "ترتیب نمایش باید بین ۰ تا ۹۹۹۹ باشد.")]
        public int SortOrder { get; set; }

        public bool IsEnabled { get; set; } = true;
    }
}
