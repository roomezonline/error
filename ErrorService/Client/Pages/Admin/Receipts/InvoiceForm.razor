    private async Task LoadData()
    {
        try
        {
            isLoading = true;
            Console.WriteLine($"Loading receipt data for ID: {ReceiptId}");
            var url = $"api/customer-receipts/{ReceiptId}";
            var response = await Http.GetAsync(url);
            Console.WriteLine($"API Response Status: {response.StatusCode}");
            
            if (response.IsSuccessStatusCode)
            {
                receipt = await response.Content.ReadFromJsonAsync<CustomerReceiptDto>();
                Console.WriteLine($"Receipt loaded: {receipt?.CustomerFirstName} {receipt?.CustomerLastName}");
                
                // Load technicians for the workshop
                if (receipt != null)
                {
                    try
                    {
                        var allUsers = await Http.GetFromJsonAsync<List<WorkshopUserDto>>($"api/workshop-auth/users?workshopId={receipt.WorkshopId}");
                        technicians = allUsers?.Where(x => x.IsTechnician && x.IsActive).ToList() ?? new();
                    }
                    catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized || ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
                    {
                        technicians = new List<WorkshopUserDto>();
                    }
                    catch
                    {
                        technicians = new List<WorkshopUserDto>();
                    }
                }

            newCatalogDeviceTypeId = receipt?.DeviceTypeId;
            await LoadDeviceTypesForReceipt();
            await LoadCatalog();

            if (receipt != null)
            {
                await LoadBankAccounts(receipt.WorkshopId);
            }

            receiptStatus = receipt?.Status ?? CustomerReceiptStatuses.Pending;
                isBadPayer = receipt?.CustomerIsBadPayer ?? false;

                try
                {
                    var billing = await Http.GetFromJsonAsync<CustomerReceiptBillingDto>($"api/customer-receipts/{ReceiptId}/billing");
                if (billing != null)
                {
                    billDiscount = billing.Discount;
                    billPrepaid = billing.Prepaid;
                    billPaid = billing.Paid;
                    selectedBankAccountId = billing.SelectedBankAccountId;

                    if (billing.Items != null && billing.Items.Any())
                    {
                        invoiceItems = billing.Items.Select(i => new InvoiceItem
                        {
                            Title = i.Title,
                            ActionDescription = i.ActionDescription,
                            UnitPrice = i.UnitPrice,
                            Quantity = i.Quantity,
                            TechnicianId = i.TechnicianId
                        }).ToList();
                    }
                }
                }
                catch
                {
                    // ignore
                }

                await LoadSmsLogCount();
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                Console.WriteLine($"API Error Content: {errorContent}");
                ToastService.ShowError($"خطا در دریافت اطلاعات: {response.StatusCode}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in LoadData: {ex.Message}");
            Console.WriteLine(ex.StackTrace);
            ToastService.ShowError("خطا در بارگذاری اطلاعات");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void AddItem()
    {
        if (string.IsNullOrWhiteSpace(newItemTitle))
        {
            ToastService.ShowError("لطفاً شرح آیتم را وارد کنید");
            return;
        }

        if (newItemUnitPrice < 0)
        {
            ToastService.ShowError("مبلغ نمی‌تواند منفی باشد");
            return;
        }

        invoiceItems.Add(new InvoiceItem
        {
            Title = newItemTitle,
            Quantity = newItemQuantity,
            UnitPrice = newItemUnitPrice
        });

        // Reset Inputs
        newItemTitle = "";
        newItemQuantity = 1;
        newItemUnitPrice = 0;
        
        ToastService.ShowInfo("آیتم اضافه شد");
    }

