@page "/admin/receipts/new"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.receipts.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JS
@inject ErrorService.Client.Services.ToastService ToastService
@inject ErrorService.Client.Services.AdminWorkshopSelectionService AdminWorkshopSelection
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@using ErrorService.Client.Shared
@using ErrorService.Client.Helpers

<PageTitle>ثبت رسید مشتری</PageTitle>

<div class="wr-page" dir="rtl">
    @if (isSuperAdmin && !selectedWorkshopId.HasValue)
    {
        <div class="workshop-warning-overlay">
            <div class="workshop-warning-content">
                <div class="workshop-warning-icon">⚠️</div>
                <h3 class="workshop-warning-title">انتخاب کارگاه الزامی است</h3>
                <p class="workshop-warning-text">شما به عنوان سوپر ادمین وارد شده‌اید. برای ثبت رسید، باید ابتدا یک کارگاه را از منوی بالای صفحه انتخاب کنید.</p>
                <div class="workshop-warning-steps">
                    <div class="workshop-warning-step">
                        <span class="step-number">۱</span>
                        <span class="step-text">روی آیکون کارگاه در بالای صفحه کلیک کنید</span>
                    </div>
                    <div class="workshop-warning-step">
                        <span class="step-number">۲</span>
                        <span class="step-text">کارگاه مورد نظر را از لیست انتخاب کنید</span>
                    </div>
                    <div class="workshop-warning-step">
                        <span class="step-number">۳</span>
                        <span class="step-text">سپس می‌توانید ثبت رسید را ادامه دهید</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="wr-header">
        <div class="wr-header__main">پذیرش دستگاه</div>
    </div>
    <div class="wr-steps">
            <div class="wr-step @(step == 1 ? "wr-step--active" : step > 1 ? "wr-step--done" : "")">1</div>
            <div class="wr-step-line"></div>
            <div class="wr-step @(step == 2 ? "wr-step--active" : step > 2 ? "wr-step--done" : "")">2</div>
            <div class="wr-step-line"></div>
            <div class="wr-step @(step == 3 ? "wr-step--active" : step > 3 ? "wr-step--done" : "")">3</div>
            <div class="wr-step-line"></div>
            <div class="wr-step @(step == 4 ? "wr-step--active" : step > 4 ? "wr-step--done" : "")">4</div>
            <div class="wr-step-line"></div>
            <div class="wr-step @(step == 5 ? "wr-step--active" : step > 5 ? "wr-step--done" : "")">5</div>
        </div>

    <div class="wr-shell @(isSuperAdmin && !selectedWorkshopId.HasValue ? "wr-shell--disabled" : "")">
        @if (isLoading)
        {
            <div class="wr-card">
                <div class="wr-loading">
                    <div class="spinner-border text-primary"></div>
                    <div class="wr-loading__text">در حال آماده‌سازی فرم...</div>
                </div>
            </div>
        }
        else
        {
            @if (step == 1)
            {
                <div class="wr-card">
                    <div class="wr-card__title">مرحله 1: انتخاب یا ثبت مشتری</div>

                    @if (selectedCustomer == null)
                    {
                        <div class="wr-field">
                            <div class="wr-label">انتخاب مشتری</div>
                            <button type="button" class="wr-btn wr-btn--select-customer" @onclick="OpenCustomerModal">
                                <span class="oi oi-magnifying-glass"></span>
                                جستجو و انتخاب مشتری
                            </button>
                            <div class="wr-hint">با کلیک، لیست مشتریان را جستجو و انتخاب کنید</div>
                        </div>
                    }

                    <CustomerSearchModal WorkshopId="@uploadWorkshopId"
                                         Visible="@showCustomerModal"
                                         OnCustomerSelected="OnModalCustomerSelected"
                                         OnDismiss="CloseCustomerModal" />

                    @if (selectedCustomer != null)
                    {
                        <div class="wr-customer-card">
                            <div class="wr-customer-card__body">
                                <div class="wr-customer-avatar" aria-hidden="true">@GetCustomerInitial(selectedCustomer)</div>
                                <div class="wr-customer-card__info">
                                    <div class="wr-customer-card__name">@selectedCustomer.FirstName @selectedCustomer.LastName</div>
                                    <div class="wr-customer-card__mobile ltr">@selectedCustomer.Mobile</div>
                                    @if (!string.IsNullOrWhiteSpace(selectedCustomer.Address))
                                    {
                                        <div class="wr-customer-card__addr">@selectedCustomer.Address</div>
                                    }
                                    else
                                    {
                                        <div class="wr-customer-card__addr wr-customer-card__addr--empty">آدرس ثبت نشده</div>
                                    }
                                </div>
                            </div>
                            <div class="wr-customer-card__actions">
                                <button type="button" class="wr-customer-card__btn wr-customer-card__btn--edit" @onclick="OpenCustomerEditSheet">
                                    <span class="oi oi-pencil"></span>
                                    <span>ویرایش</span>
                                </button>
                                <button type="button" class="wr-customer-card__btn wr-customer-card__btn--clear" title="لغو انتخاب مشتری" @onclick="ClearCustomerSelection">
                                    <span class="oi oi-x"></span>
                                    <span>لغو</span>
                                </button>
                            </div>
                        </div>
                    }

                    <div class="wr-divider"></div>

                    <div class="wr-card__subtitle">ثبت مشتری جدید</div>

                    <EditForm Model="newCustomer" OnValidSubmit="CreateCustomer">
                        <DataAnnotationsValidator />

                        <div class="wr-grid">
                            <div class="wr-field">
                                <div class="wr-label">نام</div>
                                <input class="wr-input" @bind="newCustomer.FirstName" placeholder="مثلاً علی (اختیاری)" />
                            </div>
                            <div class="wr-field">
                                <div class="wr-label">نام خانوادگی</div>
                                <input class="wr-input" @bind="newCustomer.LastName" placeholder="مثلاً قنواتی" />
                                <ValidationMessage For="() => newCustomer.LastName" />
                            </div>
                            <div class="wr-field">
                                <div class="wr-label">موبایل</div>
                                <input class="wr-input ltr" @bind="newCustomer.Mobile" placeholder="09xxxxxxxxx" inputmode="numeric" pattern="[0-9]*" @onblur="NormalizeMobile" />
                                <ValidationMessage For="() => newCustomer.Mobile" />
                            </div>
                            <div class="wr-field">
                                <div class="wr-label">آدرس</div>
                                <input class="wr-input" @bind="newCustomer.Address" placeholder="اختیاری" />
                                <ValidationMessage For="() => newCustomer.Address" />
                            </div>
                        </div>

                        <div class="wr-actions">
                            <button type="submit" class="wr-btn wr-btn--secondary" disabled="@(!CanWorkOnWorkshop)">ثبت مشتری</button>
                            @if (selectedCustomer != null)
                            {
                                <button type="button" class="wr-btn" @onclick="Next">مرحله بعد</button>
                            }
                        </div>
                    </EditForm>
                </div>
            }
            else if (step == 2)
            {
                <div class="wr-card">
                    <div class="wr-card__title">مرحله 2: انتخاب دستگاه و برند</div>

                    <div class="wr-field">
                        <div class="wr-label">نوع دستگاه</div>
                        <div class="wr-input-row">
                            <select class="wr-select wr-select--flex" @bind="deviceTypeId" @bind:after="OnDeviceTypeChanged">
                                <option value="0">انتخاب کنید...</option>
                                @if (deviceTypes != null)
                                {
                                    @foreach (var dt in deviceTypes)
                                    {
                                        <option value="@dt.Id">@dt.Name</option>
                                    }
                                }
                            </select>
                            <AuthorizeView Policy="perm:admin.technical.devices.manage">
                                <Authorized>
                                    <button type="button" class="wr-mini-btn" @onclick="async () => { await LoadAllDeviceTypes(); showDeviceTypeModal = true; }" title="مدیریت نوع دستگاه‌ها">
                                        <span class="oi oi-plus"></span>
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </div>

                    <div class="wr-field">
                        <div class="wr-label">برند</div>
                        <div class="wr-input-row">
                            <select class="wr-select wr-select--flex" @bind="deviceBrandId" disabled="@(deviceTypeId <= 0)">
                                <option value="">(اختیاری) انتخاب کنید...</option>
                                @if (deviceBrands != null)
                                {
                                    @foreach (var b in deviceBrands)
                                    {
                                        <option value="@b.Id">@b.Name</option>
                                    }
                                }
                            </select>
                            <AuthorizeView Policy="perm:admin.technical.brands.manage">
                                <Authorized>
                                    <button type="button" class="wr-mini-btn" @onclick="async () => { await LoadAllDeviceBrands(); showDeviceBrandModal = true; }" title="مدیریت برندها" disabled="@(deviceTypeId <= 0)">
                                        <span class="oi oi-plus"></span>
                                    </button>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                        <div class="wr-hint">برند بر اساس نوع دستگاه فیلتر می‌شود.</div>
                    </div>

                    <div class="wr-actions">
                        <button type="button" class="wr-btn wr-btn--ghost" @onclick="Prev">بازگشت</button>
                        <button type="button" class="wr-btn" @onclick="Next" disabled="@(deviceTypeId <= 0)">مرحله بعد</button>
                    </div>
                </div>
            }
            else if (step == 3)
            {
                <div class="wr-card">
                    <div class="wr-card__title">مرحله 3: شرح مشکل و تکنسین</div>

                    <div class="wr-field">
                        <div class="wr-label">شرح مشکل / ایراد دستگاه</div>
                        <textarea class="wr-textarea" @bind="problemDescription" placeholder="جزئیات خرابی و قطعات همراه..."></textarea>
                    </div>

                    <div class="wr-field">
                        <div class="wr-label">ارجاع به تکنسین (اختیاری)</div>
                        <select class="wr-select" @bind="technicianId">
                            <option value="">-- انتخاب تکنسین --</option>
                            @if (technicians != null)
                            {
                                @foreach (var tech in technicians)
                                {
                                    <option value="@tech.Id">@tech.FullName</option>
                                }
                            }
                        </select>
                        <div class="wr-hint">در صورت عدم انتخاب، رسید در صف انتظار عمومی باقی می‌ماند.</div>
                    </div>

                    <div class="wr-field">
                        <div class="wr-label">تاریخ ثبت (شمسی)</div>
                        <input class="wr-input ltr" data-jdp @bind="registeredAtPersian" placeholder="انتخاب تاریخ..." />
                        <div class="wr-hint">پیش‌فرض: امروز</div>
                    </div>

                    <div class="wr-actions">
                        <button type="button" class="wr-btn wr-btn--ghost" @onclick="Prev">بازگشت</button>
                        <button type="button" class="wr-btn" @onclick="Next" disabled="@(string.IsNullOrWhiteSpace(problemDescription) || problemDescription.Trim().Length < 5)">مرحله بعد</button>
                    </div>
                </div>
            }
            else if (step == 4)
            {
                <div class="wr-card">
                    <div class="wr-card__title">مرحله 4: آپلود تصویر رسید</div>

                    <div class="wr-field mb-4">
                        <div class="wr-label">تصویر دستگاه/رسید</div>
                        <ImageUploader @bind-ImageUrl="previewUrl"
                                       UploadUrl="api/customer-receipts/upload"
                                       WorkshopId="@uploadWorkshopId"
                                       RequireWorkshopId="@isSuperAdmin" />
                    </div>

                    <div class="wr-actions">
                        <button type="button" class="wr-btn wr-btn--ghost" @onclick="Prev">بازگشت</button>
                        <button type="button" class="wr-btn" @onclick="Next">مرحله بعد</button>
                    </div>
                </div>
            }
            else if (step == 5)
            {
                <div class="wr-card">
                    <div class="wr-card__title">مرحله 5: تایید نهایی</div>
                    
                    <div class="wr-preview-bill">
                        <div class="wr-pb-row">
                            <span class="wr-pb-label">پذیرش توسط</span>
                            <span class="wr-pb-dots"></span>
                            <span class="wr-pb-val">@(string.IsNullOrWhiteSpace(currentUserFullName) ? "-" : currentUserFullName)</span>
                        </div>
                        <div class="wr-pb-row">
                            <span class="wr-pb-label">تاریخ ثبت</span>
                            <span class="wr-pb-dots"></span>
                            <span class="wr-pb-val ltr">@registeredAtPersian</span>
                        </div>
                        <div class="wr-pb-row wr-pb-row--with-action">
                            <span class="wr-pb-label">مشتری</span>
                            <span class="wr-pb-dots"></span>
                            <span class="wr-pb-val">@selectedCustomer?.FirstName @selectedCustomer?.LastName</span>
                            @if (selectedCustomer != null)
                            {
                                <button type="button" class="wr-pb-edit" title="ویرایش مشتری" @onclick="OpenCustomerEditSheet">
                                    <span class="oi oi-pencil"></span>
                                </button>
                            }
                        </div>
                        <div class="wr-pb-row">
                            <span class="wr-pb-label">موبایل</span>
                            <span class="wr-pb-dots"></span>
                            <span class="wr-pb-val ltr">@selectedCustomer?.Mobile</span>
                        </div>
                        <div class="wr-pb-row">
                            <span class="wr-pb-label">دستگاه</span>
                            <span class="wr-pb-dots"></span>
                            <span class="wr-pb-val">
                                @(deviceTypes?.FirstOrDefault(x => x.Id == deviceTypeId)?.Name)
                                @if (deviceBrandId.HasValue)
                                {
                                    <span> - @(deviceBrands?.FirstOrDefault(x => x.Id == deviceBrandId.Value)?.Name)</span>
                                }
                            </span>
                        </div>
                        <div class="wr-pb-row">
                            <span class="wr-pb-label">تکنسین</span>
                            <span class="wr-pb-dots"></span>
                            <span class="wr-pb-val">@(technicians?.FirstOrDefault(x => x.Id == technicianId)?.FullName ?? "نامشخص")</span>
                        </div>
                        
                        <div class="wr-pb-chip-title">شرح مشکل</div>
                        <div class="wr-pb-chip">@problemDescription</div>

                        @if (!string.IsNullOrEmpty(previewUrl))
                        {
                            <div class="wr-pb-chip-title">تصویر ضمیمه</div>
                            <div class="wr-pb-img-wrap">
                                <img src="@previewUrl" class="wr-pb-img" />
                            </div>
                        }
                    </div>

                    <div class="wr-actions">
                        <button type="button" class="wr-btn wr-btn--ghost" @onclick="Prev">ویرایش</button>
                        <button type="button" class="wr-btn" @onclick="Submit" disabled="@isSubmitting">
                            @if (isSubmitting) { <span class="spinner-border spinner-border-sm"></span> }
                            تایید و ثبت نهایی
                        </button>
                    </div>
                </div>
            }
        }
    </div>
</div>

@if (showCustomerEditSheet && selectedCustomer != null)
{
    <div class="wr-sheet-backdrop @(customerSheetVisible ? "wr-sheet-backdrop--visible" : "")" @onclick="CloseCustomerEditSheet"></div>
    <div class="wr-bottom-sheet @(customerSheetVisible ? "wr-bottom-sheet--visible" : "")" @onclick:stopPropagation>
        <div class="wr-bottom-sheet__handle" aria-hidden="true"></div>
        <div class="wr-bottom-sheet__header">
            <h3 class="wr-bottom-sheet__title">ویرایش اطلاعات مشتری</h3>
            <button type="button" class="wr-bottom-sheet__close" title="بستن" @onclick="CloseCustomerEditSheet">
                <span class="oi oi-x"></span>
            </button>
        </div>

        <EditForm Model="editCustomer" OnValidSubmit="SaveCustomerEdit">
            <DataAnnotationsValidator />

            <div class="wr-sheet-customer-preview">
                <div class="wr-customer-avatar wr-customer-avatar--lg">@GetCustomerInitial(selectedCustomer)</div>
                <div class="wr-sheet-customer-preview__meta">
                    <div class="wr-sheet-customer-preview__label">شماره موبایل فعلی</div>
                    <div class="wr-sheet-customer-preview__mobile ltr">@selectedCustomer.Mobile</div>
                </div>
            </div>

            <div class="wr-sheet-form">
                <div class="wr-field">
                    <div class="wr-label">نام</div>
                    <input class="wr-input" @bind="editCustomer.FirstName" placeholder="نام" />
                    <ValidationMessage For="() => editCustomer.FirstName" />
                </div>
                <div class="wr-field">
                    <div class="wr-label">نام خانوادگی</div>
                    <input class="wr-input" @bind="editCustomer.LastName" placeholder="نام خانوادگی" />
                    <ValidationMessage For="() => editCustomer.LastName" />
                </div>
                <div class="wr-field">
                    <div class="wr-label">شماره موبایل جدید</div>
                    <input class="wr-input ltr" @bind="editCustomer.Mobile" placeholder="09xxxxxxxxx" inputmode="tel" @onblur="NormalizeEditMobile" />
                    <ValidationMessage For="() => editCustomer.Mobile" />
                    @if (!string.IsNullOrWhiteSpace(editCustomer.Mobile) && editCustomer.Mobile != selectedCustomer.Mobile)
                    {
                        <div class="wr-hint wr-hint--warning">توجه: با تغییر شماره موبایل، تاریخچه مشتری به شماره جدید منتقل می‌شود.</div>
                    }
                </div>
                <div class="wr-field">
                    <div class="wr-label">آدرس</div>
                    <textarea class="wr-textarea wr-textarea--compact" rows="3" @bind="editCustomer.Address" placeholder="اختیاری"></textarea>
                    <ValidationMessage For="() => editCustomer.Address" />
                </div>
            </div>

            <div class="wr-bottom-sheet__footer">
                <button type="button" class="wr-btn wr-btn--ghost wr-btn--block" @onclick="CloseCustomerEditSheet" disabled="@isSavingCustomerEdit">انصراف</button>
                <button type="submit" class="wr-btn wr-btn--block" disabled="@isSavingCustomerEdit">
                    @if (isSavingCustomerEdit) { <span class="spinner-border spinner-border-sm"></span> }
                    ذخیره تغییرات
                </button>
            </div>
        </EditForm>
    </div>
}

<!-- Device Type Modal -->
@if (showDeviceTypeModal)
{
    <div class="modal-overlay" @onclick="() => { showDeviceTypeModal = false; ResetDeviceTypeForm(); }">
        <div class="modal-content modal-content--large" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">مدیریت نوع دستگاه‌ها</h3>
                <button class="modal-close" @onclick="() => { showDeviceTypeModal = false; ResetDeviceTypeForm(); }">
                    <span class="oi oi-x"></span>
                </button>
            </div>
            <div class="modal-body">
                <div class="modal-form-section">
                    <div class="modal-field">
                        <label class="modal-label">@(!isEditingDeviceType ? "افزودن نوع دستگاه جدید" : "ویرایش نوع دستگاه")</label>
                        <div class="modal-input-row">
                            <input class="modal-input modal-input--flex" @bind="newDeviceType.Name" placeholder="مثلاً: یخچال، تلویزیون، ماشین لباسشویی" />
                            <button class="modal-btn modal-btn--primary modal-btn--small" @onclick="AddDeviceType" disabled="@isSavingDeviceType">
                                @if (isSavingDeviceType) { <span class="spinner-border spinner-border-sm"></span> }
                                @(isEditingDeviceType ? "ذخیره" : "افزودن")
                            </button>
                            @if (isEditingDeviceType)
                            {
                                <button class="modal-btn modal-btn--ghost modal-btn--small" @onclick="ResetDeviceTypeForm">انصراف</button>
                            }
                        </div>
                    </div>
                </div>
                
                <div class="modal-divider"></div>
                
                <div class="modal-list-section">
                    <label class="modal-label">لیست نوع دستگاه‌ها</label>
                    @if (allDeviceTypes == null || allDeviceTypes.Count == 0)
                    {
                        <div class="modal-empty">نوع دستگاهی یافت نشد</div>
                    }
                    else
                    {
                        <div class="modal-list">
                            @foreach (var dt in allDeviceTypes)
                            {
                                <div class="modal-list-item">
                                    <span class="modal-list-item__name">@dt.Name</span>
                                    <div class="modal-list-item__actions">
                                        <button class="modal-action-btn modal-action-btn--edit" @onclick="() => EditDeviceType(dt)" title="ویرایش">
                                            <span class="oi oi-pencil"></span>
                                        </button>
                                        <button class="modal-action-btn modal-action-btn--delete" @onclick="() => DeleteDeviceType(dt.Id)" title="حذف">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- Device Brand Modal -->
@if (showDeviceBrandModal)
{
    <div class="modal-overlay" @onclick="() => { showDeviceBrandModal = false; ResetDeviceBrandForm(); }">
        <div class="modal-content modal-content--large" @onclick:stopPropagation>
            <div class="modal-header">
                <h3 class="modal-title">مدیریت برندها</h3>
                <button class="modal-close" @onclick="() => { showDeviceBrandModal = false; ResetDeviceBrandForm(); }">
                    <span class="oi oi-x"></span>
                </button>
            </div>
            <div class="modal-body">
                <div class="modal-form-section">
                    <div class="modal-field">
                        <label class="modal-label">@(!isEditingDeviceBrand ? "افزودن برند جدید" : "ویرایش برند")</label>
                        <div class="modal-input-row">
                            <input class="modal-input modal-input--flex" @bind="newDeviceBrand.Name" placeholder="مثلاً: سامسونگ، ال‌جی، امرسان" />
                            <button class="modal-btn modal-btn--primary modal-btn--small" @onclick="AddDeviceBrand" disabled="@isSavingDeviceBrand">
                                @if (isSavingDeviceBrand) { <span class="spinner-border spinner-border-sm"></span> }
                                @(isEditingDeviceBrand ? "ذخیره" : "افزودن")
                            </button>
                            @if (isEditingDeviceBrand)
                            {
                                <button class="modal-btn modal-btn--ghost modal-btn--small" @onclick="ResetDeviceBrandForm">انصراف</button>
                            }
                        </div>
                        @if (!isEditingDeviceBrand && deviceTypeId <= 0)
                        {
                            <div class="modal-hint">برای افزودن برند، ابتدا نوع دستگاه را انتخاب کنید</div>
                        }
                    </div>
                </div>
                
                <div class="modal-divider"></div>
                
                <div class="modal-list-section">
                    <label class="modal-label">لیست برندها</label>
                    @if (allDeviceBrands == null || allDeviceBrands.Count == 0)
                    {
                        <div class="modal-empty">برندی یافت نشد</div>
                    }
                    else
                    {
                        <div class="modal-list">
                            @foreach (var db in allDeviceBrands)
                            {
                                <div class="modal-list-item">
                                    <div class="modal-list-item__info">
                                        <span class="modal-list-item__name">@db.Name</span>
                                        @if (!string.IsNullOrWhiteSpace(db.DeviceTypeName))
                                        {
                                            <span class="modal-list-item__sub">@db.DeviceTypeName</span>
                                        }
                                    </div>
                                    <div class="modal-list-item__actions">
                                        <button class="modal-action-btn modal-action-btn--edit" @onclick="() => EditDeviceBrand(db)" title="ویرایش">
                                            <span class="oi oi-pencil"></span>
                                        </button>
                                        <button class="modal-action-btn modal-action-btn--delete" @onclick="() => DeleteDeviceBrand(db.Id)" title="حذف">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteDeviceTypeConfirm"
               Title="حذف نوع دستگاه"
               Message="آیا از حذف این نوع دستگاه اطمینان دارید؟"
               OnResult="HandleDeleteDeviceTypeConfirm" />

 <ConfirmDialog IsVisible="showDeleteDeviceBrandConfirm"
               Title="حذف برند"
               Message="آیا از حذف این برند اطمینان دارید؟"
               OnResult="HandleDeleteDeviceBrandConfirm" />

<!-- SMS Confirmation Modal -->
@if (showSmsModal && createdReceipt != null)
{
    var customerName = $"{createdReceipt.CustomerFirstName} {createdReceipt.CustomerLastName}";
    var regDate = PersianDateHelper.ToPersianDateTimeString(createdReceipt.RegisteredAt, false);

    <div class="sms-overlay @(smsSent ? "sms-overlay--sent" : "")" @onclick="CloseSmsModal">
        <div class="sms-sheet" @onclick:stopPropagation>
            <div class="sms-sheet-handle"></div>

            <div class="sms-sheet-header">
                <div class="sms-sheet-icon">
                    <span class="oi oi-envelope-open"></span>
                </div>
                <h3 class="sms-sheet-title">ارسال پیامک تأیید پذیرش</h3>
                <p class="sms-sheet-subtitle">پس از تأیید، پیامک برای مشتری ارسال می‌شود</p>
            </div>

            <div class="sms-sheet-body">
                <!-- Receipt Summary Chips -->
                <div class="sms-chips-row">
                    <span class="sms-chip sms-chip--customer">
                        <span class="sms-chip-icon oi oi-person"></span>
                        @customerName
                    </span>
                    <span class="sms-chip sms-chip--mobile">
                        <span class="sms-chip-icon oi oi-phone"></span>
                        @createdReceipt.CustomerMobile
                    </span>
                    <span class="sms-chip sms-chip--device">
                        <span class="sms-chip-icon oi oi-wrench"></span>
                        @createdReceipt.DeviceTypeName (@(createdReceipt.DeviceBrandName ?? ""))
                    </span>
                    <span class="sms-chip sms-chip--workshop">
                        <span class="sms-chip-icon oi oi-briefcase"></span>
                        @createdReceipt.WorkshopName
                    </span>
                    <span class="sms-chip sms-chip--date">
                        <span class="sms-chip-icon oi oi-calendar"></span>
                        @regDate
                    </span>
                    <span class="sms-chip sms-chip--id">
                        <span class="sms-chip-icon oi oi-tag"></span>
                        #@createdReceipt.Id
                    </span>
                </div>

                <!-- SMS Preview -->
                <div class="sms-preview-section">
                    <div class="sms-preview-header">
                        <span class="oi oi-comment-square"></span>
                        پیش‌نمایش پیامک
                    </div>
                    <div class="sms-preview-bubble">
                        <pre class="sms-preview-text">@smsPreviewText</pre>
                    </div>
                </div>

                @if (smsSent)
                {
                    <div class="sms-success-banner">
                        <span class="oi oi-circle-check"></span>
                        پیامک با موفقیت ارسال شد
                    </div>
                }
            </div>

            <div class="sms-sheet-footer">
                @if (!smsSent)
                {
                    <button class="sms-btn sms-btn--primary" @onclick="SendSms" disabled="@isSendingSms">
                        @if (isSendingSms) { <span class="spinner-border spinner-border-sm"></span> }
                        <span class="oi oi-envelope-closed"></span>
                        ارسال پیامک
                    </button>
                    <button class="sms-btn sms-btn--ghost" @onclick="CloseSmsModal">بعداً ارسال می‌کنم</button>
                }
                else
                {
                    <button class="sms-btn sms-btn--primary" @onclick="NavToList">
                        <span class="oi oi-arrow-right"></span>
                        بازگشت به لیست رسیدها
                    </button>
                }
            </div>
        </div>
    </div>
}

<style>
    :root {
        --wr-bg: #f6f7ff;
        --wr-surface: #ffffff;
        --wr-text: #0f172a;
        --wr-muted: #64748b;
        --wr-border: rgba(2, 6, 23, 0.06);
        --wr-primary: #4f46e5;
        --wr-primary-2: #7c3aed;
        --wr-shadow: 0 14px 34px rgba(15, 23, 42, 0.07);
        --wr-radius: 22px;
    }

    .ltr { direction: ltr; }

    .wr-page {
        min-height: 100vh;
        background:
            radial-gradient(900px 240px at 90% 0%, rgba(124, 58, 237, 0.12), rgba(124, 58, 237, 0) 60%),
            radial-gradient(700px 220px at 10% 0%, rgba(79, 70, 229, 0.14), rgba(79, 70, 229, 0) 55%),
            var(--wr-bg);
        padding-bottom: 80px;
    }

    .wr-header {
        position: sticky;
        top: 0;
        z-index: 50;
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        background: rgba(246, 247, 255, 0.78);
        border-bottom: 1px solid rgba(2, 6, 23, 0.06);
        padding: 14px 16px 12px;
    }

    .wr-header__row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 10px;
    }

    .wr-back {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 16px;
        text-decoration: none;
        background: rgba(255,255,255,0.8);
        border: 1px solid rgba(2, 6, 23, 0.08);
        color: var(--wr-text);
        box-shadow: 0 10px 24px rgba(15, 23, 42, 0.08);
    }

    .wr-header__kicker {
        font-size: 0.75rem;
        font-weight: 800;
        color: rgba(79, 70, 229, 0.95);
    }

    .wr-header__main {
        font-size: 1.05rem;
        font-weight: 900;
        color: var(--wr-text);
        line-height: 1.2;
    }

    .wr-steps {
        display: grid;
        grid-template-columns: 28px 1fr 28px 1fr 28px 1fr 28px 1fr 28px;
        align-items: center;
        gap: 8px;
        margin-top: 16px;
        padding: 0 16px;
    }

    .wr-step {
        width: 28px;
        height: 28px;
        border-radius: 999px;
        display: grid;
        place-items: center;
        font-weight: 900;
        font-size: 0.85rem;
        background: rgba(15, 23, 42, 0.06);
        color: rgba(15, 23, 42, 0.55);
    }

    .wr-step--active {
        background: rgba(79, 70, 229, 0.14);
        color: var(--wr-primary);
        border: 1px solid rgba(79, 70, 229, 0.22);
    }

    .wr-step--done {
        background: rgba(16, 185, 129, 0.12);
        color: rgba(16, 185, 129, 0.95);
        border: 1px solid rgba(16, 185, 129, 0.22);
    }

    .wr-step-line {
        height: 2px;
        background: rgba(2, 6, 23, 0.08);
        border-radius: 999px;
    }

    .wr-shell {
        max-width: 900px;
        margin: 0 auto;
        padding: 16px 1px;
    }

    .wr-card {
        background: var(--wr-surface);
        border: 1px solid var(--wr-border);
        border-radius: var(--wr-radius);
        box-shadow: var(--wr-shadow);
        padding: 16px;
    }

    .wr-card__title {
        font-weight: 900;
        color: var(--wr-text);
        margin-bottom: 14px;
    }

    .wr-card__subtitle {
        font-weight: 900;
        color: rgba(15, 23, 42, 0.85);
        margin: 12px 0 10px;
        font-size: 0.9rem;
    }

    .wr-field { margin-bottom: 12px; }

    .wr-label {
        font-weight: 900;
        font-size: 0.8rem;
        color: rgba(15, 23, 42, 0.80);
        margin-bottom: 8px;
    }

    .wr-hint {
        font-size: 0.75rem;
        color: var(--wr-muted);
        margin-top: 4px;
    }

    .wr-mini-btn {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        border: 1px solid var(--wr-border);
        background: var(--wr-surface);
        color: var(--wr-primary);
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: all 0.2s ease;
        font-size: 0.9rem;
    }

    .wr-mini-btn:hover:not(:disabled) {
        background: var(--wr-primary);
        color: white;
        border-color: var(--wr-primary);
        transform: scale(1.05);
    }

    .wr-mini-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

    .wr-input-wrap { position: relative; }

    .wr-input-icon {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: rgba(100, 116, 139, 0.9);
        font-size: 1rem;
    }

    .wr-input, .wr-select, .wr-textarea {
        width: 100%;
        border-radius: 18px;
        border: 1px solid rgba(79, 70, 229, 0.18);
        background: rgba(79, 70, 229, 0.05);
        padding: 12px 14px;
        outline: none;
        font-weight: 800;
        color: var(--wr-text);
