    }

    private async Task OpenRulesTab()
    {
        activeTab = "rules";
        rulesError = null;
        rulesSuccess = null;
        if (rules == null) await LoadRules();
    }

    private async Task LoadRules()
    {
        rulesLoading = true;
        rulesError = null;
        try
        {
            var list = await Http.GetFromJsonAsync<List<NotificationRuleDto>>("api/notifications/admin/rules");
            rules = list ?? new();
            ruleSnapshots.Clear();
            ruleErrors.Clear();
            foreach (var r in rules) ruleSnapshots[r.EventType] = RuleSnapshot(r);
        }
        catch (Exception ex) { rulesError = $"دریافت تنظیمات خودکار انجام نشد: {ex.Message}"; }
        finally { rulesLoading = false; }

        try
        {
            messengerStatus = await Http.GetFromJsonAsync<List<MessengerChannelStatusDto>>("api/notifications/admin/messenger-status");
        }
        catch { messengerStatus = null; }
    }

    private static string RuleSnapshot(NotificationRuleDto r) =>
        $"{r.IsEnabled}|{r.Severity}|{r.TitleTemplate}|{r.BodyTemplate}|{r.ActionUrlTemplate}|{r.BroadcastToAdmins}|{r.Channels}";

    private bool IsRuleDirty(NotificationRuleDto r) =>
        ruleSnapshots.TryGetValue(r.EventType, out var snap) && snap != RuleSnapshot(r);

    private bool IsRuleSaving(string eventType) => savingRules.Contains(eventType);

    private void FocusedField(NotificationRuleDto r, string field)
    {
        focusedRuleKey = r.EventType;
        focusedField = field;
    }

    private void InsertPlaceholder(NotificationRuleDto r, string name)
    {
        var target = focusedRuleKey == r.EventType ? focusedField : "body";
        var token = "{" + name + "}";
        if (target == "title") r.TitleTemplate = (r.TitleTemplate ?? string.Empty) + token;
        else if (target == "url") r.ActionUrlTemplate = (r.ActionUrlTemplate ?? string.Empty) + token;
        else r.BodyTemplate = (r.BodyTemplate ?? string.Empty) + token;
    }

