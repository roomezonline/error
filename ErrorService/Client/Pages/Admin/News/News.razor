@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private List<NewsDto>? newsList;
    private NewsUpsertRequest model = new();
    private bool showEditor = false;
    private int editingId = 0;
    private bool isSaving = false;
    private bool isUploading = false;
    private string createdAtInput = string.Empty;

    private DotNetObjectReference<News>? objRef;
    private int _lastQuillEditingId;
    private bool _quillInitialized;

    protected override async Task OnInitializedAsync()
    {
        await LoadNews();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("initJalali");
        }

        if (!showEditor)
            return;

        // Ensure Quill exists whenever editor is visible
        if (!_quillInitialized)
        {
            objRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initQuillEditor", "quill-editor-container", model.Content ?? "", objRef);
            await JS.InvokeVoidAsync("bindCalloutSelectorForQuill", "quill-editor-container", "news-callout-selector");
            _quillInitialized = true;
            _lastQuillEditingId = editingId;
            return;
        }

        // When switching between news items, update the content
        if (_lastQuillEditingId != editingId)
        {
            await JS.InvokeVoidAsync("setQuillContent", "quill-editor-container", model.Content ?? "");
            await JS.InvokeVoidAsync("bindCalloutSelectorForQuill", "quill-editor-container", "news-callout-selector");
            _lastQuillEditingId = editingId;
        }
    }

    [JSInvokable]
    public void UpdateContent(string content)
    {
        model.Content = content;
    }

    public void Dispose() => objRef?.Dispose();

    private int skip = 0;
    private int take = 10;
    private int totalCount = 0;
    private bool isLoadingMore = false;

    private async Task LoadNews(bool loadMore = false)
    {
        if (loadMore)
        {
            isLoadingMore = true;
            skip += take;
        }
        else
        {
            skip = 0;
            newsList = null;
        }

        try
        {
            var response = await Http.GetAsync($"api/news?skip={skip}&take={take}");
            if (response.IsSuccessStatusCode)
            {
                if (response.Headers.TryGetValues("X-Total-Count", out var values))
                {
                    int.TryParse(values.FirstOrDefault(), out totalCount);
                }

                var data = await response.Content.ReadFromJsonAsync<List<NewsDto>>();
                if (data != null)
                {
                    if (loadMore && newsList != null)
                    {
                        newsList.AddRange(data);
                    }
                    else
                    {
                        newsList = data;
                    }
                }
            }
        }
        catch
        {
            ToastService.ShowError("خطا در بارگذاری اخبار");
        }
        finally
        {
            isLoadingMore = false;
        }
    }

    private void ClearImage()
    {
        model.ImageUrl = null;
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        isUploading = true;
        try
        {
            var file = e.File;
            if (file == null) return;

            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            using var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var resp = await Http.PostAsync("api/news/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                var url = (await resp.Content.ReadAsStringAsync()).Trim('"');
                model.ImageUrl = url;
                ToastService.ShowSuccess("تصویر شاخص آپلود شد");
            }
            else
            {
                ToastService.ShowError("خطا در آپلود تصویر شاخص");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در آپلود: " + ex.Message);
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task HandleInlineImageUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            using var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);
            
            var resp = await Http.PostAsync("api/news/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                var url = (await resp.Content.ReadAsStringAsync()).Trim('"');
                // Insert as Quill embed (enables resize module)
                await JS.InvokeVoidAsync("insertImageAtCursor", "quill-editor-container", url);
                ToastService.ShowSuccess("تصویر درج شد");
            }
        }
        catch (Exception ex) { ToastService.ShowError("خطا در آپلود: " + ex.Message); }
    }

    private async Task HandleInlineVideoUpload(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            using var content = new MultipartFormDataContent();
            var stream = file.OpenReadStream(150_000_000);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(streamContent, "file", file.Name);

            var resp = await Http.PostAsync("api/news/upload-video", content);
            if (resp.IsSuccessStatusCode)
            {
                var url = (await resp.Content.ReadAsStringAsync()).Trim('"');
                await JS.InvokeVoidAsync("insertVideoAtCursor", "quill-editor-container", url);
                ToastService.ShowSuccess("ویدیو درج شد");
            }
            else
            {
                ToastService.ShowError("خطا در آپلود ویدیو");
            }
        }
        catch (Exception ex) { ToastService.ShowError("خطا در آپلود: " + ex.Message); }
    }

