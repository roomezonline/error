    private int skip = 0;
    private int take = 10;
    private int totalCount = 0;
    private bool isLoadingMore = false;

    private async Task LoadNews(bool loadMore = false)
    {
        if (loadMore)
        {
            isLoadingMore = true;
            // مبدأ صفحهٔ بعد از تعداد ردیف‌های نمایش‌داده‌شده محاسبه می‌شود تا بعد از
            // افزودن/حذف محلی، هیچ موردی جا نیفتد.
            skip = newsList?.Count ?? (skip + take);
        }
        else
        {
            skip = 0;
            newsList = null;
            selectedIds.Clear();
        }

        try
        {
            var query = $"api/news?skip={skip}&take={take}&sort=newest&pinnedFirst=false";
            if (_typeFilter.HasValue) query += $"&type={_typeFilter.Value}";
            if (!string.IsNullOrWhiteSpace(_statusFilter)) query += $"&status={_statusFilter}";
            if (_categoryFilterId.HasValue) query += $"&categoryId={_categoryFilterId.Value}";
            if (!string.IsNullOrWhiteSpace(_searchQuery)) query += $"&q={Uri.EscapeDataString(_searchQuery.Trim())}";

            var response = await Http.GetAsync(query);
            if (response.IsSuccessStatusCode)
            {
                if (response.Headers.TryGetValues("X-Total-Count", out var values))
                {
                    int.TryParse(values.FirstOrDefault(), out totalCount);
                }

                var data = await response.Content.ReadFromJsonAsync<List<NewsDto>>();
                if (data != null)
                {
                    if (loadMore && newsList != null)
                    {
                        newsList.AddRange(data);
                    }
                    else
                    {
                        newsList = data;
                    }
                }
            }
        }
        catch
        {
            ToastService.ShowError("خطا در بارگذاری اخبار");
        }
        finally
        {
            isLoadingMore = false;
        }
    }

