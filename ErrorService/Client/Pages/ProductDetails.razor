@code {
    [Parameter] public int? Id { get; set; }
    [Parameter] public string? Slug { get; set; }

    [Inject] private HttpClient HttpApi { get; set; } = default!;
    [Inject] private Microsoft.AspNetCore.Components.NavigationManager Nav { get; set; } = default!;
    [Inject] private ErrorService.Client.Services.CartService CartService { get; set; } = default!;
    [Inject] private ErrorService.Client.Services.ToastService ToastService { get; set; } = default!;
    [Inject] private ErrorService.Client.Services.WishlistService Ws { get; set; } = default!;
    [Inject] private ErrorService.Client.Services.RecentlyViewedService RecentSvc { get; set; } = default!;

    private ProductDto? product;
    private List<ProductDto>? relatedProducts;
    private List<RecentlyViewedItem> _recentItems = new();
    private bool isLoading = true;
    private int currentImageIndex = 0;
    private List<string>? _cachedImages;
    private string countdownText = "";
    private Timer? timer;
    private string? productJsonLd;
    private int _quantity = 1;
    private string? sharedText;
    private bool showLightbox;
    private int _lightboxIndex;
    private int _activeTab;
    private bool showShareModal;
    private bool _showScrollTop;
    private bool _isAddingToCart;
    private CartBtnState _cartBtnState;
    private string _cartBtnText = "افزودن به سبد خرید";
    private string _cartBtnClass => _cartBtnState == CartBtnState.Done ? "pd-cart-done" : "";
    private string _scrollTopClass => _showScrollTop ? "pd-scroll-visible" : "";

    private CancellationTokenSource? _toastCts;
    private object? _scrollHandlerRef;

    private bool isInWishlist;

    private static bool IsDiscountActive(IDiscountInfo p)
        => DiscountHelper.IsActive(p);

    private static bool IsTimedActive(IDiscountInfo p)
        => DiscountHelper.IsTimedActive(p);

    private decimal EffectivePrice => product != null
        ? DiscountHelper.GetEffectivePrice(product)
        : 0m;

    private async Task ToggleWishlist()
    {
        if (product == null) return;
        await Ws.ToggleAsync(product.Id, product.Name, product.MainImageUrl, product.Price, IsDiscountActive(product) ? product.DiscountPrice : null, product.DiscountStartDate, product.DiscountExpiryDate);
        isInWishlist = !isInWishlist;
    }

    private async Task InitActionStates()
    {
        if (product == null) return;
        isInWishlist = (await Ws.GetItemsAsync()).Any(x => x.ProductId == product.Id);
    }

    private ProductReviewSummaryDto? reviewSummary;
    private List<CommentDto> _productCommentDtos = new();

    private async Task LoadReviews()
    {
        try
        {
            reviewSummary = await HttpApi.GetFromJsonAsync<ProductReviewSummaryDto>($"api/products/{(product?.Id ?? 0)}/reviews");
            if (reviewSummary != null)
                _productCommentDtos = ConvertProductReviews(reviewSummary.Reviews);
        }
        catch { }
    }

    private async Task HandleProductReviewSubmit(CommentRequest req)
    {
        var prReq = new ProductReviewRequest
        {
            FullName = req.FullName,
            Email = !string.IsNullOrWhiteSpace(req.Email) ? req.Email : "guest@errorservice.ir",
            Rating = req.Rating ?? 5,
            Content = req.Content,
            ParentId = req.ParentId
        };
        var response = await HttpApi.PostAsJsonAsync($"api/products/{(product?.Id ?? 0)}/reviews", prReq);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException("خطا در ثبت نظر");
        var fresh = await HttpApi.GetFromJsonAsync<ProductReviewSummaryDto>($"api/products/{(product?.Id ?? 0)}/reviews");
        if (fresh != null)
        {
            reviewSummary = fresh;
            _productCommentDtos = ConvertProductReviews(fresh.Reviews);
        }
    }

    private static List<CommentDto> ConvertProductReviews(List<ProductReviewDto> source)
    {
        return source.Select(r => new CommentDto
        {
            Id = r.Id,
            ParentId = r.ParentId,
            FullName = r.FullName,
            Content = r.Content,
            Rating = r.Rating,
            CreatedAtFa = r.CreatedAtFa,
            Replies = r.Replies != null ? ConvertProductReviews(r.Replies) : new()
        }).ToList();
    }

    private double startX;
    private void HandleMouseDown(MouseEventArgs e) => startX = e.ClientX;
    private void HandleMouseUp(MouseEventArgs e) => HandleSwipe(startX - e.ClientX);
    private void HandleTouchStart(TouchEventArgs e) => startX = e.Touches[0].ClientX;
    private void HandleTouchEnd(TouchEventArgs e)
    {
        if (e.ChangedTouches != null && e.ChangedTouches.Length > 0)
            HandleSwipe(startX - e.ChangedTouches[0].ClientX);
    }
    private void HandleSwipe(double diff)
    {
        var images = GetAllImages();
        if (images.Count <= 1 || Math.Abs(diff) < 30) return;
        if (diff > 0) { if (currentImageIndex < images.Count - 1) currentImageIndex++; }
        else { if (currentImageIndex > 0) currentImageIndex--; }
        StateHasChanged();
    }

    private void HandleImageError(int index)
    {
        var images = GetAllImages();
        if (index < images.Count)
        {
            var el = GetAllImages();
            if (index < el.Count)
            {
            }
        }
    }

    private void HandleThumbError(int index) { }

    private void IncrementQty() { if (_quantity < 99) _quantity++; }
    private void DecrementQty() { if (_quantity > 1) _quantity--; }

    private void OpenLightbox(int index)
    {
        var images = GetAllImages();
        _lightboxIndex = Math.Clamp(index, 0, images.Count - 1);
        showLightbox = true;
        StateHasChanged();
        try { _ = JS.InvokeVoidAsync("__pdFocusElement", "pd-lightbox-el"); } catch { }
    }
    private void CloseLightbox() => showLightbox = false;
    private void PrevLightbox()
    {
        if (_lightboxIndex > 0) _lightboxIndex--;
    }
    private void NextLightbox()
    {
        if (_lightboxIndex < GetAllImages().Count - 1) _lightboxIndex++;
    }
    private void HandleLightboxKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseLightbox();
        else if (e.Key == "ArrowLeft") PrevLightbox();
        else if (e.Key == "ArrowRight") NextLightbox();
    }

    private void OpenShareModal()
    {
        showShareModal = true;
    }

    private void CloseShareModal()
    {
        showShareModal = false;
    }

    private string GetShareText()
    {
        if (product == null) return "";
        var price = EffectivePrice.ToString("N0");
        var desc = string.IsNullOrEmpty(product.Description)
            ? $"قیمت: {price} تومان"
            : TruncateText(StripHtml(product.Description), 120);
        return $"{product.Name}\n{desc}\nقیمت: {price} تومان\n🔗 {Nav.Uri}";
    }

    private string GetShareTextForTelegram()
    {
        if (product == null) return "";
        var price = EffectivePrice.ToString("N0");
        var name = StripHtml(product.Name);
        return $"{name} - {price} تومان";
    }

    private void SwitchTab(int tab)
    {
        if (_activeTab != tab)
        {
            _activeTab = tab;
        }
    }

    [JSInvokable]
    public void OnScroll(bool isVisible)
    {
        _showScrollTop = isVisible;
        StateHasChanged();
    }

    private async Task ScrollToTop()
    {
        await JS.InvokeVoidAsync("window.scrollTo", new { top = 0, behavior = "smooth" });
    }

    private async Task CopyProductCode()
    {
        if (product == null) return;
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        try
        {
            await JS.InvokeVoidAsync("__copyToClipboard", $"#{product.Id:D6}");
            if (token.IsCancellationRequested) return;
            sharedText = "کد محصول کپی شد";
            StateHasChanged();
            await Task.Delay(2000, token);
            sharedText = null;
            StateHasChanged();
        }
        catch (OperationCanceledException) { }
        catch
        {
            if (token.IsCancellationRequested) return;
            sharedText = "خطا در کپی کد";
            StateHasChanged();
            await Task.Delay(2000, token);
            sharedText = null;
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        _quantity = 1;
        _activeTab = 0;
        currentImageIndex = 0;
        _lightboxIndex = 0;
        showLightbox = false;
        showShareModal = false;
        _cartBtnState = CartBtnState.Default;
        _cartBtnText = "افزودن به سبد خرید";
        _isAddingToCart = false;
        reviewSummary = null;
        _productCommentDtos = new();
        await LoadProduct();
        _cachedImages = null;
        await InitActionStates();
        await LoadReviews();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var dotnetRef = DotNetObjectReference.Create(this);
            _scrollHandlerRef = await JS.InvokeAsync<object>("__pdScrollHandler", dotnetRef);
        }
    }

    private async Task LoadProduct()
    {
        try
        {
            isLoading = true;
            ProductDto? loaded = null;

            if (!string.IsNullOrEmpty(Slug))
            {
                loaded = await HttpApi.GetFromJsonAsync<ProductDto>($"api/products/slug/{Uri.EscapeDataString(Slug)}");
            }
            else if (Id.HasValue)
            {
                loaded = await HttpApi.GetFromJsonAsync<ProductDto>($"api/products/{Id}");
                if (loaded != null && !string.IsNullOrEmpty(loaded.Slug))
                {
                    Nav.NavigateTo(SeoUrl.Product(loaded.Id, loaded.Slug), replace: true);
                    return;
                }
            }

            product = loaded;
            if (product != null)
            {
                productJsonLd = BuildProductJsonLd(product);
                StartCountdown();
                _ = LoadRelatedProducts(product);
                _ = TrackRecentlyViewed(product);
            }
        }
        catch { product = null; }
        finally { isLoading = false; }
    }

    private async Task TrackRecentlyViewed(ProductDto p)
    {
        await RecentSvc.AddAsync(new RecentlyViewedItem
        {
            Id = p.Id,
            Slug = p.Slug,
            Name = p.Name,
            ImageUrl = p.MainImageUrl,
            Price = p.Price,
            DiscountPrice = IsDiscountActive(p) ? p.DiscountPrice : null,
            DiscountStartDate = p.DiscountStartDate,
            DiscountExpiryDate = p.DiscountExpiryDate
        });
        _recentItems = await RecentSvc.GetItemsAsync();
        StateHasChanged();
    }

    private async Task LoadRelatedProducts(ProductDto product)
    {
        try
        {
            var excludeIds = new HashSet<int> { product.Id };
            var results = new List<ProductDto>();

            if (!string.IsNullOrWhiteSpace(product.RelatedProductIds))
            {
                var ids = product.RelatedProductIds
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .Select(id => int.TryParse(id, out var n) ? n : -1)
                    .Where(id => id > 0)
                    .Distinct()
                    .ToList();

                var tasks = ids
                    .Where(id => !excludeIds.Contains(id))
                    .Select(async pid =>
                    {
                        try
                        {
                            var p = await HttpApi.GetFromJsonAsync<ProductDto>($"api/products/{pid}");
                            if (p != null)
                            {
                                lock (excludeIds) { excludeIds.Add(pid); }
                                return p;
                            }
                        }
                        catch { }
                        return null;
                    });

                var responses = await Task.WhenAll(tasks);
                foreach (var p in responses)
                {
                    if (p != null) results.Add(p);
                }
            }

            if (results.Count < 6)
            {
                var need = 6 - results.Count;
                var query = $"api/products?categoryId={product.CategoryId}&take={need + 1}";
                var categoryProducts = await HttpApi.GetFromJsonAsync<List<ProductDto>>(query);
                if (categoryProducts != null)
                {
                    foreach (var p in categoryProducts)
                    {
                        if (excludeIds.Contains(p.Id)) continue;
                        results.Add(p);
                        excludeIds.Add(p.Id);
                        if (results.Count >= 6) break;
                    }
                }
            }

            relatedProducts = results;
        }
        catch { }
    }

    private string BuildProductJsonLd(ProductDto product)
    {
        var price = DiscountHelper.GetEffectivePrice(product);
        var images = GetAllImages();
        var baseUrl = Nav.BaseUri.TrimEnd('/');

        var productSchema = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org/",
            ["@type"] = "Product",
            ["name"] = product.Name,
            ["image"] = images.Count == 1 ? images[0] : images.ToArray(),
            ["description"] = TruncateText(product.Description ?? product.FailureSymptoms ?? product.Name, 500),
            ["url"] = $"{baseUrl}{SeoUrl.Product(product.Id, product.Slug)}",
            ["sku"] = $"ES-{product.Id:D6}",
            ["brand"] = new Dictionary<string, object?> { ["@type"] = "Brand", ["name"] = "ErrorService" },
            ["category"] = product.CategoryName ?? "قطعات یدکی",
            ["offers"] = new Dictionary<string, object?>
            {
                ["@type"] = "Offer",
                ["url"] = $"{baseUrl}{SeoUrl.Product(product.Id, product.Slug)}",
                ["priceCurrency"] = "IRT",
                ["price"] = price.ToString("F0"),
                ["availability"] = product.IsAvailable ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
                ["itemCondition"] = "https://schema.org/NewCondition"
            }
        };

        if (product.DiscountExpiryDate.HasValue)
        {
            var offers = productSchema["offers"] as Dictionary<string, object?>;
            offers!["priceValidUntil"] = product.DiscountExpiryDate.Value.ToString("yyyy-MM-dd");
            if (product.DiscountStartDate.HasValue)
                offers!["priceValidFrom"] = product.DiscountStartDate.Value.ToString("yyyy-MM-dd");
        }

        var breadcrumb = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "BreadcrumbList",
            ["itemListElement"] = new List<object>
            {
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 1, ["name"] = "خانه", ["item"] = baseUrl },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 2, ["name"] = "محصولات", ["item"] = $"{baseUrl}/products" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 3, ["name"] = product.CategoryName ?? "محصولات", ["item"] = $"{baseUrl}/products?categoryId={product.CategoryId}" },
                new Dictionary<string, object?> { ["@type"] = "ListItem", ["position"] = 4, ["name"] = product.Name }
            }
        };

        return JsonSerializer.Serialize(new object[] { productSchema, breadcrumb });
    }

    private async Task AddToCart()
    {
        if (product == null || _isAddingToCart) return;
        _isAddingToCart = true;
        _cartBtnState = CartBtnState.Spinner;
        _cartBtnText = "در حال افزودن...";
        StateHasChanged();
        await Task.Delay(400);
        await CartService.AddToCartAsync(product, _quantity);
        _cartBtnState = CartBtnState.Done;
        _cartBtnText = "افزوده شد";
        StateHasChanged();
        await Task.Delay(1500);
        _cartBtnState = CartBtnState.Default;
        _cartBtnText = "افزودن به سبد خرید";
        _isAddingToCart = false;
        StateHasChanged();
        ToastService.ShowSuccess($"تعداد {_quantity} عدد از محصول \"{product.Name}\" به سبد خرید اضافه شد.");
    }

    private List<string> GetAllImages()
    {
        if (_cachedImages != null) return _cachedImages;
        var list = new List<string>();
        if (!string.IsNullOrEmpty(product?.MainImageUrl)) list.Add(product.MainImageUrl);
        if (!string.IsNullOrEmpty(product?.ImageUrl2)) list.Add(product.ImageUrl2);
        if (!string.IsNullOrEmpty(product?.ImageUrl3)) list.Add(product.ImageUrl3);
        if (!string.IsNullOrEmpty(product?.ImageUrl4)) list.Add(product.ImageUrl4);
        if (list.Count == 0) list.Add("/images/placeholder-product.svg");
        _cachedImages = list;
        return _cachedImages;
    }

    private void StartCountdown()
    {
        timer?.Dispose();
        if (product?.DiscountExpiryDate == null) return;
        timer = new Timer(_ =>
        {
            var diff = product.DiscountExpiryDate.Value - DateTimeOffset.Now;
            if (diff.TotalSeconds <= 0)
            {
                countdownText = "پایان یافت";
                timer?.Dispose();
            }
            else
            {
                int days = (int)diff.TotalDays;
                countdownText = days > 0
                    ? $"{days} روز و {diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}"
                    : $"{diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}";
            }
            InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    private static string TruncateText(string text, int maxLength)
    {
        if (string.IsNullOrEmpty(text) || text.Length <= maxLength) return text ?? "";
        return text.Substring(0, maxLength - 3) + "...";
    }

    private static string StripHtml(string html)
    {
        return System.Text.RegularExpressions.Regex.Replace(html, @"<[^>]+>", " ").Trim();
    }

    public void Dispose()
    {
        timer?.Dispose();
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        if (_scrollHandlerRef != null)
        {
            _ = JS.InvokeVoidAsync("__pdRemoveScrollHandler", _scrollHandlerRef);
        }
    }

    private enum CartBtnState
    {
        Default,
        Spinner,
        Done
    }
}
