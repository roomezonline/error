    .pd-tech-text--link { color:#0d6efd;font-weight:600;font-size:.8rem; }
    .pd-tech-ext { color:#0d6efd;font-size:.75rem;flex-shrink:0; }

    /* ===== Related ===== */
    .pd-related { margin-top:2rem; }
    .pd-related-title { font-size:1.1rem;font-weight:700;color:#212529;margin:0 0 1rem; }
    .pd-related-track { display:flex;gap:.75rem;overflow-x:auto;padding-bottom:.5rem;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch; }
    .pd-related-track::-webkit-scrollbar { height:4px; }
    .pd-related-track::-webkit-scrollbar-track { background:#e9ecef;border-radius:2px; }
    .pd-related-track::-webkit-scrollbar-thumb { background:#adb5bd;border-radius:2px; }
    .pd-related-card { flex:0 0 180px;scroll-snap-align:start;background:#fff;border:1px solid #e9ecef;border-radius:.85rem;overflow:hidden;text-decoration:none;color:inherit;transition:transform .2s,box-shadow .2s; }
    .pd-related-card:hover { transform:translateY(-3px);box-shadow:0 8px 24px rgba(0,0,0,.08); }
    .pd-related-img { height:140px;background:#f8f9fa;display:flex;align-items:center;justify-content:center;overflow:hidden; }
    .pd-related-img img { width:100%;height:100%;object-fit:contain;padding:.5rem; }
    .pd-related-placeholder { display:flex;align-items:center;justify-content:center; }
    .pd-related-body { padding:.6rem .75rem .75rem; }
    .pd-related-name { display:block;font-size:.8rem;font-weight:600;color:#212529;margin-bottom:.35rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap; }
    .pd-related-price { display:flex;align-items:baseline;gap:.25rem;flex-wrap:wrap; }
    .pd-related-old { font-size:.7rem;color:#adb5bd;text-decoration:line-through; }
    .pd-related-current { font-size:.9rem;font-weight:700;color:#0d6efd; }
    .pd-related-unit { font-size:.65rem;color:#6c757d; }

    /* ===== Lightbox ===== */
    .pd-lightbox { position:fixed;inset:0;background:rgba(0,0,0,.85);z-index:9999;display:flex;align-items:center;justify-content:center;padding:1rem;backdrop-filter:blur(4px);animation:pd-lb-in .25s ease;outline:none; }
    @@keyframes pd-lb-in { from { opacity:0; } to { opacity:1; } }
    .pd-lightbox-content { position:relative;max-width:90vw;max-height:90vh;display:flex;flex-direction:column;align-items:center; }
    .pd-lightbox-close { position:absolute;top:-2.5rem;left:50%;transform:translateX(-50%);background:rgba(255,255,255,.15);border:none;border-radius:50%;width:40px;height:40px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .2s;z-index:10; }
    .pd-lightbox-close:hover { background:rgba(255,255,255,.3); }
    .pd-lightbox-img-wrap { display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:.75rem;max-height:80vh; }
    .pd-lightbox-img { max-width:100%;max-height:80vh;object-fit:contain;border-radius:.5rem;cursor:zoom-in;transition:transform .3s ease; }
    .pd-lightbox-img:hover { transform:scale(1.5); }
    .pd-lightbox-counter { margin-top:.75rem;color:rgba(255,255,255,.6);font-size:.8rem; }
    .pd-lightbox-nav { position:absolute;top:50%;transform:translateY(-50%);background:rgba(255,255,255,.15);border:none;border-radius:50%;width:44px;height:44px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:background .2s;z-index:10; }
    .pd-lightbox-nav:hover { background:rgba(255,255,255,.3); }
    .pd-lightbox-prev { right:calc(100% + .75rem); }
    .pd-lightbox-next { left:calc(100% + .75rem); }

    /* ===== Toast ===== */
    .pd-toast { position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#212529;color:#fff;padding:.7rem 1.5rem;border-radius:2rem;font-size:.9rem;font-weight:600;z-index:9999;box-shadow:0 4px 20px rgba(0,0,0,.2);animation:pd-fade 2.5s ease forwards;white-space:nowrap; }
    @@keyframes pd-fade { 0%{opacity:0;transform:translateX(-50%) translateY(10px)}15%{opacity:1;transform:translateX(-50%) translateY(0)}75%{opacity:1}100%{opacity:0;transform:translateX(-50%) translateY(-10px)} }

    /* ===== Sticky Bar ===== */
    .pd-sticky-bar { display:none;position:fixed;bottom:0;left:0;right:0;background:#fff;border-top:1px solid #e9ecef;box-shadow:0 -4px 20px rgba(0,0,0,.08);z-index:1000;padding:.6rem 1rem;padding-bottom:calc(.6rem + env(safe-area-inset-bottom,0px)); }
