@page "/admin/trust/portfolio"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.trust.portfolio.manage")]
@using ErrorService.Shared
@inject HttpClient Http
@inject ErrorService.Client.Services.ToastService Toast

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-black text-primary m-0">مدیریت نمونه‌کارها</h2>
        <button class="btn btn-primary rounded-pill px-4" @onclick="NewItem">افزودن نمونه‌کار</button>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">عنوان</th>
                                <th>برند</th>
                                <th>دستگاه</th>
                                <th class="text-center">نمایش</th>
                                <th class="text-center">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (isLoading)
                            {
                                <tr><td colspan="5" class="text-center py-5"><div class="spinner-border text-primary"></div></td></tr>
                            }
                            else if (!items.Any())
                            {
                                <tr><td colspan="5" class="text-center py-5 text-muted">موردی یافت نشد.</td></tr>
                            }
                            else
                            {
                                @foreach (var p in items)
                                {
                                    <tr class="@(editing?.Id == p.Id ? "table-primary" : "")">
                                        <td class="ps-4 fw-bold">@p.Title</td>
                                        <td>@p.Brand</td>
                                        <td>@p.DeviceType</td>
                                        <td class="text-center">
                                            <span class="badge @(publishedIds.Contains(p.Id) ? "bg-success" : "bg-secondary") rounded-pill">@(publishedIds.Contains(p.Id) ? "فعال" : "غیرفعال")</span>
                                        </td>
                                        <td class="text-center pe-4">
                                            <div class="d-flex justify-content-center gap-2">
                                                <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => Edit(p.Id)">ویرایش</button>
                                                <button class="btn btn-sm btn-outline-danger rounded-circle" @onclick="() => Delete(p.Id)"><span class="oi oi-trash"></span></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            @if (editing != null)
            {
                <div class="card border-0 shadow-sm rounded-4 p-4">
                    <h5 class="fw-black mb-4">@(editing.Id > 0 ? "ویرایش" : "افزودن")</h5>

                    <EditForm Model="editing" OnValidSubmit="Save">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-bold">عنوان</label>
                                <InputText class="form-control bg-light border-0 rounded-3" @bind-Value="editing!.Title" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">توضیحات</label>
                                <InputTextArea class="form-control bg-light border-0 rounded-3" rows="3" @bind-Value="editing!.Description" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">برند</label>
                                <InputText class="form-control bg-light border-0 rounded-3" @bind-Value="editing!.Brand" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">نوع دستگاه</label>
                                <InputText class="form-control bg-light border-0 rounded-3" @bind-Value="editing!.DeviceType" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">عکس قبل</label>
                                <InputText class="form-control bg-light border-0 rounded-3" @bind-Value="editing!.BeforeImageUrl" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">عکس بعد</label>
                                <InputText class="form-control bg-light border-0 rounded-3" @bind-Value="editing!.AfterImageUrl" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold">تاریخ اتمام</label>
                                <InputDate class="form-control bg-light border-0 rounded-3" @bind-Value="completionDate" />
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input" @bind-Value="isPublished" />
                                    <label class="form-check-label">نمایش در سایت</label>
                                </div>
                            </div>
                            <div class="col-12 mt-3">
                                <button type="submit" class="btn btn-primary rounded-pill px-5" disabled="@isBusy">ذخیره</button>
                                <button type="button" class="btn btn-light rounded-pill px-4 ms-2" @onclick="NewItem">جدید</button>
                            </div>
                        </div>
                    </EditForm>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .fw-black { font-weight: 900; }
</style>

@code {
    private List<PortfolioProjectDto> items = new();
    private HashSet<int> publishedIds = new();
    private PortfolioProjectDto? editing;
    private DateTime completionDate = DateTime.Today;
    private bool isPublished = true;

    private bool isLoading = true;
    private bool isBusy = false;

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        try
        {
            var resp = await Http.GetFromJsonAsync<PortfolioAdminResponse>("api/trust/admin/portfolio");
            items = resp?.Items ?? new();
            publishedIds = resp?.PublishedIds?.ToHashSet() ?? new();
        }
        catch
        {
            items = new();
            publishedIds = new();
        }
        isLoading = false;

        if (editing == null) NewItem();
    }

    private void NewItem()
    {
        editing = new PortfolioProjectDto();
        completionDate = DateTime.Today;
        isPublished = true;
    }

    private async Task Edit(int id)
    {
        var resp = await Http.GetFromJsonAsync<PortfolioAdminResponse>("api/trust/admin/portfolio");
        var item = resp?.Items?.FirstOrDefault(x => x.Id == id);
        if (item == null) return;
        editing = item;
        completionDate = item.CompletionDate.LocalDateTime.Date;
        isPublished = resp?.PublishedIds?.Contains(id) ?? true;
    }

    private async Task Save()
    {
        if (editing == null) return;
        isBusy = true;

        try
        {
            var upsert = new PortfolioAdminUpsert
            {
                Id = editing.Id,
                Title = editing.Title,
                Description = editing.Description,
                BeforeImageUrl = editing.BeforeImageUrl,
                AfterImageUrl = editing.AfterImageUrl,
                DeviceType = editing.DeviceType,
                Brand = editing.Brand,
                CompletionDate = new DateTimeOffset(completionDate, TimeSpan.Zero),
                IsPublished = isPublished
            };

            var resp = await Http.PostAsJsonAsync("api/trust/admin/portfolio", upsert);
            resp.EnsureSuccessStatusCode();

            Toast.ShowSuccess("ذخیره شد");
            await Load();
        }
        catch
        {
            Toast.ShowError("خطا در ذخیره");
        }
        finally
        {
            isBusy = false;
        }
    }

    private async Task Delete(int id)
    {
        await Http.DeleteAsync($"api/trust/admin/portfolio/{id}");
        Toast.ShowSuccess("حذف شد");
        await Load();
    }

    private class PortfolioAdminResponse
    {
        public List<PortfolioProjectDto> Items { get; set; } = new();
        public List<int> PublishedIds { get; set; } = new();
    }

    private class PortfolioAdminUpsert : PortfolioProjectDto
    {
        public bool IsPublished { get; set; }
    }
}
