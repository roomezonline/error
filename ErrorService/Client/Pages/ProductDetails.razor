@if (product != null)
{
    <div class="pd-sticky-bar">
        <div class="pd-sticky-inner">
            <div class="pd-sticky-price">
                @if (IsDiscountActive(product))
                {
                    <span class="pd-sticky-old">@((product.Price * _quantity).ToString("N0"))</span>
                }
                <span class="pd-sticky-current">@((EffectivePrice * _quantity).ToString("N0"))</span>
                <span class="pd-sticky-label">قیمت کل</span>
            </div>
            <div class="pd-sticky-actions">
                <div class="pd-sticky-qty">
                    <button class="pd-sticky-qty-btn" @onclick="DecrementQty" disabled="@(_quantity <= 1)" aria-label="کاهش">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                    <span class="pd-sticky-qty-val">@_quantity</span>
                    <button class="pd-sticky-qty-btn" @onclick="IncrementQty" disabled="@(_quantity >= QtyMax)" aria-label="افزایش">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
                    </button>
                </div>
                @if (!IsProductOutOfStock)
                {
                <button class="pd-sticky-cart @_cartBtnClass" @onclick="AddToCart" disabled="@(!product.IsAvailable || product.StockQuantity <= 0 || _isAddingToCart)">
                    @if (_cartBtnState == CartBtnState.Spinner)
                    {
                        <span class="pd-cart-spinner"></span>
                    }
                    else if (_cartBtnState == CartBtnState.Done)
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                    }
                    else
                    {
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                    }
                    <span>@_cartBtnText</span>
                </button>
                }
            </div>
        </div>
        @if (IsProductOutOfStock)
        {
            <button class="pd-sticky-notify @(_stockAlertSubscribed ? "pd-notify-subscribed" : "")"
                    @onclick="HandleStockAlertClick" disabled="@_stockAlertBusy">
                @if (_stockAlertBusy)
                {
                    <span class="pd-cart-spinner"></span>
                }
                else if (_stockAlertSubscribed)
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg>
                }
                else
                {
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                }
                <span>@(_stockAlertSubscribed ? "یادآوری ثبت شد ✓" : "خبرم کن وقتی موجود شد")</span>
            </button>
        }
    </div>
}

<button class="pd-scroll-top @_scrollTopClass" @onclick="ScrollToTop" aria-label="بالا">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
</button>

@if (sharedText != null)
{
    <div class="pd-toast" role="status" aria-live="polite">@sharedText</div>
}

<script>
    window.__pdScrollHandler = function(dotnetRef) {
        var handler = function() {
            dotnetRef.invokeMethodAsync('OnScroll', window.scrollY > 350);
        };
        window.addEventListener('scroll', handler, { passive: true });
        handler();
        return handler;
    };
    window.__pdRemoveScrollHandler = function(handler) {
        window.removeEventListener('scroll', handler);
    };
    window.__pdFocusElement = function(id) {
        var el = document.getElementById(id);
        if (el) el.focus();
    };
</script>

<style>
    .pd-wrap *, .pd-wrap *::before, .pd-wrap *::after { box-sizing: border-box; }
    .pd-wrap { font-family: 'Vazirmatn', system-ui, sans-serif; color: #212529; line-height: 1.6; }
    .pd-container { max-width: 1200px; margin: 0 auto; padding: 1.5rem 1rem; }

    /* ===== Skeleton ===== */
    @@keyframes pd-shimmer { 0%{background-position:-400px 0}100%{background-position:400px 0} }
    .pd-skeleton { padding: 1rem 0; }
    .pd-sk-grid { display:grid; grid-template-columns:1fr 1fr; gap:2rem; }
    .pd-sk-gallery { height:420px; background:#e9ecef; border-radius:1.25rem; }
    .pd-sk-info { display:flex; flex-direction:column; gap:1rem; }
    .pd-sk-line { height:20px; border-radius:0.5rem; background: linear-gradient(90deg,#e9ecef 25%,#f8f9fa 50%,#e9ecef 75%); background-size:800px 100%; animation:pd-shimmer 1.8s infinite linear; }
    .pd-sk-line.h2 { height:32px; }
    .pd-sk-line.h4 { height:28px; }
    .pd-sk-line.w-25 { width:25%; }
    .pd-sk-line.w-50 { width:50%; }
    .pd-sk-line.w-75 { width:75%; }
    .pd-sk-line.w-100 { width:100%; }
    .pd-sk-details { margin-top:2rem; }
    @@media (max-width:767.98px) { .pd-sk-grid { grid-template-columns:1fr; } .pd-sk-gallery { height:280px; } }

    .pd-notfound { text-align:center;padding:4rem 1rem;background:#fff;border-radius:1.25rem;box-shadow:0 1px 3px rgba(0,0,0,.06);max-width:400px;margin:3rem auto; }
    .pd-notfound h3 { font-size:1.15rem;color:#343a40;margin:1rem 0 1.5rem; }
    .pd-back-btn { display:inline-block;padding:.6rem 1.75rem;background:#0d6efd;color:#fff;border-radius:2rem;text-decoration:none;font-weight:600;font-size:.9rem;transition:background .2s; }
    .pd-back-btn:hover { background:#0b5ed7; }

    .pd-breadcrumb { margin-bottom:1.5rem; }
    .pd-breadcrumb ol { list-style:none;display:flex;flex-wrap:wrap;gap:.4rem;padding:0;margin:0;font-size:.85rem;color:#6c757d; }
    .pd-breadcrumb li { display:flex;align-items:center; }
    .pd-breadcrumb li+li::before { content:"/";color:#adb5bd;margin:0 .35rem; }
    .pd-breadcrumb a { color:#0d6efd;text-decoration:none; }
    .pd-breadcrumb a:hover { text-decoration:underline; }

    /* Mobile Header Sticky */
    .pd-header-sticky {
        position: sticky;
        top: 0;
        z-index: 1020;
        min-height: 56px;
        background: rgba(255, 255, 255, 0.98);
        backdrop-filter: blur(15px);
        -webkit-backdrop-filter: blur(15px);
        border-bottom: 1px solid rgba(0,0,0,0.06);
        display: flex;
        align-items: center;
        margin: -0.75rem -0.6rem 0.75rem;
        padding: 0 0.6rem;
        padding-top: env(safe-area-inset-top, 0px);
    }
    .pd-header-inner {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        max-width: 1200px;
        margin: 0 auto;
        min-height: 56px;
    }
    .pd-header-back {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #f8fafc;
        color: #475569;
        text-decoration: none;
        transition: all 0.2s;
        border: 1px solid rgba(0,0,0,0.04);
        flex-shrink: 0;
    }
    .pd-header-back:active { transform: scale(0.92); background: #f1f5f9; }
    .pd-header-title {
        flex: 1;
        text-align: center;
        font-weight: 700;
        font-size: 0.85rem;
        color: #0f172a;
        line-height: 1.3;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .pd-header-action {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        height: 44px;
        border-radius: 12px;
        background: #f8fafc;
        color: #475569;
        border: 1px solid rgba(0,0,0,0.04);
        cursor: pointer;
        transition: all 0.2s;
        flex-shrink: 0;
    }
    .pd-header-action:active { transform: scale(0.92); background: #f1f5f9; }

    .pd-main { display:grid;grid-template-columns:1fr 1fr;gap:2rem;align-items:start; }

    .pd-gallery-view { position:relative;background:#f8f9fa;border-radius:1rem;overflow:hidden;user-select:none;touch-action:none; }
    .pd-gallery-track { display:flex;transition:transform .4s cubic-bezier(.25,1,.5,1); }
    .pd-gallery-slide { min-width:100%;display:flex;align-items:center;justify-content:center;padding:1rem; }
    .pd-img-wrap { width:100%;display:flex;align-items:center;justify-content:center;overflow:hidden;border-radius:.75rem; }
    .pd-main-img { max-width:100%;max-height:460px;width:auto;height:auto;object-fit:contain;border-radius:.5rem;cursor:zoom-in;transition:transform .35s ease; }
    .pd-main-img:hover { transform:scale(1.06); }

    .pd-discount-ribbon { position:absolute;top:.75rem;right:.75rem;background:linear-gradient(135deg,#dc3545,#e4606d);color:#fff;padding:.45rem .9rem;border-radius:.65rem;z-index:5;box-shadow:0 4px 14px rgba(220,53,69,.35);text-align:center;min-width:100px;font-size:.8rem; }
    .pd-discount-label { font-weight:700;font-size:.7rem;opacity:.95;display:block; }
    .pd-discount-timer { font-family:'Courier New',monospace;font-weight:700;font-size:.95rem;direction:ltr; }

    .pd-dots { position:absolute;bottom:.75rem;left:50%;transform:translateX(-50%);display:flex;gap:.4rem; }
    .pd-dot { width:7px;height:7px;border-radius:50%;border:none;background:rgba(0,0,0,.18);cursor:pointer;transition:all .3s;padding:0; }
    .pd-dot--active { background:#0d6efd;width:22px;border-radius:4px; }

    .pd-thumbs { display:flex;gap:.6rem;justify-content:center;margin-top:.75rem;flex-wrap:wrap; }
    .pd-thumb { width:64px;height:64px;border-radius:.65rem;overflow:hidden;border:2.5px solid transparent;background:#f8f9fa;cursor:pointer;transition:all .2s;padding:0;display:flex;align-items:center;justify-content:center; }
    .pd-thumb img { width:100%;height:100%;object-fit:contain;padding:4px; }
    .pd-thumb--active { border-color:#0d6efd;background:#fff;box-shadow:0 2px 8px rgba(13,110,253,.15); }

    .pd-info { display:flex;flex-direction:column;gap:1rem; }
    .pd-category { display:inline-flex;align-self:flex-start;background:#e8f4fd;color:#0d6efd;font-size:.75rem;font-weight:700;padding:.3rem .8rem;border-radius:2rem;letter-spacing:.3px; }
    .pd-title { font-size:1.4rem;font-weight:800;color:#212529;margin:0;line-height:1.4;word-break:break-word; }
    .pd-extra { display:flex;flex-wrap:wrap;gap:.4rem 1.5rem;font-size:.8rem;color:#6c757d; }
    .pd-extra-item { display:inline-flex;align-items:center;gap:.3rem; }
    .pd-extra-item svg { flex-shrink:0; }
    .pd-code-copy { cursor:pointer;transition:color .2s; }
    .pd-code-copy:hover { color:#0d6efd; }
    .pd-instock { color:#198754;font-weight:700; }
    .pd-outstock { color:#dc3545;font-weight:700; }

    .pd-rating-stars { display:flex;align-items:center;gap:.5rem;flex-wrap:wrap; }
    .pd-stars { display:flex;gap:2px; }
    .pd-stars svg { display:block; }
    .pd-rating-text { font-size:.8rem;color:#6c757d; }

    .pd-pricebox { background:#f8f9fa;border-radius:1rem;padding:1rem 1.25rem; }
    .pd-price-row { display:flex;align-items:center;gap:.75rem;margin-bottom:.25rem; }
    .pd-price-old { font-size:.9rem;color:#adb5bd;text-decoration:line-through; }
    .pd-price-badge { font-size:.65rem;font-weight:700;background:#dc3545;color:#fff;padding:.15rem .5rem;border-radius:.35rem; }
    .pd-price-current { display:flex;align-items:baseline;gap:.35rem; }
    .pd-price-num { font-size:1.75rem;font-weight:800;color:#0d6efd;line-height:1.1; }
    .pd-price-unit { font-size:.85rem;color:#6c757d;font-weight:600; }

    .pd-highlights { display:grid;grid-template-columns:1fr 1fr;gap:.5rem; }
    .pd-hl { display:flex;align-items:center;gap:.4rem;font-size:.78rem;font-weight:600;color:#495057;padding:.5rem;background:#f8f9fa;border-radius:.65rem;transition:background .2s,transform .2s; }
    .pd-hl:hover { background:#e8f4fd;transform:translateY(-1px); }
    .pd-hl svg { flex-shrink:0;stroke:#2c7da0; }

    .pd-actions { display:flex;align-items:center;gap:.75rem;flex-wrap:wrap; }
    .pd-qty { display:flex;align-items:center;gap:.6rem;flex-shrink:0; }
    .pd-qty-label { font-weight:600;color:#495057;font-size:.9rem; }
    .pd-qty-box { display:flex;align-items:center;border:1.5px solid #dee2e6;border-radius:.65rem;overflow:hidden;background:#fff; }
    .pd-qty-btn { display:flex;align-items:center;justify-content:center;width:38px;height:38px;border:none;background:#f8f9fa;color:#495057;cursor:pointer;transition:background .15s,color .15s;padding:0;min-width:44px;min-height:44px; }
    .pd-qty-btn:hover:not(:disabled) { background:#e9ecef;color:#0d6efd; }
    .pd-qty-btn:disabled { opacity:.3;cursor:not-allowed; }
    .pd-qty-val { min-width:44px;text-align:center;font-weight:700;font-size:1rem;color:#212529;user-select:none; }

    .pd-share { display:inline-flex;align-items:center;gap:.35rem;padding:.5rem .9rem;border:1.5px solid #dee2e6;border-radius:.65rem;cursor:pointer;font-size:.8rem;font-weight:600;color:#495057;transition:all .2s;min-height:44px;background:#fff; }
    .pd-share:hover { background:#e8f4fd;border-color:#0d6efd;color:#0d6efd; }
    .pd-wishlist-active { background:#fff0f0;border-color:#dc3545;color:#dc3545; }
    .pd-wishlist-active:hover { background:#ffe0e0;border-color:#dc3545;color:#dc3545; }
    .pd-actions-tools { display:flex;gap:4px;flex-wrap:wrap; }

    .pd-add-cart { display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;padding:.85rem 1.5rem;border:none;border-radius:.85rem;background:#0d6efd;color:#fff;font-size:1rem;font-weight:700;cursor:pointer;transition:background .2s,transform .1s,box-shadow .2s;box-shadow:0 4px 14px rgba(13,110,253,.25);min-height:48px;white-space:nowrap; }
    .pd-add-cart svg { flex-shrink:0; }
    .pd-add-cart:hover:not(:disabled) { background:#0b5ed7;box-shadow:0 6px 20px rgba(13,110,253,.35);transform:translateY(-1px); }
    .pd-add-cart:active:not(:disabled) { transform:translateY(0); }
    .pd-add-cart:disabled { opacity:.5;cursor:not-allowed; }
    .pd-add-cart.pd-cart-done { background:#198754 !important;box-shadow:0 4px 14px rgba(25,135,84,.25); }

    @@keyframes pd-cart-spin { to { transform:rotate(360deg); } }
    .pd-cart-spinner { display:inline-block;width:18px;height:18px;border:2.5px solid rgba(255,255,255,.3);border-top-color:#fff;border-radius:50%;animation:pd-cart-spin .6s linear infinite; }

    /* ===== Back-in-stock notify button ===== */
    .pd-notify-btn { display:flex;align-items:center;justify-content:center;gap:.5rem;width:100%;padding:.85rem 1.5rem;border:2px dashed #fd7e14;border-radius:.85rem;background:#fff7e6;color:#d9480f;font-size:1rem;font-weight:700;cursor:pointer;transition:all .2s;min-height:48px;white-space:nowrap; }
    .pd-notify-btn svg { flex-shrink:0; }
    .pd-notify-btn:hover:not(:disabled) { background:#fd7e14;border-style:solid;border-color:#fd7e14;color:#fff;box-shadow:0 4px 14px rgba(253,126,20,.3); }
    .pd-notify-btn:disabled { opacity:.6;cursor:not-allowed; }
    .pd-notify-btn.pd-notify-subscribed { border-style:solid;border-color:#198754;background:#e8f5ee;color:#146c43; }
    .pd-notify-btn.pd-notify-subscribed:hover:not(:disabled) { background:#198754;border-color:#198754;color:#fff;box-shadow:0 4px 14px rgba(25,135,84,.3); }
    .pd-sticky-notify { display:flex;align-items:center;justify-content:center;gap:.4rem;flex:1;padding:.7rem 1rem;border:2px dashed #fd7e14;border-radius:.75rem;background:#fff7e6;color:#d9480f;font-size:.9rem;font-weight:700;cursor:pointer;transition:all .2s;min-height:44px;white-space:nowrap; }
    .pd-sticky-notify svg { flex-shrink:0; }
    .pd-sticky-notify:hover:not(:disabled) { background:#fd7e14;border-style:solid;border-color:#fd7e14;color:#fff; }
    .pd-sticky-notify:disabled { opacity:.6;cursor:not-allowed; }
    .pd-sticky-notify.pd-notify-subscribed { border-style:solid;border-color:#198754;background:#e8f5ee;color:#146c43; }
    .pd-sticky-notify.pd-notify-subscribed:hover:not(:disabled) { background:#198754;border-color:#198754;color:#fff; }
/* Out-of-stock: notify gets its own full-width row at the bottom of the bar */
.pd-sticky-bar > .pd-sticky-notify { margin:.55rem auto 0;max-width:1200px;width:100%; }

    /* ===== Messenger connect modal ===== */
    .pd-connect-overlay { position:fixed;inset:0;background:rgba(15,23,42,.55);backdrop-filter:blur(3px);display:flex;align-items:center;justify-content:center;padding:1rem;z-index:1080;animation:pd-fade-in .2s ease; }
    @@keyframes pd-fade-in { from { opacity:0; } to { opacity:1; } }
    .pd-connect-modal { position:relative;background:#fff;border-radius:1rem;padding:1.75rem 1.5rem 1.25rem;width:100%;max-width:520px;max-height:88vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.3);animation:pd-modal-up .25s ease; }
    @@keyframes pd-modal-up { from { opacity:0; transform:translateY(24px) scale(.97); } to { opacity:1; transform:translateY(0) scale(1); } }
    .pd-connect-close { position:absolute;top:.75rem;left:.75rem;width:34px;height:34px;border:none;border-radius:50%;background:#f1f3f5;color:#6c757d;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all .15s; }
    .pd-connect-close:hover { background:#e9ecef;color:#212529; }
    .pd-connect-head { text-align:center;margin-bottom:1.1rem; }
    .pd-connect-icon { width:56px;height:56px;margin:0 auto .6rem;border-radius:50%;background:#fff7e6;color:#fd7e14;display:flex;align-items:center;justify-content:center; }
    .pd-connect-head h3 { margin:0 0 .35rem;font-size:1.1rem;font-weight:800;color:#212529; }
    .pd-connect-head p { margin:0;font-size:.85rem;color:#6c757d;line-height:1.7; }
    .pd-connect-loading { display:flex;justify-content:center;padding:1.25rem; }
    .pd-connect-loading .pd-cart-spinner { border-color:rgba(13,110,253,.2);border-top-color:#0d6efd; }
    .pd-connect-list { display:flex;flex-direction:column;gap:.65rem;margin-bottom:1.1rem; }
    .pd-connect-item { display:flex;align-items:center;justify-content:space-between;gap:.75rem;padding:.8rem .9rem;border:1px solid #e9ecef;border-radius:.75rem;background:#fafbfc;flex-wrap:wrap; }
    .pd-connect-item-info { flex:1;min-width:180px; }
    .pd-connect-item-info b { display:block;font-size:.92rem;color:#212529;margin-bottom:.2rem; }
    .pd-connect-item-info p { margin:0;font-size:.78rem;color:#6c757d;line-height:1.7; }
    .pd-connect-item-btn { display:inline-flex;align-items:center;gap:.35rem;padding:.5rem .9rem;border-radius:.6rem;background:#0d6efd;color:#fff;font-size:.82rem;font-weight:700;text-decoration:none;white-space:nowrap;transition:background .15s; }
    .pd-connect-item-btn:hover { background:#0b5ed7;color:#fff; }
    .pd-connect-footer { display:flex;align-items:center;justify-content:space-between;gap:.75rem;flex-wrap:wrap;border-top:1px solid #f1f3f5;padding-top:.9rem; }
    .pd-connect-guide { display:inline-flex;align-items:center;gap:.35rem;font-size:.8rem;color:#0d6efd;text-decoration:none; }
    .pd-connect-guide:hover { text-decoration:underline; }
    .pd-connect-done { padding:.55rem 1.4rem;border:none;border-radius:.6rem;background:#212529;color:#fff;font-size:.85rem;font-weight:700;cursor:pointer;font-family:inherit;transition:background .15s; }
    .pd-connect-done:hover { background:#000; }

    /* ===== Tab transitions ===== */
    @@keyframes pd-tab-fade-in { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
    .pd-tabs-wrap { margin-top:2.5rem;background:#fff;border:1px solid #e9ecef;border-radius:1rem;overflow:hidden; }
    .pd-tabs-header { display:flex;border-bottom:1px solid #e9ecef;background:#fafbfc;overflow-x:auto; }
    .pd-tab-btn { display:inline-flex;align-items:center;gap:.4rem;padding:.85rem 1.25rem;border:none;background:transparent;color:#6c757d;font-size:.9rem;font-weight:600;cursor:pointer;transition:all .2s;white-space:nowrap;font-family:inherit;border-bottom:2px solid transparent;margin-bottom:-1px; }
    .pd-tab-btn:hover { color:#0d6efd;background:#f0f4ff; }
    .pd-tab-active { color:#0d6efd !important;border-bottom-color:#0d6efd !important;background:#fff !important; }
    .pd-tab-content { padding:1.25rem;animation:pd-tab-fade-in .3s ease; }
    .pd-tab-fade-in { animation:pd-tab-fade-in .3s ease; }
    .pd-tab-fade-out { animation:none; }
    .pd-tab-panel { }
    .pd-desc { color:#495057;line-height:2;font-size:.9rem; }
    .pd-desc p { margin-bottom:.7rem; }
    .pd-tab-empty { text-align:center;padding:2rem;color:#adb5bd;font-size:.9rem; }

    .pd-specs { display:flex;flex-direction:column; }
    .pd-specs--sheet {
        background:#fff;
        border:1.5px dashed #cbd5e1;
        border-radius:16px;
        padding:.4rem 1rem;
        display:flex;flex-direction:column;
        box-shadow:0 1px 4px rgba(15,23,42,.04);
    }
    .pd-specs--sheet .pd-spec {
        display:flex;justify-content:space-between;align-items:center;gap:1rem;
        padding:.62rem .35rem;
        border-bottom:1px dashed #e2e8f0;
        transition:background .15s;
    }
    .pd-specs--sheet .pd-spec:nth-child(even) { background:rgba(148,163,184,.045); }
    .pd-specs--sheet .pd-spec:hover { background:rgba(37,99,235,.055); }
    .pd-specs--sheet .pd-spec:last-child { border-bottom:none; }
    .pd-spec-chip {
        flex-shrink:0;
        display:inline-flex;align-items:center;
        border:1.5px dashed;
        border-radius:999px;
        padding:.28rem .85rem;
        font-size:.78rem;font-weight:800;
        letter-spacing:.2px;
        white-space:nowrap;
    }
    .pd-spec-chip--0 { color:#1d4ed8;border-color:rgba(37,99,235,.45);background:rgba(37,99,235,.07); }
    .pd-spec-chip--1 { color:#0f766e;border-color:rgba(13,148,136,.45);background:rgba(13,148,136,.07); }
    .pd-spec-chip--2 { color:#b45309;border-color:rgba(217,119,6,.45);background:rgba(217,119,6,.08); }
    .pd-spec-chip--3 { color:#6d28d9;border-color:rgba(124,58,237,.45);background:rgba(124,58,237,.07); }
    .pd-spec-val { color:#0f172a;font-weight:700;font-size:.88rem;text-align:left;min-width:0;overflow-wrap:anywhere; }
    .pd-spec-val--mono { direction:ltr;unicode-bidi:isolate;font-family:'Courier New',monospace;font-weight:800;letter-spacing:.5px;color:#334155; }
    .pd-spec-val--price { color:#1d4ed8;font-weight:900;font-size:.95rem; }
    .pd-spec-status {
        display:inline-flex;align-items:center;gap:.4rem;
        border-radius:999px;padding:.28rem .9rem;
        font-size:.78rem;font-weight:900;white-space:nowrap;
    }
    .pd-spec-status i { width:8px;height:8px;border-radius:50%;background:currentColor;box-shadow:0 0 0 3px rgba(0,0,0,.06); }
    .pd-spec-status.is-ok { background:rgba(16,185,129,.12);color:#047857;border:1.5px dashed rgba(5,150,105,.45); }
    .pd-spec-status.is-no { background:rgba(244,63,94,.1);color:#be123c;border:1.5px dashed rgba(225,29,72,.4); }
    .pd-green { color:#198754 !important; }
    .pd-red { color:#dc3545 !important; }

    .pd-tech-card {
        display:flex;align-items:flex-start;gap:.75rem;
        padding:.9rem 1rem;margin-top:.5rem;
        background:#f8f9fa;border-radius:.75rem;
        border:1px solid #e9ecef;transition:all .2s;
    }
    .pd-tech-card:hover { background:#fff;border-color:#dee2e6;box-shadow:0 2px 12px rgba(0,0,0,.05); }
    .pd-tech-card.pd-tech-link { text-decoration:none;color:inherit;cursor:pointer;align-items:center; }
    .pd-tech-card.pd-tech-link:hover { border-color:#0d6efd;background:#f0f4ff; }
    .pd-tech-icon {
        width:36px;height:36px;border-radius:10px;
        display:grid;place-items:center;flex-shrink:0;
        background:#e9ecef;color:#495057;font-size:.9rem;
    }
    .pd-tech-card.pd-tech-link .pd-tech-icon { background:#dbe4ff;color:#0d6efd; }
    .pd-tech-body { flex:1;min-width:0; }
    .pd-tech-label { font-weight:700;font-size:.78rem;color:#495057;margin-bottom:4px; }
    .pd-tech-text { font-size:.85rem;color:#212529;line-height:1.7;word-wrap:break-word; }
    .pd-tech-text--link { color:#0d6efd;font-weight:600;font-size:.8rem; }
    .pd-tech-ext { color:#0d6efd;font-size:.75rem;flex-shrink:0; }

    /* ===== Related ===== */
    .pd-related { margin-top:2rem; }
    .pd-related-title { font-size:1.1rem;font-weight:700;color:#212529;margin:0 0 1rem; }
    .pd-related-track { display:flex;gap:.75rem;overflow-x:auto;padding-bottom:.5rem;scroll-snap-type:x mandatory;-webkit-overflow-scrolling:touch; }
    .pd-related-track::-webkit-scrollbar { height:4px; }
