@page "/admin/service-voices"
@layout AdminLayout
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.servicevoices.manage")]
@using ErrorService.Shared
@using ErrorService.Client.Services
@using ErrorService.Client.Utils
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>آوای ارورسرویس | ارورسرویس</PageTitle>

<ConfirmDialog IsVisible="_showDeleteConfirm"
               Title="حذف اکشن"
               Message=@($"آیا از حذف اکشن «{_itemToDelete?.TitleFa}» و فایل صدای آن اطمینان دارید؟")
               OnResult="HandleDeleteResult" />

<div class="admin-container sv-page" dir="rtl">
    <div class="sv-hero">
        <div class="sv-hero__text">
            <h3 class="admin-page-title m-0">آوای ارورسرویس</h3>
            <p class="text-muted small m-0">
                اول دستگاه فعال کارگاه را انتخاب کنید؛ بعد برای همان دستگاه اکشن بسازید، صدا ضبط کنید و ذخیره کنید.
            </p>
        </div>
        <div class="sv-hero__actions">
            <span class="sv-pill sv-pill--ok">
                <span class="sv-dot"></span>
                @ActiveCount اکشن فعال
            </span>
            <button type="button" class="btn btn-primary rounded-3 shadow-sm" @onclick="NewItemAsync"
                    disabled="@(_selectedDeviceId is not > 0)">
                <span class="oi oi-plus me-1"></span>
                اکشن جدید
            </button>
        </div>
    </div>

    <div class="sv-devicebar">
        <div class="sv-devicebar__head">
            <div class="sv-devicebar__title"><span class="oi oi-location"></span> دستگاه هدف</div>
            <button type="button" class="sv-icon-btn" @onclick="ReloadDevicesAsync" disabled="@_loadingDevices"
                    title="بازخوانی دستگاه‌ها" aria-label="بازخوانی دستگاه‌ها">
                <span class="oi oi-reload"></span>
            </button>
        </div>

        @if (_loadingDevices)
        {
            <div class="sv-devicebar__hint">
                <span class="spinner-border spinner-border-sm me-2"></span>
                در حال بارگذاری دستگاه‌های فعال…
            </div>
        }
        else if (_devices.Count == 0)
        {
            <div class="sv-devicebar__empty">
                هیچ دستگاه فعالی به کارگاهی متصل نیست. ابتدا در
                <a href="/admin/monitoring-devices">مدیریت دستگاه‌ها</a>
                دستگاه را فعال و به کارگاه متصل کنید.
            </div>
        }
        else
        {
            <div class="sv-devicebar__row">
                <select class="form-select sv-devicebar__select" @bind="_selectedDeviceId" @bind:after="OnDeviceChangedAsync">
                    @foreach (var d in _devices)
                    {
                        <option value="@d.Id">@DeviceLabel(d)</option>
                    }
                </select>

                @if (_selectedDevice is { } chipDevice)
                {
                    <div class="sv-devicebar__chips">
                        <span class="sv-tag sv-tag--ok"><span class="oi oi-check"></span>فعال</span>
                        <span class="sv-tag"><span class="oi oi-loop"></span>@chipDevice.ActionsCount اکشن</span>
                        @if (!string.IsNullOrWhiteSpace(chipDevice.WorkshopTitle))
                        {
                            <span class="sv-tag"><span class="oi oi-map-marker"></span>@chipDevice.WorkshopTitle</span>
                        }
                    </div>
                }
            </div>

            @if (_selectedDevice is { } codeDevice)
            {
                <div class="sv-devicebar__code">
                    <span class="sv-devicebar__code-label">کد دستگاه برای فرمور:</span>
                    <code dir="ltr">@codeDevice.DeviceNumber</code>
                    <span class="sv-devicebar__code-hint">
                        همین مقدار را در <code>ava_config.h</code> به عنوان <code>DEVICE_CODE</code> بگذارید
                        یا در پنل وای‌فای دستگاه وارد کنید.
                    </span>
                </div>
            }
        }
    </div>

    <div class="sv-stats">
        <div class="sv-stat">
            <span class="sv-stat__num">@(_items?.Count ?? 0)</span>
            <span class="sv-stat__label">اکشن‌های این دستگاه</span>
        </div>
        <div class="sv-stat">
            <span class="sv-stat__num">@ActiveCount</span>
            <span class="sv-stat__label">فعال</span>
        </div>
        <div class="sv-stat">
            <span class="sv-stat__num">@WithAudioCount</span>
            <span class="sv-stat__label">دارای فایل صدا</span>
        </div>
    </div>

    <div class="sv-layout">
        <section class="sv-panel">
            <header class="sv-panel__head">
                <div>
                    <div class="sv-panel__title"><span class="oi oi-list"></span> اکشن‌های @(_selectedDevice?.Title ?? "دستگاه")</div>
                    <div class="sv-hint">@(_selectedDevice is null ? "ابتدا دستگاه هدف را انتخاب کنید" : "چیدمان بر اساس اولویت پخش")</div>
                </div>
                <button type="button" class="sv-icon-btn" @onclick="LoadAsync" title="بازخوانی" aria-label="بازخوانی">
                    <span class="oi oi-reload"></span>
                </button>
            </header>

            @if (_items == null)
            {
                <div class="sv-empty">
                    <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                    در حال بارگذاری…
                </div>
            }
            else if (_selectedDeviceId is not > 0)
            {
                <div class="sv-empty">
                    <div class="sv-empty__icon"><span class="oi oi-location"></span></div>
                    <div class="fw-bold mb-1">دستگاهی انتخاب نشده است</div>
                    <div class="small">از نوار «دستگاه هدف» یک دستگاه فعال کارگاه انتخاب کنید.</div>
                </div>
            }
            else if (!_items.Any())
            {
                <div class="sv-empty">
                    <div class="sv-empty__icon"><span class="oi oi-audio"></span></div>
                    <div class="fw-bold mb-1">برای این دستگاه هنوز اکشنی تعریف نشده است</div>
                    <div class="small">از دکمه «اکشن جدید» شروع کنید؛ مثلاً دیفراست یا استارت موتور.</div>
                </div>
            }
            else
            {
                <div class="sv-items">
                    @foreach (var it in _items)
                    {
                        <article class="sv-item @(_editingId == it.Id ? "is-editing" : "")">
                            <div class="sv-item__top">
                                <div class="sv-item__lead">
                                    <span class="sv-prio" title="اولویت">@it.Priority</span>
                                    <div class="sv-item__nameline">
                                        <div class="sv-item__title">@it.TitleFa</div>
                                        <code class="sv-item__key" dir="ltr">@it.Key</code>
                                    </div>
                                </div>
                                <div class="sv-item__tools">
                                    @if (it.DeviceId is > 0 && !string.IsNullOrWhiteSpace(it.AudioUrl))
                                    {
                                        <button type="button" class="sv-icon-btn" title="پخش آزمایشی روی دستگاه"
                                                aria-label="پخش آزمایشی روی دستگاه"
                                                @onclick="() => TestAsync(it)" disabled="@(_testingId == it.Id)">
                                            @if (_testingId == it.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                            }
                                            else
                                            {
                                                <span class="oi oi-audio"></span>
                                            }
                                        </button>
                                    }
                                    <button type="button" class="sv-icon-btn" title="ویرایش" aria-label="ویرایش" @onclick="() => Edit(it)">
                                        <span class="oi oi-pencil"></span>
                                    </button>
                                    <button type="button" class="sv-icon-btn sv-icon-btn--danger" title="حذف" aria-label="حذف" @onclick="() => AskDelete(it)">
                                        <span class="oi oi-trash"></span>
                                    </button>
                                </div>
                            </div>

                            <div class="sv-item__meta">
                                <button type="button" class="sv-toggle @(it.IsActive ? "on" : "")"
                                        @onclick="() => ToggleAsync(it)"
                                        title="@(it.IsActive ? "غیرفعال کردن" : "فعال کردن")">
                                    <span class="sv-toggle__track"><span class="sv-toggle__dot"></span></span>
                                    <span>@(it.IsActive ? "فعال" : "غیرفعال")</span>
                                </button>
                                <span class="sv-tag"><span class="oi oi-loop"></span>@it.RepeatCount بار</span>
                                @if (ServiceVoiceEventKeys.TitleOf(it.Key) is { } eventTitle)
                                {
                                    <span class="sv-tag sv-tag--event"><span class="oi oi-bolt"></span>@eventTitle</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(it.AudioUrl))
                                {
                                    <span class="sv-tag sv-tag--ok"><span class="oi oi-audio"></span>@FormatSize(it.AudioSizeBytes)</span>
                                }
                                else
                                {
                                    <span class="sv-tag sv-tag--off">بدون صدا</span>
                                }
                                @if (it.UpdatedAt != default)
                                {
                                    <span class="sv-tag sv-tag--off">آخرین ویرایش: @PersianDate.ToJalaliDateTime(it.UpdatedAt)</span>
                                }
                            </div>

                            @if (!string.IsNullOrWhiteSpace(it.AudioUrl))
                            {
                                <div class="sv-audio-row">
                                    <span class="sv-audio-row__icon"><span class="oi oi-audio"></span></span>
                                    <audio controls preload="none" src="@it.AudioUrl" class="sv-audio" dir="ltr"></audio>
                                </div>
                            }
                        </article>
                    }
                </div>
            }
        </section>

        <section class="sv-panel sv-editor" id="sv-editor">
            <header class="sv-panel__head">
                <div>
                    <div class="sv-panel__title">@(_editingId is null ? "تعریف اکشن جدید" : "ویرایش اکشن")</div>
                    <div class="sv-hint">
                        @if (_selectedDevice is { } editorDevice)
                        {
                            <span>برای دستگاه <strong>@editorDevice.Title</strong> — کد <code dir="ltr">@editorDevice.DeviceNumber</code></span>
                        }
                        else
                        {
                            <span>ابتدا دستگاه هدف را انتخاب کنید</span>
                        }
                    </div>
                </div>
                @if (_editingId is not null)
                {
                    <button type="button" class="sv-btn sv-btn--ghost" @onclick="NewItemAsync">
                        <span class="oi oi-plus"></span>
                        جدید
                    </button>
                }
            </header>

            <EditForm Model="_model" OnValidSubmit="SaveAsync" class="sv-form">
                <DataAnnotationsValidator />

                @if (_selectedDeviceId is not > 0)
                {
                    <div class="sv-note">
                        برای تعریف اکشن، ابتدا از نوار «دستگاه هدف» یک دستگاه فعال کارگاه انتخاب کنید.
                    </div>
                }

                <div class="sv-field">
                    <label class="sv-label">کلید اکشن</label>
                    <InputText class="form-control" dir="ltr" @bind-Value="_model.Key" placeholder="defrost" />
                    <div class="sv-hint">حروف انگلیسی کوچک، عدد، خط تیره یا زیرخط — مثل <code dir="ltr">engine_start</code></div>
                    <ValidationMessage For="@(() => _model.Key)" class="text-danger small" />
                </div>

                <div class="sv-field">
                    <label class="sv-label">اتصال به رویداد پایش</label>
                    <select class="form-select" value="@EventKeySelectValue" @onchange="OnEventKeyChanged">
                        <option value="">بدون اتصال — فقط پخش دستی</option>
                        @foreach (var opt in ServiceVoiceEventKeys.Options)
                        {
                            <option value="@opt.Key">@opt.TitleFa — @opt.HintFa</option>
                        }
                    </select>
                    <div class="sv-hint">
                        با انتخاب رویداد، کلید و نام خودکار پر می‌شود. هنگام تغییر همان تجهیز در پایش،
                        صدا بلافاصله روی دستگاه پخش می‌شود.
                    </div>
                </div>

                <div class="sv-field">
                    <label class="sv-label">نام نمایشی</label>
                    <InputText class="form-control" @bind-Value="_model.TitleFa" placeholder="دیفراست" />
                    <ValidationMessage For="@(() => _model.TitleFa)" class="text-danger small" />
                </div>

                <div class="row g-3 sv-field">
                    <div class="col-6">
                        <label class="sv-label">تعداد تکرار</label>
                        <InputNumber class="form-control" dir="ltr" min="1" max="50" @bind-Value="_model.RepeatCount" />
                        <div class="sv-hint">۱ تا ۵۰</div>
                        <ValidationMessage For="@(() => _model.RepeatCount)" class="text-danger small" />
                    </div>
                    <div class="col-6">
                        <label class="sv-label">اولویت</label>
                        <InputNumber class="form-control" dir="ltr" min="0" max="1000" @bind-Value="_model.Priority" />
                        <div class="sv-hint">عدد کمتر = اولویت بالاتر</div>
                        <ValidationMessage For="@(() => _model.Priority)" class="text-danger small" />
                    </div>
                </div>

                <div class="form-check form-switch sv-switch">
                    <InputCheckbox class="form-check-input" @bind-Value="_model.IsActive" />
                    <label class="form-check-label">اکشن فعال باشد</label>
                </div>

                <div class="sv-recorder @(_isRecording ? "is-recording" : "")">
                    <div class="sv-recorder__head">
                        <div class="sv-recorder__title"><span class="oi oi-audio"></span> صدای اکشن</div>
                        @if (!string.IsNullOrWhiteSpace(_existingAudioUrl) && string.IsNullOrWhiteSpace(_pendingUrl))
                        {
                            <button type="button" class="sv-btn sv-btn--danger" @onclick="DeleteAudioAsync" disabled="@_saving">
                                <span class="oi oi-trash"></span>
                                حذف صدا
                            </button>
                        }
                    </div>

                    @if (!_recorderSupported)
                    {
                        <div class="sv-note">
                            ضبط صدا در این مرورگر پشتیبانی نمی‌شود. از Chrome یا Edge روی اتصال HTTPS استفاده کنید.
                        </div>
                    }
                    else
                    {
                        <div class="sv-rec-stage">
                            @if (_isRecording)
                            {
                                <button type="button" class="sv-rec-btn is-rec" @onclick="StopRecordingAsync" title="پایان ضبط" aria-label="پایان ضبط">
                                    <span class="oi oi-media-stop"></span>
                                </button>
                                <div class="sv-rec-info">
                                    <div class="sv-rec-time" dir="ltr">@FormatDuration(_recordSeconds)</div>
                                    <div class="sv-rec-caption">در حال ضبط… برای پایان، دکمه را بزنید</div>
                                </div>
                                <div class="sv-eq" aria-hidden="true">
                                    <span></span><span></span><span></span><span></span><span></span>
                                </div>
                            }
                            else
                            {
                                <button type="button" class="sv-rec-btn" @onclick="StartRecordingAsync" disabled="@_saving" title="شروع ضبط" aria-label="شروع ضبط">
                                    <span class="oi oi-microphone"></span>
                                </button>
                                <div class="sv-rec-info">
                                    <div class="sv-rec-title">ضبط زنده صدا</div>
                                    <div class="sv-rec-caption">میکروفون را بزنید و صدای اکشن را ضبط کنید</div>
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(_pendingUrl))
                        {
                            <div class="sv-take">
                                <div class="sv-take__label">
                                    <span class="sv-tag sv-tag--ok"><span class="oi oi-check"></span>ضبط جدید — پیش از ذخیره تست کنید</span>
                                </div>
                                <audio controls src="@_pendingUrl" class="sv-audio" dir="ltr"></audio>
                                <div class="sv-rec-caption">این صدا پیش از آپلود به MP3 (مونو، ۲۲ کیلوهرتز، ۶۴ کیلوبیت) تبدیل می‌شود تا روی دستگاه ESP32 روان و واضح پخش شود.</div>
                                <div class="sv-take__actions">
                                    <button type="button" class="sv-btn sv-btn--ghost" @onclick="StartRecordingAsync" disabled="@_saving">
                                        <span class="oi oi-microphone"></span>
                                        ضبط مجدد
                                    </button>
                                    <button type="button" class="sv-btn sv-btn--danger" @onclick="ClearPendingAsync" disabled="@_saving">
                                        <span class="oi oi-x"></span>
                                        پاک کردن ضبط
                                    </button>
                                </div>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(_existingAudioUrl))
                        {
                            <div class="sv-take">
                                <div class="sv-take__label">صدای ذخیره‌شده روی سرور</div>
                                <audio controls preload="none" src="@_existingAudioUrl" class="sv-audio" dir="ltr"></audio>
                                @if (!IsDevicePlayable(_existingAudioUrl))
                                {
                                    <div class="sv-rec-hint">
                                        این فایل MP3 نیست و روی دستگاه پخش نمی‌شود. لطفاً دوباره ضبط کنید تا خودکار به MP3 تبدیل شود.
                                    </div>
                                }
                                <div class="sv-take__actions">
                                    <button type="button" class="sv-btn sv-btn--ghost" @onclick="StartRecordingAsync" disabled="@_saving">
                                        <span class="oi oi-microphone"></span>
                                        ضبط مجدد
                                    </button>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="sv-rec-hint">
                                صدایی ثبت نشده است. بعد از ضبط، «ذخیره اکشن» را بزنید تا فایل روی سرور ذخیره شود.
                            </div>
                        }
                    }
                </div>

                <div class="sv-form__actions">
                    <button class="btn btn-primary rounded-3 flex-grow-1" type="submit" disabled="@(_saving || _isRecording || _selectedDeviceId is not > 0)">
                        @if (_saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                            <span>در حال ذخیره…</span>
                        }
                        else
                        {
                            <span class="oi oi-check me-1"></span>
                            <span>ذخیره اکشن</span>
                        }
                    </button>
                    <button class="btn btn-light rounded-3" type="button" @onclick="Reset" disabled="@_saving">
                        انصراف
                    </button>
                </div>
            </EditForm>
        </section>
    </div>
</div>

<style>
    .sv-hero {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .sv-hero__text {
        max-width: 680px;
    }

    .sv-hero__actions {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .sv-devicebar {
        background: var(--app-surface);
        border: 1px solid var(--app-border);
        border-radius: 16px;
        padding: .85rem 1rem;
        margin-bottom: 1rem;
        box-shadow: var(--app-shadow-sm, 0 2px 10px rgba(15, 23, 42, .04));
    }

    .sv-devicebar__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .5rem;
        margin-bottom: .6rem;
    }

    .sv-devicebar__title {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        font-weight: 800;
        font-size: .85rem;
        color: var(--app-text);
    }

    .sv-devicebar__hint,
    .sv-devicebar__empty {
        font-size: .78rem;
        line-height: 1.9;
        color: var(--app-text-secondary);
    }

    .sv-devicebar__empty a {
        font-weight: 700;
    }

    .sv-devicebar__row {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
    }

    .sv-devicebar__select {
        flex: 1 1 320px;
        min-width: 0;
        max-width: 520px;
        border-radius: 10px;
        font-size: .85rem;
    }

    .sv-devicebar__chips {
        display: flex;
        align-items: center;
        gap: .35rem;
        flex-wrap: wrap;
    }

    .sv-devicebar__code {
        display: flex;
        align-items: center;
        gap: .45rem;
        flex-wrap: wrap;
        margin-top: .6rem;
        padding-top: .6rem;
        border-top: 1px dashed var(--app-border);
        font-size: .75rem;
        color: var(--app-text-muted);
    }

    .sv-devicebar__code code {
        background: var(--app-bg);
        border: 1px solid var(--app-border);
        border-radius: 7px;
        padding: .05rem .45rem;
        font-weight: 700;
        color: var(--app-text);
    }

    .sv-devicebar__code-hint {
        line-height: 1.8;
    }

    .sv-devicebar__code-hint code {
        padding: 0 .2rem;
    }

    .sv-pill {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        border-radius: 999px;
        padding: .38rem .8rem;
        font-size: .75rem;
        font-weight: 700;
        border: 1px solid transparent;
    }

    .sv-pill--ok {
        background: var(--app-success-bg);
        color: var(--app-success);
    }

    .sv-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: currentColor;
    }

    .sv-stats {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: .6rem;
        margin-bottom: 1rem;
    }

    .sv-stat {
        background: var(--app-surface);
        border: 1px solid var(--app-border);
        border-radius: 14px;
        padding: .75rem .9rem;
        display: flex;
        flex-direction: column;
        gap: .1rem;
    }

    .sv-stat__num {
        font-size: 1.25rem;
        font-weight: 800;
        color: var(--app-text);
        line-height: 1.4;
    }

    .sv-stat__label {
        font-size: .72rem;
        color: var(--app-text-muted);
    }

    .sv-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, .95fr);
        gap: 1rem;
        align-items: start;
    }

    .sv-panel {
        background: var(--app-surface);
        border: 1px solid var(--app-border);
        border-radius: 18px;
        overflow: hidden;
        min-width: 0;
    }

    .sv-panel__head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: .75rem;
        padding: .9rem 1.05rem;
        border-bottom: 1px solid var(--app-divider);
    }

    .sv-panel__title {
        font-weight: 800;
        font-size: .95rem;
        color: var(--app-text);
