@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Authorization
@using System.Threading
@using Microsoft.AspNetCore.Components
@using ErrorService.Shared.Models
@using ErrorService.Shared
@implements IDisposable
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ErrorService.Client.Services.ToastService ToastService

<div class="md-bg">
    <div class="md-bg-blob"></div>
    <div class="md-bg-blob"></div>
    <div class="md-bg-blob"></div>
    <div class="md-bg-blob"></div>
    <div class="md-bg-particles">
        <div class="md-bg-particle"></div>
        <div class="md-bg-particle"></div>
        <div class="md-bg-particle"></div>
        <div class="md-bg-particle"></div>
        <div class="md-bg-particle"></div>
        <div class="md-bg-particle"></div>
    </div>
</div>

@if (!IsReadOnly && _showWarning)
{
    <div class="md-warn-overlay @(_dismissing ? "hide" : "show")">
        <div class="md-warn-card">
            <div class="md-warn-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36">
                    <path d="M12 9v4M12 17h.01"/>
                    <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z" stroke-linejoin="round"/>
                </svg>
            </div>
            <div class="md-warn-title">توجه</div>
            <div class="md-warn-text">
                هرگونه بازگشایی درب دستگاه به هر دلیلی، منجر به خروج خودکار آن از سرویس می‌گردد و مسئولیت کامل این امر بر عهده‌ی کاربر خواهد بود.
            </div>
            <div class="md-warn-timer">
                <svg class="md-timer-svg" viewBox="0 0 120 120">
                    <circle cx="60" cy="60" r="50" fill="none" stroke="#eef2f6" stroke-width="6" />
                    <circle cx="60" cy="60" r="50" fill="none" stroke="@TimerStrokeColor" stroke-width="6"
                            stroke-linecap="round" stroke-dasharray="314.16"
                            stroke-dashoffset="@timerOffset" transform="rotate(-90 60 60)" style="transition: stroke-dashoffset 0.05s linear, stroke 0.15s linear" />
                    <circle class="md-timer-glow" cx="60" cy="60" r="50" fill="none" stroke="@TimerStrokeColor" stroke-width="6"
                            stroke-linecap="round" stroke-dasharray="314.16"
                            stroke-dashoffset="@timerOffset" transform="rotate(-90 60 60)" />
                    <circle class="md-timer-shine" cx="60" cy="60" r="50" fill="none" stroke="url(#grShine)" stroke-width="8"
                            stroke-linecap="round" stroke-dasharray="60 254.16" style="transform: rotate(-90deg); transform-origin: 60px 60px;" />
                    <text x="60" y="56" text-anchor="middle" dominant-baseline="central" font-size="26" font-weight="950" fill="#0f172a" font-family="inherit">@_countdownSec.ToString("F2")</text>
                    <text x="60" y="78" text-anchor="middle" dominant-baseline="central" font-size="10" font-weight="700" fill="#64748b" font-family="inherit">ثانیه</text>
                    <defs>
                        <linearGradient id="grShine" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.9" />
                            <stop offset="30%" stop-color="#f59e0b" stop-opacity="0.4" />
                            <stop offset="60%" stop-color="#fbbf24" stop-opacity="0.05" />
                            <stop offset="100%" stop-color="#fbbf24" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                </svg>
            </div>
            <button class="md-warn-btn" @onclick="DismissWarning">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                    <path d="M9 18l6-6-6-6"/>
                </svg>
                <span>متوجه شدم، ورود به صفحه</span>
            </button>
        </div>
    </div>
    }

    @if (!IsReadOnly && _showSettings)
    {
        <div class="md-modal-overlay @(_settingsMissing ? "md-overlay--forced" : "")" @onclick="() => { if (!_settingsMissing) _showSettings = false; }">
            <div class="md-modal" @onclick:stopPropagation="true">
                <div class="md-modal-head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16" style="vertical-align:middle; margin-left:6px;">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-2 2 2 2 0 01-2-2v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83 0 2 2 0 010-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 01-2-2 2 2 0 012-2h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 010-2.83 2 2 0 012.83 0l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 012-2 2 2 0 012 2v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 0 2 2 0 010 2.83l-.06.06a1.65 1.65 0 00-.33 1.82V9a1.65 1.65 0 001.51 1H21a2 2 0 012 2 2 2 0 01-2 2h-.09a1.65 1.65 0 00-1.51 1z"/>
                    </svg>
                    <span>تنظیمات</span>
                    @if (!_settingsMissing)
                    {
                        <button class="md-modal-close" @onclick="() => _showSettings = false">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                                <path d="M18 6L6 18M6 6l12 12" />
                            </svg>
                        </button>
                    }
                </div>
                @if (_settingsMissing)
                {
                    <div style="text-align:center; padding:0 0 12px; font-size:12px; color:#dc2626; font-weight:600;">
                        لطفا تنظیمات موتور و المنت را وارد کنید
                    </div>
                }
                <div class="md-modal-body">
                    <div class="md-settings-section">
                        <div class="md-settings-section-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#7c3aed" stroke-width="2" width="16" height="16">
                                <circle cx="12" cy="12" r="3"/>
                                <line x1="12" y1="2" x2="12" y2="7"/>
                                <line x1="12" y1="17" x2="12" y2="22"/>
                            </svg>
                        </div>
                        <div class="md-settings-section-title">موتور</div>
                        <div class="md-settings-limits">
                            <div class="md-settings-field">
                                <label class="md-settings-field-label">حد بالا</label>
                                <input type="number" inputmode="numeric" class="md-settings-input" @bind="_motorMax" />
                            </div>
                            <div class="md-settings-field">
                                <label class="md-settings-field-label">حد پایین</label>
                                <input type="number" inputmode="numeric" class="md-settings-input" @bind="_motorMin" />
                            </div>
                        </div>
                    </div>
                    <div class="md-settings-section">
                        <div class="md-settings-section-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#0284c7" stroke-width="2" width="16" height="16">
                                <path d="M12 2L2 7l10 5 10-5-10-5z"/>
                                <path d="M2 17l10 5 10-5"/>
                                <path d="M2 12l10 5 10-5"/>
                            </svg>
                        </div>
                        <div class="md-settings-section-title">المنت</div>
                        <div class="md-settings-limits">
                            <div class="md-settings-field">
                                <label class="md-settings-field-label">حد بالا</label>
                                <input type="number" inputmode="numeric" class="md-settings-input" @bind="_elementMax" />
                            </div>
                            <div class="md-settings-field">
                                <label class="md-settings-field-label">حد پایین</label>
                                <input type="number" inputmode="numeric" class="md-settings-input" @bind="_elementMin" />
                            </div>
                        </div>
                    </div>
                    <div class="md-settings-section">
                        <div class="md-settings-toggle-row">
                            <label class="md-toggle">
                                <input type="checkbox" @bind="_simultaneity" />
                                <span class="md-toggle-slider"></span>
                            </label>
                            <span class="md-settings-toggle-label">همزمانی موتور و المنت</span>
                        </div>
                    </div>
                    <div class="md-settings-section">
                        <div class="md-settings-toggle-row">
                            <label class="md-toggle">
                                <input type="checkbox" @bind="_ambientTempAlarmEnabled" />
                                <span class="md-toggle-slider"></span>
                            </label>
                            <span class="md-settings-toggle-label">قطع خودکار پریز در دمای بحرانی محیط</span>
                        </div>
                        <div class="md-settings-limits" style="margin-top:8px">
                            <div class="md-settings-field">
                                <label class="md-settings-field-label">دمای بحرانی (درجه)</label>
                                <input type="number" inputmode="numeric" class="md-settings-input" @bind="_ambientTempThreshold" min="30" max="50" />
                            </div>
                        </div>
                    </div>
                    <div class="md-settings-section md-settings-section--last">
                        <div class="md-settings-section-icon">
                            <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" width="16" height="16">
                                <circle cx="12" cy="12" r="10"/>
                                <polyline points="12 6 12 12 16 14"/>
                            </svg>
                        </div>
                        <div class="md-settings-section-title">تایم‌اوت اتصال</div>
                        <div class="md-settings-limits">
                            <div class="md-settings-field">
                                <label class="md-settings-field-label">مدت زمان (دقیقه)</label>
                                <input type="number" inputmode="numeric" class="md-settings-input" @bind="_timeoutMinutes" min="1" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="md-modal-footer">
                    @if (!_settingsMissing)
                    {
                        <button class="md-modal-cancel" @onclick="() => _showSettings = false">انصراف</button>
                    }
                    <button class="md-modal-confirm" @onclick="SaveSettings">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        @(_settingsMissing ? "ذخیره و ادامه" : "ذخیره تنظیمات")
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_showMenu)
    {
        <div class="md-drawer-overlay" @onclick="ToggleMenu"></div>
        <div class="md-drawer">
            <div class="md-drawer-head">
                <div class="md-drawer-head-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#00A8A8" stroke-width="1.5" width="20" height="20">
                        <rect x="3" y="3" width="18" height="18" rx="3" />
                        <path d="M9 12h6M12 9v6" />
                        <circle cx="7" cy="7" r="1.5" fill="#00A8A8" />
                        <circle cx="17" cy="7" r="1.5" fill="#00A8A8" />
                        <circle cx="7" cy="17" r="1.5" fill="#00A8A8" />
                        <circle cx="17" cy="17" r="1.5" fill="#00A8A8" />
                    </svg>
                </div>
                <div class="md-drawer-head-text">
                    <div class="md-drawer-head-title">منوی مانیتورینگ</div>
                    <div class="md-drawer-head-sub">@MonitoringDeviceTitle</div>
                </div>
                <button class="md-drawer-close" @onclick="ToggleMenu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                        <path d="M18 6L6 18M6 6l12 12" />
                    </svg>
                </button>
            </div>
            <div class="md-drawer-body">
                <div class="md-drawer-item" @onclick="GoToProfessionalChart">
                    <div class="md-drawer-item-icon md-drawer-item-icon--perf">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                            <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>
                        </svg>
                    </div>
                    <div class="md-drawer-item-text">
                        <div class="md-drawer-item-title">چارت کلی</div>
                        <div class="md-drawer-item-desc">نمودار چند محوره با جزییات کامل</div>
                    </div>
                    <svg class="md-drawer-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </div>
                <div class="md-drawer-item" @onclick="GoToProgressiveChart">
                    <div class="md-drawer-item-icon md-drawer-item-icon--zoom">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                            <circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/>
                        </svg>
                    </div>
                    <div class="md-drawer-item-text">
                        <div class="md-drawer-item-title">چارت با جزییات (پیشرفته)</div>
                        <div class="md-drawer-item-desc">زوم هوشمند و بارگذاری تدریجی داده‌ها</div>
                    </div>
                    <svg class="md-drawer-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </div>
                @if (!IsReadOnly)
                {
                <div class="md-drawer-divider"></div>
                @if (!_monitoringEnded)
                {
                <div class="md-drawer-item md-drawer-item--warn" @onclick="() => { _showMenu = false; if (_isPoweredOn) { _ = ShowPowerAlert(); } else { _showEndConfirm = true; } }">
                    <div class="md-drawer-item-icon md-drawer-item-icon--end">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 8v8M8 12h8"/>
                        </svg>
                    </div>
                    <div class="md-drawer-item-text">
                        <div class="md-drawer-item-title">پایان مانیتورینگ</div>
                        <div class="md-drawer-item-desc">خاتمه فرآیند مانیتورینگ</div>
                    </div>
                    <svg class="md-drawer-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </div>
                }
                <div class="md-drawer-item md-drawer-item--danger" @onclick="() => { _showMenu = false; if (_isPoweredOn) { _ = ShowPowerAlert(); } else { _showDeleteConfirm = true; } }">
                    <div class="md-drawer-item-icon md-drawer-item-icon--del">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                            <path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/>
                            <path d="M10 11v6M14 11v6"/>
                        </svg>
                    </div>
                    <div class="md-drawer-item-text">
                        <div class="md-drawer-item-title">حذف مانیتورینگ</div>
                        <div class="md-drawer-item-desc">حذف کامل مانیتورینگ</div>
                    </div>
                    <svg class="md-drawer-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </div>
                <div class="md-drawer-divider"></div>
                <div class="md-drawer-item md-drawer-item--alert" @onclick="() => { _showMenu = false; _ = ToggleAlertModal(); }">
                    <div class="md-drawer-item-icon md-drawer-item-icon--alert">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
                            <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
                        </svg>
                    </div>
                    <div class="md-drawer-item-text">
                        <div class="md-drawer-item-title">اخطار و هشدار</div>
                        <div class="md-drawer-item-desc">@(_hasActiveAlerts ? $"{_alertCount} پیام جدید" : "هیچ پیامی وجود ندارد")</div>
                    </div>
                    @if (_hasActiveAlerts)
                    {
                        <span class="md-drawer-alert-count">@_alertCount</span>
                    }
                    <svg class="md-drawer-item-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                        <polyline points="15 18 9 12 15 6"/>
                    </svg>
                </div>
                <AuthorizeView Policy="perm:admin.monitoring.share">
                    <div class="md-drawer-divider"></div>
                    <div class="md-drawer-share">
                        <div class="md-share-toggle-row">
                            <span class="md-share-toggle-label">اشتراک‌گذاری زنده</span>
                            <label class="md-toggle">
                                <input type="checkbox" checked="@_isShareEnabled"
                                       disabled="@_isCreatingShareLink"
                                       @onchange="async (e) => await ToggleShare((bool)(e.Value ?? false))" />
                                <span class="md-toggle-slider"></span>
                            </label>
                        </div>
                        @if (_isCreatingShareLink)
                        {
                            <div class="md-share-loading">
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>در حال ایجاد لینک...</span>
                            </div>
                        }
                        @if (_isShareEnabled && !string.IsNullOrEmpty(_shareUrl))
                        {
                            <div class="md-share-link-section">
                                <div class="md-share-link-label">لینک اشتراک‌گذاری:</div>
                                <div class="md-share-link-box">
                                    <input type="text" class="md-share-link-input" value="@_shareUrl" readonly />
                                    <button class="md-share-copy-btn" @onclick="CopyShareLink" title="کپی لینک">
                                        @if (_shareLinkCopied)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5" width="14" height="14">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                        }
                                        else
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                                                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                                                <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/>
                                            </svg>
                                        }
                                    </button>
                                </div>
                                <div class="md-share-note">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="10" height="10">
                                        <circle cx="12" cy="12" r="10"/>
                                        <path d="M12 16v-4M12 8h.01"/>
                                    </svg>
                                    <span>هر کسی با این لینک می‌تواند وضعیت زنده مانیتورینگ را مشاهده کند (فقط خواندنی)</span>
                                </div>
                            </div>
                            <div class="md-viewers-section">
                                <div class="md-viewers-head">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                        <circle cx="12" cy="12" r="3"/>
                                    </svg>
                                    <span>بینندگان فعال</span>
                                    <span class="md-viewers-count">@_totalActiveViewers نفر</span>
                                </div>
                                @if (_activeViewers.Count == 0)
                                {
                                    <div class="md-viewers-empty">هیچ بیننده‌ای متصل نیست</div>
                                }
                                else
                                {
                                    <div class="md-viewers-list">
                                        @foreach (var v in _activeViewers)
                                        {
                                            <div class="md-viewers-item">
                                                <div class="md-viewers-device">@(!string.IsNullOrEmpty(v.DeviceInfo) ? v.DeviceInfo : "دستگاه ناشناس")</div>
                                                <div class="md-viewers-meta">
                                                    <span class="md-viewers-ip">@v.IpAddress</span>
                                                    <span class="md-viewers-sep">|</span>
                                                    <span class="md-viewers-time">@PersianDateHelper.ToPersianDateTimeString(v.EnteredAt.ToLocalTime(), true)</span>
                                                    <span class="md-viewers-sep">|</span>
                                                    <span class="md-viewers-ping">@GetViewerAgo(v.LastPingAt)</span>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </AuthorizeView>
                }
            </div>
        </div>
    }

    <div class="md-wrap @(_showMenu || _showWarning ? "md-no-scroll" : "")">
        <div class="md-foot md-foot--top">
            <div class="md-clock">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                    <circle cx="12" cy="12" r="10" />
                    <polyline points="12 6 12 12 16 14" />
                </svg>
                <span id="mdDate2">----/--/--</span>
                <span class="md-clock-sep">•</span>
                <span id="mdClock" class="md-clock-time">--:--:--</span>
            </div>
        </div>
        <div class="md-header">
            <div class="md-header-main">
                <div class="md-header-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#00A8A8" stroke-width="1.5" width="20" height="20">
                        <rect x="3" y="3" width="18" height="18" rx="3" />
                        <path d="M9 12h6M12 9v6" />
                        <circle cx="7" cy="7" r="1.5" fill="#00A8A8" />
                        <circle cx="17" cy="7" r="1.5" fill="#00A8A8" />
                        <circle cx="7" cy="17" r="1.5" fill="#00A8A8" />
                        <circle cx="17" cy="17" r="1.5" fill="#00A8A8" />
                    </svg>
                </div>
                <div class="md-header-text">
                    <div class="md-header-title">داشبورد مانیتورینگ</div>
                    <div class="md-header-sub">جزییات مانیتورینگ</div>
                </div>
            </div>
            <div class="md-header-timebox">
                <div class="md-header-timebox__device">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                        <rect x="2" y="3" width="20" height="14" rx="2"/>
                        <path d="M8 21h8M12 17v4"/>
                    </svg>
                    <span>@MonitoringDeviceTitle</span>
                </div>
            </div>
            <button class="md-header-menu-btn@(_hasActiveAlerts ? " has-alert" : "")" @onclick="ToggleMenu" title="منو">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                    <circle cx="12" cy="5" r="1.5" fill="currentColor"/>
                    <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                    <circle cx="12" cy="19" r="1.5" fill="currentColor"/>
                </svg>
                @if (_hasActiveAlerts)
                {
                    <span class="md-alert-badge">@_alertCount</span>
                }
            </button>
        </div>

    @if (!string.IsNullOrEmpty(_monitoringCreatedAtFa))
    {
        <div class="md-time-row">
            <div class="md-time-row__card">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span class="md-time-row__label">شروع</span>
                <span class="md-time-row__val">
                    @if (_startParts != null && _startParts.Length == 2)
                    {
                        <span class="md-time-row__time">@ToPersian(_startParts[1])</span>
                        <span class="md-time-row__date">@ToPersian(_startParts[0])</span>
                    }
                    else
                    {
                        @ToPersian(_monitoringCreatedAtFa)
                    }
                </span>
            </div>
            <div class="md-time-row__card">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
                <span class="md-time-row__label">مدت زمان</span>
                <span class="md-time-row__val md-time-row__val--green">@_elapsedLabel</span>
            </div>
        
        </div>
    }

    @if (_inGracePeriod)
    {
        <div class="md-grace-banner">
            <div class="md-grace-banner__inner">
                <div class="md-grace-banner__icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="18" height="18">
                        <circle cx="12" cy="12" r="10"/>
                        <polyline points="12 6 12 12 16 14"/>
                    </svg>
                </div>
                <div class="md-grace-banner__body">
                    <div class="md-grace-banner__title">مهلت ۲۴ ساعته</div>
                    <div class="md-grace-banner__desc">
                        زمان اشتراک دستگاه به پایان رسیده. تا پایان مهلت، دستگاه را خاموش کنید.
                    </div>
                </div>
                <div class="md-grace-banner__countdown">
                    <div class="md-grace-banner__countdown-val">
                        @if (_graceRemaining.TotalHours >= 1)
                        {
                            <span>@($"{(int)_graceRemaining.TotalHours:D2}:{_graceRemaining.Minutes:D2}:{_graceRemaining.Seconds:D2}")</span>
                        }
                        else
                        {
                            <span style="color:#ef4444;">@($"{_graceRemaining.Minutes:D2}:{_graceRemaining.Seconds:D2}")</span>
                        }
                    </div>
                    <div class="md-grace-banner__countdown-label">زمان باقی‌مانده</div>
                </div>
            </div>
        </div>
    }

    @if (IsReadOnly)
    {
        <div class="md-readonly-banner">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="14" height="14">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span>نمایش فقط خواندنی — اشتراک‌گذاری شده</span>
        </div>
    }

    @if (_hasActiveAlerts)
    {
        <div class="md-alert-banner" @onclick="ToggleMenu" role="button" tabindex="0">
            <div class="md-alert-banner__inner">
                <div class="md-alert-banner__icon">
                    <span class="oi oi-warning"></span>
                </div>
                <div class="md-alert-banner__body">
                    <div class="md-alert-banner__title">@_alertCount اخطار فعال</div>
                    <div class="md-alert-banner__desc">
                        @if (_alertCount == 1) { <span>1 اخطار برای این دستگاه ثبت شده — برای مشاهده کلیک کنید</span> }
                        else { <span>@_alertCount اخطار برای این دستگاه ثبت شده — برای مشاهده کلیک کنید</span> }
                    </div>
                </div>
