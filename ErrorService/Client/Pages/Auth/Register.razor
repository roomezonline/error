@page "/auth/register"
@using ErrorService.Shared
@inject ErrorService.Client.Services.AuthService Auth
@inject ErrorService.Client.Services.JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ErrorService.Client.Services.ToastService Toast

<div class="container py-5 d-flex justify-content-center align-items-center min-vh-80" dir="rtl">
    <div class="auth-card p-4 rounded-5 shadow-lg bg-white w-100" style="max-width: 400px;">
        <div class="text-center mb-4">
            <div class="auth-logo mb-3">
                <span class="oi oi-person text-success display-4"></span>
            </div>
            <h3 class="fw-black mb-1">ثبت‌نام سریع</h3>
            <p class="text-muted small">برای دسترسی به پنل و پیگیری‌ها عضو شوید</p>
        </div>

        <EditForm Model="model" OnValidSubmit="HandleRegister">
            <DataAnnotationsValidator />
            
            <div class="mb-3">
                <label class="form-label small fw-bold">نام و نام خانوادگی</label>
                <InputText @bind-Value="model.FullName" class="form-control auth-input rounded-pill px-4 py-2" placeholder="نام خود را وارد کنید" />
                <ValidationMessage For="@(() => model.FullName)" class="text-danger small" />
            </div>

            <div class="mb-3">
                <label class="form-label small fw-bold">شماره موبایل</label>
                <InputText @bind-Value="model.PhoneNumber" class="form-control auth-input rounded-pill px-4 py-2" placeholder="09xxxxxxxxx" />
                <ValidationMessage For="@(() => model.PhoneNumber)" class="text-danger small" />
            </div>

            <div class="mb-4">
                <label class="form-label small fw-bold">رمز عبور</label>
                <InputText @bind-Value="model.Password" type="password" class="form-control auth-input rounded-pill px-4 py-2" placeholder="••••" />
                <ValidationMessage For="@(() => model.Password)" class="text-danger small" />
            </div>

            <button type="submit" class="btn btn-success w-100 rounded-pill py-2 fw-bold shadow-sm" disabled="@isBusy">
                @if (isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                ایجاد حساب کاربری
            </button>
        </EditForm>

        <div class="text-center mt-4 border-top pt-3">
            <span class="text-muted small">قبلاً ثبت‌نام کرده‌اید؟</span>
            <a href="/auth/login" class="text-primary fw-bold small text-decoration-none ms-1">ورود به حساب</a>
        </div>
    </div>
</div>

<style>
    .auth-card { border: 1px solid rgba(0,0,0,0.05); }
    .auth-input { background: #f8fafc; border: 1px solid #e2e8f0; }
    .auth-input:focus { background: #fff; box-shadow: 0 0 0 0.25rem rgba(25, 135, 84, 0.1); }
    .fw-black { font-weight: 900; }
</style>

@code {
    private RegisterRequest model = new();
    private bool isBusy = false;

    private async Task HandleRegister()
    {
        isBusy = true;
        try
        {
            await Auth.RegisterAsync(model);
            AuthStateProvider.NotifyAuthStateChanged();
            Toast.ShowSuccess("ثبت‌نام با موفقیت انجام شد");
            Nav.NavigateTo("/profile");
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            isBusy = false;
        }
    }
}
