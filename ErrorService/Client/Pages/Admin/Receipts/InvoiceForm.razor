@page "/admin/receipts/invoice/{ReceiptId:int}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.receipts.invoice")]
@using ErrorService.Shared
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ErrorService.Client.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>صدور فاکتور</PageTitle>

<div class="iv-page" dir="rtl">
    @if (isLoading)
    {
        <div class="iv-loading">
            <div class="spinner-border text-primary"></div>
            <span>در حال بارگذاری اطلاعات...</span>
        </div>
    }
    else if (receipt == null)
    {
        <div class="iv-error">
            <span class="oi oi-warning"></span>
            <p>رسید مورد نظر یافت نشد.</p>
            <button class="iv-btn iv-btn--primary" @onclick='() => Navigation.NavigateTo("/admin/receipts")'>بازگشت به لیست</button>
        </div>
    }
    else
    {
        <div class="iv-header">
            <button class="iv-back" @onclick='() => Navigation.NavigateTo("/admin/receipts")'>
                <span class="oi oi-arrow-right"></span>
            </button>
            <div class="iv-title">
                <div class="iv-title__main">صدور فاکتور نهایی</div>
                <div class="iv-title__sub">برای رسید #@receipt.Id</div>
            </div>
            <div class="iv-actions">
                <div class="iv-total-pill" title="مبلغ کل">
                    <span class="iv-total-pill__label">کل</span>
                    <span class="iv-total-pill__value">@TotalAmount.ToString("N0")</span>
                </div>
                <button class="iv-save-btn" @onclick="SubmitInvoice">ثبت نهایی</button>
            </div>
        </div>

        <div class="iv-content">
            <!-- Glassmorphism Receipt Card -->
            <div class="iv-premium-card">
                <div class="iv-pc-blur"></div>
                <div class="iv-pc-content">
                    <div class="iv-pc-top">
                        <div class="iv-pc-user">
                            <div class="iv-pc-avatar">
                                <span class="oi oi-person"></span>
                            </div>
                            <div class="iv-pc-name-group">
                                <span class="iv-pc-name">@receipt.CustomerFirstName @receipt.CustomerLastName</span>
                                <div class="iv-pc-mobile-wrapper">
                                    <a class="iv-chip iv-chip--mobile ltr" href="tel:@receipt.CustomerMobile">
                                        <span class="oi oi-phone"></span>
                                        <span>@receipt.CustomerMobile</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="iv-pc-status @BadgeClass(receipt.Status)">
                            @StatusFa(receipt.Status)
                        </div>
                    </div>

                    <div class="iv-pc-chips">
                        <div class="iv-chip iv-chip--device">
                            <span class="oi oi-monitor"></span>
                            <span>@receipt.DeviceTypeName @(string.IsNullOrWhiteSpace(receipt.DeviceBrandName) ? "" : " - " + receipt.DeviceBrandName)</span>
                        </div>
                        <div class="iv-chip iv-chip--date">
                            <span class="oi oi-calendar"></span>
                            <span class="ltr">@PersianDateHelper.ToPersianDateTimeString(receipt.RegisteredAt, false)</span>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(receipt.ProblemDescription))
                    {
                        <div class="iv-pc-problem">
                            <div class="iv-pc-problem-label">شرح مشکل دستگاه:</div>
                            <div class="iv-pc-problem-text">@receipt.ProblemDescription</div>
                        </div>
                    }
                </div>
            </div>

            @if (showCatalogModal)
            {
                <div class="iv-modal-overlay" @onclick="CloseCatalog"></div>
                <div class="iv-modal">
                    <div class="iv-modal-header">
                        <span class="iv-modal-title">مدیریت کاتالوگ اقلام</span>
                        <button class="iv-modal-close" @onclick="CloseCatalog"><span class="oi oi-x"></span></button>
                    </div>
                    <div class="iv-modal-body">
                        @if (canManageCatalog)
                    {
                        <div class="iv-cat-add-form">
                            <div class="iv-cat-add-row">
                                <input class="iv-add-input" @bind="newCatalogTitle" placeholder="@(editingCatalogItem != null ? "ویرایش عنوان..." : "عنوان جدید (مثلاً: تعویض برد)...")" />
                            </div>
                            <div class="iv-cat-add-subrow">
                                <select class="iv-add-input" @bind="newCatalogDeviceTypeId">
                                    <option value="">عمومی (همه دستگاه‌ها)</option>
                                    @if (deviceTypes != null)
                                    {
                                        @foreach (var dt in deviceTypes)
                                        {
                                            <option value="@dt.Id">@dt.Name</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div class="iv-cat-add-options">
                                <label class="iv-check-label">
                                    <input type="checkbox" @bind="newCatalogIsActive" />
                                    فعال باشد
                                </label>
                                <label class="iv-check-label">
                                    <input type="checkbox" @bind="newCatalogSendSms" />
                                    ارسال پیامک فعال (در آینده)
                                </label>
                            </div>
                            @if (editingCatalogItem != null)
                            {
                                <div class="iv-cat-edit-actions">
                                    <button class="iv-add-btn iv-add-btn--secondary" @onclick="CancelEditCatalogItem">لغو ویرایش</button>
                                    <button class="iv-add-btn iv-add-btn--full" @onclick="UpdateCatalogItem">ذخیره تغییرات</button>
                                </div>
                            }
                            else
                            {
                                <button class="iv-add-btn iv-add-btn--full" @onclick="CreateCatalogItem">افزودن به کاتالوگ</button>
                            }
                        </div>
                    }
                        <div class="iv-cat-list">
                            @if (catalog == null || catalog.Count == 0)
                            {
                                <div class="iv-items-empty">موردی یافت نشد</div>
                            }
                            else
                            {
                                @foreach (var grp in groupedCatalog)
                                {
                                    <div class="iv-cat-group">
                                        <div class="iv-cat-group-header">@grp.Title</div>
                                        @foreach (var cat in grp.Items)
                                        {
                                            <div class="iv-cat-item @(cat.IsActive ? "" : "iv-cat-item--disabled")">
                                                <div class="iv-cat-main">
                                                    <span class="iv-cat-title">@cat.Title</span>
                                                    <div class="iv-cat-badges">
                                                        @if (!cat.IsActive) { <span class="iv-badge iv-badge--danger">غیرفعال</span> }
                                                        @if (cat.SendSms) { <span class="iv-badge iv-badge--info">SMS</span> }
                                                    </div>
                                                </div>
                                                @if (canManageCatalog)
                                                {
                                                    <div class="iv-cat-actions">
                                                        <button class="iv-cat-edit" @onclick="() => EditCatalogItem(cat)" title="ویرایش"><span class="oi oi-pencil"></span></button>
                                                        <button class="iv-item-remove" @onclick="() => DeleteCatalogItem(cat.Id)" title="حذف"><span class="oi oi-trash"></span></button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }

            <!-- Invoice Form Section -->
            <div class="iv-section-header">
                <div class="iv-section-title">اقلام فاکتور</div>
                @if (canManageCatalog)
                {
                    <button class="iv-manage-catalog" @onclick="OpenCatalog">
                        <span class="oi oi-cog"></span>
                        مدیریت کاتالوگ
                    </button>
                }
            </div>
            
            <div class="iv-card iv-items-card">
                <div class="iv-selector-box">
                    <button class="iv-selector-trigger" @onclick="ToggleSelector">
                        <span class="oi oi-magnifying-glass"></span>
                        <span>انتخاب سریع قطعات و اجرت‌ها...</span>
                        <span class="oi oi-chevron-bottom"></span>
                    </button>
                    
                    @if (showSelector)
                    {
                        <div class="iv-selector-overlay" @onclick="ToggleSelector"></div>
                        <div class="iv-selector-dropdown">
                            <div class="iv-selector-search">
                                <label class="iv-toggle-switch">
                                    <input type="checkbox" checked="@includeAllCatalogs" @onchange="OnIncludeAllCatalogsChanged" />
                                    <span class="iv-toggle-slider"></span>
                                    <span class="iv-toggle-label">نمایش همه</span>
                                </label>
                                <input placeholder="جستجوی سریع..." @bind="catalogSearch" @bind:event="oninput" />
                            </div>
                            <div class="iv-selector-list">
                                @foreach (var cat in filteredCatalog)
                                {
                                    <div class="iv-selector-item" @onclick="() => ToggleCatalogSelection(cat)">
                                        <div class="iv-check @(tempSelectedCatalogIds.Contains(cat.Id) ? "iv-check--active" : "")">
                                            <span class="oi oi-check"></span>
                                        </div>
                                        <div class="iv-sel-info">
                                            <span class="iv-sel-title">@cat.Title</span>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="iv-selector-footer">
                                <button class="iv-sel-btn iv-sel-btn--cancel" @onclick="ToggleSelector">انصراف</button>
                                <button class="iv-sel-btn iv-sel-btn--apply" @onclick="AddSelectedFromCatalog">
                                    افزودن
                                </button>
                            </div>
                        </div>
                    }
                </div>

                <div class="iv-items-list">
                    @if (invoiceItems.Count == 0)
                    {
                        <div class="iv-items-empty">
                            <span class="oi oi-list"></span>
                            <p>هنوز آیتمی اضافه نشده است</p>
                        </div>
                    }
                    else
                    {
                        @foreach (var item in invoiceItems)
                        {
                            <div class="iv-item-row iv-item-row--complex">
                                <div class="iv-item-top-row">
                                    <div class="iv-item-title-box">
                                        <span class="iv-item-title">@item.Title</span>
                                    </div>
                                    <button class="iv-item-remove" @onclick="() => RemoveItem(item)"><span class="oi oi-trash"></span></button>
                                </div>
                                
                                <div class="iv-item-inputs">
                                    <div class="iv-item-field iv-item-field--full">
                                        <label>شرح اقدامات</label>
                                        <textarea class="iv-add-input iv-textarea-auto" @bind="item.ActionDescription" placeholder="مثلاً: تعویض فیلتر و تست..." rows="2"></textarea>
                                    </div>
                                    <div class="iv-item-grid-2">
                                        <div class="iv-item-field">
                                            <label>فی (تومان)</label>
                                            <input type="text" inputmode="decimal" class="iv-add-input iv-input--money" value="@MoneyText(item, item.UnitPrice)" @oninput="(e) => OnUnitPriceInput(e, item)" @onblur="() => OnMoneyBlur(item)" />
                                        </div>
                                        <div class="iv-item-field">
                                            <label>تکنسین</label>
                                            <select class="iv-add-input iv-input--tech" @bind="item.TechnicianId">
                                                <option value="">-- انتخاب --</option>
                                                @if (technicians != null)
                                                {
                                                    @foreach (var tech in technicians)
                                                    {
                                                        <option value="@tech.Id">@tech.FullName</option>
                                                    }
                                                }
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                    }
                </div>

            </div>

            <div class="iv-section-title">
                <span class="oi oi-task"></span>
                تغییر وضعیت رسید
                <span class="iv-sms-badge @(smsLogCount == 0 ? "iv-sms-badge--empty" : "")" @onclick="() => { if (smsLogCount > 0) showSmsHistoryModal = true; }" title="@(smsLogCount > 0 ? "مشاهده تاریخچه پیامک‌ها" : "هنوز پیامکی ارسال نشده")">
                    <span class="iv-sms-badge__icon">
                        <span class="oi oi-comment-square"></span>
                    </span>
                    <span class="iv-sms-badge__count">@smsLogCount</span>
                </span>
            </div>
            <div class="iv-card iv-status-card">
                <div class="iv-status-options">
                    <div class="iv-status-opt iv-status--pending @(receiptStatus == "pending" ? "active" : "")" @onclick='() => receiptStatus = "pending"'>
                        <span class="oi oi-clock"></span>
                        در انتظار
                    </div>
                    <div class="iv-status-opt iv-status--repaired @(receiptStatus == "repaired" ? "active" : "")" @onclick='() => receiptStatus = "repaired"'>
                        <span class="oi oi-check"></span>
                        تعمیر شده
                    </div>
                    <div class="iv-status-opt iv-status--delivered @(receiptStatus == "delivered" ? "active" : "")" @onclick='() => receiptStatus = "delivered"'>
                        <span class="oi oi-home"></span>
                        تحویل شد
                    </div>
                    <div class="iv-status-opt iv-status--failed @(receiptStatus == "not_repairable" ? "active" : "")" @onclick='() => receiptStatus = "not_repairable"'>
                        <span class="oi oi-circle-x"></span>
                        غیرتعمیر
                    </div>
                </div>
            </div>

            <div class="iv-card iv-sms-history-row @(smsLogCount == 0 ? "iv-sms-history-row--empty" : "")" @onclick="() => { if (smsLogCount > 0) showSmsHistoryModal = true; }">
                <div class="iv-sms-history-row__icon">
                    <span class="oi oi-comment-square"></span>
                </div>
                <div class="iv-sms-history-row__info">
                    <div class="iv-sms-history-row__title">تاریخچه پیامک‌ها</div>
                    <div class="iv-sms-history-row__sub">
                        @if (smsLogCount > 0)
                        {
                            <span>@smsLogCount پیامک</span>
                        }
                        else
                        {
                            <span>هنوز پیامکی ارسال نشده</span>
                        }
                    </div>
                </div>
                <div class="iv-sms-history-row__arrow">
                    <span class="oi oi-chevron-left"></span>
                </div>
            </div>

            <div class="iv-section-title">
                <span class="oi oi-credit-card"></span>
                صورتحساب نهایی
            </div>
            <div class="iv-card iv-bill-card">
                <div class="iv-bill-grid">
                    <div class="iv-bill-field">
                        <label>صورتحساب کل (تومان)</label>
                        <input type="text" inputmode="decimal" class="iv-add-input iv-input--money" value="@FormatMoney(BillTotalLive)" readonly />
                    </div>
                    <div class="iv-bill-field">
                        <label>تخفیف (تومان)</label>
                        <input type="text" inputmode="decimal" class="iv-add-input iv-input--money" value="@MoneyText("discount", billDiscount)" @oninput="OnBillDiscountInput" @onblur='() => OnMoneyBlur("discount")' />
                        <div class="iv-bill-hint iv-text-center">@DiscountPercentText</div>
                    </div>
                    <div class="iv-bill-field">
                        <label>پیش پرداخت (تومان)</label>
                        <input type="text" inputmode="decimal" class="iv-add-input iv-input--money" value="@MoneyText("prepaid", billPrepaid)" @oninput="OnBillPrepaidInput" @onblur='() => OnMoneyBlur("prepaid")' />
                    </div>
                    <div class="iv-bill-field">
                        <label>پرداخت شده (تومان)</label>
                        <input type="text" inputmode="decimal" class="iv-add-input iv-input--money" value="@MoneyText("paid", billPaid)" @oninput="OnBillPaidInput" @onblur='() => OnMoneyBlur("paid")' />
                    </div>
                </div>

                <div class="iv-bill-summary">
                    <div class="iv-bill-sum-row">
                        <span>مبلغ قابل پرداخت:</span>
                        <strong class="iv-bill-clickable" @onclick="SetPaidToPayable">@FormatMoney(BillPayable)</strong>
                    </div>
                    <div class="iv-bill-sum-row">
                        <span>باقیمانده جهت تسویه:</span>
                        <strong class="@(BillRemaining > 0 ? "iv-bill-neg" : BillRemaining < 0 ? "iv-bill-pos" : "iv-bill-ok")">@FormatMoney(BillRemaining)</strong>
                    </div>
                </div>

                <div class="iv-bill-chip">
                    <span class="iv-chip-status @CustomerBalanceChipClass">
                        <span class="oi @(BillRemaining > 0 ? "oi-warning" : BillRemaining < 0 ? "oi-star" : "oi-circle-check")"></span>
                        @CustomerBalanceChipText
                    </span>
                </div>

    <div class="iv-bad-payer-toggle">
        <label class="iv-toggle-switch @(isBadPayer ? "iv-toggle-switch--bad" : "iv-toggle-switch--good")">
            <input type="checkbox" checked="@isBadPayer" @onchange="OnBadPayerToggleChanged" />
            <span class="iv-toggle-slider"></span>
            <span class="iv-toggle-label">وضعیت مشتری: @(isBadPayer ? "بدحساب" : "خوش حساب")</span>
        </label>
    </div>

    @if (bankAccounts != null && bankAccounts.Any())
    {
        <div class="iv-bank-select mt-3">
            <label class="form-label small fw-bold mb-2">انتخاب حساب بانکی برای واریز</label>
            <select class="form-select rounded-3" @bind="selectedBankAccountId">
                <option value="">-- انتخاب کنید --</option>
                @foreach (var acc in bankAccounts)
                {
                    <option value="@acc.Id">
                        @acc.BankName - @acc.Title @(FormatCardDisplay(acc.CardNumber))
                    </option>
                }
            </select>
        </div>
    }
</div>

            <button class="iv-btn-submit-all" @onclick="SubmitInvoiceAll">
                <span class="oi oi-circle-check"></span>
                تایید نهایی و ثبت فاکتور
            </button>
        </div>
        
        <!-- Mobile Bottom Action Bar -->
        <div class="iv-mobile-bar">
             <div class="iv-total">
                 <span class="iv-total-label">مبلغ کل فاکتور:</span>
                 <span class="iv-total-value">@TotalAmount.ToString("N0") <small>تومان</small></span>
             </div>
             <button class="iv-mobile-save" @onclick="SubmitInvoice">تایید و ثبت</button>
        </div>
    }
</div>

<ConfirmDialog 
    IsVisible="@showConfirmDialog" 
    Title="@confirmDialogTitle" 
    Message="@confirmDialogMessage" 
    IsDanger="@confirmDialogIsDanger" 
    OnResult="HandleConfirmDialogResult" />

<!-- SMS Confirmation Modal (آماده تحویل) -->
@if (showSmsModal && receipt != null)
{
    var smsCustomerName = $"{receipt.CustomerFirstName} {receipt.CustomerLastName}";
    var smsRegDate = PersianDateHelper.ToPersianDateTimeString(receipt.RegisteredAt, false);

    <div class="sms-overlay @(smsSent ? "sms-overlay--sent" : "")" @onclick="CloseSmsModal">
        <div class="sms-sheet" @onclick:stopPropagation>
            <div class="sms-sheet-handle"></div>

            <div class="sms-sheet-header">
                <div class="sms-sheet-icon @(_smsType == "not_repairable" ? "sms-sheet-icon--danger" : "")">
                    <span class="oi oi-envelope-open"></span>
                </div>
                <h3 class="sms-sheet-title">
                    @(_smsType == "not_repairable" ? "ارسال پیامک غیر قابل تعمیر" : "ارسال پیامک اطلاع رسانی")
                </h3>
                <p class="sms-sheet-subtitle">
                    @(_smsType == "not_repairable" ? "دستگاه مشتری قابل تعمیر نیست" : "دستگاه مشتری آماده تحویل است")
                </p>
            </div>

            <div class="sms-sheet-body">
                <div class="sms-chips-row">
                    <span class="sms-chip sms-chip--customer">
                        <span class="sms-chip-icon oi oi-person"></span>
                        @smsCustomerName
                    </span>
                    <span class="sms-chip sms-chip--mobile">
                        <span class="sms-chip-icon oi oi-phone"></span>
                        @receipt.CustomerMobile
                    </span>
                    <span class="sms-chip sms-chip--device">
                        <span class="sms-chip-icon oi oi-wrench"></span>
                        @receipt.DeviceTypeName (@(receipt.DeviceBrandName ?? ""))
                    </span>
                    <span class="sms-chip sms-chip--workshop">
                        <span class="sms-chip-icon oi oi-briefcase"></span>
                        @receipt.WorkshopName
                    </span>
                    <span class="sms-chip sms-chip--date">
                        <span class="sms-chip-icon oi oi-calendar"></span>
                        @smsRegDate
                    </span>
                    <span class="sms-chip sms-chip--id">
                        <span class="sms-chip-icon oi oi-tag"></span>
                        #@receipt.Id
                    </span>
                </div>

                <div class="sms-preview-section">
                    <div class="sms-preview-header">
                        <span class="oi oi-comment-square"></span>
                        پیش‌نمایش پیامک
                    </div>
                    <div class="sms-preview-bubble @(_smsType == "not_repairable" ? "sms-preview-bubble--danger" : "")">
                        <pre class="sms-preview-text">@smsPreviewText</pre>
                    </div>
                </div>

                @if (smsSent)
                {
                    <div class="sms-success-banner">
                        <span class="oi oi-circle-check"></span>
                        پیامک با موفقیت ارسال شد
                    </div>
                }
                else if (!string.IsNullOrEmpty(smsError))
                {
                    <div class="sms-error-banner">
                        <span class="oi oi-circle-x"></span>
                        @smsError
                    </div>
                }
            </div>

            <div class="sms-sheet-footer">
                @if (!smsSent)
                {
                    <button class="sms-btn sms-btn--primary" @onclick="SendSms" disabled="@isSendingSms">
                        @if (isSendingSms) { <span class="spinner-border spinner-border-sm"></span> }
                        <span class="oi oi-envelope-closed"></span>
                        ارسال پیامک
                    </button>
                    <button class="sms-btn sms-btn--ghost" @onclick="CloseSmsModal">بعداً ارسال می‌کنم</button>
                }
                else
                {
                    <button class="sms-btn sms-btn--primary" @onclick="CloseSmsModalAndExit">
                        <span class="oi oi-arrow-right"></span>
                        بازگشت به لیست رسیدها
                    </button>
                }
            </div>
        </div>
    </div>
}

<!-- SMS History Modal -->
@if (showSmsHistoryModal && smsLogs.Any())
{
    <div class="sms-overlay" @onclick="() => showSmsHistoryModal = false">
        <div class="sms-history-sheet" @onclick:stopPropagation>
            <div class="sms-sheet-handle"></div>

            <div class="sms-sheet-header">
                <div class="sms-sheet-icon sms-sheet-icon--history">
                    <span class="oi oi-list-rich"></span>
                </div>
                <h3 class="sms-sheet-title">تاریخچه پیامک‌ها</h3>
                <p class="sms-sheet-subtitle">@smsLogs.Count پیامک برای این رسید ارسال شده</p>
            </div>

            <div class="sms-sheet-body">
                @foreach (var log in smsLogs)
                {
                    <div class="sms-history-card">
                        <div class="sms-history-card__header">
                            <span class="sms-module-chip sms-module-chip--@(log.ModuleType?.ToLower() ?? "default")">@log.ModuleTitle</span>
                            <span class="sms-badge sms-badge--@(log.SendStatus == "ارسال شده" ? "success" : log.SendStatus == "ناموفق" ? "danger" : "warn")">@log.SendStatus</span>
                        </div>
                        <div class="sms-history-card__body">
                            <pre class="sms-history-card__text">@log.MessageText</pre>
                        </div>
                        <div class="sms-history-card__footer">
                            <span>به @log.RecipientNumber</span>
                            <span class="sms-history-card__delivery">
                                وضعیت تحویل:
                                <span class="sms-badge sms-badge--@(log.DeliveryStatus == 2 ? "success" : log.DeliveryStatus == 1 ? "info" : log.DeliveryStatus == 3 ? "danger" : "warn")">
                                    @(log.DeliveryStatus == 0 ? "در انتظار" : log.DeliveryStatus == 1 ? "ارسال به مخابرات" : log.DeliveryStatus == 2 ? "رسیده" : log.DeliveryStatus == 3 ? "نرسیده" : "نامشخص")
                                </span>
                            </span>
                            <span class="sms-history-card__date">@log.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</span>
                        </div>
                    </div>
                }
            </div>

            <div class="sms-sheet-footer">
                <button class="sms-btn sms-btn--ghost" @onclick='() => showSmsHistoryModal = false'>بستن</button>
            </div>
        </div>
    </div>
}

