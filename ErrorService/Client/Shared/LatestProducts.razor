@using ErrorService.Shared
@using System.Net.Http.Json
@using System.Threading
@implements IDisposable
@inject IJSRuntime JS
@using ErrorService.Client.Services
@inject CartService CartService
@inject ToastService ToastService
@using ErrorService.Client.Shared

@if (settings != null && settings.ShowLatestProducts)
{
    @if (products == null)
    {
        <div class="d-flex gap-3 overflow-hidden px-2">
            @for (int i = 0; i < 4; i++)
            {
                <div style="flex: 0 0 280px; min-width: 280px;">
                    <div class="product-card-skeleton rounded-4 bg-white shadow-sm p-3">
                        <div class="skeleton-img rounded-3 mb-3"></div>
                        <div class="skeleton-text mb-2"></div>
                        <div class="skeleton-text w-50"></div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!products.Any())
    {
        <div class="text-center py-5">
            <span class="oi oi-box display-1 text-light mb-3"></span>
            <p class="text-muted">در حال حاضر محصولی برای نمایش وجود ندارد.</p>
        </div>
    }
    else
    {
        <section class="latest-products home-section bg-light" dir="rtl">
            <div class="container-fluid px-2 px-md-4">
                <div class="home-head px-2">
                    <h2 class="home-head__title">آخرین محصولات</h2>
                    <div class="home-head__actions">
                        <a href="/products" class="home-more">مشاهده همه <span class="oi oi-arrow-left" aria-hidden="true"></span></a>
                        <CarouselControls TrackId="latest-products-track" />
                    </div>
                </div>

                <div class="products-scroll-container" id="latest-products-track" @ref="scrollContainer">
                    @for (var i = 0; i < products.Count; i++)
                    {
                        var prod = products[i];
                        <div class="product-scroll-item" @key="prod.Id">
                            <ProductCard Product="prod"
                                         Index="i"
                                         CountdownText="@(DiscountHelper.IsTimedActive(prod) ? GetCountdown(prod.Id) : null)" />
                        </div>
                    }
                </div>
            </div>
        </section>
    }
}


@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private List<ProductDto>? products;
    private SiteSettingsDto? settings;
    private ElementReference scrollContainer;
    private Timer? timer;
    private Dictionary<int, string> countDowns = new();
    private bool _dragScrollInitialized;

    protected override void OnInitialized()
    {
        CartService.OnChange += StateHasChanged;
    }

    [Inject] private SiteSettingsService SettingsService { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            settings = await SettingsService.GetAsync();
            if (settings != null && !settings.ShowLatestProducts) return;

            products = await Http.GetFromJsonAsync<List<ProductDto>>("api/products?onlyAvailable=true&skip=0&take=10");
            if (products != null && products.Any(DiscountHelper.IsTimedActive))
            {
                StartTimer();
            }
        }
        catch { products = new(); }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_dragScrollInitialized && products != null && products.Any())
        {
            _dragScrollInitialized = true;
            await JS.InvokeVoidAsync("initDragScroll", scrollContainer);
        }
    }

    private void StartTimer()
    {
        timer = new Timer(_ =>
        {
            if (products == null) return;
            bool changed = false;
            foreach (var prod in products.Where(DiscountHelper.IsTimedActive))
            {
                var remaining = DiscountHelper.GetRemaining(prod);
                if (!remaining.HasValue) continue;
                var diff = remaining.Value;
                string text;
                if (diff.TotalSeconds <= 0)
                {
                    text = "پایان یافت";
                }
                else
                {
                    int days = (int)diff.TotalDays;
                    if (days > 0)
                        text = $"{days} روز و {diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}";
                    else
                        text = $"{diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}";
                }

                if (!countDowns.ContainsKey(prod.Id) || countDowns[prod.Id] != text)
                {
                    countDowns[prod.Id] = text;
                    changed = true;
                }
            }
            if (changed) InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    private string GetCountdown(int id) => countDowns.TryGetValue(id, out var text) ? text : "";

    private async Task Add(ProductDto p)
    {
        await CartService.AddToCartAsync(p, 1);
        ToastService.ShowSuccess($"{p.Name} به سبد خرید اضافه شد.");
        StateHasChanged();
    }

    private async Task Inc(ProductDto p)
    {
        await CartService.AddToCartAsync(p, 1);
        StateHasChanged();
    }

    private async Task Dec(int productId)
    {
        var current = CartService.GetQuantity(productId);
        await CartService.UpdateQuantityAsync(productId, current - 1);
        StateHasChanged();
    }

    public void Dispose()
    {
        timer?.Dispose();
        CartService.OnChange -= StateHasChanged;
    }
}
