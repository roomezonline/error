    private static bool IsUserLike(ChatMessageDto m) =>
        m.SenderType == ChatSenderTypeDto.User ||
        (m.SenderType == ChatSenderTypeDto.Operator && m.SenderId != null && m.SenderId.StartsWith("اپراتور ("));

    private static bool IsOperatorLike(ChatMessageDto m) =>
        m.SenderType == ChatSenderTypeDto.Operator && !IsUserLike(m);

    private static string MsgClass(ChatMessageDto m)
    {
        if (IsUserLike(m)) return "msg-user";
        if (IsOperatorLike(m)) return "msg-op";
        return "msg-sys";
    }

    private static string UserChannelLabel(string senderId)
    {
        if (string.IsNullOrWhiteSpace(senderId)) return "";
        var i = senderId.IndexOf('(');
        return i >= 0 && senderId.EndsWith(")") ? senderId.Substring(i) : "";
    }

    private string _cannedSearch = "";

    private List<CannedResponseDto> FilteredCannedResponses => string.IsNullOrWhiteSpace(_cannedSearch)
        ? _cannedResponses
        : _cannedResponses.Where(c =>
            c.Title?.Contains(_cannedSearch, StringComparison.OrdinalIgnoreCase) == true ||
            c.Content?.Contains(_cannedSearch, StringComparison.OrdinalIgnoreCase) == true ||
            c.Category?.Contains(_cannedSearch, StringComparison.OrdinalIgnoreCase) == true).ToList();

    private IReadOnlyList<CannedGroup> GroupedCanned => FilteredCannedResponses
        .GroupBy(c => string.IsNullOrWhiteSpace(c.Category) ? "سایر" : c.Category.Trim())
        .Select(g => new CannedGroup { Category = g.Key, Items = g.OrderBy(x => x.Title).ToList() })
        .ToList();

