    private async Task ToggleVoice()
    {
        if (_recState == RecOrder.Recording)
        {
            try { await JS.InvokeVoidAsync("__chatVoiceRecorder.stop"); } catch { }
            return;
        }
        if (_recState == RecOrder.Preview) return;
        try
        {
            var ok = await JS.InvokeAsync<bool>("__chatVoiceRecorder.start");
            _recState = ok ? RecOrder.Recording : RecOrder.Idle;
            if (ok) _recSeconds = 0;
        }
        catch { _recState = RecOrder.Idle; }
        StateHasChanged();
    }

    private async Task SendPendingVoice()
    {
        _recState = RecOrder.Idle;
        _pendingVoiceUrl = "";
        var ok = false;
        try { ok = await JS.InvokeAsync<bool>("__chatVoiceRecorder.uploadPending"); }
        catch { }
        if (!ok) _recSeconds = 0;
        StateHasChanged();
    }

    private async Task ReRecordVoice()
    {
        try { await JS.InvokeVoidAsync("__chatVoiceRecorder.clearPending"); } catch { }
        _pendingVoiceUrl = "";
        _recSeconds = 0;
        try
        {
            var ok = await JS.InvokeAsync<bool>("__chatVoiceRecorder.start");
            _recState = ok ? RecOrder.Recording : RecOrder.Idle;
            if (ok) _recSeconds = 0;
        }
        catch { _recState = RecOrder.Idle; }
        StateHasChanged();
    }

    private async Task DiscardPendingVoice()
    {
        try { await JS.InvokeVoidAsync("__chatVoiceRecorder.clearPending"); } catch { }
