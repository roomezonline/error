    private async Task SelectSession(int sessionId)
    {
        _selectedSessionId = sessionId;
        _selectedSession = _allSessions.FirstOrDefault(s => s.Id == sessionId);
        if (_selectedSession != null) _selectedSession.HasUnread = false;
        _newSessionCount = 0;
        _messages.Clear();
        _searchText = "";
        _replyToMessage = null;
        CancelEdit();
        _showMobileSidebar = false;

        if (_hub != null)
            await _hub.InvokeAsync("JoinSession", sessionId);

        try
        {
            var resp = await Http.GetFromJsonAsync<JsonElement>($"api/chat/sessions/{sessionId}/messages?take=200");
            if (resp.ValueKind == JsonValueKind.Object && resp.TryGetProperty("items", out var items))
            {
                _messages = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessageDto>>(items.GetRawText(), new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
        }
        catch { }

        await ScrollToBottom();
        StateHasChanged();

        // Mark unread user messages as read
        var unreadIds = _messages
            .Where(m => m.SenderType == ChatSenderTypeDto.User && !m.IsRead)
            .Select(m => m.Id)
            .ToList();
        if (unreadIds.Count > 0 && _hub?.State == HubConnectionState.Connected)
        {
            try { await _hub.InvokeAsync("MarkAsRead", sessionId, unreadIds); } catch { }
        }
    }

    private async Task SendMessage()
    {
        var text = _inputText.Trim();
        if (string.IsNullOrWhiteSpace(text) || _selectedSessionId == 0) return;
        if (_hub == null) { await ConnectHub(); }
        if (_hub?.State != HubConnectionState.Connected)
        {
            try { await _hub!.StartAsync(); } catch { return; }
        }
        _inputText = "";
        _userTyping = false;

        var tempId = _nextTempId--;
        _pendingTempIds.Enqueue(tempId);
        _messages.Add(new ChatMessageDto
        {
            Id = tempId,
            SessionId = _selectedSessionId,
            SenderType = ChatSenderTypeDto.Operator,
            Content = text,
            MessageType = ChatMessageTypeDto.Text,
            CreatedAt = DateTime.UtcNow,
            Status = ChatMessageStatusDto.Sending,
            ReplyToId = _replyToMessage?.Id
        });
        ScrollToBottom();
        StateHasChanged();

        var replyToId = _replyToMessage?.Id;
        CancelReply();
        try
        {
            var ok = await _hub.InvokeAsync<bool>("SendMessage", _selectedSessionId, text, ChatMessageTypeDto.Text, null, replyToId);
            if (!ok)
            {
                _messages.RemoveAll(m => m.Id == tempId);
                _chatError = "پیام ارسال نشد. شاید مکالمه بسته شده یا دسترسی ندارید.";
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _messages.RemoveAll(m => m.Id == tempId);
            _chatError = "ارسال ناموفق بود. اتصال را بررسی کنید.";
            _ = JS.InvokeVoidAsync("console.error", "SendMessage failed:", ex.Message, ex.ToString());
            StateHasChanged();
        }
    }

