@page "/admin/products"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.products.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using ErrorService.Client.Utils

@using ErrorService.Client.Services
@implements IDisposable
@inject IJSRuntime JS
@inject ToastService ToastService

<div class="admin-container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="admin-page-title m-0">مدیریت محصولات</h3>
        <button class="btn btn-primary shadow-sm rounded-3" @onclick="NewProduct">
            <span class="oi oi-plus me-1"></span> افزودن محصول جدید
        </button>
    </div>

    <ConfirmDialog IsVisible="showConfirm" 
                   Title="حذف محصول" 
                   Message=@($"آیا از حذف محصول \"{itemToDelete?.Name}\" اطمینان دارید؟")
                   OnResult="HandleDeleteResult" />

    @if (showEditor)
    {
        <div @ref="editorCard" class="card shadow-sm border-0 rounded-4 mb-4 p-4 animate__animated animate__fadeIn">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h5 class="m-0">@(editingId == 0 ? "ایجاد محصول جدید" : "ویرایش محصول")</h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>

            <EditForm Model="model" OnValidSubmit="SaveProduct">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-8">
                        <div class="mb-3">
                            <label class="form-label fw-bold">نام محصول</label>
                            <InputText @bind-Value="model.Name" class="form-control rounded-3" />
                            <ValidationMessage For="@(() => model.Name)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">کد محصول - SKU (اختیاری)</label>
                            <InputText @bind-Value="model.Sku" class="form-control rounded-3 ltr" placeholder="مثال: ERR-SENS-001" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">توضیحات</label>
                            <div class="editor-container">
                                <textarea id="tiny-editor-product" class="form-control">@model.Description</textarea>
                            </div>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">قیمت (تومان)</label>
                                <input type="text" class="form-control rounded-3 price-input-ltr" id="price-input"
                                       value="@(model.Price > 0 ? model.Price.ToString("N0") : "")" />
                                <ValidationMessage For="@(() => model.Price)" class="text-danger small" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">نوع تخفیف</label>
                                <div class="d-flex gap-3 flex-wrap align-items-center pt-1">
                                    <label class="form-check form-check-inline m-0">
                                        <input type="radio" class="form-check-input" name="discountType" value="" checked="@(discountTypeInput == DiscountTypeNone)" @onchange="() => SetDiscountType(DiscountTypeNone)" />
                                        <span class="form-check-label small fw-bold">بدون تخفیف</span>
                                    </label>
                                    <label class="form-check form-check-inline m-0">
                                        <input type="radio" class="form-check-input" name="discountType" value="permanent" checked="@(discountTypeInput == DiscountTypePermanent)" @onchange="() => SetDiscountType(DiscountTypePermanent)" />
                                        <span class="form-check-label small fw-bold">دائمی</span>
                                    </label>
                                    <label class="form-check form-check-inline m-0">
                                        <input type="radio" class="form-check-input" name="discountType" value="timed" checked="@(discountTypeInput == DiscountTypeTimed)" @onchange="() => SetDiscountType(DiscountTypeTimed)" />
                                        <span class="form-check-label small fw-bold">زمان‌دار</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        @if (discountTypeInput == "permanent" || discountTypeInput == "timed")
                        {
                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">قیمت با تخفیف</label>
                                    <input type="text" class="form-control rounded-3 price-input-ltr" id="discount-price-input"
                                           value="@(model.DiscountPrice.HasValue ? model.DiscountPrice.Value.ToString("N0") : "")" />
                                </div>
                            </div>
                        }
                        @if (discountTypeInput == "timed")
                        {
                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">تاریخ شروع تخفیف</label>
                                    <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="discountStartInput" />
                                    <div class="text-muted small mt-1">در صورت خالی بودن، از همین حالا فعال است.</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label fw-bold">تاریخ پایان تخفیف <span class="text-danger">*</span></label>
                                    <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="discountExpiryInput" />
                                    <div class="text-muted small mt-1">پس از این تاریخ، قیمت اصلی نمایش داده می‌شود.</div>
                                </div>
                            </div>
                        }
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">تاریخ و ساعت ایجاد محصول</label>
                                <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="createdAtInput" />
                                <div class="text-muted small mt-1">در صورت خالی بودن، زمان فعلی ثبت می‌شود.</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">دسته‌بندی</label>
                            <InputSelect @bind-Value="model.CategoryId" class="form-select rounded-3">
                                <option value="0">انتخاب کنید...</option>
                                @if (categories != null)
                                {
                                    @foreach (var cat in categories)
                                    {
                                        <option value="@cat.Id">@cat.Name</option>
                                    }
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => model.CategoryId)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">تصاویر محصول (حداکثر 4 عدد)</label>
                            <div class="row g-2">
                                <div class="col-6">
                                    <ImageUploader @bind-ImageUrl="model.MainImageUrl" UploadUrl="api/products/upload" ShowCamera="false" />
                                    <div class="text-center small text-muted">تصویر اصلی</div>
                                </div>
                                <div class="col-6">
                                    <ImageUploader @bind-ImageUrl="model.ImageUrl2" UploadUrl="api/products/upload" ShowCamera="false" />
                                    <div class="text-center small text-muted">تصویر 2</div>
                                </div>
                                <div class="col-6">
                                    <ImageUploader @bind-ImageUrl="model.ImageUrl3" UploadUrl="api/products/upload" ShowCamera="false" />
                                    <div class="text-center small text-muted">تصویر 3</div>
                                </div>
                                <div class="col-6">
                                    <ImageUploader @bind-ImageUrl="model.ImageUrl4" UploadUrl="api/products/upload" ShowCamera="false" />
                                    <div class="text-center small text-muted">تصویر 4</div>
                                </div>
                            </div>
                        </div>
                        <div class="form-check form-switch mt-4">
                            <InputCheckbox @bind-Value="model.IsAvailable" class="form-check-input" id="isAvailable" />
                            <label class="form-check-label fw-bold" for="isAvailable">قابل فروش</label>
                        </div>
                        <div class="form-check form-switch mt-3">
                            <InputCheckbox @bind-Value="model.IsFeatured" class="form-check-input" id="isFeatured" />
                            <label class="form-check-label fw-bold" for="isFeatured">محصول مهم (نمایش در هیرو و صفحه اصلی)</label>
                        </div>
                        <div class="mt-3">
                            <label class="form-label fw-bold">موجودی انبار (تعداد)</label>
                            <InputNumber @bind-Value="model.StockQuantity" class="form-control rounded-3" min="0" />
                            <div class="text-muted small mt-1">در صورت ۰ بودن، محصول به صورت خودکار غیرفعال می‌شود.</div>
                        </div>
                    </div>
                </div>

                <div class="mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3" @onclick="() => showTechnical = !showTechnical">
                        <span class="oi oi-@(showTechnical ? "chevron-top" : "chevron-bottom") me-1"></span>
                        اطلاعات فنی
                    </button>
                    @if (showTechnical)
                    {
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">اطلاعات سازگاری</label>
                                <InputTextArea @bind-Value="model.CompatibilityInfo" class="form-control rounded-3" rows="3" placeholder="برندها و مدل‌های سازگار با این قطعه" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">علائم خرابی</label>
                                <InputTextArea @bind-Value="model.FailureSymptoms" class="form-control rounded-3" rows="3" placeholder="علائمی که نشان می‌دهد این قطعه خراب است" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">لینک دیتاشیت (PDF)</label>
                                <InputText @bind-Value="model.DatasheetUrl" class="form-control rounded-3" placeholder="https://example.com/datasheet.pdf" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">شناسه محصولات مرتبط</label>
                                <InputText @bind-Value="model.RelatedProductIds" class="form-control rounded-3" placeholder="مثال: 5,12,23" />
                                <div class="text-muted small mt-1">شناسه عددی محصولات مرتبط را با کاما جدا کنید.</div>
                            </div>
                        </div>
                    }
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-light rounded-3 px-4" @onclick="CloseEditor">انصراف</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4" disabled="@(isSaving || isUploading)">
                        @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        ذخیره نهایی محصول
                    </button>
                </div>
            </EditForm>
        </div>
    }

    <div class="admin-toolbar">
        <div class="search-box">
            <svg class="search-box__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                <circle cx="11" cy="11" r="8"/>
                <line x1="21" y1="21" x2="16.65" y2="16.65"/>
            </svg>
            <input type="text" class="search-box__input" placeholder="جستجوی محصول..." 
                   value="@_searchQuery" @oninput="OnSearchInput" />
            @if (!string.IsNullOrEmpty(_searchQuery))
            {
                <button class="search-box__clear" @onclick="ClearSearch">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                        <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
                    </svg>
                </button>
            }
        </div>
        <button type="button" class="stock-filter-chip @(_showLowStockOnly ? "stock-filter-chip--active" : "")" @onclick="ToggleLowStock">
            <span class="oi oi-@(_showLowStockOnly ? "check" : "warning") me-1"></span>
            موجودی کم (≤ ۵)
        </button>
        <button type="button" class="stock-filter-chip @(_showFeaturedOnly ? "stock-filter-chip--active" : "")" @onclick="ToggleFeaturedFilter">
            <span class="oi oi-@(_showFeaturedOnly ? "check" : "star") me-1"></span>
            فقط مهم‌ها
        </button>
        @if (products != null)
        {
            <span class="admin-toolbar__count">@FilteredProducts.Count از @totalCount محصول</span>
        }
    </div>

    <div class="product-grid">
        @if (products == null)
        {
            <div class="product-grid__empty">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (!products.Any())
        {
            <div class="product-grid__empty">
                <span class="oi oi-cart" style="font-size: 2rem; opacity: 0.3;"></span>
                <p class="text-muted mt-2 mb-0">هیچ محصولی یافت نشد.</p>
            </div>
        }
        else if (!FilteredProducts.Any())
        {
            <div class="product-grid__empty">
                <span class="oi oi-magnifying-glass" style="font-size: 2rem; opacity: 0.3;"></span>
                <p class="text-muted mt-2 mb-0">محصولی با این عبارت یافت نشد.</p>
            </div>
        }
        else
        {
            @foreach (var prod in FilteredProducts)
            {
                <div class="product-card">
                    <div class="product-card__top">
                        <div class="product-card__thumb">
                            @if (!string.IsNullOrEmpty(prod.MainImageUrl))
                            {
                                <img src="@prod.MainImageUrl" onerror="this.src='/images/placeholder-product.svg'" />
                            }
                            else
                            {
                                <div class="product-card__thumb--empty">
                                    <span class="oi oi-image"></span>
                                </div>
                            }
                        </div>
                        <div class="product-card__info">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <div class="product-card__name">@prod.Name</div>
                                @if (prod.IsFeatured)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill" title="محصول مهم">
                                        <span class="oi oi-star"></span> مهم
                                    </span>
                                }
                            </div>
                            <div class="product-card__id">کد: #@prod.Id@(!string.IsNullOrWhiteSpace(prod.Sku) ? $" • {prod.Sku}" : "")</div>
                        </div>
                        <span class="product-card__status @(prod.IsAvailable ? "status-available" : "status-unavailable")">
                            @(prod.IsAvailable ? $"موجود ({prod.StockQuantity} عدد)" : "ناموجود")
                        </span>
                    </div>
                    <div class="product-card__body">
                        <div class="product-card__row">
                            <span class="product-card__label">دسته‌بندی</span>
                            <span class="product-card__value">@prod.CategoryName</span>
                        </div>
                        <div class="product-card__row">
                            <span class="product-card__label">قیمت</span>
                            <span class="product-card__value">
                                @if (DiscountHelper.IsActive(prod))
                                {
                                    <span class="text-decoration-line-through text-muted ms-2" style="font-size:0.75rem;">@prod.Price.ToString("N0")</span>
                                    <span class="fw-bold text-success">@DiscountHelper.GetEffectivePrice(prod).ToString("N0") <small>تومان</small></span>
                                }
                                else
                                {
                                    <span class="fw-bold">@prod.Price.ToString("N0") <small>تومان</small></span>
                                }
                            </span>
                        </div>
                        <div class="product-card__row">
                            <span class="product-card__label">تخفیف</span>
                            <span class="product-card__value">
                                @if (DiscountHelper.IsTimedActive(prod))
                                {
                                    <span class="badge bg-primary rounded-pill">زمان‌دار تا @prod.DiscountExpiryDate!.Value.ToString("yyyy/MM/dd HH:mm")</span>
                                }
                                else if (DiscountHelper.IsPermanentActive(prod))
                                {
                                    <span class="badge bg-info text-dark rounded-pill">دائمی</span>
                                }
                                else if (DiscountHelper.IsExpired(prod))
                                {
                                    <span class="badge bg-danger rounded-pill">منقضی</span>
                                }
                                else if (DiscountHelper.IsScheduled(prod))
                                {
                                    <span class="badge bg-secondary rounded-pill">شروع نشده</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div class="product-card__actions">
                        <button class="btn-icon btn-icon--edit" title="ویرایش" @onclick="() => EditProduct(prod)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
                            </svg>
                        </button>
                        <button class="btn-icon btn-icon--delete" title="حذف" @onclick="() => DeleteProduct(prod)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="16" height="16">
                                <polyline points="3 6 5 6 21 6"/>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                <line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/>
                            </svg>
                        </button>
                    </div>
                </div>
            }
        }
    </div>

    @if (products != null && products.Count < totalCount)
    {
        <div class="text-center p-3">
            <button class="btn btn-outline-primary btn-sm rounded-pill px-4" @onclick="() => LoadProducts(true)" disabled="@isLoadingMore">
                @if (isLoadingMore)
                {
                    <span class="spinner-border spinner-border-sm me-1"></span>
                }
                مشاهده بیشتر (@(totalCount - products.Count) مورد باقی‌مانده)
            </button>
        </div>
    }
</div>

<style>
    .object-fit-cover { object-fit: cover; }
    .bg-success-subtle { background-color: #d1e7dd; }
    .bg-danger-subtle { background-color: #f8d7da; }
    .price-input-ltr { direction: ltr; text-align: left; }

    .admin-toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }
    .admin-toolbar__count {
        font-size: 0.85rem;
        color: #64748b;
        white-space: nowrap;
    }
    .search-box {
        position: relative;
        flex: 1;
        max-width: 360px;
    }
    .stock-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 8px 14px;
        border: 1px solid #e2e8f0;
        background: #fff;
        color: #94a3b8;
        border-radius: 999px;
        font-size: 0.78rem;
        font-weight: 800;
        white-space: nowrap;
        cursor: pointer;
        transition: all 0.15s;
    }
    .stock-filter-chip--active {
        background: #fef3c7;
        border-color: #f59e0b;
        color: #b45309;
    }
    .search-box__icon {
        position: absolute;
        right: 14px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        pointer-events: none;
    }
    .search-box__input {
        width: 100%;
        padding: 8px 42px 8px 42px;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        font-size: 0.9rem;
        background: #fff;
        outline: none;
        transition: border-color 0.2s;
    }
    .search-box__input:focus {
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
    }
    .search-box__clear {
        position: absolute;
        left: 8px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        color: #94a3b8;
        cursor: pointer;
        padding: 4px;
        display: flex;
    }
    .search-box__clear:hover { color: #64748b; }

    .product-grid {
        display: grid;
        gap: 12px;
    }
    .product-grid__empty {
        grid-column: 1 / -1;
        text-align: center;
        padding: 48px 16px;
        background: #fff;
        border-radius: 16px;
        border: 1px solid #f1f5f9;
    }

    .product-card {
        background: #fff;
        border: 1px solid #f1f5f9;
        border-radius: 14px;
        overflow: hidden;
        transition: box-shadow 0.2s, transform 0.2s;
    }
    .product-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.06);
        transform: translateY(-1px);
    }
    .product-card__top {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 14px 0;
    }
    .product-card__thumb {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        overflow: hidden;
        background: #f8fafc;
        flex-shrink: 0;
    }
    .product-card__thumb img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .product-card__thumb--empty {
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #cbd5e1;
        font-size: 1.2rem;
        background: #f8fafc;
        border: 1px dashed #e2e8f0;
        border-radius: 10px;
    }
    .product-card__info {
        flex: 1;
        min-width: 0;
    }
    .product-card__name {
        font-weight: 700;
        color: #0f172a;
        font-size: 0.9rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .product-card__id {
        font-size: 0.75rem;
        color: #94a3b8;
        margin-top: 1px;
    }
    .product-card__status {
        font-size: 0.7rem;
        padding: 3px 10px;
        border-radius: 20px;
        font-weight: 600;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .status-available {
        background: #dcfce7;
        color: #166534;
    }
    .status-unavailable {
        background: #fee2e2;
        color: #991b1b;
    }
    .product-card__body {
        padding: 10px 14px 0;
    }
    .product-card__row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 4px 0;
    }
    .product-card__label {
        font-size: 0.78rem;
        color: #64748b;
    }
    .product-card__value {
        font-size: 0.82rem;
        color: #0f172a;
        text-align: left;
    }
    .product-card__actions {
        display: flex;
        justify-content: flex-end;
        gap: 6px;
        padding: 10px 14px;
        border-top: 1px solid #f8fafc;
        margin-top: 8px;
    }

    .btn-icon {
        width: 34px;
        height: 34px;
