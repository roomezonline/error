@page "/admin/hostinfo"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@using System.Globalization
@using ErrorService.Shared
@attribute [Authorize(Policy = "perm:admin.hostinfo.view")]
@inject HttpClient Http
@inject IJSRuntime JS
<PageTitle>تحلیل فضای ذخیره‌سازی هاست</PageTitle>
<div class="hi-page" dir="rtl">
<header class="hi-header"><div><h1><span class="oi oi-hard-drive"></span> تحلیل فضای ذخیره‌سازی هاست</h1><p>وضعیت دیسک، فایل‌های برنامه، مصرف پایگاه داده و پردازش‌ها</p></div><div class="hi-actions"><button @onclick="RefreshAsync" disabled="@_busy"><span class="oi oi-reload"></span> بروزرسانی تحلیل</button></div></header>
@if(_info is null){<div class="hi-empty">در حال دریافت اطلاعات هاست...</div>}else{
<section class="hi-kpis"><div class="hi-kpi"><b>@FmtGb(_info.Disk.TotalGb)</b><span>ظرفیت کل</span><small dir="ltr">@_info.Disk.Volume</small></div><div class="hi-kpi"><b>@FmtGb(_info.Disk.UsedGb)</b><span>فضای اشغال‌شده</span><small>@Fa(_info.Disk.UsedPercent.ToString("0.#", CultureInfo.InvariantCulture))٪ از ظرفیت</small></div><div class="hi-kpi"><b>@FmtGb(_info.Disk.FreeGb)</b><span>فضای آزاد</span><small>قابل استفاده</small></div><div class="hi-kpi"><b>@FmtMb(_info.Files.TotalMb)</b><span>فایل‌های برنامه</span><small>@Fa(_info.Files.Folders.Count) پوشه</small></div><div class="hi-kpi"><b>@FmtMb(_info.Database.TotalMb)</b><span>حجم پایگاه داده</span><small>داده @FmtMb(_info.Database.DataMb) · لاگ @FmtMb(_info.Database.LogMb)</small></div></section>
<div class="hi-note">مجموع فضای اشغال‌شده شامل فایل‌های برنامه، آپلودها، لاگ‌ها، بکاپ‌ها، فایل‌های اجرایی و دیتای پایگاه داده است.</div>
<div class="hi-grid"><section class="hi-card"><h2>فایل‌های برنامه <strong>@FmtMb(_info.Files.TotalMb)</strong></h2>@if(_info.Files.Folders.Count==0){<div class="hi-empty">فایلی یافت نشد.</div>}else{<div class="bars">@foreach(var f in _info.Files.Folders){<div><div class="bar-label"><b>@f.Name</b><span>@FmtMb(f.SizeMb)</span></div><div class="track"><i style="width:@(Width(MaxFolderMb > 0 ? f.SizeMb * 100 / MaxFolderMb : 0));background:@Color(f.Name)"></i></div></div>}</div>}</section><section class="hi-card"><h2>جدول‌های پایگاه داده <strong>@FmtMb(_info.Database.TotalMb)</strong></h2>@if(!_info.Database.Available){<div class="hi-empty">اطلاعات فایل پایگاه داده در دسترس نیست.</div>}else if(_info.Database.TopTables.Count==0){<div class="hi-empty">فایل‌های پایگاه داده خوانده شد، اما جزئیات جدول‌ها در دسترس نیست.</div>}else{<div class="table-wrap"><table><thead><tr><th>#</th><th>جدول</th><th>ردیف‌ها</th><th>حجم</th></tr></thead><tbody>@{var n=0;}@foreach(var t in _info.Database.TopTables){n++;<tr><td>@n</td><td><code>@t.Name</code></td><td>@FmtRows(t.Rows)</td><td>@FmtMb(t.SizeMb)</td></tr>}</tbody></table></div>}</section></div>
<section class="hi-card process"><h2>پردازش برنامه</h2><div><b>@Fa(_info.Process.ManagedMemoryMb.ToString("0.#", CultureInfo.InvariantCulture)) MB</b><span>حافظه مدیریت‌شده</span></div><div><b>@Fa(_info.Process.WorkingSetMb.ToString("0.#", CultureInfo.InvariantCulture)) MB</b><span>حافظه در حال استفاده</span></div><div><b>@Fa(_info.Process.UptimeHours.ToString("0.#", CultureInfo.InvariantCulture)) ساعت</b><span>مدت فعال بودن</span></div><div><b>@Fa(_info.Process.ProcessorCount.ToString(CultureInfo.InvariantCulture)) هسته</b><span>پردازنده</span></div></section>}
</div>
<style>
.hi-page{padding:12px 0 32px;color:#172033}.hi-header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px;flex-wrap:wrap;margin-bottom:20px}.hi-header h1{font-size:22px;font-weight:900;margin:0 0 7px}.hi-header h1 .oi{color:#5146e5;margin-left:7px}.hi-header p{margin:0;color:#667085;font-size:13px}.hi-actions button{display:inline-flex;align-items:center;gap:7px;border:0;border-radius:12px;padding:11px 17px;color:#fff;background:linear-gradient(135deg,#6658e8,#4737c9);font-weight:800;cursor:pointer}.hi-kpis{display:grid;grid-template-columns:repeat(5,1fr);gap:13px;margin-bottom:17px}.hi-kpi{background:#fff;border:1px solid #edf0f6;border-radius:17px;padding:17px;box-shadow:0 5px 20px #1018280b}.hi-kpi b,.hi-kpi span,.hi-kpi small{display:block}.hi-kpi b{font-size:18px;font-weight:900}.hi-kpi span{font-weight:800;font-size:12px;margin-top:6px}.hi-kpi small{color:#98a2b3;font-size:11px;margin-top:4px}.hi-note{background:#eef4ff;border:1px solid #dbe7ff;color:#344054;border-radius:13px;padding:13px 16px;font-size:12px;font-weight:600;margin-bottom:17px}.hi-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px}.hi-card{background:#fff;border:1px solid #edf0f6;border-radius:18px;padding:18px;box-shadow:0 5px 20px #1018280b}.hi-card h2{font-size:15px;font-weight:900;margin:0 0 16px}.hi-card h2 strong{float:left;color:#4f46e5;background:#eef2ff;padding:6px 10px;border-radius:999px;font-size:11px}.bars{display:grid;gap:15px}.bar-label{display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px}.bar-label span{color:#667085}.track{height:10px;background:#f2f4f7;border-radius:99px;overflow:hidden}.track i{display:block;height:100%;border-radius:99px;min-width:3px}.table-wrap{overflow:auto;border:1px solid #edf0f6;border-radius:12px}.table-wrap table{width:100%;border-collapse:collapse;font-size:12px}.table-wrap th{background:#f8fafc;color:#667085;text-align:right;padding:10px}.table-wrap td{padding:10px;border-top:1px solid #f2f4f7}.table-wrap code{background:#f2f4f7;padding:4px 8px;border-radius:6px}.process{display:grid;grid-template-columns:repeat(4,1fr);gap:11px}.process h2{grid-column:1/-1}.process div{padding:12px;background:#f8fafc;border-radius:12px}.process b,.process span{display:block}.process span{color:#98a2b3;font-size:11px;margin-top:4px}.hi-empty{text-align:center;padding:38px 10px;color:#98a2b3;font-size:12px;font-weight:700}@@media(max-width:1100px){.hi-kpis{grid-template-columns:repeat(3,1fr)}.hi-grid{grid-template-columns:1fr}}@@media(max-width:650px){.hi-kpis{grid-template-columns:repeat(2,1fr);gap:9px}.hi-kpi{padding:12px}.process{grid-template-columns:repeat(2,1fr)}}
</style>
@code {
private HostInfoDto? _info; private bool _busy;
private double MaxFolderMb => (_info != null && _info.Files.Folders.Count > 0) ? _info.Files.Folders.Max(x => x.SizeMb) : 0;
protected override async Task OnInitializedAsync(){try{_info=await Http.GetFromJsonAsync<HostInfoDto>("api/hostinfo");}catch{}}
private async Task RefreshAsync(){_busy=true;try{var r=await Http.PostAsJsonAsync("api/hostinfo/refresh",new{});_info=r.IsSuccessStatusCode?await r.Content.ReadFromJsonAsync<HostInfoDto>():await Http.GetFromJsonAsync<HostInfoDto>("api/hostinfo");}catch{}finally{_busy=false;}}
private static string Width(double v)=>Math.Clamp(v,0,100).ToString("0.#",CultureInfo.InvariantCulture)+"%";
private static string Color(string n)=>n.ToLowerInvariant() switch{"uploads"=>"#6366f1","monitoring-data"=>"#14b8a6","backups"=>"#f43f5e","images"=>"#f59e0b",_=>"#3b82f6"};
private static string FmtGb(double v)=>$"{v.ToString("0.00",CultureInfo.InvariantCulture)} GB"; private static string FmtMb(double v)=>v>=1024?FmtGb(v/1024):$"{v.ToString("0.00",CultureInfo.InvariantCulture)} MB"; private static string FmtRows(long v)=>v.ToString("N0",CultureInfo.InvariantCulture);
private static string Fa(string? value){ if(string.IsNullOrEmpty(value)) return ""; var sb=new System.Text.StringBuilder(value.Length); foreach(var c in value){ sb.Append(c>='0'&&c<='9'?(char)('۰'+(c-'0')):c); } return sb.ToString(); }
private static string Fa(int value)=>Fa(value.ToString(CultureInfo.InvariantCulture));
}