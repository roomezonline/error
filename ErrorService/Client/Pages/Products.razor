@page "/products"
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Shared
@implements IDisposable
@inject ErrorService.Client.Services.CartService CartService

<PageTitle>ارورسرویس - محصولات</PageTitle>

<SeoHeader 
    Title="ارورسرویس | فروشگاه قطعات یدکی لوازم خانگی"
    Description="فروشگاه قطعات یدکی اصل لوازم خانگی شامل ماشین لباسشویی، یخچال، ظرفشویی و ماکروفر با بهترین قیمت و ارسال سریع"
    Keywords="قطعات یدکی لوازم خانگی, خرید قطعات یدکی, لوازم یدکی ماشین لباسشویی, لوازم یدکی یخچال"
    OgType="website" />

<section class="products-list-page py-5 bg-light" dir="rtl">
    <div class="container">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <h1 class="fw-bold h2 m-0">همه محصولات</h1>
            <div class="text-muted">نمایش @((products?.Count ?? 0)) از @totalCount محصول</div>
        </div>

        <div class="filters-card bg-white rounded-5 shadow-sm border-0 p-3 p-md-4 mb-4">
            <button class="filters-toggle d-lg-none btn btn-light w-100 mb-2" @onclick="() => showFilters = !showFilters">
                <span class="oi oi-elevator me-1"></span>
                @(showFilters ? "پنهان کردن فیلترها" : "نمایش فیلترها")
            </button>
            <div class="filters-body @(showFilters ? "" : "d-none d-lg-block")">
            <div class="filters-top">
                <div class="search-wrap">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-0">
                            <span class="oi oi-magnifying-glass text-muted"></span>
                        </span>
                        <input class="form-control border-0" placeholder="جستجو در محصولات..." @bind="search" @bind:event="oninput" />
                    </div>
                </div>

                <div class="filters-actions">
                    <select class="form-select sort-select" @bind="sort">
                        <option value="">جدیدترین</option>
                        <option value="price_asc">ارزان‌ترین</option>
                        <option value="price_desc">گران‌ترین</option>
                        <option value="discount_desc">بیشترین تخفیف</option>
                    </select>

                    <label class="chip-toggle">
                        <input type="checkbox" class="form-check-input" @bind="onlyAvailable" />
                        <span>فقط موجود</span>
                    </label>

                    <label class="chip-toggle">
                        <input type="checkbox" class="form-check-input" @bind="onlyDiscounted" />
                        <span>فقط تخفیف‌دار</span>
                    </label>

                    <div class="btn-group-wrap">
                        <button class="btn btn-danger rounded-pill px-4" @onclick="ApplyFilters">
                            اعمال
                        </button>
                        <button class="btn btn-light rounded-pill px-4" @onclick="ClearFilters">
                            پاک کردن
                        </button>
                    </div>
                </div>
            </div>

            <div class="price-row mt-3">
                <div class="price-box">
                    <span class="text-muted small">حداقل قیمت</span>
                    <input type="text" inputmode="numeric" class="form-control" value="@minPriceText" @oninput="OnMinPriceInput" placeholder="0" />
                </div>
                <div class="price-box">
                    <span class="text-muted small">حداکثر قیمت</span>
                    <input type="text" inputmode="numeric" class="form-control" value="@maxPriceText" @oninput="OnMaxPriceInput" placeholder="..." />
                </div>
            </div>

            @if (categories != null && categories.Any())
            {
                <div class="category-chips mt-3">
                    <button type="button" class="cat-chip @(selectedCategoryId == null ? "active" : "")" @onclick="() => SelectCategory(null)">
                        همه
                    </button>
                    @foreach (var cat in categories)
                    {
                        <button type="button" class="cat-chip @(selectedCategoryId == cat.Id ? "active" : "")" @onclick="() => SelectCategory(cat.Id)">
                            @cat.Name
                        </button>
                    }
                </div>
            }
            </div>
        </div>

        @if (products == null)
        {
            <div class="row g-3 g-md-4">
                @for (int i = 0; i < 8; i++)
                {
                    <div class="col-6 col-md-3">
                        <div class="skeleton-card">
                            <div class="skeleton skeleton-img"></div>
                            <div class="skeleton skeleton-title"></div>
                            <div class="skeleton skeleton-text"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!products.Any())
        {
            <div class="empty-state-box">
                <span class="empty-icon oi oi-box"></span>
                <h4>محصولی یافت نشد</h4>
                <p>هیچ محصولی با فیلترهای انتخابی شما مطابقت ندارد.</p>
                <button class="btn btn-outline-primary rounded-pill px-4" @onclick="ClearFilters">پاک کردن فیلترها</button>
            </div>
        }
        else
        {
            <div class="row g-3 g-md-4">
                @foreach (var prod in products)
                {
                    <div class="col-6 col-md-3 reveal">
                        <a href="@SeoUrl.Product(prod.Id, prod.Slug)" class="text-decoration-none h-100 d-block">
                            <div class="product-card rounded-4 bg-white shadow-sm overflow-hidden h-100 border-0 @(prod.IsAvailable ? "" : "product-card--unavailable")">
                                <div class="product-card__img-wrap bg-light position-relative">
                                    @if (IsDiscountActive(prod))
                                    {
                                        <div class="discount-badge">@CalculateDiscount(prod)% تخفیف</div>
                                    }
                                    @if (!prod.IsAvailable || prod.StockQuantity <= 0)
                                    {
                                        <span class="badge bg-secondary position-absolute top-0 start-0 m-2 rounded-pill">ناموجود</span>
                                    }
                                    else if (prod.StockQuantity <= 5)
                                    {
                                        <span class="badge bg-warning position-absolute top-0 start-0 m-2 rounded-pill">تنها @prod.StockQuantity عدد</span>
                                    }
                                    <img src="@(string.IsNullOrEmpty(prod.MainImageUrl) ? "/images/placeholder-product.svg" : prod.MainImageUrl)" loading="lazy" class="product-card__img" alt="@prod.Name" />

                                    <div class="product-card__actions">
                                        <QuantityControl Quantity="@CartService.GetQuantity(prod.Id)"
                                                         Disabled="@(!prod.IsAvailable || prod.StockQuantity <= 0)"
                                                         OnAdd="() => AddToCart(prod)"
                                                         OnIncrease="() => Increase(prod)"
                                                         OnDecrease="() => Decrease(prod)" />
                                    </div>
                                </div>

                                <div class="product-card__body p-3 d-flex flex-column">
                                    @if (IsDiscountActive(prod))
                                    {
                                        <div class="discount-timer shadow-sm mb-2">
                                            <span class="oi oi-timer"></span>
                                            <span class="timer-text">@GetCountdown(prod.Id)</span>
                                        </div>
                                    }

                                    <div class="small text-muted mb-1">@prod.CategoryName</div>
                                    <h3 class="product-card__title h6 fw-bold mb-2 text-dark">@prod.Name</h3>

                                    <div class="d-flex justify-content-between align-items-center mt-auto">
                                        <div class="product-card__price w-100">
                                            @if (prod.DiscountPrice.HasValue)
                                            {
                                                <div class="small text-muted text-decoration-line-through">@prod.Price.ToString("N0")</div>
                                                <div class="fw-bold text-primary h6 m-0">@prod.DiscountPrice.Value.ToString("N0") <small class="small">تومان</small></div>
                                            }
                                            else
                                            {
                                                <div class="fw-bold text-primary h6 m-0">@prod.Price.ToString("N0") <small class="small">تومان</small></div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>

            @if (products.Count < totalCount)
            {
                <div class="text-center mt-4">
                    <button class="btn btn-outline-primary rounded-pill px-5" @onclick="LoadMore" disabled="@isLoadingMore">
                        @if (isLoadingMore)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        مشاهده بیشتر (@(totalCount - products.Count) مورد باقی‌مانده)
                    </button>
                </div>
            }
        }
    </div>
</section>

<style>
    .filters-card {
        border: 1px solid rgba(2, 6, 23, 0.06);
    }
    .filters-top {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .search-wrap {
        background: rgba(79, 70, 229, 0.06);
        border: 1px solid rgba(79, 70, 229, 0.12);
        border-radius: 999px;
        padding: 4px 10px;
    }
    .search-wrap .form-control { background: transparent; box-shadow: none; }
    .search-wrap .input-group-text { padding-right: 4px; }

    .filters-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    .sort-select {
        border-radius: 999px;
        border: 1px solid rgba(2, 6, 23, 0.08);
        padding: 10px 35px 10px 14px;
        min-width: 150px;
        background-position: left 0.75rem center;
    }

    .btn-group-wrap {
        display: inline-flex;
        gap: 10px;
        flex-wrap: nowrap;
    }

    .chip-toggle {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(2, 6, 23, 0.03);
        border: 1px solid rgba(2, 6, 23, 0.06);
        border-radius: 999px;
        padding: 8px 12px;
        font-weight: 800;
        font-size: 0.85rem;
        color: #0f172a;
        user-select: none;
    }
    .chip-toggle input { margin: 0; }

    .price-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .price-row .price-box {
        display: grid;
        gap: 6px;
    }
    .price-row .form-control {
        border-radius: 14px;
        border: 1px solid rgba(2, 6, 23, 0.08);
        padding: 10px 12px;
    }

    .category-chips {
        display: flex;
        gap: 10px;
        overflow: auto;
        padding-bottom: 6px;
    }
    .cat-chip {
        border: 1px solid rgba(2, 6, 23, 0.08);
        background: #fff;
        color: #0f172a;
        border-radius: 999px;
        padding: 8px 14px;
        font-weight: 900;
        font-size: 0.85rem;
        white-space: nowrap;
    }
    .cat-chip.active {
        background: rgba(79, 70, 229, 0.12);
        border-color: rgba(79, 70, 229, 0.25);
        color: #4f46e5;
    }

    .filters-toggle {
        border-radius: 999px;
        font-size: 0.9rem;
        font-weight: 700;
    }

    @@media (min-width: 992px) {
        .filters-top {
            grid-template-columns: 1.3fr 1fr;
            align-items: center;
        }
        .filters-actions {
            justify-content: flex-end;
        }
        .sort-select { min-width: 170px; }
        .search-wrap {
            padding: 6px 12px;
        }
    }

    @@media (max-width: 480px) {
        .price-row {
            grid-template-columns: 1fr;
        }
        .btn-group-wrap {
            width: 100%;
        }
        .btn-group-wrap .btn {
            flex: 1;
        }
    }

    .product-card {
        transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
        border: 1px solid #f0f0f0 !important;
        border-radius: 24px !important;
    }
    .product-card--unavailable {
        opacity: 0.65;
        filter: grayscale(0.35);
    }
    .product-card--unavailable .product-card__img-wrap {
        background: #f3f4f6 !important;
    }
    .product-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.1) !important;
    }
    .product-card__img-wrap {
        aspect-ratio: 1 / 1;
        overflow: hidden;
        border-radius: 24px 24px 0 0;
    }
    .product-card__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.5s ease;
    }
    .product-card:hover .product-card__img {
        transform: scale(1.1);
    }
    .product-card__title {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        height: 2.8em;
        line-height: 1.4;
        font-size: 0.9rem;
    }

    .discount-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        background: #ef4444;
        color: white;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 0.75rem;
        font-weight: bold;
        z-index: 2;
    }

    .discount-timer {
        color: #fff;
        font-size: 0.75rem;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 6px;
        background: linear-gradient(135deg, #ef4444, #b91c1c);
        padding: 6px 10px;
        border-radius: 8px;
        width: 100%;
        justify-content: center;
    }
    .timer-text { white-space: nowrap; }

    .product-card__actions {
        position: absolute;
        bottom: 10px;
        right: 10px;
        opacity: 1;
        transform: none;
        transition: all 0.3s ease;
        z-index: 3;
    }

    /* Skeleton Loading */
    .product-card-skeleton .skeleton-img {
        height: 200px;
        background: linear-gradient(90deg, #f0f0f0 25%, #f8f8f8 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: skeleton-loading 1.5s infinite;
    }
    .skeleton-text {
        height: 15px;
        background: #f0f0f0;
        border-radius: 4px;
        animation: skeleton-loading 1.5s infinite;
    }
    @@keyframes skeleton-loading {
        0% { background-position: 200% 0; }
        100% { background-position: -200% 0; }
    }
</style>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private List<ProductDto>? products;
    private List<CategoryDto>? categories;
    private int skip = 0;
    private int take = 12;
    private int totalCount = 0;
    private bool isLoadingMore = false;

    private int? selectedCategoryId = null;
    private bool onlyAvailable = false;
    private bool onlyDiscounted = false;
    private string? search;
    private decimal? minPrice;
    private decimal? maxPrice;
    private string? sort;
    private bool showFilters = true;

    private string minPriceText = "";
    private string maxPriceText = "";

    private System.Threading.Timer? timer;
    private Dictionary<int, string> countDowns = new();

    protected override async Task OnInitializedAsync()
    {
        CartService.OnChange += HandleCartChanged;
        await LoadCategories();
        await LoadProducts(loadMore: false);
    }

    private void HandleCartChanged() => InvokeAsync(StateHasChanged);

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");
            categories ??= new();
        }
        catch
        {
            categories = new();
        }
    }

    private async Task LoadMore() => await LoadProducts(loadMore: true);

    private async Task LoadProducts(bool loadMore)
    {
        if (loadMore)
        {
            isLoadingMore = true;
            skip += take;
        }
        else
        {
            skip = 0;
            products = null;
        }

        try
        {
            var query = BuildQueryString();
            var response = await Http.GetAsync($"api/products?{query}");
            if (!response.IsSuccessStatusCode)
            {
                products ??= new();
                return;
            }

            totalCount = PaginationHeaderReader.ReadTotalCount(response);
            var data = await response.Content.ReadFromJsonAsync<List<ProductDto>>();
            data ??= new();

            if (loadMore && products != null)
                products.AddRange(data);
            else
                products = data;

            StartOrStopTimer();
        }
        catch
        {
            products ??= new();
        }
        finally
        {
            isLoadingMore = false;
        }
    }

    private bool IsDiscountActive(ProductDto prod)
        => prod.DiscountPrice.HasValue && prod.DiscountExpiryDate.HasValue && prod.DiscountExpiryDate.Value > DateTimeOffset.Now;

    private int CalculateDiscount(ProductDto prod)
    {
        if (!prod.DiscountPrice.HasValue || prod.Price <= 0) return 0;
        var percent = (int)Math.Round((prod.Price - prod.DiscountPrice.Value) / prod.Price * 100);
        return percent < 0 ? 0 : percent;
    }

    private void StartOrStopTimer()
    {
        if (products == null) return;
        var any = products.Any(IsDiscountActive);
        if (!any)
        {
            timer?.Dispose();
            timer = null;
            countDowns.Clear();
            return;
        }

        timer ??= new System.Threading.Timer(_ =>
        {
            if (products == null) return;
            bool changed = false;
            foreach (var p in products.Where(IsDiscountActive))
            {
                var diff = p.DiscountExpiryDate!.Value - DateTimeOffset.Now;
                string text;
                if (diff.TotalSeconds <= 0)
                {
                    text = "پایان یافت";
                }
                else
                {
                    int days = (int)diff.TotalDays;
                    text = days > 0
                        ? $"{days} روز و {diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}"
                        : $"{diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}";
                }

                if (!countDowns.ContainsKey(p.Id) || countDowns[p.Id] != text)
                {
                    countDowns[p.Id] = text;
                    changed = true;
                }
            }

            if (changed) InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    private string GetCountdown(int id) => countDowns.ContainsKey(id) ? countDowns[id] : "--:--:--";

    private string BuildQueryString()
    {
        var parts = new List<string>
        {
            $"skip={skip}",
            $"take={take}",
            $"onlyAvailable={onlyAvailable.ToString().ToLowerInvariant()}",
            $"onlyDiscounted={onlyDiscounted.ToString().ToLowerInvariant()}"
        };

        if (selectedCategoryId.HasValue)
            parts.Add($"categoryId={selectedCategoryId.Value}");

        if (!string.IsNullOrWhiteSpace(search))
            parts.Add($"search={Uri.EscapeDataString(search.Trim())}");

        if (minPrice.HasValue)
            parts.Add($"minPrice={minPrice.Value}");

        if (maxPrice.HasValue)
            parts.Add($"maxPrice={maxPrice.Value}");

        if (!string.IsNullOrWhiteSpace(sort))
            parts.Add($"sort={Uri.EscapeDataString(sort)}");

        return string.Join("&", parts);
    }

    private async Task ApplyFilters()
    {
        skip = 0;
        await LoadProducts(loadMore: false);
    }

    private async Task ClearFilters()
    {
        selectedCategoryId = null;
        onlyAvailable = false;
        onlyDiscounted = false;
        search = null;
        minPrice = null;
        maxPrice = null;
        minPriceText = "";
        maxPriceText = "";
        sort = null;
        skip = 0;
        await LoadProducts(loadMore: false);
    }

    private void SelectCategory(int? categoryId)
    {
        selectedCategoryId = categoryId;
    }

    private async Task AddToCart(ProductDto prod) => await CartService.AddToCartAsync(prod, 1);

    private async Task Increase(ProductDto prod)
    {
        var current = CartService.GetQuantity(prod.Id);
        await CartService.UpdateQuantityAsync(prod.Id, current + 1);
    }

    private async Task Decrease(ProductDto prod)
    {
        var current = CartService.GetQuantity(prod.Id);
        await CartService.UpdateQuantityAsync(prod.Id, current - 1);
    }

    private void OnMinPriceInput(ChangeEventArgs e)
    {
        minPriceText = FormatDigits(e?.Value?.ToString());
        minPrice = TryParsePrice(minPriceText);
    }

    private void OnMaxPriceInput(ChangeEventArgs e)
    {
        maxPriceText = FormatDigits(e?.Value?.ToString());
        maxPrice = TryParsePrice(maxPriceText);
    }

    private static decimal? TryParsePrice(string? formatted)
    {
        if (string.IsNullOrWhiteSpace(formatted)) return null;
        var raw = new string(formatted.Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(raw)) return null;
        return decimal.TryParse(raw, out var v) ? v : null;
    }

    private static string FormatDigits(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return "";
        var raw = new string(input.Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(raw)) return "";
        if (!decimal.TryParse(raw, out var v)) return raw;
        return string.Format("{0:N0}", v);
    }

    public void Dispose()
    {
        timer?.Dispose();
        CartService.OnChange -= HandleCartChanged;
    }
}
