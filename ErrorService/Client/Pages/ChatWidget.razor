            var tempId = _nextTempId--;
            _pendingTempIds.Enqueue(tempId);
            _messages.Add(new ChatMessageDto
            {
                Id = tempId,
                SessionId = _sessionId,
                SenderType = ChatSenderTypeDto.User,
                Content = fileName,
                MessageType = ChatMessageTypeDto.File,
                MediaUrl = url,
                CreatedAt = DateTime.UtcNow,
                Status = ChatMessageStatusDto.Sending
            });
            ScrollToBottom();
            StateHasChanged();
            if (_hub?.State != HubConnectionState.Connected)
            {
                await QueueOffline(_sessionId, fileName, ChatMessageTypeDto.File, url);
                return;
            }
            await _hub.InvokeAsync("SendMessage", _sessionId, fileName, ChatMessageTypeDto.File, url);
        }
    }

