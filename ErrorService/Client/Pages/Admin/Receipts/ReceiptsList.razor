        var ct = _monitoringCts.Token;

        try
        {
            if (filtered == null || filtered.Count == 0) return;

            var takeCount = Math.Min(displayCount, 50);
            var need = filtered
                .Take(takeCount)
                .Where(x => !monitoringHistoryCache.ContainsKey(x.Id))
                .Select(x => x.Id)
                .ToList();

            if (need.Count == 0) return;

            var tasks = need.Select(id => LoadMonitoringHistorySilent(id));
