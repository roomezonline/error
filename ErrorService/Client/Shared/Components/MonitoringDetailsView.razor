            _motorMin = resp.GetProperty("motorMin").GetInt32();
            _elementMax = resp.GetProperty("elementMax").GetInt32();
            _elementMin = resp.GetProperty("elementMin").GetInt32();
            _simultaneity = resp.GetProperty("simultaneity").GetBoolean();
            if (resp.TryGetProperty("timeoutMinutes", out var t))
                _timeoutMinutes = Math.Max(1, t.GetInt32());
            _ambientTempAlarmEnabled = resp.TryGetProperty("ambientTempAlarmEnabled", out var ae) ? ae.GetBoolean() : true;
            _ambientTempThreshold = resp.TryGetProperty("ambientTempThreshold", out var at) ? Math.Clamp(at.GetInt32(), 30, 50) : 35;
            if (_settingsMissing) _showSettings = true;
        }
        catch
