</style>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private List<ProductDto>? products;
    private List<CategoryDto>? categories;
    private ProductUpsertRequest model = new();
    private bool showEditor = false;
    private ElementReference editorCard;
    private bool _editorScrolled;
    private int editingId = 0;
    private bool isSaving = false;
    private bool isUploading = false;
    private string createdAtInput = string.Empty;
    private string discountStartInput = string.Empty;
    private string discountExpiryInput = string.Empty;
    private string discountTypeInput = "";
    private const string DiscountTypeNone = "";
    private const string DiscountTypePermanent = "permanent";
    private const string DiscountTypeTimed = "timed";
    private DotNetObjectReference<Products>? objRef;
    private bool _tinyInitialized;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
        await LoadCategories();
    }

    [JSInvokable]
    public void UpdateContent(string content)
    {
        model.Description = content;
        StateHasChanged();
    }

    public void Dispose() => objRef?.Dispose();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showEditor)
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("initJalali");
            try { await JS.InvokeVoidAsync("formatPriceInputs"); } catch { }

            if (!_editorScrolled)
            {
                _editorScrolled = true;
                await JS.InvokeVoidAsync("scrollToElement", editorCard, "start");
            }

            if (!_tinyInitialized)
            {
                objRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("initTinyMCE", "#tiny-editor-product", objRef, "/api/products/upload");
                _tinyInitialized = true;
            }
        }
        else
        {
            _tinyInitialized = false;
            _editorScrolled = false;
        }
    }

    private string? _searchQuery;
    private bool _showLowStockOnly;
    private bool _showFeaturedOnly;
    private int skip = 0;
    private int take = 10;
    private int totalCount = 0;
    private bool isLoadingMore = false;
    private bool showTechnical;

    private List<ProductDto> FilteredProducts
    {
        get
        {
            if (products == null) return new();
            IEnumerable<ProductDto> list = products;
            if (_showLowStockOnly)
                list = list.Where(p => p.StockQuantity <= 5);
            if (_showFeaturedOnly)
                list = list.Where(p => p.IsFeatured);
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLower();
                list = list.Where(p =>
                    (p.Name?.ToLower().Contains(q) ?? false) ||
                    (p.CategoryName?.ToLower().Contains(q) ?? false));
            }
            return list.ToList();
        }
    }

    private void ToggleLowStock() => _showLowStockOnly = !_showLowStockOnly;

    private void ToggleFeaturedFilter() => _showFeaturedOnly = !_showFeaturedOnly;

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString();
    }

    private void ClearSearch()
    {
        _searchQuery = null;
    }

    private async Task LoadProducts(bool loadMore = false)
    {
        if (loadMore)
        {
            isLoadingMore = true;
            skip += take;
        }
        else
        {
            skip = 0;
            products = null;
        }

        try
        {
            var response = await Http.GetAsync($"api/products?skip={skip}&take={take}");
            if (response.IsSuccessStatusCode)
            {
                if (response.Headers.TryGetValues("X-Total-Count", out var values))
                {
                    int.TryParse(values.FirstOrDefault(), out totalCount);
                }

                var data = await response.Content.ReadFromJsonAsync<List<ProductDto>>();
                if (data != null)
                {
                    if (loadMore && products != null)
                    {
                        products.AddRange(data);
                    }
                    else
                    {
                        products = data;
                    }
                }
            }
        }
        catch
        {
            ToastService.ShowError("خطا در بارگذاری محصولات");
        }
        finally
        {
            isLoadingMore = false;
        }
    }

    private async Task LoadCategories() => categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");

    private void NewProduct()
    {
        editingId = 0;
        model = new ProductUpsertRequest { IsAvailable = true, StockQuantity = 0 };
        createdAtInput = PersianDate.ToJalaliDateTime(DateTimeOffset.Now);
        discountTypeInput = "";
        discountStartInput = string.Empty;
        discountExpiryInput = string.Empty;
        showEditor = true;
    }

    private void EditProduct(ProductDto prod)
    {
        editingId = prod.Id;
        model = new ProductUpsertRequest
        {
            Name = prod.Name,
            Sku = prod.Sku,
            Description = prod.Description,
            Price = prod.Price,
            DiscountPrice = prod.DiscountPrice,
            DiscountStartDate = prod.DiscountStartDate,
            DiscountExpiryDate = prod.DiscountExpiryDate,
            MainImageUrl = prod.MainImageUrl,
            ImageUrl2 = prod.ImageUrl2,
            ImageUrl3 = prod.ImageUrl3,
            ImageUrl4 = prod.ImageUrl4,
            CategoryId = prod.CategoryId,
            IsAvailable = prod.IsAvailable,
            StockQuantity = prod.StockQuantity,
            IsFeatured = prod.IsFeatured,
            CompatibilityInfo = prod.CompatibilityInfo,
            FailureSymptoms = prod.FailureSymptoms,
            DatasheetUrl = prod.DatasheetUrl,
            RelatedProductIds = prod.RelatedProductIds
        };
        createdAtInput = PersianDate.ToJalaliDateTime(prod.CreatedAt);
        discountTypeInput = prod.DiscountExpiryDate.HasValue ? "timed" : (prod.DiscountPrice.HasValue ? "permanent" : "");
        discountStartInput = prod.DiscountStartDate.HasValue ? PersianDate.ToJalaliDateTime(prod.DiscountStartDate.Value) : string.Empty;
        discountExpiryInput = prod.DiscountExpiryDate.HasValue ? PersianDate.ToJalaliDateTime(prod.DiscountExpiryDate.Value) : string.Empty;
        showEditor = true;
        showTechnical = true;
    }

    private void CloseEditor() => showEditor = false;

    private void SetDiscountType(string type) => discountTypeInput = type;

    private async Task SaveProduct()
    {
        isSaving = true;
        try
        {
            var priceRaw = await JS.InvokeAsync<string>("getPriceRawValue", "price-input");
            if (int.TryParse(priceRaw, out var priceVal)) model.Price = priceVal;

            if (discountTypeInput == "permanent" || discountTypeInput == "timed")
            {
                var discountRaw = await JS.InvokeAsync<string>("getPriceRawValue", "discount-price-input");
                if (int.TryParse(discountRaw, out var discountVal))
                {
                    model.DiscountPrice = discountVal;
                    if (discountVal >= model.Price && model.Price > 0)
                    {
                        ToastService.ShowError("قیمت با تخفیف باید کمتر از قیمت اصلی باشد");
                        return;
                    }
                }
                else
                {
                    ToastService.ShowError("برای تخفیف، قیمت با تخفیف الزامی است");
                    return;
                }
            }
            else
            {
                model.DiscountPrice = null;
                model.DiscountStartDate = null;
                model.DiscountExpiryDate = null;
            }

            if (discountTypeInput == "timed")
            {
                if (PersianDate.TryParseJalaliDateTime(discountExpiryInput, out var discountExpiry))
                    model.DiscountExpiryDate = discountExpiry;
                else
                {
                    ToastService.ShowError("برای تخفیف زمان‌دار، تاریخ پایان الزامی است");
                    return;
                }

                if (PersianDate.TryParseJalaliDateTime(discountStartInput, out var discountStart))
                    model.DiscountStartDate = discountStart;
                else
                    model.DiscountStartDate = null;

                if (model.DiscountStartDate.HasValue && model.DiscountExpiryDate.Value <= model.DiscountStartDate.Value)
                {
                    ToastService.ShowError("تاریخ پایان باید بعد از تاریخ شروع باشد");
                    return;
                }
            }
            else if (discountTypeInput == "permanent")
            {
                model.DiscountStartDate = null;
                model.DiscountExpiryDate = null;
            }

            if (PersianDate.TryParseJalaliDateTime(createdAtInput, out var createdAt))
                model.CreatedAt = createdAt;
            else
                model.CreatedAt = null;

            model.Description = await JS.InvokeAsync<string>("getTinyContent", "#tiny-editor-product");

            HttpResponseMessage resp;
            if (editingId == 0) resp = await Http.PostAsJsonAsync("api/products", model);
            else resp = await Http.PutAsJsonAsync($"api/products/{editingId}", model);
            
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(editingId == 0 ? "محصول با موفقیت ثبت شد" : "تغییرات محصول ذخیره شد");
                await LoadProducts();
                showEditor = false;
            }
            else
            {
                ToastService.ShowError("خطا در ذخیره‌سازی محصول");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally { isSaving = false; }
    }

    private ProductDto? itemToDelete;
    private bool showConfirm;

    private void DeleteProduct(ProductDto prod)
    {
        itemToDelete = prod;
        showConfirm = true;
    }

    private async Task HandleDeleteResult(bool result)
    {
        showConfirm = false;
        if (result && itemToDelete != null)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/products/{itemToDelete.Id}");
                if (response.IsSuccessStatusCode)
                {
                    ToastService.ShowSuccess("محصول با موفقیت حذف شد");
                    await LoadProducts();
                }
                else
                {
                    ToastService.ShowError("خطا در حذف محصول");
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"خطای سیستمی: {ex.Message}");
            }
        }
        itemToDelete = null;
    }
}
