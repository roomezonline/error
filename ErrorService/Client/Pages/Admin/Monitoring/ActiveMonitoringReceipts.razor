@page "/admin/monitoring/active-receipts"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.monitoring.view")]
@using ErrorService.Shared
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ErrorService.Client.Services.ToastService ToastService
@inject ErrorService.Client.Services.AdminWorkshopSelectionService AdminWorkshopSelection
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>مانیتورینگ‌های فعال</PageTitle>

<div class="amr-page" dir="rtl">
    <div class="amr-header">
        <a class="amr-back" href="/admin/receipts"><span class="oi oi-arrow-right"></span></a>
        <div>
            <div class="amr-kicker">پایش و مانیتورینگ</div>
            <div class="amr-title">مانیتورینگ‌های فعال</div>
        </div>
        <button type="button" class="amr-refresh" @onclick="Reload" title="بروزرسانی">
            <span class="oi oi-loop-circular"></span>
        </button>
    </div>

    @if (!isLoading && _workshopMax > 0)
    {
        <div class="amr-capacity @(_workshopUsed >= _workshopMax ? "amr-capacity--full" : "")">
            <span class="amr-capacity__label">ظرفیت مانیتورینگ کارگاه:</span>
            <span class="amr-capacity__value">@_workshopUsed از @_workshopMax</span>
            @if (_workshopUsed >= _workshopMax)
            {
                <span class="amr-capacity__badge">تکمیل</span>
            }
        </div>
    }

    @if (isLoading)
    {
        <div class="amr-card amr-loading">
            <div class="spinner-border text-primary"></div>
            <div>در حال دریافت لیست...</div>
        </div>
    }
    else if (items == null || items.Count == 0)
    {
        <div class="amr-card amr-empty">
            <div class="amr-empty__icon"><span class="oi oi-pulse"></span></div>
            <div class="amr-empty__text">در حال حاضر مانیتورینگ فعالی وجود ندارد.</div>
            <a class="amr-btn" href="/admin/receipts">رفتن به رسیدها</a>
        </div>
    }
    else
    {
        <div class="amr-list">
            @foreach (var it in items)
            {
                <div class="amr-item amr-item--alive@(it.AlertCount > 0 ? " amr-item--alert" : "")">
                    @if (it.IsActive)
                    {
                        <div class="amr-heartbar @(it.IsPoweredOn ? "amr-heartbar--live" : "amr-heartbar--dead")" aria-hidden="true">
                            <svg class="amr-heartbar__svg" viewBox="0 0 1200 44" preserveAspectRatio="none">
                                <path class="amr-heartbar__path" d="M0 22 L70 22 L90 22 L102 20 L110 24 L120 22 L170 22 L190 22 L202 18 L214 26 L226 22 L270 22 L290 22 L300 14 L308 34 L318 8 L330 34 L342 22 L390 22 L410 22 L422 19 L434 25 L446 22 L500 22 L520 22 L532 20 L540 24 L550 22 L600 22 L620 22 L632 16 L640 30 L650 22 L700 22 L720 22 L732 20 L740 24 L750 22 L800 22 L820 22 L830 14 L838 34 L848 10 L860 34 L872 22 L930 22 L950 22 L962 18 L974 26 L986 22 L1040 22 L1060 22 L1070 20 L1078 24 L1088 22 L1140 22 L1160 22 L1172 16 L1184 30 L1196 22 L1200 22" />
                            </svg>
                            <svg class="amr-heartbar__svg amr-heartbar__svg--ghost" viewBox="0 0 1200 44" preserveAspectRatio="none">
                                <path class="amr-heartbar__path" d="M0 22 L70 22 L90 22 L102 20 L110 24 L120 22 L170 22 L190 22 L202 18 L214 26 L226 22 L270 22 L290 22 L300 14 L308 34 L318 8 L330 34 L342 22 L390 22 L410 22 L422 19 L434 25 L446 22 L500 22 L520 22 L532 20 L540 24 L550 22 L600 22 L620 22 L632 16 L640 30 L650 22 L700 22 L720 22 L732 20 L740 24 L750 22 L800 22 L820 22 L830 14 L838 34 L848 10 L860 34 L872 22 L930 22 L950 22 L962 18 L974 26 L986 22 L1040 22 L1060 22 L1070 20 L1078 24 L1088 22 L1140 22 L1160 22 L1172 16 L1184 30 L1196 22 L1200 22" />
                            </svg>
                        </div>
                    }

                    @if (it.AlertCount > 0)
                    {
                        <div class="amr-alert-strip" @onclick="() => GoToDetails(it)" role="button" tabindex="0">
                            <span class="oi oi-warning"></span>
                            <span>@it.AlertCount اخطار فعال — کلیک کنید</span>
                        </div>
                    }
                    <div class="amr-item__grid">
                        <button type="button" class="amr-photo" @onclick="() => OpenPhoto(it.ReceiptImageUrl)">
                            @if (!string.IsNullOrWhiteSpace(it.ReceiptImageUrl))
                            {
                                <img src="@it.ReceiptImageUrl" class="amr-photo__img" alt="رسید" />
                            }
                            else
                            {
                                <div class="amr-photo__placeholder">
                                    <span class="oi oi-camera-slr"></span>
                                    <div class="amr-photo__phtext">بدون تصویر</div>
                                    <div class="amr-photo__phid">#@it.CustomerReceiptId</div>
                                </div>
                            }
                        </button>

                        <div class="amr-content">
                            <div class="amr-item__header">
                                <div class="amr-customer">
                                    <div class="amr-customer__name-row">
                                        <span class="amr-customer__name">@it.CustomerFullName</span>
                                        <a class="amr-customer__mobile ltr" href="tel:@it.CustomerMobile" title="شماره گیری @it.CustomerMobile">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12">
                                                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>
                                            </svg>
                                            @it.CustomerMobile
                                        </a>
                                    </div>
                                </div>
                                <div class="amr-workshop-badge">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12">
                                        <rect x="2" y="7" width="20" height="14" rx="2"/>
                                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                                    </svg>
                                    @it.WorkshopName
                                </div>
                            </div>

                            <!-- ============================================ -->
                            <!-- MID SECTION - MODERN REDESIGNED -->
                            <!-- ============================================ -->
                            <div class="amr-item__mid">
                                <!-- ردیف اول: نام دستگاه + Badge -->
                                <div class="amr-row">
                                    <span class="oi oi-monitor amr-ic"></span>
                                    <div class="amr-problem">
                                        <span class="amr-row__text amr-row__text--device">@it.CustomerDeviceTitle</span>
                                        <span class="amr-device-badge">
                                            <span class="oi oi-device-desktop"></span>
                                            دستگاه
                                        </span>
                                    </div>
                                </div>

                                <!-- ردیف دوم: توضیح مشکل مشتری -->
                                <div class="amr-row">
                                    <span class="oi oi-comment-square amr-ic"></span>
                                    <div class="amr-problem">
                                        <span class="amr-row__text amr-row__text--problem">@it.ProblemDescription</span>
                                    </div>
                                </div>

                                <!-- ردیف سوم: کد دستگاه مانیتورینگ -->
                                <div class="amr-row">
                                    <span class="oi oi-pulse amr-ic amr-ic--hot"></span>
                                    <div class="amr-problem">
                                        <span class="amr-row__text amr-row__text--code">@it.MonitoringDeviceTitle</span>
                                    </div>
                                </div>
                            </div>
                            <!-- ============================================ -->

                            <div class="amr-item__bottom">
                                <div class="amr-item__bottom-row">
                                    <div class="amr-meta-group">
                                        <div class="amr-meta">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12">
                                                <circle cx="12" cy="12" r="10"/>
                                                <polyline points="12 6 12 12 16 14"/>
                                            </svg>
                                            <span>@it.CreatedAtFa</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(it.CreatedByUserName))
                                        {
                                            <div class="amr-meta">
                                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="12" height="12">
                                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                                                    <circle cx="12" cy="7" r="4"/>
                                                </svg>
                                                <span>@it.CreatedByUserName</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="amr-actions">
                                        <button type="button" class="amr-action-btn amr-action-btn--detail" @onclick="() => GoToDetails(it)" title="جزییات مانیتورینگ">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                                <circle cx="12" cy="12" r="3"/>
                                            </svg>
                                            <span>جزییات</span>
                                        </button>
                                        <button type="button" class="amr-action-btn amr-action-btn--end" @onclick="() => ConfirmEnd(it)" title="پایان مانیتورینگ">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                                <polyline points="20 6 9 17 4 12"/>
                                            </svg>
                                            <span>پایان</span>
                                        </button>
                                        <button type="button" class="amr-action-btn amr-action-btn--delete" @onclick="() => ConfirmDelete(it)" title="حذف مانیتورینگ">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="14" height="14">
                                                <polyline points="3 6 5 6 21 6"/>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                                            </svg>
                                            <span>حذف</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (isPhotoOpen)
    {
        <div class="amr-lightbox" @onclick="ClosePhoto">
            <button type="button" class="amr-lightbox__close" @onclick:stopPropagation @onclick="ClosePhoto" title="بستن">
                <span class="oi oi-x"></span>
            </button>

            <div class="amr-lightbox__frame" @onclick:stopPropagation>
                @if (!string.IsNullOrWhiteSpace(photoUrl))
                {
                    <img src="@photoUrl" class="amr-lightbox__img" alt="تصویر رسید" />
                }
                else
                {
                    <div class="amr-lightbox__empty">
                        <span class="oi oi-camera-slr"></span>
                        <div>تصویری برای نمایش وجود ندارد</div>
                    </div>
                }
            </div>
        </div>
    }

    @if (showConfirmEnd && toEnd != null)
    {
        <div class="amr-modal-overlay" @onclick="CancelEnd">
            <div class="amr-modal amr-modal--end" @onclick:stopPropagation="true">
                <div class="amr-modal-head">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" width="16" height="16">
                        <circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>
                    </svg>
                    <span>پایان مانیتورینگ</span>
                    <button class="amr-modal-close" @onclick="CancelEnd">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <div class="amr-modal-body">
                    <div class="amr-end-icon">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="1.5" width="40" height="40">
                            <circle cx="12" cy="12" r="10"/><path d="M12 8v8M8 12h8"/>
                        </svg>
                    </div>
                    <div class="amr-end-title">پایان فرآیند مانیتورینگ</div>
                    <div class="amr-end-subtitle">رسید #@toEnd.CustomerReceiptId — @toEnd.CustomerFullName — @toEnd.CustomerDeviceTitle</div>
                    <div class="amr-end-desc">پس از پایان، داده‌ها در آرشیو ذخیره می‌شوند. لطفاً دلیل پایان را وارد کنید:</div>
                    <div class="amr-end-field">
                        <textarea class="amr-end-textarea" @bind-value="_endReason" @bind-value:event="oninput" placeholder="دلیل پایان مانیتورینگ را وارد کنید ..."></textarea>
                        <div class="amr-end-count">@($"{(string.IsNullOrWhiteSpace(_endReason) ? 0 : _endReason.Trim().Length)} / 2000")</div>
                    </div>
                    <div class="amr-end-info">
                        <svg viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="1.5" width="14" height="14">
                            <circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/>
                        </svg>
                        <span>این توضیحات برای بررسی‌های آینده ثبت می‌شود</span>
                    </div>
                </div>
                <div class="amr-modal-footer">
                    <button class="amr-modal-cancel" @onclick="CancelEnd">انصراف</button>
                    <button class="amr-modal-confirm" disabled="@(string.IsNullOrWhiteSpace(_endReason))" @onclick="HandleEndResult">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="14" height="14">
                            <polyline points="20 6 9 17 4 12"/>
                        </svg>
                        پایان و ذخیره
                    </button>
                </div>
            </div>
        </div>
    }

    @if (showConfirmDelete && toDelete != null)
    {
        <ConfirmDialog IsVisible="showConfirmDelete"
                       Title="حذف مانیتورینگ"
                       Message="@($"آیا از حذف کامل مانیتورینگ برای رسید #{toDelete.CustomerReceiptId} اطمینان دارید؟ این عملیات رکورد را به صورت کامل از دیتابیس حذف می‌کند و قابل بازگشت نیست.")"
                       ConfirmText="تایید و حذف"
                       IsDanger="true"
                       OnResult="HandleDeleteResult">
            <Details>
                <div class="cd-detail-item">
                    <span class="oi oi-person"></span>
                    <span>@toDelete.CustomerFullName</span>
                </div>
                <div class="cd-detail-item">
                    <span class="oi oi-monitor"></span>
                    <span>@toDelete.CustomerDeviceTitle</span>
                </div>
            </Details>
        </ConfirmDialog>
    }
</div>

<style>
    .ltr {
        direction: ltr;
    }

    .amr-page {
        max-width: 950px;
        margin: 0 auto;
        padding: 14px 10px 80px;
    }

    .amr-header {
        display: grid;
        grid-template-columns: 44px 1fr 44px;
        gap: 10px;
        align-items: center;
        margin-bottom: 20px;
        padding: 10px;
        border-radius: 24px;
        background: linear-gradient(135deg, rgba(255,255,255,0.9), rgba(255,255,255,0.7));
        border: 1px solid rgba(79,70,229,0.1);
        backdrop-filter: blur(12px);
        box-shadow: 0 10px 25px rgba(79,70,229,0.05);
    }

    .amr-back, .amr-refresh {
        width: 44px;
        height: 44px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        background: #fff;
        border: 1px solid rgba(79,70,229,0.1);
        color: #4f46e5;
        text-decoration: none;
        cursor: pointer;
        transition: all 0.2s;
    }

        .amr-back:hover, .amr-refresh:hover {
            background: #4f46e5;
            color: #fff;
            transform: translateY(-2px);
        }

    .amr-kicker {
        font-size: 0.72rem;
        font-weight: 900;
        color: #4f46e5;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .amr-title {
        font-size: 1.15rem;
        font-weight: 950;
        color: #1e293b;
    }

    .amr-card {
        border-radius: 22px;
        background: #fff;
        border: 1px solid rgba(2,6,23,0.06);
        box-shadow: 0 14px 34px rgba(15, 23, 42, 0.06);
        padding: 18px;
    }

    .amr-loading {
        display: flex;
        gap: 10px;
        align-items: center;
        justify-content: center;
        padding: 50px 18px;
        font-weight: 900;
        color: rgba(100,116,139,1);
    }

    .amr-empty {
        text-align: center;
        padding: 46px 18px;
    }

    .amr-empty__icon {
        font-size: 2.2rem;
        color: rgba(244,63,94,0.9);
        margin-bottom: 10px;
    }

    .amr-empty__text {
        font-weight: 900;
        color: rgba(100,116,139,1);
        margin-bottom: 14px;
    }

    .amr-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        border-radius: 999px;
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: #fff;
        font-weight: 950;
        text-decoration: none;
        box-shadow: 0 14px 34px rgba(79,70,229,0.22);
    }

    .amr-list {
        display: grid;
        gap: 12px;
    }

    .amr-item {
        position: relative;
        overflow: hidden;
        border-radius: 26px;
        background: linear-gradient(180deg, rgba(255,255,255,0.96), #fff);
        border: 1px solid rgba(2,6,23,0.06);
        box-shadow: 0 18px 42px rgba(15, 23, 42, 0.08);
        padding: 12px;
    }

    .amr-item__grid {
        display: grid;
        grid-template-columns: 132px 1fr;
        gap: 12px;
        align-items: start;
    }

    .amr-photo {
        border: 0;
        padding: 0;
        background: transparent;
        cursor: pointer;
        border-radius: 26px;
        overflow: hidden;
        position: relative;
        width: 132px;
        height: 132px;
        flex-shrink: 0;
        box-shadow: 0 14px 34px rgba(15,23,42,0.10);
    }

        .amr-photo::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.0), rgba(2,6,23,0.18));
            opacity: 0.6;
            transition: opacity 0.18s ease;
            pointer-events: none;
        }

        .amr-photo:hover::after {
            opacity: 0.35;
        }

    .amr-photo__img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transform: scale(1.02);
        transition: transform 0.22s ease;
    }

    .amr-photo:hover .amr-photo__img {
        transform: scale(1.07);
    }

    .amr-photo__placeholder {
        width: 100%;
        height: 100%;
        min-height: 132px;
        display: grid;
        place-content: center;
        gap: 6px;
        color: rgba(15,23,42,0.8);
        background: radial-gradient(circle at 25% 20%, rgba(244,63,94,0.22), transparent 55%), radial-gradient(circle at 80% 70%, rgba(79,70,229,0.22), transparent 55%), linear-gradient(135deg, rgba(15,23,42,0.08), rgba(255,255,255,0.7));
    }

        .amr-photo__placeholder .oi {
            font-size: 1.6rem;
            opacity: 0.9;
            justify-self: center;
        }

    .amr-photo__phtext {
        font-weight: 950;
        font-size: 0.86rem;
    }

    .amr-photo__phid {
        font-weight: 950;
        font-size: 0.78rem;
        opacity: 0.85;
        justify-self: center;
    }

    .amr-content {
        min-width: 0;
        padding: 2px 2px 2px 0;
    }

    .amr-heartbar {
        position: absolute;
        left: 10px;
        right: 10px;
        top: 10px;
        height: 36px;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(244,63,94,0.18);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.55);
        pointer-events: none;
        transition: background 0.4s ease, border-color 0.4s ease;
    }

    .amr-heartbar--live {
        background: linear-gradient(90deg, rgba(244,63,94,0.06), rgba(244,63,94,0.08)), repeating-linear-gradient(90deg, rgba(2,6,23,0.08) 0 1px, transparent 1px 52px), repeating-linear-gradient(0deg, rgba(2,6,23,0.06) 0 1px, transparent 1px 10px);
        border-color: rgba(244,63,94,0.18);
    }

    .amr-heartbar--dead {
        background: repeating-linear-gradient(90deg, rgba(100,116,139,0.06) 0 1px, transparent 1px 52px), repeating-linear-gradient(0deg, rgba(100,116,139,0.04) 0 1px, transparent 1px 10px);
        border-color: rgba(100,116,139,0.12);
    }

    .amr-heartbar__svg {
        position: absolute;
        top: 0;
        bottom: 0;
        left: 0;
        width: 260%;
        height: 100%;
        transition: opacity 0.4s ease, filter 0.4s ease;
    }

    .amr-heartbar--live .amr-heartbar__svg {
        opacity: 0.95;
        animation: amr-ecg-move 30s linear infinite;
        filter: drop-shadow(0 0 10px rgba(244,63,94,0.35));
    }

    .amr-heartbar--dead .amr-heartbar__svg {
        opacity: 0.15;
        animation: none;
        filter: none;
    }

    .amr-heartbar__svg--ghost {
        transition: opacity 0.4s ease;
    }

    .amr-heartbar--live .amr-heartbar__svg--ghost {
        opacity: 0.28;
        animation-duration: 44s;
    }

    .amr-heartbar--dead .amr-heartbar__svg--ghost {
        opacity: 0.08;
        animation: none;
    }

    .amr-heartbar__path {
        fill: none;
        stroke-width: 3.8;
        stroke-linecap: round;
        stroke-linejoin: round;
        transition: stroke 0.4s ease;
    }

    .amr-heartbar--live .amr-heartbar__path {
        stroke: rgba(244,63,94,0.95);
    }

    .amr-heartbar--dead .amr-heartbar__path {
        stroke: rgba(100,116,139,0.4);
    }

    @@keyframes amr-ecg-move {
        0% {
            transform: translateX(0%);
        }

        100% {
            transform: translateX(-55%);
        }
    }

    .amr-item--alive {
        padding-top: 54px;
    }

    .amr-item__header {
        display: flex; align-items: flex-start; justify-content: space-between; gap: 8px;
        margin-bottom: 10px;
    }

    .amr-customer {
        min-width: 0; flex: 1;
    }
    .amr-customer__name {
