    private void HandleTouchStart(TouchEventArgs e, CustomerReceiptDto item)
    {
        // Cancel any existing timer
        touchTimer?.Dispose();

        // Store initial touch position
        touchStartX = e.Touches[0].ClientX;
        touchStartY = e.Touches[0].ClientY;

        // Start a timer for 600ms to detect Long Press
        touchTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                contextMenuItem = item;
                // Center for mobile
                contextMenuX = 0;
                contextMenuY = 0;
                showContextMenu = true;
                _contextMenuOpenedAt = DateTime.UtcNow;
                StateHasChanged();
            });
        }, null, 600, System.Threading.Timeout.Infinite);
    }

    private void HandleTouchMove(TouchEventArgs e)
    {
        // Check if user moved finger significantly (scrolling)
        if (e.Touches.Length > 0)
        {
            var deltaX = Math.Abs(e.Touches[0].ClientX - touchStartX);
            var deltaY = Math.Abs(e.Touches[0].ClientY - touchStartY);
            
            // If moved beyond threshold, cancel the long-press
            if (deltaX > TouchMoveThreshold || deltaY > TouchMoveThreshold)
            {
                touchTimer?.Dispose();
                touchTimer = null;
            }
        }
    }

    private void HandleTouchEnd(TouchEventArgs e)
    {
        touchTimer?.Dispose();
        touchTimer = null;
    }

