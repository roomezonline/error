@page "/"
@using ErrorService.Shared
@using System.Net.Http.Json
@using System.Text.Json
@inject NavigationManager NavigationManager
@inject ErrorService.Client.Services.SiteSettingsService SettingsService

<SeoHeader 
    Title="@(string.IsNullOrWhiteSpace(settings?.SeoTitle) ? "ارورسرویس | تعمیر و سرویس لوازم خانگی، کد خطا و قطعات یدکی" : settings!.SeoTitle!)" 
    Description="@(string.IsNullOrWhiteSpace(settings?.SeoDescription) ? "ارورسرویس، مرجع تخصصی کدهای خطای لوازم خانگی، آموزش تعمیرات، قطعات یدکی و سرویس در منزل. بانک جامع ارور ماشین لباسشویی، یخچال، ظرفشویی و ماکروفر." : settings!.SeoDescription!)"
    Keywords="@(string.IsNullOrWhiteSpace(settings?.SeoKeywords) ? "کد خطای لوازم خانگی, تعمیر لوازم خانگی, قطعات یدکی, سرویس لوازم خانگی, ارور ماشین لباسشویی, ارور یخچال, تعمیرات لوازم خانگی" : settings!.SeoKeywords!)"
    OgImage="@(settings?.DefaultOgImage ?? "/images/og-default.jpg")"
    JsonLd="@orgJsonLd" />

<PublicHero />

<section class="container home-entries" dir="rtl" aria-label="دسترسی سریع به بخش‌های اصلی">
    <div class="home-entries__grid">
        <a class="home-entry home-entry--shop" href="/products">
            <span class="home-entry__icon"><span class="oi oi-box" aria-hidden="true"></span></span>
            <span class="home-entry__body">
                <span class="home-entry__title">فروشگاه قطعات</span>
                <span class="home-entry__desc">قطعات یدکی و تجهیزات</span>
            </span>
            <span class="oi oi-arrow-left home-entry__arrow" aria-hidden="true"></span>
        </a>
        <a class="home-entry home-entry--error" href="/technical/error-codes">
            <span class="home-entry__icon"><span class="oi oi-magnifying-glass" aria-hidden="true"></span></span>
            <span class="home-entry__body">
                <span class="home-entry__title">بانک کد خطا</span>
                <span class="home-entry__desc">علت خطا را سریع پیدا کن</span>
            </span>
            <span class="oi oi-arrow-left home-entry__arrow" aria-hidden="true"></span>
        </a>
        <a class="home-entry home-entry--repair" href="/admission/repair">
            <span class="home-entry__icon"><span class="oi oi-wrench" aria-hidden="true"></span></span>
            <span class="home-entry__body">
                <span class="home-entry__title">درخواست تعمیر</span>
                <span class="home-entry__desc">ثبت آنلاین و پیگیری شفاف</span>
            </span>
            <span class="oi oi-arrow-left home-entry__arrow" aria-hidden="true"></span>
        </a>
        <a class="home-entry home-entry--consult" href="/technical/consultation">
            <span class="home-entry__icon"><span class="oi oi-chat" aria-hidden="true"></span></span>
            <span class="home-entry__body">
                <span class="home-entry__title">مشاوره فنی</span>
                <span class="home-entry__desc">کمک کارشناس در انتخاب</span>
            </span>
            <span class="oi oi-arrow-left home-entry__arrow" aria-hidden="true"></span>
        </a>
    </div>
</section>

<HomeStats />

<HomeErrorCodeSearch />

@if (isInitialLoading)
{
    <div class="container my-4" dir="rtl">
        <div class="row g-3">
            @for (int i = 0; i < 6; i++)
            {
                <div class="col-12 col-md-4">
                    <div class="skeleton-card">
                        <div class="skeleton skeleton-img"></div>
                        <div class="skeleton skeleton-title"></div>
                        <div class="skeleton skeleton-text"></div>
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{

@if (orderedModules != null && orderedModules.Count > 0)
{
    @foreach (var module in orderedModules)
    {
        if (!module.IsEnabled)
        {
            continue;
        }

        @switch (module.Key)
        {
            case SiteHomeModuleKey.Stories:
                <div class="container home-head-wrap" dir="rtl">
                    <h2 class="home-head__title">@SectionTitle(SiteHomeModuleKey.Stories)</h2>
                </div>
                <ErrorService.Client.Shared.Components.StoriesBar />
                break;
            case SiteHomeModuleKey.FeatureCards:
                <FeatureCardsRow />
                break;
            case SiteHomeModuleKey.SpecialOffers:
                <SpecialOffers Title="@SectionTitle(SiteHomeModuleKey.SpecialOffers)" />
                break;
            case SiteHomeModuleKey.LatestNews:
                if (hasPublishedNews)
                {
    <div class="container home-news-block" dir="rtl">
        <div class="row g-4">
            @if (HomeCardCount > 0)
            {
                <div class="@(HomeListCount > 0 ? "col-lg-8" : "col-12") d-flex flex-column">
                    <div class="home-head">
                        <h2 class="home-head__title">@HomeTitle</h2>
                        <div class="home-head__actions">
                            <a href="/news" class="home-more">مشاهده همه <span class="oi oi-arrow-left" aria-hidden="true"></span></a>
                        </div>
                    </div>
                    <NewsCardView Count="HomeCardCount" Types="@HomeTypesCsv" />
                </div>
            }
            @if (HomeListCount > 0)
            {
                <div class="@(HomeCardCount > 0 ? "col-lg-4" : "col-12")">
                    <div class="h-100 d-flex flex-column">
                        <div class="home-head">
                            <h2 class="home-head__title">عناوین</h2>
                        </div>
                        <NewsListView Count="HomeListCount" Types="@HomeTypesCsv" />
                    </div>
                </div>
            }
        </div>
    </div>
                }
                break;
            case SiteHomeModuleKey.AcademyHub:
                <HomeAcademyHub Title="@SectionTitle(SiteHomeModuleKey.AcademyHub)" />
                break;
            case SiteHomeModuleKey.TrustStrip:
                <HomeTrustStrip Title="@SectionTitle(SiteHomeModuleKey.TrustStrip)" />
                break;
            case SiteHomeModuleKey.LatestProducts:
                if (showcaseEnabled)
                {
                    if (firstProductModuleKey == SiteHomeModuleKey.LatestProducts)
                    {
                        <HomeProductShowcase ShowLatest="showLatestProductsTab"
                                             ShowBest="showBestSellersTab"
                                             ShowRestocked="showRestockedTab"
                                             Title="@SectionTitle(SiteHomeModuleKey.LatestProducts)" />
                    }
                }
                else
                {
                    <LatestProducts Title="@SectionTitle(SiteHomeModuleKey.LatestProducts, "آخرین محصولات")" />
                }
                break;
            case SiteHomeModuleKey.BestSellers:
                if (showcaseEnabled)
                {
                    if (firstProductModuleKey == SiteHomeModuleKey.BestSellers)
                    {
                        <HomeProductShowcase ShowLatest="showLatestProductsTab"
                                             ShowBest="showBestSellersTab"
                                             ShowRestocked="showRestockedTab"
                                             Title="@SectionTitle(SiteHomeModuleKey.BestSellers, "ویترین محصولات")" />
                    }
                }
                else
                {
                    <ProductRow Title="@SectionTitle(SiteHomeModuleKey.BestSellers)"
                                Endpoint="api/products/bestsellers" />
                }
                break;
            case SiteHomeModuleKey.Restocked:
                if (showcaseEnabled)
                {
                    if (firstProductModuleKey == SiteHomeModuleKey.Restocked)
                    {
                        <HomeProductShowcase ShowLatest="showLatestProductsTab"
                                             ShowBest="showBestSellersTab"
                                             ShowRestocked="showRestockedTab"
                                             Title="@SectionTitle(SiteHomeModuleKey.Restocked, "ویترین محصولات")" />
                    }
                }
                else
                {
                    <ProductRow Title="@SectionTitle(SiteHomeModuleKey.Restocked)"
                                Endpoint="api/products/restocked" />
                }
                break;
            case SiteHomeModuleKey.HomeCategories:
                <HomeCategories Categories="categories" />
                break;
            case SiteHomeModuleKey.PopularBrands:
                if (!trustStripEnabled)
                {
                    <ErrorService.Client.Shared.Components.PopularBrandsRow Title="@SectionTitle(SiteHomeModuleKey.PopularBrands)" />
                }
                break;
            case SiteHomeModuleKey.SomeCustomers:
                if (!trustStripEnabled)
                {
                    <ErrorService.Client.Shared.Components.SomeCustomersRow Title="@SectionTitle(SiteHomeModuleKey.SomeCustomers)" />
                }
                break;
            case SiteHomeModuleKey.LatestCourses:
                if (!academyHubEnabled)
                {
                    <LatestCourses Title="@SectionTitle(SiteHomeModuleKey.LatestCourses)" />
                }
                break;
            case SiteHomeModuleKey.LatestArticles:
                if (!academyHubEnabled)
                {
                    <LatestArticles Title="@SectionTitle(SiteHomeModuleKey.LatestArticles)" />
                }
                break;
            case SiteHomeModuleKey.TeamMembers:
                <TeamMembers Title="@SectionTitle(SiteHomeModuleKey.TeamMembers)" />
                break;
            case SiteHomeModuleKey.TechnicalGuide:
                <TechnicalGuide />
                break;
        }
    }
}

}

<section class="container home-seo-intro" aria-labelledby="home-intro-title">
    <div class="home-seo-intro__card">
        <details class="home-seo-intro__details">
            <summary class="home-seo-intro__summary">
                <span class="home-seo-intro__icon" aria-hidden="true">
                    <span class="oi oi-wrench"></span>
                </span>
                <span class="home-seo-intro__summary-text">
                    <span class="home-seo-intro__eyebrow">آشنایی با ارورسرویس</span>
                    <h2 id="home-intro-title">مرجع تخصصی تعمیرات و قطعات لوازم خانگی</h2>
                </span>
                <span class="oi oi-chevron-down home-seo-intro__toggle" aria-hidden="true"></span>
            </summary>
            <div class="home-seo-intro__body">
                <div class="home-seo-intro__text">
                    <p><strong>ارورسرویس</strong> برای عیب‌یابی و تعمیر لوازم خانگی طراحی شده است. در این سایت می‌توانید <strong>کدهای خطای یخچال، ماشین لباسشویی، ظرفشویی</strong> و دیگر دستگاه‌ها را پیدا کنید. توضیحات هر کد با زبان ساده ارائه می‌شود. راهنمای <strong>بررسی اولیه</strong> نیز به شما کمک می‌کند مشکل دستگاه را بهتر بشناسید.</p>
                    <p>اگر به تعمیرکار نیاز دارید، <strong>درخواست تعمیر خود را آنلاین</strong> ثبت کنید. اطلاعات درخواست برای بررسی کارشناس ارسال می‌شود. روند پیگیری برای شما شفاف است. هدف ما <strong>کاهش زمان عیب‌یابی</strong> و ارائه خدمات مطمئن در محل است.</p>
                    <p class="home-seo-intro__last">در فروشگاه ارورسرویس، <strong>قطعات یدکی و تجهیزات فنی</strong> با توضیحات کاربردی عرضه می‌شوند. بخش آکادمی نیز <strong>آموزش‌های تعمیرات</strong> و نکات فنی را ارائه می‌کند. برای شروع می‌توانید از <a class="home-seo-intro__chip" href="/technical/error-codes">بانک کدهای خطا</a>، <a class="home-seo-intro__chip" href="/products">فروشگاه</a> یا <a class="home-seo-intro__chip" href="/admission/repair">ثبت درخواست تعمیر</a> استفاده کنید.</p>
                </div>
            </div>
        </details>
    </div>
</section>


@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private bool hasPublishedNews;
    private bool showcaseEnabled;
    private bool academyHubEnabled;
    private bool trustStripEnabled;
    private bool showLatestProductsTab;
    private bool showBestSellersTab;
    private bool showRestockedTab;
    private SiteHomeModuleKey? firstProductModuleKey;
    private List<CategoryDto>? categories;
    private SiteSettingsDto? settings;
    private ContentSettingsDto? contentSettings;
    private List<SiteHomeModuleDto> orderedModules = new();
    private string? orgJsonLd;
    private bool isInitialLoading = true;

    private int HomeCardCount => contentSettings?.HomeCardCount ?? 3;
    private int HomeListCount => contentSettings?.HomeListCount ?? 5;
    private string HomeTitle => SectionTitle(SiteHomeModuleKey.LatestNews, contentSettings?.HomeTitle);
    private string SectionTitle(SiteHomeModuleKey key, string? fallback = null)
        => HomeSectionTitles.Resolve(orderedModules, key, fallback);
    private string HomeTypesCsv => string.Join(",",
        (contentSettings ?? new ContentSettingsDto()).HomeContentTypes().Select(t => t.ToString()));
    private bool HomeBlockHasItems => HomeCardCount > 0 || HomeListCount > 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isInitialLoading = true;
            settings = await SettingsService.GetAsync();

            orgJsonLd = $"[{BuildOrgJsonLd(settings)},{BuildWebSiteJsonLd()},{BuildSiteNavigationJsonLd()}]";

            orderedModules = (settings?.HomeModules ?? new List<SiteHomeModuleDto>())
                .OrderBy(x => x.SortOrder)
                .ToList();

            if (orderedModules.Count == 0)
            {
                orderedModules = new List<SiteHomeModuleDto>
                {
                    new() { Key = SiteHomeModuleKey.Stories, IsEnabled = true, SortOrder = 5 },
                    new() { Key = SiteHomeModuleKey.SpecialOffers, IsEnabled = settings?.ShowSpecialOffers ?? true, SortOrder = 10 },
                    new() { Key = SiteHomeModuleKey.FeatureCards, IsEnabled = settings?.ShowFeatureCards ?? true, SortOrder = 18 },
                    new() { Key = SiteHomeModuleKey.HomeCategories, IsEnabled = settings?.ShowHomeCategories ?? true, SortOrder = 15 },
                    new() { Key = SiteHomeModuleKey.PopularBrands, IsEnabled = true, SortOrder = 19 },
                    new() { Key = SiteHomeModuleKey.SomeCustomers, IsEnabled = true, SortOrder = 21 },
                    new() { Key = SiteHomeModuleKey.LatestNews, IsEnabled = settings?.ShowLatestNews ?? true, SortOrder = 20 },
                    new() { Key = SiteHomeModuleKey.LatestProducts, IsEnabled = settings?.ShowLatestProducts ?? true, SortOrder = 30 },
                    new() { Key = SiteHomeModuleKey.AcademyHub, IsEnabled = true, SortOrder = 40 },
                    new() { Key = SiteHomeModuleKey.LatestCourses, IsEnabled = settings?.ShowLatestCourses ?? true, SortOrder = 41 },
                    new() { Key = SiteHomeModuleKey.LatestArticles, IsEnabled = settings?.ShowLatestArticles ?? true, SortOrder = 42 },
                    new() { Key = SiteHomeModuleKey.TrustStrip, IsEnabled = true, SortOrder = 47 },
                    new() { Key = SiteHomeModuleKey.TeamMembers, IsEnabled = settings?.ShowTeamMembers ?? true, SortOrder = 50 },
                    new() { Key = SiteHomeModuleKey.TechnicalGuide, IsEnabled = true, SortOrder = 22 }
                };
            }

            // Modules introduced by the store upgrade: keep them present so a
            // previously persisted module list keeps working after this upgrade.
            if (orderedModules.All(m => m.Key != SiteHomeModuleKey.BestSellers))
                orderedModules.Add(new() { Key = SiteHomeModuleKey.BestSellers, IsEnabled = settings?.EnableHomeBestSellers ?? true, SortOrder = 31 });

            if (orderedModules.All(m => m.Key != SiteHomeModuleKey.Restocked))
                orderedModules.Add(new() { Key = SiteHomeModuleKey.Restocked, IsEnabled = settings?.EnableHomeRestocked ?? true, SortOrder = 32 });

            // The merged sections are new; add them client-side as well so a
            // previously persisted module list keeps working after this upgrade.
            if (orderedModules.All(m => m.Key != SiteHomeModuleKey.AcademyHub))
                orderedModules.Add(new() { Key = SiteHomeModuleKey.AcademyHub, IsEnabled = true, SortOrder = 40 });
            if (orderedModules.All(m => m.Key != SiteHomeModuleKey.TrustStrip))
                orderedModules.Add(new() { Key = SiteHomeModuleKey.TrustStrip, IsEnabled = true, SortOrder = 47 });

            orderedModules = orderedModules.OrderBy(x => x.SortOrder).ToList();
            showLatestProductsTab = orderedModules.Any(m => m.Key == SiteHomeModuleKey.LatestProducts && m.IsEnabled);
            showBestSellersTab = orderedModules.Any(m => m.Key == SiteHomeModuleKey.BestSellers && m.IsEnabled);
            showRestockedTab = orderedModules.Any(m => m.Key == SiteHomeModuleKey.Restocked && m.IsEnabled);
            showcaseEnabled = showLatestProductsTab || showBestSellersTab || showRestockedTab;
            firstProductModuleKey = orderedModules
                .Where(m => m.IsEnabled && m.Key is SiteHomeModuleKey.LatestProducts or SiteHomeModuleKey.BestSellers or SiteHomeModuleKey.Restocked)
                .Select(m => (SiteHomeModuleKey?)m.Key)
                .FirstOrDefault();
            academyHubEnabled = orderedModules.Any(m => m.Key == SiteHomeModuleKey.AcademyHub && m.IsEnabled);
            trustStripEnabled = orderedModules.Any(m => m.Key == SiteHomeModuleKey.TrustStrip && m.IsEnabled);

            // Render the hero and the configured shell as soon as settings are
            // available. Categories/news are below-the-fold and must not delay
            // the first paint or LCP of the home page.
            isInitialLoading = false;
            _ = LoadSecondaryHomeDataAsync(orderedModules);
        }
        catch
        {
            hasPublishedNews = false;
            isInitialLoading = false;
        }
    }

    private async Task LoadSecondaryHomeDataAsync(List<SiteHomeModuleDto> modules)
    {
        try
        {
            var showCategories = modules.Any(m => m.Key == SiteHomeModuleKey.HomeCategories && m.IsEnabled);
            var showNews = modules.Any(m => m.Key == SiteHomeModuleKey.LatestNews && m.IsEnabled);

            var settingsTask = Http.GetFromJsonAsync<ContentSettingsDto>("api/content/settings");
            var categoriesTask = showCategories
                ? Http.GetFromJsonAsync<List<CategoryDto>>("api/categories")
                : Task.FromResult<List<CategoryDto>?>(null);

            await Task.WhenAll(settingsTask, categoriesTask);

            contentSettings = await settingsTask ?? new ContentSettingsDto();
            categories = await categoriesTask;

            if (showNews && HomeBlockHasItems)
            {
                var url = $"api/news?onlyPublished=true&skip=0&take=1&types={Uri.EscapeDataString(HomeTypesCsv)}";
                var news = await Http.GetFromJsonAsync<List<NewsDto>>(url);
                hasPublishedNews = news is { Count: > 0 };
            }
            else
            {
                hasPublishedNews = false;
            }

            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            hasPublishedNews = false;
        }
    }

    private string BuildOrgJsonLd(SiteSettingsDto? settings)
    {
        var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
        var obj = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Organization",
            ["name"] = "ارورسرویس",
            ["url"] = baseUrl,
            ["logo"] = $"{baseUrl}/favicon.png",
            ["description"] = settings?.SeoDescription ?? "فروشگاه لوازم الکترونیک، قطعات و تجهیزات ابزار دقیق و تعمیر تخصصی لوازم خانگی و بردهای الکترونیکی",
            ["contactPoint"] = new Dictionary<string, object?>
            {
                ["@type"] = "ContactPoint",
                ["contactType"] = "customer service",
                ["availableLanguage"] = "Persian"
            }
        };

        return JsonSerializer.Serialize(obj);
    }

    private string BuildWebSiteJsonLd()
    {
        var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
        var obj = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "WebSite",
            ["name"] = "ارورسرویس",
            ["url"] = baseUrl,
            ["potentialAction"] = new Dictionary<string, object?>
            {
                ["@type"] = "SearchAction",
                ["target"] = new Dictionary<string, object?>
                {
                    ["@type"] = "EntryPoint",
                    ["urlTemplate"] = $"{baseUrl}/search?q={{search_term_string}}"
                },
                ["query-input"] = "required name=search_term_string"
            }
        };

        return JsonSerializer.Serialize(obj);
    }

    private string BuildSiteNavigationJsonLd()
    {
        var baseUrl = NavigationManager.BaseUri.TrimEnd('/');
        var navigationItems = new[]
        {
            (Name: "فروشگاه", Url: $"{baseUrl}/products"),
            (Name: "آکادمی", Url: $"{baseUrl}/academy"),
            (Name: "بانک کدهای خطا", Url: $"{baseUrl}/technical/error-codes"),
            (Name: "درخواست تعمیر", Url: $"{baseUrl}/admission/repair"),
            (Name: "مشاوره فنی", Url: $"{baseUrl}/technical/consultation"),
            (Name: "تماس با ما", Url: $"{baseUrl}/contact")
        };

        var obj = new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "ItemList",
            ["name"] = "بخش‌های اصلی ارورسرویس",
            ["itemListElement"] = navigationItems.Select((item, index) => new Dictionary<string, object?>
            {
                ["@type"] = "ListItem",
                ["position"] = index + 1,
                ["name"] = item.Name,
                ["url"] = item.Url
            }).ToList()
        };

        return JsonSerializer.Serialize(obj);
    }
}
