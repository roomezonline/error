@page "/products"
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Shared
@implements IDisposable
@inject ErrorService.Client.Services.CartService CartService
@inject IJSRuntime JS

<PageTitle>فروشگاه ارورسرویس | لوازم الکترونیک، ابزار دقیق و تعمیرات تخصصی</PageTitle>

<SeoHeader
    Title="ارورسرویس | لوازم الکترونیک، ابزار دقیق و تعمیرات تخصصی"
    Description="فروشگاه تخصصی لوازم الکترونیک، قطعات الکترونیکی، بردهای آماده، تجهیزات ابزار دقیق، ابزارآلات تخصصی و ملزومات فنی با بهترین قیمت و ارسال سریع"
    Keywords="لوازم الکترونیک, قطعات الکترونیکی, ابزار دقیق, تجهیزات صنعتی, بردهای آماده, ابزارآلات تخصصی"
    OgType="website" />

<section class="sp" dir="rtl">

    <nav class="sp-crumb d-none d-md-flex" aria-label="breadcrumb">
        <div class="container">
            <ol>
                <li><a href="/"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg> خانه</a></li>
                <li class="active">فروشگاه</li>
            </ol>
        </div>
    </nav>

    <div class="container">

        <div class="sp-hero">
            <div class="sp-hero__slides">
                @for (int i = 0; i < heroSlides.Count; i++)
                {
                    var slide = heroSlides[i];
                    <div class="sp-hero__slide @(currentSlide == i ? "is-active" : "")">
                        <div class="sp-hero__slide-bg" style="background:linear-gradient(135deg,@slide.Color1 0%,@slide.Color2 50%,@slide.Color3 100%)"></div>
                        <svg class="sp-hero__svg-deco sp-hero__svg-deco--1" viewBox="0 0 200 200" fill="none" stroke="white" stroke-width="1.5"><circle cx="100" cy="100" r="80"/><circle cx="100" cy="100" r="50"/><circle cx="100" cy="100" r="20"/><line x1="100" y1="20" x2="100" y2="180"/><line x1="20" y1="100" x2="180" y2="100"/></svg>
                        <svg class="sp-hero__svg-deco sp-hero__svg-deco--2" viewBox="0 0 120 120" fill="none" stroke="white" stroke-width="1.5"><rect x="20" y="20" width="80" height="80" rx="8"/><rect x="35" y="35" width="50" height="50" rx="4"/><circle cx="60" cy="60" r="12"/></svg>
                        <svg class="sp-hero__svg-deco sp-hero__svg-deco--3" viewBox="0 0 60 60" fill="none" stroke="white" stroke-width="1.5"><polygon points="30,5 55,20 55,50 30,55 5,50 5,20"/></svg>
                        <div class="sp-hero__slide-content">
                            <span class="sp-hero__badge">@((MarkupString)slide.Icon) @slide.Badge</span>
                            <h1 class="sp-hero__title">@slide.Title</h1>
                            <p class="sp-hero__sub">@slide.Sub</p>
                            <div class="sp-hero__tags">
                                @foreach (var tag in slide.Tags)
                                {
                                    <span class="sp-hero__tag">@((MarkupString)tag)</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <div class="sp-hero__dots">
                @for (int i = 0; i < heroSlides.Count; i++)
                {
                    var idx = i;
                    <button class="sp-hero__dot @(currentSlide == idx ? "is-active" : "")" @onclick="() => GoToSlide(idx)" aria-label="اسلاید @(idx+1)"></button>
                }
            </div>
            <button class="sp-hero__nav sp-hero__nav--prev" @onclick="PrevSlide" aria-label="قبلی">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button class="sp-hero__nav sp-hero__nav--next" @onclick="NextSlide" aria-label="بعدی">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
        </div>

        @if (categories != null && categories.Any())
        {
            <div class="sp-subcats">
                @foreach (var cat in categories.Take(10))
                {
                    <a href="/products?categoryId=@cat.Id" class="sp-subcat @(selectedCategoryId == cat.Id ? "is-active" : "")" @onclick.preventsDefault="() => SelectCategory(cat.Id)">
                        <div class="sp-subcat__icon">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
                        </div>
                        <span class="sp-subcat__name">@cat.Name</span>
                    </a>
                }
                @if (selectedCategoryId.HasValue)
                {
                    <a href="/products" class="sp-subcat" @onclick.preventsDefault="() => SelectCategory(null)">
                        <div class="sp-subcat__icon sp-subcat__icon--all">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                        </div>
                        <span class="sp-subcat__name">حذف فیلتر</span>
                    </a>
                }
            </div>
        }

        <div class="sp-filters">
            <button class="sp-filters__toggle d-lg-none" @onclick="() => showFilters = !showFilters">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                @(showFilters ? "پنهان کردن فیلترها" : "نمایش فیلترها")
            </button>
            <div class="sp-filters__body @(showFilters ? "" : "d-none d-lg-block")">
                <div class="sp-filters__top">
                    <div class="sp-search">
                        <svg class="sp-search__ico" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
                        <input class="sp-search__input" placeholder="جستجو در محصولات..." @bind="search" @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <button type="button" class="sp-search__clear" @onclick="ClearFilters" aria-label="پاک کردن">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            </button>
                        }
                    </div>
                    <div class="sp-tools">
                        <select class="sp-sort" @bind="sort">
                            <option value="">جدیدترین</option>
                            <option value="price_asc">ارزان‌ترین</option>
                            <option value="price_desc">گران‌ترین</option>
                            <option value="discount_desc">بیشترین تخفیف</option>
                        </select>
                        <label class="sp-toggle">
                            <input type="checkbox" @bind="onlyAvailable" />
                            <span>فقط موجود</span>
                        </label>
                        <label class="sp-toggle">
                            <input type="checkbox" @bind="onlyDiscounted" />
                            <span>فقط تخفیف‌دار</span>
                        </label>
                        <button class="sp-btn-apply" @onclick="ApplyFilters">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                            اعمال
                        </button>
                        <button class="sp-btn-clear" @onclick="ClearFilters">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                            پاک کردن
                        </button>
                    </div>
                </div>
                <div class="sp-price">
                    <div class="sp-price__box">
                        <label>حداقل قیمت (تومان)</label>
                        <div class="sp-price__input">
                            <input type="text" inputmode="numeric" value="@minPriceText" @oninput="OnMinPriceInput" placeholder="0" />
                            <span class="sp-price__unit">تومان</span>
                        </div>
                    </div>
                    <div class="sp-price__sep">تا</div>
                    <div class="sp-price__box">
                        <label>حداکثر قیمت (تومان)</label>
                        <div class="sp-price__input">
                            <input type="text" inputmode="numeric" value="@maxPriceText" @oninput="OnMaxPriceInput" placeholder="..." />
                            <span class="sp-price__unit">تومان</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="sp-meta">
            <div class="sp-meta__count">
                <span class="sp-meta__count-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
                </span>
                <b>@totalCount</b> محصول
            </div>
            <div class="sp-meta__hint">برای یافتن سریع‌تر، از جستجو یا دسته‌بندی استفاده کنید</div>
        </div>

        @if (products == null)
        {
            <div class="row g-3 g-lg-4">
                @for (int i = 0; i < 12; i++)
                {
                    <div class="col-6 col-md-4 col-lg-3 col-xxl-2">
                        <div class="sp-sk">
                            <div class="sp-sk__img"></div>
                            <div class="sp-sk__line w40"></div>
                            <div class="sp-sk__line w80"></div>
                            <div class="sp-sk__line w50"></div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!products.Any())
        {
            <div class="sp-empty">
                <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="#cbd5e1" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M8 15s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                <h4>محصولی یافت نشد</h4>
                <p>هیچ قطعه یا تجهیزاتی با فیلترهای انتخابی مطابقت ندارد.</p>
                <button class="sp-empty__btn" @onclick="ClearFilters">پاک کردن فیلترها</button>
            </div>
        }
        else
        {
            <div class="row g-3 g-lg-4">
                @for (int _i = 0; _i < products.Count; _i++)
                {
                    var prod = products[_i];
                    var discPct = CalculateDiscount(prod);
                    var isDiscount = IsDiscountActive(prod);
                    var isTimed = DiscountHelper.IsTimedActive(prod);
                    var isPermanent = DiscountHelper.IsPermanentActive(prod);
                    var isNew = (DateTimeOffset.Now - prod.CreatedAt).TotalDays <= 14;
                    <div class="col-6 col-md-4 col-lg-3 col-xxl-2">
                        <a href="@SeoUrl.Product(prod.Id, prod.Slug)" class="sp-card-link" aria-label="@prod.Name">
                            <article class="sp-card @(!prod.IsAvailable ? "is-oos" : "") @(isDiscount ? "is-sale" : "")">
                                <div class="sp-card__media">
                                    @if (isDiscount || !prod.IsAvailable || isNew || prod.StockQuantity <= 5)
                                    {
                                        <div class="sp-card__badges">
                                            @if (isTimed)
                                            {
                                                <span class="sp-badge sp-badge--sale">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                                                    @discPct٪ تخفیف
                                                </span>
                                            }
                                            else if (isPermanent)
                                            {
                                                <span class="sp-badge sp-badge--perm">
                                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                                    تخفیف دائمی
                                                </span>
                                            }
                                            @if (isNew)
                                            {
                                                <span class="sp-badge sp-badge--new">جدید</span>
                                            }
                                            @if (!prod.IsAvailable || prod.StockQuantity <= 0)
                                            {
                                                <span class="sp-badge sp-badge--oos">ناموجود</span>
                                            }
                                            else if (prod.StockQuantity <= 5)
                                            {
                                                <span class="sp-badge sp-badge--low">تنها @prod.StockQuantity عدد</span>
                                            }
                                        </div>
                                    }
                                    <button class="sp-card__wishlist" @onclick.preventsDefault="() => { }" @onclick:stopPropagation aria-label="افزودن به علاقه‌مندی">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                                    </button>
                                    <img src="@(string.IsNullOrEmpty(prod.MainImageUrl) ? "/images/placeholder-product.svg" : prod.MainImageUrl)"
                                         loading="lazy" class="sp-card__img" alt="@prod.Name" />
                                    <div class="sp-card__cart-area">
                                        <QuantityControl Quantity="@CartService.GetQuantity(prod.Id)"
                                                         Disabled="@(!prod.IsAvailable || prod.StockQuantity <= 0)"
                                                         OnAdd="() => AddToCart(prod)"
                                                         OnIncrease="() => Increase(prod)"
                                                         OnDecrease="() => Decrease(prod)" />
                                    </div>
                                </div>
                                <div class="sp-card__body">
                                    <span class="sp-card__cat">@prod.CategoryName</span>
                                    <h3 class="sp-card__title">@prod.Name</h3>
                                    <div class="sp-card__price">
                                        @if (isDiscount)
                                        {
                                            <div class="sp-card__price-row">
                                                <span class="sp-card__now">@prod.DiscountPrice!.Value.ToString("N0") <small>تومان</small></span>
                                                <span class="sp-card__was">@prod.Price.ToString("N0") <small>تومان</small></span>
                                            </div>
                                            @if (isTimed)
                                            {
                                                <div class="sp-card__countdown" title="پایان تخفیف">
                                                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                                    @GetCountdown(prod.Id)
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="sp-card__price-row">
                                                <span class="sp-card__now">@prod.Price.ToString("N0") <small>تومان</small></span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </article>
                        </a>
                    </div>
                }
            </div>

            @if (totalPages > 1)
            {
                <nav class="sp-pager" aria-label="صفحه‌بندی">
                    <button class="sp-pager__btn sp-pager__btn--nav" disabled="@(currentPage <= 1)" @onclick="() => GoToPage(currentPage - 1)">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                        قبلی
                    </button>
                    <div class="sp-pager__pages">
                        @foreach (var p in GetPageNumbers())
                        {
                            if (p == -1)
                            {
                                <span class="sp-pager__ellipsis">...</span>
                            }
                            else
                            {
                                <button class="sp-pager__btn @(p == currentPage ? "is-active" : "")" @onclick="() => GoToPage(p)">@p</button>
                            }
                        }
                    </div>
                    <button class="sp-pager__btn sp-pager__btn--nav" disabled="@(currentPage >= totalPages)" @onclick="() => GoToPage(currentPage + 1)">
                        بعدی
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                    </button>
                </nav>
            }
        }
    </div>
</section>

<style>
    .sp{--pri:#1e40af;--pri2:#1e3a8a;--pri-l:#eff6ff;--pri-g:rgba(30,64,175,.12);--sale:#ef4444;--sale-bg:#fef2f2;--ok:#059669;--ok-bg:#ecfdf5;--warn:#d97706;--warn-bg:#fffbeb;--new:#059669;--new-bg:#ecfdf5;--bg:#f0f2f5;--sf:#fff;--sf2:#f8fafc;--bd:rgba(0,0,0,.08);--tx:#111827;--mt:#6b7280;--radius:16px;background:var(--bg);color:var(--tx);min-height:100vh;font-family:'Vazirmatn',system-ui,sans-serif;padding-bottom:4rem}
    .sp .container{max-width:1320px}

    .sp-crumb ol{list-style:none;display:flex;align-items:center;gap:.4rem;padding:0;margin:0 0 1rem;font-size:.8rem;color:var(--mt)}
    .sp-crumb li{display:flex;align-items:center}
    .sp-crumb li+li::before{content:"";margin:0 .35rem;width:4px;height:4px;background:#d1d5db;border-radius:50%;flex-shrink:0}
    .sp-crumb a{color:var(--pri);text-decoration:none;font-weight:700;display:inline-flex;align-items:center;gap:.3rem}
    .sp-crumb a:hover{text-decoration:underline}

    .sp-hero{position:relative;border-radius:20px;overflow:hidden;margin-bottom:2rem;height:280px}
    .sp-hero__slides{position:relative;width:100%;height:100%}
    .sp-hero__slide{position:absolute;inset:0;opacity:0;transition:opacity .6s ease;pointer-events:none}
    .sp-hero__slide.is-active{opacity:1;pointer-events:auto}
    .sp-hero__slide-bg{position:absolute;inset:0}
    .sp-hero__slide-content{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;height:100%;padding:2.5rem 3rem 2.5rem 10rem;color:#fff}
    .sp-hero__badge{display:inline-flex;align-items:center;gap:.4rem;background:rgba(255,255,255,.18);border:1px solid rgba(255,255,255,.25);border-radius:999px;padding:.35rem 1rem;font-size:.72rem;font-weight:800;margin-bottom:.8rem;backdrop-filter:blur(4px);width:fit-content}
    .sp-hero__title{font-size:clamp(1.3rem,3.5vw,2rem);font-weight:900;margin:0 0 .5rem;line-height:1.4}
    .sp-hero__sub{font-size:.85rem;margin:0 0 1rem;opacity:.88;font-weight:600;line-height:1.7;max-width:480px}
    .sp-hero__tags{display:flex;flex-wrap:wrap;gap:.4rem}
    .sp-hero__tag{display:inline-flex;align-items:center;gap:.3rem;background:rgba(255,255,255,.12);border:1px solid rgba(255,255,255,.18);border-radius:999px;padding:.3rem .8rem;font-size:.7rem;font-weight:700;backdrop-filter:blur(4px)}
    .sp-hero__dots{position:absolute;bottom:1.2rem;left:50%;transform:translateX(-50%);z-index:3;display:flex;gap:.5rem}
    .sp-hero__dot{width:10px;height:10px;border-radius:50%;border:2px solid rgba(255,255,255,.5);background:transparent;cursor:pointer;transition:all .3s;padding:0}
    .sp-hero__dot.is-active{background:#fff;border-color:#fff;width:28px;border-radius:5px}
    .sp-hero__nav{position:absolute;top:50%;transform:translateY(-50%);z-index:3;width:40px;height:40px;border-radius:50%;border:none;background:rgba(255,255,255,.2);backdrop-filter:blur(4px);color:#fff;cursor:pointer;display:grid;place-items:center;transition:all .2s}
    .sp-hero__nav:hover{background:rgba(255,255,255,.35)}
    .sp-hero__nav--prev{right:1rem}
    .sp-hero__nav--next{left:1rem}
    .sp-hero__svg-deco{position:absolute;z-index:1;opacity:.06;pointer-events:none}
    .sp-hero__svg-deco--1{top:-20px;right:12rem;width:180px;height:180px;animation:sp-float 6s ease-in-out infinite}
    .sp-hero__svg-deco--2{bottom:-30px;right:5rem;width:120px;height:120px;animation:sp-float 8s ease-in-out infinite reverse}
    .sp-hero__svg-deco--3{top:1rem;right:28rem;width:60px;height:60px;animation:sp-float 5s ease-in-out infinite 1s}
    @@keyframes sp-float{0%,100%{transform:translateY(0) rotate(0deg)}50%{transform:translateY(-12px) rotate(5deg)}}

    .sp-subcats{display:flex;gap:.5rem;overflow-x:auto;padding:.2rem 0 1rem;margin-bottom:.75rem;scrollbar-width:none}
    .sp-subcats::-webkit-scrollbar{display:none}
    .sp-subcat{display:flex;flex-direction:column;align-items:center;gap:.4rem;text-decoration:none;color:var(--tx);background:var(--sf);border:1.5px solid var(--bd);border-radius:14px;padding:.7rem .6rem;min-width:80px;flex-shrink:0;transition:all .2s}
    .sp-subcat:hover{border-color:var(--pri);color:var(--pri);transform:translateY(-2px);box-shadow:0 4px 12px rgba(30,64,175,.1)}
    .sp-subcat.is-active{background:var(--pri);border-color:var(--pri);color:#fff;box-shadow:0 4px 16px rgba(30,64,175,.3)}
    .sp-subcat__icon{width:40px;height:40px;border-radius:12px;background:var(--pri-l);display:grid;place-items:center;transition:all .2s}
    .sp-subcat.is-active .sp-subcat__icon{background:rgba(255,255,255,.2)}
    .sp-subcat__icon--all{background:var(--sale-bg)}
    .sp-subcat__name{font-size:.7rem;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:80px}

    .sp-filters{background:var(--sf);border:1px solid var(--bd);border-radius:var(--radius);padding:1rem 1.25rem;margin-bottom:1.25rem;box-shadow:0 2px 8px rgba(0,0,0,.03)}
    .sp-filters__toggle{width:100%;border:none;background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;border-radius:14px;padding:.7rem 1.1rem;font-size:.85rem;font-weight:800;margin-bottom:.9rem;display:flex;align-items:center;justify-content:center;gap:.5rem;box-shadow:0 6px 16px rgba(30,64,175,.25)}
    .sp-filters__top{display:grid;grid-template-columns:1fr;gap:.85rem}
