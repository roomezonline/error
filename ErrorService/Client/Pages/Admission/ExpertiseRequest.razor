    private async Task SubmitFinal()
    {
        if (settings?.OtpEnabled != false && string.IsNullOrEmpty(request.VerificationCode))
        {
            ToastService.ShowWarning("لطفاً کد تایید را وارد کنید");
            return;
        }

        isSubmitting = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/online-admission/submit", request);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("درخواست شما با موفقیت ثبت شد. به زودی با شما تماس خواهیم گرفت.");
                Nav.NavigateTo("/");
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(msg.Contains("کد") ? msg : "خطا در ثبت درخواست");
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("خطای سیستمی در ثبت درخواست");
        }
        finally { isSubmitting = false; }
    }

    private string FormatCardNumberPersian(string? cardNumber)
    {
        if (string.IsNullOrWhiteSpace(cardNumber)) return "";
        var digits = new string(cardNumber.Where(char.IsDigit).ToArray());
        if (digits.Length != 16) return cardNumber;
        
        var groups = new[] { digits.Substring(0, 4), digits.Substring(4, 4), digits.Substring(8, 4), digits.Substring(12, 4) };
        var formatted = string.Join("-", groups);
        
        // Convert to Persian digits
        return ConvertToPersianDigits(formatted);
    }

    private string ConvertToPersianDigits(string input)
    {
        return input
            .Replace('0', '۰')
            .Replace('1', '۱')
            .Replace('2', '۲')
            .Replace('3', '۳')
            .Replace('4', '۴')
            .Replace('5', '۵')
            .Replace('6', '۶')
            .Replace('7', '۷')
            .Replace('8', '۸')
            .Replace('9', '۹');
    }

    private async Task CopyCardNumber(string? cardNumber)
    {
        if (string.IsNullOrWhiteSpace(cardNumber)) return;
        var digits = new string(cardNumber.Where(char.IsDigit).ToArray());
        await JSRuntime.InvokeVoidAsync("__copyToClipboard", digits);
        ToastService.ShowSuccess("شماره کارت کپی شد");
    }

