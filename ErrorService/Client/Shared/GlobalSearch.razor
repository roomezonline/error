@using System.Net.Http.Json
@using ErrorService.Shared
@using Microsoft.AspNetCore.Components.Web

<div class="global-search" @onkeydown="HandleKeyDown">
    <div class="global-search__input">
        <span class="oi oi-magnifying-glass text-muted" aria-hidden="true"></span>
        <input class="form-control global-search__textbox" placeholder="جستجو در محصولات و اخبار..." autocomplete="off" value="@query" @oninput="OnQueryInput" @onfocus="Open" />
        @if (!string.IsNullOrWhiteSpace(query))
        {
            <button type="button" class="global-search__clear" @onclick="Clear" aria-label="پاک کردن">
                <span class="oi oi-x" aria-hidden="true"></span>
            </button>
        }
    </div>

    @if (isOpen)
    {
        <button type="button" class="global-search__backdrop" @onclick="Close" aria-label="بستن جستجو"></button>
    }


    @if (isOpen)
    {
        <div class="global-search__panel shadow" @onclick:stopPropagation="true">
            @if (isLoading)
            {
                <div class="p-3 text-center text-muted small">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    در حال جستجو...
                </div>
            }
            else if ((suggests == null || suggests.Count == 0) &&
                     (results == null || (results.Products.Count == 0 && results.News.Count == 0 && results.Articles.Count == 0)))
            {
                <div class="p-3 text-muted small">نتیجه‌ای یافت نشد.</div>
            }
            else
            {
                var searchResults = results ?? new SearchResponseDto();
                @if (suggests != null && suggests.Count > 0)
                {
                    <div class="global-search__section">
                        <div class="global-search__section-title">پیشنهاد محصولات</div>
                        @foreach (var s in suggests)
                        {
                            var suggestUrl = $"/products/{s.Id}";
                            <button type="button" class="global-search__item @(IsSelected(new SearchResultItemDto { Type = "product", Id = s.Id }) ? "is-selected" : "")" @onclick="() => Go(suggestUrl)">
                                <div class="global-search__item-title">@s.Name</div>
                                <div class="global-search__item-subtitle">@PriceLabel(s)</div>
                            </button>
                        }
                    </div>
                }

                @if (searchResults.Products.Count > 0)
                {
                    <div class="global-search__section">
                        <div class="global-search__section-title">محصولات</div>
                        @foreach (var item in searchResults.Products.Where(p => suggests == null || suggests.All(s => s.Id != p.Id)))
                        {
                            <button type="button" class="global-search__item @(IsSelected(item) ? "is-selected" : "")" @onclick="() => Go(item.Url)">
                                <div class="global-search__item-title">@item.Title</div>
                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                {
                                    <div class="global-search__item-subtitle">@item.Subtitle</div>
                                }
                            </button>
                        }
                    </div>
                }

                @if (searchResults.News.Count > 0)
                {
                    <div class="global-search__section">
                        <div class="global-search__section-title">اخبار</div>
                        @foreach (var item in searchResults.News)
                        {
                            <button type="button" class="global-search__item @(IsSelected(item) ? "is-selected" : "")" @onclick="() => Go(item.Url)">
                                <div class="global-search__item-title">@item.Title</div>
                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                {
                                    <div class="global-search__item-subtitle">@item.Subtitle</div>
                                }
                            </button>
                        }
                    </div>
                }

                @if (searchResults.Articles.Count > 0)
                {
                    <div class="global-search__section">
                        <div class="global-search__section-title">مقالات آموزشی</div>
                        @foreach (var item in searchResults.Articles)
                        {
                            <button type="button" class="global-search__item @(IsSelected(item) ? "is-selected" : "")" @onclick="() => Go(item.Url)">
                                <div class="global-search__item-title">@item.Title</div>
                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                {
                                    <div class="global-search__item-subtitle">@item.Subtitle</div>
                                }
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private string query = string.Empty;
    private bool isOpen;
    private bool isLoading;
    private SearchResponseDto? results;
    private List<ProductSuggestDto>? suggests;

    private CancellationTokenSource? cts;
    private int selectedIndex = -1;
    private string? _lastTrackedQuery;

    protected override void OnInitialized()
    {
        results = new SearchResponseDto();
    }

    private void Open()
    {
        isOpen = true;
    }

    private void Close()
    {
        isOpen = false;
        selectedIndex = -1;
    }

    private void Clear()
    {
        query = string.Empty;
        results = new SearchResponseDto();
        suggests = null;
        isOpen = false;
        selectedIndex = -1;
    }

    private async Task OnQueryInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? string.Empty;
        await SearchAsync(query);
    }

    private async Task SearchAsync(string q)
    {
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var token = cts.Token;

        if (string.IsNullOrWhiteSpace(q) || q.Trim().Length < 2)
        {
            results = new SearchResponseDto();
            suggests = null;
            isLoading = false;
            selectedIndex = -1;
            return;
        }

        isLoading = true;
        try
        {
            await Task.Delay(150, token);
            var trimmed = q.Trim();
            var searchTask = Http.GetFromJsonAsync<SearchResponseDto>($"api/search?q={Uri.EscapeDataString(trimmed)}&take=10", token);
            var suggestTask = Http.GetFromJsonAsync<List<ProductSuggestDto>>($"api/search/suggest?q={Uri.EscapeDataString(trimmed)}", token);

            SearchResponseDto? resp = null;
            List<ProductSuggestDto>? sug = null;
            try { resp = await searchTask; } catch (OperationCanceledException) { throw; } catch { }
            try { sug = await suggestTask; } catch (OperationCanceledException) { throw; } catch { }

            results = resp ?? new SearchResponseDto();
            suggests = sug ?? new List<ProductSuggestDto>();
            selectedIndex = GetFlatResults().Count > 0 ? 0 : -1;

            if (!string.Equals(_lastTrackedQuery, trimmed, StringComparison.OrdinalIgnoreCase))
            {
                _lastTrackedQuery = trimmed;
                _ = TrackSearchAsync(trimmed, GetFlatResults().Count);
            }
        }
        catch (OperationCanceledException) { }
        catch
        {
            results = new SearchResponseDto();
            selectedIndex = -1;
        }
        finally
        {
            isLoading = false;
            isOpen = true;
        }
    }

    private async Task TrackSearchAsync(string term, int count)
    {
        try { await JS.InvokeVoidAsync("trackGaEvent", "search", new { search_term = term, results = count }); } catch { }
    }

    private void Go(string url)
    {
        isOpen = false;
        selectedIndex = -1;
        Nav.NavigateTo(url);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
            return;
        }

        if (!isOpen)
            return;

        var flat = GetFlatResults();
        if (flat.Count == 0)
            return;

        if (e.Key == "ArrowDown")
        {
            selectedIndex = selectedIndex < 0 ? 0 : Math.Min(selectedIndex + 1, flat.Count - 1);
            return;
        }

        if (e.Key == "ArrowUp")
        {
            selectedIndex = selectedIndex <= 0 ? 0 : selectedIndex - 1;
            return;
        }

        if (e.Key == "Enter")
        {
            if (selectedIndex >= 0 && selectedIndex < flat.Count)
                Go(flat[selectedIndex].Url);
            return;
        }

        await Task.CompletedTask;
    }

    private List<SearchResultItemDto> GetFlatResults()
    {
        var flat = new List<SearchResultItemDto>();
        if (suggests != null)
        {
            foreach (var s in suggests)
                flat.Add(new SearchResultItemDto { Type = "product", Id = s.Id, Title = s.Name, Url = $"/products/{s.Id}", ImageUrl = s.ImageUrl });
        }
        if (results != null)
        {
            if (results.Products != null)
            {
                foreach (var p in results.Products)
                {
                    if (suggests == null || suggests.All(s => s.Id != p.Id))
                        flat.Add(p);
                }
            }
            if (results.News != null) flat.AddRange(results.News);
            if (results.Articles != null) flat.AddRange(results.Articles);
        }
        return flat;
    }

    private static string PriceLabel(ProductSuggestDto s)
    {
        var price = s.DiscountPrice.HasValue && s.DiscountPrice.Value < s.Price
            ? s.DiscountPrice.Value
            : s.Price;
        var label = $"{price:N0} تومان";
        return s.IsAvailable ? label : label + " · ناموجود";
    }

    private bool IsSelected(SearchResultItemDto item)
    {
        var flat = GetFlatResults();
        if (selectedIndex < 0 || selectedIndex >= flat.Count) return false;
        var current = flat[selectedIndex];
        return current.Type == item.Type && current.Id == item.Id;
    }

    private string Query
    {
        get => query;
        set
        {
            query = value;
            _ = InvokeAsync(() => SearchAsync(query));
        }
    }
}
