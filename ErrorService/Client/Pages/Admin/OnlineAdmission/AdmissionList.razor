@code {
    private List<OnlineAdmissionDto>? list;
    private List<OnlineAdmissionDto>? filteredList;
    private string filterType = "";
    private string filterStatus = OnlineAdmissionStatuses.Pending;
    private string searchQuery = "";
    private int? expandedId;
    private bool isSaving;
    private List<WorkshopDto>? activeWorkshops;
    private int displayCount = 12;
    private System.Threading.Timer? debounceTimer;

    // SMS Modal
    private bool showSmsModal;
    private OnlineAdmissionDto? smsModalItem;
    private string smsModalWorkshopName = "";
    private List<PersonnelSelection>? smsPersonnel;
    private bool smsSending;
    private int smsTariff;

    protected override async Task OnInitializedAsync()
    {
        await LoadActiveWorkshops();
        await LoadList();
    }

    private async Task LoadActiveWorkshops()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<WorkshopDto>>("api/workshops");
            activeWorkshops = all?.Where(x => x.IsActive).OrderBy(x => x.WorkshopName).ToList() ?? new List<WorkshopDto>();
        }
        catch
        {
            activeWorkshops = new List<WorkshopDto>();
        }
    }

    private async Task LoadList()
    {
        list = null;
        try
        {
            list = await Http.GetFromJsonAsync<List<OnlineAdmissionDto>>($"api/online-admission/admin/list?type={filterType}&status={filterStatus}");
            ApplySearch();
        }
        catch (Exception)
        {
            ToastService.ShowError("خطا در بارگذاری لیست");
        }
    }

    private void ApplySearch()
    {
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            filteredList = list?.ToList();
        }
        else
        {
            var q = searchQuery.Trim().ToLower();
            filteredList = list?.Where(x => 
                (x.CustomerFullName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.CustomerMobile?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.DeviceTypeName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.DeviceBrandName?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (x.ProblemDescription?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
            ).ToList();
        }
        displayCount = 12; // Reset to initial count when search changes
        StateHasChanged();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? "";
        debounceTimer?.Dispose();
        debounceTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                ApplySearch();
            });
        }, null, 200, System.Threading.Timeout.Infinite);
    }

    private void LoadMore()
    {
        displayCount += 12;
    }

    private bool HasMoreItems => filteredList?.Count > displayCount;

    private List<OnlineAdmissionDto>? DisplayedItems => filteredList?.Take(displayCount).ToList();

    private async Task SetFilterType(string type)
    {
        filterType = type;
        await LoadList();
    }

    private async Task SetFilterStatus(string status)
    {
        filterStatus = status;
        await LoadList();
    }

    private void ToggleExpand(OnlineAdmissionDto item)
    {
        expandedId = expandedId == item.Id ? null : item.Id;
    }

    private async Task UpdateStatus(OnlineAdmissionDto item)
    {
        isSaving = true;
        try
        {
            var resp = await Http.PostAsync($"api/online-admission/admin/update-status?id={item.Id}&status={item.Status}&adminNote={Uri.EscapeDataString(item.AdminNote ?? "")}", null);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("وضعیت با موفقیت تغییر کرد");
                expandedId = null;
                await LoadList();
            }
        }
        catch { ToastService.ShowError("خطا در ذخیره‌سازی"); }
        finally { isSaving = false; }
    }

    private string GetStatusLabel(string status) => status switch
    {
        OnlineAdmissionStatuses.Pending => "در انتظار بررسی",
        OnlineAdmissionStatuses.Verified => "تایید شده",
        OnlineAdmissionStatuses.Processing => "در حال انجام",
        OnlineAdmissionStatuses.Done => "تکمیل شده",
        OnlineAdmissionStatuses.Canceled => "لغو شده",
        OnlineAdmissionStatuses.Rejected => "رد شده",
        OnlineAdmissionStatuses.Deleted => "حذف شده",
        _ => status
    };

    private async Task AssignToWorkshop(OnlineAdmissionDto item)
    {
        if ((item.AssignedWorkshopId ?? 0) <= 0)
        {
            ToastService.ShowWarning("ابتدا کارگاه را انتخاب کنید");
            return;
        }

        var modalShown = await TryShowSmsModal(item);
        if (!modalShown)
        {
            if (await PerformAssign(item))
            {
                expandedId = null;
                await LoadList();
            }
        }
    }

    private async Task<bool> PerformAssign(OnlineAdmissionDto item)
    {
        isSaving = true;
        StateHasChanged();
        try
        {
            var note = Uri.EscapeDataString(item.AdminNote ?? string.Empty);
            var url = $"api/online-admission/admin/assign-repair?id={item.Id}&workshopId={item.AssignedWorkshopId.Value}&adminNote={note}";
            var resp = await Http.PostAsync(url, null);
            if (resp.IsSuccessStatusCode) return true;
            var body = await resp.Content.ReadAsStringAsync();
            ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا در ارجاع" : body.Trim('"'));
            return false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in PerformAssign: {ex.Message}");
            ToastService.ShowError("خطا در ارجاع");
            return false;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private async Task RejectRequest(OnlineAdmissionDto item)
    {
        if (string.IsNullOrWhiteSpace(item.AdminNote))
        {
            ToastService.ShowWarning("برای رد کردن، یادداشت مدیر الزامی است");
            return;
        }

        isSaving = true;
        try
        {
            var note = Uri.EscapeDataString(item.AdminNote ?? string.Empty);
            var resp = await Http.PostAsync($"api/online-admission/admin/reject?id={item.Id}&adminNote={note}", null);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("درخواست رد شد");
                expandedId = null;
                await LoadList();
            }
        }
        catch { ToastService.ShowError("خطا در عملیات"); }
        finally { isSaving = false; }
    }

    private async Task DeleteRequest(OnlineAdmissionDto item)
    {
        isSaving = true;
        try
        {
            var resp = await Http.PostAsync($"api/online-admission/admin/delete?id={item.Id}", null);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("حذف شد");
                expandedId = null;
                await LoadList();
            }
        }
        catch { ToastService.ShowError("خطا در حذف"); }
        finally { isSaving = false; }
    }

    private async Task RestoreRequest(OnlineAdmissionDto item)
    {
        isSaving = true;
        try
        {
            var resp = await Http.PostAsync($"api/online-admission/admin/restore?id={item.Id}", null);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("بازگردانی شد");
                expandedId = null;
                await LoadList();
            }
        }
        catch { ToastService.ShowError("خطا در بازگردانی"); }
        finally { isSaving = false; }
    }

    private async Task ShowImage(string url)
    {
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    // --- SMS Modal ---

    private async Task<bool> TryShowSmsModal(OnlineAdmissionDto item)
    {
        var workshopId = item.AssignedWorkshopId ?? 0;
        if (workshopId <= 0) return false;

        try
        {
            var moduleResp = await Http.GetAsync($"api/workshop-sms/module-status?workshopId={workshopId}&moduleType=4");
            if (!moduleResp.IsSuccessStatusCode) return false;
            var moduleActive = await moduleResp.Content.ReadFromJsonAsync<bool>();
            if (!moduleActive) return false;

            var tariffResp = await Http.GetAsync("api/workshop-sms/tariff");
            if (!tariffResp.IsSuccessStatusCode) return false;
            smsTariff = await tariffResp.Content.ReadFromJsonAsync<int>();

            var usersResp = await Http.GetFromJsonAsync<List<WorkshopUserDto>>($"api/workshop-auth/users?workshopId={workshopId}");
            if (usersResp == null || usersResp.Count == 0) return false;

            var ws = activeWorkshops?.FirstOrDefault(w => w.Id == workshopId);
            smsModalWorkshopName = ws?.WorkshopName ?? "کارگاه";

            var priority = new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase)
            {
                ["workshop_manager"] = 0,
                ["technician"] = 1,
                ["operator"] = 2,
                ["content_manager"] = 3
            };

            smsPersonnel = usersResp
                .Select(u => new PersonnelSelection
                {
                    Id = u.Id,
                    FullName = u.FullName,
                    PhoneNumber = u.PhoneNumber,
                    RoleKeys = u.RoleKeys,
                    IsSelected = usersResp.Count == 1
                })
                .OrderBy(p =>
                {
                    var minPriority = p.RoleKeys
                        .Select(r => priority.TryGetValue(r, out var pr) ? pr : 99)
                        .DefaultIfEmpty(99)
                        .Min();
                    return minPriority;
                })
                .ThenBy(p => p.FullName)
                .ToList();

            smsModalItem = item;
            showSmsModal = true;
            StateHasChanged();
            return true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading SMS modal data: {ex.Message}");
            return false;
        }
    }

    private void TogglePersonnel(PersonnelSelection person)
    {
        person.IsSelected = !person.IsSelected;
    }

    private void SelectAllPersonnel()
    {
        if (smsPersonnel == null) return;
        var allSelected = smsPersonnel.All(p => p.IsSelected);
        foreach (var p in smsPersonnel)
            p.IsSelected = !allSelected;
    }

    private void CloseSmsModal()
    {
        showSmsModal = false;
        smsModalItem = null;
        smsPersonnel = null;
        smsSending = false;
        StateHasChanged();
    }

    private async Task ConfirmSmsSend()
    {
        if (smsPersonnel == null || smsModalItem == null) return;
        var selected = smsPersonnel.Where(p => p.IsSelected && !string.IsNullOrWhiteSpace(p.PhoneNumber)).ToList();
        if (selected.Count == 0)
        {
            ToastService.ShowWarning("گیرنده‌ای انتخاب نشده است");
            return;
        }

        smsSending = true;
        StateHasChanged();

        try
        {
            var assignOk = await PerformAssign(smsModalItem);
            if (!assignOk)
            {
                smsSending = false;
                StateHasChanged();
                return;
            }

            expandedId = null;

            var request = new SendTechnicianSmsRequest
            {
                WorkshopId = smsModalItem.AssignedWorkshopId ?? 0,
                Recipients = selected.Select(p => new SmsRecipientDto
                {
                    Mobile = p.PhoneNumber,
                    TechnicianName = p.FullName
                }).ToList()
            };

            var resp = await Http.PostAsJsonAsync("api/online-admission/admin/send-technician-sms", request);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<SendTechnicianSmsResponse>();
                var successCount = result?.Results.Count(r => r.Success) ?? 0;
                var failCount = result?.Results.Count(r => !r.Success) ?? 0;
                if (failCount == 0)
                    ToastService.ShowSuccess($"ارجاع انجام شد. پیامک برای {successCount} نفر ارسال شد");
                else
                    ToastService.ShowWarning($"ارجاع انجام شد. پیامک برای {successCount} نفر ارسال شد. {failCount} نفر ناموفق");
            }
            else
            {
                ToastService.ShowWarning("ارجاع انجام شد اما پیامک ارسال نشد");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Exception in ConfirmSmsSend: {ex.Message}");
            ToastService.ShowWarning("ارجاع انجام شد اما خطا در ارسال پیامک");
        }
        finally
        {
            smsSending = false;
            await LoadList();
            CloseSmsModal();
        }
    }

    private static string GetRolePersian(string roleKey) => roleKey switch
    {
        "workshop_manager" => "مدیر",
        "technician" => "تکنسین",
        "operator" => "اپراتور",
        "content_manager" => "محتوا",
        _ => roleKey
    };

    private sealed class PersonnelSelection
    {
        public int Id { get; set; }
        public string FullName { get; set; } = "";
        public string PhoneNumber { get; set; } = "";
        public List<string> RoleKeys { get; set; } = new();
        public bool IsSelected { get; set; }
    }
}
