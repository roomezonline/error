    protected override async Task OnInitializedAsync()
    {
        // For readonly mode, validate the token first
        if (IsReadOnly)
        {
            if (string.IsNullOrWhiteSpace(ShareToken))
            {
                _monitoringEnded = true;
                return;
            }
            // Inject parameters from token
            try
            {
                var info = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>(
                    $"api/monitoring/share/connection-info?token={ShareToken}");
                if (info.ValueKind == System.Text.Json.JsonValueKind.Undefined)
                {
                    _monitoringEnded = true;
                    return;
                }
                if (info.TryGetProperty("id", out var idProp))
                    Id = idProp.GetInt32();
                if (info.TryGetProperty("customerReceiptId", out var crIdProp))
                    CustomerReceiptId = crIdProp.GetInt32();
                if (info.TryGetProperty("customerName", out var cnProp))
                    CustomerName = cnProp.GetString() ?? "";
                if (info.TryGetProperty("customerMobile", out var cmProp))
                    CustomerMobile = cmProp.GetString() ?? "";
                if (info.TryGetProperty("deviceTitle", out var dtProp))
                    DeviceTitle = dtProp.GetString() ?? "";
                if (info.TryGetProperty("deviceCode", out var dcProp))
                    Code = dcProp.GetString() ?? "";
                if (info.TryGetProperty("workshopName", out var wnProp))
                    WorkshopName = wnProp.GetString() ?? "";
                if (info.TryGetProperty("createdAtFa", out var caProp))
                    CreatedAtFa = caProp.GetString() ?? "";
                if (info.TryGetProperty("createdByUserName", out var cuProp))
                    CreatedByUserName = cuProp.GetString() ?? "";
                if (info.TryGetProperty("endedAt", out var eaProp) && eaProp.ValueKind == System.Text.Json.JsonValueKind.String)
                    _monitoringEnded = true;
            }
            catch
            {
                _monitoringEnded = true;
                return;
            }
        }
        else
        {
            // Redirect if no device code or monitoring id provided
            if (Id == 0 && string.IsNullOrWhiteSpace(Code))
            {
                Navigation.NavigateTo("/admin/monitoring/active-receipts", replace: true);
                return;
            }
        }

        // Initialize flow chart with flat baseline
        _graphFlowMax = GraphMax;
        _graphFlowMin = GraphMin;
        for (var i = 0; i < FlowCount; i++) flowData.Add(0);
        UpdateFlowPath();

        // Fetch data immediately once
        await FetchLatest();
        if (!IsReadOnly) await FetchCycles();

        // Load history for default graph source (doesn't depend on live data)
        if (!string.IsNullOrWhiteSpace(Code))
            await LoadHistoryAsync(_graphSource, GraphValue);

        if (!IsReadOnly)
        {
            // Check if settings file exists (blocking if missing)
            await CheckSettings();

            await FetchAlertCount();
            await CheckMonitoringStatus();

            await LoadShareStatusAsync();
        }

        // Fetch chart base URL — needed for both admin and shared views
        try
        {
            var settings = await Http.GetFromJsonAsync<SiteSettingsDto>("api/sitesettings");
            if (settings != null && !string.IsNullOrWhiteSpace(settings.ChartBaseUrl))
                _chartBaseUrl = settings.ChartBaseUrl.TrimEnd('/');
        }
        catch { }

        // Start warning countdown timer
        if (_showWarning)
        {
            _countdownSec = 5;
            _countdownTimer?.Dispose();
            _countdownTimer = new Timer(async _ =>
            {
                if (_disposed) return;
                if (_countdownSec <= 0) return;

                _countdownSec -= 0.05;
                if (_countdownSec < 0) _countdownSec = 0;
                await InvokeAsync(StateHasChanged);

                if (_countdownSec <= 0)
                {
                    var timer = Interlocked.Exchange(ref _countdownTimer, null);
                    timer?.Dispose();
                    DismissWarning();
                }
            }, null, 0, 50);
        }

        // Then poll every 2 seconds
        _timer = new Timer(async _ =>
        {
            if (_disposed) return;
            await FetchLatest();
            if (!IsReadOnly) await FetchCycles();
            await RefreshChangeLogs();
            if (!IsReadOnly) { await FetchAlertCount(); await FetchViewers(); }

            // Check command timeout (30 seconds) — admin only
            if (!IsReadOnly && _pendingCommandValue != null && _pendingCommandTime.HasValue &&
                (DateTime.UtcNow - _pendingCommandTime.Value).TotalSeconds > 30)
            {
                _pendingCommandValue = null;
                _pendingCommandTime = null;
                StopProgressTimer();
            }

            // Check connection timeout
            var timeoutSecs = Math.Max(10, _timeoutMinutes * 60);
            if (_connected && (DateTime.UtcNow - _lastDataTime).TotalSeconds > timeoutSecs)
            {
                _connected = false;
                _lastUpdateFa = "---";
                ResetValues();
            }

            await InvokeAsync(StateHasChanged);
        }, null, 2000, 2000);

        // Elapsed time label updater + periodic status check (every 10 seconds)
        var _statusCheckCount = 0;
        _elapsedTimer = new Timer(async _ =>
        {
            if (_disposed) return;
            UpdateElapsedLabels();
            // Refresh monitoring status every 30 seconds (3rd tick)
            _statusCheckCount++;
            if (_statusCheckCount % 3 == 0 && !IsReadOnly && Id > 0)
            {
                try { await CheckMonitoringStatus(); } catch { }
            }
            await InvokeAsync(StateHasChanged);
        }, null, 10000, 10000);
    }

    private async Task FetchLatest()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(Code)) return;

            BlinkSend();

            var url = IsReadOnly
                ? $"{ApiPrefix}/data?token={ShareToken}"
                : $"api/monitoring/latest?code={Code}";
            var data = await Http.GetFromJsonAsync<MonitoringDeviceData>(url);
            if (data == null) return;

            _dataInit = true;
            _lastDataTime = data.FileWriteTime > DateTime.MinValue ? data.FileWriteTime : data.Timestamp;

            // No data file and no cache → device is offline
            if (_lastDataTime == DateTime.MinValue)
            {
                _connected = false;
                _lastUpdateFa = "---";
                ResetValues();
                return;
            }

            _connected = true;
            _lastUpdateFa = !string.IsNullOrEmpty(data.FileWriteTimeFa) ? data.FileWriteTimeFa : data.TimestampFa;
            BlinkReceive();

            var v = ParseDouble(data.Voltage);
            voltageCurrent = v.GetValueOrDefault();

            ringCurrent = 0;
            if (!string.IsNullOrWhiteSpace(data.Jaryan))
            {
                var parts = data.Jaryan.Split('-', StringSplitOptions.RemoveEmptyEntries);
                var maxJ = double.MinValue;
                foreach (var p in parts)
                {
                    var parsed = ParseDouble(p.Trim());
                    if (parsed.HasValue && parsed.Value > maxJ)
                        maxJ = parsed.Value;
                }
                if (maxJ > double.MinValue)
                    ringCurrent = maxJ;
            }

            var tavanParsed = ParseDouble(data.Tavan);
            powerCurrent = tavanParsed.GetValueOrDefault(voltageCurrent * ringCurrent);

            v = ParseDouble(data.Temp1);
            tertiaryTemp = v.HasValue && v.Value > -120 ? v.Value : 0;

            v = ParseDouble(data.Temp2);
            ambientTemp = v.HasValue && v.Value > -120 ? v.Value : 0;

            v = ParseDouble(data.Temp3);
            secondaryTemp = v.HasValue && v.Value > -120 ? v.Value : 0;

            mainPowerOn = data.Priz?.Trim().ToLower() == "on";
            if (_pendingCommandValue != null)
            {
                var currentPriz = data.Priz?.Trim().ToLower();
                if (currentPriz == _pendingCommandValue)
                {
                    _pendingProgress = 100;
                    _pendingCommandValue = null;
                    _pendingCommandTime = null;
                    StopProgressTimer();
                }
            }
            motorOn = IsOn(data.MotorState);
            _motorTypeFromServer = data.Inverter?.Trim().ToLower() == "true" ? "اینورتر" : "ساده";
            _sensorTypeFromServer = data.CurrentType?.Trim().ToLower() switch
            {
                "circle" or "loop" => "حلقه‌ای",
                "clamp" => "کلمپی",
                _ => data.CurrentType ?? ""
            };
            h1On = IsOn(data.Element1);
            h2On = IsOn(data.Element2);
            // Read element start/stop temps from server response
            double.TryParse(data.E1StartFridge, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _e1StartFridge);
            double.TryParse(data.E1StopFridge, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _e1StopFridge);
            double.TryParse(data.E1StartFreezer, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _e1StartFreezer);
            double.TryParse(data.E1StopFreezer, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _e1StopFreezer);
            double.TryParse(data.E2StartFridge, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _e2StartFridge);
            double.TryParse(data.E2StopFridge, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _e2StopFridge);
            double.TryParse(data.E2StartFreezer, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _e2StartFreezer);
            double.TryParse(data.E2StopFreezer, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out _e2StopFreezer);
            sendOn = IsOn(data.Dc1) || IsOn(data.Ac1);
            receiveOn = IsOn(data.Dc2) || IsOn(data.Ac2);

            // Flow chart from selected graph source
            flowValue = GraphValue;
            _graphFlowMax = GraphMax;
            _graphFlowMin = GraphMin;

            if (!_historyLoading)
            {
                flowData.Add(flowValue);
                if (flowData.Count > FlowCount)
                {
                    var removeIdx = _historyCount > 0 ? _historyCount : 0;
                    flowData.RemoveAt(removeIdx);
                }
                UpdateFlowPath();
            }
        }
        catch
        {
            if (_connected)
            {
                _connected = false;
                _lastUpdateFa = "---";
                ResetValues();
            }
        }
    }

