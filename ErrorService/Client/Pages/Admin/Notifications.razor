    protected override async Task OnInitializedAsync()
    {
        try
        {
            var st = await AuthState.GetAuthenticationStateAsync();
            canManageRules = st.User?.Identity?.IsAuthenticated == true
                && (st.User.HasClaim("perm", "admin.notifications.manage") || st.User.IsInRole("super_admin"));
        }
        catch { canManageRules = false; }
        await Load();
