@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Utils
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JSRuntime

@if (stories != null && stories.Any())
{
    <div class="stories-container-wrapper">
        <div class="stories-scroll">
            @foreach (var story in stories)
            {
                <div class="story-circle-item" @onclick="() => OpenStory(story)">
                    <div class="story-ring @(viewedStoryIds.Contains(story.Id) ? "viewed" : "")">
                        <div class="story-avatar">
                            @if (story.IsVideo)
                            {
                                <div class="media-placeholder bg-dark">
                                    <video data-src="@story.MediaUrl#t=0.5" preload="metadata" 
                                           class="video-thumbnail lazy-video" muted playsinline></video>
                                    <div class="video-overlay">
                                        <span class="oi oi-play text-white"></span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <img src="@story.MediaUrl" loading="lazy" alt="@story.Title" />
                            }
                        </div>
                    </div>
                    <span class="story-name">@(string.IsNullOrWhiteSpace(story.Title) ? "استوری" : story.Title)</span>
                </div>
            }
        </div>
    </div>
}

@if (showViewer && currentStory != null)
{
    <div class="story-viewer-overlay animate__animated animate__fadeIn"
         @onmousedown="PauseStory" @onmouseup="ResumeStory" @onmouseleave="ResumeStory"
         @ontouchstart="PauseStory" @ontouchend="ResumeStory" @ontouchcancel="ResumeStory">
        <div class="story-viewer-content">
            <!-- Progress Bars -->
            <div class="story-progress-container">
                @for (int i = 0; i < stories.Count; i++)
                {
                    <div class="story-progress-bar-bg">
                        <div class="story-progress-bar-fill" 
                             style="width: @(i < currentIndex ? "100%" : (i == currentIndex ? progressPercentage + "%" : "0%"))">
                        </div>
                    </div>
                }
            </div>

            <!-- Header -->
            <div class="story-header p-3 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="story-header-avatar">
                        <img src="/favicon.ico" alt="Logo" />
                    </div>
                    <div>
                        <div class="text-white fw-bold shadow-sm lh-1">ارور سرویس</div>
                        <div class="text-white-50 small shadow-sm" dir="ltr" style="font-size: 0.65rem;">@PersianDate.ToJalaliDateTime(currentStory.CreatedAt)</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-link text-white p-1" title="اشتراک گذاری" @onclick="ShareStory" @onclick:stopPropagation>
                        <span class="oi oi-share"></span>
                    </button>
                    <button class="btn-close btn-close-white" @onclick="CloseViewer" @onclick:stopPropagation></button>
                </div>
            </div>

            <!-- Media -->
            <div class="story-media-container" @onclick="HandleMediaClick">
                @if (currentStory.IsVideo)
                {
                    <video id="storyVideo" src="@currentStory.MediaUrl" autoplay playsinline @onended="NextStory"></video>
                }
                else
                {
                    <img src="@currentStory.MediaUrl" alt="Story Content" />
                }
            </div>

            <!-- Bottom Caption & Actions -->
            <div class="story-bottom-panel">
                @if (!string.IsNullOrWhiteSpace(currentStory.Title))
                {
                    <div class="story-caption animate__animated animate__slideInUp">
                        @currentStory.Title
                    </div>
                }

                <div class="story-actions-row">
                    <div class="d-flex align-items-center gap-2">
                        <div class="story-views-chip">
                            <span class="oi oi-eye me-1"></span>
                            @currentStory.ViewCount
                        </div>
                        <button class="story-like-btn @(IsLiked(currentStory.Id) ? "liked" : "")" 
                                @onclick="ToggleLike" @onclick:stopPropagation
                                title="@(IsLiked(currentStory.Id) ? "لغو لایک" : "لایک")">
                            <svg class="story-heart" viewBox="0 0 24 24" width="24" height="24">
                                <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                                      fill="@(IsLiked(currentStory.Id) ? "#ff3040" : "none")"
                                      stroke="@(IsLiked(currentStory.Id) ? "#ff3040" : "#fff")"
                                      stroke-width="1.5"/>
                            </svg>
                            <span class="story-like-count">@currentStory.LikeCount</span>
                        </button>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(currentStory.LinkUrl))
                    {
                        <a href="@currentStory.LinkUrl" class="btn btn-light rounded-pill px-4 fw-bold shadow-lg btn-sm">
                            مشاهده بیشتر
                            <span class="oi oi-chevron-top ms-2 small"></span>
                        </a>
                    }
                </div>
            </div>

            <!-- Navigation Areas -->
            <div class="story-nav-prev" @onclick="PrevStory" @onclick:stopPropagation></div>
            <div class="story-nav-next" @onclick="NextStory" @onclick:stopPropagation></div>
        </div>
    </div>
}

<style>
    .stories-container-wrapper {
        width: 100%;
        overflow: hidden;
        padding: 15px 0;
        background: var(--app-surface);
        border-bottom: 1px solid var(--app-border);
        margin-bottom: 1rem;
    }

    .stories-scroll {
        display: flex;
        gap: 15px;
        overflow-x: auto;
        padding: 0 15px;
        scrollbar-width: none;
        -ms-overflow-style: none;
    }

    .stories-scroll::-webkit-scrollbar { display: none; }

    .story-circle-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        flex-shrink: 0;
    }

    .story-ring {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        padding: 3px;
        background: linear-gradient(45deg, #f09433 0%, #e6683c 25%, #dc2743 50%, #cc2366 75%, #bc1888 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s;
    }

    .story-ring.viewed {
        background: #e2e8f0;
    }

    .story-circle-item:active .story-ring { transform: scale(0.92); }

    .story-avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        border: 2px solid var(--app-surface);
        overflow: hidden;
        background: #f8fafc;
    }

    .story-avatar img, .video-thumbnail {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .video-thumbnail {
        filter: brightness(0.8);
    }

    .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0,0,0,0.1);
        z-index: 2;
    }

    .video-overlay .oi {
        font-size: 0.8rem;
        opacity: 0.8;
    }

    .media-placeholder { 
        display: grid; 
        place-items: center; 
        position: relative;
        width: 100%;
        height: 100%;
    }

    .story-name {
        font-size: 0.72rem;
        font-weight: 700;
        max-width: 75px;
        text-wrap: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--app-text);
    }

    /* Viewer */
    .story-viewer-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: #000;
        z-index: 10000;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .story-viewer-content {
        position: relative;
        width: 100%;
        height: 100%;
        background: #111;
        display: flex;
        flex-direction: column;
    }

    .story-progress-container {
        position: absolute;
        top: 10px;
        left: 10px;
        right: 10px;
        display: flex;
        gap: 4px;
        z-index: 5;
    }

    .story-progress-bar-bg {
        flex: 1;
        height: 2px;
        background: rgba(255,255,255,0.3);
        border-radius: 2px;
        overflow: hidden;
    }

    .story-progress-bar-fill {
        height: 100%;
        background: #fff;
        width: 0;
        transition: width linear;
    }

    .story-header {
        position: absolute;
        top: 20px;
        left: 0;
        right: 0;
        z-index: 4;
        background: linear-gradient(to bottom, rgba(0,0,0,0.6), transparent);
    }

    .story-header-avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        overflow: hidden;
        border: 1px solid #fff;
    }

    .story-header-avatar img { width:100%; height:100%; object-fit: cover; }

    .story-media-container {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #000;
        overflow: hidden;
    }

    .story-media-container img, .story-media-container video {
        max-width: 100%;
        max-height: 100%;
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    .story-bottom-panel {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        padding: 40px 20px 30px;
        background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, rgba(0,0,0,0.4) 60%, transparent 100%);
        z-index: 4;
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .story-caption {
        color: #fff;
        font-size: 0.95rem;
        text-align: center;
        line-height: 1.5;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
        white-space: pre-wrap;
    }

    .story-actions-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .story-views-chip {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        color: #fff;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.75rem;
        display: flex;
        align-items: center;
    }

    .story-nav-prev, .story-nav-next {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 25%;
        z-index: 3;
    }
    .story-nav-prev { left: 0; }
    .story-nav-next { right: 0; }

    .story-like-btn {
        background: rgba(255,255,255,0.15);
        backdrop-filter: blur(10px);
        border: none;
        border-radius: 20px;
        padding: 4px 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
        transition: transform 0.2s, background 0.2s;
        touch-action: manipulation;
    }

    .story-like-btn:active {
        transform: scale(0.9);
    }

    .story-like-btn.liked {
        background: rgba(255,48,64,0.2);
    }

    .story-heart {
        display: block;
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .story-like-btn.liked .story-heart {
        animation: storyHeartPop 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    @@keyframes storyHeartPop {
        0% { transform: scale(1); }
        50% { transform: scale(1.3); }
        100% { transform: scale(1); }
    }

    .story-like-count {
        color: #fff;
        font-size: 0.75rem;
        font-weight: 600;
        min-width: 8px;
        text-align: center;
    }

    @@media (min-width: 992px) {
        .story-viewer-content {
            max-width: none;
        }
    }
</style>

@code {
    private List<StoryDto> stories = new();
    private HashSet<int> viewedStoryIds = new();
    private HashSet<int> likedStoryIds = new();
    private bool showViewer;
    private int currentIndex;
    private StoryDto? currentStory => (currentIndex >= 0 && currentIndex < stories.Count) ? stories[currentIndex] : null;
    
    private double progressPercentage = 0;
    private double accumulatedMs = 0;
    private bool isPaused;
    private System.Timers.Timer? timer;
    private DateTime startTime;
    private const string ViewStorageKey = "viewed_stories";
    private const string LikeStorageKey = "liked_stories";

    protected override async Task OnInitializedAsync()
    {
        try {
            stories = await Http.GetFromJsonAsync<List<StoryDto>>("api/stories") ?? new();
        } catch { }
        await LoadViewedStoriesAsync();
        await LoadLikedStoriesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                await JSRuntime.InvokeVoidAsync("lazyVideoLoader.observe");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"LazyVideoLoader Error: {ex.Message}");
            }
        }
    }

    private bool IsLiked(int storyId) => likedStoryIds.Contains(storyId);

    private async Task OpenStory(StoryDto story)
    {
        currentIndex = stories.IndexOf(story);
        viewedStoryIds.Add(story.Id);
        await SaveViewedStoriesAsync();
        showViewer = true;
        await IncrementView(story.Id);
        StartStoryTimer();
    }

    private async Task IncrementView(int storyId)
    {
        try {
            await Http.PostAsync($"api/stories/{storyId}/view", null);
            var s = stories.FirstOrDefault(x => x.Id == storyId);
            if (s != null) s.ViewCount++;
        } catch { }
    }

    private void StartStoryTimer()
    {
        timer?.Stop();
        timer?.Dispose();

        progressPercentage = 0;
        accumulatedMs = 0;
        isPaused = false;
        startTime = DateTime.Now;

        timer = new System.Timers.Timer(50);
        timer.Elapsed += async (s, e) =>
        {
            if (isPaused) return;

            var duration = (currentStory?.DisplayDuration ?? 5) * 1000.0;
            accumulatedMs += (DateTime.Now - startTime).TotalMilliseconds;
            startTime = DateTime.Now;
            progressPercentage = (accumulatedMs / duration) * 100;

            if (accumulatedMs >= duration)
            {
                timer.Stop();
                await InvokeAsync(NextStory);
            }
            else
            {
                await InvokeAsync(StateHasChanged);
            }
        };
        timer.Start();
    }

    private void PauseStory()
    {
        if (timer == null || isPaused) return;
        timer.Stop();
        accumulatedMs += (DateTime.Now - startTime).TotalMilliseconds;
        isPaused = true;

        if (currentStory?.IsVideo == true)
        {
            try { JSRuntime.InvokeVoidAsync("eval", "document.getElementById('storyVideo')?.pause()"); } catch { }
        }
    }

    private void ResumeStory()
    {
        if (timer == null || !isPaused) return;
        startTime = DateTime.Now;
        isPaused = false;
        timer.Start();

        if (currentStory?.IsVideo == true)
        {
            try { JSRuntime.InvokeVoidAsync("eval", "document.getElementById('storyVideo')?.play()"); } catch { }
        }
    }

    private async Task NextStory()
    {
        if (currentIndex < stories.Count - 1)
        {
            currentIndex++;
            viewedStoryIds.Add(currentStory!.Id);
            await SaveViewedStoriesAsync();
            await IncrementView(currentStory.Id);
            StartStoryTimer();
        }
        else
        {
            CloseViewer();
        }
        StateHasChanged();
    }

    private void PrevStory()
    {
        if (currentIndex > 0)
        {
            currentIndex--;
            StartStoryTimer();
        }
        else
        {
            StartStoryTimer();
        }
        StateHasChanged();
    }

    private void CloseViewer()
    {
        timer?.Stop();
        timer?.Dispose();
        showViewer = false;
        StateHasChanged();
    }

    private void HandleMediaClick()
    {
        // Instagram style: tap to pause/resume could be added here
    }

    private async Task ToggleLike()
    {
        if (currentStory == null) return;
        var id = currentStory.Id;

        try
        {
            var response = await Http.PostAsync($"api/stories/{id}/like", null);
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<LikeResult>();
                if (result != null)
                {
                    if (result.Liked)
                        likedStoryIds.Add(id);
                    else
                        likedStoryIds.Remove(id);

                    currentStory.LikeCount = result.LikeCount;
                    await SaveLikedStoriesAsync();
                    StateHasChanged();
                }
            }
        }
        catch { }
    }

    private async Task ShareStory()
    {
        if (currentStory == null) return;
        
        var shareUrl = Nav.BaseUri;
        var text = $"استوری ارور سرویس: {currentStory.Title}";
        
        try {
            await JSRuntime.InvokeVoidAsync("navigator.share", new {
                title = "ارور سرویس",
                text = text,
                url = shareUrl
            });
        } catch {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", shareUrl);
        }
    }

    private async Task LoadViewedStoriesAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", ViewStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var ids = System.Text.Json.JsonSerializer.Deserialize<List<int>>(json);
                if (ids != null)
                {
                    foreach (var id in ids)
                        viewedStoryIds.Add(id);
                }
            }
        }
        catch { }
    }

    private async Task SaveViewedStoriesAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(viewedStoryIds.ToList());
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", ViewStorageKey, json);
        }
        catch { }
    }

    private async Task LoadLikedStoriesAsync()
    {
        try
        {
            var json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", LikeStorageKey);
            if (!string.IsNullOrWhiteSpace(json))
            {
                var ids = System.Text.Json.JsonSerializer.Deserialize<List<int>>(json);
                if (ids != null)
                {
                    foreach (var id in ids)
                        likedStoryIds.Add(id);
                }
            }
        }
        catch { }
    }

    private async Task SaveLikedStoriesAsync()
    {
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(likedStoryIds.ToList());
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", LikeStorageKey, json);
        }
        catch { }
    }

    private sealed class LikeResult
    {
        public bool Liked { get; set; }
        public int LikeCount { get; set; }
    }
}
