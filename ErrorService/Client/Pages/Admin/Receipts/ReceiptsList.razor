    private async Task ToggleCsReceiptExpand(CustomerReceiptDto item)
    {
        if (csExpandedReceiptId == item.Id)
        {
            csExpandedReceiptId = null;
            return;
        }

        csExpandedReceiptId = item.Id;
        if (!billingCache.ContainsKey(item.Id))
        {
            csLoadingDetailsReceiptId = item.Id;
            await InvokeAsync(StateHasChanged);
            try
            {
                var qs = WorkshopQs();
                var billing = await Http.GetFromJsonAsync<CustomerReceiptBillingDto>($"api/customer-receipts/{item.Id}/billing{qs}");
                if (billing != null)
                {
                    billingCache[item.Id] = billing;
                }
            }
            catch { }
            finally
            {
                csLoadingDetailsReceiptId = null;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

