@page "/admin/monitoring/progressive-chart/{MonitoringConnectionId:int}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.monitoring.view")]
@using System.Net.Http.Json
@using ErrorService.Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IDisposable

@if (!IsOverlay)
{
    <PageTitle>@_pageTitle</PageTitle>
}

<div class="dpc-page" dir="ltr">
    <div class="dpc-header">
        <button class="dpc-back" @onclick="GoBack" title="بازگشت">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="dpc-title-group">
            <div class="dpc-kicker">Progressive Detail Chart</div>
            <div class="dpc-title">@_pageTitle</div>
        </div>
        <div class="dpc-header-actions">
            <span class="dpc-badge" id="dpc-zoom-info">@_dataCount records</span>
            <span class="dpc-badge dpc-badge--zoom" id="dpc-zoom-pct">100%</span>
        </div>
    </div>

    @if (_loading)
    {
        <div class="dpc-skeleton">
            <div class="dpc-skel-legend"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <div class="dpc-skel-chart"><span></span></div>
        </div>
    }
    else if (_error != null)
    {
        <div class="dpc-error">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <h3>خطا در دریافت اطلاعات</h3>
            <p>@_error</p>
            <button class="dpc-retry-btn" @onclick="LoadData">تلاش مجدد</button>
        </div>
    }
    else if (_data != null)
    {
        @* Client Info *@
        @if (_data.ConnectionInfo != null)
        {
            <div class="dpc-client" dir="rtl">
                <div class="dpc-client__row">
                    <div class="dpc-client__item">
                        <span class="dpc-client__icon dpc-client__icon--user">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        <span class="dpc-client__value">@_data.ConnectionInfo.CustomerName</span>
                    </div>
                    <div class="dpc-client__item">
                        <span class="dpc-client__icon dpc-client__icon--phone">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </span>
                        <span class="dpc-client__value ltr" dir="ltr">@_data.ConnectionInfo.CustomerMobile</span>
                    </div>
                    <div class="dpc-client__item">
                        <span class="dpc-client__icon dpc-client__icon--device">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        </span>
                        <span class="dpc-client__value">@_data.ConnectionInfo.DeviceName</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_data.ConnectionInfo.DeviceTypeName))
                {
                    <div class="dpc-client__tags">
                        <span class="dpc-client__tag">@_data.ConnectionInfo.DeviceTypeName</span>
                        @if (!string.IsNullOrEmpty(_data.ConnectionInfo.DeviceBrandName))
                        {
                            <span class="dpc-client__tag dpc-client__tag--brand">@_data.ConnectionInfo.DeviceBrandName</span>
                        }
                    </div>
                }
            </div>
        }

        @* Controls *@
        <div class="dpc-controls">
            <div class="dpc-mode-switch" role="tablist" aria-label="حالت نمایش چارت">
                <button id="dpc-mode-overview" class="dpc-mode-btn is-active" type="button" data-chart-mode="overview">نمای کلی + زوم</button>
                <button id="dpc-mode-progressive" class="dpc-mode-btn" type="button" data-chart-mode="progressive">نمایش تدریجی</button>
            </div>
            <button id="dpc-reset-zoom" class="dpc-btn" @onclick="ResetZoom" title="ریست زوم / بازگشت به بازه کامل">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                ریست
            </button>
            <button id="dpc-span-tool" class="dpc-btn" type="button" title="اندازه‌گیری بازه: کلیک نگه‌دار و بکش">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"/><path d="M6 8v8"/><path d="M10 9v6"/><path d="M14 8v8"/><path d="M18 9v6"/><path d="M22 10v4"/></svg>
                بازه زمانی
            </button>
            <div class="dpc-live" id="dpc-live">
                <label class="dpc-live-switch" title="بروزرسانی زنده هر ۱۰ ثانیه">
                    <input type="checkbox" id="dpc-live-toggle" />
                    <span class="dpc-live-slider"></span>
                </label>
                <span class="dpc-live-label">بروزرسانی زنده</span>
                <span class="dpc-live-count" id="dpc-live-countdown" hidden></span>
            </div>
            <div class="dpc-hint">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                دسکتاپ: Ctrl + کشیدن برای انتخاب · ابزار بازه: کلیک نگه‌دار و بکش
            </div>
        </div>
        <div id="dpc-progressive-nav" class="dpc-progressive-nav" hidden>
            <button id="dpc-segment-next" class="dpc-segment-btn dpc-segment-btn--next" type="button" title="بازه بعدی (+۱۲ ساعت)">
                <svg class="dpc-seg-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
                +۱۲ ساعت
            </button>
            <span id="dpc-segment-status">بازه —</span>
            <button id="dpc-segment-prev" class="dpc-segment-btn dpc-segment-btn--prev" type="button" title="بازه قبلی (−۱۲ ساعت)">
                <svg class="dpc-seg-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                −۱۲ ساعت
            </button>
        </div>

        @* Legend + Equipment Navigation *@
        <div class="dpc-legend" id="dpc-legend">
            @* Temperature (always visible, no nav) *@
            <button class="dpc-legend-item" type="button" data-ds-idx="0" style="--dpc-c:#0ea5e9">یخچال</button>
            <button class="dpc-legend-item" type="button" data-ds-idx="1" style="--dpc-c:#e11d48">فریزر</button>
            @* Equipment: toggle + prev + next *@
            <span class="dpc-eq-set" data-eq-ds="2">
                <button class="dpc-legend-item dpc-legend-item--off double-toggle" type="button" data-ds-idx="2" style="--dpc-c:#eab308" title="نمایش/مخفی کردن برق">برق</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--prev" data-dir="prev" title="انتقال به قبلی">−</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--next" data-dir="next" title="انتقال به بعدی">+</button>
            </span>
            <span class="dpc-eq-set" data-eq-ds="3">
                <button class="dpc-legend-item double-toggle" type="button" data-ds-idx="3" style="--dpc-c:#10b981" title="نمایش/مخفی کردن موتور">موتور</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--prev" data-dir="prev" title="انتقال به قبلی">−</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--next" data-dir="next" title="انتقال به بعدی">+</button>
            </span>
            <span class="dpc-eq-set" data-eq-ds="4">
                <button class="dpc-legend-item dpc-legend-item--off double-toggle" type="button" data-ds-idx="4" style="--dpc-c:#f97316" title="نمایش/مخفی کردن المنت ۱">المنت ۱</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--prev" data-dir="prev" title="انتقال به قبلی">−</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--next" data-dir="next" title="انتقال به بعدی">+</button>
            </span>
            <span class="dpc-eq-set" data-eq-ds="5">
                <button class="dpc-legend-item dpc-legend-item--off double-toggle" type="button" data-ds-idx="5" style="--dpc-c:#ef4444" title="نمایش/مخفی کردن المنت ۲">المنت ۲</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--prev" data-dir="prev" title="انتقال به قبلی">−</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--next" data-dir="next" title="انتقال به بعدی">+</button>
            </span>
            @* Power items (no nav) *@
            <button class="dpc-legend-item dpc-legend-item--off" type="button" data-ds-idx="6" style="--dpc-c:#8b5cf6">توان</button>
            <button class="dpc-legend-item dpc-legend-item--off" type="button" data-ds-idx="7" style="--dpc-c:#ec4899">جریان</button>
        </div>

        @* Chart - JS builds everything inside this container *@
        <div class="dpc-chart-stage">
            <div id="dpc-chart-root"></div>
            <div id="dpc-span-hud" class="dpc-span-hud" hidden>
                <div class="dpc-span-hud__meta" id="dpc-span-meta"></div>
                <button type="button" id="dpc-span-clear" class="dpc-span-hud__clear" title="پاک کردن بازه">پاک</button>
            </div>
        </div>
    }
</div>

<style>
    .dpc-page {
        background: #f8fafc; min-height: 100vh; display: flex; flex-direction: column;
        font-family: Vazirmatn, sans-serif; direction: ltr;
        max-width: 100%; overflow-x: hidden;
    }
    .dpc-page > * { min-width: 0; }
    .dpc-header {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 20px; background: #fff; border-bottom: 1px solid #e2e8f0;
        position: sticky; top: 0; z-index: 10;
    }
    .dpc-back {
        width: 36px; height: 36px; border-radius: 10px; border: 1px solid #e2e8f0;
        background: #fff; display: grid; place-items: center; cursor: pointer;
        color: #475569; flex-shrink: 0;
    }
    .dpc-back:hover { background: #f1f5f9; }
    .dpc-title-group { flex: 1; min-width: 0; }
    .dpc-kicker { font-size: 11px; color: #94a3b8; font-weight: 700; letter-spacing: 0.3px; }
    .dpc-title { font-size: 17px; font-weight: 800; color: #0f172a; }
    .dpc-header-actions { display: flex; gap: 8px; align-items: center; }
    .dpc-badge {
        font-size: 12px; font-weight: 800; color: #475569;
        background: #f1f5f9; padding: 4px 12px; border-radius: 20px;
        white-space: nowrap;
    }
    .dpc-badge--zoom { background: #eef2ff; color: #4f46e5; }

    .dpc-skeleton { padding: 20px; }
    .dpc-skel-legend { display: flex; gap: 8px; margin-bottom: 14px; }
    .dpc-skel-legend span {
        width: 56px; height: 32px; border-radius: 10px; background: #e2e8f0; animation: dpc-shimmer 1.5s infinite;
    }
    .dpc-skel-chart span {
        display: block; height: 400px; border-radius: 16px; background: #e2e8f0; animation: dpc-shimmer 1.5s infinite;
    }
    @@keyframes dpc-shimmer {
        0% { opacity: 0.6; } 50% { opacity: 1; } 100% { opacity: 0.6; }
    }

    .dpc-error {
        text-align: center; padding: 60px 20px; color: #475569; direction: rtl;
    }
    .dpc-error h3 { margin: 16px 0 8px; font-size: 18px; }
    .dpc-error p { font-size: 14px; color: #94a3b8; margin-bottom: 20px; }
    .dpc-retry-btn {
        padding: 10px 28px; border: none; border-radius: 12px; background: #2563eb;
        color: #fff; font-weight: 800; cursor: pointer; font-size: 14px;
    }

    .dpc-loading {
        display: flex; align-items: center; justify-content: center; gap: 10px;
        padding: 10px; background: #fffbeb; border-bottom: 1px solid #fde68a;
        font-size: 13px; font-weight: 700; color: #92400e; direction: rtl;
    }
    .dpc-loading__spinner {
        width: 18px; height: 18px; border: 2.5px solid #fbbf24;
        border-top-color: #d97706; border-radius: 50%; animation: dpc-spin 0.7s linear infinite;
    }
    @@keyframes dpc-spin { to { transform: rotate(360deg); } }

    .dpc-chart-loading {
        display: none; position: absolute; z-index: 20; top: 50%; left: 50%;
        transform: translate(-50%, -50%); pointer-events: none;
        align-items: center; justify-content: center; width: min(310px, calc(100vw - 36px));
    }
    .dpc-chart-loading__card {
        display: flex; align-items: center; gap: 12px; width: 100%; box-sizing: border-box;
        padding: 13px 16px; border: 1px solid rgba(255,255,255,.82); border-radius: 16px;
        background: rgba(255,255,255,.82); box-shadow: 0 12px 34px rgba(15,23,42,.16),
            0 2px 8px rgba(14,165,233,.10); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    }
    .dpc-chart-loading__icon {
        display: grid; place-items: center; width: 34px; height: 34px; flex: 0 0 34px;
        border-radius: 11px; background: linear-gradient(135deg, #0ea5e9, #6366f1);
        box-shadow: 0 5px 12px rgba(14,165,233,.28); position: relative;
    }
    .dpc-chart-loading__icon::before, .dpc-chart-loading__icon::after,
    .dpc-chart-loading__icon span {
        content: ''; position: absolute; bottom: 9px; width: 3px; border-radius: 3px;
        background: rgba(255,255,255,.95); transform-origin: bottom; animation: dpc-bars 1s ease-in-out infinite;
    }
    .dpc-chart-loading__icon::before { height: 9px; left: 9px; animation-delay: -.2s; }
    .dpc-chart-loading__icon span { height: 15px; left: 15px; animation-delay: -.05s; }
    .dpc-chart-loading__icon::after { height: 11px; left: 21px; animation-delay: .12s; }
    @@keyframes dpc-bars { 0%, 100% { transform: scaleY(.55); opacity: .65; } 50% { transform: scaleY(1); opacity: 1; } }
    .dpc-chart-loading__copy { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; text-align: right; }
    .dpc-chart-loading__copy strong { color: #0f172a; font-size: 12px; font-weight: 900; }
    .dpc-chart-loading__copy small { color: #64748b; font-size: 10px; font-weight: 600; white-space: nowrap; }
    .dpc-chart-loading__dots { display: flex; align-items: center; gap: 3px; direction: ltr; }
    .dpc-chart-loading__dots i { width: 4px; height: 4px; border-radius: 50%; background: #0ea5e9; animation: dpc-dot 1.1s infinite ease-in-out; }
    .dpc-chart-loading__dots i:nth-child(2) { animation-delay: .15s; background: #6366f1; }
    .dpc-chart-loading__dots i:nth-child(3) { animation-delay: .3s; background: #a855f7; }
    @@keyframes dpc-dot { 0%, 60%, 100% { transform: translateY(0); opacity: .35; } 30% { transform: translateY(-4px); opacity: 1; } }

    .dpc-client {
        margin: 12px 20px 0; background: #fff; border-radius: 14px;
        padding: 14px 18px; border: 1px solid #e2e8f0;
    }
    .dpc-client__row { display: flex; flex-wrap: wrap; gap: 12px 20px; }
    .dpc-client__item { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #334155; font-weight: 700; }
    .dpc-client__icon {
        width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; flex-shrink: 0;
    }
    .dpc-client__icon--user { background: #dbeafe; color: #2563eb; }
    .dpc-client__icon--phone { background: #dcfce7; color: #16a34a; }
    .dpc-client__icon--device { background: #f3e8ff; color: #9333ea; }
    .dpc-client__value { direction: rtl; }
    .dpc-client__tags { display: flex; gap: 6px; margin-top: 10px; }
    .dpc-client__tag {
        font-size: 11px; font-weight: 800; padding: 3px 10px; border-radius: 8px;
        background: #f1f5f9; color: #475569;
    }
    .dpc-client__tag--brand { background: #fff7ed; color: #c2410c; }

    .dpc-controls {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 20px; direction: rtl;
    }
    .dpc-mode-switch { display: inline-flex; gap: 3px; padding: 3px; border: 1px solid #e2e8f0; border-radius: 12px; background: #f1f5f9; }
    .dpc-mode-btn { border: 0; border-radius: 9px; padding: 7px 11px; background: transparent; color: #64748b; font: 800 11px Vazirmatn, sans-serif; cursor: pointer; white-space: nowrap; }
    .dpc-mode-btn.is-active { color: #fff; background: linear-gradient(135deg, #2563eb, #4f46e5); box-shadow: 0 3px 8px rgba(37,99,235,.2); }
    .dpc-progressive-nav { display: flex; align-items: center; justify-content: center; gap: 14px; margin: 0 20px 8px; padding: 10px; border: 1px solid #dbeafe; border-radius: 12px; background: #eff6ff; color: #1e40af; direction: rtl; font-size: 12px; font-weight: 900; }
    .dpc-segment-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 7px;
        border: 2px solid transparent; border-radius: 10px;
        padding: 11px 20px; background: #fff;
        font: 900 14px Vazirmatn, sans-serif; cursor: pointer;
        min-height: 42px; min-width: 124px;
        transition: background 0.15s, border-color 0.15s, box-shadow 0.15s, transform 0.1s, filter 0.15s;
    }
    .dpc-segment-btn:hover:not(:disabled) { transform: translateY(-1px); filter: brightness(1.06); }
    .dpc-segment-btn:active:not(:disabled) { transform: translateY(0); }
    .dpc-segment-btn:disabled { cursor: not-allowed; opacity: .4; transform: none; filter: none; }
    .dpc-segment-btn--next {
        border-color: #16a34a; color: #fff;
        background: linear-gradient(180deg, #22c55e, #16a34a);
        box-shadow: 0 3px 10px rgba(22, 163, 74, 0.35);
    }
    .dpc-segment-btn--next:hover:not(:disabled) { background: linear-gradient(180deg, #16a34a, #15803d); border-color: #15803d; }
    .dpc-segment-btn--prev {
        border-color: #dc2626; color: #fff;
        background: linear-gradient(180deg, #ef4444, #dc2626);
        box-shadow: 0 3px 10px rgba(220, 38, 38, 0.35);
    }
    .dpc-segment-btn--prev:hover:not(:disabled) { background: linear-gradient(180deg, #dc2626, #b91c1c); border-color: #b91c1c; }
    .dpc-seg-arrow { flex-shrink: 0; color: #fff; }
    .dpc-segment-btn--next .dpc-seg-arrow { color: #fff; }
    .dpc-segment-btn--prev .dpc-seg-arrow { color: #fff; }
    #dpc-segment-status {
        flex: 1; text-align: center; min-width: 220px;
        display: inline-flex; align-items: center; justify-content: center; gap: 10px;
        flex-wrap: wrap; padding: 8px 14px; border-radius: 10px;
        background: #fff; border: 1.5px solid #bfdbfe;
        box-shadow: 0 1px 4px rgba(30, 64, 175, 0.08);
        color: #1e3a8a; font-weight: 900; font-size: 14px;
        font-variant-numeric: tabular-nums;
        letter-spacing: 0.1px; line-height: 1.5;
    }
    #dpc-segment-status .dpc-seg-chunk {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 3px 10px; border-radius: 8px;
        background: #eff6ff; color: #1d4ed8;
        border: 1px solid #bfdbfe;
        white-space: nowrap;
    }
    #dpc-segment-status .dpc-seg-chunk--records {
        background: #f0fdf4; color: #15803d; border-color: #bbf7d0;
    }
    #dpc-segment-status .dpc-seg-dot {
        color: #94a3b8; font-weight: 900; font-size: 16px; line-height: 1;
    }
    .dpc-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 14px; border: 1px solid #e2e8f0; border-radius: 10px;
        background: #fff; font-size: 12px; font-weight: 800; color: #475569;
        cursor: pointer; font-family: Vazirmatn, sans-serif;
    }
    .dpc-btn:hover { background: #f1f5f9; }
    .dpc-btn.is-on {
        border-color: #fcd34d; background: #fffbeb; color: #b45309;
        box-shadow: 0 0 0 3px rgba(251, 191, 36, 0.18);
    }

    .dpc-live {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 5px 12px; border: 1px solid #e2e8f0; border-radius: 12px;
        background: #fff; direction: rtl;
    }
