    private static string GetAlertCmdClass(string cmd)
    {
        return cmd == "اخطار اول" ? "warn" : "danger";
    }

    private string GetFridgeClass(double t)
    {
        if (t >= 0 && t <= 9) return "mild";
        if (t >= 10 && t <= 15) return "warm";
        if (t > 15) return "hot";
        return "cold";
    }

    private string GetFreezerClass(double t)
    {
        if (t >= -25 && t <= -12) return "mild";
        if (t > -12 && t <= -5) return "warm";
        if (t > -5) return "hot";
        return "cold";
    }

    private string GetAmbientClass(double t)
    {
        if (t <= _ambientTempThreshold) return "mild";
        return "hot";
    }

    private static double Clamp(double v, double min, double max) =>
        v < min ? min : v > max ? max : v;

    private string FreezerBarWidth => $"width:{Clamp((ambientTemp + 50) / 150 * 100, 0, 100):F1}%";
    private string AmbientBarWidth => $"width:{Clamp((secondaryTemp + 100) / 200 * 100, 0, 100):F1}%";
    private string FridgeBarWidth => $"width:{Clamp(tertiaryTemp / 50 * 100, 0, 100):F1}%";

    private async Task LoadShareStatusAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>(
                $"api/monitoring/share/active?monitoringId={Id}");
            if (result.TryGetProperty("hasActiveLink", out var has) && has.GetBoolean())
            {
                _shareToken = result.GetProperty("token").GetString();
                _shareUrl = $"{Navigation.BaseUri}monitoring/shared?token={_shareToken}";
                _isShareEnabled = true;
            }
            else
            {
                _isShareEnabled = false;
                _shareToken = null;
                _shareUrl = null;
            }
        }
        catch { }
    }

    private async Task ToggleShare(bool enabled)
    {
        if (_isCreatingShareLink) return;
        _isCreatingShareLink = true;
        try
        {
            if (enabled)
            {
                var response = await Http.PostAsJsonAsync("api/monitoring/share/create",
                    new { monitoringId = Id });
                if (response.IsSuccessStatusCode)
                {
                    var data = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                    _shareToken = data.GetProperty("token").GetString();
                    _shareUrl = $"{Navigation.BaseUri}monitoring/shared?token={_shareToken}";
                    _isShareEnabled = true;
                }
            }
            else
            {
                await Http.PostAsJsonAsync("api/monitoring/share/revoke",
                    new { token = _shareToken });
                _shareToken = null;
                _shareUrl = null;
                _isShareEnabled = false;
                _shareLinkCopied = false;
            }
        }
        catch { }
        finally
        {
            _isCreatingShareLink = false;
        }
    }

    private async Task CopyShareLink()
    {
        if (string.IsNullOrEmpty(_shareUrl)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _shareUrl);
            _shareLinkCopied = true;
        }
        catch
        {
            try
            {
                await JS.InvokeVoidAsync("copyToClipboard", _shareUrl);
                _shareLinkCopied = true;
            }
            catch { }
        }
    }

    private static string GetViewerAgo(DateTime lastPing)
    {
        var diff = DateTime.UtcNow - lastPing;
        if (diff.TotalSeconds < 5) return "هم‌اکنون";
        if (diff.TotalSeconds < 60) return $"{(int)diff.TotalSeconds} ثانیه پیش";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} دقیقه پیش";
        return $"> {(int)diff.TotalHours} ساعت پیش";
    }

