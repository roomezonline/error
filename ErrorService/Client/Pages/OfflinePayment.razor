@page "/payment/offline/{OrderId:int}"
@using ErrorService.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ErrorService.Client.Services.ToastService ToastService

<HeadContent>
    <meta name="robots" content="noindex, nofollow" />
</HeadContent>

<PageTitle>پرداخت - ارورسرویس</PageTitle>

<div class="payment-page" dir="rtl">
    <div class="container py-4">
        <div class="d-flex align-items-center gap-3 mb-5 px-1">
            <a href="/checkout" class="btn-back">
                <span class="oi oi-arrow-right"></span>
            </a>
            <h1 class="page-title">پرداخت و تایید نهایی</h1>
        </div>

        @if (isLoading)
        {
            <div class="loading-card">
                <div class="spinner-border text-primary"></div>
                <p class="mt-3 text-muted" style="font-size:0.85rem">در حال دریافت اطلاعات سفارش...</p>
            </div>
        }
        else if (order == null)
        {
            <div class="empty-state animate__animated animate__shakeX">
                <div class="empty-icon empty-icon--err"><span class="oi oi-circle-x"></span></div>
                <h3 class="empty-title">سفارش یافت نشد</h3>
                <a href="/" class="btn btn-primary-custom px-5 py-3 mt-3">بازگشت به خانه</a>
            </div>
        }
        else
        {
            <div class="row g-4 justify-content-center">
                <div class="col-lg-8">
                    <div class="payment-content animate__animated animate__fadeInUp">

                        <div class="order-banner">
                            <div>
                                <div class="order-banner-label">مبلغ قابل پرداخت</div>
                                <div class="order-banner-amount">@((order.TotalAmount - (order.DiscountAmount ?? 0)).ToString("N0")) <small>تومان</small></div>
                                @if ((order.DiscountAmount ?? 0) > 0)
                                {
                                    <div class="order-banner-note">
                                        جمع اولیه: @order.TotalAmount.ToString("N0") تومان
                                        <span class="text-warning">— تخفیف (@order.CouponCode): -@order.DiscountAmount?.ToString("N0") تومان</span>
                                    </div>
                                }
                            </div>
                            <div class="order-banner-code">
                                <span class="order-banner-code-label">شماره سفارش</span>
                                <span class="order-banner-code-val">@order.OrderNumber</span>
                            </div>
                        </div>

                        <div class="section-header">
                            <div class="step-num">۱</div>
                            <div>
                                <h2 class="section-title">انتخاب حساب بانکی</h2>
                                <p class="section-desc">مبلغ سفارش را به یکی از حساب‌های زیر واریز کنید</p>
                            </div>
                        </div>

                        @if (IsAboveCardToCardLimit)
                        {
                            <div class="limit-note animate__animated animate__fadeInUp">
                                <div class="limit-note__icon"><span class="oi oi-warning"></span></div>
                                <div class="limit-note__body">
                                    <div class="limit-note__title">مبلغ سفارش بالاتر از سقف کارت به کارت است</div>
                                    <div class="limit-note__desc">
                                        سقف فعلی کارت به کارت <b>۱۰۰ میلیون ریال</b> است و مبلغ این سفارش
                                        (<b>@PayAmountToman.ToString("N0") تومان</b>) بالاتر از آن می‌باشد.
                                        توصیه می‌شود مبلغ را از طریق <b>سیستم پایا/ساتنا (پل)</b> واریز کنید؛
                                        برای این کار کافی است <b>شماره شبا</b> حساب مقصد را از همین صفحه کپی کنید.
                                    </div>
                                </div>
                            </div>
                        }

                        <div class="bank-grid">
                            @if (bankAccounts == null || !bankAccounts.Any())
                            {
                                <div class="alert alert-warning rounded-4 border-0 p-4">
                                    <span class="oi oi-warning me-2"></span>حساب بانکی فعالی یافت نشد. با پشتیبانی تماس بگیرید.
                                </div>
                            }
                            else
                            {
                                @foreach (var acc in bankAccounts)
                                {
                                    <div class="bank-card">
                                        <div class="bank-card-header">
                                            <div class="bank-card-name">@acc.BankName</div>
                                            <span class="oi oi-credit-card bank-card-icon"></span>
                                        </div>
                                        <div class="bank-card-body">
                                            <div class="bank-card-owner">@acc.OwnerName</div>
                                            <div class="bank-card-number"
                                                 @onclick='() => CopyToClipboard(acc.CardNumber, "شماره کارت")'>
                                                @FormatCardNumber(acc.CardNumber)
                                                <span class="copy-hint">
                                                    <span class="oi oi-clipboard"></span>
                                                    لمس برای کپی
                                                </span>
                                            </div>
                                            <div class="bank-card-details">
                                                <div class="bank-detail" @onclick='() => CopyToClipboard(acc.AccountNumber, "شماره حساب")'>
                                                    <span class="bank-detail-label">حساب</span>
                                                    <span class="bank-detail-val ltr">@(string.IsNullOrEmpty(acc.AccountNumber) ? "—" : acc.AccountNumber)</span>
                                                </div>
                                                <div class="bank-detail" @onclick='() => CopyToClipboard(acc.Iban, "شماره شبا")'>
                                                    <span class="bank-detail-label">شبا</span>
                                                    <span class="bank-detail-val ltr" style="font-size:0.72rem">@(string.IsNullOrEmpty(acc.Iban) ? "—" : acc.Iban)</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <div class="section-header mt-5">
                            <div class="step-num step-num--ok">۲</div>
                            <div>
                                <h2 class="section-title">آپلود رسید پرداخت</h2>
                                <p class="section-desc">تصویر فیش واریزی یا اسکرین‌شات پرداخت را ارسال کنید (تا ۳ تصویر)</p>
                            </div>
                        </div>

                        @if (order.Status == OrderStatus.PendingPayment || order.Status == OrderStatus.ReceiptUploaded)
                        {
                            var remaining = RemainingSlots;
                            <div class="upload-section">
                                @if (order.ReceiptImageUrls.Count > 0)
                                {
                                    <div class="existing-receipts mb-3">
                                        <label class="field-label">رسیدهای ارسال‌شده (@order.ReceiptImageUrls.Count / @MaxReceiptImages)</label>
                                        <div class="receipt-grid">
                                            @foreach (var url in order.ReceiptImageUrls)
                                            {
                                                <a class="receipt-thumb" href="@url" target="_blank" rel="noopener">
                                                    <img src="@url" alt="رسید پرداخت" />
                                                </a>
                                            }
                                        </div>
                                    </div>
                                }

                                @if (order.Status == OrderStatus.ReceiptUploaded)
                                {
                                    <div class="alert alert-success rounded-4 border-0 p-3 d-flex gap-2 align-items-start" style="background:#f0fdf4;border-color:#d1fae5">
                                        <span class="oi oi-circle-check text-success mt-1"></span>
                                        <div class="small lh-base">
                                            رسید شما دریافت شد. در صورت نیاز می‌توانید تا <b>@MaxReceiptImages</b> تصویر رسید ثبت کنید
                                            (تا <b>@remaining</b> تصویر دیگر مجاز است).
                                        </div>
                                    </div>
                                }

                                @if (remaining > 0)
                                {
                                    <div class="field-group mb-3">
                                        <label class="field-label">شماره پیگیری <span class="optional">(اختیاری)</span></label>
                                        <input type="text" class="field-input text-center ltr" @bind="trackingNumber" placeholder="کد پیگیری یا ارجاع" inputmode="numeric" />
                                    </div>

                                    <div class="upload-zone">
                                        <InputFile OnChange="HandleFilesSelected" multiple class="upload-input" accept="image/*" />
                                        <div class="upload-icon">
                                            <span class="oi oi-cloud-upload"></span>
                                        </div>
                                        <h6 class="upload-title">انتخاب تصویر رسید</h6>
                                        <p class="upload-desc">تا @remaining تصویر — حداکثر @MaxReceiptImages تصویر کل — PNG, JPG, WEBP</p>
                                    </div>

                                    @if (selectedFiles.Any())
                                    {
                                        <div class="preview-area animate__animated animate__zoomIn">
                                            <div class="preview-grid">
                                                @for (int i = 0; i < selectedFiles.Count; i++)
                                                {
                                                    var index = i;
                                                    var preview = selectedFiles[i];
                                                    <div class="preview-box">
                                                        <img src="@preview.PreviewUrl" alt="پیش‌نمایش رسید" class="preview-img" />
                                                        <button type="button" class="preview-remove" @onclick="() => selectedFiles.RemoveAt(index)" aria-label="حذف تصویر">×</button>
                                                    </div>
                                                }
                                            </div>
                                            <div class="d-flex gap-2 justify-content-center mt-4 px-3">
                                                <button class="btn btn-primary-custom px-5 py-3" @onclick="UploadReceipt" disabled="@isUploading">
                                                    @if (isUploading) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                    @(order.Status == OrderStatus.ReceiptUploaded ? "افزودن رسید" : "ارسال رسید")
                                                </button>
                                                <button class="btn btn-ghost-custom px-4 py-3" @onclick="() => selectedFiles.Clear()">انصراف</button>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="success-card animate__animated animate__bounceIn">
                                        <div class="success-icon"><span class="oi oi-circle-check"></span></div>
                                        <h3 class="success-title">پیشینه رسید کامل است</h3>
                                        <p class="success-desc">حداکثر @MaxReceiptImages تصویر رسید برای این سفارش ثبت شده است. سفارش شما در حال بررسی است.</p>
                                        <a href="/" class="btn btn-outline-custom px-5 py-2 mt-3">بازگشت به صفحه اصلی</a>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="success-card animate__animated animate__bounceIn">
                                <div class="success-icon"><span class="oi oi-circle-check"></span></div>
                                <h3 class="success-title">رسید شما دریافت شد</h3>
                                <p class="success-desc">سفارش شما در حال بررسی است. به محض تایید، فرآیند ارسال آغاز می‌شود.</p>
                                <a href="/" class="btn btn-outline-custom px-5 py-2 mt-3">بازگشت به صفحه اصلی</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .payment-page { background: var(--shop-bg, #f8fafc); min-height: 100vh; }

    .btn-back {
        width: 42px; height: 42px; display: grid; place-items: center; flex-shrink: 0;
        background: var(--shop-surface, #fff); color: var(--shop-text, #1e293b);
        text-decoration: none; border: 1px solid var(--shop-border, #e2e8f0); border-radius: 12px;
    }
    .btn-back:active { transform: scale(0.95); }

    .page-title { font-size: 1.25rem; font-weight: 800; margin: 0; }

    .loading-card, .empty-state {
        text-align: center; padding: 60px 24px;
        background: var(--shop-surface, #fff); border: 1px solid var(--shop-border, #e2e8f0); border-radius: 24px;
    }
    .empty-icon { width: 80px; height: 80px; margin: 0 auto 20px; background: #f1f5f9; border-radius: 24px; display: grid; place-items: center; font-size: 2rem; color: #94a3b8; }
    .empty-icon--err { background: #fef2f2; color: #ef4444; }
    .empty-title { font-size: 1.1rem; font-weight: 800; margin-bottom: 8px; }

    .payment-content {
        background: var(--shop-surface, #fff); border: 1px solid var(--shop-border, #f1f5f9);
        border-radius: 20px; padding: 28px;
    }

    .order-banner {
        display: flex; justify-content: space-between; align-items: center;
        padding: 20px 24px; margin-bottom: 32px;
        background: linear-gradient(135deg, var(--shop-primary, #4f46e5), var(--shop-primary-2, #6366f1));
        border-radius: 16px; color: #fff;
    }
    .order-banner-label { font-size: 0.78rem; opacity: 0.8; margin-bottom: 4px; }
    .order-banner-amount { font-size: 1.6rem; font-weight: 900; }
    .order-banner-amount small { font-size: 0.75rem; font-weight: 600; opacity: 0.8; }
    .order-banner-note { font-size: 0.72rem; opacity: 0.85; margin-top: 4px; font-weight: 600; }
    .order-banner-code { text-align: left; }
    .order-banner-code-label { display: block; font-size: 0.7rem; opacity: 0.7; margin-bottom: 4px; }
    .order-banner-code-val {
        font-size: 0.9rem; font-weight: 800; background: rgba(255,255,255,0.2);
        padding: 6px 16px; border-radius: 10px; letter-spacing: 0.5px;
    }

    .section-header { display: flex; align-items: flex-start; gap: 14px; margin-bottom: 24px; }
    .step-num {
        width: 36px; height: 36px; flex-shrink: 0; display: grid; place-items: center;
        background: #f1f5f9; color: var(--shop-primary, #4f46e5); border-radius: 12px;
        font-size: 0.8rem; font-weight: 800;
    }
    .step-num--ok { background: #dcfce7; color: #16a34a; }
    .section-title { font-size: 1rem; font-weight: 800; margin: 0 0 2px; }
    .section-desc { font-size: 0.78rem; color: #94a3b8; margin: 0; }

    .bank-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 18px; margin-bottom: 12px; }

    .limit-note {
        display: flex; gap: 14px; align-items: flex-start; margin-bottom: 22px;
        padding: 18px 20px; border-radius: 16px;
        background: linear-gradient(135deg, #fff7ed 0%, #ffedd5 100%);
        border: 1px solid #fed7aa; color: #9a3412;
        box-shadow: 0 4px 16px rgba(249, 115, 22, 0.08);
    }
    .limit-note__icon {
        flex-shrink: 0; width: 42px; height: 42px; border-radius: 13px;
        background: linear-gradient(135deg, #fb923c, #f97316); color: #fff;
        display: grid; place-items: center; font-size: 1.1rem;
        box-shadow: 0 4px 10px rgba(249, 115, 22, 0.35);
    }
    .limit-note__title { font-size: 0.92rem; font-weight: 800; color: #9a3412; margin-bottom: 6px; }
    .limit-note__desc { font-size: 0.8rem; line-height: 1.95; color: #9a3412; margin: 0; opacity: 0.95; }
    .limit-note__desc b { color: #c2410c; font-weight: 800; }

    .bank-card {
        background: #fff; color: var(--shop-text, #1e293b);
        border-radius: 18px; padding: 0; position: relative; overflow: hidden;
        border: 1px solid #e8ecf1;
        box-shadow: 0 2px 12px rgba(0,0,0,0.04);
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .bank-card:hover { transform: translateY(-3px); box-shadow: 0 8px 28px rgba(0,0,0,0.08); }

    .bank-card-header {
        padding: 16px 20px; display: flex; justify-content: space-between; align-items: center;
        background: linear-gradient(135deg, #eef2ff, #e0e7ff); border-bottom: 1px solid #e0e7ff;
    }
    .bank-card:nth-child(2n) .bank-card-header { background: linear-gradient(135deg, #ecfdf5, #d1fae5); border-bottom-color: #d1fae5; }
    .bank-card:nth-child(3n) .bank-card-header { background: linear-gradient(135deg, #fef3c7, #fde68a); border-bottom-color: #fde68a; }
    .bank-card:nth-child(4n) .bank-card-header { background: linear-gradient(135deg, #fce7f3, #fbcfe8); border-bottom-color: #fbcfe8; }

    .bank-card-name {
        font-size: 0.82rem; font-weight: 700; color: #475569;
    }
    .bank-card:nth-child(2n) .bank-card-name { color: #047857; }
    .bank-card:nth-child(3n) .bank-card-name { color: #92400e; }
    .bank-card:nth-child(4n) .bank-card-name { color: #9d174d; }

    .bank-card-icon { font-size: 1.1rem; opacity: 0.45; }

    .bank-card-body { padding: 20px; }

    .bank-card-owner { font-size: 0.9rem; font-weight: 700; color: #334155; margin-bottom: 14px; }

    .bank-card-number {
        background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 12px; padding: 14px 16px;
        text-align: center; font-size: 1.1rem; font-weight: 800; letter-spacing: 2px;
        cursor: pointer; transition: all 0.15s; position: relative; color: #1e293b;
    }
    .bank-card-number:hover { background: #f0f4ff; border-color: var(--shop-primary, #4f46e5); color: var(--shop-primary, #4f46e5); }

    .copy-hint {
        display: block; font-size: 0.65rem; font-weight: 500; opacity: 0.45;
        margin-top: 6px; letter-spacing: 0; color: #64748b;
    }

    .bank-card-details { margin-top: 14px; display: flex; flex-direction: column; gap: 8px; }
    .bank-detail {
        display: flex; justify-content: space-between; align-items: center;
        padding: 10px 12px; background: #f8fafc; border-radius: 10px;
        cursor: pointer; transition: all 0.15s; border: 1px solid transparent;
    }
    .bank-detail:hover { background: #f0f4ff; border-color: #e0e7ff; }
    .bank-detail-label { font-size: 0.72rem; font-weight: 600; color: #94a3b8; }
    .bank-detail-val { font-size: 0.8rem; font-weight: 700; color: #334155; }

    .upload-section { margin-top: 8px; }

    .field-group { margin-bottom: 4px; }
    .field-label { display: block; font-size: 0.8rem; font-weight: 700; color: #475569; margin-bottom: 6px; }
    .field-label .optional { font-weight: 500; color: #cbd5e1; }
    .field-input {
        width: 100%; padding: 13px 16px; font-size: 0.88rem;
        border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc;
        color: var(--shop-text, #1e293b); outline: none; transition: border-color 0.15s, box-shadow 0.15s;
    }
    .field-input:focus { border-color: var(--shop-primary, #4f46e5); box-shadow: 0 0 0 3px rgba(79,70,229,0.08); background: #fff; }

    .upload-zone {
        border: 2px dashed #d1d5db; border-radius: 16px; background: #f8fafc;
        padding: 48px 24px; text-align: center; position: relative;
        transition: border-color 0.2s, background 0.2s;
    }
    .upload-zone:hover { border-color: var(--shop-primary, #4f46e5); background: #f0f4ff; }
    .upload-input { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    .upload-icon { width: 64px; height: 64px; margin: 0 auto 16px; background: #fff; border-radius: 18px; display: grid; place-items: center; font-size: 1.5rem; color: var(--shop-primary, #4f46e5); border: 1px solid #e2e8f0; }
    .upload-title { font-size: 0.95rem; font-weight: 800; margin-bottom: 6px; }
    .upload-desc { font-size: 0.78rem; color: #94a3b8; margin: 0; }

    .existing-receipts .receipt-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(90px, 1fr)); gap: 10px;
    }
    .receipt-thumb {
        display: block; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; background: #f8fafc;
        transition: transform 0.15s;
    }
    .receipt-thumb:hover { transform: translateY(-2px); }
    .receipt-thumb img { width: 100%; height: 90px; object-fit: cover; display: block; }

    .preview-area { text-align: center; }
    .preview-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 12px;
    }
    .preview-box {
        position: relative; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; overflow: hidden;
    }
    .preview-box .preview-img { width: 100%; height: 110px; object-fit: cover; display: block; }
    .preview-remove {
        position: absolute; top: 6px; right: 6px; width: 28px; height: 28px; padding: 0;
        border: none; border-radius: 50%; background: rgba(15,23,42,0.65); color: #fff;
        font-size: 1rem; line-height: 1; display: grid; place-items: center;
        transition: background 0.15s;
    }
    .preview-remove:hover { background: #ef4444; }

    .success-card {
        text-align: center; padding: 48px 24px;
        background: var(--shop-surface, #fff); border: 1px solid var(--shop-border, #e2e8f0); border-radius: 20px;
    }
    .success-icon { width: 72px; height: 72px; margin: 0 auto 20px; background: #dcfce7; border-radius: 50%; display: grid; place-items: center; font-size: 2rem; color: #16a34a; }
    .success-title { font-size: 1.1rem; font-weight: 800; margin-bottom: 8px; }
    .success-desc { font-size: 0.85rem; color: #64748b; line-height: 1.7; max-width: 380px; margin: 0 auto 16px; }

    .btn-primary-custom {
        background: linear-gradient(135deg, var(--shop-primary, #4f46e5), var(--shop-primary-2, #6366f1));
        color: #fff; border: none; border-radius: 14px; font-weight: 800; font-size: 0.88rem;
        transition: transform 0.15s, box-shadow 0.15s; text-decoration: none;
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
    }
    .btn-primary-custom:hover { transform: translateY(-1px); box-shadow: 0 8px 24px rgba(79,70,229,0.25); color: #fff; }
    .btn-primary-custom:active { transform: scale(0.98); }
    .btn-primary-custom:disabled { opacity: 0.6; transform: none; box-shadow: none; }

    .btn-ghost-custom {
        background: transparent; border: 1px solid var(--shop-border, #e2e8f0); border-radius: 14px;
        font-weight: 700; font-size: 0.85rem; color: #94a3b8; text-decoration: none;
        display: inline-flex; align-items: center; justify-content: center; transition: background 0.15s;
    }
    .btn-ghost-custom:hover { background: #f8fafc; }

    .btn-outline-custom {
        background: transparent; border: 1px solid var(--shop-border, #e2e8f0); border-radius: 14px;
        font-weight: 700; font-size: 0.85rem; color: #64748b; text-decoration: none;
        display: inline-flex; align-items: center; justify-content: center; transition: background 0.15s;
    }
    .btn-outline-custom:hover { background: #f8fafc; color: #475569; }

    .optional { font-weight: 500; color: #cbd5e1; }

    @@media (max-width: 768px) {
        .payment-content { padding: 20px; }
        .order-banner { flex-direction: column; gap: 16px; text-align: center; padding: 20px; }
        .order-banner-code { text-align: center; }
        .bank-grid { grid-template-columns: 1fr; gap: 14px; }
        .bank-card-number { font-size: 1rem; padding: 12px; }
        .limit-note { padding: 16px; }
        .limit-note__icon { width: 38px; height: 38px; font-size: 1rem; }
        .upload-zone { padding: 36px 20px; }
    }
</style>

@code {
    [Parameter] public int OrderId { get; set; }
    [SupplyParameterFromQuery(Name = "token")]
    public string? AccessToken { get; set; }
    private OrderDto? order;
    private List<BankAccountDto>? bankAccounts;
    private bool isLoading = true;
    private bool isUploading = false;
    private string? trackingNumber;
    private readonly List<SelectedReceiptFile> selectedFiles = new();

    private const int MaxReceiptImages = 3;
    private const decimal CardToCardLimitRials = 100_000_000m;

    private decimal PayAmountToman => order is null ? 0 : order.TotalAmount - (order.DiscountAmount ?? 0);
    private bool IsAboveCardToCardLimit => PayAmountToman * 10 > CardToCardLimitRials;

    private int UploadedReceiptCount => order?.ReceiptImageUrls.Count ?? 0;
    private int RemainingSlots => Math.Max(0, MaxReceiptImages - UploadedReceiptCount);

    private sealed class SelectedReceiptFile
    {
        public string FileName { get; set; } = string.Empty;
        public string ContentType { get; set; } = "image/jpeg";
        public byte[] Buffer { get; set; } = Array.Empty<byte>();
        public string PreviewUrl { get; set; } = string.Empty;
    }

    private string FormatCardNumber(string? cardNumber)
    {
        if (string.IsNullOrEmpty(cardNumber)) return "**** **** **** ****";
        var cleaned = cardNumber.Replace("-", "").Replace(" ", "");
        if (cleaned.Length != 16) return cardNumber;
        return $"{cleaned.Substring(0, 4)} {cleaned.Substring(4, 4)} {cleaned.Substring(8, 4)} {cleaned.Substring(12, 4)}";
    }

    private async Task CopyToClipboard(string? text, string label)
    {
        if (string.IsNullOrEmpty(text)) return;
        await JS.InvokeVoidAsync("__copyToClipboard", text);
        ToastService.ShowSuccess($"{label} کپی شد");
    }

    private string OrderUrl() => string.IsNullOrWhiteSpace(AccessToken)
        ? $"api/orders/{OrderId}"
        : $"api/orders/{OrderId}?token={Uri.EscapeDataString(AccessToken)}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            order = await Http.GetFromJsonAsync<OrderDto>($"{OrderUrl()}");
            bankAccounts = await Http.GetFromJsonAsync<List<BankAccountDto>>("api/bankaccounts/gateway");
            trackingNumber = order?.TrackingNumber ?? trackingNumber;
        }
        catch (Exception ex) { ToastService.ShowError("خطا در دریافت اطلاعات: " + ex.Message); }
        finally { isLoading = false; }
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var files = e.GetMultipleFiles(Math.Max(1, RemainingSlots));
            foreach (var file in files)
            {
                if (RemainingSlots <= 0) break;
                var buffer = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
                selectedFiles.Add(new SelectedReceiptFile
                {
                    FileName = file.Name,
                    ContentType = file.ContentType,
                    Buffer = buffer,
                    PreviewUrl = $"data:{file.ContentType};base64,{Convert.ToBase64String(buffer)}"
                });
            }
        }
        catch (Exception ex) { ToastService.ShowError("خطا در خواندن فایل: " + ex.Message); }
    }

    private async Task UploadReceipt()
    {
        if (selectedFiles.Count == 0) { ToastService.ShowError("ابتدا تصویر رسید را انتخاب کنید"); return; }
        if (isUploading) return;
        isUploading = true;
        try
        {
            var content = new MultipartFormDataContent();
            foreach (var f in selectedFiles)
            {
                var byteArrayContent = new ByteArrayContent(f.Buffer);
                byteArrayContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(f.ContentType);
                content.Add(byteArrayContent, "files", f.FileName);
            }
            if (!string.IsNullOrEmpty(trackingNumber)) content.Add(new StringContent(trackingNumber), "trackingNumber");
            if (!string.IsNullOrWhiteSpace(AccessToken)) content.Add(new StringContent(AccessToken), "accessToken");

            var response = await Http.PostAsync($"api/orders/{OrderId}/receipt", content);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(order?.Status == OrderStatus.ReceiptUploaded ? "رسید جدید ثبت شد" : "رسید پرداخت با موفقیت ثبت شد");
                order = await Http.GetFromJsonAsync<OrderDto>(OrderUrl());
                selectedFiles.Clear();
            }
            else
            {
                var serverMessage = await response.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(serverMessage) ? "خطا در ارسال فایل" : serverMessage.Trim().Trim('"'));
            }
        }
        catch { ToastService.ShowError("خطای ارتباط با سرور"); }
        finally { isUploading = false; }
    }
}
