@using System.Net.Http.Json
@using ErrorService.Shared
@using Microsoft.AspNetCore.Components.Web

<div class="global-search" @onkeydown="HandleKeyDown">
    <div class="global-search__input">
        <span class="oi oi-magnifying-glass text-muted" aria-hidden="true"></span>
        <input class="form-control global-search__textbox" placeholder="جستجو در محصولات و اخبار..." autocomplete="off" value="@query" @oninput="OnQueryInput" @onfocus="Open" />
        @if (!string.IsNullOrWhiteSpace(query))
        {
            <button type="button" class="global-search__clear" @onclick="Clear" aria-label="پاک کردن">
                <span class="oi oi-x" aria-hidden="true"></span>
            </button>
        }
    </div>

    @if (isOpen)
    {
        <button type="button" class="global-search__backdrop" @onclick="Close" aria-label="بستن جستجو"></button>
    }

<style>
    .global-search {
        position: relative;
        width: 100%;
    }
    .global-search__input {
        display: flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.92);
        border-radius: 999px;
        padding: 6px 10px;
    }
    .global-search__textbox {
        border: 0;
        background: transparent;
        box-shadow: none;
        padding: 0;
        font-size: 0.9rem;
    }
    .global-search__textbox:focus {
        outline: none;
        box-shadow: none;
    }
    .global-search__clear {
        border: 0;
        background: transparent;
        padding: 2px 6px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #6b7280;
    }
    .global-search__panel {
        position: absolute;
        top: calc(100% + 8px);
        right: 0;
        left: 0;
        background: #fff;
        border-radius: 14px;
        border: 1px solid rgba(0,0,0,0.08);
        overflow: hidden;
        z-index: 2000;
    }
    .global-search__backdrop {
        position: fixed;
        inset: 0;
        background: transparent;
        border: 0;
        padding: 0;
        margin: 0;
        z-index: 1990;
    }
    .global-search__section {
        padding: 10px;
    }
    .global-search__section + .global-search__section {
        border-top: 1px solid rgba(0,0,0,0.06);
    }
    .global-search__section-title {
        font-size: 0.75rem;
        font-weight: 800;
        color: #6b7280;
        margin-bottom: 8px;
    }
    .global-search__item {
        width: 100%;
        text-align: right;
        border: 0;
        background: transparent;
        padding: 8px 10px;
        border-radius: 10px;
    }
    .global-search__item:hover {
        background: rgba(13,110,253,0.06);
    }
    .global-search__item.is-selected {
        background: rgba(13,110,253,0.12);
        outline: 2px solid rgba(13,110,253,0.25);
    }
    .global-search__item-title {
        font-size: 0.9rem;
        font-weight: 700;
        color: #111827;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .global-search__item-subtitle {
        font-size: 0.78rem;
        color: #6b7280;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-top: 2px;
    }
</style>

    @if (isOpen)
    {
        <div class="global-search__panel shadow" @onclick:stopPropagation="true">
            @if (isLoading)
            {
                <div class="p-3 text-center text-muted small">
                    <span class="spinner-border spinner-border-sm me-2"></span>
                    در حال جستجو...
                </div>
            }
            else if (results == null || (results.Products.Count == 0 && results.News.Count == 0))
            {
                <div class="p-3 text-muted small">نتیجه‌ای یافت نشد.</div>
            }
            else
            {
                @if (results.Products.Count > 0)
                {
                    <div class="global-search__section">
                        <div class="global-search__section-title">محصولات</div>
                        @foreach (var item in results.Products)
                        {
                            <button type="button" class="global-search__item @(IsSelected(item) ? "is-selected" : "")" @onclick="() => Go(item.Url)">
                                <div class="global-search__item-title">@item.Title</div>
                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                {
                                    <div class="global-search__item-subtitle">@item.Subtitle</div>
                                }
                            </button>
                        }
                    </div>
                }

                @if (results.News.Count > 0)
                {
                    <div class="global-search__section">
                        <div class="global-search__section-title">اخبار</div>
                        @foreach (var item in results.News)
                        {
                            <button type="button" class="global-search__item @(IsSelected(item) ? "is-selected" : "")" @onclick="() => Go(item.Url)">
                                <div class="global-search__item-title">@item.Title</div>
                                @if (!string.IsNullOrWhiteSpace(item.Subtitle))
                                {
                                    <div class="global-search__item-subtitle">@item.Subtitle</div>
                                }
                            </button>
                        }
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private string query = string.Empty;
    private bool isOpen;
    private bool isLoading;
    private SearchResponseDto? results;

    private CancellationTokenSource? cts;
    private int selectedIndex = -1;

    protected override void OnInitialized()
    {
        results = new SearchResponseDto();
    }

    private void Open()
    {
        isOpen = true;
    }

    private void Close()
    {
        isOpen = false;
        selectedIndex = -1;
    }

    private void Clear()
    {
        query = string.Empty;
        results = new SearchResponseDto();
        isOpen = false;
        selectedIndex = -1;
    }

    private async Task OnQueryInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? string.Empty;
        await SearchAsync(query);
    }

    private async Task SearchAsync(string q)
    {
        cts?.Cancel();
        cts?.Dispose();
        cts = new CancellationTokenSource();
        var token = cts.Token;

        if (string.IsNullOrWhiteSpace(q) || q.Trim().Length < 2)
        {
            results = new SearchResponseDto();
            isLoading = false;
            selectedIndex = -1;
            return;
        }

        isLoading = true;
        try
        {
            await Task.Delay(150, token);
            var url = $"api/search?q={Uri.EscapeDataString(q.Trim())}&take=10";
            var resp = await Http.GetFromJsonAsync<SearchResponseDto>(url, token);
            results = resp ?? new SearchResponseDto();
            selectedIndex = GetFlatResults().Count > 0 ? 0 : -1;
        }
        catch (OperationCanceledException) { }
        catch
        {
            results = new SearchResponseDto();
            selectedIndex = -1;
        }
        finally
        {
            isLoading = false;
            isOpen = true;
        }
    }

    private void Go(string url)
    {
        isOpen = false;
        selectedIndex = -1;
        Nav.NavigateTo(url);
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
            return;
        }

        if (!isOpen)
            return;

        var flat = GetFlatResults();
        if (flat.Count == 0)
            return;

        if (e.Key == "ArrowDown")
        {
            selectedIndex = selectedIndex < 0 ? 0 : Math.Min(selectedIndex + 1, flat.Count - 1);
            return;
        }

        if (e.Key == "ArrowUp")
        {
            selectedIndex = selectedIndex <= 0 ? 0 : selectedIndex - 1;
            return;
        }

        if (e.Key == "Enter")
        {
            if (selectedIndex >= 0 && selectedIndex < flat.Count)
                Go(flat[selectedIndex].Url);
            return;
        }

        await Task.CompletedTask;
    }

    private List<SearchResultItemDto> GetFlatResults()
    {
        if (results == null) return new();
        var flat = new List<SearchResultItemDto>();
        if (results.Products != null) flat.AddRange(results.Products);
        if (results.News != null) flat.AddRange(results.News);
        return flat;
    }

    private bool IsSelected(SearchResultItemDto item)
    {
        var flat = GetFlatResults();
        if (selectedIndex < 0 || selectedIndex >= flat.Count) return false;
        var current = flat[selectedIndex];
        return current.Type == item.Type && current.Id == item.Id;
    }

    private string Query
    {
        get => query;
        set
        {
            query = value;
            _ = InvokeAsync(() => SearchAsync(query));
        }
    }
}
