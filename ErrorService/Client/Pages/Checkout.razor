    .pm-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 6px; }
    .pm-option { display: flex; align-items: center; gap: 10px; text-align: right; background: #fff; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 12px 14px; cursor: pointer; font-family: inherit; transition: all .15s; }
    .pm-option:hover { border-color: #c7d2fe; }
    .pm-option--active { border-color: var(--shop-primary, #4f46e5); background: rgba(79,70,229,.05); }
    .pm-option__ico { font-size: 1.15rem; color: #16a34a; }
    .pm-option__ico--online { color: var(--shop-primary, #4f46e5); }
    .pm-option__title { font-size: 0.82rem; font-weight: 800; color: var(--shop-text, #1e293b); }
