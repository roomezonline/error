    private void ResolveParents(List<CommentItem> items)
    {
        var parentIds = items.Where(i => i.ParentId.HasValue).Select(i => i.ParentId!.Value).ToHashSet();
        foreach (var item in items.Where(i => parentIds.Contains(i.Id)))
        {
            item._children ??= new();
        }
        foreach (var item in items.Where(i => i.ParentId.HasValue))
        {
            var parent = items.FirstOrDefault(p => p.Id == item.ParentId);
            if (parent != null)
            {
                item.ParentLabel = parent.Author;
                item.ParentContent = parent.Content.Length > 100 ? parent.Content[..100] + "..." : parent.Content;
                parent._children ??= new();
                parent._children.Add(item);
            }
        }
    }

