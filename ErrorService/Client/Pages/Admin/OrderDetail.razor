@page "/admin/orders/{Id:int}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.orders.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Services
@using ErrorService.Client.Utils
@inject HttpClient Http
@inject ToastService ToastService
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(order == null ? "جزئیات سفارش | ارورسرویس" : $"سفارش #{order.OrderNumber} | ارورسرویس")</PageTitle>

@if (isLoading)
{
    <div class="od-loading">
        <div class="od-spinner"></div>
    </div>
}
else if (order == null)
{
    <div class="od-loading">
        <div class="od-empty">
            <span class="oi oi-circle-x" style="font-size:2rem;color:#94a3b8"></span>
            <p>سفارش یافت نشد.</p>
        </div>
    </div>
}
else
{
    <div class="od-page">
        <div class="od-header">
            <div class="od-header-top">
                <button class="od-back-btn" @onclick="GoBack">
                    <span class="oi oi-arrow-right"></span>
                </button>
                <div class="od-header-info">
                    <span class="od-order-num"> #@order.OrderNumber</span>
                    <span class="od-header-date">@PersianDate.ToJalaliDateTime(order.CreatedAt)</span>
                </div>
                <span class="od-status-badge @GetStatusBadgeClass(order.Status)">@GetStatusLabel(order.Status)</span>
            </div>

            @if (!string.IsNullOrEmpty(order.NextAction))
            {
                <div class="od-next-action">
                    <span class="oi oi-bell"></span>
                    <strong>@order.NextAction</strong>
                </div>
            }
        </div>

        <OrderStageStepper Status="order.Status"
                           Stage="order.Stage"
                           StageDates="order.StageDates"
                           CreatedAt="order.CreatedAt"
                           PaymentDate="order.PaymentDate"
                           UpdatedAt="order.UpdatedAt" />

        <div class="od-summary-bar">
            <div class="od-summary-item">
                <span class="od-summary-value">@order.Items.Count</span>
                <span class="od-summary-label">اقلام</span>
            </div>
            <div class="od-summary-divider"></div>
            <div class="od-summary-item">
                <span class="od-summary-value">@((order.TotalAmount - (order.DiscountAmount ?? 0)).ToString("N0"))</span>
                <span class="od-summary-label">مبلغ (تومان)</span>
            </div>
            <div class="od-summary-divider"></div>
            <div class="od-summary-item">
                <span class="od-summary-value" style="font-size:0.8rem">@(order.ShippingMethodName ?? "—")</span>
                <span class="od-summary-label">ارسال @(order.ShippingCost > 0 ? $"({order.ShippingCost.ToString("N0")}ت)" : "(رایگان)")</span>
            </div>
            <div class="od-summary-divider"></div>
            <div class="od-summary-item">
                <span class="od-summary-value ltr" style="font-size:0.85rem">@order.PhoneNumber</span>
                <span class="od-summary-label">موبایل</span>
            </div>
        </div>

        @if (order.Status == OrderStatus.ReceiptUploaded)
        {
            <div class="od-quick-actions">
                <div class="od-quick-actions-title">
                    <span class="oi oi-check-circle"></span>
                    بررسی رسید پرداخت
                </div>
                <div class="od-quick-actions-row">
                    <button class="od-btn od-btn-approve" @onclick="QuickApprove" disabled="@isSaving">
                        @if (isSaving) { <span class="od-btn-spinner"></span> }
                        <span class="oi oi-check"></span> تایید سفارش
                    </button>
                    <button class="od-btn od-btn-reject" @onclick="QuickReject" disabled="@isSaving">
                        <span class="oi oi-x"></span> رد سفارش
                    </button>
                </div>
            </div>
        }

        <div class="od-section">
            <div class="od-section-header" @onclick="ToggleC">
                <div class="od-section-title">
                    <span class="od-section-icon oi oi-person"></span>
                    اطلاعات مشتری
                </div>
                <span class="oi oi-chevron-bottom od-section-toggle"></span>
                @if (!isEditingInfo)
                {
                    <button class="od-edit-btn" @onclick="StartEditingInfo" @onclick:stopPropagation="true">
                        <span class="oi oi-pencil"></span>
                    </button>
                }
            </div>
            @if (IsSectionVisible("c"))
            {
            @if (isEditingInfo)
            {
                <div class="od-edit-form">
                    <div class="od-field">
                        <label>نام</label>
                        <input class="od-input" @bind="editInfo.FullName" />
                    </div>
                    <div class="od-field">
                        <label>موبایل</label>
                        <input class="od-input ltr" @bind="editInfo.PhoneNumber" />
                    </div>
                    <div class="od-field">
                        <label>ایمیل</label>
                        <input class="od-input" @bind="editInfo.Email" />
                    </div>
                    <div class="od-field">
                        <label>آدرس</label>
                        <textarea class="od-input" rows="2" @bind="editInfo.Address"></textarea>
                    </div>
                    <div class="od-field">
                        <label>کد پستی</label>
                        <input class="od-input ltr" @bind="editInfo.PostalCode" />
                    </div>
                    <div class="od-field-row">
                        <button class="od-btn od-btn-primary" @onclick="SaveInfo" disabled="@isSaving">
                            @if (isSaving) { <span class="od-btn-spinner"></span> }
                            ذخیره
                        </button>
                        <button class="od-btn od-btn-ghost" @onclick="() => isEditingInfo = false">انصراف</button>
                    </div>
                </div>
            }
            else
            {
                <div class="od-info-grid">
                    <div class="od-info-item">
                        <span class="od-info-label">نام</span>
                        <span class="od-info-value">@order.FullName</span>
                    </div>
                    <div class="od-info-item">
                        <span class="od-info-label">موبایل</span>
                        <span class="od-info-value ltr">@order.PhoneNumber</span>
                    </div>
                    @if (!string.IsNullOrEmpty(order.Email))
                    {
                        <div class="od-info-item">
                            <span class="od-info-label">ایمیل</span>
                            <span class="od-info-value">@order.Email</span>
                        </div>
                    }
                    <div class="od-info-item full">
                        <span class="od-info-label">آدرس</span>
                        <span class="od-info-value">@(order.Address ?? "ثبت نشده")</span>
                    </div>
                    <div class="od-info-item">
                        <span class="od-info-label">استان / شهر</span>
                        <span class="od-info-value">@FormatProvinceCity()</span>
                    </div>
                    <div class="od-info-item">
                        <span class="od-info-label">کد پستی</span>
                        <span class="od-info-value ltr">@(string.IsNullOrWhiteSpace(order.PostalCode) ? "-" : order.PostalCode)</span>
                    </div>
                </div>
            }
            }
        </div>

        <div class="od-section">
            <div class="od-section-header" @onclick="ToggleP">
                <div class="od-section-title">
                    <span class="od-section-icon oi oi-credit-card"></span>
                    پرداخت و رسید
                </div>
                <span class="oi oi-minus od-section-toggle"></span>
            </div>
            @if (IsSectionVisible("p"))
            {
            <div class="od-info-grid">
                <div class="od-info-item">
                    <span class="od-info-label">کد رهگیری</span>
                    <span class="od-info-value ltr">@(order.TrackingNumber ?? "ثبت نشده")</span>
                </div>
                <div class="od-info-item">
                    <span class="od-info-label">تاریخ پرداخت</span>
                    <span class="od-info-value">@(order.PaymentDate.HasValue ? PersianDate.ToJalaliDateTime(order.PaymentDate.Value) : "-")</span>
                </div>
                <div class="od-info-item">
                    <span class="od-info-label">درگاه پرداخت</span>
                    <span class="od-info-value">@(order.PaymentProvider?.ToString() ?? "دستی")</span>
                </div>
            </div>
            @if (order.ReceiptImageUrls != null && order.ReceiptImageUrls.Count > 0)
            {
                <div class="od-receipts">
                    @foreach (var url in order.ReceiptImageUrls)
                    {
                        <a href="@url" target="_blank" class="od-receipt-thumb">
                            <img src="@url" />
                        </a>
                    }
                </div>
            }
            else if (!string.IsNullOrEmpty(order.ReceiptImageUrl))
            {
                <div class="od-receipts">
                    <a href="@order.ReceiptImageUrl" target="_blank" class="od-receipt-thumb">
                        <img src="@order.ReceiptImageUrl" />
                    </a>
                </div>
            }
            }
        </div>

        <div class="od-section">
            <div class="od-section-header" @onclick="ToggleI">
                <div class="od-section-title">
                    <span class="od-section-icon oi oi-list"></span>
                    اقلام سفارش
                </div>
                <span class="oi oi-minus od-section-toggle"></span>
            </div>
            @if (IsSectionVisible("i"))
            {
            <div class="od-items-list">
                @foreach (var item in order.Items)
                {
                    <div class="od-item-row">
                        <div class="od-item-info">
                            <span class="od-item-name">@item.ProductName</span>
                            <span class="od-item-meta">@item.Quantity × @item.Price.ToString("N0") تومان</span>
                        </div>
                        <span class="od-item-total">@((item.Price * item.Quantity).ToString("N0"))</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(order.ShippingMethodName))
                {
                    <div class="od-item-row">
                        <div class="od-item-info">
                            <span class="od-item-name" style="color:#64748b">ارسال (@order.ShippingMethodName)</span>
                        </div>
                        <span class="od-item-total" style="color:#64748b">
                            @if (order.ShippingCost == 0)
                            {
                                <span style="color:#16a34a">رایگان</span>
                            }
                            else
                            {
                                @order.ShippingCost.ToString("N0")
                            }
                        </span>
                    </div>
                }
                @if ((order.DiscountAmount ?? 0) > 0)
                {
                    <div class="od-item-row">
                        <div class="od-item-info">
                            <span class="od-item-name" style="color:#dc2626">تخفیف (@order.CouponCode)</span>
                        </div>
                        <span class="od-item-total" style="color:#dc2626">-@order.DiscountAmount?.ToString("N0")</span>
                    </div>
                }
                <div class="od-item-row od-items-footer od-total-row">
                    <div class="od-item-info">
                        <span class="od-item-name">مبلغ نهایی</span>
                    </div>
                    <span class="od-total-amount">@((order.TotalAmount - (order.DiscountAmount ?? 0)).ToString("N0")) تومان</span>
                </div>
            </div>
            }
        </div>

        @if (CanShowShipments())
        {
        <div class="od-section">
            <div class="od-section-header" @onclick="ToggleS">
                <div class="od-section-title">
                    <span class="od-section-icon oi oi-package"></span>
                    مرسوله‌ها
                    <span class="od-badge-count">@order.Shipments.Count</span>
                </div>
                @if (CanShowNewShipmentButton())
                {
                <button class="od-btn od-btn-primary od-btn-sm" @onclick="ShowNewShipmentForm" @onclick:stopPropagation="true">
                    <span class="oi oi-plus"></span> جدید
                </button>
                }
                <span class="oi oi-minus od-section-toggle"></span>
            </div>

            @if (IsSectionVisible("s"))
            {
            @if (showShipmentForm)
            {
                <div class="od-shipment-form">
                    <div class="od-form-title">@($"مرسوله جدید (تلاش #{order.Shipments.Count + 1})")</div>
                    <div class="od-field-row" style="flex-wrap:wrap">
                        <div class="od-field" style="flex:1;min-width:140px">
                            <label>شرکت حمل</label>
                            <input class="od-input" @bind="newShipment.Carrier" placeholder="پست، تیپاکس،..." />
                        </div>
                        <div class="od-field" style="flex:1;min-width:140px">
                            <label>کد رهگیری</label>
                            <input class="od-input ltr" @bind="newShipment.TrackingNumber" />
                        </div>
                    </div>
                    <div class="od-field">
                        <label>یادداشت</label>
                        <input class="od-input" @bind="newShipment.Notes" />
                    </div>
                    <div class="od-field-row">
                        <button class="od-btn od-btn-primary" @onclick="CreateShipment" disabled="@isSaving">
                            @if (isSaving) { <span class="od-btn-spinner"></span> }
                            ثبت مرسوله
                        </button>
                        <button class="od-btn od-btn-ghost" @onclick="() => showShipmentForm = false">انصراف</button>
                    </div>
                </div>
            }

            @if (!order.Shipments.Any())
            {
                <div class="od-empty-state">
                    <span class="oi oi-inbox" style="font-size:1.5rem;color:#94a3b8"></span>
                    <span>هنوز مرسوله‌ای ثبت نشده است.</span>
                </div>
            }
            else
            {
                @foreach (var ship in order.Shipments)
                {
                    <div class="od-shipment-card">
                        <div class="od-shipment-header">
                            <div>
                                <span class="od-shipment-attempt">تلاش #@ship.AttemptNumber</span>
                                <strong style="margin-right:6px">@ship.Carrier</strong>
                                @if (!string.IsNullOrEmpty(ship.TrackingNumber))
                                {
                                    <span class="od-shipment-meta ltr" style="margin-right:6px">@ship.TrackingNumber</span>
                                }
                            </div>
                            <div style="position:relative">
                                <button class="od-shipment-menu" @onclick="() => ToggleShipMenu(ship.Id)">
                                    <span class="oi oi-ellipsis-vert"></span>
                                </button>
                                @if (expandedShipmentId == ship.Id)
                                {
                                    <div class="od-shipment-dropdown">
                                        @foreach (OrderShipmentStatus s in Enum.GetValues(typeof(OrderShipmentStatus)))
                                        {
                                            <button class="od-dropdown-item" @onclick="() => UpdateShipmentStatus(ship, s)">@GetShipmentStatusLabel(s)</button>
                                        }
                                        <div class="od-dropdown-divider"></div>
                                        <button class="od-dropdown-item od-text-danger" @onclick="() => ConfirmDeleteShipment(ship)">حذف مرسوله</button>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="od-shipment-meta">
                            <span class="od-shipment-status @GetShipmentStatusClass(ship.Status)">@GetShipmentStatusLabelFromStr(ship.Status)</span>
                            @if (ship.ShippedAt.HasValue)
                            {
                                <span>ارسال: @PersianDate.ToJalaliDateTime(ship.ShippedAt.Value)</span>
                            }
                            @if (ship.DeliveredAt.HasValue)
                            {
                                <span>تحویل: @PersianDate.ToJalaliDateTime(ship.DeliveredAt.Value)</span>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(ship.FailureReason))
                        {
                            <div class="od-text-danger" style="font-size:0.8rem;margin-top:6px">علت ناموفقی: @ship.FailureReason</div>
                        }
                        @if (!string.IsNullOrEmpty(ship.Notes))
                        {
                            <div style="font-size:0.8rem;color:#64748b;margin-top:4px">@ship.Notes</div>
                        }
                        <div style="font-size:0.75rem;color:#94a3b8;margin-top:6px">ثبت توسط: @(ship.CreatedBy ?? "سیستم") | @PersianDate.ToJalaliDateTime(ship.CreatedAt)</div>
                    </div>
                }
            }
            }
        </div>
        }

        @if (CanShowStatusChange() || CanShowStageChange())
        {
        <div class="od-section">
            <div class="od-section-header" @onclick="ToggleU">
                <div class="od-section-title">
                    <span class="od-section-icon oi oi-loop"></span>
                    تغییر وضعیت و مرحله
                </div>
                <span class="oi oi-minus od-section-toggle"></span>
            </div>
            @if (IsSectionVisible("u"))
            {
            @if (CanShowStageChange())
            {
                <div class="od-stage-form">
                    <div class="od-stage-form-title">مرحله سفارش</div>
                    <div class="od-stage-options">
                        @foreach (var st in OrderStageInfo.Flow)
                        {
                            var stage = st;
                            var selected = stageToUpdate == stage;
                            <button class="od-stage-opt @(selected ? "selected" : "")"
                                    style="--sc: @OrderStageInfo.Color(stage);"
                                    disabled="@isSaving"
                                    @onclick="() => SelectStage(stage)">
                                <span class="od-stage-opt-dot"></span>
                                @if (stage is OrderStage.SentToUnit or OrderStage.Resolved)
                                {
                                    <span class="oi oi-truck" style="margin-inline-end:2px;"></span>
                                }
                                @OrderStageInfo.Label(stage)
                            </button>
                        }
                    </div>
                </div>
            }
            @if (CanShowStatusChange())
            {
            <div class="od-status-row">
                <select class="od-select" @bind="statusToUpdate">
                    @foreach (var s in GetValidTransitions())
                    {
                        <option value="@s">@GetStatusLabel(s)</option>
                    }
                </select>
            </div>
            }
                <div class="od-field">
                    <input class="od-input" dir="rtl" @bind="adminNote" placeholder="یادداشت مدیر (اختیاری)" />
                </div>
                <div class="od-status-actions">
                    @if (CanShowStageChange())
                    {
                        <button class="od-btn od-btn-primary" @onclick="UpdateStage" disabled="@(isSaving || stageToUpdate == null)">
                            @if (isSaving) { <span class="od-btn-spinner"></span> }
                            بروزرسانی مرحله
                        </button>
                    }
                    @if (CanShowStatusChange())
                    {
                        <button class="od-btn od-btn-secondary" @onclick="UpdateStatus" disabled="@isSaving">
                            @if (isSaving) { <span class="od-btn-spinner"></span> }
                            بروزرسانی وضعیت
                        </button>
                    }
                </div>
            }
        </div>
        }

        <div class="od-section">
            <div class="od-section-header" @onclick="ToggleN">
                <div class="od-section-title">
                    <span class="od-section-icon oi oi-document"></span>
                    یادداشت مدیر
                </div>
                <span class="oi oi-minus od-section-toggle"></span>
            </div>
            @if (IsSectionVisible("n"))
            {
            @if (string.IsNullOrEmpty(order.AdminNotes))
            {
                <div class="od-empty-state">
                    <span class="oi oi-document" style="font-size:1.5rem;color:#94a3b8"></span>
                    <span>یادداشتی ثبت نشده.</span>
                </div>
            }
            else
            {
                <div style="padding:0 16px 16px">
                    <AdminNotesList Notes="@order.AdminNotes" />
                </div>
            }
            }
        </div>

        @if (CanShowReturns())
        {
        <div class="od-section">
            <div class="od-section-header" @onclick="ToggleR">
                <div class="od-section-title">
                    <span class="od-section-icon oi oi-action-undo"></span>
                    مرجوعی
                    @if (order.Returns.Any())
                    {
                        <span class="od-badge-count">@order.Returns.Count</span>
                    }
                </div>
                @if (order.Status == OrderStatus.Completed || order.Returns.Any())
                {
                    <button class="od-btn od-btn-primary od-btn-sm" @onclick="ShowNewReturnForm" @onclick:stopPropagation="true">
                        <span class="oi oi-plus"></span> ثبت مرجوعی
                    </button>
                }
                <span class="oi oi-minus od-section-toggle"></span>
            </div>
            @if (IsSectionVisible("r"))
            {

            @if (showReturnForm)
            {
                <div class="od-return-form">
                    <div class="od-form-title">ثبت مرجوعی جدید</div>
                    <div class="od-field">
                        <label>مبلغ مرجوعی (تومان) *</label>
                        <input type="number" class="od-input" @bind="newReturn.RefundAmount" min="0" />
                    </div>
                    <div class="od-field-row" style="flex-wrap:wrap">
                        <div class="od-field" style="flex:1;min-width:140px">
                            <label>شماره کارت/حساب مقصد</label>
                            <input class="od-input ltr" @bind="newReturn.RefundCardNumber" placeholder="6037..." />
                        </div>
                        <div class="od-field" style="flex:1;min-width:140px">
                            <label>نام بانک</label>
                            <input class="od-input" @bind="newReturn.RefundBankName" placeholder="ملی، ملت،..." />
                        </div>
                    </div>
                    <div class="od-field">
                        <label>دلیل مرجوعی</label>
                        <input class="od-input" @bind="newReturn.ReturnReason" placeholder="خرابی، مغایرت، پشیمانی..." />
                    </div>
                    <div class="od-field">
                        <label>یادداشت</label>
                        <input class="od-input" @bind="newReturn.AdminNotes" />
                    </div>
                    <div class="od-field-row">
                        <button class="od-btn od-btn-primary" @onclick="CreateReturn" disabled="@isSaving">
                            @if (isSaving) { <span class="od-btn-spinner"></span> }
                            ثبت مرجوعی
                        </button>
                        <button class="od-btn od-btn-ghost" @onclick="() => showReturnForm = false">انصراف</button>
                    </div>
                </div>
            }

            @if (!order.Returns.Any())
            {
                <div class="od-empty-state">
                    <span class="oi oi-action-undo" style="font-size:1.5rem;color:#94a3b8"></span>
                    <span>مرجوعی ثبت نشده.</span>
                </div>
            }
            else
            {
                <div class="od-returns-list">
                    @foreach (var ret in order.Returns.OrderByDescending(r => r.CreatedAt))
                    {
                        <div class="od-return-card @(ret.IsRefunded ? "od-return-refunded" : "")">
                            <div class="od-return-header">
                                <div>
                                    <span class="od-return-amount">@ret.RefundAmount.ToString("N0") تومان</span>
                                    <span class="od-return-status @(ret.IsRefunded ? "od-return-status-ok" : "od-return-status-pending")">
                                        @(ret.IsRefunded ? "واریز شد" : "در انتظار واریز")
                                    </span>
                                </div>
                                @if (!ret.IsRefunded)
                                {
                                    <div style="display:flex;gap:4px">
                                        <button class="od-btn od-btn-primary od-btn-sm" @onclick="() => ShowRefundForm(ret)">
                                            <span class="oi oi-credit-card"></span> واریز
                                        </button>
                                        <button class="od-btn od-btn-ghost od-btn-sm od-btn-danger" @onclick="() => ConfirmDeleteReturn(ret)">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(ret.RefundCardNumber))
                            {
                                <div class="od-return-info">
                                    <span class="od-return-info-label">شماره کارت:</span>
                                    <span class="od-return-info-value ltr">@ret.RefundCardNumber</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(ret.RefundBankName))
                            {
                                <div class="od-return-info">
                                    <span class="od-return-info-label">بانک:</span>
                                    <span class="od-return-info-value">@ret.RefundBankName</span>
                                </div>
                            }
                            @if (ret.RefundDate.HasValue)
                            {
                                <div class="od-return-info">
                                    <span class="od-return-info-label">تاریخ واریز:</span>
                                    <span class="od-return-info-value">@PersianDate.ToJalaliDateTime(ret.RefundDate.Value)</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(ret.RefundReceiptImageUrl))
                            {
                                <div class="od-return-info">
                                    <span class="od-return-info-label">رسید واریزی:</span>
                                    <a class="od-return-info-value" href="@ret.RefundReceiptImageUrl" target="_blank" rel="noopener" style="color:#2563eb;font-weight:700;">
                                        <span class="oi oi-external-link"></span> مشاهده تصویر رسید
                                    </a>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(ret.ReturnReason))
                            {
                                <div class="od-return-info">
                                    <span class="od-return-info-label">دلیل:</span>
                                    <span class="od-return-info-value">@ret.ReturnReason</span>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(ret.AdminNotes))
                            {
                                <div class="od-return-info">
                                    <span class="od-return-info-label">یادداشت:</span>
                                    <span class="od-return-info-value" dir="rtl" style="white-space:pre-wrap;unicode-bidi:plaintext;">@ret.AdminNotes</span>
                                </div>
                            }
                            <div class="od-return-meta">
                                ثبت توسط: @(ret.CreatedBy ?? "سیستم") | @PersianDate.ToJalaliDateTime(ret.CreatedAt)
                            </div>
                        </div>
                    }
                </div>
            }
            }
        </div>
        }

        <div class="od-section">
            <div class="od-section-header" @onclick="ToggleT">
                <div class="od-section-title">
                    <span class="od-section-icon oi oi-clock"></span>
                    تاریخچه عملیات
                </div>
                <span class="oi oi-minus od-section-toggle"></span>
            </div>
            @if (IsSectionVisible("t"))
            {
            @if (!order.Events.Any())
            {
                <div class="od-empty-state">
                    <span class="oi oi-clock" style="font-size:1.5rem;color:#94a3b8"></span>
                    <span>رویدادی ثبت نشده است.</span>
                </div>
            }
            else
            {
                <div class="od-events">
                    @foreach (var evt in order.Events.OrderByDescending(e => e.CreatedAt).Take(10))
                    {
                        <div class="od-event-row">
                            <div class="od-event-icon @GetEventIconClass(evt.EventType)">
                                <span class="oi @GetEventIcon(evt.EventType)"></span>
                            </div>
                            <div class="od-event-body">
                                <div class="od-event-top">
                                    <span class="od-event-label">@GetEventLabel(evt)</span>
                                    <span class="od-event-time">@PersianDate.ToJalaliDateTime(evt.CreatedAt)</span>
                                </div>
                                @if (!string.IsNullOrEmpty(evt.DisplayMessage))
                                {
                                    <div class="od-event-msg">@evt.DisplayMessage</div>
                                }
                                <div class="od-event-by">@(evt.CreatedBy ?? "سیستم")</div>
                            </div>
                        </div>
                    }
                </div>
            }
            }
        </div>

        @if (CanShowDangerZone())
        {
            <div class="od-danger-zone">
                <h6 style="color:#dc2626;font-weight:700;margin:0 0 8px 0">عملیات خطرناک</h6>
                <button class="od-btn od-btn-danger" @onclick="() => showDeleteConfirm = true">
                    <span class="oi oi-trash"></span> حذف سفارش
                </button>
            </div>
        }
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="حذف سفارش"
               Message="@($"آیا از حذف سفارش #{order?.OrderNumber} اطمینان دارید؟ این عمل غیرقابل بازگشت است.")"
               ConfirmText="بله، حذف شود"
               IsDanger="true"
               OnResult="HandleDeleteResult" />

<ConfirmDialog IsVisible="showDeleteShipmentConfirm"
               Title="حذف مرسوله"
               Message="آیا از حذف این مرسوله اطمینان دارید؟"
               ConfirmText="بله، حذف شود"
               IsDanger="true"
               OnResult="HandleDeleteShipmentResult" />

@if (showRefundModal)
{
    <div class="od-modal-overlay" @onclick="() => showRefundModal = false">
        <div class="od-modal" @onclick:stopPropagation>
            <div class="od-modal-header">
                <h6 class="od-modal-title">ثبت واریز مرجوعی</h6>
                <button class="btn-close" @onclick="() => showRefundModal = false"></button>
            </div>
            <div class="od-modal-body">
                <div style="background:#f0fdf4;border-radius:10px;padding:12px;margin-bottom:16px;">
                    <div style="font-size:0.82rem;color:#64748b;">مبلغ مرجوعی</div>
                    <div style="font-size:1.1rem;font-weight:800;color:#059669;">@returnToRefund?.RefundAmount.ToString("N0") تومان</div>
                </div>
                <div class="od-field">
                    <label>شماره کارت/حساب مقصد *</label>
                    <input class="od-input ltr" @bind="refundInfo.RefundCardNumber" placeholder="6037..." />
                </div>
                <div class="od-field">
                    <label>نام بانک</label>
                    <input class="od-input" @bind="refundInfo.RefundBankName" placeholder="ملی، ملت،..." />
                </div>
                <div class="od-field">
                    <label>تاریخ واریز (شمسی)</label>
                    <input class="od-input ltr" data-jdp autocomplete="off" placeholder="1404/01/01" @bind="refundDateText" @bind:event="oninput" />
                </div>
                <div class="od-field">
                    <label>عکس رسید واریزی</label>
                    <ImageUploader ImageUrl="@refundReceiptUrl"
                                   ImageUrlChanged="@(u => refundReceiptUrl = u)"
                                   UploadUrl="api/orders/admin/returns/receipt"
                                   MaxSizeMb="5"
                                   ShowCamera="true" />
                </div>
                <div class="od-field">
                    <label>یادداشت</label>
                    <input class="od-input" @bind="refundInfo.AdminNotes" />
                </div>
                <div class="od-field-row">
                    <button class="od-btn od-btn-primary" @onclick="MarkRefunded" disabled="@(isSaving || string.IsNullOrWhiteSpace(refundInfo.RefundCardNumber))">
                        @if (isSaving) { <span class="od-btn-spinner"></span> }
                        تایید واریز
                    </button>
                    <button class="od-btn od-btn-ghost" @onclick="() => showRefundModal = false">انصراف</button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteReturnConfirm"
               Title="حذف مرجوعی"
               Message="@($"آیا از حذف این مرجوعی ({returnToDelete?.RefundAmount.ToString("N0")} تومان) اطمینان دارید؟")"
