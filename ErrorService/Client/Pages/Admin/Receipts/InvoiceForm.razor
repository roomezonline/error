    private string FormatMoney(decimal amount) => amount.ToString("N0");

    private string FormatCardDisplay(string? cardNumber)
    {
        if (string.IsNullOrEmpty(cardNumber) || cardNumber.Length < 4) return "";
        var clean = cardNumber.Replace("-", "").Replace(" ", "");
        var first = clean.Length >= 4 ? clean[..4] : clean;
        var last = clean.Length >= 4 ? clean[^4..] : clean;
        return $"({first}-****-{last})";
    }

    private void OnUnitPriceInput(ChangeEventArgs e, InvoiceItem item)
    {
        var digits = NormalizeDigits(e.Value?.ToString());
        item.UnitPrice = digits.Length == 0 || !long.TryParse(digits, out var result) ? 0 : result;
        _moneyRaw[item] = FormatDigits(digits);
    }

    private static string NormalizeDigits(string? raw)
    {
        if (string.IsNullOrEmpty(raw)) return "";
        var sb = new System.Text.StringBuilder(raw.Length);
        foreach (var ch in raw)
        {
            if (ch >= '0' && ch <= '9') sb.Append(ch);
            else if (ch >= '\u06F0' && ch <= '\u06F9') sb.Append((char)(ch - 0x06F0 + '0'));
            else if (ch >= '\u0660' && ch <= '\u0669') sb.Append((char)(ch - 0x0660 + '0'));
        }
        return sb.ToString();
    }

    private static string FormatDigits(string digits)
    {
        if (digits.Length == 0) return "";
        var first = digits.Length % 3;
        var sb = new System.Text.StringBuilder(digits.Length + digits.Length / 3);
        var i = 0;
        if (first > 0) { sb.Append(digits, 0, first); i = first; }
        for (; i < digits.Length; i += 3)
        {
            if (sb.Length > 0) sb.Append(',');
            sb.Append(digits, i, 3);
        }
        return sb.ToString();
    }

    private static long ParseDigits(string? raw)
    {
        var digits = NormalizeDigits(raw);
        return digits.Length == 0 || !long.TryParse(digits, out var v) ? 0 : v;
    }

    private readonly Dictionary<object, string> _moneyRaw = new();

    private string MoneyText(object key, long value)
        => _moneyRaw.TryGetValue(key, out var raw) ? raw : FormatMoney(value);

    private void OnMoneyBlur(object key) => _moneyRaw.Remove(key);

