@page "/admin/receipts/monitoring/{ReceiptId:int}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.monitoring.view")]
@attribute [Authorize(Roles = "super_admin,workshop_manager")]
@implements IDisposable
@using ErrorService.Shared
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ErrorService.Client.Services.ToastService ToastService
@inject ErrorService.Client.Services.AdminWorkshopSelectionService AdminWorkshopSelection
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>اتصال به مانیتورینگ</PageTitle>

<div class="rm-page" dir="rtl">
    <div class="rm-header">
        <button class="rm-back" @onclick='() => Navigation.NavigateTo("/admin/receipts")'>
            <span class="oi oi-arrow-right"></span>
        </button>
        <div class="rm-header__title">
            <div class="rm-header__kicker">مدیریت پایش</div>
            <div class="rm-header__main">اتصال رسید به دستگاه</div>
        </div>
        @if (isSuperAdmin)
        {
            <button class="rm-back" @onclick="RefreshData" style="margin-right: auto;" title="بروزرسانی با کارگاه جدید">
                <span class="oi oi-reload"></span>
            </button>
        }
    </div>

    @if (isLoading)
    {
        <div class="rm-card rm-card--loading">
            <div class="spinner-border text-primary"></div>
            <div class="rm-loading-text">در حال دریافت اطلاعات...</div>
        </div>
    }
    else if (receipt == null)
    {
        <div class="rm-card rm-card--error">
            <div class="rm-error-text">رسید مورد نظر یافت نشد.</div>
        </div>
    }
    else
    {
        <div class="rm-card rm-info-card">
            <div class="rm-info-grid">
                <div class="rm-info-section">
                    <div class="rm-info-icon rm-info-icon--user">
                        <span class="oi oi-person"></span>
                    </div>
                    <div>
                        <div class="rm-info-label">مشتری</div>
                        <div class="rm-info-value">@receipt.CustomerFirstName @receipt.CustomerLastName</div>
                        <div class="rm-info-sub">@receipt.CustomerMobile</div>
                    </div>
                </div>
                <div class="rm-info-section">
                    <div class="rm-info-icon rm-info-icon--device">
                        <span class="oi oi-monitor"></span>
                    </div>
                    <div>
                        <div class="rm-info-label">دستگاه مشتری</div>
                        <div class="rm-info-value">@receipt.DeviceTypeName</div>
                        <div class="rm-info-sub">@receipt.DeviceBrandName</div>
                    </div>
                </div>
            </div>
            <div class="rm-info-footer">
                <div class="rm-info-badge">شماره رسید: #@receipt.Id</div>
                <div class="rm-info-badge">تاریخ ثبت: @PersianDateHelper.ToPersianDateTimeString(receipt.RegisteredAt)</div>
            </div>
        </div>

        <div class="rm-card rm-selection-card">
            <div class="rm-card-head">
                <div class="rm-card-title">
                    <span class="oi oi-pulse"></span>
                    انتخاب دستگاه مانیتورینگ کارگاه
                </div>
                <div class="rm-card-subtitle">دستگاه‌های فعال و متصل به این کارگاه را در زیر مشاهده می‌کنید.</div>
                @if (isSuperAdmin)
                {
                    <div class="rm-info-badge" style="margin-top: 10px; background: #4f46e5; color: white;">
                        کارگاه انتخاب شده: @(selectedWorkshopId.HasValue ? selectedWorkshopId.Value.ToString() : "انتخاب نشده")
                    </div>
                }
            </div>

            @if (activeMonitoringDevices == null || !activeMonitoringDevices.Any())
            {
                <div class="rm-empty-state">
                    <div class="rm-empty-icon">
                        <span class="oi oi-warning"></span>
                    </div>
                    <div class="rm-empty-text">هیچ دستگاه مانیتورینگ فعالی برای این کارگاه تعریف نشده است.</div>
                    <button class="rm-btn rm-btn--outline" @onclick='() => Navigation.NavigateTo("/admin/monitoring")'>مدیریت دستگاه‌ها</button>
                </div>
            }
            else
            {
                <div class="rm-selection-list">
                    @foreach (var dev in activeMonitoringDevices)
                    {
                        <label class="rm-device-option @(selectedDeviceId == dev.Id ? "is-selected" : "")">
                            <input type="radio" name="monitoringDevice" value="@dev.Id"
                                   checked="@(selectedDeviceId == dev.Id)"
                                   @onchange="() => selectedDeviceId = dev.Id" />
                            <div class="rm-device-content">
                                <div class="rm-device-main">
                                    <div class="rm-device-title">@dev.Title</div>
                                </div>
                                <div class="rm-device-status">
                                    <span class="rm-status-dot"></span>
                                    آماده اتصال
                                </div>
                            </div>
                            <div class="rm-device-check">
                                <span class="oi oi-check"></span>
                            </div>
                        </label>
                    }
                </div>

                @if (_capacityFull)
                {
                    <div class="rm-capacity-warning">
                        <div class="rm-capacity-warning__icon">⚠️</div>
                        <div class="rm-capacity-warning__text">
                            <div class="rm-capacity-warning__title">ظرفیت مانیتورینگ این کارگاه تکمیل است</div>
                            <div class="rm-capacity-warning__desc">
                                تعداد مانیتورینگ‌های این کارگاه (@_workshopUsed) به حداکثر مجاز (@_workshopMax) رسیده است.
                                برای شروع مانیتورینگ جدید:
                            </div>
                            <ol class="rm-capacity-warning__steps">
                                <li>دیتای یکی از مانیتورینگ‌های قدیمی را <strong>دانلود</strong> کنید</li>
                                <li>سپس آن مانیتورینگ را <strong>حذف</strong> کنید</li>
                                <li>حالا می‌توانید مانیتورینگ جدید شروع کنید</li>
                            </ol>
                            <a href="/admin/monitoring/active-receipts?workshopId=@_targetWorkshopId" class="rm-capacity-warning__link">مدیریت مانیتورینگ‌های کارگاه</a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="rm-capacity-info">ظرفیت مانیتورینگ: @_workshopUsed از @_workshopMax</div>
                }

                <div class="rm-actions">
                    <button class="rm-btn rm-btn--primary rm-btn--lg" @onclick="ConfirmConnection" disabled="@(selectedDeviceId == 0 || isSubmitting || _capacityFull)">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>در حال تایید...</span>
                        }
                        else
                        {
                            <span>تایید اتصال به مانیتورینگ</span>
                        }
                    </button>
                </div>
            }
        </div>
    }
</div>

<style>
