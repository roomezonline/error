@if (showCustomerSummaryModal && customerSummaryReceipt != null)
{
    <div class="cs-modal-overlay" @onclick="CloseCustomerSummary"></div>
    <div class="cs-modal" @onclick:stopPropagation>
            <div class="cs-modal__header">
                <div class="cs-modal__hero">
                    <div class="cs-avatar">@GetCustomerInitial(customerSummaryReceipt)</div>
                    <div>
                        <div class="cs-modal__title">@customerSummaryReceipt.CustomerFirstName @customerSummaryReceipt.CustomerLastName</div>
                        <div class="cs-modal__mobile ltr">@customerSummaryReceipt.CustomerMobile</div>
                    </div>
                </div>
                <button class="cs-modal__close" @onclick="CloseCustomerSummary"><span class="oi oi-x"></span></button>
            </div>

            <div class="cs-modal__body">
                @if (isLoadingCustomerSummary)
                {
                    <div class="cs-loading">
                        <div class="spinner-border text-primary"></div>
                        <div class="cs-loading__text">در حال دریافت اطلاعات...</div>
                    </div>
                }
                else
                {
                    <div class="cs-sections">
                        <!-- Customer Info Section -->
                        <div class="cs-section">
                            <div class="cs-section__header">
                                <span class="oi oi-person cs-section__icon"></span>
                                <span>اطلاعات مشتری</span>
                            </div>
                            <div class="cs-info-grid">
                                <div class="cs-info-item">
                                    <div class="cs-info-label">نام و نام خانوادگی</div>
                                    <div class="cs-info-value">@customerSummaryReceipt.CustomerFirstName @customerSummaryReceipt.CustomerLastName</div>
                                </div>
                                <div class="cs-info-item">
                                    <div class="cs-info-label">شماره موبایل</div>
                                    <div class="cs-info-value ltr">@customerSummaryReceipt.CustomerMobile</div>
                                </div>
                                <div class="cs-info-item cs-info-item--full">
                                    <div class="cs-info-label">آدرس</div>
                                    <div class="cs-info-value">@(customerSummaryReceipt.CustomerAddress ?? "ثبت نشده")</div>
                                </div>
                            </div>
                        </div>

                        <!-- Financial Summary Section -->
                        @if (customerFinancialSummary != null)
                        {
                            <div class="cs-section">
                                <div class="cs-section__header">
                                    <span class="oi oi-calculator cs-section__icon"></span>
                                    <span>خلاصه مالی</span>
                                </div>
                                <div class="cs-financial-grid">
                                    <div class="cs-fin-card cs-fin-card--total">
                                        <div class="cs-fin-card__label">مجموع کل</div>
                                        <div class="cs-fin-card__value ltr">@customerFinancialSummary.TotalBill.ToString("N0")</div>
                                        <div class="cs-fin-card__unit">تومان</div>
                                    </div>
                                    <div class="cs-fin-card cs-fin-card--paid">
                                        <div class="cs-fin-card__label">پرداختی</div>
                                        <div class="cs-fin-card__value ltr">@customerFinancialSummary.TotalPaid.ToString("N0")</div>
                                        <div class="cs-fin-card__unit">تومان</div>
                                    </div>
                                    <div class="cs-fin-card cs-fin-card--remaining @(customerFinancialSummary.TotalRemaining > 0 ? "cs-fin-card--debtor" : "cs-fin-card--creditor")">
                                        <div class="cs-fin-card__label">@(customerFinancialSummary.TotalRemaining > 0 ? "بدهی" : "طلب")</div>
                                        <div class="cs-fin-card__value ltr">@Math.Abs(customerFinancialSummary.TotalRemaining).ToString("N0")</div>
                                        <div class="cs-fin-card__unit">تومان</div>
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Receipts History Section -->
                        @if (customerAllReceipts != null && customerAllReceipts.Any())
                        {
                            <div class="cs-section">
                                <div class="cs-section__header">
                                    <span class="oi oi-list cs-section__icon"></span>
                                    <span>سابقه رسیدها (@customerAllReceipts.Count)</span>
                                </div>
                                <div class="cs-receipts-list">
                                    @foreach (var receipt in customerAllReceipts.OrderByDescending(r => r.RegisteredAt))
                                    {
                                        <div class="cs-receipt-acc @(csExpandedReceiptId == receipt.Id ? "cs-receipt-acc--open" : "")">
                                            <button type="button" class="cs-receipt-item" @onclick="() => ToggleCsReceiptExpand(receipt)">
                                                <div class="cs-receipt-item__row">
                                                    <div class="cs-receipt-item__main">
                                                        <div class="cs-receipt-item__device">
                                    <span class="oi oi-monitor"></span>
                                                            @receipt.DeviceTypeName @if (!string.IsNullOrWhiteSpace(receipt.DeviceBrandName)) { <span> - @receipt.DeviceBrandName</span> }
                                                        </div>
                                                    </div>
                                                    <div class="cs-receipt-item__status">
                                                        <span class="cs-chip @ChipClass(receipt.Status)">@StatusFa(receipt.Status)</span>
                                                    </div>
                                                </div>
                                                <div class="cs-receipt-item__bottom">
                                                    <div class="cs-receipt-item__date">@PersianDateHelper.ToPersianDateTimeString(receipt.RegisteredAt, includeTime: true)</div>
                                                    <div class="cs-receipt-item__more">@(csExpandedReceiptId == receipt.Id ? "بستن" : "جزئیات")</div>
                                                </div>
                                            </button>
                                            @if (csExpandedReceiptId == receipt.Id)
                                            {
                                                <div class="rl-details cs-receipt-details">
                                                    @if (csLoadingDetailsReceiptId == receipt.Id && !billingCache.ContainsKey(receipt.Id))
                                                    {
                                                        <div class="rl-details-loading">
                                                            <span class="oi oi-loop-circular rl-spin"></span>
                                                            در حال بارگذاری جزئیات...
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="rl-details-grid">
                                                            <div class="rl-details-info">
                                                                <div class="rl-info-header">
                                                                    <span class="oi oi-info rl-info-icon"></span>
                                                                    <span>اطلاعات رسید</span>
                                                                </div>
                                                                <div class="rl-info-grid">
                                                                    <div class="rl-info-item">
                                                                        <div class="rl-info-label">تکنیسین</div>
                                                                        <div class="rl-info-value">@(receipt.TechnicianName ?? "نامشخص")</div>
                                                                    </div>
                                                                    <div class="rl-info-item">
                                                                        <div class="rl-info-label">پذیرش توسط</div>
                                                                        <div class="rl-info-value">@(string.IsNullOrWhiteSpace(receipt.CreatedByUserName) ? "-" : receipt.CreatedByUserName)</div>
                                                                    </div>
                                                                    <div class="rl-info-item rl-info-item--full">
                                                                        <div class="rl-info-label">شرح مشکل</div>
                                                                        <div class="rl-info-value rl-problem">
                                                                            @{
                                                                                var problemLines = (receipt.ProblemDescription ?? "").Split(new[] { "\n\n---\n" }, StringSplitOptions.None);
                                                                                if (problemLines.Length > 1)
                                                                                {
                                                                                    <div>@problemLines[0]</div>
                                                                                    <div class="text-danger mt-2 fw-bold" style="border-top: 1px dashed #fee2e2; padding-top: 8px;">
                                                                                        @problemLines[1].Replace("یادداشت ارجاع 2:", "").Trim()
                                                                                    </div>
                                                                                }
                                                                                else
                                                                                {
                                                                                    @(receipt.ProblemDescription ?? "-")
                                                                                }
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                            @if (billingCache.TryGetValue(receipt.Id, out var csBilling))
                                                            {
                                                                @if (csBilling.Items != null && csBilling.Items.Any())
                                                                {
                                                                    <div class="rl-details-table-wrap">
                                                                        <div class="rl-table-header">
                                                                            <span class="oi oi-spreadsheet"></span>
                                                                            <span>آیتم‌های فاکتور</span>
                                                                        </div>
                                                                        <div class="rl-table-container">
                                                                            <table class="rl-table">
                                                                                <thead>
                                                                                    <tr>
                                                                                        <th>ردیف</th>
                                                                                        <th>عنوان</th>
                                                                                        <th class="text-left">مبلغ</th>
                                                                                    </tr>
                                                                                </thead>
                                                                                <tbody>
                                                                                    @{ var csIndex = 1; }
                                                                                    @foreach (var inv in csBilling.Items)
                                                                                    {
                                                                                        <tr>
                                                                                            <td class="text-center">@(csIndex++)</td>
                                                                                            <td style="color: crimson;font-weight: bold;">@inv.Title</td>
<td class="text-right ltr rl-price">@inv.UnitPrice.ToString("N0")</td>
                                                                                        </tr>
                                                                                    }
                                                                                </tbody>
                                                                            </table>
                                                                        </div>
                                                                    </div>
                                                                }

                                                                <div class="rl-details-summary">
                                                                    <div class="rl-summary-header">
                                                                        <span class="oi oi-calculator"></span>
                                                                        <span>خلاصه مالی</span>
                                                                    </div>
                                                                    @{
                                                                        var csPayable = csBilling.BillTotal - csBilling.Discount;
                                                                        var csRemaining = csPayable - csBilling.Prepaid - csBilling.Paid;
                                                                    }
                                                                    <div class="rl-summary-grid">
                                                                        <div class="rl-s-row">
                                                                            <span class="rl-s-label">مبلغ کل:</span>
                                                                            <span class="rl-s-value ltr">@csBilling.BillTotal.ToString("N0")</span>
                                                                        </div>
                                                                        <div class="rl-s-row">
                                                                            <span class="rl-s-label">تخفیف:</span>
                                                                            <span class="rl-s-value ltr rl-discount">-@csBilling.Discount.ToString("N0")</span>
                                                                        </div>
                                                                        <div class="rl-s-row rl-s-row--total">
                                                                            <span class="rl-s-label">قابل پرداخت:</span>
                                                                            <span class="rl-s-value ltr">@csPayable.ToString("N0")</span>
                                                                        </div>
                                                                        <div class="rl-s-row rl-s-row--paid">
                                                                            <span class="rl-s-label">پرداختی:</span>
                                                                            <span class="rl-s-value ltr rl-paid">@((csBilling.Prepaid + csBilling.Paid).ToString("N0"))</span>
                                                                        </div>
                                                                        <div class="rl-s-row rl-s-row--rem @(csRemaining > 0 ? "rl-debtor" : "rl-creditor")">
                                                                            <span class="rl-s-label">@(csRemaining >= 0 ? "مانده:" : "طلب مشتری:")</span>
                                                                            <span class="rl-s-value ltr">@Math.Abs(csRemaining).ToString("N0")</span>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            }

                                                            <div class="rl-details-actions">
                                                                <AuthorizeView Policy="perm:admin.receipts.manage">
                                                                    <button type="button" class="rl-btn-edit" @onclick="() => EditReceiptFromSummary(receipt)">
                                                                        <span class="oi oi-pencil"></span> ویرایش رسید
                                                                    </button>
                                                                    <button type="button" class="rl-btn-invoice" @onclick='() => Navigation.NavigateTo($"/admin/receipts/invoice/{receipt.Id}")'>
                                                                        <span class="oi oi-spreadsheet"></span> مدیریت فاکتور
                                                                    </button>
                                                                </AuthorizeView>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
