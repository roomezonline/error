        .order-item-name { font-size: 0.75rem; -webkit-line-clamp: 1; }
        .order-item-price { font-size: 0.75rem; }
        .qty-badge { width: 20px; height: 20px; font-size: 0.65rem; }
        .price-breakdown { gap: 6px; padding: 10px 0; }
        .price-row { font-size: 0.76rem; }
        .price-total { padding: 10px 0 0; }
        .price-total span:first-child { font-size: 0.82rem; }
        .price-total-amount { font-size: 1rem; }
        .coupon-section { padding: 10px 0; }
        .coupon-input { padding: 8px 10px; font-size: 0.76rem; }
        .coupon-btn { padding: 8px 14px; font-size: 0.76rem; }
        .info-note { padding: 10px 12px; margin-top: 14px; font-size: 0.72rem; }
        .pm-grid { grid-template-columns: 1fr; }
        .checkout-submit-section {
            position: fixed; bottom: 0; left: 0; right: 0; z-index: 1200;
            padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
            background: var(--shop-surface, #fff);
            border-top: 1px solid #e2e8f0;
            box-shadow: 0 -4px 20px rgba(0,0,0,0.06);
        }
        .checkout-submit-section .btn-primary-custom {
            font-size: 0.82rem; padding: 12px 20px !important; border-radius: 12px;
        }
        .checkout-main { padding-bottom: 80px; }
    }

    @@media (min-width: 769px) {
        .checkout-grid {
            flex-direction: row; align-items: flex-start; gap: 24px;
        }
        .checkout-main { flex: 0 0 58%; max-width: 58%; order: 1; }
        .checkout-sidebar { flex: 0 0 40%; max-width: 40%; order: 2; position: sticky; top: 90px; }
        .checkout-submit-section { margin-top: 0; border-radius: 16px; border: 1px solid #e2e8f0; background: var(--shop-surface, #fff); padding: 16px 24px; }

        .section-card { padding: 28px; }
        .summary-card { padding: 24px; }
        .section-header { margin-bottom: 28px; }
    }
    .co-fs { display: flex; align-items: center; gap: .75rem; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: .75rem; padding: .7rem .85rem; margin-top: .7rem; color: #1e40af; }
    .co-fs .oi { font-size: 1.25rem; color: #2563eb; }
    .co-fs__body { flex: 1; }
    .co-fs strong { display: block; font-size: .82rem; }
    .co-fs__track { margin-top: .4rem; height: 6px; background: #dbeafe; border-radius: 999px; overflow: hidden; }
    .co-fs__fill { display: block; height: 100%; background: linear-gradient(90deg, #2563eb, #22d3ee); border-radius: 999px; transition: width .4s ease; }
    .co-fs--done { background: #f0fdf4; border-color: #bbf7d0; color: #166534; }
    .co-fs--done .oi { color: #16a34a; }
</style>

@code {
    private OrderCreateRequest request = new();
    private bool isProcessing = false;
    private EditContext? editContext;

    // کلید یکتای هر بار باز شدن صفحهٔ پرداخت: ارسال دوباره (کلیک مجدد،
    // تایم‌اوت شبکه، Refresh با POST) سفارش دوم نمی‌سازد.
    private string? _idempotencyKey;

    private string _couponInput = "";
    private string _couponCode = "";
    private decimal _couponDiscount;
    private decimal? _couponPercent;
    private bool _couponApplied;
    private bool _couponLoading;
    private string _couponMessage = "";

    private List<PaymentGatewayListItemDto> _gateways = new();
    private int? _selectedGatewayId;

    private List<ShippingMethodDto> _shippingMethods = new();
    private int? _selectedShippingMethodId;
    private SiteSettingsDto? _shop;
    private List<ProvinceDto> _provinces = new();
    private List<CityDto> _cities = new();
    private bool _citiesLoading;

    private bool StructuredAddressEnabled => _shop?.EnableStructuredAddress == true;
    private bool RequireProvinceCity => _shop?.RequireProvinceCity == true;
    private bool RequirePostalCode => _shop?.RequirePostalCode == true;

    private string AddressRegionText
    {
        get
        {
            var province = _provinces.FirstOrDefault(p => p.Id == request.ProvinceId)?.Name;
            var city = _cities.FirstOrDefault(c => c.Id == request.CityId)?.Name;
            if (string.IsNullOrWhiteSpace(province)) return city ?? string.Empty;
            return string.IsNullOrWhiteSpace(city) ? province : $"{province} - {city}";
        }
    }

    private bool FreeShippingEnabled =>
        _shop != null && _shop.EnableFreeShipping && (_shop.FreeShippingThreshold ?? 0) > 0;
    private decimal _shippingCost => _shippingMethods.FirstOrDefault(m => m.Id == _selectedShippingMethodId)?.Price ?? 0;
    private bool _shippingIsFree => _shippingMethods.FirstOrDefault(m => m.Id == _selectedShippingMethodId)?.IsFree == true;
    private bool ReachedFreeShippingThreshold =>
        FreeShippingEnabled && CartService.GetTotalAmount() >= (_shop!.FreeShippingThreshold ?? decimal.MaxValue);
    // همان قاعده‌ای که سرور در CreateOrder اعمال می‌کند؛ تا مبلغ نمایش‌داده‌شده
    // با مبلغی که درگاه/سفارش ثبت می‌شود یکسان باشد.
    private decimal EffectiveShippingCost =>
        _shippingIsFree || ReachedFreeShippingThreshold ? 0 : _shippingCost;
    private string _shippingName => _shippingMethods.FirstOrDefault(m => m.Id == _selectedShippingMethodId)?.Name ?? "در انتظار انتخاب";

    private void SelectManual() { _selectedGatewayId = null; _ = SaveDraftAsync(); }
    private void SelectGateway(int id) { _selectedGatewayId = id; _ = SaveDraftAsync(); }

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(request);
        editContext.OnFieldChanged += OnFormFieldChanged;
        _idempotencyKey = Guid.NewGuid().ToString("N");

        try
        {
            _shippingMethods = await Http.GetFromJsonAsync<List<ShippingMethodDto>>("api/shippingmethods") ?? new();
            if (_shippingMethods.Any() && _selectedShippingMethodId == null)
                _selectedShippingMethodId = _shippingMethods.First().Id;
        }
        catch { }

        try
        {
            var settings = await Http.GetFromJsonAsync<SiteSettingsDto>("api/sitesettings");
            _shop = settings;
            var allowGuest = settings?.AllowGuestCheckout ?? true;
            var me = await AuthService.GetMeAsync();
            if (me == null)
            {
                if (!allowGuest)
                {
                    Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString("/checkout")}");
                }
                return;
            }
            request.FullName = me.FullName;
            request.PhoneNumber = me.PhoneNumber;
            request.Email = me.Email;
            request.Address = me.Address;
            if (!string.IsNullOrWhiteSpace(me.PostalCode)) request.PostalCode = me.PostalCode;
            await InvokeAsync(StateHasChanged);
        }
        catch { }

        if (StructuredAddressEnabled)
            await LoadProvincesAsync();

        try
        {
            _gateways = await Http.GetFromJsonAsync<List<PaymentGatewayListItemDto>>("api/payment/gateways") ?? new();
        }
        catch { _gateways = new(); }

        await RestoreDraftAsync();
    }

    // ─────────── بازیابی و ذخیرهٔ پیش‌نویس تکمیل سفارش ───────────
    private bool _resumedDraft;

    private void OnFormFieldChanged(object? sender, FieldChangedEventArgs e) => _ = SaveDraftAsync();

    private Task SaveDraftAsync() => Recovery.SaveDraftAsync(new CheckoutDraft
    {
        FullName = request.FullName,
        PhoneNumber = request.PhoneNumber,
        Email = request.Email,
        Address = request.Address,
        ProvinceId = request.ProvinceId,
        CityId = request.CityId,
        PostalCode = request.PostalCode,
        ShippingMethodId = _selectedShippingMethodId,
        GatewayId = _selectedGatewayId,
        CouponCode = _couponApplied ? _couponCode : null,
        IdempotencyKey = _idempotencyKey
    });

    /// <summary>فرمی کاربر وسط کار رها کرده بود را برمی‌گرداند و همان بخش را برجسته می‌کند.</summary>
    private async Task RestoreDraftAsync()
    {
        try
        {
            var draft = await Recovery.LoadDraftAsync();
            if (draft == null) return;

            if (!string.IsNullOrWhiteSpace(draft.IdempotencyKey))
                _idempotencyKey = draft.IdempotencyKey;

            var hasContent = !string.IsNullOrWhiteSpace(draft.FullName)
                || !string.IsNullOrWhiteSpace(draft.PhoneNumber)
                || !string.IsNullOrWhiteSpace(draft.Address)
                || draft.ProvinceId.HasValue
                || !string.IsNullOrWhiteSpace(draft.PostalCode)
                || draft.ShippingMethodId.HasValue
                || draft.GatewayId.HasValue
                || !string.IsNullOrWhiteSpace(draft.CouponCode);
            if (!hasContent) return;

            if (!string.IsNullOrWhiteSpace(draft.FullName)) request.FullName = draft.FullName;
            if (!string.IsNullOrWhiteSpace(draft.PhoneNumber)) request.PhoneNumber = draft.PhoneNumber;
            if (!string.IsNullOrWhiteSpace(draft.Email)) request.Email = draft.Email;
            if (!string.IsNullOrWhiteSpace(draft.Address)) request.Address = draft.Address;
            if (!string.IsNullOrWhiteSpace(draft.PostalCode)) request.PostalCode = draft.PostalCode;

            if (draft.ProvinceId.HasValue && _provinces.Any(p => p.Id == draft.ProvinceId.Value))
            {
                request.ProvinceId = draft.ProvinceId;
                await LoadCitiesAsync(draft.ProvinceId.Value);
                if (draft.CityId.HasValue && _cities.Any(c => c.Id == draft.CityId.Value))
                    request.CityId = draft.CityId;
            }

            if (draft.ShippingMethodId.HasValue && _shippingMethods.Any(m => m.Id == draft.ShippingMethodId.Value))
                _selectedShippingMethodId = draft.ShippingMethodId;
            request.ShippingMethodId = _selectedShippingMethodId;

            if (draft.GatewayId.HasValue && _gateways.Any(g => g.Id == draft.GatewayId.Value))
                _selectedGatewayId = draft.GatewayId;

            if (!string.IsNullOrWhiteSpace(draft.CouponCode))
            {
                _couponInput = draft.CouponCode.Trim();
                await ApplyCoupon();
            }

            _resumedDraft = true;
            await InvokeAsync(StateHasChanged);
            await HighlightResumeStepAsync();
            ToastService.ShowInfo("اطلاعات قبلی شما بازیابی شد؛ از همان‌جا ادامه دهید");
        }
        catch { }
    }

    /// <summary>اولین مرحلهٔ ناتمام تسویه را اسکرول کرده و چند ثانیه برجسته می‌کند.</summary>
    private async Task HighlightResumeStepAsync()
    {
        var receiverIncomplete = string.IsNullOrWhiteSpace(request.FullName)
            || string.IsNullOrWhiteSpace(request.PhoneNumber)
            || string.IsNullOrWhiteSpace(request.Address);
        var target = receiverIncomplete ? "co-step-receiver"
            : _selectedShippingMethodId == null ? "co-step-shipping"
            : "co-step-payment";

        await Task.Delay(300);
        await JS.InvokeVoidAsync("eval", @"
            (function(){
                var el = document.getElementById('" + target + @"');
                if (!el) return;
                el.scrollIntoView({behavior:'smooth', block:'center'});
                el.classList.add('co-highlight');
                setTimeout(function(){ el.classList.remove('co-highlight'); }, 3500);
            })();");
    }

    private void SelectShippingMethod(int id)
    {
        _selectedShippingMethodId = id;
        request.ShippingMethodId = id;
        _ = SaveDraftAsync();
    }

    // ─────────── آدرس ساختاریافته (استان/شهر/کد پستی) ───────────
    private async Task LoadProvincesAsync()
    {
        try { _provinces = await Http.GetFromJsonAsync<List<ProvinceDto>>("api/locations/provinces") ?? new(); }
        catch { _provinces = new(); }
    }

    private async Task LoadCitiesAsync(int provinceId)
    {
        _citiesLoading = true;
        StateHasChanged();
        try { _cities = await Http.GetFromJsonAsync<List<CityDto>>($"api/locations/cities/{provinceId}") ?? new(); }
        catch { _cities = new(); }
        finally { _citiesLoading = false; }
    }

    private async Task OnProvinceChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        request.ProvinceId = int.TryParse(value, out var id) ? id : null;
        request.CityId = null;
        _cities = new();
        if (request.ProvinceId.HasValue)
            await LoadCitiesAsync(request.ProvinceId.Value);
        await SaveDraftAsync();
    }

    private async Task OnCityChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        request.CityId = int.TryParse(value, out var id) ? id : null;
        await SaveDraftAsync();
    }

    private void OnCouponInputChanged(ChangeEventArgs e)
    {
        _couponInput = e.Value?.ToString() ?? "";
        StateHasChanged();
    }

    private async Task ApplyCoupon()
    {
        _couponLoading = true;
        _couponMessage = "";
        try
        {
            var result = await Http.PostAsJsonAsync("api/coupons/apply", new CouponApplyRequest
            {
                Code = _couponInput.Trim(),
                OrderAmount = CartService.GetTotalAmount()
            });
            if (result.IsSuccessStatusCode)
            {
                var data = await result.Content.ReadFromJsonAsync<CouponApplyResult>();
                if (data != null && data.IsValid)
                {
                    _couponApplied = true;
                    _couponCode = _couponInput.Trim();
                    _couponDiscount = data.DiscountAmount ?? 0;
                    _couponPercent = data.Coupon?.DiscountPercent;
                    _couponMessage = data.Message ?? "کد تخفیف اعمال شد";
                    _ = SaveDraftAsync();
                }
                else
                {
                    _couponMessage = data?.Message ?? "کد تخفیف معتبر نیست";
                }
            }
        }
        catch { _couponMessage = "خطا در بررسی کد تخفیف"; }
        finally { _couponLoading = false; }
    }

    private void RemoveCoupon()
    {
        _couponApplied = false;
        _couponCode = "";
        _couponDiscount = 0;
        _couponPercent = null;
        _couponInput = "";
        _couponMessage = "";
        _ = SaveDraftAsync();
    }

    private async Task HandleSubmit()
    {
        if (isProcessing) return;
        if (string.IsNullOrWhiteSpace(request.FullName)) { ToastService.ShowError("نام و نام خانوادگی را وارد کنید"); return; }
        if (request.FullName.Length < 3) { ToastService.ShowError("نام وارد شده بیش از حد کوتاه است"); return; }
        if (string.IsNullOrWhiteSpace(request.PhoneNumber)) { ToastService.ShowError("شماره موبایل را وارد کنید"); return; }
        if (!System.Text.RegularExpressions.Regex.IsMatch(request.PhoneNumber, @"^09\d{9}$")) { ToastService.ShowError("فرمت شماره موبایل صحیح نیست"); return; }
        if (string.IsNullOrWhiteSpace(request.Address)) { ToastService.ShowError("آدرس پستی را وارد کنید"); return; }
        if (request.Address.Length < 10) { ToastService.ShowError("آدرس بسیار کوتاه است"); return; }

        if (StructuredAddressEnabled)
        {
            if (RequireProvinceCity && !request.ProvinceId.HasValue) { ToastService.ShowError("استان را انتخاب کنید"); return; }
            if (RequireProvinceCity && !request.CityId.HasValue) { ToastService.ShowError("شهر را انتخاب کنید"); return; }
            if (request.ProvinceId.HasValue && !request.CityId.HasValue) { ToastService.ShowError("شهر را انتخاب کنید"); return; }

            request.PostalCode = OrderAddressHelper.NormalizePostalCode(request.PostalCode);
            if (RequirePostalCode && !OrderAddressHelper.IsValidPostalCode(request.PostalCode))
            {
                ToastService.ShowError("کد پستی ۱۰ رقمی را کامل وارد کنید");
                return;
            }
            if (!string.IsNullOrEmpty(request.PostalCode) && !OrderAddressHelper.IsValidPostalCode(request.PostalCode))
            {
                ToastService.ShowError("کد پستی باید ۱۰ رقم باشد");
                return;
            }
        }
        else
        {
            request.ProvinceId = null;
            request.CityId = null;
            request.PostalCode = null;
        }

        isProcessing = true;
        try
        {
            request.Items = CartService.GetItems().Select(x => new OrderItemDto { ProductId = x.ProductId, ProductName = x.Name, Price = x.Price, Quantity = x.Quantity }).ToList();
            request.CouponCode = _couponApplied ? _couponCode : null;
            request.ShippingMethodId = _selectedShippingMethodId;
            request.IdempotencyKey = _idempotencyKey ??= Guid.NewGuid().ToString("N");
            // کلید را قبل از ارسال ذخیره می‌کنیم تا اگر پاسخ گم شود، تلاش بعدی
            // همان سفارش را بازیابی کند و سفارش دوم ساخته نشود.
            await SaveDraftAsync();
            var response = await Http.PostAsJsonAsync("api/orders", request);
            if (response.IsSuccessStatusCode)
            {
                var order = await response.Content.ReadFromJsonAsync<OrderDto>();
                if (order != null)
                {
                    await Recovery.ClearDraftAsync();
                    if (!string.IsNullOrWhiteSpace(order.AccessToken))
                        await Recovery.RememberPendingOrderAsync(order.Id, order.OrderNumber, order.AccessToken);

                    if (_selectedGatewayId.HasValue)
                    {
                        var tokenParam = string.IsNullOrWhiteSpace(order.AccessToken) ? "" : Uri.EscapeDataString(order.AccessToken);
                        var intent = await Http.GetFromJsonAsync<PaymentIntentResult>($"api/orders/{order.Id}/payment/intent?gatewayId={_selectedGatewayId.Value}&token={tokenParam}");
                        if (intent?.Success == true && !string.IsNullOrWhiteSpace(intent.GatewayUrl))
                        {
                            await CartService.ClearCartAsync();
                            Nav.NavigateTo(intent.GatewayUrl);
                            return;
                        }
                        ToastService.ShowError(intent?.Message ?? "خطا در ایجاد پرداخت آنلاین؛ به پرداخت کارت‌به‌کارت منتقل می‌شوید.");
                    }

                    await CartService.ClearCartAsync();
                    var accessToken = string.IsNullOrWhiteSpace(order.AccessToken) ? "" : $"?token={Uri.EscapeDataString(order.AccessToken)}";
                    Nav.NavigateTo($"/payment/offline/{order.Id}{accessToken}");
                }
            }
            else
            {
                var errBody = await response.Content.ReadAsStringAsync();
                ToastService.ShowError($"خطا در ثبت سفارش ({(int)response.StatusCode}): {errBody}");
            }
        }
        catch { ToastService.ShowError("خطای ارتباط با سرور"); }
        finally { isProcessing = false; }
    }

    private async Task TriggerFormSubmit()
    {
        if (editContext != null && !editContext.Validate())
        {
            ToastService.ShowError("لطفاً اطلاعات را صحیح وارد کنید");
            return;
        }
        await HandleSubmit();
    }
}
