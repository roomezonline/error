@code {
    [Parameter] public int Id { get; set; }

    private OrderDto? order;
    private bool isLoading = true;
    private bool isSaving = false;
    private bool isEditingInfo = false;
    private OrderUpdateInfoRequest editInfo = new();
    private string statusToUpdate = "";
    private OrderStage? stageToUpdate;
    private string? adminNote;

    private bool showShipmentForm = false;
    private OrderShipmentCreateDto newShipment = new();
    private int? expandedShipmentId = null;

    private bool showDeleteConfirm = false;
    private bool showDeleteShipmentConfirm = false;
    private OrderShipmentDto? shipmentToDelete;

    private bool showReturnForm = false;
    private OrderReturnCreateRequest newReturn = new();
    private bool showRefundModal = false;
    private OrderReturnDto? returnToRefund;
    private OrderReturnRefundRequest refundInfo = new();
    private string refundDateText = "";
    private string? refundReceiptUrl;
    private bool refundJdpReady;
    private bool showDeleteReturnConfirm = false;
    private OrderReturnDto? returnToDelete;

    protected override async Task OnInitializedAsync()
    {
        await LoadOrder();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showRefundModal && !refundJdpReady)
        {
            refundJdpReady = true;
            try { await JS.InvokeVoidAsync("initJalali"); } catch { }
        }
    }

    private async Task LoadOrder()
    {
        isLoading = true;
        try
        {
            order = await Http.GetFromJsonAsync<OrderDto>($"api/orders/admin/{Id}");
            if (order != null)
            {
                var valid = GetValidTransitions();
                statusToUpdate = valid.Count > 0 ? valid[0].ToString() : order.Status.ToString();
                stageToUpdate = order.Stage
                    ?? (order.Status == OrderStatus.Completed ? OrderStage.Resolved
                        : order.Status == OrderStatus.Approved ? OrderStage.PaymentConfirmed : null);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در بارگذاری: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GoBack() => Nav.NavigateTo("/admin/orders");

    private string FormatProvinceCity()
    {
        if (order == null) return "";
        if (string.IsNullOrWhiteSpace(order.ProvinceName) && string.IsNullOrWhiteSpace(order.CityName))
            return "ثبت نشده";
        if (string.IsNullOrWhiteSpace(order.CityName)) return order.ProvinceName!;
        return $"{order.ProvinceName} - {order.CityName}";
    }

    private void StartEditingInfo()
    {
        if (order == null) return;
        editInfo = new OrderUpdateInfoRequest
        {
            FullName = order.FullName, PhoneNumber = order.PhoneNumber, Email = order.Email,
            Address = order.Address ?? "", ProvinceId = order.ProvinceId, CityId = order.CityId,
            ProvinceName = order.ProvinceName, CityName = order.CityName, PostalCode = order.PostalCode
        };
        isEditingInfo = true;
    }

    private async Task SaveInfo()
    {
        if (order == null || isSaving) return;
        isSaving = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/orders/admin/{order.Id}/info", editInfo);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("اطلاعات بروزرسانی شد.");
                isEditingInfo = false;
                await LoadOrder();
            }
            else ToastService.ShowError("خطا در بروزرسانی.");
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private void SelectStage(OrderStage stage)
    {
        stageToUpdate = stage;
    }

    private bool CanShowStageChange() => order != null
        && order.Status is not (OrderStatus.Rejected or OrderStatus.Cancelled or OrderStatus.PendingPayment);

    private async Task UpdateStage()
    {
        if (order == null || isSaving || stageToUpdate == null) return;
        isSaving = true;
        try
        {
            var req = new OrderStageUpdateDto { Stage = stageToUpdate.Value, AdminNotes = adminNote };
            var resp = await Http.PutAsJsonAsync($"api/orders/admin/{order.Id}/stage", req);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("مرحله سفارش بروزرسانی شد.");
                adminNote = null;
                await LoadOrder();
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrEmpty(msg) ? msg : "خطا در بروزرسانی مرحله.");
            }
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private async Task UpdateStatus()
    {
        if (order == null || isSaving) return;
        isSaving = true;
        try
        {
            var req = new OrderStatusUpdateDto { Status = Enum.Parse<OrderStatus>(statusToUpdate), AdminNotes = adminNote };
            var resp = await Http.PutAsJsonAsync($"api/orders/admin/{order.Id}/status", req);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("وضعیت بروزرسانی شد.");
                adminNote = null;
                await LoadOrder();
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrEmpty(msg) ? msg : "خطا در بروزرسانی وضعیت.");
            }
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private void ShowNewShipmentForm()
    {
        newShipment = new OrderShipmentCreateDto();
        showShipmentForm = true;
    }

    private async Task CreateShipment()
    {
        if (order == null || isSaving) return;
        if (string.IsNullOrWhiteSpace(newShipment.Carrier))
        {
            ToastService.ShowError("شرکت حمل الزامی است.");
            return;
        }
        isSaving = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/orders/admin/{order.Id}/shipments", newShipment);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("مرسوله ثبت شد.");
                showShipmentForm = false;
                await LoadOrder();
            }
            else ToastService.ShowError("خطا در ثبت مرسوله.");
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private void ToggleShipMenu(int shipId)
    {
        expandedShipmentId = expandedShipmentId == shipId ? null : shipId;
    }

    private async Task UpdateShipmentStatus(OrderShipmentDto ship, OrderShipmentStatus newStatus)
    {
        if (order == null) return;
        expandedShipmentId = null;
        try
        {
            var req = new OrderShipmentUpdateDto { Status = newStatus };
            var resp = await Http.PutAsJsonAsync($"api/orders/admin/{order.Id}/shipments/{ship.Id}", req);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("وضعیت مرسوله بروزرسانی شد.");
                await LoadOrder();
            }
            else ToastService.ShowError("خطا در بروزرسانی.");
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
    }

    private void ConfirmDeleteShipment(OrderShipmentDto ship)
    {
        shipmentToDelete = ship;
        expandedShipmentId = null;
        showDeleteShipmentConfirm = true;
    }

    private async Task HandleDeleteShipmentResult(bool confirmed)
    {
        showDeleteShipmentConfirm = false;
        if (!confirmed || shipmentToDelete == null || order == null) return;
        try
        {
            var resp = await Http.DeleteAsync($"api/orders/admin/{order.Id}/shipments/{shipmentToDelete.Id}");
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("مرسوله حذف شد.");
                await LoadOrder();
            }
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
    }

    private void ShowNewReturnForm()
    {
        newReturn = new OrderReturnCreateRequest
        {
            RefundAmount = order != null ? order.TotalAmount - (order.DiscountAmount ?? 0) : 0
        };
        showReturnForm = true;
    }

    private async Task CreateReturn()
    {
        if (order == null || isSaving) return;
        if (newReturn.RefundAmount <= 0) { ToastService.ShowError("مبلغ مرجوعی باید بزرگ‌تر از صفر باشد."); return; }
        isSaving = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/orders/admin/{order.Id}/returns", newReturn);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("مرجوعی ثبت شد.");
                showReturnForm = false;
                await LoadOrder();
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrEmpty(msg) ? msg : "خطا در ثبت مرجوعی.");
            }
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private void ShowRefundForm(OrderReturnDto ret)
    {
        returnToRefund = ret;
        refundInfo = new OrderReturnRefundRequest
        {
            RefundCardNumber = ret.RefundCardNumber ?? "",
            RefundBankName = ret.RefundBankName,
            RefundDate = ret.RefundDate ?? DateTimeOffset.UtcNow,
            RefundReceiptImageUrl = ret.RefundReceiptImageUrl,
            AdminNotes = ret.AdminNotes
        };
        refundDateText = PersianDate.ToJalaliDate(ret.RefundDate ?? DateTimeOffset.UtcNow);
        refundReceiptUrl = ret.RefundReceiptImageUrl;
        refundJdpReady = false;
        showRefundModal = true;
    }

    private async Task MarkRefunded()
    {
        if (order == null || returnToRefund == null || isSaving) return;
        if (string.IsNullOrWhiteSpace(refundInfo.RefundCardNumber)) { ToastService.ShowError("شماره کارت الزامی است."); return; }
        if (!string.IsNullOrWhiteSpace(refundDateText))
        {
            if (PersianDate.TryParseJalaliDateTime(refundDateText, out var refundDateParsed))
                refundInfo.RefundDate = refundDateParsed;
            else { ToastService.ShowError("تاریخ واریز نامعتبر است. (فرمت شمسی: 1404/01/01)"); return; }
        }
        else refundInfo.RefundDate = DateTimeOffset.UtcNow;
        refundInfo.RefundReceiptImageUrl = refundReceiptUrl;
        isSaving = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/orders/admin/{order.Id}/returns/{returnToRefund.Id}/refund", refundInfo);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("واریز ثبت شد.");
                showRefundModal = false;
                await LoadOrder();
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrEmpty(msg) ? msg : "خطا در ثبت واریز.");
            }
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
        finally { isSaving = false; }
    }

    private void ConfirmDeleteReturn(OrderReturnDto ret)
    {
        returnToDelete = ret;
        showDeleteReturnConfirm = true;
    }

    private async Task HandleDeleteReturnResult(bool confirmed)
    {
        showDeleteReturnConfirm = false;
        if (!confirmed || returnToDelete == null || order == null) return;
        try
        {
            var resp = await Http.DeleteAsync($"api/orders/admin/{order.Id}/returns/{returnToDelete.Id}");
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("مرجوعی حذف شد.");
                await LoadOrder();
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrEmpty(msg) ? msg : "خطا در حذف.");
            }
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
    }

    private async Task HandleDeleteResult(bool confirmed)
    {
        showDeleteConfirm = false;
        if (!confirmed || order == null) return;
        try
        {
            var resp = await Http.DeleteAsync($"api/orders/admin/{order.Id}");
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("سفارش حذف شد.");
                Nav.NavigateTo("/admin/orders");
            }
            else
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(!string.IsNullOrEmpty(msg) ? msg : "خطا در حذف.");
            }
        }
        catch (Exception ex) { ToastService.ShowError(ex.Message); }
    }

