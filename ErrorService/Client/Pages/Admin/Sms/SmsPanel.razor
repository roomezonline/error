    private string WsSettingsUrl(string path) =>
        _wsSelectedWorkshopId.HasValue ? $"{path}?workshopId={_wsSelectedWorkshopId.Value}" : path;

    // ─── Workshop Settings ───
    private async Task LoadWorkshopSettings()
    {
        _loadingWsSettings = true;
        _wsSettings = null;
        _wsModules = null;
        try
        {
            var urlSettings = WsSettingsUrl("api/workshop-sms/settings");
            _wsSettings = await Http.GetFromJsonAsync<WorkshopSmsSettingDto>(urlSettings);
            if (_wsSettings != null)
            {
                _wsSettingsEdit = new WorkshopSmsSettingUpdateRequest
                {
                    IsActive = _wsSettings.IsActive
                };
            }
            var urlModules = WsSettingsUrl("api/workshop-sms/modules");
            _wsModules = await Http.GetFromJsonAsync<List<WorkshopSmsModuleDto>>(urlModules);
        }
        catch { }
        finally { _loadingWsSettings = false; }
