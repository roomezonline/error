    private string GetLocationText()
    {
        var p = provinces?.FirstOrDefault(x => x.Id == request.ProvinceId)?.Name;
        var c = cities?.FirstOrDefault(x => x.Id == request.CityId)?.Name;
        if (string.IsNullOrWhiteSpace(p) && string.IsNullOrWhiteSpace(c)) return "-";
        return string.Join(" - ", new[] { p, c }.Where(x => !string.IsNullOrWhiteSpace(x)));
    }
