    private void StartOrStopTimer()
    {
        if (products == null) return;
        var any = products.Any(p => p.DiscountPrice.HasValue && p.DiscountExpiryDate.HasValue && p.DiscountExpiryDate > DateTimeOffset.Now);
        if (!any)
        {
            timer?.Dispose();
            timer = null;
            countDowns.Clear();
            return;
        }

        timer ??= new System.Threading.Timer(_ =>
        {
            if (products == null) return;
            bool changed = false;
            foreach (var p in products.Where(p => p.DiscountPrice.HasValue && p.DiscountExpiryDate.HasValue && p.DiscountExpiryDate > DateTimeOffset.Now))
            {
                var diff = p.DiscountExpiryDate!.Value - DateTimeOffset.Now;
                string text;
                if (diff.TotalSeconds <= 0)
                {
                    text = "پایان یافت";
                }
                else
                {
                    int days = (int)diff.TotalDays;
                    text = days > 0
                        ? $"{days} روز و {diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}"
                        : $"{diff.Hours:D2}:{diff.Minutes:D2}:{diff.Seconds:D2}";
                }

                if (!countDowns.ContainsKey(p.Id) || countDowns[p.Id] != text)
                {
                    countDowns[p.Id] = text;
                    changed = true;
                }
            }

            if (changed) InvokeAsync(StateHasChanged);
        }, null, 0, 1000);
    }

    private string GetCountdown(int id) => countDowns.ContainsKey(id) ? countDowns[id] : "--:--:--";

    private string BuildQueryString()
    {
        var parts = new List<string>
        {
            $"skip={skip}",
            $"take={take}",
            $"onlyAvailable={onlyAvailable.ToString().ToLowerInvariant()}",
            $"onlyDiscounted={onlyDiscounted.ToString().ToLowerInvariant()}"
        };

        if (selectedCategoryId.HasValue)
            parts.Add($"categoryId={selectedCategoryId.Value}");

        if (!string.IsNullOrWhiteSpace(search))
            parts.Add($"search={Uri.EscapeDataString(search.Trim())}");

        if (minPrice.HasValue)
            parts.Add($"minPrice={minPrice.Value}");

        if (maxPrice.HasValue)
            parts.Add($"maxPrice={maxPrice.Value}");

        if (!string.IsNullOrWhiteSpace(sort))
            parts.Add($"sort={Uri.EscapeDataString(sort)}");

        return string.Join("&", parts);
    }

    private Dictionary<string, string> ReadQuery()
    {
        var q = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        var d = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        if (int.TryParse(q["categoryId"], out var cat) && cat > 0) d["categoryId"] = cat.ToString();

        var s = q["search"];
        if (!string.IsNullOrWhiteSpace(s)) d["search"] = s.Trim();

        var so = q["sort"];
        if (!string.IsNullOrWhiteSpace(so)) d["sort"] = so.Trim();

        if (decimal.TryParse(q["minPrice"], out var mn) && mn >= 0)
            d["minPrice"] = mn.ToString(System.Globalization.CultureInfo.InvariantCulture);

        if (decimal.TryParse(q["maxPrice"], out var mx) && mx >= 0)
            d["maxPrice"] = mx.ToString(System.Globalization.CultureInfo.InvariantCulture);

        if (string.Equals(q["onlyAvailable"], "true", StringComparison.OrdinalIgnoreCase)) d["onlyAvailable"] = "true";
        if (string.Equals(q["onlyDiscounted"], "true", StringComparison.OrdinalIgnoreCase)) d["onlyDiscounted"] = "true";

        if (int.TryParse(q["page"], out var pg) && pg > 1) d["page"] = pg.ToString();

        return d;
    }

    private Dictionary<string, string> StateQuery()
    {
        var d = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);

        if (selectedCategoryId.HasValue && selectedCategoryId.Value > 0)
            d["categoryId"] = selectedCategoryId.Value.ToString();

        if (!string.IsNullOrWhiteSpace(search)) d["search"] = search.Trim();
        if (!string.IsNullOrWhiteSpace(sort)) d["sort"] = sort.Trim();
        if (minPrice.HasValue && minPrice.Value >= 0)
            d["minPrice"] = minPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (maxPrice.HasValue && maxPrice.Value >= 0)
            d["maxPrice"] = maxPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture);
        if (onlyAvailable) d["onlyAvailable"] = "true";
        if (onlyDiscounted) d["onlyDiscounted"] = "true";
        if (currentPage > 1) d["page"] = currentPage.ToString();

        return d;
    }

    private bool QueryMatchesState()
    {
        var fromUrl = ReadQuery();
        var fromState = StateQuery();

        if (fromUrl.Count != fromState.Count) return false;
        foreach (var kv in fromUrl)
        {
            if (!fromState.TryGetValue(kv.Key, out var v)) return false;
            if (!string.Equals(v, kv.Value, StringComparison.OrdinalIgnoreCase)) return false;
        }
        return true;
    }

    private void ApplyQueryToState()
    {
        var d = ReadQuery();

        selectedCategoryId = d.TryGetValue("categoryId", out var c) && int.TryParse(c, out var ci) ? ci : null;
        search = d.TryGetValue("search", out var s) ? s : null;
        sort = d.TryGetValue("sort", out var so) ? so : null;
        minPrice = d.TryGetValue("minPrice", out var mn) && decimal.TryParse(mn, out var mnm) ? mnm : null;
        maxPrice = d.TryGetValue("maxPrice", out var mx) && decimal.TryParse(mx, out var mxv) ? mxv : null;
        onlyAvailable = d.ContainsKey("onlyAvailable");
        onlyDiscounted = d.ContainsKey("onlyDiscounted");
        currentPage = d.TryGetValue("page", out var pg) && int.TryParse(pg, out var pgi) ? pgi : 1;

        minPriceText = minPrice.HasValue ? FormatDigits(minPrice.Value.ToString()) : "";
        maxPriceText = maxPrice.HasValue ? FormatDigits(maxPrice.Value.ToString()) : "";

        skip = (currentPage - 1) * take;
    }

    private string BuildShareQuery()
    {
        var d = StateQuery();
        var parts = new List<string>();
        foreach (var key in QueryKeys)
        {
            if (d.TryGetValue(key, out var v)) parts.Add($"{key}={Uri.EscapeDataString(v)}");
        }
        return string.Join("&", parts);
    }

    private void SyncUrl()
    {
        var q = BuildShareQuery();
        var relative = q.Length == 0 ? "products" : "products?" + q;
        var target = new Uri(new Uri(Nav.BaseUri), relative).AbsoluteUri;
        if (string.Equals(Nav.Uri, target, StringComparison.OrdinalIgnoreCase)) return;
        Nav.NavigateTo(relative, replace: true);
    }

    private string BuildCanonicalUrl()
    {
        // جستجو در canonical نمی‌آید تا با سمت سرور یکی باشد (نتایج جستجو تکراری
        // از دید موتور جستجو محسوب می‌شوند).
        var d = StateQuery();
        d.Remove("search");
        var parts = new List<string>();
        foreach (var key in QueryKeys)
        {
            if (d.TryGetValue(key, out var v)) parts.Add($"{key}={Uri.EscapeDataString(v)}");
        }
        var q = string.Join("&", parts);
        return $"https://errorservice.ir/products{(q.Length > 0 ? "?" + q : "")}";
    }

