    @@media (max-width: 768px) {
        .container { padding-left: 4px; padding-right: 4px; overflow-x: hidden; }
        .admission-page { overflow-x: hidden; }
        .row { margin-left: 0; margin-right: 0; }
        .admission-card { padding: 16px 8px; border-radius: 16px; width: 100%; max-width: 100%; margin: 0; }
        .section-card { padding: 12px 8px; }
        .admission-steps { margin-bottom: 24px; padding: 0 4px; }
        .step-label { display: none; }
        .step-line { margin-bottom: 0; height: 3px; }
        .summary-card-app { border-radius: 16px; margin: 0 -4px; }
        .summary-header-app { padding: 10px 12px; font-size: 0.8rem; }
        .summary-row-app { padding: 12px; }
        .summary-icon-wrap { width: 36px; height: 36px; font-size: 1rem; }
