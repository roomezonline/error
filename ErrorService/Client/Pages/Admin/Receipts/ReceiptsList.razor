                ShowPrintDate = printShowPrintDate,
                ShowInvoiceNumber = printShowInvoiceNumber,
                Address = printAddress,
                Phone = printPhone,
                Website = printWebsite,
                LogoUrl = printLogoUrl
            };

            var resp = await Http.PostAsJsonAsync("api/print/invoice/bulk", printRequest);
            if (resp.IsSuccessStatusCode)
            {
                var printHtml = await resp.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("eval", $"const win = window.open('', '_blank'); win.document.write(`{printHtml}`); win.document.close(); win.print();");
                ToastService.ShowSuccess("فاکتورها برای پرینت آماده شد");
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("خطا در آماده‌سازی فاکتورها");
        }
    }

    private async Task OpenCustomerSummary(CustomerReceiptDto item)
    {
        customerSummaryReceipt = item;
        showCustomerSummaryModal = true;
        isLoadingCustomerSummary = true;
        customerAllReceipts = null;
        customerFinancialSummary = null;

        await InvokeAsync(StateHasChanged);

        try
        {
            // Load all receipts for this customer
            var qs = WorkshopQs();
            customerAllReceipts = await Http.GetFromJsonAsync<List<CustomerReceiptDto>>(
                $"api/customer-receipts/by-customer/{item.CustomerMobile}{qs}");

            // Load financial summary
            customerFinancialSummary = await Http.GetFromJsonAsync<CustomerFinancialSummaryDto>(
                $"api/customer-receipts/customer-financial-summary/{item.CustomerMobile}{qs}");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا در دریافت اطلاعات: {ex.Message}");
        }
        finally
        {
            isLoadingCustomerSummary = false;
            await InvokeAsync(StateHasChanged);
