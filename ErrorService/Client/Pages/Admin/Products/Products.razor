@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    private List<ProductDto>? products;
    private List<CategoryDto>? categories;
    private ProductUpsertRequest model = new();
    private bool showEditor = false;
    private ElementReference editorCard;
    private bool _editorScrolled;
    private int editingId = 0;
    private bool isSaving = false;
    private bool isUploading = false;
    private string createdAtInput = string.Empty;
    private string discountStartInput = string.Empty;
    private string discountExpiryInput = string.Empty;
    private string discountTypeInput = "";
    private const string DiscountTypeNone = "";
    private const string DiscountTypePermanent = "permanent";
    private const string DiscountTypeTimed = "timed";
    private DotNetObjectReference<Products>? objRef;
    private bool _tinyInitialized;

    private string? _routeKey;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<string>("localStorage.getItem", "adminProductsView");
            if (saved == "card" || saved == "table") _viewMode = saved;
        }
        catch { }

        try { await LoadCategories(); } catch { categories ??= new List<CategoryDto>(); }

        try { await LoadAccounting(); } catch { _acct = null; }

        NavManager.LocationChanged += OnLocationChanged;
        await HandleRouteAsync();
    }

    protected override async Task OnParametersSetAsync() => await HandleRouteAsync();

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(async () =>
        {
            await HandleRouteAsync();
            StateHasChanged();
        });

    private async Task HandleRouteAsync()
    {
        var rel = NavManager.ToBaseRelativePath(NavManager.Uri).TrimEnd('/');
        if (string.Equals(rel, _routeKey, StringComparison.OrdinalIgnoreCase)) return;
        _routeKey = rel;

        if (rel.EndsWith("admin/products/new", StringComparison.OrdinalIgnoreCase))
        {
            _editorPage = true;
            InitNewEditor();
            return;
        }

        if (Id > 0)
        {
            _editorPage = true;
            await OpenEditorById(Id);
            return;
        }

        if (_editorPage || showEditor)
        {
            _editorPage = false;
            showEditor = false;
            _tab = 0;
        }

        await LoadProducts();
        await LoadSummary();
    }

    [JSInvokable]
    public void UpdateContent(string content)
    {
        model.Description = content;
        StateHasChanged();
    }

    public void Dispose()
    {
        objRef?.Dispose();
        NavManager.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (showEditor)
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("initJalali");
            try { await JS.InvokeVoidAsync("formatPriceInputs"); } catch { }

            if (!_editorScrolled)
            {
                _editorScrolled = true;
                await JS.InvokeVoidAsync("scrollToElement", editorCard, "start");
            }

            if (!_tinyInitialized)
            {
                objRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("initTinyMCE", "#tiny-editor-product", objRef, "/api/products/upload");
                _tinyInitialized = true;
            }
        }
        else
        {
            _tinyInitialized = false;
            _editorScrolled = false;
        }
    }

    private string? _searchQuery;
    private bool _showFeaturedOnly;
    private int totalCount = 0;
    private bool isLoadingMore = false;
    private bool showTechnical;

    private int _categoryIdFilter;

    private string _statusFilter = "all";

    private string _stockFilter = "all";
    private bool _onlyDiscounted;

    private string _sort = "newest";

    private string _viewMode = "table";

    private int page = 1;

    private int pageSize = 24;

    private ProductAdminSummaryDto? summary;

    private System.Threading.CancellationTokenSource? _searchCts;

    [Parameter]
    public int Id { get; set; }

    private bool _editorPage;
    private int _tab;
    private static readonly string[] TabTitles = { "اطلاعات اصلی", "قیمت و تخفیف", "تصاویر محصول", "موجودی و ارسال", "مشخصات فنی" };

    private static string FaNum(int value)
    {
        var chars = value.ToString().ToCharArray();
        for (var i = 0; i < chars.Length; i++) chars[i] = (char)('۰' + (chars[i] - '0'));
        return new string(chars);
    }

    private async Task GoStep(int tab)
    {
        if (tab < 0 || tab >= TabTitles.Length) return;
        _tab = tab;
        try { await JS.InvokeVoidAsync("scrollToElement", editorCard, "start"); } catch { }
    }
    private List<ProductSpecDto> _specs = new();
    private string _newSpecName = "";
    private string _newSpecValue = "";
    private bool _specsSaving;
    private string _specsSig = "";
    private List<ProductPricePointDto>? _priceHistory;

    private ShopAccountingDto? _acct;

    private decimal _acctToday => _acct?.Daily is { Count: > 0 } days ? days[^1].Amount : 0m;

    private async Task LoadAccounting()
    {
        try
        {
            _acct = await Http.GetFromJsonAsync<ShopAccountingDto>("api/orders/admin/accounting?preset=month");
        }
        catch { _acct = null; }
    }

    private void GoAccounting() => NavManager.NavigateTo("/admin/shop-accounting");

    private List<ProductDto> FilteredProducts
    {
        get
        {
            if (products == null) return new();
            IEnumerable<ProductDto> list = products;
            if (_showFeaturedOnly)
                list = list.Where(p => p.IsFeatured);
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                var q = _searchQuery.Trim().ToLower();
                list = list.Where(p =>
                    (p.Name?.ToLower().Contains(q) ?? false) ||
                    (p.CategoryName?.ToLower().Contains(q) ?? false));
            }
            return list.ToList();
        }
    }

    private void ToggleLowStock() { }

    private async Task ToggleFeaturedFilter()
    {
        _showFeaturedOnly = !_showFeaturedOnly;
        page = 1;
        await LoadProducts();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        _searchQuery = e.Value?.ToString();
        _ = DebouncedSearch();
    }

    private async Task DebouncedSearch()
    {
        _searchCts?.Cancel();
        _searchCts = new System.Threading.CancellationTokenSource();
        var token = _searchCts.Token;
        try
        {
            await Task.Delay(300, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }
        if (token.IsCancellationRequested) return;
        page = 1;
        await LoadProducts();
    }

    private async Task ClearSearch()
    {
        _searchQuery = null;
        page = 1;
        await LoadProducts();
    }

    private async Task LoadProducts()

    {

        isLoadingMore = true;

        try

        {

            var q = new List<string> { $"page={page}", $"pageSize={pageSize}" };

            if (!string.IsNullOrWhiteSpace(_searchQuery)) q.Add("search=" + Uri.EscapeDataString(_searchQuery.Trim()));

            if (_categoryIdFilter > 0) q.Add($"categoryId={_categoryIdFilter}");

            if (_statusFilter != "all") q.Add("status=" + Uri.EscapeDataString(_statusFilter));

            if (_stockFilter != "all") q.Add("stock=" + Uri.EscapeDataString(_stockFilter));

            if (_showFeaturedOnly) q.Add("featured=true");

            if (_onlyDiscounted) q.Add("onlyDiscounted=true");

            if (!string.IsNullOrWhiteSpace(_sort) && _sort != "newest") q.Add("sort=" + Uri.EscapeDataString(_sort));

            var response = await Http.GetAsync("api/products/admin/list?" + string.Join("&", q));

            if (response.IsSuccessStatusCode)

            {

                if (response.Headers.TryGetValues("X-Total-Count", out var values))

                {

                    int.TryParse(values.FirstOrDefault(), out totalCount);

                }

                products = await response.Content.ReadFromJsonAsync<List<ProductDto>>() ?? new List<ProductDto>();

            }

            else if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)

            {

                ToastService.ShowError("برای مشاهده این بخش دسترسی کافی ندارید.");

                products = new List<ProductDto>();

            }

            else

            {

                ToastService.ShowError("خطا در بارگذاری محصولات");

            }

        }

        catch

        {

            ToastService.ShowError("خطا در بارگذاری محصولات");

        }

        finally

        {

            isLoadingMore = false;

        }

    }



    private async Task LoadSummary()

    {

        try

        {

            summary = await Http.GetFromJsonAsync<ProductAdminSummaryDto>("api/products/admin/summary");

        }

        catch { summary = null; }

    }



    private async Task OnCategoryChanged(ChangeEventArgs e)

    {

        _categoryIdFilter = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;

        page = 1;

        await LoadProducts();

    }



    private async Task OnStatusChanged(ChangeEventArgs e)

    {

        var v = e.Value?.ToString();

        _statusFilter = string.IsNullOrWhiteSpace(v) ? "all" : v!;

        page = 1;

        await LoadProducts();

    }



    private async Task OnStockChanged(ChangeEventArgs e)

    {

        var v = e.Value?.ToString();

        _stockFilter = string.IsNullOrWhiteSpace(v) ? "all" : v!;

        page = 1;

        await LoadProducts();

    }



    private async Task OnSortChanged(ChangeEventArgs e)

    {

        var v = e.Value?.ToString();

        _sort = string.IsNullOrWhiteSpace(v) ? "newest" : v!;

        page = 1;

        await LoadProducts();

    }



    private async Task GoPage(int target)

    {

        var next = Math.Max(1, target);

        if (next == page) return;

        page = next;

        await LoadProducts();

        try { await JS.InvokeVoidAsync("window.scrollTo", 0, 0); } catch { }

    }



    private async Task ToggleView(bool card)

    {

        _viewMode = card ? "card" : "table";

        try { await JS.InvokeVoidAsync("localStorage.setItem", "adminProductsView", _viewMode); } catch { }

    }



    private async Task ToggleDiscountedFilter()
    {
        _onlyDiscounted = !_onlyDiscounted;
        page = 1;
        await LoadProducts();
    }

    private void GoCategories() => NavManager.NavigateTo("/admin/categories");

    private bool KpiActive(string key) => key switch
    {
        "all" => _statusFilter == "all"
                 && _stockFilter == "all"
                 && !_onlyDiscounted
                 && !_showFeaturedOnly
                 && _categoryIdFilter == 0
                 && string.IsNullOrWhiteSpace(_searchQuery),
        "available" => _statusFilter == "available" && _stockFilter == "all" && !_onlyDiscounted,
        "out" => _stockFilter == "out" && !_onlyDiscounted,
        "low" => _stockFilter == "low" && !_onlyDiscounted,
        "discounted" => _onlyDiscounted,
        _ => false
    };

    private async Task ApplyKpi(string key)
    {
        _searchQuery = null;
        _categoryIdFilter = 0;
        _showFeaturedOnly = false;
        _statusFilter = "all";
        _stockFilter = "all";
        _onlyDiscounted = false;

        switch (key)
        {
            case "available": _statusFilter = "available"; break;
            case "out": _stockFilter = "out"; break;
            case "low": _stockFilter = "low"; break;
            case "discounted": _onlyDiscounted = true; break;
        }

        page = 1;
        await LoadProducts();
    }

    private async Task ResetFilters()

    {

        _searchQuery = null;

        _categoryIdFilter = 0;

        _statusFilter = "all";

        _stockFilter = "all";

        _sort = "newest";

        _showFeaturedOnly = false;
        _onlyDiscounted = false;

        page = 1;

        await LoadProducts();

    }



    private int TotalPages => Math.Max(1, (int)Math.Ceiling(totalCount / (double)pageSize));
    private async Task LoadCategories() => categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories?includeInactive=true");

    private void NewProduct()
    {
        var rel = NavManager.ToBaseRelativePath(NavManager.Uri).TrimEnd('/');
        if (rel.EndsWith("admin/products/new", StringComparison.OrdinalIgnoreCase))
        {
            InitNewEditor();
            StateHasChanged();
            return;
        }
        NavManager.NavigateTo("/admin/products/new");
    }

    private void InitNewEditor()
    {
        editingId = 0;
        model = new ProductUpsertRequest { IsAvailable = true, StockQuantity = 0, EstimatedDeliveryText = StoreDefaults.DeliveryEta };
        createdAtInput = PersianDate.ToJalaliDateTime(DateTimeOffset.Now);
        discountTypeInput = "";
        discountStartInput = string.Empty;
        discountExpiryInput = string.Empty;
        _specs = new();
        _specsSig = "";
        _priceHistory = null;
        _tab = 0;
        showEditor = true;
    }

    private void EditProduct(ProductDto prod) => NavManager.NavigateTo($"/admin/products/edit/{prod.Id}");

    private async Task OpenEditorById(int id)
    {
        var prod = (products?.FirstOrDefault(p => p.Id == id)) ?? await Http.GetFromJsonAsync<ProductDto>($"api/products/admin/{id}");
        if (prod == null)
        {
            ToastService.ShowError("محصول مورد نظر یافت نشد");
            NavManager.NavigateTo("/admin/products");
            return;
        }
        InitEditEditor(prod);
        await LoadSpecs();
        await LoadPriceHistory();
    }

    private void InitEditEditor(ProductDto prod)
    {
        editingId = prod.Id;
        model = new ProductUpsertRequest
        {
            Name = prod.Name,
            Sku = prod.Sku,
            Description = prod.Description,
            Price = prod.Price,
            DiscountPrice = prod.DiscountPrice,
            DiscountStartDate = prod.DiscountStartDate,
            DiscountExpiryDate = prod.DiscountExpiryDate,
            MainImageUrl = prod.MainImageUrl,
            ImageUrl2 = prod.ImageUrl2,
            ImageUrl3 = prod.ImageUrl3,
            ImageUrl4 = prod.ImageUrl4,
            CategoryId = prod.CategoryId,
            IsAvailable = prod.IsAvailable,
            IsDraft = prod.IsDraft,
            StockQuantity = prod.StockQuantity,
            IsFeatured = prod.IsFeatured,
            SortOrder = prod.SortOrder,
            CompatibilityInfo = prod.CompatibilityInfo,
            FailureSymptoms = prod.FailureSymptoms,
            DatasheetUrl = prod.DatasheetUrl,
            RelatedProductIds = prod.RelatedProductIds,
            EstimatedDeliveryText = prod.EstimatedDeliveryText
        };
        createdAtInput = PersianDate.ToJalaliDateTime(prod.CreatedAt);
        discountTypeInput = prod.DiscountExpiryDate.HasValue ? "timed" : (prod.DiscountPrice.HasValue ? "permanent" : "");
        discountStartInput = prod.DiscountStartDate.HasValue ? PersianDate.ToJalaliDateTime(prod.DiscountStartDate.Value) : string.Empty;
        discountExpiryInput = prod.DiscountExpiryDate.HasValue ? PersianDate.ToJalaliDateTime(prod.DiscountExpiryDate.Value) : string.Empty;
        _tab = 0;
        showEditor = true;
        showTechnical = true;
    }

    private static string SpecsSig(List<ProductSpecDto>? specs) =>
        specs is null || specs.Count == 0 ? "" :
        string.Join('\u001f', specs.Select(s => $"{s.SpecKey}\u001e{s.SpecValue}"));

    private async Task LoadSpecs()
    {
        try
        {
            _specs = await Http.GetFromJsonAsync<List<ProductSpecDto>>($"api/products/{editingId}/specs") ?? new();
        }
        catch { _specs = new(); }
        _specsSig = SpecsSig(_specs);
    }

    private async Task SaveSpecsSilentlyAsync()
    {
        if (editingId == 0) return;
        var sig = SpecsSig(_specs);
        if (sig == _specsSig) return;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/products/{editingId}/specs", new ProductSpecsUpsertRequest { Specs = _specs });
            if (resp.IsSuccessStatusCode) _specsSig = sig;
            else ToastService.ShowError("مشخصات فنی ذخیره نشد");
        }
        catch { ToastService.ShowError("خطا در ذخیره مشخصات فنی"); }
    }

    private void AddSpec()
    {
        var k = (_newSpecName ?? "").Trim();
        var v = (_newSpecValue ?? "").Trim();
        if (k.Length == 0 || v.Length == 0)
        {
            ToastService.ShowError("نام و مقدار مشخصه را وارد کنید");
            return;
        }
        if (_specs.Count >= 60)
        {
            ToastService.ShowError("حداکثر ۶۰ مشخصه مجاز است");
            return;
        }
        _specs.Add(new ProductSpecDto { ProductId = editingId, SpecKey = k.Substring(0, Math.Min(120, k.Length)), SpecValue = v.Substring(0, Math.Min(500, v.Length)) });
        _newSpecName = "";
        _newSpecValue = "";
    }

    private void RemoveSpec(int index)
    {
        if (index >= 0 && index < _specs.Count) _specs.RemoveAt(index);
    }

    private async Task SaveSpecs()
    {
        _specsSaving = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/products/{editingId}/specs", new ProductSpecsUpsertRequest { Specs = _specs });
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("مشخصات فنی ذخیره شد");
                await LoadSpecs();
            }
            else ToastService.ShowError("خطا در ذخیره مشخصات فنی");
        }
        catch (Exception ex) { ToastService.ShowError($"خطای سیستمی: {ex.Message}"); }
        finally { _specsSaving = false; }
    }

    private bool _deletingPoint;
    private bool _showPointConfirm;
    private int _pointToDelete;
    private bool _phModalOpen;
    private bool _phSaving;
    private int _phEditingPointId;
    private string _phDateInput = "";
    private string _phPriceInput = "";
    private string _phDiscountInput = "";

    private void OpenAddPricePoint()
    {
        if (editingId <= 0) return;
        _phEditingPointId = 0;
        _phDateInput = PersianDate.ToJalaliDateTime(model.CreatedAt ?? DateTimeOffset.Now);
        _phPriceInput = model.Price > 0 ? model.Price.ToString("N0") : "";
        _phDiscountInput = model.DiscountPrice.HasValue ? model.DiscountPrice.Value.ToString("N0") : "";
        _phModalOpen = true;
    }

    private void OpenEditPricePoint(ProductPricePointDto p)
    {
        _phEditingPointId = p.Id;
        _phDateInput = PersianDate.ToJalaliDateTime(p.RecordedAt);
        _phPriceInput = p.Price.ToString("N0");
        _phDiscountInput = p.DiscountPrice.HasValue ? p.DiscountPrice.Value.ToString("N0") : "";
        _phModalOpen = true;
    }

    private void ClosePhModal()
    {
        _phModalOpen = false;
        _phEditingPointId = 0;
    }

    private async Task SavePricePoint()
    {
        if (_phSaving || editingId <= 0) return;

        if (!PersianDate.TryParseJalaliDateTime(_phDateInput, out var phDate))
        {
            ToastService.ShowError("تاریخ شمسی معتبر وارد کنید (مثلاً 1404/01/01)");
            return;
        }

        var phPriceRaw = await JS.InvokeAsync<string>("getPriceRawValue", "ph-price-input");
        if (string.IsNullOrWhiteSpace(phPriceRaw) || !int.TryParse(phPriceRaw.Trim(), out var phPrice) || phPrice <= 0)
        {
            ToastService.ShowError("قیمت رکورد باید بزرگتر از صفر باشد");
            return;
        }

        decimal? phDiscount = null;
        var phDiscountRaw = await JS.InvokeAsync<string>("getPriceRawValue", "ph-discount-input");
        if (!string.IsNullOrWhiteSpace(phDiscountRaw))
        {
            if (!int.TryParse(phDiscountRaw.Trim(), out var phDiscountVal) || phDiscountVal <= 0)
            {
                ToastService.ShowError("قیمت با تخفیف معتبر نیست");
                return;
            }
            if (phDiscountVal >= phPrice)
            {
                ToastService.ShowError("قیمت با تخفیف باید کمتر از قیمت اصلی باشد");
                return;
            }
            phDiscount = phDiscountVal;
        }

        var phPayload = new ProductPricePointRequest { Price = phPrice, DiscountPrice = phDiscount, RecordedAt = phDate };

        _phSaving = true;
        try
        {
            HttpResponseMessage phResp = _phEditingPointId > 0
                ? await Http.PutAsJsonAsync($"api/products/{editingId}/price-history/{_phEditingPointId}", phPayload)
                : await Http.PostAsJsonAsync($"api/products/{editingId}/price-history", phPayload);

            if (phResp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(_phEditingPointId > 0 ? "رکورد ویرایش شد" : "رکورد افزوده شد");
                await LoadPriceHistory();
                ClosePhModal();
            }
            else
            {
                var phError = await phResp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(phError) ? "ذخیره رکورد ناموفق بود" : phError);
            }
        }
        catch { ToastService.ShowError("خطا در ذخیره رکورد"); }
        finally { _phSaving = false; }
    }

    private void RequestDeletePricePoint(int pointId)
    {
        if (_deletingPoint || editingId <= 0) return;
        _pointToDelete = pointId;
        _showPointConfirm = true;
    }

    private async Task HandlePointDeleteResult(bool result)
    {
        _showPointConfirm = false;
        if (!result || _pointToDelete <= 0) return;
        await DeletePricePoint(_pointToDelete);
        _pointToDelete = 0;
    }

    private async Task LoadPriceHistory()
    {
        try
        {
            _priceHistory = await Http.GetFromJsonAsync<List<ProductPricePointDto>>($"api/products/{editingId}/price-history");
        }
        catch { _priceHistory = null; }
    }

    private async Task DeletePricePoint(int pointId)
    {
        if (_deletingPoint || editingId <= 0) return;
        _deletingPoint = true;
        try
        {
            var resp = await Http.DeleteAsync($"api/products/{editingId}/price-history/{pointId}");
            if (resp.IsSuccessStatusCode)
            {
                await LoadPriceHistory();
                ToastService.ShowSuccess("رکورد حذف شد");
            }
            else ToastService.ShowError("حذف رکورد ناموفق بود");
        }
        catch { ToastService.ShowError("خطا در حذف رکورد"); }
        finally { _deletingPoint = false; }
    }

    private void CloseEditor()
    {
        if (_editorPage)
        {
            NavManager.NavigateTo("/admin/products");
            return;
        }
        showEditor = false;
    }

    private void SetDiscountType(string type) => discountTypeInput = type;

    private async Task SaveProduct()
    {
        isSaving = true;
        try
        {
            var priceRaw = await JS.InvokeAsync<string>("getPriceRawValue", "price-input");
            if (string.IsNullOrWhiteSpace(priceRaw) || !int.TryParse(priceRaw.Trim(), out var priceVal) || priceVal <= 0)
            {
                ToastService.ShowError("قیمت محصول معتبر نیست؛ لطفاً قیمت را وارد کنید");
                return;
            }
            model.Price = priceVal;

            if (discountTypeInput == "permanent" || discountTypeInput == "timed")
            {
                var discountRaw = await JS.InvokeAsync<string>("getPriceRawValue", "discount-price-input");
                if (string.IsNullOrWhiteSpace(discountRaw))
                {
                    if (!model.DiscountPrice.HasValue)
                    {
                        ToastService.ShowError("برای تخفیف، قیمت با تخفیف الزامی است");
                        return;
                    }
                }
                else if (int.TryParse(discountRaw.Trim(), out var discountVal) && discountVal > 0)
                {
                    model.DiscountPrice = discountVal;
                    if (discountVal >= model.Price)
                    {
                        ToastService.ShowError("قیمت با تخفیف باید کمتر از قیمت اصلی باشد");
                        return;
                    }
                }
                else
                {
                    ToastService.ShowError("قیمت با تخفیف معتبر نیست");
                    return;
                }
            }
            else
            {
                model.DiscountPrice = null;
                model.DiscountStartDate = null;
                model.DiscountExpiryDate = null;
            }

            if (discountTypeInput == "timed")
            {
                if (PersianDate.TryParseJalaliDateTime(discountExpiryInput, out var discountExpiry))
                    model.DiscountExpiryDate = discountExpiry;
                else
                {
                    ToastService.ShowError("برای تخفیف زمان‌دار، تاریخ پایان الزامی است");
                    return;
                }

                if (PersianDate.TryParseJalaliDateTime(discountStartInput, out var discountStart))
                    model.DiscountStartDate = discountStart;
                else
                    model.DiscountStartDate = null;

                if (model.DiscountStartDate.HasValue && model.DiscountExpiryDate.Value <= model.DiscountStartDate.Value)
                {
                    ToastService.ShowError("تاریخ پایان باید بعد از تاریخ شروع باشد");
                    return;
                }
            }
            else if (discountTypeInput == "permanent")
            {
                model.DiscountStartDate = null;
                model.DiscountExpiryDate = null;
            }

            if (PersianDate.TryParseJalaliDateTime(createdAtInput, out var createdAt))
                model.CreatedAt = createdAt;
            else
                model.CreatedAt = null;

            var tinyContent = await JS.InvokeAsync<string>("getTinyContent", "#tiny-editor-product");
            if (!string.IsNullOrEmpty(tinyContent)) model.Description = tinyContent;

            HttpResponseMessage resp;
            if (editingId == 0) resp = await Http.PostAsJsonAsync("api/products", model);
            else resp = await Http.PutAsJsonAsync($"api/products/{editingId}", model);
            
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(editingId == 0 ? "محصول با موفقیت ثبت شد" : "تغییرات محصول ذخیره شد");
                await SaveSpecsSilentlyAsync();
                if (_editorPage)
                {
                    NavManager.NavigateTo("/admin/products");
                    return;
                }
                await LoadProducts();
                await LoadSummary();
                showEditor = false;
            }
            else
            {
                ToastService.ShowError("خطا در ذخیره‌سازی محصول");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطای سیستمی: {ex.Message}");
        }
        finally { isSaving = false; }
    }

    private ProductDto? itemToDelete;
    private bool showConfirm;

    private void DeleteProduct(ProductDto prod)
    {
        itemToDelete = prod;
        showConfirm = true;
    }

    private async Task HandleDeleteResult(bool result)
    {
        showConfirm = false;
        if (result && itemToDelete != null)
        {
            try
            {
                var response = await Http.DeleteAsync($"api/products/{itemToDelete.Id}");
                if (response.IsSuccessStatusCode)
                {
                    ToastService.ShowSuccess("محصول با موفقیت حذف شد");
                    await LoadProducts();
                }
                else
                {
                    ToastService.ShowError("خطا در حذف محصول");
                }
            }
            catch (Exception ex)
            {
                ToastService.ShowError($"خطای سیستمی: {ex.Message}");
            }
        }
        itemToDelete = null;
    }
}
