        "success" => "موفق",
        "partial" => "با خطای جزئی",
        "failed" => "ناموفق",
        "running" => "در حال اجرا",
        _ => "نامشخص"
    };

    private static string RunStatusClass(string? status) => status switch
    {
        "success" => "cs-status--published",
        "partial" => "cs-status--duplicate",
        "failed" => "cs-status--failed",
        "running" => "cs-status--processing",
        _ => "cs-status--skipped"
    };
}
