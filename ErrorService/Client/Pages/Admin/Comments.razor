    private async Task SubmitReply(CommentItem parent)
    {
        _replyError = null;
        _replySuccess = null;
        if (string.IsNullOrWhiteSpace(_replyContent))
        {
            _replyError = "متن پاسخ نمی‌تواند خالی باشد";
            return;
        }
        _isReplying = true;
        try
        {
            var name = string.IsNullOrWhiteSpace(_replyName) ? "مدیریت" : _replyName.Trim();
            HttpResponseMessage resp = parent.SourceType switch
            {
                SECTION_PRODUCTS => await Http.PostAsJsonAsync($"api/products/{parent.OwnerId}/reviews", new ProductReviewRequest
                {
                    FullName = name,
                    Email = "admin@errorservice.ir",
                    Content = _replyContent.Trim(),
                    Rating = 5,
                    ParentId = parent.Id
                }),
                SECTION_ACADEMY => await Http.PostAsJsonAsync($"api/trainingarticles/{parent.OwnerId}/comments", new TrainingArticleCommentRequest
                {
                    FullName = name,
                    Content = _replyContent.Trim(),
                    ParentId = parent.Id
                }),
                SECTION_NEWS => await Http.PostAsJsonAsync($"api/news/{parent.OwnerId}/comments", new CommentRequest
                {
                    FullName = name,
                    Content = _replyContent.Trim(),
                    ParentId = parent.Id
                }),
                _ => throw new NotSupportedException()
            };
            if (resp.IsSuccessStatusCode)
            {
                _replySuccess = "پاسخ با موفقیت ارسال شد.";
                _replyContent = "";
                await Task.Delay(1500);
                _replyTargetId = null;
            }
            else
            {
                _replyError = "خطا در ارسال پاسخ";
            }
        }
        catch
        {
            _replyError = "خطا در ارسال پاسخ";
        }
        finally
        {
            _isReplying = false;
        }
    }

    private void StartEdit(CommentItem item)
    {
        _replyTargetId = null;
        _editTargetId = _editTargetId == item.Id ? null : item.Id;
        _editName = item.Author;
        _editContent = item.Content;
        _editRating = item.Rating;
    }

    private void CancelEdit()
    {
        _editTargetId = null;
        _editName = "";
        _editContent = "";
        _editRating = null;
    }

    private async Task SubmitEdit(CommentItem item)
    {
        if (string.IsNullOrWhiteSpace(_editContent))
        {
            ToastService.ShowError("متن نظر نمی‌تواند خالی باشد");
            return;
        }
        _isEditing = true;
        try
        {
            var req = new CommentEditRequest
            {
                FullName = string.IsNullOrWhiteSpace(_editName) ? null : _editName.Trim(),
                Content = _editContent.Trim(),
                Rating = _editRating
            };
            var resp = item.SourceType switch
            {
                SECTION_PRODUCTS => await Http.PutAsJsonAsync($"api/products/{item.OwnerId}/reviews/{item.Id}", req),
                SECTION_ACADEMY => await Http.PutAsJsonAsync($"api/trainingarticles/comments/{item.Id}", req),
                SECTION_NEWS => await Http.PutAsJsonAsync($"api/news/{item.OwnerId}/comments/{item.Id}", req),
                _ => await Http.PutAsJsonAsync($"api/trust/admin/testimonials/{item.Id}", req)
            };
            if (resp.IsSuccessStatusCode)
            {
                item.Author = req.FullName ?? item.Author;
                item.Content = req.Content;
                item.Rating = req.Rating;
                ToastService.ShowSuccess("نظر ویرایش شد");
                _editTargetId = null;
            }
            else
            {
                ToastService.ShowError("خطا در ویرایش");
            }
        }
        catch
        {
            ToastService.ShowError("خطا در ویرایش");
        }
        finally
        {
            _isEditing = false;
        }
    }

