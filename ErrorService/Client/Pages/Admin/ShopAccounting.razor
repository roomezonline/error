@page "/admin/shop-accounting"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.orders.view")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Services
@using ErrorService.Client.Utils
@inject HttpClient Http
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>حسابداری فروشگاه | ارورسرویس</PageTitle>

<div class="admin-container ac-page" dir="rtl">
    <div class="ac-head">
        <div>
            <h3 class="admin-page-title m-0">حسابداری فروشگاه</h3>
            <div class="ac-sub">
                @if (report == null)
                {
                    <span>در حال محاسبه…</span>
                }
                else
                {
                    <span>بازه: <b>@report.DateFrom</b> تا <b>@report.DateTo</b> (@report.RangeDays روز)</span>
                }
            </div>
        </div>
        <button class="btn btn-outline-secondary rounded-3 shadow-sm" @onclick="Load" disabled="@loading">
            <span class="oi oi-reload me-1"></span> بروزرسانی
        </button>
    </div>

    <div class="ac-filter card border-0 shadow-sm rounded-4 p-3 mb-4">
        <div class="ac-presets">
            @foreach (var p in Presets)
            {
                <button class="ac-chip @(preset == p.Key ? "ac-chip--active" : "")" @onclick="() => SetPreset(p.Key)">
                    @p.Label
                </button>
            }
        </div>
        <div class="ac-dates">
            <div class="ac-date">
                <label>از تاریخ</label>
                <input class="ac-date__input" data-jdp autocomplete="off" placeholder="از تاریخ"
                       @bind="dateFrom" @bind:event="oninput" @bind:after="OnDateChanged" />
            </div>
            <div class="ac-date">
                <label>تا تاریخ</label>
                <input class="ac-date__input" data-jdp autocomplete="off" placeholder="تا تاریخ"
                       @bind="dateTo" @bind:event="oninput" @bind:after="OnDateChanged" />
            </div>
            <button class="btn btn-primary rounded-3 px-4" @onclick="ApplyCustom" disabled="@loading">
                ساخت گزارش
            </button>
        </div>
    </div>

    @if (loading && report == null)
    {
        <div class="ac-loading">
            <div class="spinner-border text-primary"></div>
            <div class="mt-2 small text-muted">محاسبه گزارش مالی…</div>
        </div>
    }
    else if (report == null)
    {
        <div class="ac-empty">داده‌ای برای این بازه وجود ندارد.</div>
    }
    else
    {
        <div class="ac-kpi">
            <div class="ac-kpi__item ac-kpi__item--hero">
                <span class="ac-kpi__label">درآمد خالص (پس از مرجوعی)</span>
                <span class="ac-kpi__value">@report.NetRevenue.ToString("N0")</span>
                <span class="ac-kpi__hint">تومان — تاییدشده منهای بازپرداخت</span>
            </div>
            <div class="ac-kpi__item ac-kpi__item--ok">
                <span class="ac-kpi__label">فروش تاییدشده</span>
                <span class="ac-kpi__value">@report.ConfirmedAmount.ToString("N0")</span>
                <span class="ac-kpi__hint">@report.ConfirmedCount سفارش تایید/تکمیل</span>
            </div>
            <div class="ac-kpi__item">
                <span class="ac-kpi__label">فروش قابل پرداخت</span>
                <span class="ac-kpi__value">@report.SellAmount.ToString("N0")</span>
                <span class="ac-kpi__hint">@report.ActiveCount سفارش فعال (بدون لغو/رد)</span>
            </div>
            <div class="ac-kpi__item">
                <span class="ac-kpi__label">سفارش ثبت‌شده</span>
                <span class="ac-kpi__value">@report.OrdersCount.ToString("N0")</span>
                <span class="ac-kpi__hint">میانگین @report.AvgOrderAmount.ToString("N0") تومان</span>
            </div>
            <div class="ac-kpi__item ac-kpi__item--info">
                <span class="ac-kpi__label">اقلام فروخته‌شده</span>
                <span class="ac-kpi__value">@report.UnitsSold.ToString("N0")</span>
                <span class="ac-kpi__hint">@report.UnitsCancelled قلم در سفارش‌های لغو/رد شده</span>
            </div>
            <div class="ac-kpi__item ac-kpi__item--danger">
                <span class="ac-kpi__label">مرجوعی</span>
                <span class="ac-kpi__value">@report.ReturnsCount.ToString("N0")</span>
                <span class="ac-kpi__hint">@report.RefundAmount.ToString("N0") تومان بازپرداخت</span>
            </div>
        </div>

        <div class="ac-grid">
            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="ac-card-title">خلاصه مالی</div>
                <div class="ac-rows">
                    <div class="ac-row"><span>مبلغ ناخالص (با ارسال)</span><b>@report.GrossAmount.ToString("N0")</b></div>
                    <div class="ac-row ac-row--minus"><span>تخفیف اعمال‌شده</span><b>@report.DiscountTotal.ToString("N0")</b></div>
                    <div class="ac-row"><span>هزینه ارسال</span><b>@report.ShippingTotal.ToString("N0")</b></div>
                    <div class="ac-row ac-row--strong"><span>فروش قابل پرداخت</span><b>@report.SellAmount.ToString("N0")</b></div>
                    <div class="ac-row ac-row--ok"><span>تاییدشده (درآمد)</span><b>@report.ConfirmedAmount.ToString("N0")</b></div>
                    <div class="ac-row"><span>در انتظار پرداخت (@report.PendingCount)</span><b>@report.PendingAmount.ToString("N0")</b></div>
                    <div class="ac-row"><span>رسید آپلود شده (@report.ReceiptCount)</span><b>@report.ReceiptAmount.ToString("N0")</b></div>
                    <div class="ac-row ac-row--minus"><span>لغو/رد شده (@(@report.CancelledCount + report.RejectedCount))</span><b>@report.CancelledAmount.ToString("N0")</b></div>
                    <div class="ac-row ac-row--minus"><span>بازپرداخت مرجوعی (@report.RefundedCount)</span><b>@report.RefundAmount.ToString("N0")</b></div>
                    <div class="ac-row ac-row--hero"><span>درآمد خالص</span><b>@report.NetRevenue.ToString("N0")</b></div>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4 p-3">
                <div class="ac-card-title">وضعیت سفارش‌ها</div>
                <div class="ac-rows">
                    @foreach (var s in report.Statuses)
                    {
                        var tone = s.Key switch
                        {
                            "Approved" or "Completed" => "ac-row--ok",
                            "Cancelled" or "Rejected" => "ac-row--minus",
                            _ => ""
                        };
                        <div class="ac-row @tone">
                            <span>@s.Label <i class="ac-badge">@s.Count</i></span>
                            <b>@s.Amount.ToString("N0")</b>
                        </div>
                    }
                </div>
                <div class="ac-note">
                    مبالغ به تومان است. سفارش‌های لغو/رد شده جزو درآمد حساب نمی‌شوند.
                </div>
            </div>
        </div>

        @if (report.IncludeDaily && report.Daily.Count > 0)
        {
            <div class="card border-0 shadow-sm rounded-4 p-3 mt-4">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="ac-card-title m-0">روزشمار فروش</div>
                    <div class="small text-muted">فروش قابل پرداخت هر روز (تومان) — برای جزئیات، روی روز کلیک کنید</div>
                </div>
                <div class="ac-days">
                    @foreach (var d in report.Daily)
                    {
                        <div class="ac-day @(d.Amount == 0 && d.RefundAmount == 0 ? "ac-day--empty" : "")"
                             role="button" tabindex="0"
                             title="سفارش‌های @d.JalaliDate را ببینید"
                             @onclick="() => OpenDay(d)"
                             @onkeydown="e => OnDayKey(e, d)">
                            <span class="ac-day__date">@d.JalaliDate</span>
                            <span class="ac-day__meta">@d.OrdersCount سفارش · @d.Units قلم</span>
                            <div class="ac-day__bar"><i style="width: @BarPct(d.Amount)%"></i></div>
                            <span class="ac-day__amount">@d.Amount.ToString("N0")</span>
                            @if (d.CancelledAmount > 0)
                            {
                                <span class="ac-day__cancel" title="لغو/رد شده">−@d.CancelledAmount.ToString("N0")</span>
                            }
                            @if (d.RefundAmount > 0)
                            {
                                <span class="ac-day__refund" title="بازپرداخت مرجوعی">↩ @d.RefundAmount.ToString("N0")</span>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        @if (selectedDay != null)
        {
            <div class="ac-modal" @onclick="CloseDay">
                <div class="ac-modal__box" @onclick:stopPropagation="true">
                    <div class="ac-modal__head">
                        <div>
                            <div class="ac-modal__title">جزئیات روز <b>@selectedDay.JalaliDate</b></div>
                            @if (dayDetail != null)
                            {
                                <div class="ac-modal__sub">
                                    @dayDetail.OrdersCount سفارش · @dayDetail.Units قلم فروخته‌شده · @dayDetail.Date
                                </div>
                            }
                        </div>
                        <button type="button" class="ac-modal__close" @onclick="CloseDay" aria-label="بستن">×</button>
                    </div>

                    @if (dayLoading)
                    {
                        <div class="ac-modal__loading">
                            <div class="spinner-border text-primary"></div>
                            <div class="small text-muted mt-2">در حال دریافت سفارش‌های این روز…</div>
                        </div>
                    }
                    else if (dayDetail != null)
                    {
                        <div class="ac-modal__stats">
                            <span class="ac-stat"><i>سفارش ثبت‌شده</i><b>@dayDetail.OrdersCount</b></span>
                            <span class="ac-stat"><i>سفارش فعال</i><b>@dayDetail.ActiveCount</b></span>
                            <span class="ac-stat ac-stat--ok"><i>تاییدشده</i><b>@dayDetail.ConfirmedCount</b></span>
                            <span class="ac-stat ac-stat--bad"><i>لغو/رد شده</i><b>@dayDetail.CancelledCount</b></span>
                            <span class="ac-stat"><i>اقلام فروخته‌شده</i><b>@dayDetail.Units</b></span>
                            <span class="ac-stat ac-stat--money"><i>فروش قابل پرداخت</i><b>@dayDetail.Amount.ToString("N0")</b></span>
                            <span class="ac-stat ac-stat--ok"><i>تاییدشده (مبلغ)</i><b>@dayDetail.ConfirmedAmount.ToString("N0")</b></span>
                            @if (dayDetail.RefundAmount > 0)
                            {
                                <span class="ac-stat ac-stat--warn"><i>بازپرداخت مرجوعی</i><b>@dayDetail.RefundAmount.ToString("N0")</b></span>
                            }
                        </div>

                        @if (dayDetail.Orders.Count == 0)
                        {
                            <div class="ac-modal__empty">سفارشی در این روز ثبت نشده است.</div>
                        }
                        else
                        {
                            <div class="ac-orders">
                                @foreach (var o in dayDetail.Orders)
                                {
                                    <div class="ac-order @(o.IsCancelled ? "ac-order--cancelled" : "")">
                                        <div class="ac-order__head">
                                            <span class="ac-order__no">سفارش <b dir="ltr">@o.OrderNumber</b></span>
                                            <span class="ac-order__status @StatusTone(o.StatusKey)">@o.StatusLabel</span>
                                            <span class="ac-order__time" dir="ltr">@o.Time</span>
                                            @if (!string.IsNullOrEmpty(o.CouponCode))
                                            {
                                                <span class="ac-order__coupon" title="کد تخفیف">کوپن: <b dir="ltr">@o.CouponCode</b></span>
                                            }
                                            <a class="ac-order__link" href="/admin/orders/@o.Id" @onclick:stopPropagation="true">مشاهده سفارش</a>
                                        </div>

                                        <div class="ac-order__customer">
                                            <span class="ac-order__name">@o.CustomerName</span>
                                            <span class="ac-order__phone" dir="ltr">@o.Phone</span>
                                        </div>

                                        <div class="ac-order__items">
                                            @foreach (var it in o.Items)
                                            {
                                                <div class="ac-item">
                                                    <span class="ac-item__name">@it.Name</span>
                                                    <span class="ac-item__qty" dir="ltr">@it.Quantity × @it.UnitPrice.ToString("N0")</span>
                                                    <span class="ac-item__total" dir="ltr">@it.Total.ToString("N0")</span>
                                                </div>
                                            }
                                        </div>

                                        <div class="ac-order__totals">
                                            <span>کل سفارش: <b dir="ltr">@o.TotalAmount.ToString("N0")</b></span>
                                            @if (o.DiscountAmount > 0)
                                            {
                                                <span class="ac-order__disc">تخفیف: <b dir="ltr">−@o.DiscountAmount.ToString("N0")</b></span>
                                            }
                                            @if (o.ShippingCost > 0)
                                            {
                                                <span>ارسال: <b dir="ltr">@o.ShippingCost.ToString("N0")</b></span>
                                            }
                                            <span class="ac-order__pay">قابل پرداخت: <b dir="ltr">@o.Payable.ToString("N0")</b></span>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (dayDetail.Returns.Count > 0)
                        {
                            <div class="ac-returns">
                                <div class="ac-returns__title">مرجوعی‌های این روز (@dayDetail.Returns.Count)</div>
                                @foreach (var r in dayDetail.Returns)
                                {
                                    <div class="ac-return">
                                        <span>سفارش <b dir="ltr">@r.OrderNumber</b></span>
                                        @if (!string.IsNullOrWhiteSpace(r.Reason))
                                        {
                                            <span class="ac-return__reason">@r.Reason</span>
                                        }
                                        <span class="ac-return__amt @(r.IsRefunded ? "" : "ac-return__amt--pending")" dir="ltr">
                                            @(r.IsRefunded ? "↩ " : "در انتظار: ")@r.RefundAmount.ToString("N0")
                                        </span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="ac-modal__foot">
                            <button type="button" class="btn btn-outline-secondary rounded-3" @onclick="CloseDay">بستن</button>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .ac-page { padding-bottom: 32px; }
    .ac-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; flex-wrap: wrap; margin-bottom: 16px; }
    .ac-sub { font-size: .78rem; color: #64748b; margin-top: 4px; }
    .ac-sub b { color: #0f172a; }

    .ac-presets { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
    .ac-chip {
        border: 1px solid #e2e8f0; background: #fff; color: #475569;
        border-radius: 999px; padding: 6px 14px; font-size: .78rem; font-weight: 700;
        cursor: pointer; transition: all .15s; font-family: inherit;
    }
    .ac-chip:hover { border-color: #c7d2fe; color: #4338ca; }
    .ac-chip--active { background: #4f46e5; border-color: #4f46e5; color: #fff; }

    .ac-dates { display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; }
    .ac-date { flex: 1; min-width: 160px; }
    .ac-date label { display: block; font-size: .68rem; color: #94a3b8; font-weight: 700; margin-bottom: 4px; }
    .ac-date__input {
        width: 100%; padding: 8px 10px; border: 1px solid #e2e8f0; border-radius: 10px;
        font-size: .82rem; background: #fff; outline: none; font-family: inherit;
        text-align: center; cursor: pointer; transition: border-color .2s;
    }
    .ac-date__input:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,.12); }

    .ac-loading { text-align: center; padding: 48px 16px; }
    .ac-empty { text-align: center; padding: 48px 16px; color: #94a3b8; font-size: .9rem; }

    .ac-kpi { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin-bottom: 16px; }
    .ac-kpi__item {
        background: #fff; border: 1px solid #e8edf3; border-radius: 14px; padding: 14px;
        display: flex; flex-direction: column; gap: 5px; box-shadow: 0 1px 2px rgba(15,23,42,.04);
        border-inline-start: 4px solid #cbd5e1;
    }
    .ac-kpi__item--hero { border-inline-start-color: #4f46e5; background: linear-gradient(180deg,#eef2ff 0%,#fff 60%); }
    .ac-kpi__item--ok { border-inline-start-color: #059669; }
    .ac-kpi__item--info { border-inline-start-color: #0891b2; }
    .ac-kpi__item--danger { border-inline-start-color: #dc2626; }
    .ac-kpi__label { font-size: .72rem; color: #64748b; font-weight: 700; }
    .ac-kpi__value { font-size: 1.35rem; font-weight: 900; color: #0f172a; direction: ltr; text-align: right; }
    .ac-kpi__item--hero .ac-kpi__value { color: #4338ca; }
    .ac-kpi__item--ok .ac-kpi__value { color: #047857; }
    .ac-kpi__item--danger .ac-kpi__value { color: #b91c1c; }
    .ac-kpi__hint { font-size: .68rem; color: #94a3b8; }

    .ac-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
    .ac-card-title { font-size: .8rem; font-weight: 800; color: #0f172a; margin-bottom: 10px; }

    .ac-rows { display: flex; flex-direction: column; gap: 2px; }
    .ac-row {
        display: flex; justify-content: space-between; align-items: center; gap: 8px;
        padding: 7px 8px; border-radius: 8px; font-size: .8rem; color: #475569;
    }
    .ac-row:nth-child(odd) { background: #f8fafc; }
    .ac-row b { direction: ltr; font-weight: 800; color: #0f172a; }
    .ac-row--strong { background: #eef2ff !important; }
    .ac-row--strong b, .ac-row--strong span { color: #4338ca; font-weight: 800; }
    .ac-row--ok b, .ac-row--ok span { color: #047857; font-weight: 800; }
    .ac-row--minus b, .ac-row--minus span { color: #b91c1c; font-weight: 700; }
    .ac-row--hero { background: linear-gradient(90deg,#4f46e5,#6366f1) !important; }
    .ac-row--hero span, .ac-row--hero b { color: #fff !important; font-weight: 900; font-size: .86rem; }
    .ac-badge {
        display: inline-block; min-width: 20px; text-align: center; font-style: normal;
        background: #e2e8f0; color: #334155; border-radius: 999px; padding: 1px 7px;
        font-size: .68rem; font-weight: 800; margin-inline-start: 4px;
    }
    .ac-note { margin-top: 10px; font-size: .7rem; color: #94a3b8; line-height: 1.7; }

    .ac-days { display: flex; flex-direction: column; gap: 4px; max-height: 460px; overflow-y: auto; padding-inline-end: 4px; }
    .ac-day {
        display: grid; grid-template-columns: 84px 110px 1fr 110px auto; align-items: center;
        gap: 8px; padding: 5px 8px; border-radius: 8px; font-size: .74rem; background: #f8fafc;
        border: 1px solid transparent; cursor: pointer; transition: background .15s, border-color .15s, box-shadow .15s;
    }
    .ac-day:hover { background: #eef2ff; border-color: #c7d2fe; box-shadow: 0 1px 3px rgba(79,70,229,.14); }
    .ac-day:focus-visible { outline: 2px solid #4f46e5; outline-offset: 1px; }
    .ac-day--empty { opacity: .55; }
    .ac-day__date { font-weight: 800; color: #334155; direction: ltr; text-align: right; }
    .ac-day__meta { color: #94a3b8; font-size: .68rem; }
    .ac-day__bar { height: 8px; background: #eef2f7; border-radius: 999px; overflow: hidden; }
    .ac-day__bar i { display: block; height: 100%; background: linear-gradient(90deg,#6366f1,#2563eb); border-radius: 999px; transition: width .4s; }
    .ac-day__amount { direction: ltr; font-weight: 800; color: #0f172a; text-align: left; }
    .ac-day__cancel { color: #dc2626; font-size: .68rem; direction: ltr; }
    .ac-day__refund { color: #b45309; font-size: .68rem; direction: ltr; }

    /* ── مودال جزئیات روز ── */
    .ac-modal {
        position: fixed; inset: 0; z-index: 1060; display: flex; align-items: flex-start; justify-content: center;
        padding: 4vh 12px; overflow-y: auto; background: rgba(15,23,42,.55); backdrop-filter: blur(2px);
    }
    .ac-modal__box {
        background: #fff; width: min(780px, 100%); margin: auto; border-radius: 18px; padding: 18px;
        box-shadow: 0 24px 70px rgba(15,23,42,.35); animation: acPop .16s ease-out;
    }
    @@keyframes acPop { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }
    .ac-modal__head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
    .ac-modal__title { font-size: .95rem; font-weight: 900; color: #0f172a; }
    .ac-modal__title b { color: #4338ca; }
    .ac-modal__sub { font-size: .72rem; color: #94a3b8; margin-top: 3px; }
    .ac-modal__close {
        border: 0; background: #f1f5f9; color: #475569; width: 30px; height: 30px; border-radius: 50%;
        font-size: 1.15rem; line-height: 1; cursor: pointer; transition: background .15s;
    }
    .ac-modal__close:hover { background: #e2e8f0; color: #0f172a; }
    .ac-modal__loading { text-align: center; padding: 36px 12px; }
    .ac-modal__empty { text-align: center; padding: 26px 12px; color: #94a3b8; font-size: .82rem; }
    .ac-modal__foot { display: flex; justify-content: flex-end; margin-top: 14px; }

    .ac-modal__stats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
    .ac-stat {
        display: flex; flex-direction: column; gap: 2px; min-width: 92px; flex: 1 1 92px;
        background: #f8fafc; border: 1px solid #eef2f7; border-radius: 12px; padding: 8px 10px;
    }
    .ac-stat i { font-style: normal; font-size: .64rem; color: #94a3b8; font-weight: 700; }
    .ac-stat b { font-size: .95rem; font-weight: 900; color: #0f172a; direction: ltr; text-align: right; }
    .ac-stat--ok { background: #ecfdf5; border-color: #d1fae5; }
