        }
    }

    private void HandleCartChanged() => InvokeAsync(StateHasChanged);

    private void StartSlideTimer()
    {
        slideTimer?.Dispose();
        slideTimer = new System.Threading.Timer(_ =>
        {
            currentSlide = (currentSlide + 1) % heroSlides.Count;
            InvokeAsync(StateHasChanged);
        }, null, 5000, 5000);
    }

    private void GoToSlide(int idx)
    {
        currentSlide = idx;
        StartSlideTimer();
    }

    private void PrevSlide()
    {
        currentSlide = (currentSlide - 1 + heroSlides.Count) % heroSlides.Count;
        StartSlideTimer();
    }

    private void NextSlide()
    {
        currentSlide = (currentSlide + 1) % heroSlides.Count;
        StartSlideTimer();
    }

    private async Task LoadCategories()
    {
        try
        {
            categories = await Http.GetFromJsonAsync<List<CategoryDto>>("api/categories");
            categories ??= new();
        }
        catch
        {
            categories = new();
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1) page = 1;
        if (page > totalPages) page = totalPages;
        if (page == currentPage && products != null) return;
        currentPage = page;
        skip = (currentPage - 1) * take;
        await LoadProducts();
    }

    private List<int> GetPageNumbers()
    {
        var pages = new List<int>();
        if (totalPages <= 7)
        {
            for (int i = 1; i <= totalPages; i++) pages.Add(i);
        }
        else
        {
            pages.Add(1);
            if (currentPage > 3) pages.Add(-1);
            int start = Math.Max(2, currentPage - 1);
            int end = Math.Min(totalPages - 1, currentPage + 1);
            for (int i = start; i <= end; i++) pages.Add(i);
            if (currentPage < totalPages - 2) pages.Add(-1);
            pages.Add(totalPages);
        }
        return pages;
    }

    private async Task LoadProducts()
