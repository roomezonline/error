@code {
    [Inject] private HttpClient Http { get; set; } = default!;

    private List<ServiceVoiceActionDto>? _items;
    private List<ServiceVoiceDeviceDto> _devices = new();
    private int? _selectedDeviceId;
    private bool _loadingDevices;
    private ServiceVoiceActionUpsertRequest _model = NewModel(10, 0);
    private int? _editingId;
    private bool _saving;
    private bool _recorderSupported;
    private bool _isRecording;
    private int _recordSeconds;
    private string _pendingUrl = string.Empty;
    private string _existingAudioUrl = string.Empty;
    private DotNetObjectReference<ServiceVoices>? _dotNetRef;

    private ServiceVoiceActionDto? _itemToDelete;
    private bool _showDeleteConfirm;
    private int? _testingId;

    private ServiceVoiceDeviceDto? _selectedDevice =>
        _devices.FirstOrDefault(x => x.Id == _selectedDeviceId);

    private int ActiveCount => _items?.Count(x => x.IsActive) ?? 0;
    private int WithAudioCount => _items?.Count(x => !string.IsNullOrWhiteSpace(x.AudioUrl)) ?? 0;

    private static string DeviceLabel(ServiceVoiceDeviceDto d) =>
        string.IsNullOrWhiteSpace(d.WorkshopTitle)
            ? $"{d.Title} — {d.DeviceNumber}"
            : $"{d.Title} — {d.DeviceNumber} ({d.WorkshopTitle})";

    /// <summary>اگر کلید فعلی یکی از رویدادهای استاندارد باشد، همان در dropdown انتخاب می‌شود.</summary>
    private string EventKeySelectValue =>
        ServiceVoiceEventKeys.Options.Any(x => string.Equals(x.Key, _model.Key, StringComparison.OrdinalIgnoreCase))
            ? _model.Key.ToLowerInvariant()
            : string.Empty;

    private void OnEventKeyChanged(ChangeEventArgs e)
    {
        var key = (e.Value?.ToString() ?? string.Empty).Trim().ToLowerInvariant();
        var option = ServiceVoiceEventKeys.Options
            .FirstOrDefault(x => string.Equals(x.Key, key, StringComparison.OrdinalIgnoreCase));

        if (option == null)
        {
            // «بدون اتصال»: اگر کلید فعلی از رویدادهای استاندارد است پاک می‌شود؛
            // کلید دستی سفارشی دست‌نخورده می‌ماند.
            if (ServiceVoiceEventKeys.TitleOf(_model.Key) != null)
            {
                _model.Key = string.Empty;
                _model.TitleFa = string.Empty;
            }
            return;
        }

        _model.Key = option.Key;
        _model.TitleFa = option.TitleFa;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDevicesAsync(keepSelection: false);
        if (_selectedDeviceId is > 0)
            await LoadAsync();
        else
            _items = new();

        Reset();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _recorderSupported = await JS.InvokeAsync<bool>("serviceVoiceRecorder.isSupported");
            if (_recorderSupported) StateHasChanged();
        }
        catch
        {
            _recorderSupported = false;
        }
    }

    private async Task LoadDevicesAsync(bool keepSelection = true)
    {
        _loadingDevices = true;
        var previous = keepSelection ? _selectedDeviceId : null;
        try
        {
            var list = await Http.GetFromJsonAsync<List<ServiceVoiceDeviceDto>>("api/admin/service-voices/devices")
                       ?? new();

            _devices = list;
            _selectedDeviceId = list.Any(x => x.Id == previous)
                ? previous
                : list.FirstOrDefault()?.Id;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                                           || ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _devices = new();
            _selectedDeviceId = null;
            ToastService.ShowError("خطای دسترسی: این بخش فقط برای سوپر ادمین فعال است.");
        }
        catch
        {
            _devices = new();
            _selectedDeviceId = null;
            ToastService.ShowError("خطا در بارگذاری دستگاه‌های فعال");
        }
        finally
        {
            _loadingDevices = false;
        }
    }

    private async Task ReloadDevicesAsync()
    {
        await LoadDevicesAsync();
        if (_selectedDeviceId is > 0)
            await LoadAsync();
        else
            _items = new();

        Reset();
    }

    private async Task OnDeviceChangedAsync()
    {
        await LoadAsync();
        Reset();
    }

    private async Task LoadAsync()
    {
        if (_selectedDeviceId is not > 0)
        {
            _items = new();
            return;
        }

        try
        {
            _items = await Http.GetFromJsonAsync<List<ServiceVoiceActionDto>>(
                         $"api/admin/service-voices?deviceId={_selectedDeviceId}") ?? new();
            _items = _items.OrderBy(x => x.Priority).ThenBy(x => x.Id).ToList();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized
                                           || ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _items = new();
            ToastService.ShowError("خطای دسترسی: این بخش فقط برای سوپر ادمین فعال است.");
        }
        catch
        {
            _items = new();
            ToastService.ShowError("خطا در بارگذاری اکشن‌ها");
        }
    }

    private async Task NewItemAsync()
    {
        if (_selectedDeviceId is not > 0)
        {
            ToastService.ShowWarning("ابتدا از نوار «دستگاه هدف» یک دستگاه فعال انتخاب کنید.");
            return;
        }

        Reset();
        await ScrollToEditorAsync();
    }

    private void Edit(ServiceVoiceActionDto it)
    {
        _editingId = it.Id;
        _model = new ServiceVoiceActionUpsertRequest
        {
            Id = it.Id,
            MonitoringDeviceId = it.DeviceId ?? _selectedDeviceId ?? 0,
            Key = it.Key,
            TitleFa = it.TitleFa,
            IsActive = it.IsActive,
            RepeatCount = it.RepeatCount,
            Priority = it.Priority
        };
        _existingAudioUrl = it.AudioUrl ?? string.Empty;
        _pendingUrl = string.Empty;
        _recordSeconds = 0;
        _ = ClearRecorderPendingAsync();
        _ = ScrollToEditorAsync();
    }

    private void Reset()
    {
        _editingId = null;
        _model = NewModel(NextPriority(), _selectedDeviceId ?? 0);
        _existingAudioUrl = string.Empty;
        _pendingUrl = string.Empty;
        _recordSeconds = 0;
        _ = ClearRecorderPendingAsync();
    }

    private int NextPriority()
    {
        if (_items == null || _items.Count == 0) return 10;
        return Math.Min(1000, _items.Max(x => x.Priority) + 10);
    }

    private static ServiceVoiceActionUpsertRequest NewModel(int priority, int deviceId) => new()
    {
        MonitoringDeviceId = deviceId,
        Key = string.Empty,
        TitleFa = string.Empty,
        IsActive = true,
        RepeatCount = 1,
        Priority = priority
    };

    private async Task ScrollToEditorAsync()
    {
        try { await JS.InvokeVoidAsync("serviceVoiceRecorder.scrollToEditor", "sv-editor"); } catch { }
    }

    private async Task SaveAsync()
    {
        if (_isRecording) return;

        if (_selectedDeviceId is not > 0)
        {
            ToastService.ShowWarning("ابتدا از نوار «دستگاه هدف» یک دستگاه فعال انتخاب کنید.");
            return;
        }

        _saving = true;
        try
        {
            _model.MonitoringDeviceId = _selectedDeviceId.Value;

            var resp = await Http.PostAsJsonAsync("api/admin/service-voices", _model);
            if (!resp.IsSuccessStatusCode)
            {
                ToastService.ShowError(await ReadErrorAsync(resp, "خطا در ذخیره اکشن"));
                return;
            }

            var saved = await resp.Content.ReadFromJsonAsync<ServiceVoiceActionDto>();
            if (saved == null)
            {
                ToastService.ShowError("پاسخ سرور نامعتبر بود");
                return;
            }

            var uploaded = false;
            if (_recorderSupported && await JS.InvokeAsync<bool>("serviceVoiceRecorder.hasPending"))
            {
                var result = await JS.InvokeAsync<VoiceUploadResult>(
                    "serviceVoiceRecorder.uploadPending", $"/api/admin/service-voices/{saved.Id}/audio");

                if (result?.Ok == true)
                {
                    uploaded = true;
                }
                else
                {
                    ToastService.ShowWarning("اکشن ذخیره شد، اما آپلود صدا انجام نشد: " +
                        CleanErrorBody(result?.Body) + " — دوباره ضبط و ذخیره کنید.");
                }
            }

            _pendingUrl = string.Empty;
            _recordSeconds = 0;
            ToastService.ShowSuccess(uploaded ? "اکشن و صدا ذخیره شد" : "اکشن ذخیره شد");

            await LoadDevicesAsync();
            await LoadAsync();
            var refreshed = _items?.FirstOrDefault(x => x.Id == saved.Id);
            if (refreshed != null)
            {
                _editingId = refreshed.Id;
                _model = new ServiceVoiceActionUpsertRequest
                {
                    Id = refreshed.Id,
                    MonitoringDeviceId = refreshed.DeviceId ?? _selectedDeviceId ?? 0,
                    Key = refreshed.Key,
                    TitleFa = refreshed.TitleFa,
                    IsActive = refreshed.IsActive,
                    RepeatCount = refreshed.RepeatCount,
                    Priority = refreshed.Priority
                };
                _existingAudioUrl = refreshed.AudioUrl ?? string.Empty;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا در ذخیره: {ex.Message}");
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleAsync(ServiceVoiceActionDto it)
    {
        try
        {
            var resp = await Http.PostAsync($"api/admin/service-voices/{it.Id}/toggle", null);
            if (resp.IsSuccessStatusCode)
            {
                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(await ReadErrorAsync(resp, "تغییر وضعیت انجام نشد"));
            }
        }
        catch
        {
            ToastService.ShowError("تغییر وضعیت انجام نشد");
        }
    }

    private async Task TestAsync(ServiceVoiceActionDto it)
    {
        if (_testingId != null || _saving) return;

        _testingId = it.Id;
        try
        {
            var resp = await Http.PostAsync($"api/admin/service-voices/{it.Id}/test", null);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<ServiceVoiceTestResultDto>();
                ToastService.ShowSuccess(result?.Message ?? "درخواست پخش آزمایشی برای دستگاه ارسال شد");
            }
            else
            {
                ToastService.ShowError(await ReadErrorAsync(resp, "ارسال پخش آزمایشی انجام نشد"));
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"ارسال پخش آزمایشی انجام نشد: {ex.Message}");
        }
        finally
        {
            _testingId = null;
        }
    }

    private async Task DeleteAudioAsync()
    {
        if (_editingId is null) return;

        _saving = true;
        try
        {
            var resp = await Http.DeleteAsync($"api/admin/service-voices/{_editingId}/audio");
            if (resp.IsSuccessStatusCode)
            {
                _existingAudioUrl = string.Empty;
                ToastService.ShowSuccess("صدای اکشن حذف شد");
                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(await ReadErrorAsync(resp, "حذف صدا انجام نشد"));
            }
        }
        catch
        {
            ToastService.ShowError("حذف صدا انجام نشد");
        }
        finally
        {
            _saving = false;
        }
    }

    private void AskDelete(ServiceVoiceActionDto it)
    {
        _itemToDelete = it;
        _showDeleteConfirm = true;
    }

    private async Task HandleDeleteResult(bool ok)
    {
        _showDeleteConfirm = false;
        var item = _itemToDelete;
        _itemToDelete = null;

        if (!ok || item == null) return;

        try
        {
            var resp = await Http.DeleteAsync($"api/admin/service-voices/{item.Id}");
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("اکشن حذف شد");
                if (_editingId == item.Id) Reset();
                await LoadDevicesAsync();
                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(await ReadErrorAsync(resp, "حذف اکشن انجام نشد"));
            }
        }
        catch
        {
            ToastService.ShowError("حذف اکشن انجام نشد");
        }
    }

    private async Task StartRecordingAsync()
    {
        _dotNetRef ??= DotNetObjectReference.Create(this);
        try
        {
            var result = await JS.InvokeAsync<VoiceStartResult>("serviceVoiceRecorder.start", _dotNetRef);
            if (result?.Ok == true)
            {
                _isRecording = true;
                _recordSeconds = 0;
                _pendingUrl = string.Empty;
            }
            else
            {
                ToastService.ShowError(result?.Error ?? "شروع ضبط انجام نشد");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"شروع ضبط انجام نشد: {ex.Message}");
        }
    }

    private async Task StopRecordingAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("serviceVoiceRecorder.stop");
        }
        catch
        {
            // callback نتیجه را برمی‌گرداند
        }
        _isRecording = false;
    }

    private async Task ClearPendingAsync()
    {
        _pendingUrl = string.Empty;
        _recordSeconds = 0;
        await ClearRecorderPendingAsync();
    }

    private async Task ClearRecorderPendingAsync()
    {
        if (!_recorderSupported) return;
        try { await JS.InvokeVoidAsync("serviceVoiceRecorder.clearPending"); } catch { }
    }

    [JSInvokable]
    public Task OnRecordingTick(int seconds)
    {
        _recordSeconds = seconds;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnRecordingStopped(int seconds)
    {
        _isRecording = false;
        _recordSeconds = seconds;
        try
        {
            _pendingUrl = await JS.InvokeAsync<string>("serviceVoiceRecorder.getPendingUrl");
        }
        catch
        {
            _pendingUrl = string.Empty;
        }
        StateHasChanged();
    }

    private static string FormatDuration(int seconds) =>
        TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(@"mm\:ss");

    /// <summary>فقط MP3 روی دستگاه ESP32 قابل پخش است.</summary>
    private static bool IsDevicePlayable(string? url) =>
        !string.IsNullOrWhiteSpace(url) &&
        url.EndsWith(".mp3", StringComparison.OrdinalIgnoreCase);

    private static string FormatSize(long bytes)
    {
        if (bytes <= 0) return "0 KB";
        if (bytes < 1024 * 1024) return $"{Math.Max(1, bytes / 1024)} KB";
        return $"{bytes / (1024.0 * 1024.0):0.0} MB";
    }

    private static string CleanErrorBody(string? body)
    {
        if (string.IsNullOrWhiteSpace(body)) return "خطای ناشناخته";
        return body.Trim().Trim('"');
    }

    private static async Task<string> ReadErrorAsync(HttpResponseMessage resp, string fallback)
    {
        try
        {
            var body = await resp.Content.ReadAsStringAsync();
            return string.IsNullOrWhiteSpace(body) ? fallback : CleanErrorBody(body);
        }
        catch
        {
            return fallback;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("serviceVoiceRecorder.stop"); } catch { }
        try { await JS.InvokeVoidAsync("serviceVoiceRecorder.clearPending"); } catch { }
        _dotNetRef?.Dispose();
    }

    private sealed class VoiceStartResult
    {
        public bool Ok { get; set; }
        public string? Error { get; set; }
    }

    private sealed class VoiceUploadResult
    {
        public bool Ok { get; set; }
        public int Status { get; set; }
        public string? Body { get; set; }
    }
}
