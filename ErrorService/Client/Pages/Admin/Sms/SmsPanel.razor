    private async Task ToggleModule(WorkshopSmsModuleDto mod, bool isActive)
    {
        try
        {
            var url = $"api/workshop-sms/modules/{mod.Id}";
            if (_wsSelectedWorkshopId.HasValue)
                url += $"?workshopId={_wsSelectedWorkshopId.Value}";
            var response = await Http.PutAsJsonAsync(url,
                new WorkshopSmsModuleUpdateRequest { IsActive = isActive, ModuleType = mod.ModuleType });
            if (response.IsSuccessStatusCode)
            {
                mod.IsActive = isActive;
                if (mod.Id == 0)
                {
                    var result = await response.Content.ReadFromJsonAsync<ModuleCreateResult>();
                    if (result?.id > 0) mod.Id = result.id;
                }
                ToastService.ShowSuccess($"ماژول {(isActive ? "فعال" : "غیرفعال")} شد");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا: {ex.Message}");
        }
    }

