    }

    private static bool TryParseJalaliDate(string? s, out DateTimeOffset value)
    {
        value = default;
        if (string.IsNullOrWhiteSpace(s)) return false;
        var parts = s.Trim().Split('/');
        if (parts.Length != 3) return false;

        if (!int.TryParse(parts[0], out var jy)) return false;
        if (!int.TryParse(parts[1], out var jm)) return false;
        if (!int.TryParse(parts[2], out var jd)) return false;

        try
        {
            value = PersianDateHelper.FromPersianDate(jy, jm, jd);
            return true;
        }
        catch
        {
            return false;
        }
    }

    private void CancelEdit()
    {
        isEditMode = false;
        editPreviewUrl = null;
        editFileBuffer = null;
        editFileName = null;
        editFileContentType = null;
    }

    private async Task OnEditFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 10 * 1024 * 1024)
        {
            ToastService.ShowError("حجم فایل بیش از حد مجاز است");
            return;
        }

        editFileName = file.Name;
        editFileContentType = file.ContentType;

        try
        {
            editFileBuffer = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            editPreviewUrl = $"data:{editFileContentType};base64,{Convert.ToBase64String(editFileBuffer)}";
        }
        catch
        {
            ToastService.ShowError("خطا در خواندن فایل");
        }
    }

    private async Task SaveEdit()
    {
        if (selected == null) return;
        if (!CanWorkOnWorkshop) return;

        if (editDeviceTypeId <= 0)
        {
            ToastService.ShowError("نوع دستگاه انتخاب نشده است");
            return;
        }

        if (string.IsNullOrWhiteSpace(editProblem) || editProblem.Trim().Length < 5)
        {
            ToastService.ShowError("شرح مشکل کافی نیست");
            return;
        }

        DateTimeOffset regDate;
        try
        {
            if (string.IsNullOrWhiteSpace(editRegDateString)) throw new Exception();
            var parts = editRegDateString.Split('/');
            if (parts.Length != 3) throw new Exception();
            
            int jy = int.Parse(parts[0]);
            int jm = int.Parse(parts[1]);
            int jd = int.Parse(parts[2]);
            
            regDate = PersianDateHelper.FromPersianDate(jy, jm, jd);
        }
        catch
        {
            ToastService.ShowError("تاریخ ثبت نامعتبر است");
            return;
        }

        // Auto-capture current time
        var now = DateTimeOffset.Now;
        var reg = new DateTimeOffset(
            regDate.Year, regDate.Month, regDate.Day,
            now.Hour, now.Minute, now.Second, now.Offset);

        isSaving = true;
        try
        {
            var content = new MultipartFormDataContent();
            content.Add(new StringContent(selected.CustomerId.ToString()), "customerId");
            content.Add(new StringContent(editDeviceTypeId.ToString()), "deviceTypeId");
            if (editDeviceBrandId.HasValue)
                content.Add(new StringContent(editDeviceBrandId.Value.ToString()), "deviceBrandId");
            content.Add(new StringContent(editProblem.Trim()), "problemDescription");
            content.Add(new StringContent(editStatus), "status");
            if (editTechnicianId.HasValue)
                content.Add(new StringContent(editTechnicianId.Value.ToString()), "technicianId");
            content.Add(new StringContent(reg.ToString("O")), "registeredAt");

            if (editFileBuffer != null)
            {
                var byteArrayContent = new ByteArrayContent(editFileBuffer);
                byteArrayContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(editFileContentType ?? "image/jpeg");
                content.Add(byteArrayContent, "file", editFileName ?? "receipt.jpg");
            }
            else if (!string.IsNullOrWhiteSpace(editPreviewUrl) && !editPreviewUrl.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
            {
                content.Add(new StringContent(editPreviewUrl), "receiptImageUrl");
            }

            var qs = WorkshopQs(selected.WorkshopId);
            if (isSuperAdmin && string.IsNullOrEmpty(qs))
            {
                ToastService.ShowWarning("ابتدا کارگاه را از منوی بالای صفحه انتخاب کنید");
                return;
            }

            var resp = await Http.PutAsync($"api/customer-receipts/{selected.Id}{qs}", content);
            if (!resp.IsSuccessStatusCode)
            {
                var msg = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(msg) ? "خطا در ذخیره" : msg.Trim('"'));
                return;
            }

            var updated = await resp.Content.ReadFromJsonAsync<CustomerReceiptDto>();
            if (updated != null)
            {
                selected = updated;

                if (all != null)
                {
                    var idx = all.FindIndex(x => x.Id == updated.Id);
                    if (idx >= 0) all[idx] = updated;
                }

                ApplyFilter();
                ToastService.ShowSuccess("تغییرات ذخیره شد");
                CancelEdit();
            }
        }
        catch
        {
            ToastService.ShowError("خطا در ارتباط با سرور");
        }
        finally
        {
            isSaving = false;
        }
    }

