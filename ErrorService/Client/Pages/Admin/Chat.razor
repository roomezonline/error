        try
        {
            var url = $"api/chat/ai-models/catalog?kind={Uri.EscapeDataString(p.Kind)}&baseUrl={Uri.EscapeDataString(p.BaseUrl)}";
            var json = await Http.GetFromJsonAsync<JsonElement>(url);
            var list = new List<CatalogItemUi>();
            if (json.TryGetProperty("models", out var models) && models.ValueKind == JsonValueKind.Array)
                foreach (var m in models.EnumerateArray())
                {
                    var id = m.TryGetProperty("id", out var mid) ? mid.GetString() : null;
                    if (string.IsNullOrWhiteSpace(id)) continue;
                    if (p.Models.Any(x => string.Equals(x.ModelId, id, StringComparison.OrdinalIgnoreCase))) continue;
                    list.Add(new CatalogItemUi { Id = id!, Name = m.TryGetProperty("name", out var nm) ? nm.GetString() : null });
                }
            p.Catalog = list;
            p.CatalogMessage = json.TryGetProperty("message", out var msg) && msg.ValueKind == JsonValueKind.String
                ? msg.GetString()
                : $"{list.Count} مدل دریافت شد.";
        }
        catch
        {
            p.CatalogMessage = "خطا در دریافت فهرست.";
        }
        p.CatalogLoading = false;
        StateHasChanged();
    }

