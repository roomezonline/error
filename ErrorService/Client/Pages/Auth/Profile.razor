    private string replyMessage = "";
    private string? replyAttachmentUrl;
    private string? replyAttachmentName;
    private string? replyAttachmentType;
    private ConsultationTicket newTicket = new();
    private ConsultationTicket? selectedTicketForProfile;
    private bool isCreatingNewTicket = false;

    private async Task SelectTicketForProfile(ConsultationTicket ticket)
    {
        selectedTicketForProfile = ticket;
        if (!ticket.IsUserRead)
        {
            try
            {
                var resp = await Http.PostAsync($"api/technical/tickets/{ticket.Id}/read-user", null);
                if (resp.IsSuccessStatusCode)
                {
                    ticket.IsUserRead = true;
                }
            }
            catch { }
        }
    }

    private async Task HandleSubmitTicket()
    {
        isBusy = true;
        try
        {
            var response = await Http.PostAsJsonAsync("api/technical/tickets", newTicket);
            if (response.IsSuccessStatusCode)
            {
                newTicket = new();
                isCreatingNewTicket = false;
                await LoadSummary();
                Toast.ShowSuccess("تیکت شما با موفقیت ثبت شد.");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError(ex.Message);
        }
        isBusy = false;
    }

    private async Task HandleReplySubmit()
    {
        if (selectedTicketForProfile == null) return;
        if (string.IsNullOrWhiteSpace(replyMessage) && string.IsNullOrEmpty(replyAttachmentUrl)) return;

        isBusy = true;
        try
        {
            var reply = new TicketReply
            {
                Message = replyMessage?.Trim() ?? "",
                IsAdmin = false,
                AttachmentUrl = replyAttachmentUrl,
                AttachmentName = replyAttachmentName,
                AttachmentContentType = replyAttachmentType
            };
            var response = await Http.PostAsJsonAsync($"api/technical/tickets/{selectedTicketForProfile.Id}/reply", reply);
            if (response.IsSuccessStatusCode)
            {
                var newReply = await response.Content.ReadFromJsonAsync<TicketReply>();
                if (newReply != null)
                {
                    selectedTicketForProfile.Replies.Add(newReply);
                }
                selectedTicketForProfile.IsUserRead = true;
                replyMessage = "";
                replyAttachmentUrl = null;
                replyAttachmentName = null;
                replyAttachmentType = null;
                Toast.ShowInfo("پاسخ شما ثبت شد.");
            }
        }
        catch
        {
            Toast.ShowError("خطا در ارسال پاسخ");
        }
        isBusy = false;
    }

    private async Task OnReplyAttachmentSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isBusy = true;
        try
        {
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var resp = await Http.PostAsync("api/technical/tickets/upload-attachment", content);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null)
                {
                    replyAttachmentUrl = result.Url;
                    replyAttachmentName = result.Name;
                    replyAttachmentType = result.ContentType;
                    Toast.ShowInfo("فایل پیوست شد");
                }
            }
            else
            {
                Toast.ShowError("خطا در آپلود فایل");
            }
        }
        catch
        {
            Toast.ShowError("خطا در آپلود فایل");
        }
        isBusy = false;
    }

    private void RemoveReplyAttachment()
    {
        replyAttachmentUrl = null;
        replyAttachmentName = null;
        replyAttachmentType = null;
    }

    private async Task OnReplyKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
