@code {
    private enum ChatWidgetStatus { UserInfo, Loading, Active, Closed }
    private ChatWidgetStatus _status = ChatWidgetStatus.UserInfo;
    private HubConnection? _hub;
    private List<ChatMessageDto> _messages = new();
    private string _inputText = "";
    private bool _operatorTyping;
    private int _sessionId;
    private int _unreadCount;
    private string? _statusMessage;
    private bool _isOpen;
    private bool _voiceSupported;
    private RecOrder _recState = RecOrder.Idle;
    private int _recSeconds;
    private string _pendingVoiceUrl = "";
    private enum RecOrder { Idle, Recording, Preview }
    private string? _lightboxUrl;
    private ElementReference _messagesContainer;
    private SiteSettingsDto _settings = new();
    private bool _settingsLoaded;
    private bool _isLoggedIn;
    private string _userName = "";
    private string _userEmail = "";
    private string _userPhone = "";
    private bool _emojiOpen;
    private ElementReference _inputRef;
    private static readonly string[] Emojis =
    {
        "😀","😊","🙂","😉","😍","🤩","😎","🤔","😅","😂","🥰","😇","🙃","😴","🤗","👍","👎","👏","🙏","💪","❤️","🔥","🎉","✨","⭐","🌹","☕","🚀","💡","✅","❌","⚠️"
    };
    private DateTime _lastTypingSent = DateTime.MinValue;
    private bool _hasConnectedOnce;
    private bool _showRating;
    private int _ratingValue;
    private string _ratingComment = "";
    private int _lastSessionId;
    private int _onlineAdminsCount;

    protected override async Task OnInitializedAsync()
    {
            try { _settings = await Http.GetFromJsonAsync<SiteSettingsDto>("api/SiteSettings") ?? new(); }
        catch { }
        _settingsLoaded = true;

        try
        {
            var token = await JS.InvokeAsync<string>("localStorage.getItem", "auth_token");
            _isLoggedIn = !string.IsNullOrEmpty(token);
            var savedName = await JS.InvokeAsync<string>("localStorage.getItem", "chat_user_name");
            var savedEmail = await JS.InvokeAsync<string>("localStorage.getItem", "chat_user_email");
            var savedPhone = await JS.InvokeAsync<string>("localStorage.getItem", "chat_user_phone");
            if (!string.IsNullOrEmpty(savedName)) _userName = savedName;
            if (!string.IsNullOrEmpty(savedEmail)) _userEmail = savedEmail;
            if (!string.IsNullOrEmpty(savedPhone)) _userPhone = savedPhone;
        }
        catch { }
    }

    private DotNetObjectReference<ChatWidget>? _dotNetRef;

    private bool _operatorRequested;

    private async Task RequestOperator()
    {
        if (_sessionId == 0 || _hub == null) return;
        _operatorRequested = true;
        try { await _hub.InvokeAsync("RequestOperator", _sessionId); } catch { }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { _voiceSupported = await JS.InvokeAsync<bool>("__chatVoiceRecorder.isSupported"); } catch { }
            _dotNetRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("window.__chatSetDotNetRef", _dotNetRef); } catch { }
            StateHasChanged();
        }
    }

    private async Task CheckExistingSession()
    {
        try
        {
            var visitorId = await GetVisitorId();
            var active = await Http.GetFromJsonAsync<ChatSessionDto?>($"api/chat/active?visitorId={visitorId}");
            if (active != null)
            {
                _sessionId = active.Id;
                _userName = active.UserName ?? _userName;
                _status = ChatWidgetStatus.Active;
                if (_hub != null)
                    await _hub.InvokeAsync("JoinSession", _sessionId);
                await LoadMessages();
                StateHasChanged();
            }
        }
        catch { }
    }

    [JSInvokable]
    public Task OnRecordingTick(int seconds)
    {
        _recSeconds = seconds;
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public async Task OnVoiceStopped(int seconds)
    {
        _recSeconds = seconds;
        _recState = RecOrder.Preview;
        try { _pendingVoiceUrl = await JS.InvokeAsync<string>("__chatVoiceRecorder.getPendingUrl") ?? ""; }
        catch { }
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnVoiceRecorded(string url)
    {
        if (string.IsNullOrEmpty(url))
        {
            if (_pendingTempIds.TryDequeue(out var failedId))
                _messages.RemoveAll(m => m.Id == failedId);
            StateHasChanged();
            return;
        }
        if (_hub != null)
        {
            var tempId = _nextTempId--;
            _pendingTempIds.Enqueue(tempId);
            _messages.Add(new ChatMessageDto
            {
                Id = tempId,
                SessionId = _sessionId,
                SenderType = ChatSenderTypeDto.User,
                MessageType = ChatMessageTypeDto.Voice,
                MediaUrl = url,
                CreatedAt = DateTime.UtcNow,
                Status = ChatMessageStatusDto.Sending
            });
            ScrollToBottom();
            StateHasChanged();
            if (_hub?.State != HubConnectionState.Connected)
            {
                if (!await SendViaRestAsync(_sessionId, "", ChatMessageTypeDto.Voice, url))
                    await QueueOffline(_sessionId, "", ChatMessageTypeDto.Voice, url);
                return;
            }
            try { await _hub.InvokeAsync("SendMessage", _sessionId, "", ChatMessageTypeDto.Voice, url); }
            catch
            {
                if (!await SendViaRestAsync(_sessionId, "", ChatMessageTypeDto.Voice, url))
                    await QueueOffline(_sessionId, "", ChatMessageTypeDto.Voice, url);
            }
        }
    }

    private async Task ConnectHub()
    {
        if (_hub != null)
        {
            if (_hub.State == HubConnectionState.Connected) return;
            await _hub.DisposeAsync();
            _hub = null;
        }

        var visitorId = await GetVisitorId();
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri($"/hubs/chat?visitorId={visitorId}"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<ChatMessageDto>("NewMessage", msg =>
        {
            if (_messages.Any(m => m.Id == msg.Id)) return;
            if (_pendingTempIds.TryDequeue(out var tempId))
                _messages.RemoveAll(m => m.Id == tempId);
            _messages.Add(msg);
            _messages.Sort((a, b) => a.CreatedAt.CompareTo(b.CreatedAt));
            if (msg.SenderType == ChatSenderTypeDto.Operator)
            {
                _operatorTyping = false;
                if (msg.SenderId != "پاسخ خودکار") _operatorRequested = true;
                _ = _hub.InvokeAsync("MarkAsRead", msg.SessionId, new List<int> { msg.Id });
            }
            if (!_isOpen && msg.SenderType != ChatSenderTypeDto.User)
            {
                _unreadCount++;
                _ = JS.InvokeVoidAsync("__chatPlayNotification");
                _ = JS.InvokeVoidAsync("__chatNotify", "پیام جدید از پشتیبانی", msg.Content ?? "مکالمه جدید");
                _ = JS.InvokeVoidAsync("__chatFlashTitle", "💬 پیام جدید");
            }
            _ = ScrollToBottom();
            InvokeAsync(StateHasChanged);
        });

        _hub.On<bool>("OperatorTyping", isTyping =>
        {
            _operatorTyping = isTyping;
            InvokeAsync(StateHasChanged);
        });

        _hub.On<int>("SessionClosed", sessionId =>
        {
            _status = ChatWidgetStatus.Closed;
            _statusMessage = "مکالمه توسط اپراتور پایان یافت.";
            _lastSessionId = _sessionId;
            _sessionId = 0;
            _showRating = true;
            _ratingValue = 0;
            _ratingComment = "";
            InvokeAsync(StateHasChanged);
        });

        _hub.On<int, List<int>>("MessagesRead", (sessionId, messageIds) =>
        {
            if (_sessionId == sessionId)
            {
                foreach (var msg in _messages.Where(m => messageIds.Contains(m.Id)))
                {
                    msg.IsRead = true;
                    msg.Status = ChatMessageStatusDto.Read;
                }
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.On<int>("PresenceChanged", count =>
        {
            _onlineAdminsCount = count;
            InvokeAsync(StateHasChanged);
        });

        _hub.On<ChatMessageDto>("MessageEdited", msg =>
        {
            var existing = _messages.FirstOrDefault(m => m.Id == msg.Id);
            if (existing != null)
            {
                existing.Content = msg.Content;
                existing.EditedAt = msg.EditedAt;
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.On<int, int>("MessageDeleted", (sessionId, messageId) =>
        {
            var existing = _messages.FirstOrDefault(m => m.Id == messageId);
            if (existing != null)
            {
                existing.IsDeleted = true;
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.Reconnecting += _ => { _status = ChatWidgetStatus.Loading; InvokeAsync(StateHasChanged); return Task.CompletedTask; };
        _hub.Reconnected += async _ =>
        {
            _pendingTempIds.Clear();
            _messages.RemoveAll(m => m.Id < 0);
            if (_sessionId > 0)
            {
                _status = ChatWidgetStatus.Active;
                _statusMessage = null;
            }
            if (_hub != null)
            {
                try { _onlineAdminsCount = await _hub.InvokeAsync<int>("GetPresence"); } catch { }
            }
            if (_sessionId > 0)
            {
                try
                {
                    await _hub!.InvokeAsync("JoinSession", _sessionId);
                    await LoadMessages();
                    await FlushPending();
                }
                catch { }
            }
            InvokeAsync(StateHasChanged);
        };
        _hub.Closed += _ =>
        {
            _pendingTempIds.Clear();
            if (_sessionId > 0)
            {
                _status = ChatWidgetStatus.Active;
                _statusMessage = null;
            }
            InvokeAsync(StateHasChanged);
            return Task.CompletedTask;
        };

        await _hub.StartAsync();
        _hasConnectedOnce = true;
        try { _onlineAdminsCount = await _hub.InvokeAsync<int>("GetPresence"); } catch { }
    }

    private async Task ToggleOpen()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            _unreadCount = 0;
            _ = JS.InvokeVoidAsync("__chatRequestNotifyPermission");
            if (!_hasConnectedOnce)
            {
                try
                {
                    await ConnectHub();
                    await CheckExistingSession();
                    await FlushPending();
                }
                catch
                {
                    _status = ChatWidgetStatus.Active;
                    _statusMessage = "اتصال برقرار نشد. دوباره تلاش کنید.";
                }
            }
            else
            {
                if (_hub == null || _hub.State != HubConnectionState.Connected)
                {
                    try { await ConnectHub(); } catch { }
                }
                if (_sessionId > 0)
                {
                    try { await _hub!.InvokeAsync("JoinSession", _sessionId); } catch { }
                    await LoadMessages();
                    await FlushPending();
                    await ScrollToBottom();
                }
                else
                {
                    await CheckExistingSession();
                    await FlushPending();
                }
            }
            StateHasChanged();
        }
    }

    private async Task StartChat()
    {
        if (string.IsNullOrWhiteSpace(_userName)) return;
        if (_settings.ChatPhoneRequired && string.IsNullOrWhiteSpace(_userPhone)) return;

        await JS.InvokeVoidAsync("localStorage.setItem", "chat_user_name", _userName);
        await JS.InvokeVoidAsync("localStorage.setItem", "chat_user_phone", _userPhone);

        _status = ChatWidgetStatus.Loading;
        StateHasChanged();

        try
        {
            await ConnectHub();
            var result = await _hub!.InvokeAsync<StartChatResult>("StartChat", _userName, _userEmail, _userPhone);
            if (!result.Success || result.SessionId == 0)
            {
                _status = ChatWidgetStatus.Closed;
                _statusMessage = result.Message ?? "شروع مکالمه ممکن نشد. لطفاً دوباره تلاش کنید.";
                StateHasChanged();
                return;
            }
            _sessionId = result.SessionId;
            _status = ChatWidgetStatus.Active;
            _statusMessage = null;
            await LoadMessages();
        }
        catch
        {
            _status = ChatWidgetStatus.Closed;
            _statusMessage = "خطا در برقراری ارتباط.";
        }
        StateHasChanged();
    }

    private async Task LoadMessages()
    {
        if (_sessionId == 0) return;
        try
        {
            var visitorId = await GetVisitorId();
            var resp = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/chat/sessions/{_sessionId}/messages?visitorId={visitorId}&take=200");
            if (resp.ValueKind == System.Text.Json.JsonValueKind.Object && resp.TryGetProperty("items", out var items))
            {
                _messages = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessageDto>>(items.GetRawText(), new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
            await ScrollToBottom();
        }
        catch { }

        // Mark unread operator messages as read
        var unreadIds = _messages
            .Where(m => m.SenderType == ChatSenderTypeDto.Operator && !m.IsRead)
            .Select(m => m.Id)
            .ToList();
        if (unreadIds.Count > 0 && _hub?.State == HubConnectionState.Connected)
        {
            try { await _hub.InvokeAsync("MarkAsRead", _sessionId, unreadIds); } catch { }
        }
    }

    private int _nextTempId = -1;
    private Queue<int> _pendingTempIds = new();

    private async Task SendText()
    {
        var text = _inputText.Trim();
        if (string.IsNullOrWhiteSpace(text) || _sessionId == 0) return;
        _inputText = "";
        _operatorTyping = false;

        var tempId = _nextTempId--;
        _pendingTempIds.Enqueue(tempId);
        _messages.Add(new ChatMessageDto
        {
            Id = tempId,
            SessionId = _sessionId,
            SenderType = ChatSenderTypeDto.User,
            Content = text,
            MessageType = ChatMessageTypeDto.Text,
            CreatedAt = DateTime.UtcNow,
            Status = ChatMessageStatusDto.Sending
        });
        ScrollToBottom();
        StateHasChanged();

        if (_hub == null || _hub.State != HubConnectionState.Connected)
        {
            try { if (_hub != null) await _hub.StartAsync(); } catch { }
        }
        if (_hub?.State != HubConnectionState.Connected)
        {
            if (await SendViaRestAsync(_sessionId, text, ChatMessageTypeDto.Text, null)) return;
            await QueueOffline(_sessionId, text, ChatMessageTypeDto.Text, null);
            return;
        }

        try { await _hub.InvokeAsync("SendMessage", _sessionId, text, ChatMessageTypeDto.Text, null); }
        catch
        {
            if (!await SendViaRestAsync(_sessionId, text, ChatMessageTypeDto.Text, null))
                await QueueOffline(_sessionId, text, ChatMessageTypeDto.Text, null);
        }
    }

    private async Task<bool> SendViaRestAsync(int sessionId, string content, ChatMessageTypeDto type, string? mediaUrl)
    {
        try
        {
            var visitorId = await GetVisitorId();
            var resp = await Http.PostAsJsonAsync("api/chat/send", new
            {
                sessionId,
                content,
                messageType = type,
                mediaUrl,
                visitorId
            });
            if (!resp.IsSuccessStatusCode) return false;
            var dto = await resp.Content.ReadFromJsonAsync<ChatMessageDto>();
            if (dto == null) return false;
            if (_messages.Any(m => m.Id == dto.Id)) return true;
            if (_pendingTempIds.TryDequeue(out var tempId))
                _messages.RemoveAll(m => m.Id == tempId);
            _messages.Add(dto);
            _messages.Sort((a, b) => a.CreatedAt.CompareTo(b.CreatedAt));
            await ScrollToBottom();
            StateHasChanged();
            return true;
        }
        catch { return false; }
    }

    private async Task QueueOffline(int sessionId, string content, ChatMessageTypeDto type, string? mediaUrl)
    {
        try
        {
            var raw = await JS.InvokeAsync<string>("__chatLoadPending");
            var list = System.Text.Json.JsonSerializer.Deserialize<List<PendingChatItem>>(raw) ?? new();
            list.Add(new PendingChatItem
            {
                SessionId = sessionId,
                Content = content,
                MessageType = (int)type,
                MediaUrl = mediaUrl
            });
            await JS.InvokeVoidAsync("__chatSavePending", System.Text.Json.JsonSerializer.Serialize(list));
        }
        catch { }
    }

    private async Task FlushPending()
    {
        if (_hub?.State != HubConnectionState.Connected || _sessionId == 0) return;
        try
        {
            var raw = await JS.InvokeAsync<string>("__chatLoadPending");
            var list = System.Text.Json.JsonSerializer.Deserialize<List<PendingChatItem>>(raw) ?? new();
            if (list.Count == 0) return;
            var remaining = new List<PendingChatItem>();
            foreach (var item in list)
            {
                if (item.SessionId == _sessionId)
                {
                    try
                    {
                        await _hub.InvokeAsync("SendMessage", item.SessionId, item.Content,
                            (ChatMessageTypeDto)item.MessageType, item.MediaUrl);
                    }
                    catch { remaining.Add(item); }
                }
                else remaining.Add(item);
            }
            await JS.InvokeVoidAsync("__chatSavePending", System.Text.Json.JsonSerializer.Serialize(remaining));
        }
        catch { }
    }

    private sealed class PendingChatItem
    {
        public int SessionId { get; set; }
        public string? Content { get; set; }
        public int MessageType { get; set; }
        public string? MediaUrl { get; set; }
    }

