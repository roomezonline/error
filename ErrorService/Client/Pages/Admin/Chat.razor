        _siteSettingsSuccess = siteOk && baleOk;
        _siteSettingsMessage = (siteOk && baleOk)
            ? "همه تنظیمات ذخیره شد."
            : (!siteOk ? "ذخیره تنظیمات چت ناموفق بود." : "ذخیره تنظیمات بله ناموفق بود.");
        if (siteOk && baleOk) _siteSettingsMessage = "تنظیمات ذخیره شد.";
    }

