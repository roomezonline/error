@page "/admin/newsletter-subscribers"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.settings.manage")]
@using System.Net.Http.Json
@using ErrorService.Shared
@inject HttpClient Http
@inject ErrorService.Client.Services.ToastService Toast

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-black text-primary m-0">مشترکین خبرنامه</h2>
        <span class="badge bg-primary rounded-pill px-3 py-2">@subscribers.Count مشترک</span>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        @if (loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        }
        else if (subscribers.Count == 0)
        {
            <div class="text-center py-5 text-muted">
                <div class="display-3 mb-3 opacity-25"><span class="oi oi-inbox"></span></div>
                <h5>هیچ مشترکی یافت نشد</h5>
                <p class="small">هنوز کسی در خبرنامه ثبت‌نام نکرده است.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 fw-bold">#</th>
                            <th class="fw-bold">ایمیل</th>
                            <th class="fw-bold">تاریخ ثبت‌نام</th>
                            <th class="fw-bold text-center">وضعیت</th>
                            <th class="fw-bold text-center">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in subscribers)
                        {
                            <tr>
                                <td class="ps-4">@sub.Id</td>
                                <td dir="ltr" class="text-start">@sub.Email</td>
                                <td>@sub.CreatedAtFa</td>
                                <td class="text-center">
                                    @if (sub.IsActive)
                                    {
                                        <span class="badge bg-success rounded-pill">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill">غیرفعال</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => Delete(sub.Id)">
                                        <span class="oi oi-trash"></span> حذف
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<NewsletterSubscriptionDto> subscribers = new();
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            subscribers = await Http.GetFromJsonAsync<List<NewsletterSubscriptionDto>>("api/newsletter") ?? new();
        }
        catch { }
        finally { loading = false; }
    }

    private async Task Delete(int id)
    {
        try
        {
            await Http.DeleteAsync($"api/newsletter/{id}");
            subscribers.RemoveAll(x => x.Id == id);
            Toast.ShowSuccess("مشترک با موفقیت حذف شد.");
        }
        catch
        {
            Toast.ShowError("خطا در حذف مشترک.");
        }
    }
}
