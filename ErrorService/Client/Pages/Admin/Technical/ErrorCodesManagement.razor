@page "/admin/technical/error-codes"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.technical.errorcodes.manage")]
@using ErrorService.Shared.Models
@implements IDisposable
@inject HttpClient Http
@inject ErrorService.Client.Services.ToastService Toast

<PageTitle>مدیریت کدهای خطا | ارورسرویس</PageTitle>

<div class="ec-page">
    <!-- Header -->
    <div class="ec-header">
        <div class="ec-header__top">
            <a class="ec-back" href="/admin"><span class="oi oi-arrow-right"></span></a>
            <div class="ec-header__title">
                <div class="ec-header__kicker">مدیریت فنی</div>
                <div class="ec-header__main">کدهای خطا</div>
            </div>
        </div>

        <div class="ec-search-row">
            <div class="ec-search-box">
                <span class="oi oi-magnifying-glass ec-search-icon"></span>
                <input class="ec-search-input" placeholder="جستجو برند، دستگاه یا کد خطا..."
                       value="@searchQuery"
                       @oninput="OnSearchInput" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button class="ec-search-clear" @onclick="ClearSearch">
                        <span class="oi oi-x"></span>
                    </button>
                }
            </div>
        </div>

        <div class="ec-filters">
            <div class="ec-filter-group">
                <select class="ec-filter-select" @bind="filterBrand" @bind:after="FilterList">
                    <option value="">همه برندها</option>
                    @foreach (var b in brandCatalog)
                    {
                        <option value="@b.Name">@b.Name@(b.UsageCount == 0 ? " (خالی)" : "")</option>
                    }
                </select>
                <div class="ec-filter-actions">
                    <button class="ec-filter-icon" title="افزودن برند" @onclick="() => OpenCatalogModal(ErrorCodeCatalogKind.Brand)">
                        <span class="oi oi-plus"></span>
                    </button>
                    <button class="ec-filter-icon" title="ویرایش برند انتخاب‌شده"
                            disabled="@(string.IsNullOrEmpty(filterBrand) || !HasCatalogItem(ErrorCodeCatalogKind.Brand, filterBrand))"
                            @onclick="() => EditSelectedCatalog(ErrorCodeCatalogKind.Brand, filterBrand)">
                        <span class="oi oi-pencil"></span>
                    </button>
                    <button class="ec-filter-icon ec-filter-icon--danger" title="حذف برند (فقط اگر استفاده نشده باشد)"
                            disabled="@(string.IsNullOrEmpty(filterBrand) || !HasCatalogItem(ErrorCodeCatalogKind.Brand, filterBrand))"
                            @onclick="() => AskDeleteCatalog(ErrorCodeCatalogKind.Brand, filterBrand)">
                        <span class="oi oi-trash"></span>
                    </button>
                </div>
            </div>

            <div class="ec-filter-group">
                <select class="ec-filter-select" @bind="filterDevice" @bind:after="FilterList">
                    <option value="">همه دستگاه‌ها</option>
                    @foreach (var d in deviceCatalog)
                    {
                        <option value="@d.Name">@d.Name@(d.UsageCount == 0 ? " (خالی)" : "")</option>
                    }
                </select>
                <div class="ec-filter-actions">
                    <button class="ec-filter-icon" title="افزودن نوع دستگاه" @onclick="() => OpenCatalogModal(ErrorCodeCatalogKind.DeviceType)">
                        <span class="oi oi-plus"></span>
                    </button>
                    <button class="ec-filter-icon" title="ویرایش نوع دستگاه انتخاب‌شده"
                            disabled="@(string.IsNullOrEmpty(filterDevice) || !HasCatalogItem(ErrorCodeCatalogKind.DeviceType, filterDevice))"
                            @onclick="() => EditSelectedCatalog(ErrorCodeCatalogKind.DeviceType, filterDevice)">
                        <span class="oi oi-pencil"></span>
                    </button>
                    <button class="ec-filter-icon ec-filter-icon--danger" title="حذف نوع دستگاه (فقط اگر استفاده نشده باشد)"
                            disabled="@(string.IsNullOrEmpty(filterDevice) || !HasCatalogItem(ErrorCodeCatalogKind.DeviceType, filterDevice))"
                            @onclick="() => AskDeleteCatalog(ErrorCodeCatalogKind.DeviceType, filterDevice)">
                        <span class="oi oi-trash"></span>
                    </button>
                </div>
            </div>

            <div class="ec-filter-group">
                <select class="ec-filter-select" @bind="filterCategory" @bind:after="FilterList">
                    <option value="">همه دسته‌ها</option>
                    @foreach (var c in categoryCatalog)
                    {
                        <option value="@c.Name">@c.Name@(c.UsageCount == 0 ? " (خالی)" : "")</option>
                    }
                </select>
                <div class="ec-filter-actions">
                    <button class="ec-filter-icon" title="افزودن دسته‌بندی" @onclick="() => OpenCatalogModal(ErrorCodeCatalogKind.Category)">
                        <span class="oi oi-plus"></span>
                    </button>
                    <button class="ec-filter-icon" title="ویرایش دسته‌بندی انتخاب‌شده"
                            disabled="@(string.IsNullOrEmpty(filterCategory) || !HasCatalogItem(ErrorCodeCatalogKind.Category, filterCategory))"
                            @onclick="() => EditSelectedCatalog(ErrorCodeCatalogKind.Category, filterCategory)">
                        <span class="oi oi-pencil"></span>
                    </button>
                    <button class="ec-filter-icon ec-filter-icon--danger" title="حذف دسته‌بندی (فقط اگر استفاده نشده باشد)"
                            disabled="@(string.IsNullOrEmpty(filterCategory) || !HasCatalogItem(ErrorCodeCatalogKind.Category, filterCategory))"
                            @onclick="() => AskDeleteCatalog(ErrorCodeCatalogKind.Category, filterCategory)">
                        <span class="oi oi-trash"></span>
                    </button>
                </div>
            </div>

            @if (HasActiveFilters)
            {
                <button class="ec-filter-reset" @onclick="ResetFilters">پاک‌کردن فیلترها</button>
            }
        </div>

        <div class="ec-header__actions">
            <button class="ec-add-btn" @onclick="() => OpenModal()">
                <span class="oi oi-plus"></span>
                <span>افزودن</span>
            </button>
        </div>
    </div>

    <!-- Stats -->
    <div class="ec-stats">
        <div class="ec-stat">
            <div class="ec-stat__value">@resultCount</div>
            <div class="ec-stat__label">نتیجه</div>
        </div>
        <div class="ec-stat">
            <div class="ec-stat__value">@groupedFiltered.Count</div>
            <div class="ec-stat__label">دسته‌بندی</div>
        </div>
        <div class="ec-stat">
            <div class="ec-stat__value">@brandCount</div>
            <div class="ec-stat__label">برند</div>
        </div>
    </div>

    <!-- List -->
    <div class="ec-list">
        @if (isLoading)
        {
            @for (int i = 0; i < 5; i++)
            {
                <div class="ec-skeleton">
                    <div class="ec-skeleton__line ec-skeleton__line--short"></div>
                    <div class="ec-skeleton__line ec-skeleton__line--long"></div>
                    <div class="ec-skeleton__line ec-skeleton__line--medium"></div>
                </div>
            }
        }
        else if (!groupedFiltered.Any())
        {
            <div class="ec-empty">
                <span class="oi oi-magnifying-glass ec-empty__icon"></span>
                <div class="ec-empty__title">موردی یافت نشد</div>
                <div class="ec-empty__desc">هیچ کد خطایی با عبارت جستجوی شما مطابقت ندارد</div>
            </div>
        }
        else
        {
            <div class="ec-list-toolbar">
                <button class="ec-collapse-all" @onclick="ToggleCollapseAll">
                    <span class="oi oi-@(allCollapsed ? "chevron-down" : "chevron-up")"></span>
                    @(allCollapsed ? "باز کردن همه" : "جمع کردن همه")
                </button>
                <span class="ec-list-toolbar__hint">
                    @(allCollapsed ? "فقط دسته‌بندی‌ها نمایش داده می‌شود" : "برای بستن هر دسته روی آن کلیک کنید")
                </span>
            </div>

            @foreach (var group in groupedFiltered.Take(visibleGroupLimit))
            {
                var isCollapsed = IsCategoryCollapsed(group.Key);
                <div class="ec-brand-group">
                    <div class="ec-brand-header ec-brand-header--clickable @(isCollapsed ? "ec-brand-header--collapsed" : "")"
                         @onclick="() => ToggleCategory(group.Key)">
                        <span class="ec-brand-dot"></span>
                        <span class="ec-brand-name">@group.Key</span>
                        <span class="ec-brand-count">@group.Count() مورد</span>
                        <span class="oi oi-@(isCollapsed ? "chevron-right" : "chevron-bottom") ec-brand-chevron"></span>
                    </div>

                    @if (!isCollapsed)
                    {
                        @foreach (var brandGroup in group
                            .GroupBy(x => (x.Brand ?? "").Trim(), StringComparer.OrdinalIgnoreCase)
                            .OrderBy(g => g.Key, StringComparer.OrdinalIgnoreCase))
                        {
                            <div class="ec-subgroup">
                                <div class="ec-subgroup__header">
                                    <span class="oi oi-grid-three-up ec-subgroup__icon"></span>
                                    <span class="ec-subgroup__brand">@brandGroup.Key</span>
                                    <span class="ec-subgroup__count">@brandGroup.Count()</span>
                                </div>

                                    @foreach (var item in brandGroup.OrderBy(x => x.DeviceType, StringComparer.OrdinalIgnoreCase).ThenBy(x => x.Code, StringComparer.OrdinalIgnoreCase))
                                    {
                                        <div class="ec-card" @onclick="() => OpenModal(item)">
                                            <div class="ec-card__top">
                                                <span class="ec-card__device">@item.DeviceType</span>
                                                <div class="ec-card__top-actions">
                                                    <span class="ec-card__code">@item.Code</span>
                                                    <div class="ec-card__actions" @onclick:stopPropagation="true">
                                                        <button class="ec-card__btn ec-card__btn--edit" @onclick="() => OpenModal(item)">
                                                            <span class="oi oi-pencil"></span>
                                                        </button>
                                                        <button class="ec-card__btn ec-card__btn--delete" @onclick="() => AskDelete(item)">
                                                            <span class="oi oi-trash"></span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="ec-card__desc">@item.Description</div>
                                            @if (!string.IsNullOrEmpty(item.Solution))
                                            {
                                                <div class="ec-card__solution">
                                                    <span class="oi oi-check ec-card__solution-icon"></span>
                                                    <span>@TruncateText(item.Solution, 80)</span>
                                                </div>
                                            }
                                            @if (item.ImageUrl != null)
                                            {
                                                <div class="ec-card__image-badge">
                                                    <span class="oi oi-image"></span> تصویر دارد
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        }
                </div>
            }

            @if (groupedFiltered.Count > visibleGroupLimit)
            {
                <button class="ec-load-more" @onclick="() => visibleGroupLimit += 20">
                    نمایش دسته‌های بیشتر (@(groupedFiltered.Count - visibleGroupLimit) دسته دیگر)
                </button>
            }
        }
    </div>
</div>

<!-- Modal -->
@if (showModal)
{
    <div class="ec-modal-overlay" @onclick="CloseModal">
        <div class="ec-modal" @onclick:stopPropagation="true">
            <div class="ec-modal__header">
                <div class="ec-modal__title">
                    <span class="oi oi-@(editingItem.Id == 0 ? "plus" : "pencil")"></span>
                    @(editingItem.Id == 0 ? "افزودن کد جدید" : "ویرایش کد خطا")
                </div>
                <button class="ec-modal__close" @onclick="CloseModal">
                    <span class="oi oi-x"></span>
                </button>
            </div>

            <EditForm class="ec-modal__form" Model="editingItem" OnValidSubmit="HandleSubmit">
                <div class="ec-modal__body">
                    <DataAnnotationsValidator />

                    @if (duplicateMatch != null)
                    {
                        <div class="ec-dupe-warning">
                            <span class="oi oi-alert"></span>
                            <div class="ec-dupe-warning__text">
                                این ترکیب قبلاً ثبت شده است.
                                <div class="ec-dupe-warning__meta">
                                    @duplicateMatch.Brand — @duplicateMatch.DeviceType — @duplicateMatch.Code
                                </div>
                            </div>
                            <button type="button" class="ec-dupe-warning__btn" @onclick="() => EditDuplicate(duplicateMatch)">
                                ویرایش کد موجود
                            </button>
                        </div>
                    }

                    <div class="ec-field">
                        <label class="ec-field__label">برند <span class="ec-field__req">*</span></label>
                        <StringTypeahead Items="brandSuggestions"
                                         @bind-Value="editingItem.Brand"
                                         Placeholder="مثلاً: Samsung" />
                        <ValidationMessage For="@(() => editingItem.Brand)" class="ec-field__error" />
                    </div>

                    <div class="ec-field">
                        <label class="ec-field__label">نوع دستگاه <span class="ec-field__req">*</span></label>
                        <StringTypeahead Items="deviceSuggestions"
                                         @bind-Value="editingItem.DeviceType"
                                         Placeholder="مثلاً: ماشین لباسشویی" />
                        <ValidationMessage For="@(() => editingItem.DeviceType)" class="ec-field__error" />
                    </div>

                    @if (RelatedSubsetCodes.Any())
                    {
                        <div class="ec-field">
                            <label class="ec-field__label">
                                خطاهای این زیرمجموعه
                                <span class="ec-related__hint">(برای مشاهده/ویرایش کلیک کنید)</span>
                            </label>
                            <div class="ec-related">
                                @foreach (var related in RelatedSubsetCodes)
                                {
                                    <button type="button"
                                            class="ec-related__chip @(related.Id == editingItem.Id ? "ec-related__chip--active" : "")"
                                            title="@related.Description"
                                            @onclick="() => LoadRelatedIntoModal(related)">
                                        @related.Code
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    <div class="ec-field">
                        <label class="ec-field__label">کد خطا <span class="ec-field__req">*</span></label>
                        <InputText class="ec-field__input ec-field__input--code" @bind-Value="editingItem.Code" placeholder="مثلاً: E01" />
                        <ValidationMessage For="@(() => editingItem.Code)" class="ec-field__error" />
                    </div>

                    <div class="ec-field">
                        <label class="ec-field__label">دسته‌بندی</label>
                        <div class="ec-cat-row">
                            <select class="ec-field__input" @bind="editingItem.Category">
                                <option value="">بدون دسته</option>
                                @foreach (var c in categoryCatalog)
                                {
                                    <option value="@c.Name">@c.Name</option>
                                }
                            </select>
                            <button type="button" class="ec-filter-icon" title="افزودن دسته‌بندی جدید"
                                    @onclick="() => OpenCatalogModal(ErrorCodeCatalogKind.Category)">
                                <span class="oi oi-plus"></span>
                            </button>
                            <button type="button" class="ec-filter-icon" title="ویرایش دسته انتخابی"
                                    disabled="@string.IsNullOrWhiteSpace(editingItem.Category)"
                                    @onclick="() => EditSelectedCatalog(ErrorCodeCatalogKind.Category, editingItem.Category)">
                                <span class="oi oi-pencil"></span>
                            </button>
                        </div>
                    </div>

                    <div class="ec-field">
                        <label class="ec-field__label">شرح خطا <span class="ec-field__req">*</span></label>
                        <InputTextArea class="ec-field__textarea" @bind-Value="editingItem.Description" rows="2" />
                        <ValidationMessage For="@(() => editingItem.Description)" class="ec-field__error" />
                    </div>

                    <div class="ec-field">
                        <label class="ec-field__label">راه حل پیشنهادی</label>
                        <InputTextArea class="ec-field__textarea" @bind-Value="editingItem.Solution" rows="3" />
                    </div>

                    <div class="ec-field">
                        <label class="ec-field__label">تصویر</label>
                        <ImageUploader @bind-ImageUrl="editingItem.ImageUrl"
                                       UploadUrl="api/technical/error-codes/upload" />
                    </div>

                    <div class="ec-field">
                        <label class="ec-field__label">نکات فنی</label>
                        <InputTextArea class="ec-field__textarea" @bind-Value="editingItem.TechnicalNotes" rows="2" />
                    </div>
                </div>

                <div class="ec-modal__footer">
                    <button type="button" class="ec-modal__btn ec-modal__btn--cancel" @onclick="CloseModal">انصراف</button>
                    <button type="submit" class="ec-modal__btn ec-modal__btn--submit" disabled="@(isSubmitting || duplicateMatch != null)">
                        @if (isSubmitting) { <span class="spinner-border spinner-border-sm"></span> }
                        ذخیره
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="حذف کد خطا"
               Message="آیا از حذف این کد خطا مطمئن هستید؟ این عملیات قابل بازگشت نیست."
               ConfirmText="حذف"
               IsDanger="true"
               OnResult="HandleDeleteResult" />

<ConfirmDialog IsVisible="showCatalogDeleteConfirm"
               Title="حذف از لیست"
               Message="@catalogDeleteMessage"
               ConfirmText="حذف"
               IsDanger="true"
               OnResult="HandleCatalogDeleteResult" />

@if (showCatalogModal)
{
    <div class="ec-modal-overlay" @onclick="CloseCatalogModal">
        <div class="ec-modal ec-modal--sm" @onclick:stopPropagation="true">
            <div class="ec-modal__header">
                <div class="ec-modal__title">
                    <span class="oi oi-@(catalogModalId == 0 ? "plus" : "pencil")"></span>
                    @(catalogModalId == 0 ? CatalogKindTitle(catalogModalKind, true) : CatalogKindTitle(catalogModalKind, false))
                </div>
                <button class="ec-modal__close" @onclick="CloseCatalogModal">
                    <span class="oi oi-x"></span>
                </button>
            </div>
            <div class="ec-modal__body">
                <div class="ec-field">
                    <label class="ec-field__label">نام <span class="ec-field__req">*</span></label>
                    <input class="ec-field__input"
                           value="@catalogModalName"
                           @oninput="OnCatalogNameInput"
                           placeholder="@CatalogKindTitle(catalogModalKind, true)"
                           @onkeydown="OnCatalogNameKeyDown" />
                    @if (catalogModalId != 0 && catalogModalUsage > 0)
                    {
                        <div class="ec-dupe-warning" style="margin-top:8px">
                            <span class="oi oi-info"></span>
                            <div class="ec-dupe-warning__text">
                                تغییر نام روی @catalogModalUsage کد خطا اعمال می‌شود.
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="ec-modal__footer">
                <button type="button" class="ec-modal__btn ec-modal__btn--cancel" @onclick="CloseCatalogModal">انصراف</button>
                <button type="button" class="ec-modal__btn ec-modal__btn--submit"
                        disabled="@(isCatalogSaving || string.IsNullOrWhiteSpace(catalogModalName))"
                        @onclick="SaveCatalogItem">
                    @if (isCatalogSaving) { <span class="spinner-border spinner-border-sm"></span> }
                    ذخیره
                </button>
            </div>
        </div>
    </div>
}

<style>
    .ec-page {
        padding: 0 0 24px;
        min-height: 100vh;
        background: #f8fafc;
    }

    /* ── Header ── */
    .ec-header {
        background: #fff;
        padding: 20px 16px 16px;
        border-radius: 0 0 24px 24px;
        box-shadow: 0 1px 6px rgba(0,0,0,0.06);
        border-bottom: 1px solid #f1f5f9;
    }
    .ec-header__top {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }
    .ec-back {
        width: 36px; height: 36px;
        display: flex; align-items: center; justify-content: center;
        background: #f1f5f9;
        border-radius: 10px;
        color: #475569;
        text-decoration: none;
        font-size: 0.9rem;
        transition: background 0.2s;
    }
    .ec-back:hover { background: #e2e8f0; color: #1e293b; }
    .ec-header__kicker { font-size: 0.7rem; color: #94a3b8; letter-spacing: 0.5px; }
    .ec-header__main { font-size: 1.15rem; font-weight: 800; color: #1e293b; }

    .ec-search-row { margin-bottom: 10px; }
    .ec-search-box {
        position: relative;
        display: flex;
        align-items: center;
    }
    .ec-search-icon {
        position: absolute;
        right: 12px;
        color: #94a3b8;
        font-size: 0.85rem;
        pointer-events: none;
    }
    .ec-search-input {
        width: 100%;
        padding: 11px 40px 11px 12px;
        border: 1.5px solid #e2e8f0;
        border-radius: 12px;
        background: #f8fafc;
        color: #1e293b;
        font-size: 0.85rem;
        outline: none;
        transition: border-color 0.2s, background 0.2s;
        font-family: inherit;
    }
    .ec-search-input::placeholder { color: #94a3b8; }
    .ec-search-input:focus {
        border-color: #6366f1;
        background: #fff;
        box-shadow: 0 0 0 3px rgba(99,102,241,0.1);
    }
    .ec-search-clear {
        position: absolute;
        left: 8px;
        background: #f1f5f9;
        border: none;
        border-radius: 8px;
        color: #94a3b8;
        width: 26px; height: 26px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer;
        font-size: 0.65rem;
        transition: background 0.2s;
    }
    .ec-search-clear:hover { background: #e2e8f0; color: #475569; }

    .ec-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 12px;
    }
    .ec-filter-select {
        flex: 1;
        min-width: 130px;
        padding: 9px 10px;
        border: 1.5px solid #e2e8f0;
        border-radius: 10px;
        background: #f8fafc;
        color: #334155;
        font-size: 0.78rem;
        font-weight: 600;
        outline: none;
        cursor: pointer;
        font-family: inherit;
    }
    .ec-filter-select:focus {
        border-color: #6366f1;
