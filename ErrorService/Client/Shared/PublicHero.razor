@implements IAsyncDisposable
@using System.Net.Http.Json
@using ErrorService.Shared
@using Microsoft.JSInterop

@if (_loading)
{
    <section class="hero" dir="rtl" aria-busy="true" aria-label="در حال بارگذاری اسلایدر">
        <div class="hero__slider hero__slider--skeleton"></div>
    </section>
}
else if (Slides.Count > 0)
{
    <section class="hero" dir="rtl" aria-label="اسلایدر ارورسرویس">
        <h1 class="visually-hidden">@ActiveTitle</h1>

        <div class="hero__slider" role="region" aria-roledescription="اسلایدر" aria-label="اسلایدهای پیشنهادی" @ref="_sliderElement">
            @for (var i = 0; i < Slides.Count; i++)
            {
                var slide = Slides[i];
                var isActive = i == activeIndex;

                <div class="hero__slide @(isActive ? "is-active" : "") @(string.IsNullOrWhiteSpace(slide.MobileImageUrl) ? "hero__slide--no-mobile" : "")"
                     aria-hidden="@(isActive ? "false" : "true")">
                    <div class="hero__media">
                        @if (string.IsNullOrWhiteSpace(slide.MobileImageUrl))
                        {
                            <img class="hero__mediaBlur" src="@slide.ImageUrl" alt="" aria-hidden="true" loading="lazy" decoding="async" />
                        }
                        <picture>
                            @if (!string.IsNullOrWhiteSpace(slide.MobileImageUrl))
                            {
                                <source media="(max-width: 899.98px)" srcset="@slide.MobileImageUrl" />
                            }
                            <img class="hero__imgFg" src="@slide.ImageUrl" alt="@slide.AltText"
                                 loading="@(isActive ? "eager" : "lazy")"
                                 fetchpriority="@(isActive ? "high" : "auto")"
                                 decoding="async" />
                        </picture>
                    </div>

                    <div class="hero__veil" aria-hidden="true"></div>

                    @if (!string.IsNullOrWhiteSpace(slide.LinkUrl))
                    {
                        <a class="hero__cta" href="@slide.LinkUrl" tabindex="@(isActive ? 0 : -1)" aria-hidden="@(isActive ? "false" : "true")">
                            <span>مشاهده</span>
                            <span class="oi oi-arrow-left" aria-hidden="true"></span>
                        </a>
                    }
                </div>
            }

            @if (Slides.Count > 1)
            {
                <button type="button" class="hero__arrow hero__arrow--prev" @onclick="Prev" aria-label="اسلاید قبلی">
                    <span class="oi oi-chevron-right" aria-hidden="true"></span>
                </button>
                <button type="button" class="hero__arrow hero__arrow--next" @onclick="Next" aria-label="اسلاید بعدی">
                    <span class="oi oi-chevron-left" aria-hidden="true"></span>
                </button>

                <div class="hero__dots" role="group" aria-label="انتخاب اسلاید">
                    @for (var i = 0; i < Slides.Count; i++)
                    {
                        var slideIndex = i;
                        <button type="button"
                                class="hero__dot @(i == activeIndex ? "hero__dot--active" : "")"
                                @onclick="() => GoTo(slideIndex)"
                                aria-label="اسلاید @(i + 1)"
                                aria-current="@(i == activeIndex ? "true" : null)"></button>
                    }
                </div>
            }
        </div>
    </section>
}

@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private const int SlideIntervalSeconds = 6;

    private bool _loading = true;
    private int activeIndex;
    private ElementReference _sliderElement;
    private readonly List<HeroSlide> Slides = new();
    private readonly DotNetObjectReference<PublicHero> _self;

    private IJSObjectReference? _interactionRef;
    private IJSObjectReference? _visibilityRef;
    private PeriodicTimer? timer;
    private CancellationTokenSource? cts;
    private bool _pageVisible = true;
    private bool _initialized;
    private DateTime _lastNavUtc = DateTime.MinValue;

    public PublicHero()
    {
        _self = DotNetObjectReference.Create(this);
    }

    private string ActiveTitle => Slides.Count == 0 ? "ارورسرویس" : Slides[activeIndex].Title;

    protected override async Task OnInitializedAsync()
    {
        await LoadSlidesAsync();
    }

    private async Task LoadSlidesAsync()
    {
        Slides.Clear();

        try
        {
            var dbSlides = await Http.GetFromJsonAsync<List<SliderItemDto>>("api/sliders/active");
            if (dbSlides is not null)
            {
                foreach (var s in dbSlides)
                {
                    if (string.IsNullOrWhiteSpace(s.ImageUrl)) continue;

                    Slides.Add(new HeroSlide(
                        s.ImageUrl,
                        s.MobileImageUrl,
                        string.IsNullOrWhiteSpace(s.Title) ? "ارورسرویس" : s.Title,
                        s.Subtitle ?? string.Empty,
                        s.LinkUrl));
                }
            }
        }
        catch
        {
            // A failed slider request should never take down the home page.
        }

        _loading = false;
        activeIndex = 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_initialized || _loading || Slides.Count == 0) return;
        _initialized = true;

        try { _interactionRef = await JS.InvokeAsync<IJSObjectReference>("publicHero.init", _sliderElement, _self); }
        catch { }

        try { _visibilityRef = await JS.InvokeAsync<IJSObjectReference>("publicHero.initVisibility", _self); }
        catch { }

        StartAutoAdvance();
    }

    private void StartAutoAdvance()
    {
        if (Slides.Count < 2) return;

        cts = new CancellationTokenSource();
        timer = new PeriodicTimer(TimeSpan.FromSeconds(SlideIntervalSeconds));
        _ = RunAutoAdvanceAsync(cts.Token);
    }

    private async Task RunAutoAdvanceAsync(CancellationToken cancellationToken)
    {
        if (timer is null) return;

        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                if (Slides.Count < 2 || !_pageVisible) continue;
                if (DateTime.UtcNow - _lastNavUtc < TimeSpan.FromSeconds(SlideIntervalSeconds)) continue;

                await InvokeAsync(() =>
                {
                    activeIndex = (activeIndex + 1) % Slides.Count;
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException) { }
    }

    [JSInvokable]
    public void Next() => Step(1);

    [JSInvokable]
    public void Prev() => Step(-1);

    private void Step(int delta)
    {
        if (Slides.Count < 2) return;

        _lastNavUtc = DateTime.UtcNow;
        _ = InvokeAsync(() =>
        {
            activeIndex = (activeIndex + delta + Slides.Count) % Slides.Count;
            StateHasChanged();
        });
    }

    private void GoTo(int index)
    {
        if (Slides.Count == 0 || index < 0 || index >= Slides.Count) return;

        _lastNavUtc = DateTime.UtcNow;
        if (index == activeIndex) return;

        activeIndex = index;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnVisibilityChanged(bool visible) => _pageVisible = visible;

    public async ValueTask DisposeAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        timer?.Dispose();

        await DisposeRefAsync(_interactionRef);
        await DisposeRefAsync(_visibilityRef);
        _self.Dispose();
    }

    private static async ValueTask DisposeRefAsync(IJSObjectReference? reference)
    {
        if (reference is null) return;

        try
        {
            await reference.InvokeVoidAsync("dispose");
            await reference.DisposeAsync();
        }
        catch
        {
            // The JS runtime can already be gone during navigation away.
        }
    }

    private sealed record HeroSlide(string ImageUrl, string? MobileImageUrl, string Title, string Subtitle, string? LinkUrl)
    {
        public string AltText => string.IsNullOrWhiteSpace(Subtitle) ? Title : $"{Title} — {Subtitle}";
    }
}
