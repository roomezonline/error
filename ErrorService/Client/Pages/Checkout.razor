    .pm-option__check { display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%; border: 1.5px solid #e2e8f0; color: transparent; font-size: 0.6rem; margin-inline-start: auto; flex-shrink: 0; }
    .pm-option__check--on { background: var(--shop-primary, #4f46e5); border-color: var(--shop-primary, #4f46e5); color: #fff; }

    .ship-grid { display: flex; flex-direction: column; gap: 8px; margin-top: 6px; }
    .ship-option {
        display: flex; align-items: center; gap: 10px; text-align: right;
        background: #fff; border: 1.5px solid #e2e8f0; border-radius: 14px;
        padding: 12px 14px; cursor: pointer; font-family: inherit; transition: all .15s;
    }
    .ship-option:hover { border-color: #c7d2fe; }
    .ship-option--active { border-color: var(--shop-primary, #4f46e5); background: rgba(79,70,229,.05); }
    .ship-option__body { flex: 1; display: flex; flex-direction: column; }
    .ship-option__name { font-size: 0.85rem; font-weight: 700; color: var(--shop-text, #1e293b); }
    .ship-option__days { font-size: 0.72rem; color: #94a3b8; margin-top: 2px; }
    .ship-option__price { font-size: 0.82rem; font-weight: 700; color: var(--shop-primary, #4f46e5); white-space: nowrap; }
    .ship-option__check {
        display: grid; place-items: center; width: 22px; height: 22px; border-radius: 50%;
        border: 1.5px solid #e2e8f0; color: transparent; font-size: 0.6rem; flex-shrink: 0;
    }
    .ship-option__check--on { background: var(--shop-primary, #4f46e5); border-color: var(--shop-primary, #4f46e5); color: #fff; }

    @@media (max-width: 768px) {
        .section-card { padding: 16px 14px; }
        .summary-card { padding: 16px 14px; border-radius: 16px; }
        .section-header { margin-bottom: 20px; }
