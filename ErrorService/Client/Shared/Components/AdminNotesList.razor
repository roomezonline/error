        border-color: #dc2626;
        color: #fff;
    }

    .an-btn--danger:hover:not(:disabled) {
        background: #b91c1c;
        border-color: #b91c1c;
    }

    .an-spinner {
        width: 12px;
        height: 12px;
        border: 2px solid rgba(255, 255, 255, 0.45);
