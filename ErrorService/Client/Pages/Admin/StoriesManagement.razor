@page "/admin/stories"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.stories.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using System.Net.Http.Headers
@using ErrorService.Client.Utils
@inject HttpClient Http
@inject ErrorService.Client.Services.ToastService Toast
@inject IJSRuntime JS

<div class="container-fluid py-4" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-black text-primary mb-1">مدیریت استوری‌ها</h2>
            <p class="text-muted small">افزودن عکس یا ویدیو به سبک اینستاگرام در صفحه اصلی</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4 shadow-sm" @onclick="() => OpenModal()">
            <span class="oi oi-plus me-2"></span>
            استوری جدید
        </button>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">رسانه</th>
                        <th>عنوان</th>
                        <th>مدت (ثانیه)</th>
                        <th class="text-center">بازدید</th>
                        <th>وضعیت</th>
                        <th>تاریخ ثبت (شمسی)</th>
                        <th class="text-center">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (isLoading)
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="spinner-border text-primary" role="status"></div>
                            </td>
                        </tr>
                    }
                    else if (!stories.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">هیچ استوری یافت نشد.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in stories)
                        {
                            <tr>
                                <td class="ps-4">
                                    @if (item.IsVideo)
                                    {
                                        <div class="media-preview rounded-3 bg-dark d-flex align-items-center justify-content-center text-white">
                                            <span class="oi oi-video"></span>
                                        </div>
                                    }
                                    else
                                    {
                                        <img src="@item.MediaUrl" class="media-preview rounded-3 object-fit-cover" />
                                    }
                                </td>
                                <td>@item.Title</td>
                                <td>@item.DisplayDuration ثانیه</td>
                                <td class="text-center fw-bold">
                                    <span class="badge rounded-pill bg-light text-dark border">
                                        <span class="oi oi-eye me-1"></span>
                                        @item.ViewCount
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge rounded-pill bg-success-subtle text-success px-3">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge rounded-pill bg-danger-subtle text-danger px-3">غیرفعال</span>
                                    }
                                </td>
                                <td class="small text-muted" dir="ltr">@PersianDate.ToJalaliDateTime(item.CreatedAt)</td>
                                <td class="text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <button class="btn btn-sm btn-outline-info rounded-circle" @onclick="() => OpenModal(item)">
                                            <span class="oi oi-pencil"></span>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger rounded-circle" @onclick="() => DeleteStory(item.Id)">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showModal)
{
    <div class="modal fade show d-block" style="background: rgba(0,0,0,0.5); backdrop-filter: blur(4px);">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-bottom p-4">
                    <h5 class="modal-title fw-bold">@(editingItem.Id == 0 ? "افزودن استوری" : "ویرایش استوری")</h5>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>
                <EditForm Model="request" OnValidSubmit="HandleSubmit">
                    <div class="modal-body p-4">
                        <DataAnnotationsValidator />
                        <div class="row g-3">
                        <div class="mb-4">
                            <label class="form-label fw-bold small text-muted mb-2">تصویر یا ویدیو استوری</label>
                            <ImageUploader @bind-ImageUrl="request.MediaUrl" 
                                           UploadUrl="api/stories/admin/upload" 
                                           Accept="image/*,video/*"
                                           MaxSizeMb="50" />
                            @if (isUploading)
                            {
                                <div class="progress mt-2" style="height: 4px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                                </div>
                            }
                        </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">عنوان (اختیاری)</label>
                                <InputText class="form-control" @bind-Value="request.Title" />
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold">لینک (اختیاری)</label>
                                <InputText class="form-control" @bind-Value="request.LinkUrl" placeholder="https://..." />
                            </div>
                            <div class="col-6">
                                <label class="form-label small fw-bold">زمان نمایش (ثانیه)</label>
                                <InputNumber class="form-control" @bind-Value="request.DisplayDuration" />
                            </div>
                            <div class="col-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <InputCheckbox class="form-check-input" @bind-Value="request.IsActive" id="isActiveSwitch" />
                                    <label class="form-check-label small fw-bold" for="isActiveSwitch">فعال باشد</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer border-top p-4">
                        <button type="button" class="btn btn-light rounded-pill px-4" @onclick="CloseModal">انصراف</button>
                        <button type="submit" class="btn btn-primary rounded-pill px-4" disabled="@(isSubmitting || isUploading)">
                            @if (isSubmitting) { <span class="spinner-border spinner-border-sm me-2"></span> }
                            ذخیره تغییرات
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

<style>
    .media-preview {
        width: 60px;
        height: 60px;
        object-fit: cover;
    }
    .bg-success-subtle { background: rgba(25, 135, 84, 0.1); }
    .bg-danger-subtle { background: rgba(220, 53, 69, 0.1); }
</style>

@code {
    private List<StoryDto> stories = new();
    private StoryDto editingItem = new();
    private StoryUpsertRequest request = new();
    private bool isLoading = true;
    private bool showModal = false;
    private bool isSubmitting = false;
    private bool isUploading = false;

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        isLoading = true;
        try {
            stories = await Http.GetFromJsonAsync<List<StoryDto>>("api/stories/admin") ?? new();
        } catch {
            Toast.ShowError("خطا در بارگذاری اطلاعات");
        }
        isLoading = false;
    }

    private void OpenModal(StoryDto? item = null)
    {
        if (item != null)
        {
            editingItem = item;
            request = new StoryUpsertRequest
            {
                MediaUrl = item.MediaUrl,
                IsVideo = item.IsVideo,
                Title = item.Title,
                LinkUrl = item.LinkUrl,
                DisplayDuration = item.DisplayDuration,
                IsActive = item.IsActive
            };
        }
        else
        {
            editingItem = new StoryDto();
            request = new StoryUpsertRequest();
        }
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task OnMediaSelected(InputFileChangeEventArgs e)
    {
        isUploading = true;
        try
        {
            var file = e.File;
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var response = await Http.PostAsync("api/stories/admin/upload", content);
            if (response.IsSuccessStatusCode)
            {
                request.MediaUrl = await response.Content.ReadAsStringAsync();
                request.IsVideo = file.ContentType.StartsWith("video/");
                if (request.IsVideo) request.DisplayDuration = 15; // default for video
            }
            else
            {
                Toast.ShowError("خطا در آپلود فایل");
            }
        }
        catch (Exception ex)
        {
            Toast.ShowError($"خطا: {ex.Message}");
        }
        finally
        {
            isUploading = false;
        }
    }

    private async Task HandleSubmit()
    {
        if (string.IsNullOrEmpty(request.MediaUrl))
        {
            Toast.ShowError("ابتدا فایل را آپلود کنید");
            return;
        }

        isSubmitting = true;
        try
        {
            HttpResponseMessage response;
            if (editingItem.Id == 0)
                response = await Http.PostAsJsonAsync("api/stories/admin", request);
            else
                response = await Http.PutAsJsonAsync($"api/stories/admin/{editingItem.Id}", request);

            if (response.IsSuccessStatusCode)
            {
                Toast.ShowSuccess("با موفقیت ذخیره شد");
                showModal = false;
                await LoadData();
            }
            else
            {
                Toast.ShowError("خطا در ذخیره‌سازی");
            }
        }
        catch
        {
            Toast.ShowError("خطای سیستم");
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task DeleteStory(int id)
    {
        var response = await Http.DeleteAsync($"api/stories/admin/{id}");
        if (response.IsSuccessStatusCode)
        {
            Toast.ShowSuccess("حذف شد");
            await LoadData();
        }
    }
}
