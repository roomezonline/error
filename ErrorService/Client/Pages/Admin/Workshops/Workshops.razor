@page "/admin/workshops"
@layout AdminLayout
@using ErrorService.Client.Helpers
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize]
@using ErrorService.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using ErrorService.Client.Services
@inject ToastService ToastService
@inject IJSRuntime JS
@using ErrorService.Client.Shared

<div class="admin-container" dir="rtl" @ref="pageTopRef" id="workshops-page-top">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="admin-page-title m-0">مدیریت کارگاه‌ها</h3>
    </div>

    <div class="ws-tabs" role="tablist">
        @if (isSuperAdmin)
        {
            <button type="button"
                    class="ws-tab @(activeTab == WorkshopPageTab.Register ? "ws-tab--active" : "")"
                    role="tab"
                    aria-selected="@(activeTab == WorkshopPageTab.Register)"
                    @onclick="() => SetActiveTab(WorkshopPageTab.Register)">
                <span class="oi oi-plus"></span>
                <span>ثبت کارگاه</span>
            </button>
        }
        <button type="button"
                class="ws-tab @(activeTab == WorkshopPageTab.Manage ? "ws-tab--active" : "")"
                role="tab"
                aria-selected="@(activeTab == WorkshopPageTab.Manage)"
                @onclick="() => SetActiveTab(WorkshopPageTab.Manage)">
            <span class="oi oi-list"></span>
            <span>@(isSuperAdmin ? "مدیریت کارگاه" : "کارگاه من")</span>
        </button>
    </div>

    <ConfirmDialog IsVisible="showConfirm"
                   Title="حذف کارگاه"
                   Message=@($"آیا از حذف کارگاه \"{itemToDelete?.WorkshopName}\" اطمینان دارید؟")
                   OnResult="HandleDeleteResult" />

    <UserDeleteConfirmDialog IsVisible="showUserConfirm"
                             Title="@userConfirmTitle"
                             Message="@userConfirmMessage"
                             HasTransactionalRefs="userHasTransactionalRefs"
                             OnResult="HandleUserDeleteResult"
                             OnDeactivate="HandleUserDeactivate" />

    @if (activeTab == WorkshopPageTab.Register)
    {
        <div class="ws-register-wrapper">
            <div class="ws-form-card">
                    <div class="ws-form-card__hero">
                        <div class="ws-form-card__hero-icon">
                            <span class="oi oi-wrench"></span>
                        </div>
                        <div>
                            <h5 class="ws-form-card__title">@(editingId == 0 ? "ثبت کارگاه جدید" : "ویرایش کارگاه")</h5>
                            <p class="ws-form-card__subtitle">اطلاعات کارگاه را با دقت وارد کنید</p>
                        </div>
                    </div>

                <EditForm Model="model" OnValidSubmit="Save" class="ws-form">
                    <DataAnnotationsValidator />

                    <div class="ws-field">
                        <label class="ws-field__label" for="ws-workshop-name">
                            <span class="ws-field__icon oi oi-home"></span>
                            نام کارگاه
                        </label>
                        <div class="ws-field__control">
                            <input id="ws-workshop-name" @bind="model.WorkshopName" class="ws-field__input" placeholder="مثلاً کارگاه تعمیرات آریا" />
                        </div>
                        <ValidationMessage For="@(() => model.WorkshopName)" class="ws-field__error" />
                    </div>

                    <div class="ws-field">
                        <label class="ws-field__label" for="ws-owner-name">
                            <span class="ws-field__icon oi oi-person"></span>
                            نام و نام خانوادگی صاحب امتیاز
                        </label>
                        <div class="ws-field__control">
                            <input id="ws-owner-name" @bind="model.OwnerFullName" class="ws-field__input" placeholder="نام کامل مدیر کارگاه" />
                        </div>
                        <ValidationMessage For="@(() => model.OwnerFullName)" class="ws-field__error" />
                    </div>

                    <div class="ws-field">
                        <label class="ws-field__label" for="ws-mobile">
                            <span class="ws-field__icon oi oi-phone"></span>
                            شماره موبایل
                        </label>
                        <div class="ws-field__control">
                            <input id="ws-mobile" @bind="model.MobileNumber" class="ws-field__input ltr" placeholder="09xxxxxxxxx" inputmode="tel" />
                        </div>
                        <ValidationMessage For="@(() => model.MobileNumber)" class="ws-field__error" />
                    </div>

                    <div class="ws-field">
                        <label class="ws-field__label">
                            <span class="ws-field__icon oi oi-map-marker"></span>
                            استان
                        </label>
                        <div class="ws-field__control ws-field__control--select">
                            <SearchableSelect Items="(provinces ?? new List<ProvinceDto>())"
                                              Value="model.ProvinceId"
                                              ValueChanged="OnProvinceChanged"
                                              GetValue="p => p.Id"
                                              GetText="p => p.Name"
                                              Placeholder="انتخاب استان"
                                              Hint="ابتدا استان را جستجو و انتخاب کنید" />
                        </div>
                        <ValidationMessage For="@(() => model.ProvinceId)" class="ws-field__error" />
                    </div>

                    <div class="ws-field">
                        <label class="ws-field__label">
                            <span class="ws-field__icon oi oi-location"></span>
                            شهرستان / شهر
                        </label>
                        <div class="ws-field__control ws-field__control--select">
                            <SearchableSelect Items="(cities ?? new List<CityDto>())"
                                              Value="model.CityId"
                                              ValueChanged="OnCityChanged"
                                              GetValue="c => c.Id"
                                              GetText="c => c.Name"
                                              Placeholder="انتخاب شهر"
                                              Hint="سپس شهر را جستجو و انتخاب کنید"
                                              Disabled="@(cities == null || !cities.Any())" />
                        </div>
                        <ValidationMessage For="@(() => model.CityId)" class="ws-field__error" />
                    </div>

                    <div class="ws-field">
                        <label class="ws-field__label" for="ws-address">
                            <span class="ws-field__icon oi oi-map"></span>
                            آدرس
                        </label>
                        <div class="ws-field__control">
                            <textarea id="ws-address" @bind="model.Address" class="ws-field__input ws-field__textarea" rows="3" placeholder="آدرس کامل کارگاه (اختیاری)"></textarea>
                        </div>
                        <ValidationMessage For="@(() => model.Address)" class="ws-field__error" />
                    </div>

                    <div class="ws-toggles">
                        <label class="ws-switch-row">
                            <div class="ws-switch-row__text">
                                <span class="ws-switch-row__title">کارگاه فعال</span>
                                <span class="ws-switch-row__sub">در صورت غیرفعال، کارگاه در پذیرش نمایش داده نمی‌شود</span>
                            </div>
                            <span class="ws-switch">
                                <InputCheckbox @bind-Value="model.IsActive" class="ws-switch__input" />
                                <span class="ws-switch__track" aria-hidden="true"></span>
                            </span>
                        </label>

                        <label class="ws-switch-row">
                            <div class="ws-switch-row__text">
                                <span class="ws-switch-row__title">نمایش در «همکاران ما»</span>
                                <span class="ws-switch-row__sub">لوگو در ردیف مشتریان صفحه اصلی سایت نمایش داده شود</span>
                            </div>
                            <span class="ws-switch">
                                <InputCheckbox @bind-Value="model.ShowInCustomersRow" class="ws-switch__input" />
                                <span class="ws-switch__track ws-switch__track--accent" aria-hidden="true"></span>
                            </span>
                        </label>
                    </div>

                    <div class="ws-field">
                        <label class="ws-field__label">
                            <span class="ws-field__icon oi oi-image"></span>
                            تصویر کارگاه (لوگو)
                        </label>
                        <div class="ws-logo-upload">
                            @if (!string.IsNullOrEmpty(model.ImageUrl))
                            {
                                <div class="ws-logo-preview">
                                    <img src="@model.ImageUrl" alt="لوگوی کارگاه" />
                                    <div class="ws-logo-overlay">
                                        <label class="ws-logo-action" title="تغییر تصویر">
                                            <span class="oi oi-pencil"></span>
                                            <InputFile OnChange="HandleLogoFile" accept="image/*,.svg" class="d-none" />
                                        </label>
                                        <button type="button" class="ws-logo-action ws-logo-action--danger" @onclick="RemoveLogo" title="حذف">
                                            <span class="oi oi-trash"></span>
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="ws-logo-options">
                                    <label class="ws-logo-option">
                                        <div class="ws-logo-option__icon">
                                            <span class="oi oi-image"></span>
                                        </div>
                                        <span class="ws-logo-option__title">انتخاب از گالری</span>
                                        <span class="ws-logo-option__hint">حداکثر ۵ مگابایت</span>
                                        <InputFile OnChange="HandleLogoFile" accept="image/*,.svg" class="d-none" />
                                    </label>
                                    <label class="ws-logo-option ws-logo-option--camera">
                                        <div class="ws-logo-option__icon">
                                            <span class="oi oi-camera"></span>
                                        </div>
                                        <span class="ws-logo-option__title">گرفتن عکس</span>
                                        <span class="ws-logo-option__hint">دوربین گوشی</span>
                                        <InputFile OnChange="HandleLogoFile" accept="image/*" capture="environment" class="d-none" />
                                    </label>
                                </div>
                            }
                        </div>
                    </div>

                    <div class="ws-field">
                        <label class="ws-field__label">
                            <span class="ws-field__icon">📊</span>
                            تعداد مجاز مانیتورینگ
                        </label>
                        <div class="ws-field__hint">حداکثر تعداد مانیتورینگ (فعال + پایان‌یافته) که این کارگاه می‌تواند داشته باشد</div>
                        <div class="ws-input-wrap">
                            <InputNumber @bind-Value="model.MaxMonitoringConnections" class="ws-input ws-input--ltr ws-input--monitoring" min="1" max="100" />
                        </div>
                    </div>

                    <div class="ws-form-actions">
                        <button type="submit" class="ws-btn ws-btn--primary" disabled="@isSaving">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            <span class="oi oi-check me-1"></span>
                            ذخیره کارگاه
                        </button>
                        @if (editingId != 0)
                        {
                            <button type="button" class="ws-btn ws-btn--ghost" @onclick="ResetForm">انصراف</button>
                        }
                    </div>
                </EditForm>
                </div>
            </div>
    }
    else
    {
        <div class="row g-4 mt-1">
            <div class="col-12">
                <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                    <h5 class="m-0 fw-bold text-muted">@(isSuperAdmin ? "لیست کارگاه‌ها" : "کارگاه من")</h5>
                    @if (isSuperAdmin)
                    {
                        <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="StartNewWorkshop">
                            <span class="oi oi-plus me-1"></span>
                            ثبت کارگاه جدید
                        </button>
                    }
                </div>
                <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="p-3">
                    @if (items == null)
                    {
                        <div class="text-center py-4">در حال بارگذاری...</div>
                    }
                    else if (!items.Any())
                    {
                        <div class="text-center py-4 text-muted">کارگاهی ثبت نشده است.</div>
                    }
                    else
                    {
                        @foreach (var it in items)
                        {
                            var isExpanded = expandedIds.Contains(it.Id);

                            <div class="ws-card rounded-4 border bg-white shadow-sm mb-3 overflow-hidden">
                                <button type="button" class="ws-card__header w-100 border-0 bg-transparent" @onclick="() => ToggleDetails(it.Id)">
                                    <div class="d-flex align-items-center justify-content-between gap-3">
                                        <div class="text-end overflow-hidden">
                                            <div class="fw-black text-dark text-truncate">@it.WorkshopName</div>
                                            <div class="small text-muted text-truncate">@it.ProvinceName / @it.CityName</div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <span class="badge @(it.IsActive ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") rounded-pill px-3">
                                                @(it.IsActive ? "فعال" : "غیرفعال")
                                            </span>
                                            <span class="oi @(isExpanded ? "oi-chevron-top" : "oi-chevron-bottom") text-muted"></span>
                                        </div>
                                    </div>
                                </button>

                                @if (isExpanded)
                                {
                                    <div class="ws-card__body p-3 pt-0">
                                        <div class="ws-kv-grid">
                                            <div class="ws-kv">
                                                <div class="ws-kv__k">صاحب امتیاز</div>
                                                <div class="ws-kv__v">@it.OwnerFullName</div>
                                            </div>
                                            <div class="ws-kv">
                                                <div class="ws-kv__k">موبایل</div>
                                                <div class="ws-kv__v">@it.MobileNumber</div>
                                            </div>
                                        </div>

                                        <div class="d-flex flex-wrap justify-content-end gap-2 mt-3">
                                            <button class="btn btn-sm btn-outline-success" title="افزودن پرسنل" @onclick="() => OpenAddUserModal(it)" @onclick:stopPropagation>
                                                <span class="oi oi-plus"></span>
                                            </button>
                                            @if (isSuperAdmin)
                                            {
                                                <button class="btn btn-sm btn-outline-secondary" title="فعال/غیرفعال" @onclick="() => ToggleStatus(it)" @onclick:stopPropagation>
                                                    <span class="oi oi-power-standby"></span>
                                                </button>
                                            }
                                            @if (isSuperAdmin || canEditOwn)
                                            {
                                                <button class="btn btn-sm btn-outline-primary" title="ویرایش" @onclick="async () => await Edit(it)" @onclick:stopPropagation>
                                                    <span class="oi oi-pencil"></span>
                                                </button>
                                            }
                                            @if (isSuperAdmin)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" title="حذف" @onclick="() => AskDelete(it)" @onclick:stopPropagation>
                                                    <span class="oi oi-trash"></span>
                                                </button>
                                            }
                                        </div>

                                        <div class="mt-3 pt-3 border-top">
                                            <div class="ws-staff-header">
                                                <div class="ws-staff-header__title">
                                                    <span class="oi oi-people"></span>
                                                    پرسنل کارگاه
                                                    @if (workshopUsersMap.TryGetValue(it.Id, out var staffCountList))
                                                    {
                                                        <span class="ws-staff-header__count">@staffCountList.Count</span>
                                                    }
                                                </div>
                                                <button type="button" class="ws-staff-header__add" @onclick="() => OpenAddUserModal(it)" @onclick:stopPropagation>
                                                    <span class="oi oi-plus"></span>
                                                    افزودن
                                                </button>
                                            </div>

                                            @if (!workshopUsersMap.ContainsKey(it.Id))
                                            {
                                                <div class="ws-staff-empty">در حال بارگذاری پرسنل...</div>
                                            }
                                            else if (workshopUsersMap.TryGetValue(it.Id, out var wsUsers) && wsUsers.Any())
                                            {
                                                <div class="ws-staff-list">
                                                    @foreach (var user in wsUsers)
                                                    {
                                                        <div class="ws-staff-item @(user.IsActive ? "" : "ws-staff-item--inactive")">
                                                            <div class="ws-staff-item__avatar">@GetStaffInitial(user)</div>
                                                            <div class="ws-staff-item__body">
                                                                <div class="ws-staff-item__top">
                                                                    <div class="ws-staff-item__name">@user.FullName</div>
                                                                    <span class="ws-staff-item__status @(user.IsActive ? "ws-staff-item__status--on" : "ws-staff-item__status--off")">
                                                                        @(user.IsActive ? "فعال" : "غیرفعال")
                                                                    </span>
                                                                </div>
                                                                <div class="ws-staff-item__phone ltr">@user.PhoneNumber</div>
                                                                @if (user.IsTechnician)
                                                                {
                                                                    <span class="ws-staff-item__tag ws-staff-item__tag--tech">تکنسین</span>
                                                                }
                                                                <div class="ws-staff-item__roles">
                                                                    @if (user.RoleKeys.Any())
                                                                    {
                                                                        @foreach (var r in user.RoleKeys.Take(4))
                                                                        {
                                                                            <span class="ws-staff-item__role">@GetRoleTitle(r)</span>
                                                                        }
                                                                        @if (user.RoleKeys.Count > 4)
                                                                        {
                                                                            <span class="ws-staff-item__role ws-staff-item__role--more">+@(user.RoleKeys.Count - 4)</span>
                                                                        }
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="ws-staff-item__role ws-staff-item__role--empty">بدون نقش</span>
                                                                    }
                                                                </div>
                                                            </div>
                                                            <div class="ws-staff-item__actions">
                                                                <button type="button" class="ws-staff-action ws-staff-action--edit" title="ویرایش" @onclick="() => EditUser(user, it)" @onclick:stopPropagation>
                                                                    <span class="oi oi-pencil"></span>
                                                                </button>
                                                                <button type="button" class="ws-staff-action @(user.IsActive ? "ws-staff-action--warn" : "ws-staff-action--ok")" title="@(user.IsActive ? "غیرفعال کردن" : "فعال کردن")" @onclick="() => ToggleUserStatusInList(user, it)" @onclick:stopPropagation>
                                                                    <span class="oi @(user.IsActive ? "oi-power-standby" : "oi-check")"></span>
                                                                </button>
                                                                <button type="button" class="ws-staff-action ws-staff-action--danger" title="حذف" @onclick="() => AskDeleteUser(user, it)" @onclick:stopPropagation>
                                                                    <span class="oi oi-trash"></span>
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="ws-staff-empty">هیچ پرسنلی برای این کارگاه ثبت نشده است.</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>
                </div>
            </div>
        </div>
    }
</div>

@if (showUserModal)
{
    <div class="ws-user-modal-backdrop" @onclick="CloseUserModal"></div>
    <div class="ws-user-modal" @onclick:stopPropagation>
        <div class="ws-user-modal__header">
            <div class="ws-user-modal__hero">
                <div class="ws-user-modal__avatar">@(editingUserId == 0 ? "+" : GetStaffInitialFromRequest())</div>
                <div>
                    <h5 class="ws-user-modal__title">@(editingUserId == 0 ? "افزودن پرسنل" : "ویرایش پرسنل")</h5>
                    <p class="ws-user-modal__sub">کارگاه: @targetWorkshop?.WorkshopName</p>
                </div>
            </div>
            <button type="button" class="ws-user-modal__close" @onclick="CloseUserModal"><span class="oi oi-x"></span></button>
        </div>

        <div class="ws-user-modal__body">
            <EditForm Model="userRequest" OnValidSubmit="SaveUser" autocomplete="off" class="ws-form">
                <DataAnnotationsValidator />

                <div class="ws-field">
                    <label class="ws-field__label"><span class="ws-field__icon oi oi-person"></span>نام و نام خانوادگی</label>
                    <div class="ws-field__control">
                        <input @bind="userRequest.FullName" class="ws-field__input" placeholder="نام تکنسین یا همکار..." autocomplete="new-password" />
                    </div>
                    <ValidationMessage For="@(() => userRequest.FullName)" class="ws-field__error" />
                </div>

                <div class="ws-field">
                    <label class="ws-field__label"><span class="ws-field__icon oi oi-phone"></span>شماره موبایل (نام کاربری)</label>
                    <div class="ws-field__control">
                        <input @bind="userRequest.PhoneNumber" class="ws-field__input ltr" placeholder="09xxxxxxxxx" autocomplete="new-password" />
                    </div>
                    <ValidationMessage For="@(() => userRequest.PhoneNumber)" class="ws-field__error" />
                </div>

                <div class="ws-toggles ws-toggles--compact">
                    <label class="ws-switch-row">
                        <div class="ws-switch-row__text">
                            <span class="ws-switch-row__title">حساب فعال</span>
                            <span class="ws-switch-row__sub">کاربر بتواند وارد سیستم شود</span>
                        </div>
                        <span class="ws-switch">
                            <InputCheckbox @bind-Value="userRequest.IsActive" class="ws-switch__input" />
                            <span class="ws-switch__track" aria-hidden="true"></span>
                        </span>
                    </label>
                    <label class="ws-switch-row">
                        <div class="ws-switch-row__text">
                            <span class="ws-switch-row__title">تکنسین</span>
                            <span class="ws-switch-row__sub">امکان ارجاع رسید به این پرسنل</span>
                        </div>
                        <span class="ws-switch">
                            <InputCheckbox @bind-Value="userRequest.IsTechnician" class="ws-switch__input" />
                            <span class="ws-switch__track ws-switch__track--accent" aria-hidden="true"></span>
                        </span>
                    </label>
                </div>

                <div class="ws-password-card">
                    <div class="ws-password-card__title">
                        <span class="oi oi-lock-locked"></span>
                        @(editingUserId == 0 ? "رمز عبور اولیه" : "تغییر رمز عبور")
                    </div>
                    <div class="ws-field">
                        <label class="ws-field__label">@(editingUserId == 0 ? "رمز عبور" : "رمز عبور جدید")</label>
                        <div class="ws-field__control ws-field__control--password">
                            <input @bind="newPassword" type="@(showNewPassword ? "text" : "password")" class="ws-field__input ltr" placeholder="@(editingUserId == 0 ? "حداقل ۴ کاراکتر" : "خالی = بدون تغییر")" autocomplete="new-password" />
                            <button type="button" class="ws-password-toggle" @onclick="() => showNewPassword = !showNewPassword" title="نمایش/مخفی">
                                <span class="oi @(showNewPassword ? "oi-eye-slash" : "oi-eye")"></span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="ws-field">
                    <label class="ws-field__label"><span class="ws-field__icon oi oi-shield"></span>نقش‌های دسترسی</label>
                    @if (availableRoles == null)
                    {
                        <div class="ws-staff-empty">در حال بارگذاری نقش‌ها...</div>
                    }
                    else
                    {
                        <div class="ws-role-grid">
                            @foreach (var role in RolesForTargetWorkshop)
                            {
                                <button type="button" class="ws-role-chip @(userRequest.RoleKeys.Contains(role.Key) ? "ws-role-chip--on" : "")" @onclick="() => ToggleUserRole(role.Key, !userRequest.RoleKeys.Contains(role.Key))">
                                    <span class="ws-role-chip__check">@(userRequest.RoleKeys.Contains(role.Key) ? "✓" : "")</span>
                                    <span>@role.TitleFa</span>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="ws-form-actions">
                    <button type="submit" class="ws-btn ws-btn--primary" disabled="@isSavingUser">
                        @if (isSavingUser) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        ذخیره پرسنل
                    </button>
                    <button type="button" class="ws-btn ws-btn--ghost" @onclick="CloseUserModal">انصراف</button>
