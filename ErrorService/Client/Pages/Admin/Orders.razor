@page "/admin/orders"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.orders.manage")]
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Services
@using ErrorService.Client.Utils
@inject HttpClient Http
@inject ToastService ToastService

<div class="admin-container" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="admin-page-title m-0">مدیریت سفارش‌ها</h3>
        <button class="btn btn-light rounded-pill px-3 shadow-sm" @onclick="LoadOrders">
            <span class="oi oi-reload"></span> بروزرسانی
        </button>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
            <div class="spinner-border text-primary"></div>
            <p class="text-muted mt-2">در حال بارگذاری سفارش‌ها...</p>
        </div>
    }
    else if (orders == null || !orders.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
            <div class="display-1 text-light mb-3"><span class="oi oi-cart"></span></div>
            <h5 class="text-muted fw-bold">هنوز سفارشی ثبت نشده است.</h5>
        </div>
    }
    else if (!filteredOrders.Any())
    {
        <div class="text-center py-5 bg-white rounded-4 shadow-sm border-0">
            <div class="display-1 text-light mb-3"><span class="oi oi-filter"></span></div>
            <h5 class="text-muted fw-bold">سفارشی با این فیلتر یافت نشد.</h5>
        </div>
    }
    else
    {
        <div class="mb-3">
            <div class="d-flex flex-wrap gap-2">
                <button class="btn btn-sm @(statusFilter == null ? "btn-primary" : "btn-light") rounded-pill px-3" @onclick="() => FilterByStatus(null)">
                    همه <span class="badge bg-white text-primary ms-1">@orders.Count</span>
                </button>
                @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                {
                    var count = orders.Count(o => o.Status == status);
                    if (count > 0)
                    {
                        <button class="btn btn-sm @(statusFilter == status ? "btn-primary" : "btn-light") rounded-pill px-3" @onclick="() => FilterByStatus(status)">
                            @GetStatusLabel(status) <span class="badge bg-white text-primary ms-1">@count</span>
                        </button>
                    }
                }
            </div>
        </div>
        <div class="row g-3">
            @foreach (var order in filteredOrders)
            {
                <div class="col-12">
                    <div class="order-card rounded-4 shadow-sm bg-white overflow-hidden border p-3">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="fw-black text-primary">#@order.OrderNumber</div>
                                <div class="small text-muted mt-1">@PersianDate.ToJalaliDateTime(order.CreatedAt)</div>
                            </div>
                            <span class="badge @GetStatusClass(order.Status) rounded-pill px-3 py-2">
                                @GetStatusLabel(order.Status)
                            </span>
                        </div>
                        
                        <div class="row g-2 mb-3">
                            <div class="col-md-4">
                                <div class="small text-muted">مشتری:</div>
                                <div class="fw-bold">@order.FullName</div>
                            </div>
                            <div class="col-md-4">
                                <div class="small text-muted">مبلغ کل:</div>
                                <div class="fw-black text-dark">@order.TotalAmount.ToString("N0") <small>تومان</small></div>
                            </div>
                            <div class="col-md-4">
                                <div class="small text-muted">تخفیف:</div>
                                <div class="fw-bold text-danger">@((order.DiscountAmount ?? 0).ToString("N0")) <small>تومان</small></div>
                                @if (!string.IsNullOrEmpty(order.CouponCode))
                                {
                                    <div class="small"><span class="badge bg-warning text-dark">@order.CouponCode</span></div>
                                }
                            </div>
                            <div class="col-md-4">
                                <div class="small text-muted">موبایل:</div>
                                <div class="fw-bold">@order.PhoneNumber</div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                            <button class="btn btn-outline-danger btn-sm rounded-pill px-3" @onclick="() => ConfirmDelete(order)">
                                <span class="oi oi-trash"></span> حذف
                            </button>
                            <button class="btn btn-primary btn-sm rounded-pill px-4" @onclick="() => ViewDetails(order.Id)">
                                مشاهده و مدیریت
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (selectedOrder != null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content border-0 rounded-4 shadow-lg">
                <div class="modal-header border-0 pt-4 px-4">
                    <h5 class="modal-title fw-black">جزئیات سفارش @selectedOrder.OrderNumber</h5>
                    <button type="button" class="btn-close" @onclick="() => selectedOrder = null"></button>
                </div>
                <div class="modal-body p-4" dir="rtl">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-3">
                                <h6 class="fw-bold text-primary m-0">اطلاعات مشتری</h6>
                                @if (!isEditingInfo)
                                {
                                    <button class="btn btn-outline-primary btn-sm rounded-pill px-3" @onclick="StartEditingInfo">
                                        <span class="oi oi-pencil me-1"></span>ویرایش
                                    </button>
                                }
                            </div>
                            @if (isEditingInfo)
                            {
                                <div class="edit-info-form">
                                    <div class="mb-2">
                                        <label class="form-label small text-muted">نام</label>
                                        <input class="form-control form-control-sm rounded-3" @bind="editInfoModel.FullName" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small text-muted">موبایل</label>
                                        <input class="form-control form-control-sm rounded-3" @bind="editInfoModel.PhoneNumber" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small text-muted">ایمیل</label>
                                        <input class="form-control form-control-sm rounded-3" @bind="editInfoModel.Email" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small text-muted">آدرس</label>
                                        <textarea class="form-control form-control-sm rounded-3" rows="2" @bind="editInfoModel.Address"></textarea>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small text-muted">کد پستی</label>
                                        <input class="form-control form-control-sm rounded-3 ltr" @bind="editInfoModel.PostalCode" />
                                    </div>
                                    <div class="mb-2 small">
                                        <span class="text-muted">استان / شهر:</span>
                                        <span class="fw-bold">@($"{editInfoModel.ProvinceName}{(!string.IsNullOrEmpty(editInfoModel.CityName) ? " - " + editInfoModel.CityName : "")}")</span>
                                    </div>
                                    <div class="d-flex gap-2">
                                        <button class="btn btn-primary btn-sm rounded-pill px-3" @onclick="UpdateOrderInfo" disabled="@isUpdating">
                                            @if (isUpdating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                            ذخیره
                                        </button>
                                        <button class="btn btn-light btn-sm rounded-pill px-3" @onclick="() => isEditingInfo = false">انصراف</button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="mb-2"><strong>نام:</strong> @selectedOrder.FullName</div>
                                <div class="mb-2"><strong>موبایل:</strong> @selectedOrder.PhoneNumber</div>
                                <div class="mb-2"><strong>آدرس:</strong> @(selectedOrder.Address ?? "ثبت نشده")</div>
                                <div class="mb-2"><strong>استان / شهر:</strong> @FormatProvinceCity(selectedOrder)</div>
                                <div class="mb-2"><strong>کد پستی:</strong> @(string.IsNullOrWhiteSpace(selectedOrder.PostalCode) ? "ثبت نشده" : selectedOrder.PostalCode)</div>
                            }
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold border-bottom pb-2 mb-3 text-primary">وضعیت پرداخت</h6>
                            @if ((selectedOrder.ReceiptImageUrls?.Count ?? 0) > 0 || !string.IsNullOrEmpty(selectedOrder.ReceiptImageUrl))
                            {
                                <div class="mb-3">
                                    <div class="small text-muted mb-1">
                                        تصویر رسید (@(selectedOrder.ReceiptImageUrls?.Count ?? 1)):
                                    </div>
                                    <div class="d-flex flex-wrap gap-2">
                                        @if ((selectedOrder.ReceiptImageUrls?.Count ?? 0) > 0)
                                        {
                                            @foreach (var url in selectedOrder.ReceiptImageUrls!)
                                            {
                                                <a href="@url" target="_blank" rel="noopener">
                                                    <img src="@url" class="img-thumbnail rounded-3" style="max-height: 150px;" alt="عکس رسید" />
                                                </a>
                                            }
                                        }
                                        else
                                        {
                                            <a href="@selectedOrder.ReceiptImageUrl" target="_blank" rel="noopener">
                                                <img src="@selectedOrder.ReceiptImageUrl" class="img-thumbnail rounded-3" style="max-height: 150px;" alt="عکس رسید" />
                                            </a>
                                        }
                                    </div>
                                </div>
                                <div class="mb-2"><strong>کد پیگیری:</strong> @(selectedOrder.TrackingNumber ?? "ثبت نشده")</div>
                            }
                            else
                            {
                                <div class="alert alert-warning py-2 small">رسیدی آپلود نشده است.</div>
                            }
                        </div>
                        <div class="col-12">
                            <h6 class="fw-bold border-bottom pb-2 mb-3 text-primary">اقلام سفارش</h6>
                            <div class="table-responsive">
                                <table class="table table-sm table-borderless align-middle">
                                    <thead class="bg-light">
                                        <tr>
                                            <th>محصول</th>
                                            <th class="text-center">تعداد</th>
                                            <th class="text-end">قیمت</th>
                                            <th class="text-end">جمع</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in selectedOrder.Items)
                                        {
                                            <tr>
                                                <td>@item.ProductName</td>
                                                <td class="text-center">@item.Quantity</td>
                                                <td class="text-end">@item.Price.ToString("N0")</td>
                                                <td class="text-end fw-bold">@((item.Price * item.Quantity).ToString("N0"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                    <tfoot>
                                        @if ((selectedOrder.DiscountAmount ?? 0) > 0)
                                        {
                                            <tr>
                                                <td colspan="3" class="text-end text-danger">تخفیف (@selectedOrder.CouponCode):</td>
                                                <td class="text-end text-danger">-@selectedOrder.DiscountAmount?.ToString("N0")</td>
                                            </tr>
                                        }
                                        <tr class="border-top">
                                            <td colspan="3" class="text-end fw-bold">مبلغ قابل پرداخت:</td>
                                            <td class="text-end fw-black text-primary">@((selectedOrder.TotalAmount - (selectedOrder.DiscountAmount ?? 0)).ToString("N0"))</td>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                        <div class="col-12 border-top pt-3">
                            <h6 class="fw-bold mb-3">تغییر وضعیت و یادداشت مدیر</h6>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <select class="form-select rounded-3" @bind="statusToUpdate">
                                        @foreach (OrderStatus status in Enum.GetValues(typeof(OrderStatus)))
                                        {
                                            <option value="@status">@GetStatusLabel(status)</option>
                                        }
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <textarea class="form-control rounded-3" rows="2" @bind="adminNote" placeholder="یادداشت مدیر..."></textarea>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 p-4">
                    <button type="button" class="btn btn-light rounded-pill px-4" @onclick="() => selectedOrder = null">بستن</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" @onclick="UpdateOrderStatus" disabled="@isUpdating">
                        @if (isUpdating) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        بروزرسانی سفارش
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<ConfirmDialog IsVisible="showDeleteConfirm"
               Title="حذف سفارش"
               Message="@($"آیا از حذف سفارش #{itemToDelete?.OrderNumber} اطمینان دارید؟ این عمل غیرقابل بازگشت است.")"
               ConfirmText="بله، حذف شود"
               IsDanger="true"
               OnResult="HandleDeleteResult" />

<style>
    .fw-black { font-weight: 900; }
    .order-card { transition: all 0.2s ease; }
    .order-card:hover { border-color: #2563eb; }
    .edit-info-form .form-control { font-size: 0.85rem; }
    .edit-info-form .form-label { margin-bottom: 2px; }
    .ltr { direction: ltr; text-align: left; }
</style>

@code {
    private List<OrderDto>? orders;
    private OrderDto? selectedOrder;
    private OrderDto? itemToDelete;
    private bool showDeleteConfirm = false;
    private bool isDeleting = false;
    private bool isLoading = true;
    private bool isUpdating = false;
    private OrderStatus statusToUpdate;
    private string? adminNote;
    private bool isEditingInfo = false;
    private OrderUpdateInfoRequest editInfoModel = new();
    private OrderStatus? statusFilter = null;

    private List<OrderDto> filteredOrders => orders?.Where(o => statusFilter == null || o.Status == statusFilter.Value).ToList() ?? new();

    private static string FormatProvinceCity(OrderDto o)
    {
        if (string.IsNullOrWhiteSpace(o.ProvinceName) && string.IsNullOrWhiteSpace(o.CityName))
            return "ثبت نشده";
        if (string.IsNullOrWhiteSpace(o.CityName)) return o.ProvinceName!;
        return $"{o.ProvinceName} - {o.CityName}";
    }

    private void FilterByStatus(OrderStatus? status)
    {
        statusFilter = status;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadOrders();
    }

    private async Task LoadOrders()
    {
        try
        {
            isLoading = true;
            orders = await Http.GetFromJsonAsync<List<OrderDto>>("api/orders/admin/all");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در بارگذاری سفارش‌ها: " + ex.Message);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ConfirmDelete(OrderDto order)
    {
        itemToDelete = order;
        showDeleteConfirm = true;
    }

    private async Task HandleDeleteResult(bool confirmed)
    {
        showDeleteConfirm = false;
        if (!confirmed || itemToDelete == null || isDeleting) return;
        isDeleting = true;
        try
        {
            var resp = await Http.DeleteAsync($"api/orders/admin/{itemToDelete.Id}");
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("سفارش با موفقیت حذف شد.");
                await LoadOrders();
            }
            else
            {
                ToastService.ShowError("خطا در حذف سفارش.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطای سیستمی: " + ex.Message);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private async Task ViewDetails(int id)
    {
        try
        {
            selectedOrder = await Http.GetFromJsonAsync<OrderDto>($"api/orders/{id}");
            if (selectedOrder != null)
            {
                statusToUpdate = selectedOrder.Status;
                adminNote = selectedOrder.AdminNotes;
                isEditingInfo = false;
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در دریافت جزئیات: " + ex.Message);
        }
    }

    private void StartEditingInfo()
    {
        if (selectedOrder == null) return;
        editInfoModel = new OrderUpdateInfoRequest
        {
            FullName = selectedOrder.FullName,
            PhoneNumber = selectedOrder.PhoneNumber,
            Email = selectedOrder.Email,
            Address = selectedOrder.Address ?? "",
            ProvinceId = selectedOrder.ProvinceId,
            CityId = selectedOrder.CityId,
            ProvinceName = selectedOrder.ProvinceName,
            CityName = selectedOrder.CityName,
            PostalCode = selectedOrder.PostalCode
        };
        isEditingInfo = true;
    }

    private async Task UpdateOrderInfo()
    {
        if (selectedOrder == null || isUpdating) return;
        isUpdating = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/orders/admin/{selectedOrder.Id}/info", editInfoModel);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("اطلاعات خریدار بروزرسانی شد.");
                selectedOrder.FullName = editInfoModel.FullName;
                selectedOrder.PhoneNumber = editInfoModel.PhoneNumber;
                selectedOrder.Email = editInfoModel.Email;
                selectedOrder.Address = editInfoModel.Address;
                selectedOrder.ProvinceId = editInfoModel.ProvinceId;
                selectedOrder.CityId = editInfoModel.CityId;
                selectedOrder.ProvinceName = editInfoModel.ProvinceName;
                selectedOrder.CityName = editInfoModel.CityName;
                selectedOrder.PostalCode = editInfoModel.PostalCode;
                isEditingInfo = false;
                await LoadOrders();
            }
            else
            {
                ToastService.ShowError("خطا در بروزرسانی اطلاعات.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطای سیستمی: " + ex.Message);
        }
        finally
        {
            isUpdating = false;
        }
    }

    private async Task UpdateOrderStatus()
    {
        if (selectedOrder == null || isUpdating) return;
        isUpdating = true;

        try
        {
            var req = new OrderStatusUpdateDto { Status = statusToUpdate, AdminNotes = adminNote };
            var resp = await Http.PutAsJsonAsync($"api/orders/admin/{selectedOrder.Id}/status", req);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("سفارش با موفقیت بروزرسانی شد.");
                selectedOrder = null;
                await LoadOrders();
            }
            else
            {
                ToastService.ShowError("خطا در بروزرسانی وضعیت.");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطای سیستمی: " + ex.Message);
        }
        finally
        {
            isUpdating = false;
        }
    }

    private string GetStatusLabel(OrderStatus status) => status switch
    {
        OrderStatus.PendingPayment => "در انتظار پرداخت",
        OrderStatus.ReceiptUploaded => "رسید آپلود شد",
        OrderStatus.Approved => "تایید شده",
        OrderStatus.Rejected => "رد شده",
        OrderStatus.Cancelled => "لغو شده",
        OrderStatus.Completed => "تکمیل شده",
        _ => status.ToString()
    };

    private string GetStatusClass(OrderStatus status) => status switch
    {
        OrderStatus.PendingPayment => "bg-warning-subtle text-warning",
        OrderStatus.ReceiptUploaded => "bg-info-subtle text-info",
        OrderStatus.Approved => "bg-success-subtle text-success",
        OrderStatus.Rejected => "bg-danger-subtle text-danger",
        OrderStatus.Cancelled => "bg-secondary-subtle text-secondary",
        OrderStatus.Completed => "bg-success text-white",
        _ => "bg-light"
    };
}
