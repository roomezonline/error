    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(100);
            await JS.InvokeVoidAsync("initJalali");
        }

        // هنگام باز بودن مدال، اسکرول صفحهٔ پشت قفل می‌شود تا لیست جابه‌جا نشود.
        if (_bodyScrollLocked != showEditor)
        {
            _bodyScrollLocked = showEditor;
            try { await JS.InvokeVoidAsync("setBodyScrollLock", showEditor); } catch { }
        }

        if (!showEditor)
            return;

        // Ensure Quill exists whenever editor is visible
        if (!_quillInitialized)
        {
            objRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initQuillEditor", "quill-editor-container", model.Content ?? "", objRef);
            await JS.InvokeVoidAsync("bindNewsEditorStateForQuill", "quill-editor-container");
            _quillInitialized = true;
            _lastQuillEditingId = editingId;
            return;
        }

        // When switching between news items, update the content
        if (_lastQuillEditingId != editingId)
        {
            await JS.InvokeVoidAsync("setQuillContent", "quill-editor-container", model.Content ?? "");
            await JS.InvokeVoidAsync("bindNewsEditorStateForQuill", "quill-editor-container");
            _lastQuillEditingId = editingId;
        }
    }

