    private async Task LoadTrackedProductsAsync()
    {
        isLoadingTrackedProducts = true;
        try
        {
            recentlyViewedItems = await RecentSvc.GetItemsAsync();
            var activeAlerts = await Http.GetFromJsonAsync<StockAlertMineDto>("api/stock-alerts/mine");
            activeStockAlertProductIds = activeAlerts?.ActiveProductIds?.ToHashSet() ?? new();

            var ids = wishlistItems.Select(x => x.ProductId)
                .Concat(recentlyViewedItems.Select(x => x.Id))
                .Concat(activeStockAlertProductIds)
                .Distinct().Take(30).ToList();
            var requests = ids.Select(async id =>
            {
                try { return await Http.GetFromJsonAsync<ProductDto>($"api/products/{id}"); }
                catch { return null; }
            });
            var products = (await Task.WhenAll(requests)).Where(x => x != null).Cast<ProductDto>().ToList();

            trackedProductCards = products.Select(p => new ProductWatchCard
            {
                ProductId = p.Id,
                Name = p.Name,
                ImageUrl = p.MainImageUrl,
                IsInStock = p.IsAvailable && p.StockQuantity > 0,
                StockQuantity = p.StockQuantity,
                IsFavorite = wishlistItems.Any(x => x.ProductId == p.Id),
                IsRecentlyViewed = recentlyViewedItems.Any(x => x.Id == p.Id),
                StockAlertActive = activeStockAlertProductIds.Contains(p.Id)
            }).ToList();
        }
        catch { trackedProductCards = new(); }
        finally { isLoadingTrackedProducts = false; }
    }

    private async Task ToggleStockAlertAsync(ProductWatchCard item)
    {
        item.IsAlertBusy = true;
        try
        {
            HttpResponseMessage response;
            if (item.StockAlertActive)
                response = await Http.DeleteAsync($"api/stock-alerts/{item.ProductId}");
            else
                response = await Http.PostAsync($"api/stock-alerts/{item.ProductId}", null);

            if (response.IsSuccessStatusCode)
            {
                item.StockAlertActive = !item.StockAlertActive;
                if (item.StockAlertActive)
                    Toast.ShowSuccess("اعلان موجود شدن محصول برای شما فعال شد.");
                else
                    Toast.ShowSuccess("اعلان موجودی این محصول غیرفعال شد.");
            }
            else
            {
                var message = await response.Content.ReadAsStringAsync();
                Toast.ShowWarning(string.IsNullOrWhiteSpace(message) ? "تغییر وضعیت اعلان انجام نشد." : message.Trim('"'));
            }
        }
        catch { Toast.ShowError("ارتباط با سرویس اعلان موجودی برقرار نشد."); }
        finally
        {
            item.IsAlertBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

