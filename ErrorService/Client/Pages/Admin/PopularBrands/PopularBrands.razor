@page "/admin/popular-brands"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.popularbrands.manage")]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using ErrorService.Shared
@using ErrorService.Client.Services
@inject ToastService ToastService
@inject IJSRuntime JS

<div class="admin-container" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="admin-page-title m-0">محبوب‌ترین برندها</h3>
        <button class="btn btn-success rounded-3" @onclick="NewItem">جدید</button>
    </div>

    <ConfirmDialog IsVisible="showConfirm"
                   Title="حذف آیتم"
                   Message=@($"آیا از حذف آیتم \"{itemToDelete?.Title}\" اطمینان دارید؟")
                   OnResult="HandleDeleteResult" />

    <div class="row g-4">
        <div class="col-md-5">
            <div class="card shadow-sm border-0 rounded-4 p-3">
                <h5 class="card-title mb-3">@(editingId is null ? "ایجاد آیتم" : "ویرایش آیتم")</h5>

                <EditForm Model="model" OnValidSubmit="Save">
                    <DataAnnotationsValidator />

                    <div class="mb-3">
                        <label class="form-label">عنوان</label>
                        <InputText class="form-control rounded-3" @bind-Value="model.Title" />
                        <ValidationMessage For="@(() => model.Title)" class="text-danger small" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">لینک (اختیاری)</label>
                        <InputText class="form-control rounded-3" @bind-Value="model.LinkUrl" placeholder="مثلاً: /devices/brands" />
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label">ترتیب</label>
                            <InputNumber class="form-control rounded-3" @bind-Value="model.SortOrder" />
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <div class="form-check">
                                <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" />
                                <label class="form-check-label">فعال</label>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">لوگو</label>
                        <InputFile OnChange="OnLogoSelected" accept="image/*,.svg" />
                        <div class="text-muted small mt-1">لوگو با پس‌زمینه شفاف (PNG/SVG) بهترین نتیجه را دارد.</div>

                        @if (!string.IsNullOrWhiteSpace(model.ImageUrl))
                        {
                            <div class="image-preview mt-2">
                                <img src="@model.ImageUrl" alt="preview" />
                                <div class="image-preview__url">@model.ImageUrl</div>
                            </div>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <button class="btn btn-primary rounded-3" type="submit" disabled="@isSaving">ذخیره</button>
                        <button class="btn btn-light rounded-3" type="button" @onclick="Reset">انصراف</button>
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
                <div class="p-3 border-bottom bg-white d-flex justify-content-between align-items-center">
                    <div class="fw-bold">لیست آیتم‌ها</div>
                    <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="Load">بازخوانی</button>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">لوگو</th>
                                <th>عنوان</th>
                                <th>ترتیب</th>
                                <th>وضعیت</th>
                                <th class="text-end pe-4">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (items == null)
                            {
                                <tr><td colspan="5" class="text-center py-4">در حال بارگذاری...</td></tr>
                            }
                            else if (!items.Any())
                            {
                                <tr><td colspan="5" class="text-center py-4 text-muted">موردی ثبت نشده است.</td></tr>
                            }
                            else
                            {
                                @foreach (var it in items.OrderBy(x => x.SortOrder).ThenByDescending(x => x.Id))
                                {
                                    <tr>
                                        <td class="ps-4">
                                            <div class="mini-thumb">
                                                @if (!string.IsNullOrWhiteSpace(it.ImageUrl))
                                                {
                                                    <img src="@it.ImageUrl" alt="@it.Title" loading="lazy" decoding="async" />
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">-</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="fw-bold">@it.Title</td>
                                        <td>@it.SortOrder</td>
                                        <td>
                                            <span class="badge @(it.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary") rounded-pill px-3">
                                                @(it.IsActive ? "فعال" : "غیرفعال")
                                            </span>
                                        </td>
                                        <td class="text-end pe-4">
                                            <button class="btn btn-sm btn-outline-primary border-0" @onclick="() => Edit(it)">
                                                <span class="oi oi-pencil"></span>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger border-0" @onclick="() => AskDelete(it)">
                                                <span class="oi oi-trash"></span>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .image-preview {
        border: 1px solid rgba(15, 23, 42, 0.08);
        border-radius: 14px;
        padding: 10px;
        background: #fff;
    }
    .image-preview img {
        width: 100%;
        max-height: 120px;
        object-fit: contain;
        display: block;
    }
    .image-preview__url {
        margin-top: 6px;
        font-size: 0.75rem;
        color: #64748b;
        word-break: break-all;
    }

    .mini-thumb {
        width: 56px;
        height: 38px;
        border-radius: 10px;
        border: 1px solid rgba(15, 23, 42, 0.06);
        background: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .mini-thumb img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
    }
</style>

@code {
    [Inject] private HttpClient Http { get; set; } = default!;

    private List<PopularBrandItemDto>? items;

    private PopularBrandItemUpsertRequest model = new() { IsActive = true, SortOrder = 0 };
    private int? editingId;
    private bool isSaving;

    private PopularBrandItemDto? itemToDelete;
    private bool showConfirm;

    protected override async Task OnInitializedAsync()
    {
        await Load();
        Reset();
    }

    private async Task Load()
    {
        try
        {
            items = await Http.GetFromJsonAsync<List<PopularBrandItemDto>>("api/popular-brands");
            items ??= new();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized || ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            items = new();
            ToastService.ShowError("خطای دسترسی: مجوز کافی ندارید. لطفاً از سیستم خارج شده و دوباره وارد شوید.");
        }
        catch
        {
            items = new();
            ToastService.ShowError("خطا در بارگذاری آیتم‌ها");
        }
    }

    private void NewItem() => Reset();

    private void Edit(PopularBrandItemDto it)
    {
        editingId = it.Id;
        model = new PopularBrandItemUpsertRequest
        {
            Title = it.Title,
            ImageUrl = it.ImageUrl,
            LinkUrl = it.LinkUrl,
            SortOrder = it.SortOrder,
            IsActive = it.IsActive
        };
    }

    private void Reset()
    {
        editingId = null;
        model = new PopularBrandItemUpsertRequest
        {
            IsActive = true,
            SortOrder = (items != null && items.Any() ? items.Max(x => x.SortOrder) : 0) + 1
        };
    }

    private async Task Save()
    {
        isSaving = true;
        try
        {
            HttpResponseMessage resp;
            if (editingId is null)
                resp = await Http.PostAsJsonAsync("api/popular-brands", model);
            else
                resp = await Http.PutAsJsonAsync($"api/popular-brands/{editingId.Value}", model);

            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(editingId is null ? "ایتم ایجاد شد" : "تغییرات ذخیره شد");
                await Load();
                Reset();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا در ذخیره" : body.Trim('"'));
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AskDelete(PopularBrandItemDto it)
    {
        itemToDelete = it;
        showConfirm = true;
    }

    private async Task HandleDeleteResult(bool ok)
    {
        showConfirm = false;
        if (!ok || itemToDelete == null) return;

        try
        {
            var resp = await Http.DeleteAsync($"api/popular-brands/{itemToDelete.Id}");
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("حذف شد");
                await Load();
                if (editingId == itemToDelete.Id)
                    Reset();
            }
            else
            {
                ToastService.ShowError("خطا در حذف");
            }
        }
        catch
        {
            ToastService.ShowError("خطا در حذف");
        }
        finally
        {
            itemToDelete = null;
        }
    }

    private async Task OnLogoSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            using var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var resp = await Http.PostAsync("api/popular-brands/upload", content);
            var body = await resp.Content.ReadAsStringAsync();

            if (!resp.IsSuccessStatusCode)
            {
                ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "آپلود ناموفق" : body.Trim('"'));
                return;
            }

            model.ImageUrl = body.Trim('"');
            ToastService.ShowSuccess("لوگو آپلود شد");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا در آپلود: {ex.Message}");
        }
    }
}
