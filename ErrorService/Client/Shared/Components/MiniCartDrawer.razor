@using ErrorService.Shared
@using ErrorService.Client.Services
@implements IDisposable
@inject CartService CartService
@inject SiteSettingsService SettingsService
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (_open)
{
    <div class="mc-overlay" @onclick="Close" role="presentation">
        <aside class="mc" role="dialog" aria-modal="true" aria-label="سبد خرید" @onclick:stopPropagation>
            <header class="mc-head">
                <div class="mc-head__title">
                    <span class="mc-head__icon"><span class="oi oi-cart" aria-hidden="true"></span></span>
                    <div>
                        <strong>سبد خرید شما</strong>
                        <small>@CartService.GetTotalCount() کالا</small>
                    </div>
                </div>
                <button type="button" class="mc-close" @onclick="Close" aria-label="بستن سبد خرید">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </header>

            @if (ShowFreeShipping)
            {
                <div class="mc-ship @(_freeShippingReached ? "is-done" : "")">
                    <div class="mc-ship__row">
                        <span class="mc-ship__icon"><span class="oi @(_freeShippingReached ? "oi-check" : "oi-truck")" aria-hidden="true"></span></span>
                        @if (_freeShippingReached)
                        {
                            <span class="mc-ship__text">ارسال این سفارش <b>رایگان</b> است.</span>
                        }
                        else
                        {
                            <span class="mc-ship__text">
                                <b>@RemainingForFreeShipping.ToString("N0") تومان</b> تا ارسال رایگان
                            </span>
                        }
                    </div>
                    <div class="mc-ship__bar" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                         aria-valuenow="@FreeShippingPercent" aria-label="پیشرفت ارسال رایگان">
                        <span class="mc-ship__fill" style="width:@(FreeShippingPercent)%;"></span>
                    </div>
                </div>
            }

            <div class="mc-body">
                @if (Items.Count == 0)
                {
                    <div class="mc-empty">
                        <span class="oi oi-cart" aria-hidden="true"></span>
                        <p>سبد خرید شما خالی است.</p>
                        <a class="mc-btn mc-btn--ghost" href="/products" @onclick="Close">رفتن به فروشگاه</a>
                    </div>
                }
                else
                {
                    @foreach (var item in Items)
                    {
                        <div class="mc-item" @key="item.ProductId">
                            <a class="mc-item__img" href="@ProductLink(item)" @onclick="Close">
                                <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "/images/placeholder-product.svg" : ImageUrlHelper.Thumb(item.ImageUrl, 200))"
                                     loading="lazy" decoding="async" alt="@item.Name" />
                            </a>
                            <div class="mc-item__main">
                                <a class="mc-item__name" href="@ProductLink(item)" @onclick="Close">@item.Name</a>
                                <div class="mc-item__price">@item.Price.ToString("N0") <small>تومان</small></div>
                                <div class="mc-item__actions">
                                    <div class="mc-qty" role="group" aria-label="تعداد @item.Name">
                                        <button type="button" class="mc-qty__btn" @onclick="() => Decrease(item)" aria-label="کم کردن">
                                            <span class="oi oi-minus"></span>
                                        </button>
                                        <span class="mc-qty__val">@item.Quantity</span>
                                        <button type="button" class="mc-qty__btn" @onclick="() => Increase(item)" aria-label="زیاد کردن">
                                            <span class="oi oi-plus"></span>
                                        </button>
                                    </div>
                                    <button type="button" class="mc-remove" @onclick="() => Remove(item)" aria-label="حذف @item.Name">
                                        <span class="oi oi-trash" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            @if (Items.Count > 0)
            {
                <footer class="mc-foot">
                    <div class="mc-total">
                        <span>جمع سبد خرید</span>
                        <b>@CartService.GetTotalAmount().ToString("N0") <small>تومان</small></b>
                    </div>
                    <div class="mc-foot__actions">
                        <a class="mc-btn mc-btn--primary" href="/checkout" @onclick="Close">
                            <span class="oi oi-arrow-left" aria-hidden="true"></span>
                            تکمیل خرید
                        </a>
                        <a class="mc-btn mc-btn--ghost" href="/cart" @onclick="Close">مشاهده سبد</a>
                    </div>
                </footer>
            }
        </aside>
    </div>
}

<style>
    .mc-overlay {
        position: fixed;
        inset: 0;
        z-index: 1140;
        background: rgba(2, 6, 23, 0.5);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        animation: mc-fade 0.18s ease;
    }

    .mc {
        position: absolute;
        top: 0;
        left: 0;
        bottom: 0;
        width: min(400px, 92vw);
        display: flex;
        flex-direction: column;
        background: var(--app-surface, #fff);
        color: var(--app-text, #0f172a);
        border-start-end-radius: 20px;
        border-end-end-radius: 20px;
        box-shadow: 12px 0 40px rgba(2, 6, 23, 0.28);
        animation: mc-slide 0.24s cubic-bezier(0.4, 0, 0.2, 1);
        overflow: hidden;
    }

    @@keyframes mc-fade { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes mc-slide { from { transform: translateX(-100%); } to { transform: none; } }

    .mc-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 1rem 1.1rem;
        border-bottom: 1px solid var(--app-border, rgba(15, 23, 42, 0.08));
    }

    .mc-head__title { display: flex; align-items: center; gap: 0.65rem; }
    .mc-head__title strong { display: block; font-size: 0.95rem; font-weight: 900; }
    .mc-head__title small { display: block; font-size: 0.72rem; color: var(--app-text-muted, #64748b); }

    .mc-head__icon {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        font-size: 1.05rem;
    }

    .mc-close {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border: none;
        border-radius: 50%;
        background: var(--app-bg, #f1f5f9);
        color: var(--app-text-secondary, #334155);
        cursor: pointer;
    }

    .mc-close:hover { background: rgba(239, 68, 68, 0.12); color: #dc2626; }

    .mc-ship {
        margin: 0.75rem 1.1rem 0;
        padding: 0.7rem 0.8rem;
        border-radius: 14px;
        background: rgba(37, 99, 235, 0.07);
        border: 1px solid rgba(37, 99, 235, 0.14);
    }

    .mc-ship.is-done {
        background: rgba(16, 185, 129, 0.09);
        border-color: rgba(16, 185, 129, 0.22);
    }

    .mc-ship__row { display: flex; align-items: center; gap: 0.5rem; font-size: 0.76rem; }
    .mc-ship__icon { color: #2563eb; font-size: 0.95rem; }
    .mc-ship.is-done .mc-ship__icon { color: #059669; }
    .mc-ship__text { color: var(--app-text-secondary, #334155); }
    .mc-ship__text b { color: var(--app-primary, #2563eb); font-variant-numeric: tabular-nums; }
    .mc-ship.is-done .mc-ship__text b { color: #047857; }

    .mc-ship__bar {
        height: 5px;
        margin-top: 0.5rem;
        border-radius: 999px;
        background: rgba(37, 99, 235, 0.14);
        overflow: hidden;
    }

    .mc-ship.is-done .mc-ship__bar { background: rgba(16, 185, 129, 0.18); }

    .mc-ship__fill {
        display: block;
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg, #2563eb, #38bdf8);
        transition: width 0.4s ease;
    }

    .mc-ship.is-done .mc-ship__fill { background: linear-gradient(90deg, #059669, #34d399); }

    .mc-body {
        flex: 1 1 auto;
        overflow-y: auto;
        padding: 0.9rem 1.1rem;
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
        -webkit-overflow-scrolling: touch;
    }

    .mc-item {
        display: flex;
        gap: 0.7rem;
        padding: 0.6rem;
        border: 1px solid var(--app-border, rgba(15, 23, 42, 0.08));
        border-radius: 14px;
        background: var(--app-card-bg, #fff);
    }

    .mc-item__img {
        flex: 0 0 62px;
        width: 62px;
        height: 62px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: var(--app-bg, #f8fafc);
        overflow: hidden;
    }

    .mc-item__img img { width: 100%; height: 100%; object-fit: contain; padding: 4px; }

    .mc-item__main { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; gap: 0.25rem; }

    .mc-item__name {
        font-size: 0.78rem;
        font-weight: 800;
        color: var(--app-text, #0f172a);
        text-decoration: none;
        line-height: 1.7;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .mc-item__name:hover { color: var(--app-primary, #2563eb); }

    .mc-item__price { font-size: 0.78rem; font-weight: 800; color: var(--app-primary, #2563eb); }

    .mc-item__actions { display: flex; align-items: center; justify-content: space-between; margin-top: 0.15rem; }

    .mc-qty {
        display: inline-flex;
        align-items: center;
        gap: 0.3rem;
        padding: 0.15rem 0.3rem;
        border: 1px solid var(--app-border-strong, rgba(15, 23, 42, 0.12));
        border-radius: 999px;
    }

    .mc-qty__btn {
        width: 26px;
        height: 26px;
        display: grid;
        place-items: center;
        border: none;
        border-radius: 50%;
        background: rgba(37, 99, 235, 0.1);
        color: #2563eb;
        cursor: pointer;
        font-size: 0.62rem;
    }

    .mc-qty__btn:active { transform: scale(0.93); }
    .mc-qty__val { min-width: 20px; text-align: center; font-size: 0.78rem; font-weight: 900; }

    .mc-remove {
        border: none;
        background: transparent;
        color: #94a3b8;
        cursor: pointer;
        padding: 0.25rem;
        font-size: 0.8rem;
    }

    .mc-remove:hover { color: #dc2626; }

    .mc-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 2.5rem 1rem;
        text-align: center;
        color: var(--app-text-muted, #64748b);
    }

    .mc-empty .oi { font-size: 2.4rem; opacity: 0.45; }
    .mc-empty p { margin: 0; font-size: 0.85rem; }

    .mc-foot {
        border-top: 1px solid var(--app-border, rgba(15, 23, 42, 0.08));
        padding: 0.9rem 1.1rem calc(0.9rem + env(safe-area-inset-bottom, 0px));
        background: var(--app-surface, #fff);
        display: flex;
        flex-direction: column;
        gap: 0.65rem;
    }

    .mc-total { display: flex; align-items: baseline; justify-content: space-between; font-size: 0.82rem; color: var(--app-text-secondary, #334155); }
    .mc-total b { font-size: 1.05rem; font-weight: 900; color: var(--app-text, #0f172a); }
    .mc-total small { font-size: 0.7rem; font-weight: 700; }

    .mc-foot__actions { display: flex; gap: 0.5rem; }

    .mc-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.35rem;
        padding: 0.62rem 0.9rem;
        border-radius: 999px;
        border: 1px solid transparent;
        font-size: 0.82rem;
        font-weight: 800;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.15s ease, background 0.15s ease;
    }

    .mc-btn:active { transform: scale(0.97); }

    .mc-btn--primary {
        flex: 1 1 auto;
        background: linear-gradient(135deg, #2563eb, #4f46e5);
        color: #fff;
        box-shadow: 0 10px 22px rgba(37, 99, 235, 0.28);
    }

    .mc-btn--primary:hover { background: linear-gradient(135deg, #1d4ed8, #4338ca); }

    .mc-btn--ghost {
        background: transparent;
        border-color: var(--app-border-strong, rgba(15, 23, 42, 0.14));
        color: var(--app-text-secondary, #334155);
    }

    .mc-btn--ghost:hover { background: var(--app-bg, #f1f5f9); }

    [data-theme="dark"] .mc-head__icon { background: rgba(59, 130, 246, 0.18); color: #93c5fd; }
    [data-theme="dark"] .mc-item__price { color: #60a5fa; }
    [data-theme="dark"] .mc-item__name:hover { color: #93c5fd; }
    [data-theme="dark"] .mc-qty__val { color: #bfdbfe; }
    [data-theme="dark"] .mc-ship { background: rgba(37, 99, 235, 0.14); border-color: rgba(59, 130, 246, 0.28); }
    [data-theme="dark"] .mc-ship.is-done { background: rgba(16, 185, 129, 0.14); border-color: rgba(16, 185, 129, 0.3); }

    @@media (prefers-reduced-motion: reduce) {
        .mc-overlay, .mc { animation: none; }
    }
</style>

@code {
    private bool _open;
    private SiteSettingsDto? _settings;
    private bool _loadingSettings;
    private DotNetObjectReference<MiniCartDrawer>? _selfRef;
    private readonly string _escOwner = "minicart";
    private bool _disposed;

    private List<CartItem> Items => CartService.GetItems();

    private bool ShowFreeShipping =>
        _settings?.EnableFreeShipping == true && _settings.FreeShippingThreshold is > 0;

    private decimal Threshold => _settings?.FreeShippingThreshold ?? 0;

    private decimal RemainingForFreeShipping =>
        Math.Max(0, Threshold - CartService.GetTotalAmount());

    private bool _freeShippingReached => ShowFreeShipping && CartService.GetTotalAmount() >= Threshold;

    private int FreeShippingPercent
    {
        get
        {
            if (!ShowFreeShipping || Threshold <= 0) return 0;
            var ratio = CartService.GetTotalAmount() / Threshold * 100m;
            return (int)Math.Clamp(Math.Round(ratio), 0, 100);
        }
    }

    protected override void OnInitialized()
    {
        CartService.ItemAdded += HandleItemAdded;
        CartService.OnChange += StateHasChanged;
        Nav.LocationChanged += HandleNavigation;
        _ = EnsureSettingsAsync();
    }

    private void HandleNavigation(object? sender, LocationChangedEventArgs e)
    {
        if (_open) Close();
    }

    private async Task EnsureSettingsAsync()
    {
        if (_settings != null || _loadingSettings) return;
        _loadingSettings = true;
        try
        {
            _settings = await SettingsService.GetAsync();
            if (_open && !_disposed) await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _loadingSettings = false;
        }
    }

    private void HandleItemAdded(CartItem item) => _ = InvokeAsync(async () =>
    {
        if (_disposed) return;
        await EnsureSettingsAsync();
        if (!_open && ShouldAutoOpen())
        {
            _open = true;
            _selfRef ??= DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("esSetScrollLock", _escOwner, true); } catch { }
            try { await JS.InvokeVoidAsync("esOnEsc", _escOwner, _selfRef); } catch { }
        }
        StateHasChanged();
    });

    /// <summary>
    /// در صفحه جزئیات محصول و سبد خرید، خود صفحه بازخورد کافی دارد؛
    /// برای جلوگیری از پوشاندن آن، سبد کوچک خودکار باز نمی‌شود.
    /// </summary>
    private bool ShouldAutoOpen()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/').ToLowerInvariant();
        if (path.Length == 0) path = "/";
        if (path.StartsWith("/products/")) return false;
        if (path.StartsWith("/cart")) return false;
        if (path.StartsWith("/checkout")) return false;
        if (path.StartsWith("/compare")) return false;
        return true;
    }

    private void Close()
    {
        if (!_open) return;
        _open = false;
        _ = JS.InvokeVoidAsync("esSetScrollLock", _escOwner, false);
        _ = JS.InvokeVoidAsync("esOffEsc", _escOwner);
        StateHasChanged();
    }

    [JSInvokable]
    public void CloseFromJs() => Close();

    private async Task Increase(CartItem item)
    {
        await CartService.UpdateQuantityAsync(item.ProductId, item.Quantity + 1);
    }

    private async Task Decrease(CartItem item)
    {
        if (item.Quantity <= 1)
            await CartService.RemoveItemAsync(item.ProductId);
        else
            await CartService.UpdateQuantityAsync(item.ProductId, item.Quantity - 1);
    }

    private async Task Remove(CartItem item)
    {
        await CartService.RemoveItemAsync(item.ProductId);
    }

    private static string ProductLink(CartItem item) => SeoUrl.Product(item.ProductId, null);

    public void Dispose()
    {
        _disposed = true;
        CartService.ItemAdded -= HandleItemAdded;
        CartService.OnChange -= StateHasChanged;
        Nav.LocationChanged -= HandleNavigation;
        _ = JS.InvokeVoidAsync("esSetScrollLock", _escOwner, false);
        _ = JS.InvokeVoidAsync("esOffEsc", _escOwner);
        _selfRef?.Dispose();
    }
}
