@using ErrorService.Shared.Models
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav

@if (footer != null)
{
    <footer class="site-footer" dir="rtl">
        <!-- Main Footer -->
        <div class="footer-main">
            <div class="container-fluid px-3 px-md-4">
                <div class="row g-4">
                    <!-- Company Info Column -->
                    <div class="col-lg-4 col-md-6">
                        <div class="footer-brand">
                            @if (!string.IsNullOrEmpty(footer.LogoUrl))
                            {
                                <img src="@footer.LogoUrl" alt="@footer.CompanyName" class="footer-logo" loading="lazy" />
                            }
                            else
                            {
                                <div class="footer-logo-text">
                                    <span class="oi oi-cog me-2"></span>
                                    @footer.CompanyName
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(footer.CompanyDescription))
                            {
                                <p class="footer-desc">@footer.CompanyDescription</p>
                            }
                        </div>
                        
                        <!-- Contact Info -->
                        <div class="footer-contact">
                            @if (!string.IsNullOrEmpty(footer.PhoneNumber1))
                            {
                                <a href="tel:@footer.PhoneNumber1" class="contact-item">
                                    <span class="contact-icon"><span class="oi oi-phone"></span></span>
                                    <span>@footer.PhoneNumber1</span>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(footer.WhatsAppNumber))
                            {
                                <a href="https://wa.me/@(footer.WhatsAppNumber.TrimStart('+', '0'))" target="_blank" class="contact-item">
                                    <span class="contact-icon whatsapp"><span class="oi oi-comment-square"></span></span>
                                    <span>واتساپ: @footer.WhatsAppNumber</span>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(footer.Email))
                            {
                                <a href="mailto:@footer.Email" class="contact-item">
                                    <span class="contact-icon"><span class="oi oi-envelope-closed"></span></span>
                                    <span>@footer.Email</span>
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(footer.Address))
                            {
                                <div class="contact-item">
                                    <span class="contact-icon"><span class="oi oi-map-marker"></span></span>
                                    <span>@footer.Address</span>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Link Groups -->
                    @foreach (var group in footer.LinkGroups.OrderBy(g => g.SortOrder).Take(3))
                    {
                        <div class="col-lg-2 col-md-6 col-6">
                            <div class="footer-links">
                                <h5 class="footer-title">@group.Title</h5>
                                <ul class="footer-list">
                                    @foreach (var link in group.Links.OrderBy(l => l.SortOrder))
                                    {
                                        <li>
                                            @if (link.IsExternal)
                                            {
                                                <a href="@link.Url" target="_blank" rel="noopener">
                                                    @if (!string.IsNullOrEmpty(link.Icon))
                                                    {
                                                        <span class="oi @link.Icon me-1"></span>
                                                    }
                                                    @link.Title
                                                </a>
                                            }
                                            else
                                            {
                                                <a href="@link.Url">
                                                    @if (!string.IsNullOrEmpty(link.Icon))
                                                    {
                                                        <span class="oi @link.Icon me-1"></span>
                                                    }
                                                    @link.Title
                                                </a>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Newsletter -->
        <div class="footer-newsletter py-4" style="background:rgba(0,0,0,0.02);">
            <div class="container-fluid px-3 px-md-4">
                <div class="row justify-content-center">
                    <div class="col-md-6 text-center">
                        <h5 class="fw-bold mb-2">عضویت در خبرنامه</h5>
                        <p class="small text-muted mb-3">با عضویت در خبرنامه، از جدیدترین محصولات و تخفیف‌ها باخبر شوید.</p>
                        <div class="input-group mx-auto" style="max-width:450px;">
                            <input type="email" class="form-control rounded-start-3" placeholder="ایمیل خود را وارد کنید..." @bind="newsletterEmail" />
                            <button class="btn btn-primary rounded-end-3" @onclick="SubscribeNewsletter" disabled="@newsletterBusy">
                                @if (newsletterBusy) { <span class="spinner-border spinner-border-sm"></span> }
                                else { <span>عضویت</span> }
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(newsletterMsg))
                        {
                            <div class="small mt-2 @(newsletterIsError ? "text-danger" : "text-success")">@newsletterMsg</div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Trust Badges & Social -->
        <div class="footer-trust">
            <div class="container-fluid px-3 px-md-4">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <!-- Social Links -->
                        <div class="footer-social">
                            <span class="social-label">ما را دنبال کنید:</span>
                            <div class="social-links">
                                @if (!string.IsNullOrEmpty(footer.InstagramUrl))
                                {
                                    <a href="@footer.InstagramUrl" target="_blank" rel="noopener" class="social-link instagram" title="اینستاگرام">
                                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(footer.TelegramUrl))
                                {
                                    <a href="@footer.TelegramUrl" target="_blank" rel="noopener" class="social-link telegram" title="تلگرام">
                                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(footer.YouTubeUrl))
                                {
                                    <a href="@footer.YouTubeUrl" target="_blank" rel="noopener" class="social-link youtube" title="یوتیوب">
                                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                                    </a>
                                }
                                @if (!string.IsNullOrEmpty(footer.LinkedInUrl))
                                {
                                    <a href="@footer.LinkedInUrl" target="_blank" rel="noopener" class="social-link linkedin" title="لینکدین">
                                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <!-- Trust Badges -->
                        <div class="trust-badges">
                            @if (!string.IsNullOrEmpty(footer.EnamadCode))
                            {
                                <div class="trust-badge">
                                    <img src="https://trustseal.enamad.ir/logo.aspx?id=@footer.EnamadCode&Code=@footer.EnamadCode" 
                                         alt="نماد اعتماد الکترونیک" loading="lazy" />
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(footer.SamandehiCode))
                            {
                                <div class="trust-badge">
                                    <img src="https://logo.samandehi.ir/logo.aspx?id=@footer.SamandehiCode&Code=@footer.SamandehiCode" 
                                         alt="ساماندهی" loading="lazy" />
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(footer.EtaCode))
                            {
                                <div class="trust-badge eta-badge">
                                    <span class="badge-icon">کسب‌وکار اینترنتی</span>
                                    <span class="badge-code">@footer.EtaCode</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div class="footer-copyright">
            <div class="container-fluid px-3 px-md-4">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <p class="copyright-text">@footer.CopyrightText</p>
                    </div>
                    <div class="col-md-6">
                        <div class="copyright-links">
                            <a href="/privacy">حریم خصوصی</a>
                            <span class="separator">|</span>
                            <a href="/terms">شرایط استفاده</a>
                            <span class="separator">|</span>
                            <a href="/about">درباره ما</a>
                            <span class="separator">|</span>
                            <a href="/commitment">تعهدنامه</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
}

<style>
    .site-footer {
        background: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
        color: #f1f5f9;
        margin-top: auto;
        overflow-x: hidden;
        width: 100%;
    }

    .footer-main {
        padding: 60px 0 40px;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .footer-brand {
        margin-bottom: 24px;
    }

    .footer-logo {
        height: 50px;
        margin-bottom: 16px;
        filter: brightness(0) invert(1);
    }

    .footer-logo-text {
        font-size: 1.75rem;
        font-weight: 800;
        color: #fff;
        margin-bottom: 16px;
        display: flex;
        align-items: center;
    }

    .footer-desc {
        color: #94a3b8;
        font-size: 0.95rem;
        line-height: 1.8;
        max-width: 300px;
    }

    .footer-contact {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .contact-item {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #cbd5e1;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.2s ease;
    }

    .contact-item:hover {
        color: #60a5fa;
    }

    .contact-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(255,255,255,0.1);
        display: grid;
        place-items: center;
        color: #60a5fa;
        font-size: 0.85rem;
        flex-shrink: 0;
    }

    .contact-icon.whatsapp {
        background: rgba(37, 211, 102, 0.15);
        color: #25d366;
    }

    .footer-title {
        font-size: 1rem;
        font-weight: 700;
        color: #fff;
        margin-bottom: 20px;
        position: relative;
        padding-bottom: 10px;
    }

    .footer-title::after {
        content: '';
        position: absolute;
        bottom: 0;
        right: 0;
        width: 30px;
        height: 2px;
        background: linear-gradient(90deg, #3b82f6, #10b981);
        border-radius: 2px;
    }

    .footer-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .footer-list li {
        margin-bottom: 10px;
    }

    .footer-list a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.9rem;
        transition: all 0.2s ease;
        display: inline-flex;
        align-items: center;
    }

    .footer-list a:hover {
        color: #60a5fa;
        padding-right: 5px;
    }

    /* Trust & Social Section */
    .footer-trust {
        padding: 30px 0;
        border-bottom: 1px solid rgba(255,255,255,0.1);
    }

    .footer-social {
        display: flex;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
    }

    .social-label {
        color: #94a3b8;
        font-size: 0.9rem;
    }

    .social-links {
        display: flex;
        gap: 12px;
    }

    .social-link {
        width: 40px;
        height: 40px;
        border-radius: 12px;
        background: rgba(255,255,255,0.1);
        display: grid;
        place-items: center;
        color: #fff;
        transition: all 0.3s ease;
    }

    .social-link svg {
        width: 20px;
        height: 20px;
    }

    .social-link:hover {
        transform: translateY(-3px);
    }

    .social-link.instagram:hover {
        background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);
    }

    .social-link.telegram:hover {
        background: #0088cc;
    }

    .social-link.youtube:hover {
        background: #ff0000;
    }

    .social-link.linkedin:hover {
        background: #0077b5;
    }

    .trust-badges {
        display: flex;
        gap: 16px;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .trust-badge {
        height: 70px;
        padding: 8px 16px;
        background: #fff;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .trust-badge img {
        height: 50px;
        width: auto;
    }

    .eta-badge {
        flex-direction: column;
        gap: 4px;
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: #fff;
        min-width: 120px;
    }

    .badge-icon {
        font-size: 0.7rem;
        opacity: 0.9;
    }

    .badge-code {
        font-size: 0.85rem;
        font-weight: 700;
        font-family: monospace;
    }

    /* Copyright Section */
    .footer-copyright {
        padding: 20px 0;
        background: rgba(0,0,0,0.2);
    }

    .copyright-text {
        color: #64748b;
        font-size: 0.85rem;
        margin: 0;
    }

    .copyright-links {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
        align-items: center;
        flex-wrap: wrap;
    }

    .copyright-links a {
        color: #94a3b8;
        text-decoration: none;
        font-size: 0.85rem;
        transition: color 0.2s ease;
    }

    .copyright-links a:hover {
        color: #60a5fa;
    }

    .separator {
        color: #475569;
    }

    /* Dark Mode Support */
    [data-theme="dark"] .site-footer {
        background: linear-gradient(180deg, #0f172a 0%, #020617 100%);
    }

    [data-theme="dark"] .trust-badge {
        background: #1e293b;
    }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        .footer-main {
            padding: 40px 0 30px;
        }

        .trust-badges {
            justify-content: center;
            margin-top: 20px;
        }

        .copyright-links {
            justify-content: center;
            margin-top: 10px;
        }

        .footer-title::after {
            right: 50%;
            transform: translateX(50%);
        }

        .footer-links {
            text-align: center;
        }
    }
</style>

@code {
    private FooterSettingsDto? footer;
    private string newsletterEmail = "";
    private string? newsletterMsg;
    private bool newsletterIsError;
    private bool newsletterBusy;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            footer = await Http.GetFromJsonAsync<FooterSettingsDto>("api/footer");
        }
        catch
        {
            footer = GetDefaultFooter();
        }
    }

    private async Task SubscribeNewsletter()
    {
        var email = newsletterEmail?.Trim() ?? "";
        if (string.IsNullOrWhiteSpace(email)) { newsletterIsError = true; newsletterMsg = "لطفاً ایمیل خود را وارد کنید."; return; }
        var emailRegex = new System.Text.RegularExpressions.Regex(@"^[^@\s]+@[^@\s]+\.[^@\s]+$");
        if (!emailRegex.IsMatch(email)) { newsletterIsError = true; newsletterMsg = "فرمت ایمیل صحیح نیست."; return; }
        newsletterBusy = true;
        newsletterIsError = false;
        newsletterMsg = null;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/newsletter/subscribe", new { email });
            var result = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (resp.IsSuccessStatusCode)
            {
                newsletterIsError = false;
                newsletterMsg = result?.GetValueOrDefault("message") ?? "با موفقیت ثبت شد.";
                newsletterEmail = "";
            }
            else
            {
                newsletterIsError = true;
                newsletterMsg = result?.GetValueOrDefault("message") ?? "خطا در ثبت‌نام";
            }
        }
        catch
        {
            newsletterIsError = true;
            newsletterMsg = "خطا در ارتباط با سرور.";
        }
        finally
        {
            newsletterBusy = false;
        }
    }

    private FooterSettingsDto GetDefaultFooter()
    {
        return new FooterSettingsDto
        {
            CompanyName = "ارورسرویس",
            CompanyDescription = "مرکز تخصصی تعمیرات و آموزش‌های الکترونیک با بیش از ۱۰ سال تجربه در خدمت شما",
            PhoneNumber1 = "09166912537",
            WhatsAppNumber = "09166912537",
            Email = "info@errorservice.ir",
            Address = "خوزستان، رامهرمز، خیابان کانال",
            InstagramUrl = "https://instagram.com/errorservice",
            TelegramUrl = "https://t.me/errorservice",
            CopyrightText = "© 2025 ارورسرویس - تمامی حقوق محفوظ است",
            LinkGroups = new List<FooterLinkGroupDto>
            {
                new FooterLinkGroupDto
                {
                    Title = "دسترسی سریع",
                    Links = new List<FooterLinkDto>
                    {
                        new FooterLinkDto { Title = "صفحه اصلی", Url = "/" },
                        new FooterLinkDto { Title = "محصولات", Url = "/products" },
                        new FooterLinkDto { Title = "آکادمی آموزش", Url = "/academy" },
                        new FooterLinkDto { Title = "تماس با ما", Url = "/contact" }
                    }
                },
                new FooterLinkGroupDto
                {
                    Title = "خدمات",
                    Links = new List<FooterLinkDto>
                    {
                        new FooterLinkDto { Title = "تعمیرات", Url = "/services/repair" },
                        new FooterLinkDto { Title = "مشاوره فنی", Url = "/technical/consultation" },
                        new FooterLinkDto { Title = "بانک کدهای خطا", Url = "/technical/error-codes" },
                        new FooterLinkDto { Title = "ابزار محاسباتی", Url = "/technical/calculators" }
                    }
                },
                new FooterLinkGroupDto
                {
                    Title = "راهنما",
                    Links = new List<FooterLinkDto>
                    {
                        new FooterLinkDto { Title = "نحوه سفارش", Url = "/help/how-to-order" },
                        new FooterLinkDto { Title = "شرایط گارانتی", Url = "/help/warranty" },
                        new FooterLinkDto { Title = "سوالات متداول", Url = "/help/faq" },
                        new FooterLinkDto { Title = "درباره ما", Url = "/about" }
                    }
                }
            }
        };
    }
}
