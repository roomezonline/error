@code {
    [Parameter] public int MonitoringConnectionId { get; set; }
    [Parameter] public bool IsOverlay { get; set; }
    [Parameter] public EventCallback OnOverlayClose { get; set; }

    private MonitoringChartResponse? _data;
    private bool _loading = true;
    private string? _error;
    private string _pageTitle = "";
    private int _dataCount;
    private bool _needsChartInit;
    private bool _dataRendered;

    protected override bool ShouldRender()
    {
        if (_error != null) return true;
        if (_data == null) return true;
        return !_dataRendered;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !IsOverlay)
        {
            await JS.InvokeVoidAsync("dpcApplyBodyClass");
        }

        if (_needsChartInit && _data != null)
        {
            _needsChartInit = false;
            _dataRendered = true;
            try
            {
                await JS.InvokeVoidAsync("window.monitoringProgressiveChart.initAndLoad", "dpc-chart-root", _data, MonitoringConnectionId);
            }
            catch (Exception ex)
            {
                _dataRendered = false;
                _error = "خطا در راه‌اندازی چارت: " + ex.Message;
                StateHasChanged();
            }
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        _error = null;
        _needsChartInit = false;
        _dataRendered = false;
        StateHasChanged();

        try
        {
            var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var data = await Http
                .GetFromJsonAsync<MonitoringChartResponse>(
                    $"api/monitoring/chart/{MonitoringConnectionId}/progressive-records?maxPoints=1200")
                .WaitAsync(cts.Token);

            if (data == null)
            {
                _error = "داده‌ای یافت نشد";
                return;
            }

            _data = data;
            _dataCount = data.TotalCount > 0 ? data.TotalCount : (data.Labels?.Count ?? 0);
            _pageTitle = $"چارت با جزییات - {data.ConnectionInfo?.DeviceName ?? "اتصال " + MonitoringConnectionId}";
            _needsChartInit = true;
        }
        catch (OperationCanceledException)
        {
            _error = "دریافت اطلاعات زمان‌بر شد. لطفاً دوباره تلاش کنید.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ResetZoom()
    {
        await JS.InvokeVoidAsync("resetProgressiveChartZoom");
    }

    private async Task GoBack()
    {
        if (IsOverlay)
        {
            await OnOverlayClose.InvokeAsync();
            return;
        }

        Navigation.NavigateTo("/admin/monitoring/details?Id=" + MonitoringConnectionId);
    }

    public void Dispose()
    {
        try { _ = JS.InvokeVoidAsync("window.monitoringProgressiveChart.setLiveMode", false); } catch { }
        if (!IsOverlay)
        {
            try { _ = JS.InvokeVoidAsync("dpcClearBodyClass"); } catch { }
        }
    }
}
