@code {
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private bool isSuperAdmin;
    private bool canEditOwn;
    private bool canManageStaff;

    private enum WorkshopPageTab
    {
        Register,
        Manage
    }

    private WorkshopPageTab activeTab = WorkshopPageTab.Register;
    private ElementReference pageTopRef;

    private List<WorkshopDto>? items;
    private List<ProvinceDto>? provinces;
    private List<CityDto>? cities;
    private List<RoleDto>? availableRoles;

    private Dictionary<string, string> roleTitleMap = new();

    private WorkshopUpsertRequest model = new();
    private int editingId;
    private bool isSaving;
    private bool isUploadingLogo;

    private WorkshopDto? itemToDelete;
    private bool showConfirm;

    private WorkshopUserDto? userToDelete;
    private bool showUserConfirm;
    private WorkshopDto? userToDeleteWorkshop;

    private string userConfirmTitle = "حذف پرسنل";
    private string userConfirmMessage = "";
    private bool userHasTransactionalRefs = false;

    // Workshop User Management State
    private HashSet<int> expandedIds = new();
    private Dictionary<int, List<WorkshopUserDto>> workshopUsersMap = new();
    private bool showUserModal;
    private bool isSavingUser;
    private WorkshopDto? targetWorkshop;
    private WorkshopUserUpsertRequest userRequest = new();
    private int editingUserId = 0;
    private string? newPassword;
    private string? confirmPassword;
    private bool showNewPassword;

    private IEnumerable<RoleDto> RolesForTargetWorkshop =>
        (availableRoles ?? new List<RoleDto>())
            .Where(r => r.WorkshopId == null || r.WorkshopId == targetWorkshop?.Id)
            .OrderBy(r => r.TitleFa);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        isSuperAdmin = user.IsInRole("super_admin");
        canEditOwn = user.HasClaim("perm", "admin.workshops.editown");
        canManageStaff = user.HasClaim("perm", "workshop.users.manage");

        if (!isSuperAdmin && !canEditOwn && !canManageStaff)
        {
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        await LoadProvinces();
        await Load();
        await LoadRoles();
        if (!isSuperAdmin) activeTab = WorkshopPageTab.Manage;
        ResetForm();
    }

    private async Task LoadRoles()
    {
        try
        {
            var resp = await Http.GetAsync("api/roles");
            if (resp.IsSuccessStatusCode)
            {
                availableRoles = await resp.Content.ReadFromJsonAsync<List<RoleDto>>();
                roleTitleMap = (availableRoles ?? new List<RoleDto>())
                    .Where(x => !string.IsNullOrWhiteSpace(x.Key) && !string.IsNullOrWhiteSpace(x.TitleFa))
                    .GroupBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
                    .ToDictionary(g => g.Key, g => g.First().TitleFa, StringComparer.OrdinalIgnoreCase);
            }
        }
        catch { }
    }

    private string GetRoleTitle(string key)
    {
        if (string.IsNullOrWhiteSpace(key)) return string.Empty;
        return roleTitleMap.TryGetValue(key, out var title) ? title : key;
    }

    private async Task LoadProvinces()
    {
        provinces = await Http.GetFromJsonAsync<List<ProvinceDto>>("api/locations/provinces");
    }

    private async Task LoadCities(int provinceId)
    {
        if (provinceId <= 0)
        {
            cities = new List<CityDto>();
            return;
        }

        cities = await Http.GetFromJsonAsync<List<CityDto>>($"api/locations/cities/{provinceId}");
    }

    private async Task Load() => items = await Http.GetFromJsonAsync<List<WorkshopDto>>("api/workshops");

    private async Task OnProvinceChanged(int provinceId)
    {
        model.ProvinceId = provinceId;
        model.CityId = 0;
        cities = new List<CityDto>();
        await LoadCities(provinceId);
        if (cities != null && cities.Any())
        {
            model.CityId = cities.First().Id;
        }
        StateHasChanged();
    }

    private Task OnCityChanged(int cityId)
    {
        model.CityId = cityId;
        return Task.CompletedTask;
    }

    private void SetActiveTab(WorkshopPageTab tab) => activeTab = tab;

    private async Task ScrollToPageTopAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "window.scrollTo({ top: 0, behavior: 'smooth' });");
            await JS.InvokeVoidAsync("eval", "document.getElementById('workshops-page-top')?.scrollIntoView({ behavior: 'smooth', block: 'start' });");
        }
        catch
        {
            // ignore scroll errors (prerender / disconnected circuit)
        }
    }

    private async Task StartNewWorkshop()
    {
        ResetForm();
        activeTab = WorkshopPageTab.Register;
        await ScrollToPageTopAsync();
    }

    private void ResetForm()
    {
        editingId = 0;
        model = new WorkshopUpsertRequest
        {
            ProvinceId = provinces?.FirstOrDefault()?.Id ?? 0,
            CityId = 0,
            IsActive = true,
            ShowInCustomersRow = false,
            MaxMonitoringConnections = 2,
            ImageUrl = null
        };
        _ = LoadCities(model.ProvinceId);
    }

    private async Task Edit(WorkshopDto dto)
    {
        activeTab = WorkshopPageTab.Register;
        editingId = dto.Id;
        model = new WorkshopUpsertRequest
        {
            WorkshopName = dto.WorkshopName,
            OwnerFullName = dto.OwnerFullName,
            MobileNumber = dto.MobileNumber,
            ProvinceId = dto.ProvinceId,
            CityId = dto.CityId,
            Address = dto.Address,
            IsActive = dto.IsActive,
            ImageUrl = dto.ImageUrl,
            ShowInCustomersRow = dto.ShowInCustomersRow,
            MaxMonitoringConnections = dto.MaxMonitoringConnections
        };
        await LoadCities(model.ProvinceId);
        await InvokeAsync(StateHasChanged);
        await ScrollToPageTopAsync();
    }

    private async Task HandleLogoFile(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        if (file.Size > 5_000_000)
        {
            ToastService.ShowError("حجم فایل زیاد است (حداکثر ۵ مگابایت)");
            return;
        }

        isUploadingLogo = true;
        try
        {
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            using var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var resp = await Http.PostAsync("api/workshops/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                var url = (await resp.Content.ReadAsStringAsync()).Trim().Trim('"');
                model.ImageUrl = url;
                ToastService.ShowSuccess("تصویر آپلود شد");
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا در آپلود" : body.Trim('"'));
            }
        }
        catch
        {
            ToastService.ShowError("خطای سیستمی در آپلود");
        }
        finally
        {
            isUploadingLogo = false;
        }
    }

    private void RemoveLogo()
    {
        model.ImageUrl = null;
    }

    private async Task Save()
    {
        isSaving = true;
        try
        {
            HttpResponseMessage resp;
            if (editingId == 0)
                resp = await Http.PostAsJsonAsync("api/workshops", model);
            else
                resp = await Http.PutAsJsonAsync($"api/workshops/{editingId}", model);

            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(editingId == 0 ? "کارگاه ایجاد شد" : "تغییرات ذخیره شد");
                await Load();
                ResetForm();
                activeTab = WorkshopPageTab.Manage;
                await ScrollToPageTopAsync();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا در ذخیره" : body.Trim('"'));
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void AskDelete(WorkshopDto dto)
    {
        itemToDelete = dto;
        showConfirm = true;
    }

    private async Task HandleDeleteResult(bool ok)
    {
        showConfirm = false;
        if (!ok || itemToDelete == null) return;

        var resp = await Http.DeleteAsync($"api/workshops/{itemToDelete.Id}");
        if (resp.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess("حذف شد");
            await Load();
            ResetForm();
        }
        else
        {
            var body = await resp.Content.ReadAsStringAsync();
            ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "حذف ناموفق" : body.Trim('"'));
        }
    }

    private void AskDeleteUser(WorkshopUserDto user, WorkshopDto ws)
    {
        _ = AskDeleteUserAsync(user, ws);
    }

    private async Task AskDeleteUserAsync(WorkshopUserDto user, WorkshopDto ws)
    {
        userToDelete = user;
        userToDeleteWorkshop = ws;

        userConfirmTitle = "حذف پرسنل";
        userConfirmMessage = $"آیا از حذف پرسنل \"{user.FullName}\" اطمینان دارید؟";
        userHasTransactionalRefs = false;

        try
        {
            var check = await Http.GetFromJsonAsync<DeleteCheckResponse>($"api/workshop-auth/users/{user.Id}/delete-check");
            if (check != null && check.HasTransactionalRefs)
            {
                userHasTransactionalRefs = true;
                userConfirmMessage = $"آیا از حذف پرسنل \"{user.FullName}\" اطمینان دارید؟";
            }
        }
        catch
        {
            // If delete-check fails, assume no refs
        }

        showUserConfirm = true;
    }

    private async Task HandleUserDeleteResult(bool ok)
    {
        showUserConfirm = false;
        if (!ok || userToDelete == null) return;

        var url = userHasTransactionalRefs
            ? $"api/workshop-auth/users/{userToDelete.Id}?force=true"
            : $"api/workshop-auth/users/{userToDelete.Id}";
        var resp = await Http.DeleteAsync(url);

        if (resp.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess("پرسنل حذف شد");
            if (userToDeleteWorkshop != null) await LoadWorkshopUsers(userToDeleteWorkshop.Id);
        }
        else
        {
            var body = await resp.Content.ReadAsStringAsync();
            ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "عملیات ناموفق" : body.Trim('"'));
        }
    }

    private async Task HandleUserDeactivate()
    {
        showUserConfirm = false;
        if (userToDelete == null) return;

        var resp = await Http.PutAsync($"api/workshop-auth/users/{userToDelete.Id}/deactivate", content: null);

        if (resp.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess("پرسنل غیرفعال شد");
            if (userToDeleteWorkshop != null) await LoadWorkshopUsers(userToDeleteWorkshop.Id);
        }
        else
        {
            var body = await resp.Content.ReadAsStringAsync();
            ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "عملیات ناموفق" : body.Trim('"'));
        }
    }

    private sealed class DeleteCheckResponse
    {
        public bool CanHardDelete { get; set; }
        public bool HasTransactionalRefs { get; set; }
    }

    private async Task ToggleStatus(WorkshopDto dto)
    {
        var resp = await Http.PatchAsync($"api/workshops/{dto.Id}/toggle-status", content: null);
        if (resp.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess("وضعیت بروزرسانی شد");
            await Load();
        }
        else
        {
            ToastService.ShowError("خطا در بروزرسانی وضعیت");
        }
    }

    // Workshop User Logic
    private async Task ToggleDetails(int id)
    {
        if (expandedIds.Contains(id))
        {
            expandedIds.Remove(id);
        }
        else
        {
            expandedIds.Add(id);
            await LoadWorkshopUsers(id);
        }
    }

    private async Task LoadWorkshopUsers(int workshopId)
    {
        try
        {
            var users = await Http.GetFromJsonAsync<List<WorkshopUserDto>>($"api/workshop-auth/users?workshopId={workshopId}");
            if (users != null)
            {
                workshopUsersMap[workshopId] = users;
            }
        }
        catch { }
    }

    private static string GetStaffInitial(WorkshopUserDto u)
    {
        var name = (u.FullName ?? string.Empty).Trim();
        return string.IsNullOrEmpty(name) ? "?" : name[0].ToString();
    }

    private string GetStaffInitialFromRequest()
    {
        var name = (userRequest.FullName ?? string.Empty).Trim();
        return string.IsNullOrEmpty(name) ? "?" : name[0].ToString();
    }

    private void ResetUserPasswordFields()
    {
        newPassword = null;
        confirmPassword = null;
        showNewPassword = false;
    }

    private void OpenAddUserModal(WorkshopDto ws)
    {
        targetWorkshop = ws;
        userRequest = new WorkshopUserUpsertRequest { WorkshopId = ws.Id, IsActive = true, IsTechnician = false };
        editingUserId = 0;
        ResetUserPasswordFields();
        showUserModal = true;
    }

    private void EditUser(WorkshopUserDto user, WorkshopDto ws)
    {
        targetWorkshop = ws;
        editingUserId = user.Id;
        userRequest = new WorkshopUserUpsertRequest
        {
            WorkshopId = user.WorkshopId,
            FullName = user.FullName,
            PhoneNumber = user.PhoneNumber,
            IsActive = user.IsActive,
            IsTechnician = user.IsTechnician,
            RoleKeys = new List<string>(user.RoleKeys)
        };
        ResetUserPasswordFields();
        showUserModal = true;
    }

    private void CloseUserModal()
    {
        showUserModal = false;
        isSavingUser = false;
        ResetUserPasswordFields();
    }

    private void AskDeleteCurrentEditingUser()
    {
        if (targetWorkshop == null || editingUserId <= 0) return;
        var user = workshopUsersMap.GetValueOrDefault(targetWorkshop.Id)?.FirstOrDefault(x => x.Id == editingUserId);
        if (user != null)
        {
            CloseUserModal();
            AskDeleteUser(user, targetWorkshop);
        }
    }

    private async Task ToggleUserStatusInList(WorkshopUserDto user, WorkshopDto ws)
    {
        try
        {
            var resp = await Http.PutAsync($"api/workshop-auth/users/{user.Id}/toggle-status", content: null);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(user.IsActive ? "پرسنل غیرفعال شد" : "پرسنل فعال شد");
                await LoadWorkshopUsers(ws.Id);
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا در تغییر وضعیت" : body.Trim('"'));
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا: {ex.Message}");
        }
    }

    private void ToggleUserRole(string key, bool isChecked)
    {
        if (isChecked) { if (!userRequest.RoleKeys.Contains(key)) userRequest.RoleKeys.Add(key); }
        else { userRequest.RoleKeys.Remove(key); }
    }

    private async Task SaveUser()
    {
        if (isSavingUser) return;

        if (editingUserId == 0)
        {
            if (editingUserId == 0 && string.IsNullOrWhiteSpace(newPassword))
            {
                ToastService.ShowError("رمز عبور اولیه باید حداقل ۴ کاراکتر باشد");
                return;
            }
            userRequest.Password = newPassword.Trim();
        }
        else if (!string.IsNullOrWhiteSpace(newPassword))
        {
            if (newPassword.Trim().Length < 4)
            {
                ToastService.ShowError("رمز جدید باید حداقل ۴ کاراکتر باشد");
                return;
            }
            userRequest.Password = newPassword.Trim();
        }
        else
        {
            userRequest.Password = null;
        }

        isSavingUser = true;
        try
        {
            HttpResponseMessage resp;
            if (editingUserId == 0)
                resp = await Http.PostAsJsonAsync("api/workshop-auth/users", userRequest);
            else
                resp = await Http.PutAsJsonAsync($"api/workshop-auth/users/{editingUserId}", userRequest);

            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(editingUserId == 0 ? "پرسنل اضافه شد" : "اطلاعات پرسنل ذخیره شد");
                if (targetWorkshop != null) await LoadWorkshopUsers(targetWorkshop.Id);
                CloseUserModal();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(body) ? "خطا در ذخیره کاربر" : body.Trim('"'));
            }
        }
        finally { isSavingUser = false; }
    }
}
