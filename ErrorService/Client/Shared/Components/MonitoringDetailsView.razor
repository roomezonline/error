    /* Alert card */
    .md-alert-card {
        background: rgba(255,255,255,0.95);
        border: 1px solid rgba(0,0,0,0.04);
        border-radius: 16px; overflow: hidden;
        transition: all 0.2s;
        box-shadow: 0 2px 8px rgba(0,0,0,0.03);
