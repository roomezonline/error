                                CooldownUntil = m.TryGetProperty("cooldownUntil", out var mcu) && mcu.ValueKind == JsonValueKind.String
                                    ? DateTime.TryParse(mcu.GetString(), out var mdt) ? mdt : null : null,
                                LastError = m.TryGetProperty("lastError", out var mle) ? mle.GetString() : null,
                                SuccessCount = m.TryGetProperty("successCount", out var msc) && msc.ValueKind == JsonValueKind.Number ? msc.GetInt64() : 0,
                                FailureCount = m.TryGetProperty("failureCount", out var mfc) && mfc.ValueKind == JsonValueKind.Number ? mfc.GetInt64() : 0
                            });
                    list.Add(ui);
                }
            }
            _aiProviders = list;
            _aiProvidersLoaded = true;
        }
        catch { }
        _aiProvidersLoading = false;
        StateHasChanged();
    }

