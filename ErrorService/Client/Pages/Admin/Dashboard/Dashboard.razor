    @if (IsSuperAdmin)
    {
    <!-- Recent Activity Section -->
    <div class="dash-section mt-5">
        <div class="d-flex justify-content-between align-items-center mb-4 px-2">
            <h5 class="fw-black mb-0">گزارش وضعیت سیستم</h5>
            <a href="/admin/logs" class="text-primary small fw-bold text-decoration-none">مشاهده همه رویدادها</a>
        </div>

        @if (healthSummary == null)
        {
            <div class="card border-0 shadow-sm rounded-5 p-4 bg-white text-center">
                <div class="spinner-border text-primary spinner-border-sm mb-2"></div>
                <p class="text-muted small mb-0">در حال تحلیل وضعیت سلامت سیستم...</p>
            </div>
        }
        else
        {
            <div class="row g-3">
                <div class="col-12">
                    @if (healthSummary.UnresolvedErrors > 0)
                    {
                        <div class="card border-0 shadow-sm rounded-5 p-4 bg-white border-start border-danger border-5">
                            <div class="d-flex align-items-center gap-3">
                                <div class="display-6 text-danger"><span class="oi oi-warning"></span></div>
                                <div>
                                    <h6 class="fw-bold mb-1">سیستم نیاز به توجه دارد!</h6>
                                    <p class="text-muted small mb-0">تعداد @healthSummary.UnresolvedErrors خطای حل نشده شناسایی شده است.</p>
                                </div>
                                <div class="ms-auto">
                                    <a href="/admin/logs?onlyUnresolved=true" class="btn btn-danger btn-sm rounded-pill px-3">بررسی فوری</a>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="card border-0 shadow-sm rounded-5 p-4 bg-white text-center border-start border-success border-5">
                            <div class="display-6 text-success mb-2"><span class="oi oi-circle-check"></span></div>
                            <h6 class="fw-bold mb-1">وضعیت سبز: همه چیز مرتب است</h6>
                            <p class="text-muted small mb-0">در ۲۴ ساعت گذشته هیچ خطای بحرانی حل نشده‌ای ثبت نشده است.</p>
                        </div>
                    }
                </div>

                <!-- Health Cards -->
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 text-center">
                        <div class="text-muted x-small fw-bold mb-1">رویدادهای ۲۴ ساعت</div>
                        <div class="h4 fw-black m-0 text-primary">@healthSummary.TotalEvents24h</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 text-center">
                        <div class="text-muted x-small fw-bold mb-1">خطاهای بحرانی</div>
                        <div class="h4 fw-black m-0 @(healthSummary.CriticalErrors24h > 0 ? "text-danger" : "text-success")">@healthSummary.CriticalErrors24h</div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 text-center">
                        <div class="text-muted x-small fw-bold mb-1">سرعت پاسخ‌دهی</div>
                        <div class="h4 fw-black m-0 text-info">@((int)healthSummary.AvgResponseTime) <small class="x-small">ms</small></div>
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100 text-center">
                        <div class="text-muted x-small fw-bold mb-1">نرخ خطا (API)</div>
                        <div class="h4 fw-black m-0 @(healthSummary.ErrorRate > 5 ? "text-danger" : "text-success")">@healthSummary.ErrorRate%</div>
                    </div>
                </div>

                @if (healthSummary.TopErrors.Any())
                {
                    <div class="col-12 mt-2">
                        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                            <div class="small fw-bold text-muted mb-3">پرتکرارترین خطاها (۲۴ ساعت اخیر)</div>
                            <div class="list-group list-group-flush">
                                @foreach (var err in healthSummary.TopErrors)
                                {
                                    <div class="list-group-item px-0 py-2 border-0 d-flex justify-content-between align-items-center">
                                        <div class="overflow-hidden">
                                            <div class="fw-bold small text-truncate">@err.PersianTitle</div>
                                            <div class="x-small text-muted font-monospace">@err.ErrorCode</div>
                                        </div>
                                        <span class="badge bg-light text-dark rounded-pill">@err.Count بار</span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
    }

    <!-- Version Badge -->
    @if (!string.IsNullOrEmpty(currentVersion))
    {
        <div class="version-badge-container">
            <a href="/admin/release-history" class="version-badge">
                <span class="oi oi-tag"></span>
                <span>نسخه @currentVersion</span>
            </a>
        </div>
    }
</div>

<style>
    .fw-black { font-weight: 900; }

    .dash-wrapper {
        padding-bottom: 20px;
    }

    /* Stats Grid */
    .stats-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid rgba(0,0,0,0.04);
        border-radius: 20px;
        transition: all 0.25s ease;
    }
    .stat-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 28px rgba(0,0,0,0.08) !important;
    }


    .stat-icon-bg {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.4rem;
    }

    .stat-value { font-size: 1.25rem; line-height: 1; margin-bottom: 4px; }
    .stat-label { font-size: 0.75rem; color: #64748b; font-weight: 700; }

    /* Apps Grid (Android Style) */
    .apps-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
    }

    .apps-sections { display: grid; gap: 18px; }
    .apps-section {
        border-radius: 22px;
