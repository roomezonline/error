    private static string DateSeparatorText(DateTime dt)
    {
        var local = dt.ToLocalTime();
        if (local.Date == DateTime.Today) return "امروز";
        if (local.Date == DateTime.Today.AddDays(-1)) return "دیروز";
        return local.ToString("yyyy/MM/dd");
    }

    private static readonly System.Text.RegularExpressions.Regex UrlRegex =
        new(@"https?://[^\s<>""']+", System.Text.RegularExpressions.RegexOptions.Compiled);

    private static string ApplyMarkdown(string s)
    {
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(?m)^\s*#{1,6}\s+(.+?)\s*$", "<strong>$1</strong>");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(?m)^\s*[-+]\s+", "• ");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"\*\*(?!\s)([^*\n]+?)(?<!\s)\*\*", "<strong>$1</strong>");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(?<![*\w])\*(?!\s)([^*\n]+?)(?<!\s)\*(?![*\w])", "<em>$1</em>");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"(?<![\w])_(?!\s)([^_\n]+?)(?<!\s)_(?![\w])", "<em>$1</em>");
        s = System.Text.RegularExpressions.Regex.Replace(s, @"`([^`\n]+)`", "<code>$1</code>");
        return s;
    }

    private static string RenderMsgHtml(string? content)
    {
        if (string.IsNullOrWhiteSpace(content)) return "";

        var urls = new System.Collections.Generic.List<string>();
        var src = UrlRegex.Replace(content, m =>
        {
            urls.Add(m.Value);
            return "zzchaturl" + (urls.Count - 1) + "zz";
        });

        var s = ApplyMarkdown(System.Net.WebUtility.HtmlEncode(src));

        if (urls.Count > 0)
        {
            s = System.Text.RegularExpressions.Regex.Replace(s, @"zzchaturl(\d+)zz", m =>
            {
                if (!int.TryParse(m.Groups[1].Value, out var i) || i < 0 || i >= urls.Count) return "";
                var u = System.Net.WebUtility.HtmlEncode(urls[i]);
                return "<a href=\"" + u + "\" target=\"_blank\" rel=\"noopener noreferrer\" style=\"color:inherit;text-decoration:underline;word-break:break-all;\">" + u + "</a>";
            });
        }

        return s;
    }

