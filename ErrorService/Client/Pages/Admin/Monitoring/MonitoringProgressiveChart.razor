@page "/admin/monitoring/progressive-chart/{MonitoringConnectionId:int}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.monitoring.view")]
@using System.Net.Http.Json
@using ErrorService.Shared
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>@_pageTitle</PageTitle>

<div class="dpc-page" dir="ltr">
    <div class="dpc-header">
        <button class="dpc-back" @onclick="GoBack" title="بازگشت">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <div class="dpc-title-group">
            <div class="dpc-kicker">Progressive Detail Chart</div>
            <div class="dpc-title">@_pageTitle</div>
        </div>
        <div class="dpc-header-actions">
            <span class="dpc-badge" id="dpc-zoom-info">@_dataCount records</span>
            <span class="dpc-badge dpc-badge--zoom" id="dpc-zoom-pct">100%</span>
        </div>
    </div>

    @if (_loading)
    {
        <div class="dpc-skeleton">
            <div class="dpc-skel-legend"><span></span><span></span><span></span><span></span><span></span><span></span></div>
            <div class="dpc-skel-chart"><span></span></div>
        </div>
    }
    else if (_error != null)
    {
        <div class="dpc-error">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <h3>خطا در دریافت اطلاعات</h3>
            <p>@_error</p>
            <button class="dpc-retry-btn" @onclick="LoadData">تلاش مجدد</button>
        </div>
    }
    else if (_data != null)
    {
        @* Loading indicator *@
        <div class="dpc-loading" id="dpc-loading" style="display:none;">
            <div class="dpc-loading__spinner"></div>
            <span>در حال بارگذاری داده‌های دقیق‌تر…</span>
        </div>

        @* Client Info *@
        @if (_data.ConnectionInfo != null)
        {
            <div class="dpc-client" dir="rtl">
                <div class="dpc-client__row">
                    <div class="dpc-client__item">
                        <span class="dpc-client__icon dpc-client__icon--user">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </span>
                        <span class="dpc-client__value">@_data.ConnectionInfo.CustomerName</span>
                    </div>
                    <div class="dpc-client__item">
                        <span class="dpc-client__icon dpc-client__icon--phone">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                        </span>
                        <span class="dpc-client__value ltr" dir="ltr">@_data.ConnectionInfo.CustomerMobile</span>
                    </div>
                    <div class="dpc-client__item">
                        <span class="dpc-client__icon dpc-client__icon--device">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                        </span>
                        <span class="dpc-client__value">@_data.ConnectionInfo.DeviceName</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(_data.ConnectionInfo.DeviceTypeName))
                {
                    <div class="dpc-client__tags">
                        <span class="dpc-client__tag">@_data.ConnectionInfo.DeviceTypeName</span>
                        @if (!string.IsNullOrEmpty(_data.ConnectionInfo.DeviceBrandName))
                        {
                            <span class="dpc-client__tag dpc-client__tag--brand">@_data.ConnectionInfo.DeviceBrandName</span>
                        }
                    </div>
                }
            </div>
        }

        @* Controls *@
        <div class="dpc-controls">
            <button class="dpc-btn" @onclick="ResetZoom" title="بازگشت به نمای کلی">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                نمای کلی
            </button>
            <div class="dpc-hint">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                اسکرول برای زوم · کشیدن برای پیمایش
            </div>
        </div>

        @* Legend + Equipment Navigation *@
        <div class="dpc-legend" id="dpc-legend">
            @* Temperature (always visible, no nav) *@
            <button class="dpc-legend-item" type="button" data-ds-idx="0" style="--dpc-c:#0ea5e9">یخچال</button>
            <button class="dpc-legend-item" type="button" data-ds-idx="1" style="--dpc-c:#e11d48">فریزر</button>
            @* Equipment: toggle + prev + next *@
            <span class="dpc-eq-set" data-eq-ds="2">
                <button class="dpc-legend-item dpc-legend-item--off double-toggle" type="button" data-ds-idx="2" style="--dpc-c:#eab308" title="نمایش/مخفی کردن برق">برق</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--prev" data-dir="prev" title="انتقال به قبلی">−</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--next" data-dir="next" title="انتقال به بعدی">+</button>
            </span>
            <span class="dpc-eq-set" data-eq-ds="3">
                <button class="dpc-legend-item double-toggle" type="button" data-ds-idx="3" style="--dpc-c:#10b981" title="نمایش/مخفی کردن موتور">موتور</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--prev" data-dir="prev" title="انتقال به قبلی">−</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--next" data-dir="next" title="انتقال به بعدی">+</button>
            </span>
            <span class="dpc-eq-set" data-eq-ds="4">
                <button class="dpc-legend-item dpc-legend-item--off double-toggle" type="button" data-ds-idx="4" style="--dpc-c:#f97316" title="نمایش/مخفی کردن المنت ۱">المنت ۱</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--prev" data-dir="prev" title="انتقال به قبلی">−</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--next" data-dir="next" title="انتقال به بعدی">+</button>
            </span>
            <span class="dpc-eq-set" data-eq-ds="5">
                <button class="dpc-legend-item dpc-legend-item--off double-toggle" type="button" data-ds-idx="5" style="--dpc-c:#ef4444" title="نمایش/مخفی کردن المنت ۲">المنت ۲</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--prev" data-dir="prev" title="انتقال به قبلی">−</button>
                <button class="dpc-eq-nav-btn dpc-eq-nav--next" data-dir="next" title="انتقال به بعدی">+</button>
            </span>
            @* Power items (no nav) *@
            <button class="dpc-legend-item dpc-legend-item--off" type="button" data-ds-idx="6" style="--dpc-c:#8b5cf6">توان</button>
            <button class="dpc-legend-item dpc-legend-item--off" type="button" data-ds-idx="7" style="--dpc-c:#14b8a6">جریان</button>
        </div>

        @* Chart - JS builds everything inside this container *@
        <div id="dpc-chart-root"></div>
    }
</div>

<style>
    .dpc-page {
        background: #f8fafc; min-height: 100vh; display: flex; flex-direction: column;
        font-family: Vazirmatn, sans-serif; direction: ltr;
        max-width: 100%; overflow-x: hidden;
    }
    .dpc-page > * { min-width: 0; }
    .dpc-header {
        display: flex; align-items: center; gap: 12px;
        padding: 14px 20px; background: #fff; border-bottom: 1px solid #e2e8f0;
        position: sticky; top: 0; z-index: 10;
    }
    .dpc-back {
        width: 36px; height: 36px; border-radius: 10px; border: 1px solid #e2e8f0;
        background: #fff; display: grid; place-items: center; cursor: pointer;
        color: #475569; flex-shrink: 0;
    }
    .dpc-back:hover { background: #f1f5f9; }
    .dpc-title-group { flex: 1; min-width: 0; }
    .dpc-kicker { font-size: 11px; color: #94a3b8; font-weight: 700; letter-spacing: 0.3px; }
    .dpc-title { font-size: 17px; font-weight: 800; color: #0f172a; }
    .dpc-header-actions { display: flex; gap: 8px; align-items: center; }
    .dpc-badge {
        font-size: 12px; font-weight: 800; color: #475569;
        background: #f1f5f9; padding: 4px 12px; border-radius: 20px;
        white-space: nowrap;
    }
    .dpc-badge--zoom { background: #eef2ff; color: #4f46e5; }

    .dpc-skeleton { padding: 20px; }
    .dpc-skel-legend { display: flex; gap: 8px; margin-bottom: 14px; }
    .dpc-skel-legend span {
        width: 56px; height: 32px; border-radius: 10px; background: #e2e8f0; animation: dpc-shimmer 1.5s infinite;
    }
    .dpc-skel-chart span {
        display: block; height: 400px; border-radius: 16px; background: #e2e8f0; animation: dpc-shimmer 1.5s infinite;
    }
    @@keyframes dpc-shimmer {
        0% { opacity: 0.6; } 50% { opacity: 1; } 100% { opacity: 0.6; }
    }

    .dpc-error {
        text-align: center; padding: 60px 20px; color: #475569; direction: rtl;
    }
    .dpc-error h3 { margin: 16px 0 8px; font-size: 18px; }
    .dpc-error p { font-size: 14px; color: #94a3b8; margin-bottom: 20px; }
    .dpc-retry-btn {
        padding: 10px 28px; border: none; border-radius: 12px; background: #2563eb;
        color: #fff; font-weight: 800; cursor: pointer; font-size: 14px;
    }

    .dpc-loading {
        display: flex; align-items: center; justify-content: center; gap: 10px;
        padding: 10px; background: #fffbeb; border-bottom: 1px solid #fde68a;
        font-size: 13px; font-weight: 700; color: #92400e; direction: rtl;
    }
    .dpc-loading__spinner {
        width: 18px; height: 18px; border: 2.5px solid #fbbf24;
        border-top-color: #d97706; border-radius: 50%; animation: dpc-spin 0.7s linear infinite;
    }
    @@keyframes dpc-spin { to { transform: rotate(360deg); } }

    .dpc-client {
        margin: 12px 20px 0; background: #fff; border-radius: 14px;
        padding: 14px 18px; border: 1px solid #e2e8f0;
    }
    .dpc-client__row { display: flex; flex-wrap: wrap; gap: 12px 20px; }
    .dpc-client__item { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #334155; font-weight: 700; }
    .dpc-client__icon {
        width: 26px; height: 26px; border-radius: 8px; display: grid; place-items: center; flex-shrink: 0;
    }
    .dpc-client__icon--user { background: #dbeafe; color: #2563eb; }
    .dpc-client__icon--phone { background: #dcfce7; color: #16a34a; }
    .dpc-client__icon--device { background: #f3e8ff; color: #9333ea; }
    .dpc-client__value { direction: rtl; }
    .dpc-client__tags { display: flex; gap: 6px; margin-top: 10px; }
    .dpc-client__tag {
        font-size: 11px; font-weight: 800; padding: 3px 10px; border-radius: 8px;
        background: #f1f5f9; color: #475569;
    }
    .dpc-client__tag--brand { background: #fff7ed; color: #c2410c; }

    .dpc-controls {
        display: flex; align-items: center; gap: 12px;
        padding: 10px 20px; direction: rtl;
    }
    .dpc-btn {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 6px 14px; border: 1px solid #e2e8f0; border-radius: 10px;
        background: #fff; font-size: 12px; font-weight: 800; color: #475569;
        cursor: pointer; font-family: Vazirmatn, sans-serif;
    }
    .dpc-btn:hover { background: #f1f5f9; }
    .dpc-hint {
        font-size: 11px; color: #94a3b8; display: flex; align-items: center; gap: 4px;
    }

    .dpc-legend {
        display: flex; flex-wrap: wrap; gap: 8px;
        padding: 8px 20px; direction: rtl;
    }
    .dpc-legend-item {
        padding: 6px 14px; border-radius: 10px; border: 1.5px solid var(--dpc-c);
        background: var(--dpc-c); color: #fff; font-weight: 800; font-size: 12px;
        cursor: pointer; transition: all 0.15s; font-family: Vazirmatn, sans-serif;
    }
    .dpc-legend-item:hover { filter: brightness(0.92); }
    .dpc-legend-item--off {
        background: #fff; color: var(--dpc-c); border-color: #e2e8f0;
        --dpc-bg: #fff;
    }
    .dpc-legend-item--off:hover { background: #f8fafc; filter: none; }

    .dpc-eq-set {
        display: inline-flex; align-items: center; gap: 3px;
        border: 1px solid #e2e8f0; border-radius: 12px; padding: 2px;
        background: #fff;
    }
    .dpc-eq-set .dpc-legend-item {
        border-radius: 10px 0 0 10px; border: none; padding: 6px 10px;
    }
    .dpc-eq-set .dpc-legend-item--off { background: #fff; }
    .dpc-eq-nav-btn {
        width: 30px; height: 30px; border-radius: 8px; border: none;
        background: transparent; cursor: pointer; display: inline-flex;
        align-items: center; justify-content: center; font-size: 17px; font-weight: 800;
        line-height: 1; padding: 0; font-family: inherit;
        touch-action: manipulation; -webkit-tap-highlight-color: transparent;
        transition: background 0.1s, transform 0.1s;
    }
    .dpc-eq-nav--prev { color: #94a3b8; }
    .dpc-eq-nav--next { color: #94a3b8; }
    .dpc-eq-nav-btn:hover { background: #f1f5f9; color: #475569; }
    .dpc-eq-nav-btn:active { background: #e2e8f0; transform: scale(0.88); }

    #dpc-chart-root { min-width: 0; }

    body.has-dpc-page .admin-content-container {
        max-width: none !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .dpc-chart-scroll {
        overflow-x: auto; overflow-y: hidden; flex: 1; min-width: 0;
        padding: 0 0 60px 0; position: relative;
        overscroll-behavior-x: contain;
        touch-action: pan-x pinch-zoom;
        -webkit-overflow-scrolling: touch;
        will-change: scroll-position;
        /* Firefox */
        scrollbar-width: thin;
        scrollbar-color: #94a3b8 #e2e8f0;
    }
    .dpc-chart-scroll::-webkit-scrollbar { height: 6px; }
    .dpc-chart-scroll::-webkit-scrollbar-track { background: #e2e8f0; border-radius: 4px; }
    .dpc-chart-scroll::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 4px; }
    .dpc-chart-wrapper { height: 460px; position: relative; width: 100%; }
    #dpc-canvas { width: 100%; height: 100%; display: block; will-change: auto; }

    @@media (max-width: 700px) {
        .dpc-header { padding: 10px 14px; flex-wrap: wrap; }
        .dpc-title { font-size: 14px; }
        .dpc-client { margin: 8px 12px 0; padding: 10px 14px; }
        .dpc-client__row { gap: 8px; }
        .dpc-legend { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 8px 10px; }
        .dpc-legend-item { font-size: 11px; padding: 4px 8px; text-align: center; }
        .dpc-eq-set { gap: 2px; padding: 2px; }
        .dpc-eq-set .dpc-legend-item { padding: 5px 8px; font-size: 11px; }
        .dpc-eq-nav-btn { width: 34px; height: 34px; font-size: 19px; }
        .dpc-chart-scroll { padding: 0 0 40px 0; overscroll-behavior-x: contain; min-width: 0; -webkit-overflow-scrolling: touch; will-change: scroll-position; }
        .dpc-chart-wrapper { height: min(340px, calc(100vh - 380px)); }
        #dpc-canvas { will-change: auto; }
    }
</style>

<script>
    window.resetProgressiveChartZoom = function() {
        window.monitoringProgressiveChart.resetZoom();
    };

    (function() {
        // Body class for full-width layout (replaces :has() selector)
        var el = document.querySelector('.dpc-page');
        if (el) document.body.classList.add('has-dpc-page');
    })();

    document.addEventListener('keydown', function(e) {
        if (e.target.closest('input, textarea, select, [contenteditable]')) return;
        var chart = window.monitoringProgressiveChart;
        if (!chart) return;
        if (e.key === 'ArrowLeft') {
            e.preventDefault();
            chart.navPrev();
        } else if (e.key === 'ArrowRight') {
            e.preventDefault();
            chart.navNext();
        }
    });

    document.addEventListener('click', function(e) {
        var btn = e.target.closest('.dpc-legend-item[data-ds-idx]');
        if (btn) {
            var idx = parseInt(btn.getAttribute('data-ds-idx'), 10);
            var isVisible = window.monitoringProgressiveChart.toggleDataset(idx);
            btn.classList.toggle('dpc-legend-item--off', !isVisible);
            // Disable nav buttons when hidden
            var set = btn.closest('.dpc-eq-set');
            if (set) {
                set.querySelectorAll('.dpc-eq-nav-btn').forEach(function(nb) {
                    nb.style.opacity = isVisible ? '1' : '0.3';
                });
            }
            return;
        }
        var navBtn = e.target.closest('.dpc-eq-nav-btn');
        if (navBtn) {
            var set = navBtn.closest('.dpc-eq-set');
            if (!set) return;
            var ds = parseInt(set.getAttribute('data-eq-ds'), 10);
            var dir = navBtn.getAttribute('data-dir');
            // Check if dataset is visible before navigating
            if (window.monitoringProgressiveChart.isDatasetVisible) {
                if (!window.monitoringProgressiveChart.isDatasetVisible(ds)) return;
            }
            window.monitoringProgressiveChart.navToTransition(ds, dir);
        }
    });
</script>

@code {
    [Parameter] public int MonitoringConnectionId { get; set; }

    private MonitoringChartResponse? _data;
    private bool _loading = true;
    private string? _error;
    private string _pageTitle = "";
    private int _dataCount;
    private bool _needsChartInit;
    private bool _dataRendered;

    protected override bool ShouldRender()
    {
        if (_error != null) return true;
        if (_data == null) return true;
        return !_dataRendered;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsChartInit && _data != null)
        {
            _needsChartInit = false;
            _dataRendered = true;
            try
            {
                await JS.InvokeVoidAsync("window.monitoringProgressiveChart.initAndLoad", "dpc-chart-root", _data, MonitoringConnectionId);
            }
            catch (Exception ex)
            {
                _dataRendered = false;
                _error = "خطا در راه‌اندازی چارت: " + ex.Message;
                StateHasChanged();
            }
        }
    }

    private async Task LoadData()
    {
        _loading = true;
        _error = null;
        _needsChartInit = false;
        _dataRendered = false;
        StateHasChanged();

        try
        {
            var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            var data = await Http
                .GetFromJsonAsync<MonitoringChartResponse>(
                    $"api/monitoring/chart/{MonitoringConnectionId}/progressive-records?maxPoints=3000")
                .WaitAsync(cts.Token);

            if (data == null)
            {
                _error = "داده‌ای یافت نشد";
                return;
            }

            _data = data;
            _dataCount = data.Labels?.Count ?? 0;
            _pageTitle = $"چارت با جزییات - {data.ConnectionInfo?.DeviceName ?? "اتصال " + MonitoringConnectionId}";
            _needsChartInit = true;
        }
        catch (OperationCanceledException)
        {
            _error = "دریافت اطلاعات زمان‌بر شد. لطفاً دوباره تلاش کنید.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task ResetZoom()
    {
        await JS.InvokeVoidAsync("resetProgressiveChartZoom");
    }

    private void GoBack()
    {
        Navigation.NavigateTo("/admin/monitoring/details?Id=" + MonitoringConnectionId);
    }
}
