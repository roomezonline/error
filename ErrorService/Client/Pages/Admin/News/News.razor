@page "/admin/news"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.news.manage")]
@using ErrorService.Shared
@using ErrorService.Shared.Models
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using ErrorService.Client.Services
@using ErrorService.Client.Utils
@implements IDisposable
@inject IJSRuntime JS
@inject ToastService ToastService

<PageTitle>مرکز محتوا | ارورسرویس</PageTitle>

<div class="admin-container" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 page-head">
        <h3 class="admin-page-title m-0">مدیریت مرکز محتوا</h3>
        <div class="d-flex flex-wrap gap-2 page-actions">
            <a href="/admin/content-categories" class="btn btn-outline-secondary rounded-3">
                <span class="oi oi-tags me-1"></span> دسته‌بندی‌ها
            </a>
            <a href="/admin/content-tags" class="btn btn-outline-secondary rounded-3">
                <span class="oi oi-tag me-1"></span> برچسب‌ها
            </a>
            <a href="/admin/content-settings" class="btn btn-outline-secondary rounded-3">
                <span class="oi oi-cog me-1"></span> تنظیمات
            </a>
            <button class="btn btn-primary shadow-sm rounded-3" @onclick="NewNews">
                <span class="oi oi-plus me-1"></span> محتوای جدید
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 p-3 mb-3">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="content-type-tabs">
                <button type="button" class="ctab @(_typeFilter == null ? "is-active" : null)" @onclick="() => SetTypeFilter(null)">همه</button>
                @foreach (var type in ContentTypeCatalog.All)
                {
                    <button type="button" class="ctab @(_typeFilter == type ? "is-active" : null)" @onclick="() => SetTypeFilter(type)">
                        <span class="oi @ContentTypeCatalog.Icon(type) me-1"></span>@ContentTypeCatalog.PluralLabel(type)
                    </button>
                }
            </div>
            <div class="ms-auto d-flex flex-wrap gap-2 content-filters">
                <select class="form-select form-select-sm rounded-3" style="width: 160px;" @bind="_statusFilter" @bind:after="() => LoadNews()">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="published">منتشرشده</option>
                    <option value="scheduled">زمان‌بندی‌شده</option>
                    <option value="draft">پیش‌نویس</option>
                    <option value="archived">آرشیو</option>
                </select>
                <select class="form-select form-select-sm rounded-3" style="width: 180px;" @bind="_categoryFilterId" @bind:after="() => LoadNews()">
                    <option value="">همه دسته‌ها</option>
                    @foreach (var cat in CategoriesForFilter)
                    {
                        <option value="@cat.Id">@cat.Title</option>
                    }
                </select>
                <div class="input-group input-group-sm" style="width: 240px;">
                    <input type="search" class="form-control rounded-start-3" placeholder="جستجو در عنوان و برچسب…"
                           @bind="_searchQuery" @bind:event="oninput" @bind:after="OnSearchChanged" />
                    @if (!string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        <button type="button" class="btn btn-outline-secondary" @onclick="ClearSearch" title="پاک کردن">×</button>
                    }
                </div>
            </div>
        </div>
    </div>

    <ConfirmDialog IsVisible="showConfirm" 
                   Title="حذف خبر" 
                   Message=@($"آیا از حذف خبر \"{itemToDelete?.Title}\" اطمینان دارید؟")
                   OnResult="HandleDeleteResult" />

    @if (showEditor)
    {
        <div class="nw-modal-overlay" @onclick="CloseEditorIfIdle">
            <div class="nw-modal" @onclick:stopPropagation>
            <div class="nw-modal__head">
                <h5 class="m-0 fw-bold">
                    @(editingId == 0 ? "ایجاد " : "ویرایش ")@ContentTypeCatalog.Label(model.ContentType)
                </h5>
                <button class="btn-close" @onclick="CloseEditor"></button>
            </div>

            <EditForm Model="model" OnValidSubmit="SaveNews" class="nw-modal__form">
                <DataAnnotationsValidator />
                <div class="nw-modal__body">
                <div class="row g-4">
                    <div class="col-12">
                        <div class="mb-3">
                            <label class="form-label fw-bold">عنوان خبر</label>
                            <InputText @bind-Value="model.Title" class="form-control rounded-3" placeholder="عنوان جذاب انتخاب کنید..." />
                            <ValidationMessage For="@(() => model.Title)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">تاریخ و ساعت ایجاد</label>
                            <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="createdAtInput" />
                            <div class="text-muted small mt-1">در صورت خالی بودن، زمان فعلی ثبت می‌شود.</div>
                        </div>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label class="form-label fw-bold">نوع محتوا</label>
                                <InputSelect @bind-Value="model.ContentType" class="form-select rounded-3" @onchange="OnEditorTypeChanged">
                                    @foreach (var type in ContentTypeCatalog.All)
                                    {
                                        <option value="@type">@ContentTypeCatalog.PluralLabel(type)</option>
                                    }
                                </InputSelect>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-bold">دسته‌بندی</label>
                                <InputSelect @bind-Value="model.CategoryId" class="form-select rounded-3">
                                    <option value="">بدون دسته</option>
                                    @foreach (var cat in EditorCategories)
                                    {
                                        <option value="@cat.Id">@cat.Title</option>
                                    }
                                </InputSelect>
                            </div>
                        </div>
                        <div class="card bg-light border-0 rounded-4 p-3 mb-3">
                            <div class="fw-bold mb-2">زمان‌بندی انتشار</div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label small">انتشار از</label>
                                    <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="_publishAtInput" placeholder="خالی = بلافاصله" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small">آرشیو خودکار از</label>
                                    <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="_expireAtInput" placeholder="خالی = بدون انقضا" />
                                </div>
                            </div>
                            <div class="form-check form-switch mt-3">
                                <InputCheckbox @bind-Value="model.IsFeatured" class="form-check-input" id="isFeatured" />
                                <label class="form-check-label fw-bold" for="isFeatured">محتوای منتخب (نمایش ویژه)</label>
                            </div>
                            <div class="mt-2">
                                <label class="form-label small">سنجاق تا تاریخ</label>
                                <input class="form-control rounded-3" data-jdp autocomplete="off" @bind="_pinnedUntilInput" placeholder="خالی = بدون سنجاق" />
                            </div>
                        </div>
                        <div class="seo-panel mb-3">
                            <button type="button" class="seo-panel__toggle @(_seoOpen ? "is-open" : null)"
                                    @onclick="ToggleSeoPanel" aria-expanded="@(_seoOpen ? "true" : "false")">
                                <span class="seo-panel__title">
                                    <span class="oi oi-document me-2"></span>سئو و منبع (اختیاری)
                                </span>
                                <span class="seo-panel__meta">
                                    @if (!string.IsNullOrWhiteSpace(model.SourceName))
                                    {
                                        <span class="seo-panel__badge">منبع: @model.SourceName</span>
                                    }
                                    <span class="oi @(_seoOpen ? "oi-chevron-top" : "oi-chevron-bottom")"></span>
                                </span>
                            </button>
                            @if (_seoOpen)
                            {
                                <div class="seo-panel__body">
                                    <div class="mb-2">
                                        <label class="form-label small">عنوان سئو</label>
                                        <InputText @bind-Value="model.SeoTitle" class="form-control rounded-3" placeholder="خالی = عنوان اصلی" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">توضیح متا</label>
                                        <InputTextArea @bind-Value="model.SeoDescription" class="form-control rounded-3" rows="2" placeholder="خالی = خلاصه خودکار" />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label small">آدرس کانونیکال</label>
                                        <InputText @bind-Value="model.CanonicalUrl" class="form-control rounded-3" placeholder="https://…" />
                                    </div>
                                    <div class="row g-2">
                                        <div class="col-md-6">
                                            <label class="form-label small">نام منبع</label>
                                            <InputText @bind-Value="model.SourceName" class="form-control rounded-3" placeholder="مثلاً: زومیت" />
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label small">لینک منبع</label>
                                            <InputText @bind-Value="model.SourceUrl" class="form-control rounded-3" placeholder="https://…" />
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(model.SourceName) || !string.IsNullOrWhiteSpace(model.SourceUrl))
                                    {
                                        <div class="d-flex justify-content-end mt-2">
                                            <button type="button" class="btn btn-sm btn-outline-danger rounded-3" @onclick="ClearSource">
                                                <span class="oi oi-trash me-1"></span> حذف منبع
                                            </button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">خلاصه خبر (نمایش در لیست)</label>
                            <InputTextArea @bind-Value="model.Summary" class="form-control rounded-3" rows="2" placeholder="توضیح کوتاه برای جذب مخاطب..." />
                            <ValidationMessage For="@(() => model.Summary)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">نویسنده خبر</label>
                            <InputText @bind-Value="model.AuthorName" class="form-control rounded-3" placeholder="نام نویسنده..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">تگ‌ها (با کاما جدا کنید)</label>
                            <InputText @bind-Value="model.Tags" class="form-control rounded-3" placeholder="مثلاً: تکنولوژی، هوش مصنوعی، خبر" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">متن کامل خبر</label>
                            
                            <div class="news-tools">
                                <div class="news-tools__row">
                                    <span class="news-tools__label">قالب</span>
                                    <div class="news-tools__group">
                                        <button type="button" class="news-chip" data-header-btn="2" @onclick='() => ApplyHeader(2)'>تیتر</button>
                                        <button type="button" class="news-chip" data-header-btn="3" @onclick='() => ApplyHeader(3)'>زیرتیتر</button>
                                        <button type="button" class="news-chip" data-header-btn="" @onclick='() => ApplyHeader(0)'>متن معمولی</button>
                                    </div>
                                </div>

                                <div class="news-tools__row">
                                    <span class="news-tools__label">باکس</span>
                                    <div class="news-tools__group">
                                        <button type="button" class="news-chip" data-callout-btn="info" @onclick='() => ApplyCallout("info")'><span class="news-dot" style="--dot:#2563eb"></span>اطلاعات</button>
                                        <button type="button" class="news-chip" data-callout-btn="note" @onclick='() => ApplyCallout("note")'><span class="news-dot" style="--dot:#f59e0b"></span>نکته</button>
                                        <button type="button" class="news-chip" data-callout-btn="warning" @onclick='() => ApplyCallout("warning")'><span class="news-dot" style="--dot:#f97316"></span>هشدار</button>
                                        <button type="button" class="news-chip" data-callout-btn="danger" @onclick='() => ApplyCallout("danger")'><span class="news-dot" style="--dot:#ef4444"></span>فوری</button>
                                        <button type="button" class="news-chip" data-callout-btn="success" @onclick='() => ApplyCallout("success")'><span class="news-dot" style="--dot:#10b981"></span>موفقیت</button>
                                        <button type="button" class="news-chip" data-callout-btn="quote" @onclick='() => ApplyCallout("quote")'><span class="news-dot" style="--dot:#f59e0b"></span>نقل‌قول</button>
                                        <button type="button" class="news-chip news-chip--ghost" data-callout-btn="none" @onclick='() => ApplyCallout("none")'>بدون باکس</button>
                                        <button type="button" class="news-chip news-chip--cta" data-callout-btn="readmore" @onclick="OpenReadMorePicker">بیشتر مطالعه کنید</button>
                                        <button type="button" class="news-chip news-chip--ghost" @onclick="ExitBoxAndContinue">خروج از باکس</button>
                                    </div>
                                </div>

                                <div class="news-tools__row">
                                    <span class="news-tools__label">رنگ متن</span>
                                    <div class="news-tools__group">
                                        <button type="button" class="news-chip news-chip--color" @onclick='() => ApplyColor("#1d4ed8")'><span class="news-dot" style="--dot:#1d4ed8"></span>آبی</button>
                                        <button type="button" class="news-chip news-chip--color" @onclick='() => ApplyColor("#dc2626")'><span class="news-dot" style="--dot:#dc2626"></span>قرمز</button>
                                        <button type="button" class="news-chip news-chip--color" @onclick='() => ApplyColor("#047857")'><span class="news-dot" style="--dot:#047857"></span>سبز</button>
                                        <button type="button" class="news-chip news-chip--color" @onclick='() => ApplyColor("#c2410c")'><span class="news-dot" style="--dot:#c2410c"></span>نارنجی</button>
                                        <button type="button" class="news-chip news-chip--ghost" @onclick="() => ApplyColor(null)">رنگ پیش‌فرض</button>
                                    </div>
                                    <span class="news-tools__label">هایلایت</span>
                                    <div class="news-tools__group">
                                        <button type="button" class="news-chip news-chip--color" @onclick='() => ApplyHighlight("#fef08a")'><span class="news-dot" style="--dot:#fef08a"></span>زرد</button>
                                        <button type="button" class="news-chip news-chip--color" @onclick='() => ApplyHighlight("#dbeafe")'><span class="news-dot" style="--dot:#dbeafe"></span>آبی</button>
                                        <button type="button" class="news-chip news-chip--color" @onclick='() => ApplyHighlight("#dcfce7")'><span class="news-dot" style="--dot:#dcfce7"></span>سبز</button>
                                        <button type="button" class="news-chip news-chip--color" @onclick='() => ApplyHighlight("#fce7f3")'><span class="news-dot" style="--dot:#fce7f3"></span>صورتی</button>
                                        <button type="button" class="news-chip news-chip--ghost" @onclick="() => ApplyHighlight(null)">بدون هایلایت</button>
                                    </div>
                                </div>

                                <div class="news-tools__row news-tools__row--media">
                                    <label class="news-chip news-chip--media mb-0">
                                        <span class="oi oi-image me-1"></span> عکس
                                        <InputFile OnChange="HandleInlineImageUpload" class="d-none" accept="image/*" />
                                    </label>
                                    <label class="news-chip news-chip--media mb-0">
                                        <span class="oi oi-video me-1"></span> ویدیو
                                        <InputFile OnChange="HandleInlineVideoUpload" class="d-none" accept="video/*" />
                                    </label>
                                    <button type="button" class="news-chip" @onclick='InsertVideoLink'>لینک ویدیو</button>
                                    <button type="button" class="news-chip" @onclick='InsertTable'>جدول</button>
                                    <button type="button" class="news-chip" @onclick='InsertCta'><span class="oi oi-link-intact me-1"></span>دکمه لینک</button>
                                    <button type="button" class="news-chip" @onclick='InsertCaption'><span class="oi oi-text me-1"></span>زیرنویس عکس</button>
                                    <div class="news-tools__group">
                                        <span class="news-tools__label">اندازه عکس</span>
                                        <button type="button" class="news-chip" @onclick='() => ResizeSelectedImage(25)'>25%</button>
                                        <button type="button" class="news-chip" @onclick='() => ResizeSelectedImage(50)'>50%</button>
                                        <button type="button" class="news-chip" @onclick='() => ResizeSelectedImage(75)'>75%</button>
                                        <button type="button" class="news-chip" @onclick='() => ResizeSelectedImage(100)'>100%</button>
                                    </div>
                                </div>
                            </div>
                            <div id="quill-editor-container" style="min-height: 400px; background: white;"></div>
                            <ValidationMessage For="@(() => model.Content)" class="text-danger small" />
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-4">
                            <label class="form-label fw-bold">تصویر شاخص</label>
                            <div class="image-upload-zone rounded-4 border-2 border-dashed d-flex flex-column align-items-center justify-content-center p-4 bg-light position-relative">
                                @if (!string.IsNullOrEmpty(model.ImageUrl))
                                {
                                    <img src="@model.ImageUrl" class="img-fluid rounded-3 mb-2" style="max-height: 200px;" />
                                    <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-2 rounded-circle shadow" @onclick="ClearImage">
                                        <span class="oi oi-x"></span>
                                    </button>
                                }
                                else
                                {
                                    <span class="oi oi-cloud-upload display-4 text-muted mb-2"></span>
                                    <InputFile OnChange="HandleFileUpload" class="position-absolute w-100 h-100 opacity-0" style="cursor: pointer; top: 0; left: 0;" />
                                    <span class="text-muted small text-center">برای انتخاب تصویر شاخص کلیک کنید</span>
                                }
                            </div>
                            @if (isUploading)
                            {
                                <div class="progress mt-2" style="height: 6px;">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                                </div>
                            }
                        </div>

                        <div class="card bg-light border-0 rounded-4 p-3">
                            <div class="form-check form-switch">
                                <InputCheckbox @bind-Value="model.IsPublished" class="form-check-input" id="isPublished" />
                                <label class="form-check-label fw-bold" for="isPublished">انتشار در سایت</label>
                            </div>
                            <div class="text-muted small mt-1">در صورت غیرفعال بودن، خبر فقط در پنل ادمین نمایش داده می‌شود.</div>
                        </div>
                    </div>
                </div>
                </div>

                <div class="news-actions mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-outline-primary rounded-3 news-actions__preview" @onclick="OpenLivePreview">
                        <span class="oi oi-eye me-1"></span> پیش‌نمایش زنده
                    </button>
                    @if (editingId != 0)
                    {
                        <a class="btn btn-outline-secondary rounded-3 news-actions__page" href="@ContentTypeCatalog.DetailRoute(model.ContentType, editingId, currentSlug)" target="_blank">
                            <span class="oi oi-external-link me-1"></span> صفحه منتشرشده
                        </a>
                    }
                    <div class="news-actions__main">
                        <button type="button" class="btn btn-light rounded-3" @onclick="CloseEditor">انصراف</button>
                        <button type="submit" class="btn btn-primary rounded-3 shadow-sm" disabled="@(isSaving || isUploading)">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            ذخیره نهایی
                        </button>
                    </div>
                </div>
            </EditForm>

            @if (_previewOpen)
            {
                <div class="nprev-overlay" @onclick="CloseLivePreview"></div>
                <div class="nprev-modal @(_previewMobile ? "is-mobile" : null)" role="dialog" aria-modal="true" aria-label="پیش‌نمایش زنده" dir="rtl">
                    <div class="nprev-head">
                        <div class="nprev-head__title"><span class="oi oi-eye me-1"></span> پیش‌نمایش زنده</div>
                        <div class="nprev-devices">
                            <button type="button" class="nprev-dev @(_previewMobile ? null : "is-active")" @onclick='() => _previewMobile = false'>دسکتاپ</button>
                            <button type="button" class="nprev-dev @(_previewMobile ? "is-active" : null)" @onclick='() => _previewMobile = true'>موبایل</button>
                        </div>
                        <button type="button" class="btn-close" @onclick="CloseLivePreview" aria-label="بستن"></button>
                    </div>
                    <div class="nprev-body">
                        <div class="nprev-canvas">
                            <div class="nd-page" dir="rtl">
                                <article class="nd-article">
                                    <h1 class="nd-title">@(string.IsNullOrWhiteSpace(model.Title) ? "عنوان پیش‌نمایش" : model.Title)</h1>
                                    @if (!string.IsNullOrWhiteSpace(model.Summary))
                                    {
                                        <div class="nd-summary">
                                            <span class="nd-summary__label">خلاصه</span>
                                            <p class="nd-summary__text">@model.Summary</p>
                                        </div>
                                    }
                                    <div class="nd-body article-content-body">
                                        @((MarkupString)HtmlSanitizer.Sanitize(_previewHtml))
                                    </div>
                                </article>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        </div>
    }

    @if (_linkPickerOpen)
    {
        <div class="lp-overlay" @onclick="CloseReadMorePicker"></div>
        <div class="lp-modal" role="dialog" aria-modal="true" aria-label="انتخاب مطلب برای بیشتر مطالعه کنید" dir="rtl">
            <div class="lp-head">
                <div>
                    <h5 class="lp-title">درج کارت «بیشتر مطالعه کنید»</h5>
                    <p class="lp-sub">از مطالب سایت انتخاب کنید؛ عنوان و لینک به‌صورت خودکار ثبت می‌شود.</p>
                </div>
                <button type="button" class="btn-close" @onclick="CloseReadMorePicker" aria-label="بستن"></button>
            </div>

            <div class="lp-tabs">
                @foreach (var tab in LinkPickerTabs)
                {
                    <button type="button" class="lp-tab @(_linkPickerTab == tab.Key ? "is-active" : null)" @onclick="() => SwitchLinkTab(tab.Key)">
                        @tab.Label
                        @if (tab.Key == _linkPickerTab && _linkPickerLoading)
                        {
                            <span class="spinner-border spinner-border-sm" style="width: .7rem; height: .7rem;"></span>
                        }
                    </button>
                }
            </div>

            <div class="lp-search">
                <span class="oi oi-magnifying-glass"></span>
                <input type="search" class="lp-search__input" placeholder="@LinkSearchPlaceholder"
                       @bind="_linkPickerQuery" @bind:event="oninput" @bind:after="OnLinkQueryChanged" />
                @if (!string.IsNullOrEmpty(_linkPickerQuery))
                {
                    <button type="button" class="lp-search__clear" @onclick="ClearLinkQuery" title="پاک کردن جستجو">×</button>
                }
            </div>

            <div class="lp-list">
                @if (_linkPickerError != null)
                {
                    <div class="lp-empty text-danger">@_linkPickerError</div>
                }
                else if (_linkPickerLoading)
                {
                    @for (var i = 0; i < 5; i++)
                    {
                        <div class="lp-skeleton"></div>
                    }
                }
                else if (!FilteredLinkItems.Any())
                {
                    <div class="lp-empty">
                        @(string.IsNullOrWhiteSpace(_linkPickerQuery) ? "موردی در این بخش ثبت نشده است." : "نتیجه‌ای برای این جستجو پیدا نشد.")
                    </div>
                }
                else
                {
                    @foreach (var item in FilteredLinkItems)
                    {
                        <button type="button" class="lp-item @(_linkPickerSelected == item ? "is-selected" : null)" @onclick="() => SelectLinkItem(item)">
                            <span class="lp-item__badge lp-item__badge--@item.Type">@item.TypeLabel</span>
                            <span class="lp-item__body">
                                <span class="lp-item__title">@item.Title</span>
                                @if (!string.IsNullOrWhiteSpace(item.Meta))
                                {
                                    <span class="lp-item__meta">@item.Meta</span>
                                }
                            </span>
                            <span class="lp-item__check"><span class="oi oi-check"></span></span>
                        </button>
                    }
                }
            </div>

            <div class="lp-custom">
                <div class="lp-custom__row">
                    <label class="lp-custom__label" for="lpCustomLabel">متن کارت</label>
                    <div class="lp-custom__field">
                        <input id="lpCustomLabel" type="text" class="lp-custom__input" maxlength="140"
                               placeholder="خالی = متن پیش‌فرض (نوع و عنوان خودکار)"
                               @bind="_linkCustomLabel" @bind:event="oninput" />
                        @if (!string.IsNullOrWhiteSpace(_linkCustomLabel))
                        {
                            <button type="button" class="lp-custom__clear" @onclick="ClearLinkCustomLabel" title="بازگشت به پیش‌فرض">×</button>
                        }
                    </div>
                </div>
                <p class="lp-custom__hint">
                    @if (_linkPickerSelected is null)
                    {
                        <text>پس از انتخاب مطلب، متن پیش‌فرض کارت (نوع و عنوان) خودکار ساخته می‌شود.</text>
                    }
                    else
                    {
                        <text>پیش‌فرض: «@AutoCardLabel» — اگر متنی بنویسید، همان جای پیش‌فرض درج می‌شود.</text>
                    }
                </p>
            </div>

            <div class="lp-foot">
                <div class="lp-picked">
                    @if (_linkPickerSelected != null)
                    {
                        <span class="lp-picked__label">متن نهایی:</span>
                        <span class="lp-picked__title">@EffectiveCardLabel</span>
                    }
                    else
                    {
                        <span class="lp-picked__hint">یک مورد را انتخاب کنید.</span>
                    }
                </div>
                <div class="lp-actions">
                    <button type="button" class="btn btn-light rounded-3 px-3" @onclick="CloseReadMorePicker">انصراف</button>
                    <button type="button" class="btn btn-primary rounded-3 px-4" disabled="@(_linkPickerSelected == null)" @onclick="InsertSelectedReadMore">
                        <span class="oi oi-arrow-left me-1"></span> درج در متن
                    </button>
                </div>
            </div>
        </div>
    }

    @if (selectedIds.Count > 0)
    {
        <div class="bulk-bar d-flex flex-wrap align-items-center gap-2 mb-2 px-3 py-2 rounded-3">
            <span class="fw-bold small">@selectedIds.Count مورد انتخاب شده</span>
            <div class="ms-auto d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-success rounded-3" @onclick='() => RunBulk("publish")'>انتشار</button>
                <button type="button" class="btn btn-sm btn-outline-secondary rounded-3" @onclick='() => RunBulk("unpublish")'>لغو انتشار</button>
                <button type="button" class="btn btn-sm btn-outline-warning rounded-3" @onclick='() => RunBulk("archive")'>آرشیو</button>
                <button type="button" class="btn btn-sm btn-outline-danger rounded-3" @onclick='() => RunBulk("delete")'>حذف</button>
            </div>
        </div>
    }

    <div class="content-list shadow-sm">
        <div class="content-list__toolbar">
            <label class="content-list__selectall">
                <input type="checkbox" class="form-check-input m-0" checked="@AllSelected" @onchange="ToggleSelectAll" />
                <span>انتخاب همه</span>
            </label>
            <span class="content-list__count">@totalCount.ToString("N0") مورد</span>
        </div>

        @if (newsList == null)
        {
            <div class="content-list__state"><div class="spinner-border text-primary"></div></div>
        }
        else if (!newsList.Any())
        {
            <div class="content-list__state text-muted">محتوایی با این فیلترها یافت نشد.</div>
        }
        else
        {
            @foreach (var news in newsList)
            {
                <div class="content-item @(selectedIds.Contains(news.Id) ? "is-selected" : null)">
                    <div class="content-item__check">
                        <input type="checkbox" class="form-check-input m-0"
                               checked="@selectedIds.Contains(news.Id)"
                               @onchange="e => ToggleSelect(news.Id, (bool?)e.Value == true)" />
                    </div>
                    <a class="content-item__thumb" href="@ContentTypeCatalog.DetailRoute(news.ContentType, news.Id, news.Slug)" target="_blank" tabindex="-1">
                        @if (!string.IsNullOrEmpty(news.ImageUrl))
                        {
                            <img src="@news.ImageUrl" alt="@news.Title" loading="lazy" />
                        }
                        else
                        {
                            <span class="oi oi-image"></span>
                        }
                    </a>
                    <div class="content-item__body">
                        <a class="content-item__title" href="@ContentTypeCatalog.DetailRoute(news.ContentType, news.Id, news.Slug)" target="_blank">
                            @if (news.IsFeatured) { <span class="oi oi-star-fill content-item__flag is-featured" title="منتخب"></span> }
                            @if (news.PinnedUntil.HasValue && news.PinnedUntil > DateTimeOffset.UtcNow) { <span class="oi oi-pin content-item__flag is-pinned" title="سنجاق‌شده"></span> }
                            <span>@news.Title</span>
                        </a>
                        @if (!string.IsNullOrWhiteSpace(news.Summary))
                        {
                            <div class="content-item__summary">@news.Summary</div>
                        }
                        <div class="content-item__meta">
                            <span class="badge rounded-pill @ContentTypeCatalog.BadgeClass(news.ContentType)">@ContentTypeCatalog.Label(news.ContentType)</span>
                            @if (!string.IsNullOrWhiteSpace(news.CategoryTitle))
                            {
                                <span class="content-item__chip"><span class="oi oi-folder"></span>@news.CategoryTitle</span>
                            }
                            <span class="content-item__chip"><span class="oi oi-calendar"></span>@PersianDate.ToJalaliDateTime(news.PublishedAt)</span>
                            @if (news.PublishAt.HasValue && news.PublishAt > DateTimeOffset.UtcNow)
                            {
                                <span class="content-item__chip is-info"><span class="oi oi-clock"></span>زمان‌بندی‌شده</span>
                            }
                        </div>
                    </div>
                    <div class="content-item__side">
                        <span class="badge @ContentStatusResolver.BadgeClass(news.Status) rounded-pill">@ContentStatusResolver.Label(news.Status)</span>
                        <span class="content-item__views" title="بازدید"><span class="oi oi-eye"></span>@news.ViewCount.ToString("N0")</span>
                    </div>
                    <div class="content-item__actions">
                        <a class="content-act is-view" href="@ContentTypeCatalog.DetailRoute(news.ContentType, news.Id, news.Slug)" target="_blank" title="پیش‌نمایش">
                            <span class="oi oi-eye"></span>
                        </a>
                        <button type="button" class="content-act is-edit" @onclick="() => EditNews(news)" title="ویرایش">
                            <span class="oi oi-pencil"></span>
                        </button>
                        <button type="button" class="content-act is-delete" @onclick="() => ConfirmDelete(news)" title="حذف">
                            <span class="oi oi-trash"></span>
                        </button>
                    </div>
                </div>
            }
        }

        @if (newsList != null && newsList.Count < totalCount)
        {
            <div class="content-list__more">
                <button class="btn btn-outline-primary btn-sm rounded-pill px-4" @onclick="() => LoadNews(true)" disabled="@isLoadingMore">
                    @if (isLoadingMore)
                    {
                        <span class="spinner-border spinner-border-sm me-1"></span>
                    }
                    مشاهده بیشتر (@(totalCount - newsList.Count) مورد باقی‌مانده)
                </button>
            </div>
        }
    </div>
</div>

<style>
    .image-upload-zone {
        min-height: 200px;
        transition: all 0.2s ease;
    }
    .image-upload-zone:hover {
        background: #f0f4f8 !important;
        border-color: #0d6efd !important;
    }
    .object-fit-cover { object-fit: cover; }
    .bg-success-subtle { background-color: #d1e7dd; }
    .bg-warning-subtle { background-color: #fff3cd; }
    .admin-container { padding: 0; }
    /* SEO/source panel (Blazor-driven; Bootstrap JS is not loaded here) */
    .seo-panel {
        border: 1px solid var(--app-border, #e2e8f0);
        border-radius: 16px;
        background: var(--app-surface, #fff);
        overflow: hidden;
    }
    .seo-panel__toggle {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 16px;
        border: 0;
        background: var(--app-table-header, #f8fafc);
        color: var(--app-text, #0f172a);
        font-weight: 800;
        font-size: .9rem;
        text-align: start;
        cursor: pointer;
        transition: background .15s ease;
    }
    .seo-panel__toggle:hover { background: var(--app-table-row-hover, #f1f5f9); }
    .seo-panel__toggle.is-open {
        border-bottom: 1px solid var(--app-border, #e2e8f0);
        color: var(--app-primary, #2563eb);
    }
    .seo-panel__meta { display: inline-flex; align-items: center; gap: 8px; color: var(--app-text-muted, #64748b); }
    .seo-panel__badge {
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: .72rem;
        font-weight: 700;
        color: var(--app-primary, #2563eb);
        background: var(--app-primary-light, rgba(37, 99, 235, .1));
        border-radius: 999px;
        padding: 2px 10px;
    }
    .seo-panel__body { padding: 14px 16px 16px; }

    /* Editor action bar: wraps instead of squeezing on narrow screens */
    .news-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .news-actions__preview { margin-inline-end: auto; }
    .news-actions__main { display: flex; align-items: center; gap: 8px; }
    .news-actions .btn { white-space: nowrap; }
    @@media (max-width: 767.98px) {
        .news-actions { display: grid; grid-template-columns: 1fr 1fr; }
        .news-actions__preview,
        .news-actions__page { grid-column: 1 / -1; margin-inline-end: 0; width: 100%; }
        .news-actions__main { display: contents; }
        .news-actions .btn { width: 100%; padding-inline: 8px; }
    }
    .content-type-tabs { display: inline-flex; flex-wrap: wrap; gap: 6px; }
    .ctab {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 14px;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: #fff;
        color: #475569;
        font-size: .82rem;
        font-weight: 700;
        cursor: pointer;
        transition: all .15s ease;
    }
    .ctab:hover { border-color: #93c5fd; color: #1d4ed8; background: #f0f7ff; }
    .ctab.is-active { border-color: #2563eb; color: #1d4ed8; background: #eff6ff; box-shadow: 0 0 0 2px rgba(37, 99, 235, .12); }
    .bulk-bar { background: #eff6ff; border: 1px solid #bfdbfe; }

    /* Content list: responsive rows instead of a cramped table */
    .content-list {
        background: var(--app-surface, #fff);
        border: 1px solid var(--app-border, #e2e8f0);
        border-radius: 18px;
        overflow: hidden;
    }
    .content-list__toolbar {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        padding: 10px 16px;
        background: var(--app-table-header, #f8fafc);
        border-bottom: 1px solid var(--app-border, #e2e8f0);
    }
    .content-list__selectall {
        display: flex; align-items: center; gap: 8px; margin: 0;
        font-size: .8rem; font-weight: 800;
        color: var(--app-text-secondary, #475569);
        cursor: pointer;
    }
    .content-list__count { font-size: .75rem; color: var(--app-text-muted, #64748b); }
    .content-list__state { padding: 56px 16px; text-align: center; }
    .content-list__more {
        padding: 14px; text-align: center;
        border-top: 1px solid var(--app-border, #e2e8f0);
        background: var(--app-table-header, #f8fafc);
    }
    .content-item {
        display: grid;
        grid-template-columns: 32px 60px minmax(0, 1fr) 104px 116px;
        grid-template-areas: "check thumb body side actions";
        align-items: center;
        gap: 12px;
        padding: 12px 16px;
        border-bottom: 1px solid var(--app-divider, rgba(15, 23, 42, .06));
        border-inline-start: 3px solid transparent;
        transition: background .15s ease, border-color .15s ease;
    }
    .content-item:last-child { border-bottom: 0; }
    .content-item:hover { background: var(--app-table-row-hover, #f8fafc); }
    .content-item.is-selected {
        background: var(--app-primary-light, rgba(37, 99, 235, .08));
        border-inline-start-color: var(--app-primary, #2563eb);
    }
    .content-item__check { grid-area: check; display: flex; justify-content: center; }
    .content-item__thumb {
        grid-area: thumb;
        width: 56px; height: 56px;
        display: flex; align-items: center; justify-content: center;
        border-radius: 12px; overflow: hidden;
        background: var(--app-table-header, #f1f5f9);
        color: var(--app-text-muted, #94a3b8);
        font-size: 1.15rem;
        text-decoration: none;
    }
    .content-item__thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .content-item__body { grid-area: body; min-width: 0; }
    .content-item__title {
        display: flex; align-items: center; flex-wrap: wrap; gap: 4px;
        font-size: .9rem; font-weight: 800; line-height: 1.7;
        color: var(--app-text, #0f172a);
        text-decoration: none;
    }
    .content-item__title:hover { color: var(--app-primary, #2563eb); }
    .content-item__flag.is-featured { color: #f59e0b; font-size: .75rem; }
    .content-item__flag.is-pinned { color: var(--app-primary, #2563eb); font-size: .72rem; }
    .content-item__summary {
        margin-top: 2px;
        font-size: .76rem; color: var(--app-text-muted, #64748b);
        overflow: hidden; display: -webkit-box;
        -webkit-line-clamp: 1; -webkit-box-orient: vertical;
    }
    .content-item__meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin-top: 6px; }
    .content-item__chip {
        display: inline-flex; align-items: center; gap: 3px;
        padding: 2px 8px; border-radius: 999px;
        font-size: .7rem; font-weight: 600;
        color: var(--app-text-muted, #64748b);
        background: var(--app-table-header, #f1f5f9);
    }
    .content-item__chip.is-info { color: var(--app-info, #0369a1); background: var(--app-info-bg, rgba(6, 182, 212, .12)); }
    .content-item__side { grid-area: side; display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
    .content-item__views { display: inline-flex; align-items: center; gap: 4px; font-size: .72rem; color: var(--app-text-muted, #64748b); }
    .content-item__actions { grid-area: actions; display: flex; justify-content: flex-end; gap: 6px; }
    .content-act {
        width: 34px; height: 34px;
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid transparent; border-radius: 10px;
        background: transparent; text-decoration: none;
        transition: all .15s ease;
    }
    .content-act.is-view { color: var(--app-text-secondary, #475569); border-color: var(--app-border, #e2e8f0); }
    .content-act.is-edit { color: var(--app-primary, #2563eb); background: var(--app-primary-light, rgba(37, 99, 235, .1)); }
    .content-act.is-delete { color: var(--app-danger, #dc2626); background: var(--app-danger-bg, rgba(220, 38, 38, .1)); }
    .content-act:hover { transform: translateY(-1px); }
    .content-act.is-view:hover { background: var(--app-table-header, #f1f5f9); }
    .content-act.is-edit:hover { background: var(--app-primary, #2563eb); color: #fff; }
    .content-act.is-delete:hover { background: var(--app-danger, #dc2626); color: #fff; }
    @@media (max-width: 991.98px) {
        .content-item {
            grid-template-columns: 24px 52px minmax(0, 1fr);
            grid-template-areas:
                "check thumb body"
                "check thumb side"
                "actions actions actions";
            align-items: start;
            gap: 6px 10px;
            padding: 12px;
        }
        .content-item__thumb { width: 48px; height: 48px; }
        .content-item__check { padding-top: 4px; }
        .content-item__side { flex-direction: row; align-items: center; gap: 8px; }
        .content-item__actions {
            justify-content: flex-end;
            margin-top: 2px; padding-top: 8px;
            border-top: 1px dashed var(--app-divider, #e2e8f0);
        }
    }
    @@media (max-width: 575.98px) {
        .content-list { border-radius: 14px; }
        .content-list__toolbar { padding: 8px 10px; }
        .content-item { padding: 10px; gap: 5px 8px; }
        .content-item__title { font-size: .84rem; }
        .content-item__summary { -webkit-line-clamp: 2; }
        .content-act { width: 38px; height: 38px; }
        .page-head { gap: 10px; }
        .page-actions { width: 100%; }
        .page-actions .btn { flex: 1 1 45%; white-space: nowrap; }
        .content-type-tabs { width: 100%; }
        .ctab { flex: 1 1 auto; justify-content: center; }
        .content-filters { width: 100%; }
        .content-filters > select,
        .content-filters > .input-group { width: 100% !important; }
