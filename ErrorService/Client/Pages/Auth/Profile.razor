@code {
    private UserProfileDto? user;
    private UpdateProfileRequest updateModel = new();
    private ChangePasswordRequest passwordModel = new();
    private string activeTab = "overview";
    private bool isBusy = false;
    private bool showMobileSidebar = false;
    private string orderFilter = "all";

    private List<OrderDto> myOrders = new();
    private List<ConsultationTicket> myTickets = new();
    private List<CouponDto> myCoupons = new();
    private List<WishlistItem> wishlistItems = new();
    private List<RecentlyViewedItem> recentlyViewedItems = new();
    private List<ProductWatchCard> trackedProductCards = new();
    private HashSet<int> activeStockAlertProductIds = new();
    private bool isLoadingTrackedProducts;
    private List<CartItem> cartItems = new();
    private decimal cartTotal = 0;
    private bool isCartLoading = false;
    private bool isLoadingOrders = false;
    private bool isLoadingTickets = false;
    private bool isLoadingCoupons = false;
    private Dictionary<int, ProductAvailabilityDto> cartAvailability = new();
    private bool showRemoveUnavailableConfirm;
    private bool isCheckingCartAvailability;

    private IEnumerable<int> UnavailableCartProductIds =>
        cartItems
            .Where(i => cartAvailability.TryGetValue(i.ProductId, out var a) && !a.HasSufficientStock)
            .Select(i => i.ProductId);

    private int UnavailableCartCount => UnavailableCartProductIds.Count();

    private decimal AvailableCartTotal =>
        cartItems
            .Where(i => !cartAvailability.TryGetValue(i.ProductId, out var a) || a.HasSufficientStock)
            .Sum(i => i.Price * i.Quantity);

    private ProductAvailabilityDto? GetCartAvailability(int productId)
        => cartAvailability.TryGetValue(productId, out var a) ? a : null;

    private int ActiveOrdersCount => myOrders.Count(o =>
        o.Status == OrderStatus.PendingPayment
        || o.Status == OrderStatus.ReceiptUploaded
        || o.Status == OrderStatus.Approved);

    private int UnreadTicketsCount => myTickets.Count(t => !t.IsUserRead);

    private int ActiveCouponsCount => myCoupons.Count(c =>
        !c.IsUsedByMe
        && c.IsActive
        && (!c.ExpiryDate.HasValue || c.ExpiryDate >= DateTimeOffset.UtcNow)
        && (!c.MaxUsageCount.HasValue || c.CurrentUsageCount < c.MaxUsageCount.Value));

    private HashSet<int> expandedOrders = new();

    private List<NotificationDto> notifications = new();
    private bool notifsLoading = true;
    private int notifUnreadCount;

    private BaleConnectStatusDto? baleStatus;
    private bool baleLoading;
    private bool baleSessionExpired;
    private bool hideBaleBanner;

    private async Task LoadBaleStatusAsync()
    {
        baleLoading = true;
        try
        {
            var resp = await Http.GetAsync("api/notifications/bale-status");
            baleSessionExpired = resp.StatusCode == System.Net.HttpStatusCode.Unauthorized;
            baleStatus = resp.IsSuccessStatusCode
                ? await resp.Content.ReadFromJsonAsync<BaleConnectStatusDto>()
                : null;
        }
        catch { baleStatus = null; baleSessionExpired = false; }
        baleLoading = false;
    }

    private async Task LoadNotificationsAsync()
    {
        notifsLoading = true;
        var items = await Notifs.LoadAsync(30);
        notifications = items;
        notifUnreadCount = items.Count(x => !x.IsRead);
        notifsLoading = false;
    }

    private async Task MarkAllNotificationsReadAsync()
    {
        var count = await Notifs.MarkAllReadAsync();
        foreach (var n in notifications) n.IsRead = true;
        notifUnreadCount = 0;
        if (count > 0)
            Toast.ShowSuccess("همه اعلان‌ها خوانده شد");
    }

    private async Task OpenNotificationAsync(NotificationDto item)
    {
        if (!item.IsRead)
        {
            item.IsRead = true;
            notifUnreadCount = Math.Max(0, notifUnreadCount - 1);
            await Notifs.MarkReadAsync(item.Id);
        }
        if (!string.IsNullOrWhiteSpace(item.ActionUrl))
            Nav.NavigateTo(item.ActionUrl);
    }

    private async Task HideNotificationAsync(NotificationDto item)
    {
        notifications.Remove(item);
        if (!item.IsRead)
            notifUnreadCount = Math.Max(0, notifUnreadCount - 1);
        await Notifs.HideAsync(item.Id);
    }

    private static string NotifDotStyle(int severity) => severity switch
    {
        1 => "background:#16a34a",
        2 => "background:#f59e0b",
        3 => "background:#dc2626",
        _ => "background:#0d6efd"
    };

    protected override async Task OnInitializedAsync()
    {
        await Recovery.RefreshAsync();
        var tabIndex = Nav.Uri.IndexOf("?tab=", StringComparison.OrdinalIgnoreCase);
        if (tabIndex >= 0)
        {
            var tabValue = Uri.UnescapeDataString(Nav.Uri[(tabIndex + 5)..]).Split('&')[0].Trim().ToLowerInvariant();
            if (tabValue is "overview" or "orders" or "tickets" or "wishlist" or "cart" or "edit" or "password" or "coupons" or "bale")
                activeTab = tabValue;
        }

        await LoadUser();
        if (user != null)
        {
            await LoadSummary();
            await LoadBaleStatusAsync();
        }
        wishlistItems = await Ws.GetItemsAsync();
        await LoadTrackedProductsAsync();
        Ws.OnChange += OnWishlistChanged;

        await Cart.InitializeAsync();
        RefreshCart();
        Cart.OnChange += OnCartChanged;

        await LoadNotificationsAsync();
    }

    private async void OnWishlistChanged()
    {
        wishlistItems = await Ws.GetItemsAsync();
        await LoadTrackedProductsAsync();
        await InvokeAsync(StateHasChanged);
    }

    private void OnCartChanged()
    {
        RefreshCart();
        _ = CheckCartAvailabilityAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private void RefreshCart()
    {
        cartItems = Cart.GetItems();
        cartTotal = Cart.GetTotalAmount();
    }

    private async Task CheckCartAvailabilityAsync()
    {
        if (activeTab != "cart" || isCheckingCartAvailability)
            return;

        if (cartItems.Count == 0)
        {
            if (cartAvailability.Count > 0)
            {
                cartAvailability.Clear();
                await InvokeAsync(StateHasChanged);
            }
            return;
        }

        isCheckingCartAvailability = true;
        try
        {
            var req = cartItems.Select(i => new ProductAvailabilityCheckItem
            {
                ProductId = i.ProductId,
                Quantity = i.Quantity
            }).ToList();

            var resp = await Http.PostAsJsonAsync("api/products/check-availability", req);
            if (resp.IsSuccessStatusCode)
            {
                var result = await resp.Content.ReadFromJsonAsync<List<ProductAvailabilityDto>>();
                if (result != null)
                {
                    var newMap = result.ToDictionary(x => x.ProductId);
                    var becameUnavailable = newMap.Count(kvp =>
                        !kvp.Value.HasSufficientStock &&
                        (!cartAvailability.TryGetValue(kvp.Key, out var old) || old.HasSufficientStock));

                    cartAvailability = newMap;

                    if (becameUnavailable > 0)
                        Toast.ShowWarning($"{becameUnavailable} کالا در سبد شما ناموجود شده است.");

                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch { }
        finally { isCheckingCartAvailability = false; }
    }

    private async Task ProceedFromProfileCart()
    {
        await CheckCartAvailabilityAsync();

        if (UnavailableCartCount > 0)
        {
            showRemoveUnavailableConfirm = true;
            StateHasChanged();
            return;
        }

        Nav.NavigateTo("/checkout");
    }

    private async Task HandleProfileRemoveUnavailableResult(bool confirmed)
    {
        showRemoveUnavailableConfirm = false;
        if (!confirmed)
        {
            StateHasChanged();
            return;
        }

        foreach (var pid in UnavailableCartProductIds.ToList())
            await Cart.RemoveItemAsync(pid);

        Toast.ShowSuccess("کالاهای ناموجود از سبد حذف شدند.");
        Nav.NavigateTo("/checkout");
    }

    private async Task LoadUser()
    {
        var token = await Auth.GetTokenAsync() ?? await Auth.GetWorkshopTokenAsync();
        if (!string.IsNullOrWhiteSpace(token))
        {
            var identity = JwtParser.ParseClaimsFromJwt(token);
            if (!identity.Claims.Any(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier))
            {
                Toast.ShowError("نشست شما قدیمی است؛ لطفاً دوباره وارد شوید.");
                Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString("/profile")}");
                return;
            }
        }

        user = await Auth.GetMeAsync();
        if (user == null)
        {
            Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString("/profile")}");
            return;
        }
        updateModel = new UpdateProfileRequest {
            FullName = user.FullName,
            Email = user.Email,
            Address = user.Address,
            PostalCode = user.PostalCode
        };
    }

