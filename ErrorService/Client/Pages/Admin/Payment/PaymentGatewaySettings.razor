    .pgs-side-list li { display: flex; gap: 10px; font-size: 0.75rem; color: #475569; line-height: 1.9; }
    .pgs-side-list .oi { color: #4f46e5; }

    .pgs-overlay { position: fixed; inset: 0; background: rgba(15,23,42,.55); backdrop-filter: blur(2px); z-index: 1200; display: grid; place-items: center; padding: 20px; }
    .pgs-modal { background: #fff; border-radius: 18px; width: 100%; max-width: 460px; max-height: 88vh; overflow-y: auto; padding: 24px; box-shadow: 0 24px 60px rgba(0,0,0,.25); }
    .pgs-modal--wide { max-width: 620px; }
    .pgs-modal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; margin-bottom: 6px; }
    .pgs-modal-title { font-size: 1.02rem; font-weight: 900; margin: 0; }
    .pgs-modal-sub { font-size: 0.78rem; color: #64748b; margin-bottom: 18px; }
    .pgs-modal-x { border: none; background: #f1f5f9; width: 34px; height: 34px; border-radius: 10px; color: #64748b; cursor: pointer; font-size: 0.8rem; }
    .pgs-modal-actions { display: flex; gap: 10px; margin-top: 20px; }

    .pgs-add-grid { display: grid; grid-template-columns: 1fr; gap: 10px; }
    .pgs-add-opt { text-align: right; background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 14px 16px; cursor: pointer; font-family: inherit; transition: all .15s; }
    .pgs-add-opt:hover { border-color: #c7d2fe; background: #eef2ff; }
    .pgs-add-opt__title { display: block; font-weight: 900; font-size: 0.9rem; color: #0f172a; }
    .pgs-add-opt__desc { display: block; font-size: 0.74rem; color: #64748b; line-height: 1.9; margin-top: 3px; }

    .pgs-field { margin-bottom: 18px; }
    .pgs-label { display: block; font-size: 0.8rem; font-weight: 800; color: #334155; margin-bottom: 7px; }
    .pgs-input { width: 100%; padding: 11px 14px; font-size: 0.85rem; border: 1px solid #e2e8f0; border-radius: 12px; background: #f8fafc; color: #0f172a; outline: none; transition: border-color .15s, box-shadow .15s; }
    .pgs-input:focus { border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,.08); background: #fff; }
    .pgs-hint { font-size: 0.72rem; color: #94a3b8; margin-top: 5px; line-height: 1.9; }
    .optional-txt { font-weight: 600; color: #cbd5e1; }
    .ltr { direction: ltr; text-align: left; }

    .pgs-callback-preview { background: #0f172a; color: #e2e8f0; border-radius: 12px; padding: 12px 16px; margin-bottom: 18px; }
    .pgs-callback-preview__label { display: block; font-size: 0.72rem; color: #94a3b8; margin-bottom: 6px; }
    .pgs-callback-preview code { font-size: 0.78rem; word-break: break-all; }

    @@media (max-width: 900px) {
        .pgs-layout { grid-template-columns: 1fr; }
        .pgs-side { position: static; }
        .pgs-row { flex-direction: column; align-items: flex-start; }
    }
</style>

@code {
    private List<PaymentGatewayDto> _gateways = new();
    private List<PaymentProviderDefinition> _providers = new();
    private bool _loading = true;
    private bool _saving;
    private bool _showAdd;
    private bool _showEdit;
    private PaymentGatewayDto? _draft;
    private Dictionary<string, string> _editConfig = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _providers = await Http.GetFromJsonAsync<List<PaymentProviderDefinition>>("api/payment/providers") ?? new();
            _gateways = await Http.GetFromJsonAsync<List<PaymentGatewayDto>>("api/payment/admin/gateways") ?? new();
        }
        catch { }
        _loading = false;
    }

    private string SandboxHint => _draft?.SandboxHint ?? "";
    private string CallbackPreview
    {
        get
        {
            if (_draft == null) return "";
            var baseUrl = string.IsNullOrWhiteSpace(_draft.CallbackBaseUrl) ? "https://errorservice.ir" : _draft.CallbackBaseUrl.TrimEnd('/');
            if (baseUrl.Contains("{orderId}"))
                return baseUrl.Replace("{orderId}", "123");
            return $"{baseUrl}/api/orders/123/payment/callback";
        }
    }

    private string GetConfigValue(GatewayConfigField f)
        => _editConfig.TryGetValue(f.Key, out var v) ? v : string.Empty;

    private void OnConfigChange(GatewayConfigField f, ChangeEventArgs e)
        => _editConfig[f.Key] = e.Value?.ToString() ?? string.Empty;

    private void OpenAdd() => _showAdd = true;
    private void CloseAdd() { _showAdd = false; }

    private async Task CreateGateway(string provider)
    {
        _saving = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/payment/admin/gateways", new PaymentGatewayCreateRequest { Provider = provider });
            if (resp.IsSuccessStatusCode)
            {
                var dto = await resp.Content.ReadFromJsonAsync<PaymentGatewayDto>();
                _showAdd = false;
                await Reload();
                if (dto != null) OpenEdit(dto);
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Toast.ShowError(string.IsNullOrWhiteSpace(err) ? "خطا در افزودن درگاه" : err);
            }
        }
        catch { Toast.ShowError("خطای ارتباط با سرور"); }
        finally { _saving = false; }
    }

    private void OpenEdit(PaymentGatewayDto g)
    {
        _draft = new PaymentGatewayDto
        {
            Id = g.Id,
            Provider = g.Provider,
            Title = g.Title,
            Online = g.Online,
            IsActive = g.IsActive,
            IsConfigured = g.IsConfigured,
            Sandbox = g.Sandbox,
            SupportsSandbox = g.SupportsSandbox,
            SandboxHint = g.SandboxHint,
            CallbackBaseUrl = g.CallbackBaseUrl,
            CallbackUrl = g.CallbackUrl,
            SortOrder = g.SortOrder,
            Config = new Dictionary<string, string>(g.Config),
            Fields = g.Fields
        };
        _editConfig = new Dictionary<string, string>(g.Config);
        _showEdit = true;
    }

    private void CloseEdit() { _showEdit = false; _draft = null; }

    private async Task ToggleActive(PaymentGatewayDto g, ChangeEventArgs e)
    {
        var value = e.Value is bool b && b;
        try
        {
            await SaveInternal(new PaymentGatewaySaveRequest
            {
                Id = g.Id,
                Provider = g.Provider,
                Title = g.Title,
                IsActive = value,
                Sandbox = g.Sandbox,
                CallbackBaseUrl = g.CallbackBaseUrl,
                SortOrder = g.SortOrder,
                Config = g.Config
            });
        }
        catch { Toast.ShowError("خطا در تغییر وضعیت درگاه"); }
    }

    private async Task Save()
    {
        if (_draft == null) return;
        await SaveInternal(new PaymentGatewaySaveRequest
        {
            Id = _draft.Id,
            Provider = _draft.Provider,
            Title = _draft.Title,
            IsActive = _draft.IsActive,
            Sandbox = _draft.Sandbox,
            CallbackBaseUrl = _draft.CallbackBaseUrl,
            SortOrder = _draft.SortOrder,
            Config = new Dictionary<string, string>(_editConfig)
        });
    }

    private async Task SaveInternal(PaymentGatewaySaveRequest request)
    {
        _saving = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/payment/admin/gateways/{request.Id}", request);
            if (resp.IsSuccessStatusCode)
            {
                await Reload();
                Toast.ShowSuccess("تنظیمات درگاه ذخیره شد");
                _showEdit = false;
                _draft = null;
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Toast.ShowError(string.IsNullOrWhiteSpace(err) ? "خطا در ذخیره تنظیمات درگاه" : err);
            }
        }
        catch { Toast.ShowError("خطای ارتباط با سرور"); }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteGateway(PaymentGatewayDto g)
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/payment/admin/gateways/{g.Id}");
            if (resp.IsSuccessStatusCode)
            {
                _gateways.RemoveAll(x => x.Id == g.Id);
                Toast.ShowSuccess("درگاه حذف شد");
            }
            else
            {
                var err = await resp.Content.ReadAsStringAsync();
                Toast.ShowError(string.IsNullOrWhiteSpace(err) ? "خطا در حذف درگاه" : err);
            }
        }
        catch { Toast.ShowError("خطای ارتباط با سرور"); }
    }

    private async Task Reload()
    {
        try
        {
            _gateways = await Http.GetFromJsonAsync<List<PaymentGatewayDto>>("api/payment/admin/gateways") ?? new();
        }
        catch { }
    }
}