    private async Task SubmitRating()
    {
        if (_ratingValue == 0 || _lastSessionId == 0) return;
        try
        {
            await Http.PostAsJsonAsync($"api/Chat/sessions/{_lastSessionId}/rate?visitorId={await GetVisitorId()}", new { rating = _ratingValue, comment = _ratingComment });
            _showRating = false;
        }
        catch { }
    }

    private async Task RestartChat()
    {
        _messages.Clear();
        _sessionId = 0;
        _status = ChatWidgetStatus.UserInfo;
        _statusMessage = null;
        _operatorRequested = false;
    }

    private async Task<string> GetVisitorId()
    {
        var id = await JS.InvokeAsync<string>("localStorage.getItem", "chat_visitor_id");
        if (string.IsNullOrEmpty(id))
        {
            id = Guid.NewGuid().ToString("N");
            await JS.InvokeVoidAsync("localStorage.setItem", "chat_visitor_id", id);
        }
        return id;
    }

