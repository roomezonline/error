@page "/admin/online-admission/settings"
@layout AdminLayout
@using ErrorService.Shared
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.onlineadmission.manage")]
@inject HttpClient Http
@inject ErrorService.Client.Services.ToastService ToastService

<PageTitle>تنظیمات پذیرش آنلاین</PageTitle>

<div class="admin-container" dir="rtl">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="admin-page-title m-0">تنظیمات کارشناسی آنلاین</h3>
        <a href="/admin/online-admission" class="btn btn-light rounded-3">
            <span class="oi oi-arrow-right me-1"></span> بازگشت به لیست
        </a>
    </div>

    @if (settings == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm border-0 rounded-4 p-4">
                    <div class="mb-4">
                        <label class="form-label fw-bold">مبلغ کارشناسی (ریال)</label>
                        <input type="text" class="form-control rounded-3 py-2 ltr" @bind="formattedAmount" @bind:event="oninput" @bind:after="OnAmountInput" inputmode="decimal" placeholder="0" />
                        <div class="text-muted small mt-1">این مبلغ در مرحله پرداخت به مشتری نمایش داده می‌شود.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">متن راهنمای پرداخت (HTML)</label>
                        <textarea class="form-control rounded-3" rows="6" @bind="settings.HtmlDescription" placeholder="توضیحات لازم برای واریز وجه و آپلود رسید..."></textarea>
                    </div>

                    <div class="form-check form-switch mb-4">
                        <input class="form-check-input" type="checkbox" id="isEnabled" @bind="settings.IsEnabled">
                        <label class="form-check-label fw-bold" for="isEnabled">سیستم پذیرش فعال باشد</label>
                    </div>

                    <div class="text-end">
                        <button class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm" @onclick="SaveSettings" disabled="@isSaving">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            ذخیره تنظیمات
                        </button>
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card shadow-sm border-0 rounded-4 p-4 bg-light">
                    <h6 class="fw-black mb-3 text-primary"><span class="oi oi-credit-card me-1"></span> حساب‌های فعال</h6>
                    <p class="small text-muted mb-4">شماره حساب‌هایی که در این بخش مشاهده می‌کنید از بخش «مدیریت حساب‌های بانکی» سیستم لود می‌شوند.</p>
                    
                    <div class="d-grid gap-2">
                        @foreach (var acc in settings.BankAccounts)
                        {
                            <div class="bg-white p-3 rounded-3 border small shadow-sm">
                                <div class="fw-bold mb-1">@acc.BankName</div>
                                <div class="text-muted mb-1">@acc.OwnerName</div>
                                <div class="ltr text-end fw-bold">@acc.CardNumber</div>
                            </div>
                        }
                        
                        @if (!settings.BankAccounts.Any())
                        {
                            <div class="alert alert-warning small">هیچ حساب بانکی فعالی در سیستم ثبت نشده است.</div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .admin-container { padding: 24px; }
    .fw-black { font-weight: 950; }
</style>

@code {
    private AdmissionExpertiseSettingsDto? settings;
    private bool isSaving;
    private string formattedAmount = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        try
        {
            settings = await Http.GetFromJsonAsync<AdmissionExpertiseSettingsDto>("api/online-admission/settings");
            if (settings != null)
            {
                formattedAmount = FormatNumber(settings.Amount);
            }
        }
        catch { ToastService.ShowError("خطا در بارگذاری تنظیمات"); }
    }

    private void OnAmountInput()
    {
        if (settings == null) return;

        // Remove non-numeric characters
        var cleanValue = new string(formattedAmount.Where(char.IsDigit).ToArray());
        if (string.IsNullOrWhiteSpace(cleanValue))
        {
            settings.Amount = 0;
            return;
        }

        // Parse to long
        if (long.TryParse(cleanValue, out var number))
        {
            settings.Amount = number;
            formattedAmount = FormatNumber(number);
        }
    }

    private string FormatNumber(long number)
    {
        return number.ToString("N0");
    }

    private async Task SaveSettings()
    {
        if (settings == null) return;
        isSaving = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("api/online-admission/admin/settings", settings);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("تنظیمات با موفقیت ذخیره شد");
            }
        }
        catch { ToastService.ShowError("خطا در ذخیره‌سازی"); }
        finally { isSaving = false; }
    }
}
