    private CancellationTokenSource? _loadCts;

    private async Task Load()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
        var ct = _loadCts.Token;

        isLoading = true;
        try
        {
            if (!CanWorkOnWorkshop)
            {
                all = new List<CustomerReceiptDto>();
                filtered = new List<CustomerReceiptDto>();
                return;
            }

            var qs = WorkshopQs();
            all = await Http
                .GetFromJsonAsync<List<CustomerReceiptDto>>($"api/customer-receipts{qs}", ct)
                .WaitAsync(ct);
            ApplyFilter();
            await PrefetchMonitoringHistory();
        }
        catch (OperationCanceledException)
        {
            ToastService.ShowError("دریافت لیست زمان‌بر شد. لطفاً دوباره تلاش کنید.");
        }
        catch
        {
            ToastService.ShowError("خطا در دریافت لیست");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void ApplyFilter()
    {
        displayCount = PageSize;
        if (all == null)
        {
            filtered = new List<CustomerReceiptDto>();
            paySettledCount = 0;
            payDebtorCount = 0;
            payCreditorCount = 0;
            filteredCountForHeader = 0;
            return;
        }

        var term = NormalizeDigits((q ?? string.Empty).Trim());

        IEnumerable<CustomerReceiptDto> query = all;

        if (!string.IsNullOrWhiteSpace(status))
            query = query.Where(x => string.Equals(x.Status, status, StringComparison.OrdinalIgnoreCase));

        if (!string.IsNullOrWhiteSpace(term))
        {
            query = query.Where(x =>
                ($"{x.CustomerFirstName} {x.CustomerLastName}").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (x.CustomerMobile ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (x.DeviceTypeName ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase) ||
                (x.DeviceBrandName ?? string.Empty).Contains(term, StringComparison.OrdinalIgnoreCase));
        }

        var fromOk = TryParseJalaliDate(dateFrom, out var fromDate);
        var toOk = TryParseJalaliDate(dateTo, out var toDate);

        if (fromOk)
            query = query.Where(x => x.RegisteredAt >= fromDate);

        if (toOk)
        {
            var endExclusive = toDate.AddDays(1);
            query = query.Where(x => x.RegisteredAt < endExclusive);
        }

        var baseList = query
            .OrderByDescending(x => x.RegisteredAt)
            .ToList();

        paySettledCount = 0;
        payDebtorCount = 0;
        payCreditorCount = 0;
        foreach (var it in baseList)
        {
            var st = GetPaymentState(it);
            if (st == "settled") paySettledCount++;
            else if (st == "debtor") payDebtorCount++;
            else if (st == "creditor") payCreditorCount++;
        }

        IEnumerable<CustomerReceiptDto> finalQuery = baseList;
        if (!string.IsNullOrWhiteSpace(paymentFilter))
        {
            finalQuery = finalQuery.Where(x => string.Equals(GetPaymentState(x), paymentFilter, StringComparison.OrdinalIgnoreCase));
        }

        filtered = finalQuery.ToList();

        filteredCountForHeader = filtered.Count;
        allCount = filtered.Count;
        pendingCount = filtered.Count(x => x.Status == "pending");
        notRepairableCount = filtered.Count(x => x.Status == "not_repairable");
        repairedCount = filtered.Count(x => x.Status == "repaired");
        deliveredCount = filtered.Count(x => x.Status == "delivered");
    }

