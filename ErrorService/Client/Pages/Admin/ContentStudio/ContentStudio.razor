    private async Task AddAllSuggested()
    {
        if (_addingSuggested) return;

        var missing = SuggestedSources.Where(p => !IsSuggestedAdded(p)).ToList();
        if (missing.Count == 0)
        {
            Toast.ShowInfo("همه منابع پیشنهادی از قبل اضافه شده‌اند.");
            return;
        }

        _addingSuggested = true;
        var added = 0;
        var failures = new List<string>();
        try
        {
            for (var i = 0; i < missing.Count; i++)
            {
                try
                {
                    var resp = await Http.PostAsJsonAsync($"{ApiBase}/sources", SuggestedRequest(missing[i], 100 + i * 10));
                    if (resp.IsSuccessStatusCode) added++;
                    else failures.Add($"{missing[i].Name}: {await ReadErrorAsync(resp) ?? "خطا"}");
                }
                catch (Exception ex)
                {
                    failures.Add($"{missing[i].Name}: {ex.Message}");
                }
            }

            await LoadSources();
            await LoadOverview();
        }
        finally
        {
            _addingSuggested = false;
        }

        if (failures.Count == 0)
            Toast.ShowSuccess($"{added} منبع اضافه شد.");
        else
            Toast.ShowWarning($"{added} منبع اضافه شد و {failures.Count} مورد ناموفق بود: " + string.Join(" | ", failures.Take(3)));
    }

