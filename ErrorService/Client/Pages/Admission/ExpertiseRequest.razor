@page "/admission/expertise"
@using ErrorService.Shared
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject ErrorService.Client.Services.ToastService ToastService
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>درخواست کارشناسی آنلاین</PageTitle>

<SeoHeader 
    Title="درخواست کارشناسی آنلاین لوازم خانگی | ارورسرویس"
    Description="ثبت درخواست کارشناسی و عیب‌یابی آنلاین لوازم خانگی. بررسی تخصصی و اعلام هزینه تعمیر"
    Keywords="کارشناسی لوازم خانگی, عیب‌یابی آنلاین, بررسی تعمیرات"
    OgType="website" />

<div class="admission-page" dir="rtl">
    <div class="admission-bg-blobs">
        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
    </div>
    <div class="container py-4 py-lg-5 position-relative">
        <div class="row justify-content-center">
            <div class="col-lg-10 col-xl-8">
                <div class="admission-card shadow-lg" @ref="admissionCard">
                    <!-- Header -->
                    <div class="admission-header mb-4 text-center text-md-start">
                        <div class="d-flex flex-column flex-md-row align-items-center gap-3">
                            <div class="admission-icon expertise">
                                <span class="oi oi-magnifying-glass"></span>
                            </div>
                            <div>
                                <h1 class="h3 fw-black m-0 text-gradient">درخواست کارشناسی هوشمند</h1>
                                <p class="text-muted small m-0 fw-bold">عیب‌یابی تخصصی دستگاه شما توسط برترین متخصصین کشور</p>
                            </div>
                        </div>
                    </div>

                    <!-- Steps Indicator -->
                    <div class="admission-steps mb-5">
                        <div class="step @(step >= 1 ? "active" : "") @(step > 1 ? "done" : "")">
                            <div class="step-num">@(step > 1 ? "✓" : "۱")</div>
                            <div class="step-label">دستگاه</div>
                        </div>
                        <div class="step-line"></div>
                        <div class="step @(step >= 2 ? "active" : "") @(step > 2 ? "done" : "")">
                            <div class="step-num">@(step > 2 ? "✓" : "۲")</div>
                            <div class="step-label">شرح مشکل</div>
                        </div>
                        <div class="step-line"></div>
                        <div class="step @(step >= 3 ? "active" : "") @(step > 3 ? "done" : "")">
                            <div class="step-num">@(step > 3 ? "✓" : "۳")</div>
                            <div class="step-label">مشخصات</div>
                        </div>
                        <div class="step-line"></div>
                        <div class="step @(step >= 4 ? "active" : "") @(step > 4 ? "done" : "")">
                            <div class="step-num">@(step > 4 ? "✓" : "۴")</div>
                            <div class="step-label">پرداخت</div>
                        </div>
                        <div class="step-line"></div>
                        <div class="step @(step >= 5 ? "active" : "")">
                            <div class="step-num">۵</div>
                            <div class="step-label">تایید</div>
                        </div>
                    </div>

                    @if (isLoading)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary"></div>
                            <p class="mt-3 text-muted">در حال بارگذاری اطلاعات...</p>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="request" OnSubmit="HandleNext">
                            <DataAnnotationsValidator />

                            @if (step == 1)
                            {
                                <div class="step-content">
                                    <div class="section-stack">
                                        <div class="section-card">
                                            <div class="section-head">
                                                <div class="section-icon info"><span class="oi oi-map-marker"></span></div>
                                                <div class="section-text">
                                                    <div class="section-title text-primary">موقعیت شما</div>
                                                    <div class="section-sub">ابتدا استان و شهر خود را مشخص کنید</div>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold small">استان</label>
                                                    <div class="searchable-select-wrap">
                                                        <SearchableSelect Items="(provinces ?? new List<ProvinceDto>())"
                                                                          Value="request.ProvinceId"
                                                                          ValueChanged="OnProvinceChanged"
                                                                          GetValue="p => p.Id"
                                                                          GetText="p => p.Name"
                                                                          Placeholder="انتخاب استان"
                                                                          Hint="جستجو و انتخاب کنید" />
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold small">شهر</label>
                                                    <div class="searchable-select-wrap">
                                                        <SearchableSelect Items="(cities ?? new List<CityDto>())"
                                                                          Value="request.CityId"
                                                                          ValueChanged="OnCityChanged"
                                                                          GetValue="c => c.Id"
                                                                          GetText="c => c.Name"
                                                                          Placeholder="انتخاب شهر"
                                                                          Hint="سپس شهر را انتخاب کنید"
                                                                          Disabled="@(cities == null || !cities.Any())" />
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="section-card">
                                            <div class="section-head">
                                                <div class="section-icon expertise"><span class="oi oi-laptop"></span></div>
                                                <div class="section-text">
                                                    <div class="section-title text-primary">اطلاعات دستگاه</div>
                                                    <div class="section-sub">انتخاب نوع و برند</div>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold small">نوع دستگاه</label>
                                                    <select class="form-select rounded-3 shadow-sm py-2" @bind="request.DeviceTypeId" @bind:after="OnDeviceTypeChanged">
                                                        <option value="0">انتخاب کنید...</option>
                                                        @if (deviceTypes != null)
                                                        {
                                                            @foreach (var dt in deviceTypes)
                                                            {
                                                                <option value="@dt.Id">@dt.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                    <ValidationMessage For="() => request.DeviceTypeId" class="text-danger small" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold small">برند دستگاه</label>
                                                    <select class="form-select rounded-3 shadow-sm py-2" @bind="request.DeviceBrandId" disabled="@(request.DeviceTypeId <= 0)">
                                                        <option value="">انتخاب کنید...</option>
                                                        @if (deviceBrands != null)
                                                        {
                                                            @foreach (var b in deviceBrands)
                                                            {
                                                                <option value="@b.Id">@b.Name</option>
                                                            }
                                                        }
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (step == 2)
                            {
                                <div class="step-content">
                                    <div class="section-stack">
                                        <div class="section-card">
                                            <div class="section-head">
                                                <div class="section-icon warning"><span class="oi oi-chat"></span></div>
                                                <div class="section-text">
                                                    <div class="section-title text-primary">شرح مشکل</div>
                                                    <div class="section-sub">هرچه دقیق‌تر، نتیجه بهتر</div>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-12">
                                                    <label class="form-label fw-bold small">شرح مشکل دستگاه</label>
                                                    <textarea class="form-control rounded-4 shadow-sm" rows="4" @bind="request.ProblemDescription" placeholder="مثلاً: دستگاه روشن نمی‌شود یا صدای غیرعادی می‌دهد..."></textarea>
                                                    <ValidationMessage For="() => request.ProblemDescription" class="text-danger small" />
                                                </div>
                                                <div class="col-12 mt-3">
                                                    <label class="form-label fw-bold small">تصویر دستگاه</label>
                                                    @if (string.IsNullOrEmpty(request.DeviceImageUrl))
                                                    {
                                                        <div class="row g-2">
                                                            <div class="col-6">
                                                                <label class="ad-upload-card" style="cursor: pointer;">
                                                                    <svg class="ad-upload-icon ad-upload-icon--gallery" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
                                                                        <circle cx="8.5" cy="8.5" r="1.5"/>
                                                                        <polyline points="21,15 16,10 5,21"/>
                                                                    </svg>
                                                                    <span class="ad-upload-label">انتخاب از گالری</span>
                                                                    <span class="ad-upload-hint">تصاویر دستگاه</span>
                                                                    <InputFile OnChange="HandleDeviceImageUpload" accept="image/*" class="d-none" />
                                                                </label>
                                                            </div>
                                                            <div class="col-6">
                                                                <label class="ad-upload-card" style="cursor: pointer;">
                                                                    <svg class="ad-upload-icon ad-upload-icon--camera" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                                                                        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                                                                        <circle cx="12" cy="13" r="4"/>
                                                                    </svg>
                                                                    <span class="ad-upload-label">دوربین</span>
                                                                    <span class="ad-upload-hint">عکس با کیفیت</span>
                                                                    <InputFile OnChange="HandleDeviceImageUpload" accept="image/*" capture="environment" class="d-none" />
                                                                </label>
                                                            </div>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <div class="image-upload-zone has-image rounded-4 border-2 border-dashed p-4 text-center bg-light">
                                                            <div class="position-relative" style="z-index: 10;">
                                                                <img src="@request.DeviceImageUrl" class="img-fluid rounded-3 shadow-sm mb-3" style="max-height: 180px" />
                                                                <div class="mt-2">
                                                                    <button type="button" class="btn btn-sm btn-danger rounded-pill px-3" @onclick="() => request.DeviceImageUrl = null">تغییر عکس</button>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    }
                                                    @if (isDeviceUploading)
                                                    {
                                                        <div class="progress mt-2" style="height: 6px;">
                                                            <div class="progress-bar progress-bar-striped progress-bar-animated" style="width: 100%"></div>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (step == 3)
                            {
                                <div class="step-content">
                                    <div class="section-stack">
                                        <div class="section-card">
                                            <div class="section-head">
                                                <div class="section-icon info"><span class="oi oi-person"></span></div>
                                                <div class="section-text">
                                                    <div class="section-title text-primary">مشخصات فردی</div>
                                                    <div class="section-sub">اطلاعات تماس جهت هماهنگی</div>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold small">نام و نام خانوادگی</label>
                                                    <input class="form-control rounded-3 shadow-sm py-2" @bind="request.CustomerFullName" />
                                                    <ValidationMessage For="() => request.CustomerFullName" class="text-danger small" />
                                                </div>
                                                <div class="col-md-6">
                                                    <label class="form-label fw-bold small">تلفن همراه</label>
                                                    <input class="form-control rounded-3 shadow-sm py-2" @bind="request.CustomerMobile" placeholder="09123456789" type="tel" maxlength="11" />
                                                    <ValidationMessage For="() => request.CustomerMobile" class="text-danger small" />
                                                </div>
                                                <div class="col-12">
                                                    <label class="form-label fw-bold small">آدرس جهت مراجعه</label>
                                                    <input class="form-control rounded-3 shadow-sm py-2" @bind="request.CustomerAddress" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (step == 4)
                            {
                                <div class="step-content">
                                    <div class="section-card mb-4 border-primary-subtle bg-primary-light">
                                        <div class="section-head mb-0 border-0">
                                            <div class="section-icon info"><span class="oi oi-info"></span></div>
                                            <div class="section-text">
                                                <div class="section-title text-primary">راهنمای پرداخت کارشناسی</div>
                                                <div class="section-sub text-dark fw-bold">مبلغ کارشناسی: <span class="fw-black fs-5 text-dark">@(settings?.Amount.ToString("N0"))</span> ریال</div>
                                            </div>
                                        </div>
                                        <div class="mt-3 small lh-lg opacity-75">@((MarkupString)(settings?.HtmlDescription ?? ""))</div>
                                    </div>

                                    <div class="section-stack mb-4">
                                        <div class="section-card">
                                            <div class="section-head">
                                                <div class="section-icon expertise"><span class="oi oi-credit-card"></span></div>
                                                <div class="section-text">
                                                    <div class="section-title text-primary">شماره حساب‌های جهت واریز</div>
                                                    <div class="section-sub">یکی از حساب‌های زیر را انتخاب کنید</div>
                                                </div>
                                            </div>
                                            <div class="row g-3">
                                                @if (settings?.BankAccounts != null)
                                                {
                                                    @foreach (var acc in settings.BankAccounts)
                                                    {
                                                        <div class="col-md-6">
                                                            <div class="bank-account-card-android p-3">
                                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                                    <span class="bank-badge">@acc.BankName</span>
                                                                    <span class="owner-name">@acc.OwnerName</span>
                                                                </div>
                                                                <div class="card-num-vivid ltr" dir="ltr">
                                                                    @FormatCardNumberPersian(acc.CardNumber)
                                                                </div>
                                                                <button type="button" class="btn btn-sm btn-outline-primary mt-2 w-100" @onclick="() => CopyCardNumber(acc.CardNumber)">
                                                                    <span class="oi oi-clipboard me-1"></span> کپی شماره کارت
                                                                </button>
                                                                @if (!string.IsNullOrEmpty(acc.Iban))
                                                                {
                                                                    <div class="iban-vivid">IR @acc.Iban</div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                        </div>

                                        <div class="section-card">
                                            <div class="section-head">
                                                <div class="section-icon warning"><span class="oi oi-cloud-upload"></span></div>
                                                <div class="section-text">
                                                    <div class="section-title text-primary">پرداخت هزینه کارشناسی</div>
                                                    <div class="section-sub">واریز به شماره کارت و آپلود رسید</div>
                                                </div>
                                            </div>
                                            <div class="receipt-upload-zone-android">
                                                @if (string.IsNullOrEmpty(request.ReceiptImageUrl))
                                                {
                                                    <div class="upload-placeholder py-4">
                                                        <span class="oi oi-camera display-5 mb-2"></span>
                                                        <p class="m-0 fw-bold">انتخاب فایل رسید</p>
                                                    </div>
                                                    <InputFile OnChange="HandleReceiptUpload" accept="image/*" class="upload-input" />
                                                }
                                                else
                                                {
                                                    <div class="upload-preview p-2">
                                                        <img src="@request.ReceiptImageUrl" class="rounded-3 shadow-sm" />
                                                        <div class="mt-2 text-center">
                                                            <button type="button" class="btn btn-sm btn-link text-danger fw-bold" @onclick="() => request.ReceiptImageUrl = null">
                                                                <span class="oi oi-trash me-1"></span> حذف و تغییر رسید
                                                            </button>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                            @if (isUploading)
                                            {
                                                <div class="upload-progress-android mt-3">
                                                    <div class="progress-bar-android"></div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (step == 5)
                            {
                                <div class="step-content text-center">
                                    <div class="success-icon-wrap mx-auto mb-4">
                                        <span class="oi oi-check"></span>
                                    </div>
                                    <h5 class="fw-black mb-3">تایید نهایی اطلاعات</h5>

                                    @if (settings?.OtpEnabled != false)
                                    {
                                        <p class="text-muted small mb-4">یک کد تایید ۶ رقمی به شماره @request.CustomerMobile ارسال شد. لطفاً کد را وارد کنید.</p>

                                        <div class="row justify-content-center mb-4">
                                            <div class="col-12 col-md-8">
                                                <div class="otp-container d-flex justify-content-center gap-2 mb-2 @otpStatusClass" dir="ltr">
                                                    @for (int i = 0; i < 6; i++)
                                                    {
                                                        var index = i;
                                                        <input type="text" class="otp-input" maxlength="1"
                                                               value="@otpDigits[index]"
                                                               @oninput="(e) => HandleOtpInput(e, index)"
                                                               @onkeydown="(e) => HandleOtpKeyDown(e, index)"
                                                               id="otp-@index" disabled="@isOtpVerified" />
                                                    }
                                                </div>
                                                <div class="otp-status-message @otpStatusClass">
                                                    @if (!string.IsNullOrEmpty(otpStatusMessage))
                                                    {
                                                        <span class="status-icon @otpStatusClass"></span>
                                                        @otpStatusMessage
                                                    }
                                                </div>
                                                <div class="otp-timer-wrap">
                                                    @if (otpTimerSeconds > 0)
                                                    {
                                                        <div class="otp-timer">
                                                            <span class="timer-digits">@FormatTime(otpTimerSeconds)</span>
                                                            <span class="timer-label">تا ارسال مجدد</span>
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn-resend-otp" @onclick="() => ResendOtp()">
                                                            <span class="oi oi-reload me-1"></span>
                                                            ارسال مجدد کد
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted small mb-4">لطفاً اطلاعات زیر را بررسی کرده و درخواست خود را ثبت کنید.</p>
                                    }

                                    <div class="summary-card-app mb-4">
                                        <div class="summary-header-app">
                                            <span class="oi oi-clipboard me-2"></span>
                                            خلاصه درخواست
                                        </div>
                                        <div class="summary-list-app">
                                            <div class="summary-row-app">
                                                <div class="summary-icon-wrap device"><span class="oi oi-laptop"></span></div>
                                                <div class="summary-content-app">
                                                    <div class="summary-label-app">دستگاه</div>
                                                    <div class="summary-value-app">@(deviceTypes?.FirstOrDefault(x => x.Id == request.DeviceTypeId)?.Name) @(deviceBrands?.FirstOrDefault(x => x.Id == request.DeviceBrandId)?.Name != null ? "- " + deviceBrands?.FirstOrDefault(x => x.Id == request.DeviceBrandId)?.Name : "")</div>
                                                </div>
                                            </div>
                                            <div class="summary-divider"></div>
                                            <div class="summary-row-app">
                                                <div class="summary-icon-wrap user"><span class="oi oi-person"></span></div>
                                                <div class="summary-content-app">
                                                    <div class="summary-label-app">مشتری</div>
                                                    <div class="summary-value-app">@request.CustomerFullName</div>
                                                    <div class="summary-sub-app ltr">@request.CustomerMobile</div>
                                                </div>
                                            </div>
                                            <div class="summary-divider"></div>
                                            <div class="summary-row-app">
                                                <div class="summary-icon-wrap location"><span class="oi oi-map-marker"></span></div>
                                                <div class="summary-content-app">
                                                    <div class="summary-label-app">موقعیت</div>
                                                    <div class="summary-value-app">@GetLocationText()</div>
                                                </div>
                                            </div>
                                            <div class="summary-divider"></div>
                                            <div class="summary-row-app">
                                                <div class="summary-icon-wrap problem"><span class="oi oi-chat"></span></div>
                                                <div class="summary-content-app">
                                                    <div class="summary-label-app">شرح مشکل</div>
                                                    <div class="summary-value-app text-break">@request.ProblemDescription</div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                            <div class="admission-actions d-flex justify-content-between mt-5 pt-4 border-top">
                                @if (step > 1)
                                {
                                    <button type="button" class="btn btn-light rounded-pill px-3 px-md-4 py-2 fw-bold" @onclick="HandlePrev">
                                        <span class="d-none d-md-inline">مرحله قبلی</span>
                                        <span class="d-md-none">قبلی</span>
                                    </button>
                                }
                                else
                                {
                                    <div></div>
                                }

                                @if (step < 5)
                                {
                                    <button type="submit" class="btn btn-primary rounded-pill px-4 px-md-5 py-2 fw-black shadow-lg" disabled="@(step == 4 && string.IsNullOrEmpty(request.ReceiptImageUrl))">
                                        <span class="d-none d-md-inline">بعدی</span>
                                        <span class="d-md-none">بعد</span>
                                        <span class="oi oi-arrow-left ms-1 small"></span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success rounded-pill px-3 px-md-5 py-2 fw-black shadow-lg final-submit-btn" @onclick="SubmitFinal" disabled="@isSubmitting" @ref="submitButton">
                                        @if (isSubmitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                        <span class="btn-text-short">ثبت درخواست</span>
                                        <span class="btn-text-full d-none d-md-inline">تایید نهایی و ثبت</span>
                                    </button>
                                }
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Vazir Font */
    .admission-page {
        font-family: 'Vazir', sans-serif !important;
    }

    .bank-account-card-android {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        transition: all 0.3s;
        font-family: 'Vazir', sans-serif !important;
    }
    .bank-account-card-android:hover {
        border-color: #2563eb;
        box-shadow: 0 8px 20px rgba(37, 99, 235, 0.1);
    }
    .bank-badge {
        background: #2563eb;
        color: #fff;
        font-size: 0.7rem;
        padding: 2px 10px;
        border-radius: 8px;
        font-weight: 800;
    }
    .owner-name {
        font-size: 0.8rem;
