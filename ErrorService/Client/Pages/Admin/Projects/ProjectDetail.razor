@page "/admin/projects/{Id:int}"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.projects.view")]
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@using ErrorService.Shared
@using ErrorService.Client.Services
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>جزییات پروژه</PageTitle>

@if (isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else if (project == null)
{
    <div class="text-center py-5">
        <span class="oi oi-circle-x display-4 text-danger"></span>
        <p class="mt-2">پروژه یافت نشد.</p>
        <a href="/admin/projects" class="btn btn-primary rounded-pill">بازگشت به لیست</a>
    </div>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
        <a href="/admin/projects" class="btn btn-sm btn-outline-secondary rounded-circle flex-shrink-0" style="width:36px;height:36px;display:grid;place-items:center">
            <span class="oi oi-arrow-right"></span>
        </a>
        <div class="flex-grow-1" style="min-width:0;">
            <h4 class="fw-bold mb-0 text-truncate">@project.Name</h4>
            <small class="text-muted">ایجاد شده: @project.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm")</small>
        </div>
        @if (isViewOnly)
        {
            <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1" style="font-size:0.72rem;">
                <span class="oi oi-eye me-1"></span> مشاهده
            </span>
        }
        <a class="btn btn-sm btn-outline-primary rounded-pill px-3 flex-shrink-0" style="white-space:nowrap;cursor:pointer;" @onclick="DownloadZipAsync">
            <span class="oi oi-data-transfer-download me-1" style="font-size:0.8rem;"></span>
            <span class="d-none d-sm-inline">دانلود ZIP</span>
            <span class="d-sm-none">ZIP</span>
        </a>
    </div>

    <div class="project-tabs mb-4">
        @foreach (var tab in tabs)
        {
            <button class="project-tab @(activeTab == tab.Key ? "project-tab--active" : "")" @onclick="() => activeTab = tab.Key">
                <span class="oi @tab.Icon"></span>
                <span>@tab.Label</span>
            </button>
        }
    </div>

    @if (activeTab == "info")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4">
            @if (isViewOnly)
            {
                <div class="row g-3">
                    <div class="col-12">
                        <div class="view-chip">
                            <div class="view-chip__icon bg-primary-subtle text-primary"><span class="oi oi-info"></span></div>
                            <div class="view-chip__content">
                                <div class="view-chip__label">نام پروژه</div>
                                <div class="view-chip__value fw-bold fs-5">@project.Name</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-12">
                        <div class="view-chip">
                            <div class="view-chip__icon bg-secondary-subtle text-secondary"><span class="oi oi-sort-ascending"></span></div>
                            <div class="view-chip__content">
                                <div class="view-chip__label">ترتیب</div>
                                <div class="view-chip__value">@project.SortOrder</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-12">
                        <div class="view-chip">
                            <div class="view-chip__icon @(project.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")"><span class="oi @(project.IsActive ? "oi-check" : "oi-x")"></span></div>
                            <div class="view-chip__content">
                                <div class="view-chip__label">وضعیت</div>
                                <div class="view-chip__value">@(project.IsActive ? "فعال" : "غیرفعال")</div>
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(project.Summary))
                    {
                    <div class="col-12">
                        <div class="view-chip">
                            <div class="view-chip__icon bg-info-subtle text-info"><span class="oi oi-text"></span></div>
                            <div class="view-chip__content">
                                <div class="view-chip__label">خلاصه</div>
                                <div class="view-chip__value">@project.Summary</div>
                            </div>
                        </div>
                    </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(project.Description))
                    {
                    <div class="col-12">
                        <div class="view-chip">
                            <div class="view-chip__icon bg-warning-subtle text-warning"><span class="oi oi-document"></span></div>
                            <div class="view-chip__content">
                                <div class="view-chip__label">توضیحات</div>
                                <div class="view-chip__value" style="white-space:pre-wrap;">@project.Description</div>
                            </div>
                        </div>
                    </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(project.CoverImageUrl))
                    {
                    <div class="col-12">
                        <div class="view-chip">
                            <div class="view-chip__icon bg-danger-subtle text-danger"><span class="oi oi-image"></span></div>
                            <div class="view-chip__content">
                                <div class="view-chip__label">عکس جلد</div>
                                <img src="@project.CoverImageUrl" class="rounded-3 mt-1" style="max-height:180px;cursor:pointer;max-width:100%;" @onclick="() => OpenLightbox(project.CoverImageUrl)" />
                            </div>
                        </div>
                    </div>
                    }
                </div>
            }
            else
            {
            <EditForm Model="editModel" OnValidSubmit="SaveInfo">
                <DataAnnotationsValidator />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small text-muted">نام پروژه *</label>
                        <InputText class="form-control rounded-3" @bind-Value="editModel.Name" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small text-muted">ترتیب</label>
                        <InputNumber class="form-control rounded-3" @bind-Value="editModel.SortOrder" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check form-switch">
                            <InputCheckbox class="form-check-input" @bind-Value="editModel.IsActive" id="act" />
                            <label class="form-check-label" for="act">فعال</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small text-muted">خلاصه</label>
                        <InputText class="form-control rounded-3" @bind-Value="editModel.Summary" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small text-muted">توضیحات</label>
                        <InputTextArea class="form-control rounded-3" @bind-Value="editModel.Description" rows="5" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small text-muted">عکس جلد</label>
                        <ImageUploader @bind-ImageUrl="editModel.CoverImageUrl" UploadUrl=@($"api/projects/upload?projectId={Id}&type=cover") ShowCamera="false" />
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-primary rounded-pill px-5 py-2" disabled="@isSaving">
                            @if (isSaving) { <span class="spinner-border spinner-border-sm me-2"></span> } ذخیره
                        </button>
                    </div>
                </div>
            </EditForm>
            }
        </div>
    }
    else if (activeTab == "images")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="fw-bold mb-3">عکس‌های پروژه (@project.Images.Count)</h6>
            <div class="row g-3 mb-4">
                @foreach (var img in project.Images)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="position-relative rounded-3 overflow-hidden border" style="aspect-ratio:1;cursor:pointer;" @onclick="() => OpenLightbox(img.ImageUrl)">
                            <img src="@img.ImageUrl" alt="@img.Caption" style="width:100%;height:100%;object-fit:cover" />
                            @if (!isViewOnly)
                            {
                                <button class="btn btn-sm btn-danger position-absolute top-0 start-0 m-1 rounded-circle" style="width:28px;height:28px" @onclick:stopPropagation="true" @onclick="() => DeleteImage(img.Id)">
                                    <span class="oi oi-trash p-0" style="font-size:0.7rem"></span>
                                </button>
                            }
                            @if (!string.IsNullOrWhiteSpace(img.Caption))
                            {
                                <div class="position-absolute bottom-0 start-0 end-0 bg-dark bg-opacity-75 text-white px-2 py-1 small">@img.Caption</div>
                            }
                        </div>
                    </div>
                }
            </div>
            @if (!isViewOnly)
            {
            <div class="border-top pt-3">
                <h6 class="fw-bold mb-3">افزودن عکس جدید</h6>
                <ImageUploader @bind-ImageUrl="newImageUrl" UploadUrl=@($"api/projects/upload?projectId={Id}&type=images") ShowCamera="false" />
                <div class="row g-2 mt-3">
                    <div class="col-md-5">
                        <input class="form-control form-control-sm rounded-3" placeholder="عنوان عکس (اختیاری)" @bind="newImageCaption" />
                    </div>
                    <div class="col-md-3">
                        <input type="number" class="form-control form-control-sm rounded-3" placeholder="ترتیب" @bind="newImageSort" />
                    </div>
                    <div class="col-md-4">
                        <button class="btn-add-project" @onclick="AddImage" disabled="@(string.IsNullOrEmpty(newImageUrl) || isAddingImage)">
                            @if (isAddingImage)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <span class="oi oi-plus me-1"></span>
                            }
                            افزودن عکس
                        </button>
                    </div>
                </div>
            </div>
            }
        </div>
    }
    else if (activeTab == "files")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="fw-bold mb-3">فایل‌های پروژه (@project.Files.Count)</h6>

            @if (project.Files.Any())
            {
                <div class="table-responsive mb-4">
                    <table class="table table-sm align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th>نام فایل</th>
                                <th>نوع</th>
                                <th>ورژن</th>
                                <th>توضیحات</th>
                                <th>تاریخ</th>
                                @if (!isViewOnly) { <th></th> }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var f in project.Files)
                            {
                                var isImage = !string.IsNullOrEmpty(f.FileUrl) && (f.FileUrl.EndsWith(".jpg", StringComparison.OrdinalIgnoreCase) || f.FileUrl.EndsWith(".jpeg", StringComparison.OrdinalIgnoreCase) || f.FileUrl.EndsWith(".png", StringComparison.OrdinalIgnoreCase) || f.FileUrl.EndsWith(".webp", StringComparison.OrdinalIgnoreCase));
                                <tr>
                                    <td>
                                        @if (isImage)
                                        {
                                            <a href="@f.FileUrl" target="_blank" class="text-decoration-none fw-bold d-flex align-items-center gap-2" style="cursor:pointer;">
                                                <img src="@f.FileUrl" alt="@f.FileName" style="width:36px;height:36px;object-fit:cover;border-radius:6px;" @onclick:stopPropagation @onclick="() => OpenLightbox(f.FileUrl)" />
                                                @f.FileName
                                            </a>
                                        }
                                        else
                                        {
                                            <a href="@f.FileUrl" target="_blank" download="@f.FileName" class="text-decoration-none fw-bold d-flex align-items-center gap-2">
                                                <span class="oi oi-arrow-circle-bottom" style="color:#6366f1;font-size:1.1rem;"></span>
                                                @f.FileName
                                            </a>
                                        }
                                    </td>
                                    <td><span class="badge bg-info-subtle text-info">@GetFileTypeLabel(f.FileType)</span></td>
                                    <td>@(f.Version ?? "—")</td>
                                    <td class="small text-muted" style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@(f.Description ?? "—")</td>
                                    <td class="small text-muted">@f.UploadedAt.ToLocalTime().ToString("MM/dd")</td>
                                    @if (!isViewOnly)
                                    {
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => DeleteFile(f.Id)">
                                            <span class="oi oi-trash" style="font-size:0.7rem"></span>
                                        </button>
                                    </td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (!isViewOnly)
            {
            <div class="border-top pt-3">
                <h6 class="fw-bold mb-3">افزودن فایل جدید</h6>
                <FileUploader @bind-FileUrl="newFileUrl" FileName="@newFileTitle"
                              UploadUrl=@($"api/projects/upload?projectId={Id}&type=files")
                              Accept="*/*"
                              AcceptHint="سند، PCB، نقشه و سایر فایل‌ها" />
                <div class="row g-2 mt-3">
                    <div class="col-md-3">
                        <input class="form-control form-control-sm rounded-3" placeholder="نام فایل" @bind="newFileTitle" />
                    </div>
                    <div class="col-md-2">
                        <select class="form-select form-select-sm rounded-3" @bind="newFileType">
                            <option value="Document">سند</option>
                            <option value="Pcb">PCB</option>
                            <option value="Map">نقشه</option>
                            <option value="CoverImage">جلد</option>
                            <option value="Other">متفرقه</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <input class="form-control form-control-sm rounded-3" placeholder="ورژن" @bind="newFileVersion" />
                    </div>
                    <div class="col-md-3">
                        <input class="form-control form-control-sm rounded-3" placeholder="توضیحات" @bind="newFileDesc" />
                    </div>
                    <div class="col-md-2">
                        <button class="btn-add-project" @onclick="AddFile" disabled="@(string.IsNullOrEmpty(newFileUrl) || string.IsNullOrWhiteSpace(newFileTitle) || isAddingFile)">
                            @if (isAddingFile)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <span class="oi oi-plus me-1"></span>
                            }
                            افزودن فایل
                        </button>
                    </div>
                </div>
            </div>
            }
        </div>
    }
    else if (activeTab == "sections")
    {
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="fw-bold mb-0">بخش‌های محتوایی (@project.Sections.Count)</h6>
                @if (!isViewOnly)
                {
                <button class="btn-add-project" @onclick="ShowNewSection">
                    <span class="oi oi-plus me-1"></span> بخش جدید
                </button>
                }
            </div>

            @if (!isViewOnly && showSectionForm)
            {
                <div class="bg-light rounded-3 p-3 mb-3">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <input class="form-control form-control-sm rounded-3" placeholder="عنوان بخش" @bind="newSectionTitle" />
                        </div>
                        <div class="col-md-2">
                            <input type="number" class="form-control form-control-sm rounded-3" placeholder="ترتیب" @bind="newSectionSort" />
                        </div>
                        <div class="col-md-4 d-flex gap-2">
                            <button class="btn btn-primary btn-sm rounded-pill flex-grow-1" @onclick="AddSection" disabled="@string.IsNullOrWhiteSpace(newSectionTitle)">
                                ذخیره
                            </button>
                            <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="() => showSectionForm = false">انصراف</button>
                        </div>
                    </div>
                </div>
            }

            @foreach (var sec in project.Sections)
            {
                <div class="border rounded-3 p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <div class="fw-bold">@sec.Title <small class="text-muted">(@sec.Items.Count آیتم)</small></div>
                        @if (!isViewOnly)
                        {
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick="() => StartAddItem(sec.Id)">
                                <span class="oi oi-plus" style="font-size:0.7rem"></span>
                            </button>
                            <button class="btn btn-sm btn-outline-danger rounded-pill" @onclick="() => DeleteSection(sec.Id)">
                                <span class="oi oi-trash" style="font-size:0.7rem"></span>
                            </button>
                        </div>
                        }
                    </div>

                    @if (!isViewOnly && activeSectionId == sec.Id && showItemForm)
                    {
                        <div class="bg-light rounded-3 p-3 mb-2">
                            <div class="row g-2">
                                <div class="col-md-2">
                                    <select class="form-select form-select-sm rounded-3" @bind="newItemType">
                                        <option value="Text">متن</option>
                                        <option value="Image">عکس</option>
                                        <option value="File">فایل</option>
                                    </select>
                                </div>
                                <div class="col-md-5">
                                    @if (newItemType == "Text")
                                    {
                                        <textarea class="form-control form-control-sm rounded-3" rows="2" placeholder="متن محتوا" @bind="newItemText"></textarea>
                                    }
                                    else if (newItemType == "Image")
                                    {
                                        <ImageUploader @bind-ImageUrl="newItemMediaUrl" UploadUrl=@($"api/projects/upload?projectId={Id}&type=images") ShowCamera="false" />
                                    }
                                    else
                                    {
                                        <FileUploader @bind-FileUrl="newItemMediaUrl" UploadUrl=@($"api/projects/upload?projectId={Id}&type=files") Accept="*/*" AcceptHint="فایل ضمیمه" />
                                    }
                                </div>
                                <div class="col-md-3">
                                    <input class="form-control form-control-sm rounded-3" placeholder="توضیحات" @bind="newItemDesc" />
                                </div>
                                <div class="col-md-2 d-flex gap-1">
                                    <button class="btn-add-project btn-add-project--sm" @onclick="() => AddSectionItem(sec.Id)">افزودن</button>
                                    <button class="btn btn-outline-secondary btn-sm rounded-pill" @onclick="() => showItemForm = false">×</button>
                                </div>
                            </div>
                        </div>
                    }

                    @if (sec.Items.Any())
                    {
                        @foreach (var item in sec.Items)
                        {
                            <div class="d-flex align-items-center gap-3 py-2 border-top small">
                                @if (item.ItemType == SectionItemType.Image && !string.IsNullOrEmpty(item.MediaUrl))
                                {
                                    <img src="@item.MediaUrl" alt="@item.FileName" style="width:48px;height:48px;object-fit:cover;border-radius:8px;border:1px solid #e2e8f0;cursor:pointer;" @onclick="() => OpenLightbox(item.MediaUrl)" />
                                }
                                else if (item.ItemType == SectionItemType.File && !string.IsNullOrEmpty(item.MediaUrl))
                                {
                                    <a href="@item.MediaUrl" target="_blank" download="@(item.FileName ?? "file")" class="d-flex align-items-center justify-content-center" style="width:48px;height:48px;background:linear-gradient(135deg,#ede9fe,#e0e7ff);border-radius:8px;text-decoration:none;">
                                        <span class="oi oi-arrow-circle-bottom" style="color:#6366f1;font-size:1.3rem;"></span>
                                    </a>
                                }
                                else
                                {
                                    <div class="d-flex align-items-center justify-content-center" style="width:48px;height:48px;background:#f1f5f9;border-radius:8px;">
                                        <span class="oi oi-text" style="color:#94a3b8;font-size:1.1rem;"></span>
                                    </div>
                                }
                                <div class="flex-grow-1" style="min-width:0;">
                                    @if (item.ItemType == SectionItemType.Text && !string.IsNullOrEmpty(item.TextContent))
                                    {
                                        <div class="text-muted" style="max-height:60px;overflow:hidden">@item.TextContent</div>
                                    }
                                    else if (item.ItemType == SectionItemType.Image)
                                    {
                                        <div class="fw-bold text-truncate" style="max-width:300px;">@(item.FileName ?? "تصویر")</div>
                                    }
                                    else if (item.ItemType == SectionItemType.File)
                                    {
                                        <a href="@item.MediaUrl" target="_blank" download="@(item.FileName ?? "file")" class="text-decoration-none fw-bold text-truncate d-block" style="max-width:300px;">@(item.FileName ?? "فایل")</a>
                                    }
                                    @if (!string.IsNullOrEmpty(item.Description))
                                    {
                                        <div class="text-muted small">@item.Description</div>
                                    }
                                </div>
                                @if (!isViewOnly)
                                {
                                <button class="btn btn-sm btn-outline-danger rounded-pill flex-shrink-0" @onclick="() => DeleteSectionItem(sec.Id, item.Id)">
                                    <span class="oi oi-trash" style="font-size:0.65rem"></span>
                                </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-muted small py-2">هنوز آیتمی اضافه نشده.</div>
                    }
                </div>
            }
        </div>
    }
}

<style>
    .project-tabs {
        display: flex;
        gap: 8px;
        overflow-x: auto;
        padding-bottom: 4px;
        -webkit-overflow-scrolling: touch;
    }
    .project-tabs::-webkit-scrollbar { display: none; }

    .project-tab {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: 14px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        color: #64748b;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
        flex-shrink: 0;
    }
    .project-tab:hover { background: #f1f5f9; color: #334155; }
    .project-tab--active {
        background: linear-gradient(135deg, #2563eb, #1d4ed8);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 4px 12px rgba(37,99,235,0.3);
    }
    .project-tab .oi { font-size: 1rem; }

    @@media (max-width: 575.98px) {
        .project-tab { padding: 14px 16px; font-size: 0.85rem; gap: 6px; }
        .project-tab .oi { font-size: 0.9rem; }
    }

    .btn-add-project {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 12px 24px;
        border-radius: 12px;
        border: none;
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        font-weight: 700;
        font-size: 0.95rem;
        cursor: pointer;
        transition: all 0.2s ease;
        white-space: nowrap;
    }
    .btn-add-project:hover { opacity: 0.9; transform: translateY(-1px); box-shadow: 0 4px 12px rgba(16,185,129,0.3); }
    .btn-add-project:disabled { opacity: 0.5; cursor: not-allowed; transform: none; box-shadow: none; }
    .btn-add-project--sm { padding: 10px 18px; font-size: 0.85rem; }

    .view-chip {
        display: flex; align-items: flex-start; gap: 14px;
        background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px;
        padding: 16px 18px; transition: all 0.2s;
    }
    .view-chip:hover { background: #f1f5f9; border-color: #cbd5e1; }
    .view-chip__icon {
        width: 44px; height: 44px; border-radius: 12px;
        display: grid; place-items: center; font-size: 1.1rem; flex-shrink: 0;
    }
    .view-chip__content { min-width: 0; flex: 1; }
    .view-chip__label {
        font-size: 0.72rem; color: #94a3b8; font-weight: 600;
        text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 4px;
    }
    .view-chip__value { font-size: 0.95rem; color: #1e293b; word-break: break-word; }
    @@media (max-width: 575.98px) {
        .view-chip { padding: 12px 14px; gap: 10px; }
        .view-chip__icon { width: 38px; height: 38px; font-size: 0.95rem; }
        .view-chip__label { font-size: 0.68rem; }
        .view-chip__value { font-size: 0.88rem; }
    }

    @@media (max-width: 575.98px) {
        .btn-add-project { width: 100%; padding: 14px 20px; }
    }
    .lightbox-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,0.92);
        display: flex; align-items: center; justify-content: center;
        z-index: 9999; cursor: zoom-out; animation: lbFadeIn 0.2s;
    }
    .lightbox-overlay img {
        max-width: 92vw; max-height: 92vh; object-fit: contain;
        border-radius: 8px; box-shadow: 0 0 40px rgba(0,0,0,0.5);
    }
    .lightbox-close {
        position: fixed; top: 16px; left: 16px; z-index: 10000;
        background: rgba(255,255,255,0.15); border: none; color: #fff;
        width: 40px; height: 40px; border-radius: 50%; font-size: 1.2rem;
        cursor: pointer; display: grid; place-items: center;
    }
    .lightbox-close:hover { background: rgba(255,255,255,0.3); }
    @@keyframes lbFadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>

@if (!string.IsNullOrEmpty(lightboxUrl))
{
    <div class="lightbox-overlay" @onclick="CloseLightbox">
        <button class="lightbox-close" @onclick="CloseLightbox">×</button>
        <img src="@lightboxUrl" @onclick:stopPropagation />
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private ProjectDto? project;
    private ProjectUpsertRequest editModel = new();
    private bool isLoading = true;
    private bool isSaving = false;
    private string activeTab = "info";
    private bool isViewOnly = false;
    private string? lightboxUrl;

    private (string Key, string Label, string Icon)[] tabs = {
        ("info", "اطلاعات", "oi-info"),
        ("images", "عکس‌ها", "oi-image"),
        ("files", "فایل‌ها", "oi-document"),
        ("sections", "بخش‌ها", "oi-list")
    };

    // Image form
    private string? newImageUrl;
    private string? newImageCaption;
    private int newImageSort;
    private bool isAddingImage;

    // File form
    private string? newFileUrl;
    private string? newFileTitle;
    private string newFileType = "Document";
    private string? newFileVersion;
    private string? newFileDesc;
    private bool isAddingFile;

    // Section form
    private bool showSectionForm = false;
    private string? newSectionTitle;
    private int newSectionSort;

    // Section item form
    private bool showItemForm = false;
    private int activeSectionId;
    private string newItemType = "Text";
    private string? newItemText;
    private string? newItemMediaUrl;
    private string? newItemDesc;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Nav.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        isViewOnly = query["view"] == "1";
        await LoadProject();
    }

    private void OpenLightbox(string url) { lightboxUrl = url; }
    private void CloseLightbox() { lightboxUrl = null; }

    private async Task DownloadZipAsync()
    {
        try
        {
            var token = await JS.InvokeAsync<string?>("eval", "localStorage.getItem('auth_token')");
            var url = $"/api/projects/{Id}/export";
            if (!string.IsNullOrWhiteSpace(token))
            {
                await JS.InvokeVoidAsync("downloadWithAuth", url, token, $"project-{Id}.zip");
            }
            else
            {
                await JS.InvokeVoidAsync("window.open", url, "_blank");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError("خطا در دانلود: " + ex.Message);
        }
    }

    private async Task LoadProject()
    {
        isLoading = true;
        try
        {
            project = await Http.GetFromJsonAsync<ProjectDto>($"api/projects/{Id}");
            if (project != null)
            {
                editModel = new ProjectUpsertRequest
                {
                    Name = project.Name,
                    Summary = project.Summary,
                    Description = project.Description,
                    CoverImageUrl = project.CoverImageUrl,
                    SortOrder = project.SortOrder,
                    IsActive = project.IsActive
                };
            }
        }
        catch (Exception ex) { ToastService.ShowError("خطا: " + ex.Message); }
        finally { isLoading = false; }
    }

    private async Task SaveInfo()
    {
        if (isSaving) return;
        isSaving = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"api/projects/{Id}", editModel);
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("ذخیره شد");
                await LoadProject();
            }
            else ToastService.ShowError("خطا در ذخیره");
        }
        catch { ToastService.ShowError("خطای ارتباط"); }
        finally { isSaving = false; }
    }

    private async Task AddImage()
    {
        if (string.IsNullOrEmpty(newImageUrl) || isAddingImage) return;
        isAddingImage = true;
        StateHasChanged();
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/projects/{Id}/images", new ProjectImageAddRequest
            {
                ImageUrl = newImageUrl,
                Caption = newImageCaption,
                SortOrder = newImageSort
            });
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("عکس اضافه شد");
                newImageUrl = null; newImageCaption = null; newImageSort = 0;
                await LoadProject();
            }
        }
        catch { ToastService.ShowError("خطا"); }
        finally { isAddingImage = false; StateHasChanged(); }
    }

    private async Task DeleteImage(int imageId)
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/projects/{Id}/images/{imageId}");
            if (resp.IsSuccessStatusCode) { ToastService.ShowSuccess("حذف شد"); await LoadProject(); }
        }
        catch { ToastService.ShowError("خطا"); }
    }

    private async Task AddFile()
    {
        if (string.IsNullOrEmpty(newFileUrl) || string.IsNullOrWhiteSpace(newFileTitle) || isAddingFile) return;
        isAddingFile = true;
        StateHasChanged();
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/projects/{Id}/files", new ProjectFileAddRequest
            {
                FileUrl = newFileUrl,
                FileName = newFileTitle,
                FileType = Enum.Parse<ProjectFileType>(newFileType),
                Version = newFileVersion,
                Description = newFileDesc
            });
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("فایل اضافه شد");
                newFileUrl = null; newFileTitle = null; newFileVersion = null; newFileDesc = null;
                await LoadProject();
            }
        }
        catch { ToastService.ShowError("خطا"); }
        finally { isAddingFile = false; StateHasChanged(); }
    }

    private async Task DeleteFile(int fileId)
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/projects/{Id}/files/{fileId}");
            if (resp.IsSuccessStatusCode) { ToastService.ShowSuccess("حذف شد"); await LoadProject(); }
        }
        catch { ToastService.ShowError("خطا"); }
    }

    private void ShowNewSection()
    {
        showSectionForm = true;
        newSectionTitle = null;
        newSectionSort = project?.Sections.Count ?? 0;
    }

    private async Task AddSection()
    {
        if (string.IsNullOrWhiteSpace(newSectionTitle)) return;
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/projects/{Id}/sections", new ProjectSectionUpsertRequest
            {
                Title = newSectionTitle,
                SortOrder = newSectionSort
            });
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("بخش اضافه شد");
                showSectionForm = false;
                await LoadProject();
            }
        }
        catch { ToastService.ShowError("خطا"); }
    }

    private async Task DeleteSection(int sectionId)
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/projects/{Id}/sections/{sectionId}");
            if (resp.IsSuccessStatusCode) { ToastService.ShowSuccess("حذف شد"); await LoadProject(); }
        }
        catch { ToastService.ShowError("خطا"); }
    }

    private void StartAddItem(int sectionId)
    {
        activeSectionId = sectionId;
        showItemForm = true;
        newItemType = "Text"; newItemText = null; newItemMediaUrl = null; newItemDesc = null;
    }

    private async Task AddSectionItem(int sectionId)
    {
        try
        {
            var resp = await Http.PostAsJsonAsync($"api/projects/{Id}/sections/{sectionId}/items", new ProjectSectionItemAddRequest
            {
                ItemType = Enum.Parse<SectionItemType>(newItemType),
                TextContent = newItemText,
                MediaUrl = newItemMediaUrl,
                Description = newItemDesc,
                SortOrder = 0
            });
            if (resp.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("آیتم اضافه شد");
                showItemForm = false;
                await LoadProject();
            }
        }
        catch { ToastService.ShowError("خطا"); }
    }

    private async Task DeleteSectionItem(int sectionId, int itemId)
    {
        try
        {
            var resp = await Http.DeleteAsync($"api/projects/{Id}/sections/{sectionId}/items/{itemId}");
            if (resp.IsSuccessStatusCode) { ToastService.ShowSuccess("حذف شد"); await LoadProject(); }
        }
        catch { ToastService.ShowError("خطا"); }
    }

    private static string GetFileTypeLabel(ProjectFileType t) => t switch
    {
        ProjectFileType.Document => "سند",
        ProjectFileType.Pcb => "PCB",
        ProjectFileType.Map => "نقشه",
        ProjectFileType.CoverImage => "جلد",
        _ => "متفرقه"
    };
}
