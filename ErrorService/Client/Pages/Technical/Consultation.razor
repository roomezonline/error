    private async Task OnAttachmentSelected(InputFileChangeEventArgs e)
    {
        imageError = null;
        var file = e.File;
        if (file == null) return;

        if (file.Size > 10 * 1024 * 1024)
        {
            imageError = "حجم فایل زیاد است (حداکثر 10MB)";
            return;
        }

        isSubmitting = true;
        try {
            var content = new MultipartFormDataContent();
            var fileContent = new StreamContent(file.OpenReadStream(10 * 1024 * 1024));
            fileContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(fileContent, "file", file.Name);

            var resp = await Http.PostAsync("api/technical/tickets/upload-attachment", content);
            if (resp.IsSuccessStatusCode) {
                var result = await resp.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null) {
                    if (file.ContentType.StartsWith("image/")) {
                        newTicket.ImageUrl = result.Url;
                        imagePreviewUrl = result.Url;
                    } else {
                        newTicket.FileUrl = result.Url;
                        newTicket.FileName = result.Name;
                        newTicket.FileContentType = result.ContentType;
                    }
                }
            } else {
                imageError = "خطا در آپلود فایل";
            }
        } catch {
            imageError = "خطا در ارتباط با سرور";
        }
        isSubmitting = false;
    }

    private class UploadResult {
        public string Url { get; set; } = "";
        public string Name { get; set; } = "";
        public string ContentType { get; set; } = "";
    }
}
