@using ErrorService.Shared
@using System.Net.Http.Json
@inject HttpClient Http

@if (items == null)
{
    <div class="container my-4" dir="rtl">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex align-items-center justify-content-center gap-3">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="fw-bold">در حال بارگذاری مشتریان...</div>
            </div>
        </div>
    </div>
}
else if (items.Count == 0)
{
    <div></div>
}
else
{
    <div class="container my-4" dir="rtl">
        <div class="customers-card shadow-sm rounded-4">
            <div class="customers-card__header">
                <div class="customers-card__title">
                    همکاران ما
                    <span class="customers-card__spark">✨</span>
                </div>
                <CarouselControls TrackId="home-customers-track" />
            </div>

            <div class="customers-track" id="home-customers-track" aria-label="همکاران ما" data-auto-scroll="26">
                @foreach (var it in items)
                {
                    <a class="customer-item" href="/workshops/@it.Id" aria-label="@it.WorkshopName">
                        <div class="customer-item__card">
                            <div class="customer-item__badge">@it.OwnerFullName</div>
                            <div class="customer-item__thumb">
                                @if (!string.IsNullOrWhiteSpace(it.ImageUrl))
                                {
                                    <img class="customer-item__img" src="@ImageUrlHelper.Thumb(it.ImageUrl, 200)" alt="@it.WorkshopName" loading="lazy" decoding="async" />
                                }
                                else
                                {
                                    <img class="customer-item__img" src="/images/default-workshop.jpg" alt="@it.WorkshopName" loading="lazy" decoding="async" />
                                }
                            </div>
                            <div class="customer-item__meta">
                                <div class="customer-item__name">@it.WorkshopName</div>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
}

@code {
    private List<WorkshopDto>? items;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await Http.GetFromJsonAsync<List<WorkshopDto>>("api/workshops/customers-row");
            items ??= new();
        }
        catch
        {
            items = new();
        }
    }
}
