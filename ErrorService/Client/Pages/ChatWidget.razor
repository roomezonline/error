    private async Task CheckExistingSession()
    {
        try
        {
            var visitorId = await GetVisitorId();
            var active = await Http.GetFromJsonAsync<ChatSessionDto?>($"api/chat/active?visitorId={visitorId}");
            if (active != null)
            {
                _sessionId = active.Id;
                _userName = active.UserName ?? _userName;
                _status = ChatWidgetStatus.Active;
                if (_hub != null)
                    await _hub.InvokeAsync("JoinSession", _sessionId);
                await LoadMessages();
                StateHasChanged();
            }
        }
        catch { }
    }

    [JSInvokable]
    public async Task OnVoiceRecorded(string url)
    {
        if (string.IsNullOrEmpty(url))
        {
            if (_pendingTempIds.TryDequeue(out var failedId))
                _messages.RemoveAll(m => m.Id == failedId);
            StateHasChanged();
            return;
        }
        if (_hub != null)
        {
            var tempId = _nextTempId--;
            _pendingTempIds.Enqueue(tempId);
            _messages.Add(new ChatMessageDto
            {
                Id = tempId,
                SessionId = _sessionId,
                SenderType = ChatSenderTypeDto.User,
                MessageType = ChatMessageTypeDto.Voice,
                MediaUrl = url,
                CreatedAt = DateTime.UtcNow,
                Status = ChatMessageStatusDto.Sending
            });
            ScrollToBottom();
            StateHasChanged();
            if (_hub?.State != HubConnectionState.Connected)
            {
                await QueueOffline(_sessionId, "", ChatMessageTypeDto.Voice, url);
                return;
            }
            await _hub.InvokeAsync("SendMessage", _sessionId, "", ChatMessageTypeDto.Voice, url);
        }
    }

    private async Task ConnectHub()
    {
        if (_hub != null)
        {
            if (_hub.State == HubConnectionState.Connected) return;
            await _hub.DisposeAsync();
            _hub = null;
        }

        var visitorId = await GetVisitorId();
        _hub = new HubConnectionBuilder()
            .WithUrl(Nav.ToAbsoluteUri($"/hubs/chat?visitorId={visitorId}"))
            .WithAutomaticReconnect()
            .Build();

        _hub.On<ChatMessageDto>("NewMessage", msg =>
        {
            if (_pendingTempIds.TryDequeue(out var tempId))
                _messages.RemoveAll(m => m.Id == tempId);
            _messages.Add(msg);
            _messages.Sort((a, b) => a.CreatedAt.CompareTo(b.CreatedAt));
            if (msg.SenderType == ChatSenderTypeDto.Operator)
            {
                _operatorTyping = false;
                if (msg.SenderId != "پاسخ خودکار") _operatorRequested = true;
                _ = _hub.InvokeAsync("MarkAsRead", msg.SessionId, new List<int> { msg.Id });
            }
            if (!_isOpen && msg.SenderType != ChatSenderTypeDto.User)
            {
                _unreadCount++;
                _ = JS.InvokeVoidAsync("__chatPlayNotification");
                _ = JS.InvokeVoidAsync("__chatNotify", "پیام جدید از پشتیبانی", msg.Content ?? "مکالمه جدید");
                _ = JS.InvokeVoidAsync("__chatFlashTitle", "💬 پیام جدید");
            }
            _ = ScrollToBottom();
            InvokeAsync(StateHasChanged);
        });

        _hub.On<bool>("OperatorTyping", isTyping =>
        {
            _operatorTyping = isTyping;
            InvokeAsync(StateHasChanged);
        });

        _hub.On<int>("SessionClosed", sessionId =>
        {
            _status = ChatWidgetStatus.Closed;
            _statusMessage = "مکالمه توسط اپراتور پایان یافت.";
            _lastSessionId = _sessionId;
            _sessionId = 0;
            _showRating = true;
            _ratingValue = 0;
            _ratingComment = "";
            InvokeAsync(StateHasChanged);
        });

        _hub.On<int, List<int>>("MessagesRead", (sessionId, messageIds) =>
        {
            if (_sessionId == sessionId)
            {
                foreach (var msg in _messages.Where(m => messageIds.Contains(m.Id)))
                {
                    msg.IsRead = true;
                    msg.Status = ChatMessageStatusDto.Read;
                }
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.On<int>("PresenceChanged", count =>
        {
            _onlineAdminsCount = count;
            InvokeAsync(StateHasChanged);
        });

        _hub.On<ChatMessageDto>("MessageEdited", msg =>
        {
            var existing = _messages.FirstOrDefault(m => m.Id == msg.Id);
            if (existing != null)
            {
                existing.Content = msg.Content;
                existing.EditedAt = msg.EditedAt;
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.On<int, int>("MessageDeleted", (sessionId, messageId) =>
        {
            var existing = _messages.FirstOrDefault(m => m.Id == messageId);
            if (existing != null)
            {
                existing.IsDeleted = true;
                InvokeAsync(StateHasChanged);
            }
        });

        _hub.Reconnecting += _ => { _pendingTempIds.Clear(); _status = ChatWidgetStatus.Loading; InvokeAsync(StateHasChanged); return Task.CompletedTask; };
        _hub.Reconnected += async _ =>
        {
            _pendingTempIds.Clear();
            _messages.RemoveAll(m => m.Id < 0);
            _onlineAdminsCount = await _hub.InvokeAsync<int>("GetPresence");
            if (_sessionId > 0)
            {
                await _hub.InvokeAsync("JoinSession", _sessionId);
                await LoadMessages();
                await FlushPending();
            }
            InvokeAsync(StateHasChanged);
        };

        await _hub.StartAsync();
        _hasConnectedOnce = true;
        try { _onlineAdminsCount = await _hub.InvokeAsync<int>("GetPresence"); } catch { }
    }

    private async Task ToggleOpen()
    {
        _isOpen = !_isOpen;
        if (_isOpen)
        {
            _unreadCount = 0;
            _ = JS.InvokeVoidAsync("__chatRequestNotifyPermission");
            if (!_hasConnectedOnce)
            {
                await ConnectHub();
                await CheckExistingSession();
                await FlushPending();
            }
            else if (_sessionId > 0)
            {
                await _hub!.InvokeAsync("JoinSession", _sessionId);
                await LoadMessages();
                await FlushPending();
                await ScrollToBottom();
            }
            StateHasChanged();
        }
    }

    private async Task StartChat()
    {
        if (string.IsNullOrWhiteSpace(_userName)) return;
        if (_settings.ChatPhoneRequired && string.IsNullOrWhiteSpace(_userPhone)) return;

        await JS.InvokeVoidAsync("localStorage.setItem", "chat_user_name", _userName);
        await JS.InvokeVoidAsync("localStorage.setItem", "chat_user_phone", _userPhone);

        _status = ChatWidgetStatus.Loading;
        StateHasChanged();

        try
        {
            await ConnectHub();
            var result = await _hub!.InvokeAsync<StartChatResult>("StartChat", _userName, _userEmail, _userPhone);
            _sessionId = result.SessionId;
            _status = ChatWidgetStatus.Active;
            _statusMessage = null;
            await LoadMessages();
        }
        catch
        {
            _status = ChatWidgetStatus.Closed;
            _statusMessage = "خطا در برقراری ارتباط.";
        }
        StateHasChanged();
    }

    private async Task LoadMessages()
    {
        if (_sessionId == 0) return;
        try
        {
            var visitorId = await GetVisitorId();
            var resp = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/chat/sessions/{_sessionId}/messages?visitorId={visitorId}&take=200");
            if (resp.ValueKind == System.Text.Json.JsonValueKind.Object && resp.TryGetProperty("items", out var items))
            {
                _messages = System.Text.Json.JsonSerializer.Deserialize<List<ChatMessageDto>>(items.GetRawText(), new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
            }
            await ScrollToBottom();
        }
        catch { }

        // Mark unread operator messages as read
        var unreadIds = _messages
            .Where(m => m.SenderType == ChatSenderTypeDto.Operator && !m.IsRead)
            .Select(m => m.Id)
            .ToList();
        if (unreadIds.Count > 0 && _hub?.State == HubConnectionState.Connected)
        {
            try { await _hub.InvokeAsync("MarkAsRead", _sessionId, unreadIds); } catch { }
        }
    }

    private int _nextTempId = -1;
    private Queue<int> _pendingTempIds = new();

    private async Task SendText()
    {
        var text = _inputText.Trim();
        if (string.IsNullOrWhiteSpace(text) || _sessionId == 0) return;
        _inputText = "";
        _operatorTyping = false;

        var tempId = _nextTempId--;
        _pendingTempIds.Enqueue(tempId);
        _messages.Add(new ChatMessageDto
        {
            Id = tempId,
            SessionId = _sessionId,
            SenderType = ChatSenderTypeDto.User,
            Content = text,
            MessageType = ChatMessageTypeDto.Text,
            CreatedAt = DateTime.UtcNow,
            Status = ChatMessageStatusDto.Sending
        });
        ScrollToBottom();
        StateHasChanged();

        if (_hub == null || _hub.State != HubConnectionState.Connected)
        {
            try { if (_hub != null) await _hub.StartAsync(); } catch { }
        }
        if (_hub?.State != HubConnectionState.Connected)
        {
            await QueueOffline(_sessionId, text, ChatMessageTypeDto.Text, null);
            return;
        }

        try { await _hub.InvokeAsync("SendMessage", _sessionId, text, ChatMessageTypeDto.Text, null); }
        catch { await QueueOffline(_sessionId, text, ChatMessageTypeDto.Text, null); }
    }

    private async Task QueueOffline(int sessionId, string content, ChatMessageTypeDto type, string? mediaUrl)
    {
        try
        {
            var raw = await JS.InvokeAsync<string>("__chatLoadPending");
            var list = System.Text.Json.JsonSerializer.Deserialize<List<PendingChatItem>>(raw) ?? new();
            list.Add(new PendingChatItem
            {
                SessionId = sessionId,
                Content = content,
                MessageType = (int)type,
                MediaUrl = mediaUrl
            });
            await JS.InvokeVoidAsync("__chatSavePending", System.Text.Json.JsonSerializer.Serialize(list));
        }
        catch { }
    }

    private async Task FlushPending()
    {
        if (_hub?.State != HubConnectionState.Connected || _sessionId == 0) return;
        try
        {
            var raw = await JS.InvokeAsync<string>("__chatLoadPending");
            var list = System.Text.Json.JsonSerializer.Deserialize<List<PendingChatItem>>(raw) ?? new();
            if (list.Count == 0) return;
            var remaining = new List<PendingChatItem>();
            foreach (var item in list)
            {
                if (item.SessionId == _sessionId)
                {
                    try
                    {
                        await _hub.InvokeAsync("SendMessage", item.SessionId, item.Content,
                            (ChatMessageTypeDto)item.MessageType, item.MediaUrl);
                    }
                    catch { remaining.Add(item); }
                }
                else remaining.Add(item);
            }
            await JS.InvokeVoidAsync("__chatSavePending", System.Text.Json.JsonSerializer.Serialize(remaining));
        }
        catch { }
    }

