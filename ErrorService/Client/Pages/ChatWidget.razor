@using Microsoft.AspNetCore.SignalR.Client
@using System.Net.Http.Json
@using ErrorService.Shared
@using ErrorService.Client.Utils
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav

@if (_settingsLoaded && (!_settings.EnableOnlineChat || (!_settings.AllowGuestChat && !_isLoggedIn)))
{
    return;
}

<div class="chat-widget @(_isOpen ? "chat-open" : "") @(_onlineAdminsCount == 0 && _settingsLoaded ? "chat-offline" : "")">
    @if (!_isOpen)
    {
        <button class="chat-fab" @onclick="ToggleOpen" title="پشتیبانی آنلاین">
            <svg class="chat-fab-icon" width="28" height="28" viewBox="0 0 24 24" fill="none">
                <path d="M4 13a5.5 5.5 0 0 1 5.5-5.5h5A5.5 5.5 0 0 1 20 13v1.7a2.6 2.6 0 0 1-2.6 2.6H9.4l-3.64 2.43A.9.9 0 0 1 4 19V13Z" fill="#fff"/>
                <circle class="chat-dot1" cx="9.2" cy="11.6" r="1.15" fill="#4361ee"/>
                <circle class="chat-dot2" cx="12" cy="11.6" r="1.15" fill="#4361ee"/>
                <circle class="chat-dot3" cx="14.8" cy="11.6" r="1.15" fill="#4361ee"/>
                <path d="M12.6 2v2M11.4 3h2.4" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/>
            </svg>
            <svg class="chat-fab-ring" width="64" height="64" viewBox="0 0 64 64" fill="none"><circle cx="32" cy="32" r="29" stroke="currentColor" stroke-width="2" opacity=".35"/></svg>
            @if (_unreadCount > 0)
            {
                <span class="chat-badge">@_unreadCount</span>
            }
        </button>
    }
    else
    {
        <div class="chat-panel">
            <div class="chat-header">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold">پشتیبانی آنلاین</span>
                    <span class="bale-badge @(_onlineAdminsCount > 0 ? "online" : "")">
                        <span class="bale-dot"></span>
                        @(_onlineAdminsCount > 0 ? "اپراتور آنلاین" : "اپراتور آفلاین")
                    </span>
                </div>
                <button class="chat-header-btn" @onclick="ToggleOpen" title="بستن"><span class="oi oi-x"></span></button>
            </div>

            @if (_status == ChatWidgetStatus.UserInfo)
            {
                <div class="chat-body d-flex flex-column justify-content-center p-4">
                    <div class="text-center mb-4">
                        <div class="display-5 mb-2">💬</div>
                        <h6 class="fw-bold">شروع گفتگو</h6>
                        <p class="text-muted small mb-0">پیام شما به اپراتور ارسال می‌شود و در سریع‌ترین زمان پاسخ می‌گیرید.</p>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">نام شما</label>
                        <input class="form-control form-control-sm rounded-pill" @bind="_userName" placeholder="نام خود را وارد کنید..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">شماره تماس @(_settings.ChatPhoneRequired ? " (الزامی)" : " (اختیاری)")</label>
                        <input type="tel" class="form-control form-control-sm rounded-pill" @bind="_userPhone" placeholder="مثال: 0912 123 4567" />
                    </div>
                    <button class="btn btn-primary btn-sm rounded-pill py-2 fw-bold" @onclick="StartChat" disabled="@(string.IsNullOrWhiteSpace(_userName) || (_settings.ChatPhoneRequired && string.IsNullOrWhiteSpace(_userPhone)))">
                        شروع گفتگو
                    </button>
                </div>
            }
            else if (_status == ChatWidgetStatus.Loading)
            {
                <div class="chat-body d-flex align-items-center justify-content-center">
                    <div class="text-center">
                        <div class="spinner-border text-primary mb-2"></div>
                        <div class="text-muted small">در حال اتصال...</div>
                    </div>
                </div>
            }
            else if (_status == ChatWidgetStatus.Closed)
            {
                <div class="chat-body d-flex flex-column align-items-center justify-content-center p-4 text-center">
                    <div class="display-5 text-muted mb-3">👋</div>
                    <h6 class="fw-bold">مکالمه پایان یافت</h6>
                    <p class="text-muted small mb-3">@_statusMessage</p>
                    @if (_showRating && _lastSessionId > 0)
                    {
                        <div class="w-100 border-top pt-3 mt-1">
                            <p class="small fw-bold mb-2">امتیاز شما به این گفتگو</p>
                            <div class="d-flex justify-content-center gap-1 mb-2" style="font-size:1.6rem;">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="star @(i <= _ratingValue ? "star-on" : "")" @onclick="() => SetRating(i)" style="cursor:pointer;color:@(i <= _ratingValue ? "#f5a623" : "#ddd");transition:color .15s;">★</span>
                                }
                            </div>
                            <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="نظر شما..." @bind="_ratingComment" style="font-size:.8rem;"></textarea>
                            <button class="btn btn-primary btn-sm rounded-pill px-4 w-100" @onclick="SubmitRating" disabled="@(_ratingValue == 0)">
                                ثبت امتیاز
                            </button>
                        </div>
                    }
                    else
                    {
                        <button class="btn btn-primary btn-sm rounded-pill px-4" @onclick="RestartChat">شروع مکالمه جدید</button>
                    }
                </div>
            }
            else
            {
                <div class="chat-body" @ref="_messagesContainer">
                    @foreach (var msg in _messages)
                    {
                        if (ShouldShowDateSeparator(msg))
                        {
                            <div class="chat-date-sep">@DateSeparatorText(msg.CreatedAt)</div>
                        }
                        if (msg.IsDeleted)
                        {
                            <div class="chat-msg @(IsOpLike(msg) ? "chat-msg-op" : "chat-msg-user")">
                                <div class="chat-bubble chat-bubble-deleted">این پیام حذف شده است</div>
                            </div>
                            continue;
                        }
                        <div class="chat-msg @(IsOpLike(msg) ? "chat-msg-op" : "chat-msg-user")">
                            @if (msg.ReplyToId != null)
                            {
                                var reply = _messages.FirstOrDefault(m => m.Id == msg.ReplyToId);
                                <div class="chat-reply-quote">
                                    <span>@(reply != null && IsOpLike(reply) ? "اپراتور" : "کاربر"):</span>
                                    <span>@(string.IsNullOrWhiteSpace(reply?.Content) ? "..." : reply!.Content)</span>
                                </div>
                            }
                            @if (msg.MessageType == ChatMessageTypeDto.Text)
                            {
                                <div class="chat-bubble">@((MarkupString)LinkifyContent(msg.Content))</div>
                            }
                            else if (msg.MessageType == ChatMessageTypeDto.Image)
                            {
                                <div class="chat-bubble">
                                    <img src="@msg.MediaUrl" class="chat-media-img" alt="تصویر" loading="lazy" @onclick="() => OpenImage(msg.MediaUrl)" />
                                    @if (!string.IsNullOrEmpty(msg.Content))
                                    {
                                        <div class="mt-1 small">@msg.Content</div>
                                    }
                                </div>
                            }
                            else if (msg.MessageType == ChatMessageTypeDto.Voice)
                            {
                                <div class="chat-bubble">
                                    <audio src="@msg.MediaUrl" controls class="chat-audio" preload="metadata"></audio>
                                </div>
                            }
                            else if (msg.MessageType == ChatMessageTypeDto.File)
                            {
                                <div class="chat-bubble">
                                    <a href="@msg.MediaUrl" target="_blank" class="chat-file-link" download>
                                        <span class="oi oi-file"></span>
                                        @(!string.IsNullOrEmpty(msg.Content) ? msg.Content : "فایل")
                                    </a>
                                </div>
                            }
                            else if (msg.MessageType == ChatMessageTypeDto.System)
                            {
                                <div class="chat-bubble chat-bubble-system">@msg.Content</div>
                            }
                            <div class="chat-time">
                            @if (IsUserLike(msg))
                            {
                                @if (msg.Status == ChatMessageStatusDto.Sending)
                                {
                                    <span class="chat-status sending">⏳</span>
                                }
                                else if (msg.Status == ChatMessageStatusDto.Read)
                                {
                                    <span class="chat-status read">✓✓</span>
                                }
                                else
                                {
                                    <span class="chat-status">✓</span>
                                }
                            }
                                @if (msg.EditedAt != null)
                                {
                                    <span class="chat-edited">ویرایش‌شده</span>
                                }
                                @if (msg.SenderId == "پاسخ خودکار")
                                {
                                    <span class="chat-edited">🤖 پاسخ خودکار</span>
                                }
                                @PersianDate.ToTime(msg.CreatedAt)
                            </div>
                            @if (msg.SenderId == "پاسخ خودکار" && !_operatorRequested)
                            {
                                <button class="btn btn-sm btn-outline-secondary mt-1 chat-request-operator" @onclick="RequestOperator">درخواست گفتگو با اپراتور انسانی</button>
                            }
                        </div>
                    }
                    @if (_operatorTyping)
                    {
                        <div class="chat-msg chat-msg-op">
                            <div class="chat-bubble chat-typing"><span></span><span></span><span></span></div>
                        </div>
                    }
                </div>

                <div class="chat-footer">
                    @if (_emojiOpen)
                    {
                        <div class="chat-emoji-panel">
                            @foreach (var e in Emojis)
                            {
                                <button class="chat-emoji-btn" @onclick="() => AddEmoji(e)">@e</button>
                            }
                        </div>
                    }
                    @if (_recState == RecOrder.Recording)
                    {
                        <div class="chat-rec-timer">
                            <span class="chat-rec-dot"></span>
                            <span class="oi oi-microphone"></span>
                            <span class="chat-rec-time">@FormatDuration(_recSeconds)</span>
                            <span class="chat-rec-hint">در حال ضبط…</span>
                            <button class="chat-rec-stop" @onclick="ToggleVoice" title="توقف و بررسی"><span class="oi oi-media-stop"></span></button>
                        </div>
                    }
                    @if (_recState == RecOrder.Preview)
                    {
                        <div class="chat-rec-bar">
                            <audio src="@_pendingVoiceUrl" controls preload="metadata" class="chat-rec-audio"></audio>
                            <span class="chat-rec-info"><span class="oi oi-microphone"></span> @FormatDuration(_recSeconds)</span>
                            <div class="chat-rec-actions">
                                <button class="chat-rec-btn send" @onclick="SendPendingVoice" title="ارسال"><span class="oi oi-arrow-left"></span></button>
                                <button class="chat-rec-btn redo" @onclick="ReRecordVoice" title="ضبط مجدد"><span class="oi oi-action-redo"></span></button>
                                <button class="chat-rec-btn del" @onclick="DiscardPendingVoice" title="حذف"><span class="oi oi-x"></span></button>
                            </div>
                        </div>
                    }
                    <div class="chat-input-row">
                        <input class="chat-input" value="@_inputText" @oninput="OnInputChanged"
                               placeholder="پیام خود را بنویسید..."
                               @onkeydown="HandleKeyDown"
                               @ref="_inputRef"
                               disabled="@(_status != ChatWidgetStatus.Active)" />
                        <button class="chat-btn chat-attach-btn @(_attachOpen ? "chat-attach-active" : "")" @onclick="ToggleAttach" title="افزودن فایل، تصویر یا ایموجی" disabled="@(_status != ChatWidgetStatus.Active)">
                            <span class="oi oi-plus"></span>
                        </button>
                        @if (_attachOpen)
                        {
                            <div class="chat-attach-overlay" @onclick="CloseAttach"></div>
                            <div class="chat-attach-menu">
                                <button class="chat-attach-item" @onclick="PickImageMenu">
                                    <span class="chat-attach-ico img"><span class="oi oi-image"></span></span>
                                    <span class="chat-attach-label">
                                        <span class="chat-attach-name">ارسال تصویر</span>
                                        <span class="chat-attach-desc">عکس یا اسکرین‌شات</span>
                                    </span>
                                    <span class="oi oi-chevron-left chat-attach-arrow"></span>
                                </button>
                                <button class="chat-attach-item" @onclick="PickFileMenu">
                                    <span class="chat-attach-ico file"><span class="oi oi-paperclip"></span></span>
                                    <span class="chat-attach-label">
                                        <span class="chat-attach-name">ارسال فایل</span>
                                        <span class="chat-attach-desc">PDF، سند و سایر فایل‌ها</span>
                                    </span>
                                    <span class="oi oi-chevron-left chat-attach-arrow"></span>
                                </button>
                                @if (_voiceSupported)
                                {
                                    <button class="chat-attach-item" @onclick="PickVoiceMenu">
                                        <span class="chat-attach-ico voice"><span class="oi oi-microphone"></span></span>
                                        <span class="chat-attach-label">
                                            <span class="chat-attach-name">ضبط صدا</span>
                                            <span class="chat-attach-desc">ارسال پیام صوتی</span>
                                        </span>
                                        <span class="oi oi-chevron-left chat-attach-arrow"></span>
                                    </button>
                                }
                                <button class="chat-attach-item" @onclick="PickEmojiMenu">
                                    <span class="chat-attach-ico emoji"><span class="oi oi-smiley"></span></span>
                                    <span class="chat-attach-label">
                                        <span class="chat-attach-name">ایموجی</span>
                                        <span class="chat-attach-desc">شکلک و ایموجی</span>
                                    </span>
                                    <span class="oi oi-chevron-left chat-attach-arrow"></span>
                                </button>
                            </div>
                        }
                        <button class="chat-btn chat-btn-send" @onclick="SendText" title="ارسال" disabled="@(string.IsNullOrWhiteSpace(_inputText) || _status != ChatWidgetStatus.Active)">
                            <span class="oi oi-arrow-left"></span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(_lightboxUrl))
{
    <div class="chat-lightbox-overlay" @onclick="CloseLightbox">
        <img src="@_lightboxUrl" class="chat-lightbox-img" alt="تصویر" />
    </div>
}

<style>
    /* ── Root ── */
    .chat-widget { position: fixed; bottom: 24px; left: 20px; z-index: 9999; direction: rtl; }
    .chat-fab { width: 64px; height: 64px; border-radius: 50%; border: none; cursor: pointer; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; color: #fff; background: radial-gradient(120% 120% at 22% 14%, rgba(255,255,255,.38) 0%, rgba(255,255,255,0) 42%), linear-gradient(135deg,#0d6efd 0%,#4361ee 55%,#7c3aed 100%); box-shadow: 0 6px 24px rgba(67,97,238,.5), 0 14px 44px rgba(13,110,253,.3), inset 0 1px 0 rgba(255,255,255,.4); animation: chat-fab-in .55s cubic-bezier(.34,1.56,.64,1); transition: transform .25s cubic-bezier(.34,1.56,.64,1), box-shadow .25s; }
    .chat-fab::before { content: ''; position: absolute; top: 5%; left: 13%; width: 46%; height: 30%; border-radius: 50%; background: rgba(255,255,255,.4); filter: blur(2.5px); transform: rotate(-14deg); pointer-events: none; z-index: 1; }
    .chat-fab::after { content: ''; position: absolute; top: 0; bottom: 0; left: -60%; width: 45%; background: linear-gradient(100deg, transparent, rgba(255,255,255,.55), transparent); transform: skewX(-20deg); pointer-events: none; z-index: 1; animation: chat-shine 3.2s ease-in-out infinite; }
    .chat-fab:hover { transform: translateY(-3px) scale(1.08); box-shadow: 0 10px 34px rgba(67,97,238,.6), 0 20px 56px rgba(13,110,253,.4), inset 0 1px 0 rgba(255,255,255,.5); }
    .chat-fab:hover .chat-fab-icon { transform: scale(1.08); }
    .chat-fab:active { transform: scale(.92); box-shadow: 0 4px 14px rgba(67,97,238,.5); }
    .chat-fab-icon { position: relative; z-index: 2; transition: transform .25s; animation: chat-fab-float 3.2s ease-in-out infinite; }
    .chat-fab-ring { position: absolute; inset: 0; width: 100%; height: 100%; color: rgba(255,255,255,.4); animation: chat-ring 2.8s ease-in-out infinite; filter: drop-shadow(0 0 5px rgba(255,255,255,.55)); }
    .chat-dot1, .chat-dot2, .chat-dot3 { animation: chat-dot 1.6s ease-in-out infinite; }
    .chat-dot2 { animation-delay: .2s; }
    .chat-dot3 { animation-delay: .4s; }
    @@keyframes chat-fab-in { 0% { opacity: 0; transform: scale(.3) translateY(26px); } 60% { opacity: 1; transform: scale(1.12) translateY(-4px); } 100% { opacity: 1; transform: scale(1) translateY(0); } }
    @@keyframes chat-shine { 0% { left: -60%; } 60%, 100% { left: 130%; } }
    @@keyframes chat-fab-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-3px); } }
    @@keyframes chat-dot { 0%, 60%, 100% { opacity: .2; } 30% { opacity: 1; } }
    @@keyframes chat-badge-pop { from { transform: scale(0); } to { transform: scale(1); } }
    .chat-badge { position: absolute; top: -4px; right: -4px; background: #dc3545; color: #fff; border-radius: 50%; width: 24px; height: 24px; font-size: .72rem; font-weight: 800; display: flex; align-items: center; justify-content: center; border: 2px solid #fff; z-index: 4; box-shadow: 0 3px 10px rgba(220,53,69,.45); animation: chat-badge-pop .4s cubic-bezier(.34,1.56,.64,1); }
    @@keyframes chat-ring { 0%,100% { opacity: .45; transform: scale(1); } 50% { opacity: 0; transform: scale(1.18); } }
    .chat-panel { width: 340px; height: 520px; max-height: calc(100vh - 100px); background: #fff; border-radius: 16px; box-shadow: 0 8px 40px rgba(0,0,0,.15); display: flex; flex-direction: column; overflow: hidden; animation: chat-in .25s ease; }
    @@keyframes chat-in { from { opacity:0; transform:translateY(16px) scale(.95); } to { opacity:1; transform:translateY(0) scale(1); } }
    .chat-header { background: #0d6efd; color: #fff; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; }
    .bale-badge { display: inline-flex; align-items: center; gap: 5px; background: rgba(255,255,255,.18); color: #fff; font-size: .68rem; padding: 3px 9px; border-radius: 12px; direction: rtl; }
    .bale-dot { width: 7px; height: 7px; border-radius: 50%; background: #ffc107; box-shadow: 0 0 0 0 rgba(255,193,7,.5); animation: chat-pulse 1.8s infinite; }
    .bale-badge.online .bale-dot { background: #25d366; box-shadow: 0 0 0 0 rgba(37,211,102,.5); }
    .bale-badge.online .bale-dot { animation: chat-pulse 1.8s infinite; }
    .chat-header-btn { background: rgba(255,255,255,.15); border: none; color: #fff; width: 30px; height: 30px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: .8rem; }
    .chat-body { flex: 1; overflow-y: auto; padding: 12px; display: flex; flex-direction: column; gap: 8px; background: #f8f9fa; scroll-behavior: smooth; }
    .chat-msg { max-width: 85%; display: flex; flex-direction: column; gap: 2px; animation: msgIn .2s ease; }
    @@keyframes msgIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }
    .chat-msg-user { align-self: flex-start; }
    .chat-msg-op { align-self: flex-end; }
    .chat-bubble { padding: 10px 14px; border-radius: 16px; font-size: .85rem; line-height: 1.55; word-break: break-word; white-space: pre-wrap; }
    .chat-msg-user .chat-bubble { background: #0d6efd; color: #fff; border-bottom-left-radius: 4px; }
    .chat-msg-op .chat-bubble { background: #e9ecef; color: #212529; border-bottom-right-radius: 4px; }
    .chat-bubble-system { background: transparent; color: #6c757d; font-size: .75rem; text-align: center; padding: 4px 8px; }
    .chat-bubble-deleted { background: transparent !important; color: #adb5bd !important; font-style: italic; font-size: .72rem; }
    .chat-date-sep { align-self: center; background: #e9ecef; color: #6c757d; font-size: .62rem; padding: 2px 12px; border-radius: 12px; margin: 4px 0; }
    .chat-reply-quote { background: rgba(255,255,255,.22); border-right: 3px solid rgba(255,255,255,.8); border-radius: 8px; padding: 3px 10px; margin-bottom: 4px; display: flex; gap: 6px; font-size: .68rem; }
    .chat-msg-user .chat-reply-quote { background: #eef0f2; border-right-color: #adb5bd; }
    .chat-reply-quote span:last-child { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .chat-edited { font-size: .58rem; color: #adb5bd; margin-left: 3px; }
    .chat-time { font-size: .65rem; color: #adb5bd; padding: 4px 4px 0; display: flex; align-items: center; gap: 3px; }
    .chat-status { font-size: .6rem; font-weight: 700; color: #adb5bd; }
    .chat-status.sending { font-size: .55rem; }
    .chat-status.read { color: #0d6efd; }
    .chat-status.read::before { content: ""; }
    .chat-media-img { max-width: 200px; max-height: 180px; border-radius: 10px; cursor: pointer; }
    .chat-audio { width: 100%; min-width: 180px; height: 40px; }
    .chat-file-link { color: inherit; text-decoration: none; display: flex; align-items: center; gap: 6px; }
    .chat-typing { display: flex; gap: 4px; padding: 12px 16px; }
    .chat-typing span { width: 7px; height: 7px; border-radius: 50%; background: #6c757d; animation: chat-bounce 1.4s infinite; }
    .chat-typing span:nth-child(2) { animation-delay: .2s; }
    .chat-typing span:nth-child(3) { animation-delay: .4s; }
    @@keyframes chat-bounce { 0%,60%,100% { transform:translateY(0); } 30% { transform:translateY(-6px); } }
    .chat-footer { padding: 8px 10px; border-top: 1px solid #e9ecef; background: #fff; }
    .chat-emoji-panel { display: flex; flex-wrap: wrap; gap: 2px; max-height: 130px; overflow-y: auto; padding: 6px 4px 8px; }
    .chat-emoji-btn { background: transparent; border: none; font-size: 1.25rem; padding: 3px 5px; border-radius: 8px; cursor: pointer; transition: background .15s; flex-shrink: 0; }
    .chat-emoji-btn:hover { background: #e9ecef; }
    .chat-offline .chat-fab { filter: grayscale(.85); animation: none; }
    .chat-offline .chat-fab-ring { display: none; }
    .chat-input-row { display: flex; gap: 6px; align-items: center; flex-wrap: nowrap; position: relative; }
    .chat-input { flex: 1; min-width: 0; border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 12px 16px; font-size: .92rem; outline: none; transition: border-color .2s, box-shadow .2s; min-height: 48px; }
    .chat-input:focus { border-color: #0d6efd; box-shadow: 0 0 0 3px rgba(13,110,253,.12); }
    .chat-attach-active { background: #e7f0ff !important; color: #0d6efd !important; }
    .chat-attach-overlay { position: fixed; inset: 0; z-index: 95; }
    .chat-attach-menu { position: absolute; bottom: calc(100% + 10px); right: 0; z-index: 96; background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; box-shadow: 0 12px 32px rgba(15,23,42,.16); padding: 6px; width: 240px; animation: msgIn .18s ease; }
    .chat-attach-item { display: flex; align-items: center; gap: 10px; width: 100%; border: none; background: transparent; border-radius: 10px; padding: 9px 10px; cursor: pointer; text-align: right; transition: background .15s; }
