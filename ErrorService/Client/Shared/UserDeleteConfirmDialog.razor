@using ErrorService.Client.Services

@if (IsVisible)
{
    <div class="cd-backdrop" @onclick="Cancel">
        <div class="cd-modal" @onclick:stopPropagation>
            <div class="cd-header cd-header--danger">
                <div class="cd-icon cd-icon--danger">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18"></path>
                        <path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path>
                        <path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path>
                    </svg>
                </div>
                <div class="cd-title">@Title</div>
            </div>
            <div class="cd-body">
                <p class="cd-msg">@Message</p>
                @if (HasTransactionalRefs)
                {
                    <div class="cd-warning">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
                            <line x1="12" y1="9" x2="12" y2="13"></line>
                            <line x1="12" y1="17" x2="12.01" y2="17"></line>
                        </svg>
                        <span>این پرسنل دارای سابقه رسید/فاکتور است. حذف کامل باعث مشکل در سوابق می‌شود.</span>
                    </div>
                }
            </div>
            <div class="cd-footer cd-footer--multi">
                <button type="button" class="cd-btn cd-btn--ghost" @onclick="Cancel">انصراف</button>
                @if (HasTransactionalRefs)
                {
                    <button type="button" class="cd-btn cd-btn--warning" @onclick="Deactivate">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <rect x="1" y="6" width="22" height="12" rx="2"></rect>
                            <line x1="6" y1="12" x2="18" y2="12"></line>
                        </svg>
                        غیرفعال کردن
                    </button>
                    <button type="button" class="cd-btn cd-btn--danger" @onclick="Delete">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        حذف کامل
                    </button>
                }
                else
                {
                    <button type="button" class="cd-btn cd-btn--danger" @onclick="Delete">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16">
                            <polyline points="3 6 5 6 21 6"></polyline>
                            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                        </svg>
                        حذف کامل
                    </button>
                }
            </div>
        </div>
    </div>
}

<style>
    .cd-warning {
        display: flex; align-items: flex-start; gap: 8px;
        margin-top: 12px; padding: 12px; border-radius: 16px;
        background: rgba(255,152,0,0.1); border: 1px solid rgba(255,152,0,0.25);
        font-size: 0.82rem; font-weight: 700; color: rgba(180,83,9,1);
        line-height: 1.5; text-align: right;
    }
    .cd-warning svg { flex-shrink: 0; margin-top: 2px; }
    .cd-footer--multi {
        grid-template-columns: 1fr;
    }
    .cd-footer--multi .cd-btn--ghost {
        order: 3;
    }
    .cd-footer--multi .cd-btn--warning {
        background: linear-gradient(135deg, rgba(255,152,0,1), rgba(245,124,0,1));
        color: #fff; box-shadow: 0 18px 36px rgba(255,152,0,0.28);
    }
    .cd-footer--multi .cd-btn--warning:hover { filter: brightness(1.05); }

    @@media (min-width: 641px) {
        .cd-footer--multi {
            display: grid; grid-template-columns: 1fr 1fr;
        }
        .cd-footer--multi .cd-btn--ghost { order: 0; grid-column: 1; }
        .cd-footer--multi .cd-btn--warning { grid-column: 2; }
        .cd-footer--multi .cd-btn--danger { grid-column: 1 / -1; }
    }
</style>

@code {
    [Parameter] public string Title { get; set; } = "تایید حذف کاربر";
    [Parameter] public string Message { get; set; } = "آیا از حذف این کاربر اطمینان دارید؟";
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public bool HasTransactionalRefs { get; set; }
    [Parameter] public EventCallback<bool> OnResult { get; set; }
    [Parameter] public EventCallback OnDeactivate { get; set; }

    private async Task Cancel() => await OnResult.InvokeAsync(false);
    private async Task Delete() => await OnResult.InvokeAsync(true);
    private async Task Deactivate() => await OnDeactivate.InvokeAsync();
}
