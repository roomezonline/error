    private bool Flag(string name)
    {
        if (_shop == null) return true;
        return name switch
        {
            "reviews" => _shop.EnableProductReviews,
            "media" => _shop.EnableReviewMedia,
            "qna" => _shop.EnableProductQna,
            "specs" => _shop.EnableSpecsTable,
            "chart" => _shop.EnablePriceHistoryChart,
            "badges" => _shop.EnableProductBadges,
            "trust" => _shop.EnableTrustBar,
            "eta" => _shop.EnableDeliveryEta,
            "wishlist" => _shop.EnableWishlist,
            "stockalert" => _shop.EnableStockAlert,
            "related" => _shop.EnableRelatedProducts,
            "recent" => _shop.EnableRecentlyViewed,
            _ => true
        };
    }

    private static bool IsDiscountActive(IDiscountInfo p)
        => DiscountHelper.IsActive(p);

    private static bool IsTimedActive(IDiscountInfo p)
        => DiscountHelper.IsTimedActive(p);

    private decimal EffectivePrice => product != null
        ? DiscountHelper.GetEffectivePrice(product)
        : 0m;

    private async Task ToggleWishlist()
    {
        if (product == null) return;
        await Ws.ToggleAsync(product.Id, product.Name, product.MainImageUrl, product.Price, IsDiscountActive(product) ? product.DiscountPrice : null, product.DiscountStartDate, product.DiscountExpiryDate);
        isInWishlist = !isInWishlist;
    }

    private async Task InitActionStates()
    {
        if (product == null) return;
        isInWishlist = (await Ws.GetItemsAsync()).Any(x => x.ProductId == product.Id);
        await LoadStockAlertStateAsync();
    }

    private bool IsProductOutOfStock => product != null && (!product.IsAvailable || product.StockQuantity <= 0);

    private async Task LoadStockAlertStateAsync()
    {
        _stockAlertSubscribed = false;
        _isAuthenticated = false;
        if (product == null || !IsProductOutOfStock)
            return;

        try
        {
            var state = await AuthState.GetAuthenticationStateAsync();
            _isAuthenticated = state.User.Identity?.IsAuthenticated == true;
            if (!_isAuthenticated)
                return;

            var mine = await HttpApi.GetFromJsonAsync<StockAlertMineDto>("api/stock-alerts/mine");
            _stockAlertSubscribed = mine?.ActiveProductIds?.Contains(product.Id) == true;
        }
        catch
        {
            // Not logged in or call failed — treat as not subscribed.
        }
    }

    private async Task HandleStockAlertClick()
    {
        if (product == null || _stockAlertBusy)
            return;

        if (!_isAuthenticated)
        {
            Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}");
            return;
        }

        _stockAlertBusy = true;
        StateHasChanged();
        try
        {
            if (_stockAlertSubscribed)
            {
                var resp = await HttpApi.DeleteAsync($"api/stock-alerts/{product.Id}");
                if (resp.IsSuccessStatusCode)
                {
                    _stockAlertSubscribed = false;
                    ToastService.ShowInfo("یادآوری موجود شدن لغو شد.");
                }
                else
                {
                    ToastService.ShowError("لغو یادآوری انجام نشد؛ دوباره تلاش کنید.");
                }
            }
            else
            {
                var resp = await HttpApi.PostAsJsonAsync($"api/stock-alerts/{product.Id}", new { });
                if (resp.IsSuccessStatusCode)
                {
                    _stockAlertSubscribed = true;
                    ToastService.ShowSuccess("ثبت شد؛ هنگام موجود شدن کالا به شما اطلاع می‌دهیم.");
                    await OpenConnectModalIfNeededAsync();
                }
                else if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    _isAuthenticated = false;
                    Nav.NavigateTo($"/auth/login?returnUrl={Uri.EscapeDataString(Nav.Uri)}");
                }
                else
                {
                    var msg = await SafeReadErrorAsync(resp, "خطا در ثبت یادآوری؛ دوباره تلاش کنید.");
                    ToastService.ShowError(msg);
                }
            }
        }
        catch
        {
            ToastService.ShowError("خطا در ثبت یادآوری؛ اتصال اینترنت خود را بررسی کنید.");
        }
        finally
        {
            _stockAlertBusy = false;
            StateHasChanged();
        }
    }

    private async Task OpenConnectModalIfNeededAsync()
    {
        try
        {
            _connectChannelsLoading = true;
            var channels = await HttpApi.GetFromJsonAsync<List<MessengerConnectChannelDto>>("api/stock-alerts/connect-status");
            if (channels != null && channels.Count > 0)
            {
                _connectChannels = channels;
                _showConnectModal = true;
            }
        }
        catch
        {
            // Modal is a nice-to-have — never fail the subscribe flow because of it.
        }
        finally
        {
            _connectChannelsLoading = false;
        }
    }

    private void CloseConnectModal()
    {
        _showConnectModal = false;
    }

    private static async Task<string> SafeReadErrorAsync(HttpResponseMessage resp, string fallback)
    {
        try
        {
            var text = await resp.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(text))
                return fallback;
            using var doc = JsonDocument.Parse(text);
            if (doc.RootElement.TryGetProperty("title", out var title))
                return title.GetString() ?? fallback;
            if (doc.RootElement.ValueKind == JsonValueKind.String)
                return doc.RootElement.GetString() ?? fallback;
        }
        catch
        {
            // fall through
        }
        return fallback;
    }

    private ProductReviewSummaryDto? reviewSummary;
    private List<CommentDto> _productCommentDtos = new();

    private async Task LoadReviews()
    {
        try
        {
            reviewSummary = await HttpApi.GetFromJsonAsync<ProductReviewSummaryDto>($"api/products/{(product?.Id ?? 0)}/reviews");
            if (reviewSummary != null)
                _productCommentDtos = ConvertProductReviews(reviewSummary.Reviews);
            if (product != null)
                productJsonLd = BuildProductJsonLd(product);
        }
        catch { }
    }

    private async Task HandleProductReviewSubmit(CommentRequest req)
    {
        var prReq = new ProductReviewRequest
        {
            FullName = req.FullName,
            Email = !string.IsNullOrWhiteSpace(req.Email) ? req.Email : "guest@errorservice.ir",
            Rating = req.Rating ?? 5,
            Content = req.Content,
            MediaUrl = req.MediaUrl,
            ParentId = req.ParentId
        };
        var response = await HttpApi.PostAsJsonAsync($"api/products/{(product?.Id ?? 0)}/reviews", prReq);
        if (!response.IsSuccessStatusCode)
            throw new InvalidOperationException("خطا در ثبت نظر");
        var fresh = await HttpApi.GetFromJsonAsync<ProductReviewSummaryDto>($"api/products/{(product?.Id ?? 0)}/reviews");
        if (fresh != null)
        {
            reviewSummary = fresh;
            _productCommentDtos = ConvertProductReviews(fresh.Reviews);
        }
    }

    private static List<CommentDto> ConvertProductReviews(List<ProductReviewDto> source)
    {
        return source.Select(r => new CommentDto
        {
            Id = r.Id,
            ParentId = r.ParentId,
            FullName = r.FullName,
            Content = r.Content,
            Rating = r.Rating,
            CreatedAtFa = r.CreatedAtFa,
            MediaUrl = r.MediaUrl,
            Replies = r.Replies != null ? ConvertProductReviews(r.Replies) : new()
        }).ToList();
    }

    private double startX;
