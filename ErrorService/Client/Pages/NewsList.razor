@page "/news"
@implements IDisposable
@page "/tips"
@page "/announcements"
@page "/news/category/{CategorySlug}"
@page "/tips/category/{CategorySlug}"
@page "/announcements/category/{CategorySlug}"
@page "/news/tag/{TagSlug}"
@page "/tips/tag/{TagSlug}"
@page "/announcements/tag/{TagSlug}"
@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Shared
@using ErrorService.Client.Utils
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

<SeoHeader
    Title="@SeoTitle"
    Description="@SeoDescription"
    Keywords="@SeoKeywords"
    OgType="website" />

<section class="news-page py-5 bg-light" dir="rtl">
    <div class="container">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
            <div>
                <h1 class="fw-bold h2 m-0 mb-2">@PageHeading</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb m-0">
                        <li class="breadcrumb-item"><a href="/">خانه</a></li>
                        @if (CategorySlug != null)
                        {
                            <li class="breadcrumb-item"><a href="@ContentTypeCatalog.Route(_type)">@ContentTypeCatalog.PluralLabel(_type)</a></li>
                            <li class="breadcrumb-item active">@(CategoryTitle ?? CategorySlug)</li>
                        }
                        else if (TagSlug != null)
                        {
                            <li class="breadcrumb-item"><a href="@ContentTypeCatalog.Route(_type)">@ContentTypeCatalog.PluralLabel(_type)</a></li>
                            <li class="breadcrumb-item active">برچسب: @TagSlug</li>
                        }
                        else
                        {
                            <li class="breadcrumb-item active">@ContentTypeCatalog.PluralLabel(_type)</li>
                        }
                    </ol>
                </nav>
            </div>
            <div class="news-hub-tabs">
                @foreach (var type in EnabledTabs)
                {
                    <a href="@ContentTypeCatalog.Route(type)" class="news-hub-tab @(type == _type && CategorySlug == null && TagSlug == null ? "is-active" : null)">
                        <span class="oi @ContentTypeCatalog.Icon(type) me-1"></span>@ContentTypeCatalog.PluralLabel(type)
                    </a>
                }
            </div>
        </div>

        <div class="news-hub-toolbar card border-0 shadow-sm rounded-4 p-3 mb-4">
            <div class="d-flex flex-wrap align-items-center gap-2">
                @if (Categories.Any())
                {
                    <div class="news-hub-cats">
                        <a href="@ContentTypeCatalog.Route(_type)" class="news-cat-chip @(CategorySlug == null ? "is-active" : null)">همه</a>
                        @foreach (var cat in Categories)
                        {
                            <a href="@ContentTypeCatalog.CategoryRoute(_type, cat.Slug ?? cat.Id.ToString())"
                               class="news-cat-chip @(string.Equals(CategorySlug, cat.Slug, StringComparison.OrdinalIgnoreCase) ? "is-active" : null)">
                                @cat.Title
                                <span class="news-cat-chip__count">@cat.ContentCount</span>
                            </a>
                        }
                    </div>
                }
                <div class="ms-auto d-flex gap-2">
                    <div class="input-group input-group-sm" style="width: 240px;">
                        <input type="search" class="form-control rounded-start-3" placeholder="جستجو در @ContentTypeCatalog.PluralLabel(_type)…"
                               @bind="_query" @bind:event="oninput" @bind:after="OnSearchChanged" />
                        @if (!string.IsNullOrWhiteSpace(_query))
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="ClearSearch">×</button>
                        }
                    </div>
                    <select class="form-select form-select-sm rounded-3" style="width: 140px;" @bind="_sort" @bind:after="() => ReloadAsync()">
                        <option value="newest">جدیدترین</option>
                        <option value="oldest">قدیمی‌ترین</option>
                        <option value="views">پربازدیدترین</option>
                    </select>
                </div>
            </div>
        </div>

        @if (_items == null)
        {
            <div class="row g-4">
                @for (int i = 0; i < 6; i++)
                {
                    <div class="col-md-4">
                        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                            <div style="height:200px;background:#f0f0f0"></div>
                            <div class="card-body p-3">
                                <div style="height:15px;background:#f0f0f0;border-radius:4px" class="mb-2"></div>
                                <div style="height:15px;background:#f0f0f0;border-radius:4px;width:75%"></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (!_items.Any())
        {
            <div class="empty-state-box">
                <span class="empty-icon oi @ContentTypeCatalog.Icon(_type)"></span>
                <h4>@ContentTypeCatalog.Label(_type)ی یافت نشد</h4>
                <p>در حال حاضر محتوایی مطابق با این فیلترها برای نمایش وجود ندارد.</p>
                <a href="@ContentTypeCatalog.Route(_type)" class="btn btn-outline-primary rounded-pill px-4">نمایش همه @ContentTypeCatalog.PluralLabel(_type)</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var news in _items)
                {
                    <div class="col-md-4 reveal">
                        <div class="card news-card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                            <a href="@ContentTypeCatalog.DetailRoute(news.ContentType, news.Id, news.Slug)" class="text-decoration-none d-block">
                                <div class="news-card__img-wrap position-relative">
                                    @if (!string.IsNullOrWhiteSpace(news.ImageUrl))
                                    {
                                        <img src="@ImageUrlHelper.Thumb(news.ImageUrl, 500)" srcset="@ImageUrlHelper.SrcSet(news.ImageUrl)"
                                             sizes="(max-width: 768px) 100vw, 400px" loading="lazy" decoding="async"
                                             class="card-img-top" alt="@news.Title" />
                                    }
                                    else
                                    {
                                        <div class="news-placeholder-wrap card-img-top">
                                            <div class="news-placeholder-icon"><span class="oi oi-image"></span></div>
                                            <div class="news-placeholder-text">تصویری ثبت نشده است</div>
                                        </div>
                                    }
                                    <div class="news-card__badges position-absolute top-0 start-0 m-2 d-flex gap-1">
                                        <span class="badge rounded-pill px-2 @ContentTypeCatalog.BadgeClass(news.ContentType)">@ContentTypeCatalog.Label(news.ContentType)</span>
                                        @if (news.IsFeatured)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-2">منتخب</span>
                                        }
                                        @if (news.PinnedUntil.HasValue && news.PinnedUntil > DateTimeOffset.UtcNow)
                                        {
                                            <span class="badge bg-primary rounded-pill px-2">سنجاق</span>
                                        }
                                    </div>
                                    <div class="news-card__date position-absolute bottom-0 start-0 m-3 badge bg-primary rounded-pill px-3 shadow">
                                        <span class="small opacity-75 me-1">@PersianDate.ToTime(news.PublishedAt)</span>
                                        <span>@PersianDate.ToJalaliDate(news.PublishedAt)</span>
                                    </div>
                                </div>
                            </a>
                            <div class="card-body p-3 d-flex flex-column">
                                <a href="@ContentTypeCatalog.DetailRoute(news.ContentType, news.Id, news.Slug)" class="text-decoration-none">
                                    <h3 class="h6 fw-bold text-dark mb-2 news-card__title">@news.Title</h3>
                                </a>
                                <p class="text-muted small mb-2 news-card__summary">@news.Summary</p>
                                <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var tag in ContentTags.Split(news.Tags).Take(2))
                                        {
                                            <a href="@ContentTypeCatalog.TagRoute(news.ContentType, tag)" class="news-tag-chip">@tag</a>
                                        }
                                    </div>
                                    @if (_settings.ShowViewCount)
                                    {
                                        <span class="small text-muted"><span class="oi oi-eye me-1"></span>@news.ViewCount.ToString("N0")</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            @if (_items.Count < _totalCount)
            {
                <div class="text-center mt-4">
                    <button class="btn btn-outline-primary rounded-pill px-5" @onclick="LoadMoreAsync" disabled="@_isLoadingMore">
                        @if (_isLoadingMore)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        مشاهده بیشتر (@(_totalCount - _items.Count) مورد باقی‌مانده)
                    </button>
                </div>
            }
        }
    </div>
</section>

<style>
    .news-hub-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
    .news-hub-tab {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 8px 16px;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: #fff;
        color: #475569;
        font-size: .85rem;
        font-weight: 700;
        text-decoration: none;
        transition: all .15s ease;
    }
    .news-hub-tab:hover { border-color: #93c5fd; color: #1d4ed8; }
    .news-hub-tab.is-active { border-color: #2563eb; color: #1d4ed8; background: #eff6ff; }
    .news-hub-cats { display: flex; flex-wrap: wrap; gap: 6px; }
    .news-cat-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border: 1px solid #e2e8f0;
        border-radius: 999px;
        background: #fff;
        color: #475569;
        font-size: .8rem;
        font-weight: 700;
        text-decoration: none;
    }
    .news-cat-chip:hover { border-color: #93c5fd; color: #1d4ed8; }
    .news-cat-chip.is-active { border-color: #2563eb; color: #1d4ed8; background: #eff6ff; }
    .news-cat-chip__count { font-size: .7rem; opacity: .7; }
    .news-tag-chip {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 999px;
        background: #f1f5f9;
        color: #64748b;
        font-size: .7rem;
        font-weight: 700;
    }
    .news-card { transition: transform .3s ease, box-shadow .3s ease; }
    .news-card:hover { transform: translateY(-5px); box-shadow: 0 15px 35px rgba(0,0,0,.1) !important; }
    .news-card__img-wrap { height: 200px; overflow: hidden; }
    .news-card__img-wrap img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
    .news-card:hover img { transform: scale(1.06); }
    .news-placeholder-wrap {
        height: 100%;
        background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 8px; color: #94a3b8;
    }
    .news-placeholder-icon { font-size: 2.5rem; opacity: .5; }
    .news-placeholder-text { font-size: .75rem; font-weight: 700; }
    .news-card__title {
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden; height: 2.8em; line-height: 1.4;
    }
    .news-card__summary {
        display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;
        overflow: hidden; line-height: 1.45; min-height: 2.9em; font-size: .82rem;
    }
    .empty-state-box { text-align: center; padding: 60px 20px; }
    .empty-icon { font-size: 3rem; color: #cbd5e1; display: block; margin-bottom: 12px; }
</style>

@code {
    [Parameter] public string? CategorySlug { get; set; }
    [Parameter] public string? TagSlug { get; set; }

    [Inject] private HttpClient Http { get; set; } = default!;

    private ContentType _type = ContentType.News;
    private ContentSettingsDto _settings = new();
    private List<ContentCategoryDto> _categories = new();
    private List<NewsDto>? _items;
    private string _query = string.Empty;
    private string _sort = "newest";
    private int _skip = 0;
    private int _take = 12;
    private int _totalCount = 0;
    private bool _isLoadingMore;
    private CancellationTokenSource? _searchCts;
    private bool _needsRevealScan;

    private string? CategoryTitle => _categories
        .FirstOrDefault(c => string.Equals(c.Slug, CategorySlug, StringComparison.OrdinalIgnoreCase))?.Title;

    private IEnumerable<ContentType> EnabledTabs =>
        ContentTypeCatalog.All.Where(t => _settings.IsTypeEnabled(t));

    private IEnumerable<ContentCategoryDto> Categories => _categories;

    private string PageHeading => CategorySlug != null
        ? $"{CategoryTitle ?? CategorySlug} — {ContentTypeCatalog.PluralLabel(_type)}"
        : TagSlug != null
            ? $"برچسب: {TagSlug}"
            : ContentTypeCatalog.PluralLabel(_type);

    private string SeoTitle => $"{PageHeading} | ارورسرویس";

    private string SeoDescription => $"آخرین {ContentTypeCatalog.PluralLabel(_type)} و مطالب مرتبط با لوازم الکترونیک، قطعات الکترونیک، تجهیزات ابزار دقیق و تعمیر لوازم خانگی در ارورسرویس.";

    private string SeoKeywords => $"{ContentTypeCatalog.PluralLabel(_type)}, مطالب الکترونیک, تعمیر لوازم خانگی, ابزار دقیق";

    protected override async Task OnParametersSetAsync()
    {
        var relative = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        var segment = relative.Split('/', '?')[0].Trim().ToLowerInvariant();
        _type = ContentTypeCatalog.FromSlug(segment);

        await LoadSettingsAsync();
        await LoadCategoriesAsync();
        await ReloadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_needsRevealScan)
        {
            _needsRevealScan = false;
            try { await JS.InvokeVoidAsync("observeNewReveals"); } catch { }
        }
    }

    public void Dispose() => _searchCts?.Dispose();

    private async Task LoadSettingsAsync()
    {
        try { _settings = await Http.GetFromJsonAsync<ContentSettingsDto>("api/content/settings") ?? new(); }
        catch { _settings = new(); }
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            _categories = await Http.GetFromJsonAsync<List<ContentCategoryDto>>(
                $"api/content/categories?type={_type}") ?? new();
        }
        catch { _categories = new(); }
    }

    private async Task OnSearchChanged()
    {
        _searchCts?.Cancel();
        var cts = new CancellationTokenSource();
        _searchCts = cts;

        try { await Task.Delay(320, cts.Token); }
        catch (OperationCanceledException) { return; }

        await ReloadAsync();
    }

    private void ClearSearch()
    {
        _query = string.Empty;
        _ = ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _skip = 0;
        _take = Math.Clamp(_settings.PageSize, 1, 60);
        _items = null;
        StateHasChanged();
        await LoadPageAsync(append: false);
    }

    private Task LoadMoreAsync() => LoadPageAsync(append: true);

    private async Task LoadPageAsync(bool append)
    {
        if (append)
        {
            if (_isLoadingMore) return;
            _isLoadingMore = true;
            _skip += _take;
        }

        try
        {
            var url = $"api/news?onlyPublished=true&skip={_skip}&take={_take}&type={_type}&sort={_sort}";
            if (!string.IsNullOrWhiteSpace(CategorySlug)) url += $"&category={Uri.EscapeDataString(CategorySlug)}";
            if (!string.IsNullOrWhiteSpace(TagSlug)) url += $"&tag={Uri.EscapeDataString(TagSlug)}";
            if (!string.IsNullOrWhiteSpace(_query)) url += $"&q={Uri.EscapeDataString(_query.Trim())}";

            var response = await Http.GetAsync(url);
            if (!response.IsSuccessStatusCode)
            {
                if (!append) _items = new();
                return;
            }

            _totalCount = PaginationHeaderReader.ReadTotalCount(response);
            var data = await response.Content.ReadFromJsonAsync<List<NewsDto>>() ?? new();

            if (append && _items != null)
                _items.AddRange(data);
            else
                _items = data;

            _needsRevealScan = true;
        }
        catch
        {
            if (!append) _items = new();
        }
        finally
        {
            _isLoadingMore = false;
        }
    }
}
