@page "/admin/monitoring/my-devices"
@layout AdminLayout
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = "perm:admin.monitoring.view")]
@using ErrorService.Shared
@using System.Net.Http.Json
@inject HttpClient Http
@inject NavigationManager Navigation
@inject ErrorService.Client.Services.ToastService ToastService
@inject ErrorService.Client.Services.AdminWorkshopSelectionService AdminWorkshopSelection
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<PageTitle>دستگاه‌های مانیتورینگ من</PageTitle>

<div class="md-page" dir="rtl">
    <div class="md-topbar">
        <a class="md-topbar__back" href="/admin"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg></a>
        <div class="md-topbar__titles">
            <div class="md-topbar__kicker">پایش و مانیتورینگ</div>
            <h1 class="md-topbar__title">دستگاه‌های من</h1>
        </div>
        <button class="md-topbar__refresh" @onclick="LoadData" title="بروزرسانی">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4v6h6M23 20v-6h-6"/><path d="M20.49 9A9 9 0 005.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 013.51 15"/></svg>
        </button>
    </div>

    @if (isLoading)
    {
        <div class="md-shimmer">
            <div class="md-shimmer__card"><div class="md-shimmer__line md-shimmer__line--lg"></div><div class="md-shimmer__line md-shimmer__line--sm"></div><div class="md-shimmer__line md-shimmer__line--md"></div></div>
            <div class="md-shimmer__card"><div class="md-shimmer__line md-shimmer__line--lg"></div><div class="md-shimmer__line md-shimmer__line--sm"></div><div class="md-shimmer__line md-shimmer__line--md"></div></div>
            <div class="md-shimmer__card"><div class="md-shimmer__line md-shimmer__line--lg"></div><div class="md-shimmer__line md-shimmer__line--sm"></div><div class="md-shimmer__line md-shimmer__line--md"></div></div>
        </div>
    }
    else if (_devices == null || _devices.Count == 0)
    {
        <div class="md-empty">
            <div class="md-empty__graphic">
                <svg viewBox="0 0 120 120" width="100" height="100" fill="none" stroke="#cbd5e1" stroke-width="1.5">
                    <rect x="20" y="30" width="80" height="60" rx="10" stroke-width="2"/>
                    <rect x="35" y="42" width="50" height="8" rx="4"/>
                    <rect x="35" y="56" width="35" height="8" rx="4"/>
                    <circle cx="85" cy="75" r="12" stroke-width="2"/>
                    <path d="M81 75h8M85 71v8" stroke-width="2.5" stroke="#94a3b8"/>
                </svg>
            </div>
            <div class="md-empty__title">دستگاهی یافت نشد</div>
            <div class="md-empty__desc">هیچ دستگاه مانیتورینگی به کارگاه شما تخصیص داده نشده است</div>
            <a href="/admin" class="md-btn md-btn--primary">بازگشت به داشبورد</a>
        </div>
    }
    else
    {
        <div class="md-summary">
            <div class="md-summary__item md-summary__item--active">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span class="md-summary__num">@_devices.Count(d => d.IsActiveNow)</span>
                <span class="md-summary__lbl">فعال</span>
            </div>
            <div class="md-summary__item md-summary__item--warning">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                <span class="md-summary__num">@_devices.Count(d => d.IsExpiringSoon)</span>
                <span class="md-summary__lbl">در حال انقضا</span>
            </div>
            <div class="md-summary__item md-summary__item--danger">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
                <span class="md-summary__num">@_devices.Count(d => d.EndAt.HasValue && d.RemainingDays == 0)</span>
                <span class="md-summary__lbl">منقضی شده</span>
            </div>
        </div>

        <div class="md-list">
            @foreach (var device in _devices)
            {
                var progress = device.RemainingDays.HasValue && device.EndAt.HasValue && device.StartAt < DateTimeOffset.UtcNow
                    ? (int)Math.Clamp(100.0 * device.RemainingDays.Value / (device.EndAt.Value - device.StartAt).TotalDays * 100 / 100, 0, 100)
                    : 100;
                var pct = device.RemainingDays.HasValue ? Math.Clamp(device.RemainingDays.Value, 0, 999) : 999;
                <div class="md-card @(device.IsExpiringSoon ? "md-card--exp" : "") @(!device.IsActiveNow ? "md-card--dead" : "")">
                    <div class="md-card__accent"></div>

                    <div class="md-card__top">
                        <div class="md-card__identity">
                            <div class="md-card__icon">
                                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
                            </div>
                            <div>
                                <div class="md-card__name">@device.DeviceTitle</div>
                                <div class="md-card__code">@device.DeviceNumber</div>
                            </div>
                        </div>
                        <div class="md-card__status">
                            @if (!device.IsActiveNow)
                            {
                                <span class="md-chip md-chip--dead">منقضی شده</span>
                            }
                            else if (device.IsExpiringSoon)
                            {
                                <span class="md-chip md-chip--exp">در حال انقضا</span>
                            }
                            else
                            {
                                <span class="md-chip md-chip--live">فعال</span>
                            }
                        </div>
                    </div>

                    <div class="md-card__body">
                        <div class="md-card__ring">
                            @if (device.RemainingDays.HasValue)
                            {
                                <svg viewBox="0 0 48 48" width="48" height="48">
                                    <circle cx="24" cy="24" r="20" fill="none" stroke="#f1f5f9" stroke-width="4"/>
                                    <circle cx="24" cy="24" r="20" fill="none"
                                        stroke="currentColor" stroke-width="4" stroke-linecap="round"
                                        stroke-dasharray="125.6"
                                        stroke-dashoffset="@(125.6 - 125.6 * Math.Clamp(progress, 0, 100) / 100.0)"
                                        transform="rotate(-90 24 24)"
                                        class="md-card__ring-fill" />
                                    <text x="24" y="26" text-anchor="middle" fill="currentColor"
                                        font-size="10" font-weight="900">@pct</text>
                                </svg>
                                <span class="md-card__ring-lbl">روز</span>
                            }
                            else
                            {
                                <div class="md-card__inf">
                                    <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    <span>نامحدود</span>
                                </div>
                            }
                        </div>

                        <div class="md-card__dates">
                            <div class="md-card__date">
                                <span class="md-card__date-dot"></span>
                                <div>
                                    <div class="md-card__date-lbl">شروع</div>
                                    <div class="md-card__date-val">@device.StartDateFa</div>
                                </div>
                            </div>
                            <div class="md-card__date">
                                <span class="md-card__date-dot md-card__date-dot--end"></span>
                                <div>
                                    <div class="md-card__date-lbl">پایان</div>
                                    <div class="md-card__date-val">@(device.EndDateFa ?? "نامحدود")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="md-card__actions">
                        @if (device.HasPendingRenewal)
                        {
                            <div class="md-act md-act--pending">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                                <span>در انتظار تایید</span>
                            </div>
                        }
                        else
                        {
                            <button type="button" class="md-act md-act--renew" @onclick="() => ShowRenewalModal(device)">
                                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M1 4v6h6M23 20v-6h-6"/><path d="M20.49 9A9 9 0 005.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 013.51 15"/></svg>
                                <span>تمدید</span>
                            </button>
                        }
                        <button type="button" class="md-act md-act--history" @onclick="() => ShowHistoryModal(device.AssignmentId)">
                            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            <span>تاریخچه</span>
                        </button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (_showRenewalModal)
{
    <div class="mmd-modal-overlay" @onclick="CloseRenewalModal">
        <div class="mmd-modal" @onclick:stopPropagation>
            <div class="mmd-modal__head">
                <div class="mmd-modal__title">درخواست تمدید</div>
                <button type="button" class="mmd-btn mmd-btn--ghost" @onclick="CloseRenewalModal"><span class="oi oi-x"></span></button>
            </div>
            <div class="mmd-modal__body">
                <div class="mmd-field">
                    <label class="mmd-label">دستگاه</label>
                    <div class="mmd-static">@_renewalDevice?.DeviceTitle (@_renewalDevice?.DeviceNumber)</div>
                </div>

                <div class="mmd-field">
                    <label class="mmd-label">پلن تمدید</label>
                    @if (_plans == null)
                    {
                        <div class="mmd-loading">در حال بارگذاری پلن‌ها...</div>
                    }
                    else if (_plans.Count == 0)
                    {
                        <div class="mmd-empty-sm">هیچ پلن فعالی یافت نشد</div>
                    }
                    else
                    {
                        <div class="mmd-plan-grid">
                            @foreach (var plan in _plans)
                            {
                                <button type="button" class="mmd-plan @(_selectedPlanId == plan.Id ? "mmd-plan--active" : "")" @onclick="() => _selectedPlanId = plan.Id">
                                    <div class="mmd-plan__months">@plan.Months ماه</div>
                                    <div class="mmd-plan__price">@plan.Price.ToString("N0") تومان</div>
                                    <div class="mmd-plan__desc">@plan.Title</div>
                                </button>
                            }
                        </div>
                    }
                </div>

                <div class="mmd-field">
                    <label class="mmd-label">رسید پرداخت (اختیاری)</label>
                    <div class="mmd-file-upload">
                        @if (!string.IsNullOrEmpty(_selectedFileName))
                        {
                            <div class="mmd-file-upload__preview">
                                @if (!string.IsNullOrEmpty(_receiptPreviewUrl))
                                {
                                    <img class="mmd-file-upload__thumb" src="@_receiptPreviewUrl" alt="رسید" />
                                }
                                else
                                {
                                    <div class="mmd-file-upload__file-icon">
                                        <span class="oi oi-document"></span>
                                    </div>
                                }
                                <div class="mmd-file-upload__info">
                                    <span class="mmd-file-upload__name">@_selectedFileName</span>
                                </div>
                                <button type="button" class="mmd-file-upload__remove" @onclick="ClearSelectedFile">
                                    <span class="oi oi-x"></span>
                                </button>
                            </div>
                        }
                        else
                        {
                            <label class="mmd-file-upload__zone" for="renewalFileInput">
                                <div class="mmd-file-upload__icon">
                                    <span class="oi oi-cloud-upload"></span>
                                </div>
                                <span class="mmd-file-upload__title">انتخاب فایل</span>
                                <span class="mmd-file-upload__hint">jpg, jpeg, png, webp, pdf</span>
                            </label>
                        }
                    </div>
                    <InputFile id="renewalFileInput" OnChange="OnFileSelected" accept=".jpg,.jpeg,.png,.webp,.pdf" class="d-none" />
                </div>

                <div class="mmd-field">
                    <label class="mmd-label">توضیحات (اختیاری)</label>
                    <textarea class="mmd-textarea" @bind="_renewalNote" placeholder="توضیحات خود را وارد کنید..." rows="3"></textarea>
                </div>
            </div>
            <div class="mmd-modal__foot">
                <button type="button" class="mmd-btn mmd-btn--ghost" @onclick="CloseRenewalModal">انصراف</button>
                <button type="button" class="mmd-btn mmd-btn--primary" @onclick="SubmitRenewalRequest" disabled="@_isSubmitting">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                    }
                    ثبت درخواست
                </button>
            </div>
        </div>
    </div>
}

@if (_showHistoryModal)
{
    <div class="mmd-modal-overlay" @onclick="CloseHistoryModal">
        <div class="mmd-modal mmd-modal--wide" @onclick:stopPropagation>
            <div class="mmd-modal__head">
                <div class="mmd-modal__title">تاریخچه تمدید</div>
                <button type="button" class="mmd-btn mmd-btn--ghost" @onclick="CloseHistoryModal"><span class="oi oi-x"></span></button>
            </div>
            <div class="mmd-modal__body">
                @if (_historyLoading)
                {
                    <div class="mmd-loading"><div class="spinner-border spinner-border-sm text-primary"></div> در حال بارگذاری...</div>
                }
                else if (_historyItems == null || _historyItems.Count == 0)
                {
                    <div class="mmd-empty-sm">تاریخچه‌ای یافت نشد</div>
                }
                else
                {
                    <div class="mmd-history-table">
                        <div class="mmd-history-row mmd-history-row--head">
                            <span>تاریخ</span>
                            <span>پلن</span>
                            <span>قیمت</span>
                            <span>وضعیت</span>
                            <span>رسید</span>
                            <span>توضیحات ادمین</span>
                        </div>
                        @foreach (var item in _historyItems)
                        {
                            <div class="mmd-history-row">
                                <span class="x-small">@item.CreatedAtFa</span>
                                <span>@item.PlanMonths ماه@(!string.IsNullOrEmpty(item.PlanTitle) ? $" - {item.PlanTitle}" : "")</span>
                                <span class="mmd-price">@item.PriceAtRequest.ToString("N0") تومان</span>
                                <span>
                                    @if (item.Status == "Approved")
                                    {
                                        <span class="mmd-badge mmd-badge--success">تایید شده</span>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <span class="mmd-badge mmd-badge--danger">رد شده</span>
                                    }
                                    else
                                    {
                                        <span class="mmd-badge mmd-badge--warning">در انتظار</span>
                                    }
                                </span>
                                <span>
                                    @if (!string.IsNullOrEmpty(item.PaymentReceiptUrl))
                                    {
                                        <a href="@item.PaymentReceiptUrl" target="_blank" class="mmd-link">مشاهده</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </span>
                                <span class="x-small text-muted">@(item.AdminNote ?? "—")</span>
                            </div>
                        }
                    </div>
                }
            </div>
            <div class="mmd-modal__foot">
                <button type="button" class="mmd-btn mmd-btn--primary" @onclick="CloseHistoryModal">بستن</button>
            </div>
        </div>
    </div>
}

@code {
    private List<MyDeviceDto>? _devices;
    private bool isLoading = true;

    private bool _showRenewalModal;
    private MyDeviceDto? _renewalDevice;
    private List<MonitoringPlanDto>? _plans;
    private int _selectedPlanId;
    private string? _renewalNote;
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;
    private string? _receiptPreviewUrl;
    private bool _isSubmitting;

    private bool _showHistoryModal;
    private bool _historyLoading;
    private List<RenewalRequestDto>? _historyItems;
    private int _historyAssignmentId;

    private bool _isSuperAdmin;
    private int? _workshopId;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        _isSuperAdmin = user.IsInRole("super_admin");

        if (_isSuperAdmin)
        {
            await AdminWorkshopSelection.InitializeAsync();
            AdminWorkshopSelection.OnChanged += OnWorkshopChanged;
            _workshopId = AdminWorkshopSelection.SelectedWorkshopId;
        }
        else
        {
            var wsIdStr = user.Claims.FirstOrDefault(c => c.Type == "workshop_id")?.Value;
            if (!string.IsNullOrWhiteSpace(wsIdStr) && int.TryParse(wsIdStr, out var wsId))
                _workshopId = wsId;
        }

        await LoadData();
    }

    private void OnWorkshopChanged(int? wsId)
    {
        _workshopId = wsId;
        _ = LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        StateHasChanged();

        try
        {
            var qs = _workshopId.HasValue ? $"?workshopId={_workshopId}" : "";
            _devices = await Http.GetFromJsonAsync<List<MyDeviceDto>>($"api/monitoring-devices/my-devices{qs}");
        }
        catch
        {
            _devices = new();
            ToastService.ShowError("خطا در دریافت لیست دستگاه‌ها");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task ShowRenewalModal(MyDeviceDto device)
    {
        _renewalDevice = device;
        _renewalNote = null;
        _selectedFile = null;
        _selectedFileName = null;
        _showRenewalModal = true;
        StateHasChanged();

        try
        {
            _plans = await Http.GetFromJsonAsync<List<MonitoringPlanDto>>("api/monitoring-plans?activeOnly=true");
            if (_plans != null && _plans.Count > 0)
                _selectedPlanId = _plans[0].Id;
        }
        catch
        {
            _plans = new();
            ToastService.ShowError("خطا در دریافت پلن‌ها");
        }
    }

    private void CloseRenewalModal()
    {
        _showRenewalModal = false;
        _renewalDevice = null;
        ClearSelectedFile();
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _selectedFileName = e.File?.Name;
        if (_selectedFile != null)
        {
            try
            {
                var resized = await _selectedFile.RequestImageFileAsync("image/jpeg", 800, 800);
                using var stream = resized.OpenReadStream(maxAllowedSize: 2_000_000);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                _receiptPreviewUrl = $"data:image/jpeg;base64,{Convert.ToBase64String(ms.ToArray())}";
            }
            catch
            {
                _receiptPreviewUrl = null;
            }
        }
    }

    private void ClearSelectedFile()
    {
        _selectedFile = null;
        _selectedFileName = null;
        _receiptPreviewUrl = null;
    }

    private async Task SubmitRenewalRequest()
    {
        if (_renewalDevice == null || _selectedPlanId == 0) return;
        _isSubmitting = true;
        StateHasChanged();

        try
        {
            var content = new MultipartFormDataContent();
            content.Add(new StringContent(_selectedPlanId.ToString()), "planId");
            if (!string.IsNullOrWhiteSpace(_renewalNote))
                content.Add(new StringContent(_renewalNote), "note");

            if (_selectedFile != null)
            {
                var stream = _selectedFile.OpenReadStream(maxAllowedSize: 5_000_000);
                content.Add(new StreamContent(stream), "file", _selectedFile.Name);
            }

            var response = await Http.PostAsync($"api/monitoring-devices/assignments/{_renewalDevice.AssignmentId}/request-renewal", content);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("درخواست تمدید با موفقیت ثبت شد");
                CloseRenewalModal();
                await LoadData();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                ToastService.ShowError(err);
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا: {ex.Message}");
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }

    private async Task ShowHistoryModal(int assignmentId)
    {
        _historyAssignmentId = assignmentId;
        _showHistoryModal = true;
        _historyLoading = true;
        _historyItems = null;
        StateHasChanged();

        try
        {
            _historyItems = await Http.GetFromJsonAsync<List<RenewalRequestDto>>($"api/monitoring-devices/assignments/{assignmentId}/renewal-history");
        }
        catch
        {
            _historyItems = new();
            ToastService.ShowError("خطا در دریافت تاریخچه");
        }
        finally
        {
            _historyLoading = false;
            StateHasChanged();
        }
    }

    private void CloseHistoryModal()
    {
        _showHistoryModal = false;
        _historyItems = null;
    }

    public void Dispose()
    {
        if (_isSuperAdmin)
            AdminWorkshopSelection.OnChanged -= OnWorkshopChanged;
    }
}

<style>
    /* ══════════════════════════════════════
       MY DEVICES — Premium Dark-Surface
       ══════════════════════════════════════ */
    .md-page * { box-sizing: border-box; }
    .md-page {
        padding-bottom: 24px; font-family: 'Vazirmatn', sans-serif;
        min-height: 100%;
        background:
            radial-gradient(ellipse 120% 50% at 50% 0%, rgba(37,99,235,0.04) 0%, transparent 70%),
            radial-gradient(ellipse 100% 40% at 80% 100%, rgba(16,185,129,0.03) 0%, transparent 70%),
            linear-gradient(180deg, #f0f4f8 0%, #f8fafc 100%);
    }

    /* ── Top Bar ── */
    .md-topbar {
        display: flex; align-items: center; gap: 12px; margin-bottom: 22px;
        padding-top: 4px;
    }
