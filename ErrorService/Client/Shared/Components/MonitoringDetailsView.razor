    private static string LerpColor(string from, string to, double t)
    {
        var (r1, g1, b1) = ParseHex(from);
        var (r2, g2, b2) = ParseHex(to);
        var r = (int)(r1 + (r2 - r1) * t);
        var g = (int)(g1 + (g2 - g1) * t);
        var b = (int)(b1 + (b2 - b1) * t);
        return $"#{r:X2}{g:X2}{b:X2}";
    }
    private static (int, int, int) ParseHex(string hex)
    {
        hex = hex.TrimStart('#');
        return (Convert.ToInt32(hex[..2], 16), Convert.ToInt32(hex[2..4], 16), Convert.ToInt32(hex[4..6], 16));
    }
