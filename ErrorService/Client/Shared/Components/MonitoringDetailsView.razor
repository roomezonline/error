                            <stop offset="0%" stop-color="#0ea5e9" /><stop offset="100%" stop-color="#3b82f6" />
                        </linearGradient>
                    </defs>
                </svg>
                <div class="md-ring-val">
                    <span class="md-ring-num">@ringCurrent.ToString("F2")</span>
