                    <span>آپلود فایل CSV</span>
                    <button class="md-modal-close" @onclick="CloseCsvUpload">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="18" height="18">
                            <path d="M18 6L6 18M6 6l12 12" />
                        </svg>
                    </button>
                </div>
                <div class="md-modal-body" style="text-align:center; padding:24px 20px;">
                    <div style="font-size:40px; margin-bottom:12px; color:#f59e0b;">⚠️</div>
                    <div style="font-size:14px; font-weight:700; color:#1E2A3A; margin-bottom:8px;">دیتای جزییات این مانیتورینگ در سیستم موجود نیست</div>
                    <div style="font-size:12px; color:#6B7A8A; line-height:1.7; margin-bottom:16px;">
                        دیتای ریز این مانیتورینگ از دیتابیس حذف شده است.<br />
