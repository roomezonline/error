    private async Task HandleFallbackUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        _uploadingImage = true;
        try
        {
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            using var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var resp = await Http.PostAsync($"{ApiBase}/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                var url = (await resp.Content.ReadAsStringAsync()).Trim('"');
                _sourceForm.FallbackImageUrl = url;
                _sourceForm.ImageMode = "OwnFallback";
                Toast.ShowSuccess("تصویر اختصاصی آپلود شد.");
            }
            else
