@using ErrorService.Shared
@using System.Net.Http.Json
@using ErrorService.Client.Helpers
@using ErrorService.Client.Services
@inject HttpClient Http
@inject CartService CartService
@inject ToastService ToastService

@if (_items != null && _items.Any())
{
    <section class="pr-row home-section bg-light" dir="rtl">
        <div class="container-fluid px-2 px-md-4">
            <div class="home-head px-2">
                <div class="home-head__heading">
                    <h2 class="home-head__title">@Title</h2>
                    @if (!string.IsNullOrWhiteSpace(Subtitle))
                    {
                        <p class="pr-row__sub">@Subtitle</p>
                    }
                </div>
                <div class="home-head__actions">
                    <a href="/products" class="home-more">مشاهده همه <span class="oi oi-arrow-left" aria-hidden="true"></span></a>
                    <CarouselControls TrackId="@_trackId" />
                </div>
            </div>

            <div class="pr-row__scroll" id="@_trackId">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var prod = _items[i];
                    <div class="pr-row__item" @key="prod.Id">
                        <ProductCard Product="prod" Variant="row" Index="i" />
                    </div>
                }
            </div>
        </div>
    </section>
}


@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Endpoint { get; set; } = "";
    [Parameter] public int Take { get; set; } = 8;

    private List<ProductDto>? _items;
    private readonly string _trackId = "pr-row-" + Guid.NewGuid().ToString("N").Substring(0, 8);

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrWhiteSpace(Endpoint)) return;
        try
        {
            var sep = Endpoint.Contains('?') ? "&" : "?";
            _items = await Http.GetFromJsonAsync<List<ProductDto>>($"{Endpoint}{sep}take={Take}") ?? new();
        }
        catch
        {
            _items = new List<ProductDto>();
        }
    }

    private async Task Add(ProductDto product)
    {
        try
        {
            await CartService.AddToCartAsync(product, 1);
            ToastService.ShowSuccess("به سبد خرید اضافه شد");
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"خطا در افزودن به سبد: {ex.Message}");
        }
    }
}
