@using ErrorService.Shared
@using Microsoft.JSInterop

@if (Categories != null && Categories.Any())
{
    <section class="home-categories" dir="rtl">
        <div class="container">
            <div class="categories-scroll-wrapper" @ref="scrollWrapper">
                <div class="categories-grid">
                    @foreach (var cat in Categories.OrderBy(x => x.SortOrder))
                    {
                        <a href="/products?categoryId=@cat.Id" class="category-item-link">
                            <div class="category-circle-wrapper">
                                <div class="category-circle">
                                    @if (!string.IsNullOrEmpty(cat.Icon))
                                    {
                                        if (cat.Icon.StartsWith("/") || cat.Icon.StartsWith("http"))
                                        {
                                            <img src="@cat.Icon" loading="lazy" decoding="async" alt="@(string.IsNullOrWhiteSpace(cat.Name) ? "Home appliance category" : cat.Name)" class="category-img" />
                                        }
                                        else
                                        {
                                            <i class="oi @cat.Icon"></i>
                                        }
                                    }
                                    else
                                    {
                                        <span class="oi oi-grid-three-up"></span>
                                    }
                                </div>
                            </div>
                            <span class="category-name">@cat.Name</span>
                        </a>
                    }
                </div>
            </div>
        </div>
    </section>
}


@code {
    [Parameter] public List<CategoryDto>? Categories { get; set; }
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private ElementReference scrollWrapper;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Categories != null && Categories.Any())
        {
            await JS.InvokeVoidAsync("initDragScroll", scrollWrapper);
        }
    }
}
