    private async Task TestModel(string modelChoice)
    {
        var model = modelChoice == "__custom__" ? (_siteAiModel?.Trim() ?? "") : modelChoice;
        if (string.IsNullOrWhiteSpace(model))
        {
            _modelTests[modelChoice] = new ModelTestState { Ok = false, Message = "ابتدا نام مدل سفارشی را وارد کنید." };
            StateHasChanged();
            return;
        }

        _modelTests[modelChoice] = new ModelTestState { Busy = true };
        StateHasChanged();
        try
        {
            var resp = await Http.PostAsJsonAsync("api/chat/ai-test", new
            {
                model,
                apiUrl = _siteAiApiUrl,
                apiKey = _siteAiApiKey,
                temperature = _siteAiTemperature,
                maxTokens = _siteAiMaxTokens
            });
            var json = await resp.Content.ReadFromJsonAsync<JsonElement>();
            var ok = json.TryGetProperty("success", out var s) && s.GetBoolean();
            var msg = json.TryGetProperty("message", out var m) ? m.GetString() ?? "" : "";
            var ms = json.TryGetProperty("elapsedMs", out var e) && e.ValueKind == JsonValueKind.Number ? e.GetInt64() : 0;
            var reply = json.TryGetProperty("reply", out var r) && r.ValueKind == JsonValueKind.String ? r.GetString() : null;
            _modelTests[modelChoice] = new ModelTestState { Busy = false, Ok = ok, Message = msg, Ms = ms, Reply = reply };
        }
        catch
        {
            _modelTests[modelChoice] = new ModelTestState { Busy = false, Ok = false, Message = "خطا در ارتباط با سرور." };
        }
        StateHasChanged();
    }

