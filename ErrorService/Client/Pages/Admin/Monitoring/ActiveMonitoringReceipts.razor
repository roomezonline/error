                {
                    var cap = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/monitoring-receipts/workshop-capacity?workshopId={capWorkshopId.Value}");
                    _workshopUsed = cap.GetProperty("used").GetInt32();
                    _workshopMax = cap.GetProperty("max").GetInt32();
                }
                catch { }
            }
            else if (items?.Count > 0)
            {
                var firstWs = items.FirstOrDefault()?.WorkshopId;
                if (firstWs.HasValue)
                {
                    try
                    {
                        var cap = await Http.GetFromJsonAsync<System.Text.Json.JsonElement>($"api/monitoring-receipts/workshop-capacity?workshopId={firstWs.Value}");
                        _workshopUsed = cap.GetProperty("used").GetInt32();
                        _workshopMax = cap.GetProperty("max").GetInt32();
                    }
                    catch { }
                }
            }
        }
        catch
        {
            ToastService.ShowError("خطا در دریافت لیست");
            items = new();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenPhoto(string? url)
    {
        photoUrl = url;
        isPhotoOpen = true;
    }

    private void ClosePhoto()
    {
        isPhotoOpen = false;
        photoUrl = null;
    }

    private void ConfirmEnd(MonitoringReceiptConnectionDto item)
    {
        if (item.IsPoweredOn)
        {
            ToastService.ShowError("برق دستگاه وصل است. لطفاً ابتدا برق دستگاه را قطع کنید.");
            return;
        }
        toEnd = item;
        showConfirmEnd = true;
    }

    private void CancelEnd()
    {
        showConfirmEnd = false;
        _endReason = "";
    }

    private async Task HandleEndResult()
    {
        showConfirmEnd = false;
        if (toEnd == null || string.IsNullOrWhiteSpace(_endReason)) return;
        var reason = _endReason.Trim();
        _endReason = "";
        try
        {
            var res = await Http.PostAsJsonAsync($"api/monitoring-receipts/{toEnd.Id}/end", new { endReason = reason });
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("مانیتورینگ با موفقیت پایان یافت");
                await Reload();
            }
            else
            {
                var msg = await res.Content.ReadAsStringAsync();
                ToastService.ShowError(string.IsNullOrWhiteSpace(msg) ? "خطا در پایان مانیتورینگ" : msg.Trim('"'));
            }
        }
        catch
        {
            ToastService.ShowError("خطای سیستمی");
        }
    }

    private void GoToDetails(MonitoringReceiptConnectionDto it)
    {
        var qs = $"?id={it.Id}&customerReceiptId={it.CustomerReceiptId}&customerName={Uri.EscapeDataString(it.CustomerFullName)}" +
                 $"&customerMobile={Uri.EscapeDataString(it.CustomerMobile)}&deviceTitle={Uri.EscapeDataString(it.CustomerDeviceTitle)}" +
                 $"&problemDescription={Uri.EscapeDataString(it.ProblemDescription)}&monitoringDeviceTitle={Uri.EscapeDataString(it.MonitoringDeviceTitle)}" +
                 $"&workshopName={Uri.EscapeDataString(it.WorkshopName)}&createdAtFa={Uri.EscapeDataString(it.CreatedAtFa)}" +
                 $"&createdByUserName={Uri.EscapeDataString(it.CreatedByUserName ?? "")}" +
                 $"&code={Uri.EscapeDataString(it.MonitoringDeviceNumber)}";
        Navigation.NavigateTo($"/admin/monitoring/details{qs}");
    }

    private void ConfirmDelete(MonitoringReceiptConnectionDto item)
    {
        if (item.IsPoweredOn)
        {
            ToastService.ShowError("برق دستگاه وصل است. لطفاً ابتدا برق دستگاه را قطع کنید.");
            return;
        }
        toDelete = item;
        showConfirmDelete = true;
    }

    private async Task HandleDeleteResult(bool confirmed)
    {
        showConfirmDelete = false;
        if (!confirmed || toDelete == null) return;
        try
        {
            var res = await Http.DeleteAsync($"api/monitoring-receipts/{toDelete.Id}/hard");
            if (res.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("مانیتورینگ با موفقیت حذف شد");
                await Reload();
            }
            else
            {
                ToastService.ShowError("خطا در حذف مانیتورینگ");
            }
        }
        catch
        {
            ToastService.ShowError("خطای سیستمی");
        }
    }
}