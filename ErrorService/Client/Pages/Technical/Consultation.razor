@page "/technical/consultation"
@using ErrorService.Shared.Models
@inject HttpClient Http
@inject ErrorService.Client.Services.ThemeService Theme
@inject ErrorService.Client.Services.ToastService Toast

<PageTitle>مشاوره فنی | ارورسرویس</PageTitle>

<SeoHeader 
    Title="سیستم مشاوره فنی تعمیرات لوازم خانگی | ارورسرویس"
    Description="ارسال سوال فنی و دریافت پاسخ از متخصصین تعمیرات لوازم خانگی. مشاوره رایگان عیب‌یابی"
    Keywords="مشاوره فنی, مشاوره تعمیرات, سوال فنی لوازم خانگی"
    OgType="website" />

<div class="container py-4">
    <div class="text-center mb-5">
        <h2 class="fw-black text-primary mb-2">سیستم مشاوره فنی</h2>
        <p class="text-muted">ارسال سوال فنی و دریافت پاسخ از متخصصین تعمیرات</p>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="sticky-top" style="top: 130px;">
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4" style="background: var(--app-surface);">
                    <h5 class="fw-bold mb-3">ثبت تیکت جدید</h5>
                    <EditForm Model="newTicket" OnValidSubmit="HandleSubmit">
                        <DataAnnotationsValidator />
                        <div class="mb-3">
                            <label class="form-label small fw-bold">موضوع</label>
                            <InputText class="form-control custom-input" @bind-Value="newTicket.Title" placeholder="عنوان کوتاه موضوع" />
                            <ValidationMessage For="@(() => newTicket.Title)" class="text-danger small" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label small fw-bold">شرح دقیق مشکل</label>
                            <InputTextArea class="form-control custom-input" @bind-Value="newTicket.Description" rows="4" placeholder="علائم خرابی و اقدامات انجام شده را بنویسید..." />
                            <ValidationMessage For="@(() => newTicket.Description)" class="text-danger small" />
                        </div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold">آپلود مستندات (تصویر یا فایل)</label>

                            <div class="image-upload-drop rounded-4 p-3 position-relative">
                                <div class="d-flex align-items-center justify-content-between mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="oi oi-paperclip text-primary"></span>
                                        <span class="small fw-bold">تصویر، ویدیو یا فایل فنی</span>
                                    </div>

                                    <span class="upload-chip">حداکثر 10MB</span>
                                </div>

                                <div class="text-center py-2">
                                    @if (!string.IsNullOrWhiteSpace(imagePreviewUrl))
                                    {
                                        <div class="position-relative d-inline-block">
                                            <img src="@imagePreviewUrl" class="img-fluid rounded-4 border" style="max-height: 150px;" />
                                            <button type="button" class="btn btn-sm btn-danger rounded-circle position-absolute top-0 start-0 m-n2 shadow-sm" @onclick="ClearSelectedImage" style="width:24px;height:24px;padding:0;line-height:1;">&times;</button>
                                        </div>
                                    }
                                    
                                    @if (!string.IsNullOrWhiteSpace(newTicket.FileUrl))
                                    {
                                        <div class="bg-white border rounded-3 p-2 d-flex align-items-center gap-2 mt-2 shadow-sm">
                                            <span class="oi oi-file text-primary"></span>
                                            <span class="small text-truncate flex-grow-1" style="max-width: 180px;">@newTicket.FileName</span>
                                            <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => { newTicket.FileUrl = null; newTicket.FileName = null; }">
                                                <span class="oi oi-trash"></span>
                                            </button>
                                        </div>
                                    }

                                    @if (string.IsNullOrWhiteSpace(imagePreviewUrl) && string.IsNullOrWhiteSpace(newTicket.FileUrl))
                                    {
                                        <div class="text-muted small py-2">برای انتخاب فایل یا تصویر کلیک کنید</div>
                                    }
                                </div>

                                <InputFile OnChange="OnAttachmentSelected" class="file-overlay" />
                            </div>

                            @if (!string.IsNullOrWhiteSpace(imageError))
                            {
                                <div class="text-danger small mt-2">@imageError</div>
                            }
                        </div>
                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" disabled="@isSubmitting">
                            @if (isSubmitting)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            ثبت درخواست مشاوره
                        </button>
                    </EditForm>
                </div>

                <div class="card border-0 shadow-sm rounded-4 p-4 text-center bg-primary-subtle border-primary">
                    <span class="oi oi-info text-primary display-6 mb-3"></span>
                    <h6 class="fw-bold text-primary">پاسخگویی سریع</h6>
                    <p class="small text-muted mb-0">متخصصین ما در کمتر از ۲۴ ساعت به تیکت‌های شما پاسخ می‌دهند.</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <h5 class="fw-bold mb-4 d-flex align-items-center">
                <span class="oi oi-list-rich me-2 text-primary"></span>
                تاریخچه مشاوره‌های شما
            </h5>

            @if (selectedTicket == null)
            {
                @if (isLoading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status"></div>
                    </div>
                }
                else if (showGuestHistoryPrompt)
                {
                    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
                        <div class="mb-3">
                            <span class="oi oi-lock-locked display-4 text-warning opacity-50"></span>
                        </div>
                        <h6 class="fw-bold mb-2">برای مشاهده تاریخچه تیکت‌ها وارد شوید</h6>
                        <p class="small text-muted mb-4">برای پیگیری مشاوره‌های قبلی خود نیاز به حساب کاربری دارید.</p>
                        <div class="d-flex justify-content-center gap-2">
                            <a class="btn btn-primary btn-sm rounded-pill px-4" href="/auth/login">ورود به حساب</a>
                            <a class="btn btn-outline-primary btn-sm rounded-pill px-4" href="/auth/register">ثبت‌نام سریع</a>
                        </div>
                    </div>
                }
                else if (!myTickets.Any())
                {
                    <div class="text-center py-5 bg-white rounded-4 shadow-sm border opacity-50">
                        <span class="oi oi-chat display-3 mb-3 text-muted"></span>
                        <h5>هنوز تیکتی ثبت نکرده‌اید</h5>
                        <p class="small">اولین مشاوره فنی خود را از پنل سمت راست ثبت کنید.</p>
                    </div>
                }
                else
                {
                    <div class="d-flex flex-column gap-3">
                        @foreach (var ticket in myTickets)
                        {
                            <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: var(--app-surface);">
                                <div class="p-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="d-flex align-items-center gap-2 overflow-hidden flex-grow-1">
                                            @if (!ticket.IsUserRead)
                                            {
                                                <span class="badge rounded-pill bg-danger shadow-sm flex-shrink-0" style="font-size: 0.6rem;">پاسخ جدید</span>
                                            }
                                            <div class="overflow-hidden">
                                                <h6 class="fw-bold mb-1 text-truncate">@ticket.Title</h6>
                                                <span class="small text-muted">@FormatJalaliDateTime(ticket.CreatedAt)</span>
                                            </div>
                                        </div>
                                        <span class="badge @GetTicketStatusClass(ticket) rounded-pill px-3 py-2 flex-shrink-0 ms-2">
                                            @GetTicketStatusLabel(ticket)
                                        </span>
                                    </div>
                                    <p class="small text-muted mb-3 text-truncate-2">@ticket.Description</p>
                                    
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="avatar-sm rounded-circle bg-light border">شما</div>
                                            @if (ticket.Replies.Any(r => r.IsAdmin))
                                            {
                                                <div class="avatar-sm rounded-circle bg-primary text-white border">تیم</div>
                                            }
                                        </div>
                                        <button class="btn btn-outline-primary btn-sm rounded-pill px-4" @onclick="() => SelectTicket(ticket)">
                                            مشاهده و گفتگو
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden" style="background: var(--app-surface);">
                    <div class="p-4 border-bottom bg-white d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-3">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" @onclick="BackToTickets">
                                بازگشت
                            </button>
                            <div>
                                <div class="fw-bold">@selectedTicket.Title</div>
                                <div class="small text-muted">@GetStatusLabel(selectedTicket.Status)</div>
                            </div>
                        </div>
                        <span class="badge @GetStatusClass(selectedTicket.Status) rounded-pill px-3 py-2">
                            @GetStatusLabel(selectedTicket.Status)
                        </span>
                    </div>

                    <div class="p-4 bg-light-subtle" style="max-height: 60vh; overflow: auto;">
                        <div class="d-flex gap-3 mb-4">
                            <div class="avatar-md bg-secondary text-white rounded-circle flex-shrink-0 text-center pt-2">شما</div>
                            <div class="chat-bubble user w-100">
                                <p class="mb-0">@selectedTicket.Description</p>
                                @if (!string.IsNullOrEmpty(selectedTicket.ImageUrl))
                                {
                                    <a href="@selectedTicket.ImageUrl" target="_blank">
                                        <img src="@selectedTicket.ImageUrl" class="img-fluid rounded-3 mt-3 border shadow-sm" style="max-height: 250px;" />
                                    </a>
                                }
                                
                                @if (!string.IsNullOrEmpty(selectedTicket.FileUrl))
                                {
                                    <div class="mt-3 p-2 bg-light rounded-3 border d-flex align-items-center gap-3">
                                        <div class="bg-primary bg-opacity-10 p-2 rounded-3">
                                            <span class="oi oi-file text-primary"></span>
                                        </div>
                                        <div class="flex-grow-1 overflow-hidden">
                                            <div class="small fw-bold text-truncate">@selectedTicket.FileName</div>
                                            <div class="smaller text-muted">@selectedTicket.FileContentType</div>
                                        </div>
                                        <a href="@selectedTicket.FileUrl" target="_blank" class="btn btn-sm btn-outline-primary rounded-pill">
                                            <span class="oi oi-cloud-download"></span>
                                        </a>
                                    </div>
                                }

                                <div class="chat-meta">@FormatJalaliDateTime(selectedTicket.CreatedAt)</div>
                            </div>
                        </div>

                        @foreach (var reply in selectedTicket.Replies)
                        {
                            <div class="d-flex gap-3 mb-4 @(reply.IsAdmin ? "flex-row-reverse" : "")">
                                <div class="avatar-md @(reply.IsAdmin ? "bg-primary" : "bg-secondary") text-white rounded-circle flex-shrink-0 text-center pt-2">
                                    @(reply.IsAdmin ? "ادمین" : "شما")
                                </div>
                                <div class="chat-bubble @(reply.IsAdmin ? "admin" : "user") w-100">
                                    <p class="mb-1">@reply.Message</p>
                                    
                                    @if (!string.IsNullOrEmpty(reply.AttachmentUrl))
                                    {
                                        <div class="mt-2 p-2 @(reply.IsAdmin ? "bg-white bg-opacity-50" : "bg-light") rounded-3 border d-flex align-items-center gap-2">
                                            <span class="oi @(reply.AttachmentContentType?.StartsWith("image/") == true ? "oi-image" : "oi-file") text-primary"></span>
                                            <span class="small text-truncate flex-grow-1">@reply.AttachmentName</span>
                                            <a href="@reply.AttachmentUrl" target="_blank" class="btn btn-sm btn-link p-0">
                                                <span class="oi oi-cloud-download"></span>
                                            </a>
                                        </div>
                                    }

                                    <div class="d-flex justify-content-between align-items-center mt-2">
                                        <span class="smaller text-muted">@(reply.IsAdmin ? "تیم پشتیبانی" : "شما")</span>
                                        <span class="chat-meta">@FormatJalaliDateTime(reply.RepliedAt)</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="p-4 bg-white border-top">
                        @if (!string.IsNullOrEmpty(replyAttachmentUrl))
                        {
                            <div class="bg-light border rounded-3 p-2 mb-2 d-flex align-items-center gap-2 shadow-sm">
                                <span class="oi oi-paperclip text-primary"></span>
                                <span class="small text-truncate flex-grow-1">@replyAttachmentName</span>
                                <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="() => { replyAttachmentUrl = null; }">
                                    <span class="oi oi-trash"></span>
                                </button>
                            </div>
                        }
                        <div class="input-group">
                            <label class="btn btn-outline-secondary px-3 m-0 d-flex align-items-center justify-content-center" style="border-radius: 0 12px 12px 0;">
                                <span class="oi oi-paperclip"></span>
                                <InputFile OnChange="OnReplyAttachmentSelected" class="d-none" />
                            </label>
                            <input type="text" class="form-control custom-input border-start-0 border-end-0" placeholder="پاسخ خود را بنویسید..." @bind="replyMessage" />
                            <button class="btn btn-primary px-4 fw-bold" @onclick="SendReply" disabled="@(string.IsNullOrEmpty(replyMessage) || isSubmitting)" style="border-radius: 12px 0 0 12px;">
                                @if (isSubmitting) { <span class="spinner-border spinner-border-sm"></span> }
                                ارسال
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .custom-input {
        border-radius: 12px;
        padding: 10px 15px;
        background: var(--app-bg);
        border: 1px solid var(--app-border);
        color: var(--app-text);
    }
    .custom-input:focus {
        background: var(--app-surface);
        border-color: var(--app-primary);
        box-shadow: 0 0 0 0.25rem rgba(37, 99, 235, 0.1);
    }
    .image-upload-drop {
        border: 2px dashed var(--app-border) !important;
        background: rgba(37, 99, 235, 0.03);
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .image-upload-drop:hover {
        border-color: var(--app-primary) !important;
        background: rgba(37, 99, 235, 0.06);
    }
    .upload-chip {
        font-size: 0.72rem;
        font-weight: 800;
        line-height: 1;
        padding: 6px 10px;
        border-radius: 999px;
        background: #fff;
        border: 1px dashed rgba(2, 6, 23, 0.18);
        color: var(--app-text-muted);
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
    }
    .file-overlay {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        cursor: pointer;
    }
    .bg-primary-subtle { background: rgba(37, 99, 235, 0.05) !important; }
    .avatar-sm {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
        font-weight: 800;
        white-space: nowrap;
        padding: 0;
        flex: 0 0 auto;
    }
    .avatar-md { width: 45px; height: 45px; font-weight: bold; }

    .chat-bubble {
        border-radius: 18px;
        padding: 12px 14px;
        box-shadow: 0 10px 24px rgba(2,6,23,0.06);
    }

    .chat-bubble.user {
        background: #fff;
        border: 1px solid rgba(2,6,23,0.08);
    }

    .chat-bubble.admin {
        background: rgba(37, 99, 235, 0.10);
        border: 1px solid rgba(37, 99, 235, 0.25);
    }

    .chat-meta{
        font-size: 0.72rem;
        color: rgba(2,6,23,0.55);
        margin-top: 6px;
        text-align: left;
        direction: ltr;
        white-space: nowrap;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .smaller { font-size: 0.7rem; }
    .ms-n2 { margin-right: -8px; }
</style>

@code {
    private ConsultationTicket newTicket = new();
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private List<ConsultationTicket> myTickets = new();
    private ConsultationTicket? selectedTicket;
    private string replyMessage = "";
    private bool isLoading = true;
    private bool isSubmitting = false;
    private bool showGuestHistoryPrompt = false;

    private Microsoft.AspNetCore.Components.Forms.IBrowserFile? selectedImage;
    private string? imagePreviewUrl;
    private string? imageError;

    private const long MaxImageBytes = 2 * 1024 * 1024; // 2MB
    private static readonly string[] AllowedContentTypes = new[] { "image/jpeg", "image/png", "image/webp" };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        showGuestHistoryPrompt = false;
        try {
            var resp = await Http.GetAsync("api/technical/tickets/my");

            if (resp.StatusCode == System.Net.HttpStatusCode.Unauthorized || resp.StatusCode == System.Net.HttpStatusCode.Forbidden)
            {
                showGuestHistoryPrompt = true;
                myTickets = new();
            }
            else if (resp.IsSuccessStatusCode)
            {
                myTickets = await resp.Content.ReadFromJsonAsync<List<ConsultationTicket>>() ?? new();
            }
            else
            {
                Toast.ShowError("خطا در بارگذاری تاریخچه مشاوره‌ها");
                myTickets = new();
            }
        } catch {
            Toast.ShowError("خطا در بارگذاری تاریخچه مشاوره‌ها");
            myTickets = new();
        }
        isLoading = false;
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        imageError = null;
        selectedImage = null;
        imagePreviewUrl = null;

        var file = e.File;
        if (file == null) return;

        if (!AllowedContentTypes.Contains(file.ContentType))
        {
            imageError = "فرمت تصویر مجاز نیست. فقط JPG / PNG / WEBP";
            return;
        }

        if (file.Size > MaxImageBytes)
        {
            imageError = "حجم تصویر زیاد است. حداکثر 2MB";
            return;
        }

        selectedImage = file;

        var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
        var base64 = Convert.ToBase64String(bytes);
        imagePreviewUrl = $"data:{file.ContentType};base64,{base64}";
    }

    private void ClearSelectedImage()
    {
        selectedImage = null;
        imagePreviewUrl = null;
        imageError = null;
    }

    private async Task<string?> UploadTicketImage(Microsoft.AspNetCore.Components.Forms.IBrowserFile file)
    {
        var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
        var content = new MultipartFormDataContent();
        var byteContent = new ByteArrayContent(bytes);
        byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
        content.Add(byteContent, "file", file.Name);

        var resp = await Http.PostAsync("api/technical/tickets/upload-image", content);
        if (!resp.IsSuccessStatusCode)
            throw new Exception("آپلود تصویر ناموفق بود");

        return await resp.Content.ReadAsStringAsync();
    }

    private async Task HandleSubmit()
    {
        isSubmitting = true;
        try {
            if (selectedImage != null)
            {
                var imageUrl = await UploadTicketImage(selectedImage);
                newTicket.ImageUrl = imageUrl?.Trim('"');
            }

            var response = await Http.PostAsJsonAsync("api/technical/tickets", newTicket);
            if (response.IsSuccessStatusCode) {
                newTicket = new ConsultationTicket();
                ClearSelectedImage();
                await LoadData();
                Toast.ShowSuccess("تیکت شما با موفقیت ثبت شد.");
            }
        } catch (Exception ex) {
            Toast.ShowError(ex.Message);
        }
        isSubmitting = false;
    }

    private static string FormatJalaliDateTime(DateTime dt)
    {
        if (dt == default || dt == DateTime.MinValue || dt.Year < 1000) return "---";
        var pc = new System.Globalization.PersianCalendar();
        try {
            var y = pc.GetYear(dt);
            var m = pc.GetMonth(dt);
            var d = pc.GetDayOfMonth(dt);
            return $"{dt:HH:mm}  {y:0000}/{m:00}/{d:00}";
        } catch {
            return "---";
        }
    }

    private async Task SelectTicket(ConsultationTicket ticket)
    {
        selectedTicket = ticket;
        if (!ticket.IsUserRead)
        {
            try
            {
                var resp = await Http.PostAsync($"api/technical/tickets/{ticket.Id}/read-user", null);
                if (resp.IsSuccessStatusCode)
                {
                    ticket.IsUserRead = true;
                }
            }
            catch { /* ignore */ }
        }
    }

    private string? replyAttachmentUrl;
    private string? replyAttachmentName;
    private string? replyAttachmentType;

    private async Task OnReplyAttachmentSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isSubmitting = true;
        try {
            var bytes = await ImageCompressionHelper.CompressIfNeededAsync(file, JS);
            var content = new MultipartFormDataContent();
            var byteContent = new ByteArrayContent(bytes);
            byteContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(file.ContentType);
            content.Add(byteContent, "file", file.Name);

            var resp = await Http.PostAsync("api/technical/tickets/upload-attachment", content);
            if (resp.IsSuccessStatusCode) {
                var result = await resp.Content.ReadFromJsonAsync<UploadResult>();
                if (result != null) {
                    replyAttachmentUrl = result.Url;
                    replyAttachmentName = result.Name;
                    replyAttachmentType = result.ContentType;
                    Toast.ShowInfo("فایل پیوست شد");
                }
            }
        } catch {
            Toast.ShowError("خطا در آپلود فایل");
        }
        isSubmitting = false;
    }

    private async Task SendReply()
    {
        if (selectedTicket == null || string.IsNullOrEmpty(replyMessage)) return;
        
        isSubmitting = true;
        try {
            var reply = new TicketReply { 
                Message = replyMessage, 
                IsAdmin = false,
                AttachmentUrl = replyAttachmentUrl,
                AttachmentName = replyAttachmentName,
                AttachmentContentType = replyAttachmentType
            };
            var response = await Http.PostAsJsonAsync($"api/technical/tickets/{selectedTicket.Id}/reply", reply);
            if (response.IsSuccessStatusCode) {
                var newReply = await response.Content.ReadFromJsonAsync<TicketReply>();
                if (newReply != null)
                {
                    selectedTicket.Replies.Add(newReply);
                }
                replyMessage = "";
                replyAttachmentUrl = null;
                replyAttachmentName = null;
                replyAttachmentType = null;
                Toast.ShowInfo("پاسخ شما ثبت شد.");
            }
        } catch {
            Toast.ShowError("خطا در ارسال پاسخ");
        }
        isSubmitting = false;
    }

    private string GetStatusClass(TicketStatus status)
    {
        if (status == TicketStatus.Pending)
            return (selectedTicket?.Replies?.Count ?? 0) > 0 ? "bg-primary text-white" : "bg-warning text-dark";

        return status switch
        {
            TicketStatus.InProgress => "bg-danger text-white",
            TicketStatus.Resolved => "bg-success text-white",
            TicketStatus.Closed => "bg-secondary text-white",
            _ => "bg-light"
        };
    }

