@page "/admin/chat"
@layout AdminLayout
@attribute [Authorize(Policy = "perm:admin.chat.manage")]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@using System.Net.Http.Json
@using ErrorService.Shared
@using ErrorService.Client.Services
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AuthService Auth
@implements IAsyncDisposable

<PageTitle>گفتگوها | ارورسرویس</PageTitle>

<ConfirmDialog IsVisible="showConfirmDelete"
               Title="حذف مکالمه"
               Message="آیا از حذف این مکالمه و تمام پیام‌های آن اطمینان دارید؟"
               OnResult="HandleDeleteResult" />

<div class="chat-app">
    @* --- Mobile overlay --- *@
    @if (_showMobileSidebar)
    {
        <div class="chat-overlay" @onclick="() => _showMobileSidebar = false"></div>
    }

    @* --- Settings modal (tabbed) --- *@
    @if (_showSettings)
    {
        <div class="settings-backdrop" @onclick="() => _showSettings = false"></div>
        <div class="settings-modal">
            <div class="settings-head">
                <h6 class="m-0 fw-bold">تنظیمات چت</h6>
                <button class="btn-close-sm" @onclick="() => _showSettings = false"></button>
            </div>

            <div class="settings-tabs">
                <button class="settings-tab @(_settingsTab == "general" ? "active" : "")" @onclick='() => SetSettingsTab("general")'>
                    <span class="oi oi-wrench"></span> عمومی چت
                </button>
                <button class="settings-tab @(_settingsTab == "bale" ? "active" : "")" @onclick='() => SetSettingsTab("bale")'>
                    <span class="oi oi-chat"></span> بله
                </button>
                <button class="settings-tab @(_settingsTab == "telegram" ? "active" : "")" @onclick='() => SetSettingsTab("telegram")'>
                    <span class="oi oi-paper-plane"></span> تلگرام
                </button>
                <button class="settings-tab @(_settingsTab == "ai" ? "active" : "")" @onclick='() => SetSettingsTab("ai")'>
                    <span class="oi oi-lightbulb"></span> هوش مصنوعی
                </button>
            </div>

            <div class="settings-body">

                @* ======== عمومی چت ======== *@
                @if (_settingsTab == "general")
                {
                    <div class="settings-card">
                        <div class="settings-card-title">پیام خوش‌آمدگویی</div>
                        <textarea class="form-control form-control-sm" rows="2" @bind="_siteWelcomeMessage" placeholder="مثلاً: سلام! چطور می‌توانم کمکتان کنم؟"></textarea>
                    </div>

                    <div class="settings-card">
                        <div class="switch-row">
                            <div class="switch-text">
                                <div class="switch-title">پیام یادآور خودکار</div>
                                <div class="switch-desc">اگر اپراتور پاسخ نداد، پس از مدت تعیین‌شده پیام یادآور ارسال شود.</div>
                            </div>
                            <label class="chat-switch">
                                <input type="checkbox" @bind="_siteEnableAutoMessage" />
                                <span class="chat-slider"></span>
                            </label>
                        </div>
                        @if (_siteEnableAutoMessage)
                        {
                            <div class="field-block">
                                <label class="field-label">مدت انتظار (ثانیه)</label>
                                <input type="number" min="5" class="form-control form-control-sm" @bind="_siteAutoMessageSeconds" />
                            </div>
                        }
                    </div>

                    <div class="settings-card">
                        <div class="switch-row">
                            <div class="switch-text">
                                <div class="switch-title">الزام شماره تماس</div>
                                <div class="switch-desc">کاربر برای شروع گفتگو باید شماره موبایل خود را وارد کند.</div>
                            </div>
                            <label class="chat-switch">
                                <input type="checkbox" @bind="_sitePhoneRequired" />
                                <span class="chat-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="settings-actions">
                        <button class="btn btn-success btn-sm" @onclick="SaveAllSettings" disabled="@(_settingsLoading || _savingSiteSettings || _savingSettings)">
                            @if (_savingSiteSettings || _savingSettings) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            ذخیره تنظیمات
                        </button>
                    </div>
                }

                @* ======== بله ======== *@
                @if (_settingsTab == "bale")
                {
                    <div class="settings-card">
                        <div class="switch-row">
                            <div class="switch-text">
                                <div class="switch-title">فعال‌سازی چت بله</div>
                                <div class="switch-desc">شامل دریافت پیام‌های کاربران از ربات بله.</div>
                            </div>
                            <label class="chat-switch">
                                <input type="checkbox" @bind="_siteEnableBale" />
                                <span class="chat-slider"></span>
                            </label>
                        </div>

                        <div class="field-block">
                            <label class="field-label">توکن ربات بله</label>
                            <input type="password" class="form-control form-control-sm" @bind="_baleToken" placeholder="توکن ربات بله" />
                        </div>
                        <div class="field-block">
                            <label class="field-label">شناسه گروه بله</label>
                            <input type="text" class="form-control form-control-sm" @bind="_baleGroupId" placeholder="-123456789" />
                        </div>
                        <div class="field-block">
                            <label class="field-label">توکن وب‌هوک (اختیاری)</label>
                            <input type="text" class="form-control form-control-sm" @bind="_webhookSecret" placeholder="webhook_secret" />
                        </div>
                        @if (!string.IsNullOrEmpty(_webhookUrl))
                        {
                            <div class="info-chip">
                                <div class="fw-bold mb-1">آدرس وب‌هوک</div>
                                <code class="d-block text-break" dir="ltr">@_webhookUrl</code>
                            </div>
                        }

                        <div class="btn-row">
                            <button class="btn btn-primary btn-sm" @onclick="SaveBaleSettings" disabled="@_savingSettings">
                                @if (_savingSettings) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                ذخیره
                            </button>
                            <button class="btn btn-outline-secondary btn-sm" @onclick="TestBaleConnection">تست اتصال</button>
                            <button class="btn btn-outline-info btn-sm" @onclick="SetWebhook" disabled="@_settingWebhook">
                                @if (_settingWebhook) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                ثبت وب‌هوک
                            </button>
                        </div>
                        @if (!string.IsNullOrEmpty(_settingsMessage))
                        {
                            <div class="alert @(_settingsSuccess ? "alert-success" : "alert-danger") py-2 small mb-0">@_settingsMessage</div>
                        }

                        <div class="sub-sep">وضعیت وب‌هوک</div>
                        <div class="d-flex align-items-center justify-content-between mb-2">
                            <small class="text-muted">آخرین بررسی ثبت وب‌هوک</small>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CheckWebhookStatus" disabled="@_checkingWebhookStatus">
                                @if (_checkingWebhookStatus) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                بررسی
                            </button>
                        </div>
                        @if (_webhookStatusChecked)
                        {
                            <div class="p-2 rounded-3 small @(_webhookStatusRegistered ? "bg-success bg-opacity-10" : "bg-warning bg-opacity-10")">
                                @if (_webhookStatusRegistered)
                                {
                                    <div class="text-success fw-bold">وب‌هوک ثبت شده</div>
                                    <code class="d-block mt-1 text-break" dir="ltr">@_webhookStatusUrl</code>
                                    if (!string.IsNullOrEmpty(_webhookUrl) && _webhookStatusUrl != _webhookUrl)
                                    {
                                        <div class="text-danger mt-1">آدرس ثبت‌شده با آدرس فعلی مطابقت ندارد</div>
                                    }
                                }
                                else
                                {
                                    <div class="text-warning fw-bold">وب‌هوک ثبت نشده</div>
                                    <div class="text-muted mt-1">دکمه «ثبت وب‌هوک» را بزنید</div>
                                }
                            </div>
                        }
                    </div>

                    <div class="settings-card">
                        <div class="switch-row">
                            <div class="switch-text">
                                <div class="switch-title">ارسال اعلان از طریق بله</div>
                            </div>
                            <label class="chat-switch">
                                <input type="checkbox" @bind="_siteNotifyBale" />
                                <span class="chat-slider"></span>
                            </label>
                        </div>
                        @if (_siteNotifyBale)
                        {
                            <div class="field-block">
                                <label class="field-label">کلید دسترسی سفیر (Api Access Key)</label>
                                <input type="password" class="form-control form-control-sm" @bind="_siteBaleSafirKey" placeholder="از پنل کسب‌وکار بله (business.bale.ai)" />
                                <div class="form-text small">برای ارسال بله به شماره موبایل کاربران لازم است از بخش «سفیر» پنل کسب‌وکار بله دریافت شود؛ در صورت نداشتن کلید، اعلان بله برای کاربرانی که شماره را در ربات فرستاده‌اند از خود ربات ارسال می‌شود.</div>
                            </div>
                        }
                    </div>

                    <div class="settings-actions">
                        <button class="btn btn-success btn-sm" @onclick="SaveAllSettings" disabled="@(_settingsLoading || _savingSiteSettings || _savingSettings)">
                            @if (_savingSiteSettings || _savingSettings) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            ذخیره تنظیمات
                        </button>
                    </div>
                }

                @* ======== تلگرام ======== *@
                @if (_settingsTab == "telegram")
                {
                    <div class="settings-card">
                        <div class="switch-row">
                            <div class="switch-text">
                                <div class="switch-title">فعال‌سازی چت تلگرام</div>
                                <div class="switch-desc">دریافت و ارسال پیام از طریق ربات تلگرام.</div>
                            </div>
                            <label class="chat-switch">
                                <input type="checkbox" @bind="_siteEnableTelegram" />
                                <span class="chat-slider"></span>
                            </label>
                        </div>

                        @if (_siteEnableTelegram)
                        {
                            <div class="field-block">
                                <label class="field-label">توکن ربات تلگرام</label>
                                <input type="password" class="form-control form-control-sm" @bind="_siteTelegramToken" placeholder="123456:ABC..." />
                            </div>
                            <div class="field-block">
                                <label class="field-label">شناسه گروه تلگرام</label>
                                <input type="text" class="form-control form-control-sm" @bind="_siteTelegramGroupId" placeholder="-100123456789" />
                            </div>
                        }
                    </div>

                    <div class="settings-card">
                        <div class="switch-row">
                            <div class="switch-text">
                                <div class="switch-title">ارسال اعلان از طریق تلگرام</div>
                            </div>
                            <label class="chat-switch">
                                <input type="checkbox" @bind="_siteNotifyTelegram" />
                                <span class="chat-slider"></span>
                            </label>
                        </div>
                    </div>

                    <div class="settings-actions">
                        <button class="btn btn-success btn-sm" @onclick="SaveAllSettings" disabled="@(_settingsLoading || _savingSiteSettings || _savingSettings)">
                            @if (_savingSiteSettings || _savingSettings) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            ذخیره تنظیمات
                        </button>
                    </div>
                }

                @* ======== هوش مصنوعی ======== *@
                @if (_settingsTab == "ai")
                {
                    <div class="settings-card accent">
                        <div class="switch-row">
                            <div class="switch-text">
                                <div class="switch-title">فعال بودن دستیار هوشمند</div>
                                <div class="switch-desc">دستیار همیشه در ابتدای گفتگو فعال است و تا زمان پاسخ انسان به کاربر کمک می‌کند؛ با اولین پاسخ اپراتور یا درخواست اپراتور انسانی کنار می‌رود.</div>
                            </div>
                            <label class="chat-switch">
                                <input type="checkbox" @bind="_siteEnableAi" />
                                <span class="chat-slider"></span>
                            </label>
                        </div>

                        <div class="info-chip">
                            بدون تنظیم URL و کلید، فقط به سوالات پرتکرار (FAQ) پاسخ داده می‌شود.
                        </div>
                    </div>

                    @if (_siteEnableAi)
                    {
                        <div class="settings-card">
                            <div class="settings-card-title ai-title-row">
                                <span><span class="oi oi-graph"></span> مصرف و اعتبار</span>
                                <button class="mini-btn" @onclick="LoadAiStats" disabled="@_aiStatsLoading">
                                    @(_aiStatsLoading ? "در حال بارگذاری..." : "به‌روزرسانی")
                                </button>
                            </div>

                            <div class="ai-stats">
                                <div class="ai-stat"><b>@(_aiUsage?.todayAiReplies ?? 0)</b><span>پاسخ امروز</span></div>
                                <div class="ai-stat"><b>@(_aiUsage?.totalAiReplies ?? 0)</b><span>پاسخ کل</span></div>
                                <div class="ai-stat"><b>@(_aiUsage?.last30AiReplies ?? 0)</b><span>۳۰ روز اخیر</span></div>
                                <div class="ai-stat"><b>@(_aiUsage?.sessionsWithAi ?? 0)</b><span>مکالمه</span></div>
                                <div class="ai-stat"><b>@(_aiUsage?.memberAiReplies ?? 0)</b><span>اعضا</span></div>
                                <div class="ai-stat"><b>@(_aiUsage?.guestAiReplies ?? 0)</b><span>مهمان‌ها</span></div>
                            </div>

                            @if (_aiUsage != null)
                            {
                                <div class="ai-quota">
                                    <div class="ai-quota-row">
                                        <span>سقف روزانه هر عضو</span>
                                        <b>@(_aiUsage.dailyLimit <= 0 ? "غیرفعال" : $"{_aiUsage.dailyLimit} پاسخ")</b>
                                    </div>
                                    <div class="ai-quota-row">
                                        <span>سقف هر مکالمه</span>
                                        <b>@(_aiUsage.sessionLimit <= 0 ? "نامحدود" : $"{_aiUsage.sessionLimit} پاسخ")</b>
                                    </div>
                                    <div class="ai-quota-row">
                                        <span>امروز کل پیام‌های چت</span>
                                        <b>@_aiUsage.allMessagesToday</b>
                                    </div>
                                </div>
                            }

                            <div class="ai-credits @(_aiCreditsLoading ? "loading" : "")">
                                <div class="ai-credits-head">
                                    <span><span class="oi oi-credit-card"></span> اعتبار API</span>
                                    <button class="mini-btn" @onclick="LoadAiCredits" disabled="@_aiCreditsLoading">
                                        @(_aiCreditsLoading ? "در حال استعلام..." : "استعلام")
                                    </button>
                                </div>

                                @if (_aiCreditsLoading)
                                {
                                    <div class="ai-credits-note"><span class="spinner-border spinner-border-sm"></span> در حال استعلام اعتبار از سرویس‌دهنده...</div>
                                }
                                else if (_aiCredits == null)
                                {
                                    <div class="ai-credits-note">هنوز استعلام نشده است. برای دیدن اعتبار باقی‌مانده دکمه «استعلام» را بزنید.</div>
                                }
                                else if (!_aiCredits.ok)
                                {
                                    <div class="ai-credits-note warn">@(_aiCredits.message ?? "استعلام انجام نشد.")</div>
                                }
                                else
                                {
                                    <div class="ai-credits-grid">
                                        <div class="ai-credit ok"><b dir="ltr">@_aiCredits.remaining.ToString("0.####")</b><span>باقی‌مانده (@_aiCredits.currency)</span></div>
                                        <div class="ai-credit used"><b dir="ltr">@_aiCredits.totalUsage.ToString("0.####")</b><span>مصرف‌شده (@_aiCredits.currency)</span></div>
                                        <div class="ai-credit"><b dir="ltr">@_aiCredits.totalCredits.ToString("0.####")</b><span>کل شارژ (@_aiCredits.currency)</span></div>
                                    </div>
                                    <div class="ai-credits-bar"><div class="ai-credits-bar__fill" style="width:@(CreditsPercent)%"></div></div>
                                    @if (_aiCredits.limit is > 0)
                                    {
                                        <div class="ai-credits-note ok">سقف مجاز ماهانه: @_aiCredits.limit.Value.ToString("0.####") @_aiCredits.currency</div>
                                    }
                                }
                            </div>
                        </div>

                        <div class="settings-card">
                            <div class="settings-card-title">کنترل پرسش و پاسخ</div>

                            <div class="switch-row">
                                <div class="switch-text">
                                    <div class="switch-title">دستیار برای مهمان‌ها فعال باشد</div>
                                    <div class="switch-desc">اگر خاموش باشد، کاربران واردنشده فقط با اپراتور انسانی گفتگو می‌کنند.</div>
                                </div>
                                <label class="chat-switch">
                                    <input type="checkbox" @bind="_siteAiGuestEnabled" />
                                    <span class="chat-slider"></span>
                                </label>
                            </div>

                            <div class="field-block">
                                <label class="field-label">سقف پیام روزانه هر عضو</label>
                                <input type="number" min="0" class="form-control form-control-sm" @bind="_siteAiDailyLimit" />
                                <div class="form-text small">تعداد پاسخ‌های دستیار در هر روز برای هر کاربر عضو. مقدار ۰ یعنی غیرفعال برای اعضا. برای هر کاربر می‌توانید در «کاربران سایت» سقف جداگانه ثبت کنید.</div>
                            </div>

                            <div class="limit-grid">
                                <div class="limit-box">
                                    <label class="field-label">حداکثر طول سوال (کاراکتر)</label>
                                    <input type="number" min="50" max="4000" class="form-control form-control-sm" @bind="_siteAiMaxQuestionChars" />
                                    <div class="form-text small">سوال‌های بلندتر پردازش نمی‌شوند.</div>
                                </div>
                                <div class="limit-box">
                                    <label class="field-label">حداکثر طول پاسخ (توکن)</label>
                                    <input type="number" min="50" max="4000" class="form-control form-control-sm" @bind="_siteAiMaxTokens" />
                                    <div class="form-text small">هر چه کمتر، پاسخ کوتاه‌تر و ارزان‌تر.</div>
                                </div>
                                <div class="limit-box">
                                    <label class="field-label">سقف پاسخ در هر مکالمه</label>
                                    <input type="number" min="0" max="500" class="form-control form-control-sm" @bind="_siteAiSessionLimit" />
                                    <div class="form-text small">پس از این تعداد، نوبت اپراتور انسانی است.</div>
                                </div>
                                <div class="limit-box">
                                    <label class="field-label">خلاقیت پاسخ (۰ تا ۲)</label>
                                    <input type="number" min="0" max="2" step="0.1" class="form-control form-control-sm" @bind="_siteAiTemperature" />
                                    <div class="form-text small">۰ = دقیق و تکراری، ۱ = متعادل، ۲ = خلاق.</div>
                                </div>
                            </div>

                            <div class="field-block">
                                <label class="field-label">کلمات ممنوعه (جداسازی با کاما)</label>
                                <input type="text" class="form-control form-control-sm" @bind="_siteAiBlockKeywords" placeholder="قیمت قطعی, زمان تحویل قطعی, شماره حساب" />
                                <div class="form-text small">اگر سوال کاربر شامل یکی از این کلمات باشد، دستیار پاسخ نمی‌دهد و اپراتور انسانی وارد گفتگو می‌شود.</div>
                            </div>


                            <div class="field-block">
                                <label class="field-label">موضوعات پیشنهادی (جداسازی با کاما)</label>
                                <input type="text" class="form-control form-control-sm" @bind="_siteAiTopics" placeholder="پشتیبانی فنی و عیب‌یابی, پیگیری سفارش, راهنمای خرید و استعلام قیمت, سایر موضوعات" />
                                <div class="form-text small">این موضوعات به‌صورت دکمه بالای فیلد چت به کاربر نمایش داده می‌شود و در پیام خوش‌آمد دستیار هم فهرست می‌شود.</div>
                            </div>
                        </div>

                        <div class="settings-card">
                            <div class="settings-card-title ai-title-row">
                                <span><span class="oi oi-layers"></span> مدل فعال</span>
                                <span class="model-active-chip" dir="ltr">@(ResolveModelValue() is { Length: > 0 } v ? v : "—")</span>
                            </div>

                            <div class="model-grid">
                                @foreach (var m in AiModelOptions)
                                {
                                    var id = m.Id;
                                    <div class="model-card @(_siteAiModelChoice == id ? "sel" : "")" role="button" tabindex="0" @onclick="() => SelectModel(id)">
                                        <span class="model-check"><span class="oi oi-check"></span></span>
                                        <span class="model-name" dir="ltr">@m.Label</span>
                                        <span class="model-desc">@m.Desc</span>
                                        <span class="model-tags">
                                            <span class="model-tag">@m.Tier</span>
                                            <span class="model-tag tag-speed">@m.Speed</span>
                                        </span>
                                        <span class="model-test-row" @onclick:stopPropagation>
                                            <button type="button" class="model-test-btn" @onclick="() => TestModel(id)"
                                                    disabled="@(_modelTests.TryGetValue(id, out var t) && t.Busy)"
                                                    title="تست این مدل بدون ذخیره تنظیمات">
                                                @if (_modelTests.TryGetValue(id, out var tb) && tb.Busy)
                                                {
                                                    <span class="spinner-border spinner-border-sm"></span>
                                                    <span>در حال تست…</span>
                                                }
                                                else
                                                {
                                                    <span class="oi oi-media-play"></span>
                                                    <span>تست مدل</span>
                                                }
                                            </button>
                                            @if (_modelTests.TryGetValue(id, out var tr) && !tr.Busy && tr.Ok != null)
                                            {
                                                <span class="model-test-result @(tr.Ok == true ? "ok" : "fail")" title="@(tr.Reply ?? tr.Message)">
                                                    @(tr.Ok == true
                                                        ? $"✓ سالم ({ToFaNum(tr.Ms)}ms)"
                                                        : $"✗ {(tr.Message?.Length > 110 ? tr.Message[..110] + "…" : tr.Message)}")
                                                </span>
                                            }
                                        </span>
                                    </div>
                                }
                                <div class="model-card @(_siteAiModelChoice == "__custom__" ? "sel" : "")" role="button" tabindex="0" @onclick='() => SelectModel("__custom__")'>
                                    <span class="model-check"><span class="oi oi-check"></span></span>
                                    <span class="model-name" dir="ltr">custom</span>
                                    <span class="model-desc">نام دلخواه خود را وارد کنید (مثلاً از فهرست ارائه‌دهنده).</span>
                                    <span class="model-tags"><span class="model-tag">سفارشی</span></span>
                                    <span class="model-test-row" @onclick:stopPropagation>
                                        <button type="button" class="model-test-btn" @onclick='() => TestModel("__custom__")'
                                                disabled="@(_modelTests.TryGetValue("__custom__", out var tc) && tc.Busy)"
                                                title="تست مدل سفارشی بدون ذخیره تنظیمات">
                                            @if (_modelTests.TryGetValue("__custom__", out var tcb) && tcb.Busy)
                                            {
                                                <span class="spinner-border spinner-border-sm"></span>
                                                <span>در حال تست…</span>
                                            }
                                            else
                                            {
                                                <span class="oi oi-media-play"></span>
                                                <span>تست مدل</span>
                                            }
                                        </button>
                                        @if (_modelTests.TryGetValue("__custom__", out var tcr) && !tcr.Busy && tcr.Ok != null)
                                        {
                                            <span class="model-test-result @(tcr.Ok == true ? "ok" : "fail")" title="@(tcr.Reply ?? tcr.Message)">
                                                @(tcr.Ok == true
                                                    ? $"✓ سالم ({ToFaNum(tcr.Ms)}ms)"
                                                    : $"✗ {(tcr.Message?.Length > 110 ? tcr.Message[..110] + "…" : tcr.Message)}")
                                            </span>
                                        }
                                    </span>
                                </div>
                            </div>

                            @if (_siteAiModelChoice == "__custom__")
                            {
                                <div class="field-block">
                                    <label class="field-label">نام مدل سفارشی</label>
                                    <input type="text" class="form-control form-control-sm" dir="ltr" @bind="_siteAiModel" placeholder="gpt-4o-mini / llama-3.1-8b / ..." />
                                </div>
                            }
                        </div>

                        <div class="settings-card">
                            <div class="settings-card-title ai-title-row">
                                <span><span class="oi oi-circle-check"></span> سرویس‌دهنده‌ها و زنجیره خودکار</span>
                                <span class="d-flex gap-2">
                                    <button type="button" class="mini-btn" @onclick="TestChainAsync" disabled="@(_aiProvidersLoading || _chainTesting)">
                                        @(_chainTesting ? "در حال تست زنجیره…" : "تست زنجیره")
                                    </button>
                                    <button type="button" class="mini-btn" @onclick="SaveAiProvidersAsync" disabled="@(_aiProvidersLoading || _aiProvidersSaving)">
                                        @(_aiProvidersSaving ? "در حال ذخیره…" : "ذخیره سرویس‌دهنده‌ها")
                                    </button>
                                </span>
                            </div>

                            <div class="form-text small mb-2">
                                در صورت خطا یا اتمام سقف، زنجیره به‌صورت خودکار و بی‌صدا از سرویس‌دهنده ← کلید ← مدل بعدی استفاده می‌کند و کاربر فقط پاسخ نهایی را می‌بیند.
                            </div>

                            @if (_aiProvidersLoading)
                            {
                                <div class="text-muted small py-2"><span class="spinner-border spinner-border-sm"></span> در حال بارگذاری…</div>
                            }
                            else
                            {
                                @if (_aiProviders.Count == 0 && !string.IsNullOrWhiteSpace(_siteAiApiUrl))
                                {
                                    <div class="alert alert-info py-2 small d-flex justify-content-between align-items-center mb-2">
                                        <span>تنظیمات قدیمی (تک‌کلیدی) به‌عنوان fallback استفاده می‌شود. می‌توانید آن را به سرویس‌دهنده تبدیل کنید.</span>
                                        <button type="button" class="btn btn-outline-primary btn-sm" @onclick="SeedFromLegacyAsync" disabled="@_aiProvidersSaving">تبدیل به سرویس‌دهنده</button>
                                    </div>
                                }

                                @foreach (var p in _aiProviders)
                                {
                                    var pRef = p;
                                    <div class="ai-provider-box @(pRef.Enabled ? "" : "off")">
                                        <div class="ai-provider-head">
                                            <label class="chat-switch mb-0" title="فعال/غیرفعال">
                                                <input type="checkbox" @bind="pRef.Enabled" />
                                                <span class="chat-slider"></span>
                                            </label>
                                            <input type="text" class="form-control form-control-sm" placeholder="نام سرویس‌دهنده" @bind="pRef.Name" />
                                            <input type="text" class="form-control form-control-sm" dir="ltr" placeholder="https://openrouter.ai/api/v1" @bind="pRef.BaseUrl" />
                                            <select class="form-select form-select-sm" style="max-width:130px" @bind="pRef.Kind">
                                                <option value="openrouter">OpenRouter</option>
                                                <option value="openai">OpenAI</option>
                                                <option value="custom">سازگار OpenAI</option>
                                            </select>
                                            <span class="d-flex gap-1">
                                                <button type="button" class="icon-btn-sm" title="بالا" @onclick="() => MoveProvider(pRef, -1)"><span class="oi oi-arrow-top"></span></button>
                                                <button type="button" class="icon-btn-sm" title="پایین" @onclick="() => MoveProvider(pRef, 1)"><span class="oi oi-arrow-bottom"></span></button>
                                                <button type="button" class="icon-btn-sm text-danger" title="حذف سرویس‌دهنده" @onclick="() => RemoveProvider(pRef)"><span class="oi oi-trash"></span></button>
                                            </span>
                                        </div>

                                        @if (pRef.Kind == "openrouter")
                                        {
                                            <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
                                                <button type="button" class="btn btn-outline-success btn-sm" @onclick="() => LoadCatalogAsync(pRef)" disabled="@(pRef.CatalogLoading)">
                                                    @(pRef.CatalogLoading ? "در حال دریافت…" : "دریافت مدل‌های رایگان OpenRouter")
                                                </button>
                                                @if (pRef.CatalogMessage != null)
                                                {
                                                    <small class="text-muted">@pRef.CatalogMessage</small>
                                                }
                                            </div>
                                            @if (pRef.Catalog is { Count: > 0 })
                                            {
                                                <div class="ai-catalog">
                                                    @foreach (var c in pRef.Catalog.Take(60))
                                                    {
                                                        var cat = c;
                                                        <label class="ai-catalog-item">
                                                            <input type="checkbox" @bind="cat.Selected" />
                                                            <span dir="ltr">@cat.Id</span>
                                                            <small class="text-muted">@cat.Name</small>
                                                        </label>
                                                    }
                                                    <button type="button" class="btn btn-primary btn-sm mt-1" @onclick="() => AddSelectedCatalog(pRef)">
                                                        افزودن مدل‌های انتخاب‌شده (@pRef.Catalog.Count(x => x.Selected))
                                                    </button>
                                                </div>
                                            }
                                        }

                                        <div class="ai-sub-title">کلیدها (API Key)</div>
                                        @foreach (var k in pRef.Keys)
                                        {
                                            var kRef = k;
                                            <div class="ai-row @(kRef.Enabled ? "" : "off")">
                                                <input type="checkbox" @bind="kRef.Enabled" title="فعال" />
                                                <input type="password" class="form-control form-control-sm" dir="ltr" placeholder="sk-..." @bind="kRef.KeyValue" />
                                                <input type="text" class="form-control form-control-sm" style="max-width:130px" placeholder="برچسب (اختیاری)" @bind="kRef.Label" />
                                                <span class="ai-status-chip @(kRef.InCooldown ? "warn" : kRef.FailureCount > kRef.SuccessCount ? "bad" : "ok")"
                                                      title="@(kRef.LastError ?? "")">
                                                    @(kRef.InCooldown
                                                        ? $"کول‌داون تا {kRef.CooldownUntil:HH:mm}"
                                                        : $"✓{ToFaNum(kRef.SuccessCount)} ✗{ToFaNum(kRef.FailureCount)}")
                                                </span>
                                                <button type="button" class="icon-btn-sm text-danger" @onclick="() => pRef.Keys.Remove(kRef)"><span class="oi oi-trash"></span></button>
                                            </div>
                                        }
                                        <button type="button" class="btn btn-outline-secondary btn-sm mt-1" @onclick="() => pRef.Keys.Add(new AiKeyUi())">+ افزودن کلید</button>

                                        <div class="ai-sub-title mt-2">مدل‌ها</div>
                                        @foreach (var m in pRef.Models)
                                        {
                                            var mRef = m;
                                            <div class="ai-row @(mRef.Enabled ? "" : "off")">
                                                <input type="checkbox" @bind="mRef.Enabled" title="فعال" />
                                                <input type="text" class="form-control form-control-sm" dir="ltr" placeholder="provider/model:free" @bind="mRef.ModelId" />
                                                <input type="text" class="form-control form-control-sm" style="max-width:130px" placeholder="نام نمایشی" @bind="mRef.Label" />
                                                <span class="ai-status-chip @(mRef.InCooldown ? "warn" : mRef.FailureCount > mRef.SuccessCount ? "bad" : "ok")"
                                                      title="@(mRef.LastError ?? "")">
                                                    @(mRef.InCooldown
                                                        ? $"کول‌داون تا {mRef.CooldownUntil:HH:mm}"
                                                        : $"✓{ToFaNum(mRef.SuccessCount)} ✗{ToFaNum(mRef.FailureCount)}")
                                                </span>
                                                <button type="button" class="icon-btn-sm text-danger" @onclick="() => pRef.Models.Remove(mRef)"><span class="oi oi-trash"></span></button>
                                            </div>
                                        }
                                        <button type="button" class="btn btn-outline-secondary btn-sm mt-1" @onclick="() => pRef.Models.Add(new AiModelUi())">+ افزودن مدل</button>
                                    </div>
                                }

                                <button type="button" class="btn btn-outline-primary btn-sm mt-2" @onclick="AddProvider">
                                    <span class="oi oi-plus"></span> افزودن سرویس‌دهنده
                                </button>
                            }

                            @if (_chainTesting)
                            {
                                <div class="text-muted small mt-2"><span class="spinner-border spinner-border-sm"></span> در حال تست کاندیدها (تا ۳۰ ثانیه)…</div>
                            }
                            @if (_chainMessage != null)
                            {
                                <div class="alert @(_chainOk == true ? "alert-success" : _chainOk == false ? "alert-danger" : "alert-info") py-2 small mt-2 mb-0">@_chainMessage</div>
                            }
                            @if (_chainResults is { Count: > 0 })
                            {
                                <div class="ai-chain-results mt-2">
                                    @foreach (var r in _chainResults)
                                    {
                                        <div class="ai-chain-row @(r.Ok ? "ok" : "fail")">
                                            <span class="chain-provider">@r.Provider</span>
                                            <span class="chain-model" dir="ltr">@r.Model</span>
                                            <span class="chain-key" dir="ltr">@r.Key</span>
                                            <span class="chain-status">@r.Message</span>
                                            <span class="chain-ms">@ToFaNum(r.Ms)ms</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(_aiProvidersMessage))
                            {
                                <div class="alert @(_aiProvidersOk == true ? "alert-success" : "alert-danger") py-2 small mt-2 mb-0">@_aiProvidersMessage</div>
                            }
                        </div>

                        <div class="settings-card">
                            <div class="settings-card-title">اتصال به مدل (fallback تک‌کلیدی)</div>

                            <div class="form-text small mb-2">
                                اگر سرویس‌دهنده‌ای در بخش بالا ثبت نشده باشد، از این پیکربندی استفاده می‌شود.
                            </div>

                            <div class="field-block">
                                <label class="field-label">ارائه‌دهنده</label>
                                <input type="text" class="form-control form-control-sm" @bind="_siteAiProvider" placeholder="مثلاً: openai / openrouter / سرویس ایرانی" />
                                <div class="form-text small">برای OpenRouter می‌توانید خالی بگذارید؛ از روی آدرس API تشخیص داده می‌شود.</div>
                            </div>
                            <div class="field-block">
                                <label class="field-label">آدرس API (پایانه: /chat/completions)</label>
                                <input type="text" class="form-control form-control-sm" dir="ltr" @bind="_siteAiApiUrl" placeholder="https://openrouter.ai/api/v1" />
                                @if (_siteAiApiUrl.Contains("openrouter.ai", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="form-text small text-success">OpenRouter شناسایی شد — استعلام اعتبار و مدل‌های رایگان فعال است.</div>
                                }
                            </div>

                            <div class="field-block">
                                <label class="field-label">کلید API</label>
                                <input type="password" class="form-control form-control-sm" @bind="_siteAiApiKey" placeholder="sk-..." />
                            </div>
                            <div class="field-block">
                                <label class="field-label">دستور سیستم (Prompt)</label>
                                <textarea class="form-control form-control-sm" rows="3" @bind="_siteAiSystemPrompt" placeholder="شما پشتیبان فروشگاه هستید..."></textarea>
                            </div>

                            <div class="btn-row">
                                <button class="btn btn-outline-primary btn-sm" @onclick="TestAiConnection" disabled="@_aiTestBusy">
                                    @(_aiTestBusy ? "در حال تست..." : "تست مدل انتخابی (با تنظیمات فعلی فرم)")
                                </button>
                            </div>
                            @if (_aiTestMessage != null)
                            {
                                <div class="alert @(_aiTestOk == true ? "alert-success" : "alert-danger") py-2 small mb-0" style="white-space:pre-line">@_aiTestMessage</div>
                            }
                        </div>

                        <div class="settings-actions">
                            <button class="btn btn-success btn-sm" @onclick="SaveAllSettings" disabled="@(_settingsLoading || _savingSiteSettings || _savingSettings)">
                                @if (_savingSiteSettings || _savingSettings) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                ذخیره تنظیمات
                            </button>
                        </div>
                    }
                }

                @if (_settingsLoading)
                {
                    <div class="text-muted small text-center py-2">در حال بارگذاری تنظیمات...</div>
                }
                @if (!string.IsNullOrEmpty(_siteSettingsMessage))
                {
                    <div class="alert @(_siteSettingsSuccess ? "alert-success" : "alert-danger") py-2 small mb-0">@_siteSettingsMessage</div>
                }
            </div>
        </div>
    }

    @* --- Sidebar --- *@
    <div class="chat-sidebar @(_showMobileSidebar ? "show" : "")">
        <div class="sidebar-head">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <h6 class="m-0 fw-bold">مکالمات</h6>
                <button class="btn-close-sm d-md-none" @onclick="() => _showMobileSidebar = false"></button>
            </div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="bale-dot @(_baleConfigured ? "on" : "off")"></span>
                <small class="text-muted">@(_baleConfigured ? "متصل به بله" : "بله پیکربندی نشده")</small>
            </div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="conn-dot @(_hubStatus == "متصل" ? "on" : "")"></span>
                <small class="text-muted">اتصال سرور: @_hubStatus</small>
            </div>
            <div class="filter-row">
                <button class="filter-btn @(_activeFilter == "all" ? "act" : "")" @onclick='() => SetFilter("all")'>
                    همه @_allSessions.Count
                    @if (_newSessionCount > 0 && _activeFilter != "all") { <span class="filter-badge">@_newSessionCount</span> }
                </button>
                <button class="filter-btn @(_activeFilter == "active" ? "act" : "")" @onclick='() => SetFilter("active")'>فعال @_allSessions.Count(s => s.Status == ChatSessionStatusDto.Active)</button>
                <button class="filter-btn @(_activeFilter == "closed" ? "act" : "")" @onclick='() => SetFilter("closed")'>پایان @_allSessions.Count(s => s.Status == ChatSessionStatusDto.Closed)</button>
            </div>
        </div>

        <div class="session-list">
            @if (FilteredSessions.Count == 0)
            {
                <div class="empty-list">
                    <span class="oi oi-chat empty-icon"></span>
                    <span>مکالمه‌ای یافت نشد</span>
                </div>
            }
            @foreach (var session in FilteredSessions)
            {
                <div class="session-row @(_selectedSessionId == session.Id ? "sel" : "") @(session.HasUnread ? "unread" : "")"
                     @onclick="() => SelectSession(session.Id)">
                    <div class="s-avatar">@(session.UserName?.FirstOrDefault() ?? '?')</div>
                    <div class="s-info">
                        <div class="s-name">@(session.UserName ?? "کاربر")</div>
                        <div class="s-meta">
                            <span class="s-badge @(session.Status == ChatSessionStatusDto.Active ? "badge-active" : "badge-closed")">
                                @(session.Status == ChatSessionStatusDto.Active ? "فعال" : "پایان")
                            </span>
                            @if (session.Rating is > 0)
                            {
                                <span class="s-rating" title="@(session.RatingComment ?? "")">★@session.Rating</span>
                            }
                            @if (!string.IsNullOrEmpty(session.UserPhone))
                            {
                                <span class="s-phone">📞</span>
                            }
                            <span class="s-time">@FormatTime(session.CreatedAt)</span>
                        </div>
                    </div>
                    @if (session.HasUnread) { <div class="s-unread"></div> }
                </div>
            }
        </div>

        <div class="sidebar-foot">
            <button class="settings-trigger" @onclick='() => OpenSettings("bale")'>
                <span class="oi oi-cog"></span>
                تنظیمات چت و بله
            </button>
        </div>
    </div>

    @* --- Main chat area --- *@
    <div class="chat-main">
        @* --- Top bar (always visible) --- *@
        <div class="chat-topbar">
            <button class="btn-back d-md-none" @onclick="() => _showMobileSidebar = true">
                <span class="oi oi-menu"></span>
            </button>
            @if (_selectedSession == null)
            {
                <div class="topbar-user">
                    <div class="topbar-name">چت آنلاین</div>
                </div>
                <div class="topbar-actions">
                    <button class="act-btn" @onclick='() => OpenSettings("general")' title="تنظیمات چت"><span class="oi oi-cog"></span></button>
                </div>
            }
            else
            {
                <div class="topbar-user">
                    <div class="topbar-name">@(_selectedSession.UserName ?? "کاربر")</div>
                    @if (!string.IsNullOrEmpty(_selectedSession.UserEmail))
                    {
                        <div class="topbar-detail">@_selectedSession.UserEmail</div>
                    }
                    @if (!string.IsNullOrEmpty(_selectedSession.UserPhone))
                    {
                        <div class="topbar-detail" dir="ltr">📞 @_selectedSession.UserPhone</div>
                    }
                    <div class="topbar-detail">@(_selectedSession.CreatedAt.ToLocalTime().ToString("yyyy/MM/dd HH:mm"))</div>
                </div>
                <div class="topbar-actions">
                    <button class="act-btn sound-btn" @onclick="ToggleSound" title="صدا"><span class="oi @(_soundEnabled ? "oi-volume-high" : "oi-volume-off")"></span></button>
                    @if (_selectedSession.Status == ChatSessionStatusDto.Active)
                    {
                        <button class="act-btn transfer-btn" @onclick="OpenTransfer" title="انتقال"><span class="oi oi-transfer"></span></button>
                        <button class="act-btn end-btn" @onclick="CloseSession" title="پایان مکالمه"><span class="oi oi-circle-x"></span></button>
                    }
                    <button class="act-btn delete-btn" @onclick="AskDelete" title="حذف مکالمه"><span class="oi oi-trash"></span></button>
                    <button class="act-btn ban-btn" @onclick="ToggleBan" title="بن/لغو بن کاربر"><span class="oi oi-ban"></span></button>
                    <button class="act-btn" @onclick='() => OpenSettings("general")' title="تنظیمات چت"><span class="oi oi-cog"></span></button>
                </div>
            }
        </div>

        @if (_selectedSessionId == 0)
        {
            <div class="chat-welcome">
                <div class="welcome-icon"><span class="oi oi-chat"></span></div>
                <h5>به پنل مدیریت چت خوش آمدید</h5>
                <p class="text-muted">یک مکالمه را از لیست انتخاب کنید</p>
            </div>
        }
        else
        {
            @* --- Messages --- *@
            <div class="messages-area" @ref="_messagesContainer">
                <div class="msg-search-row">
                    <input class="msg-search" @bind="_searchText"
                           placeholder="جستجو در پیام‌های این مکالمه..." />
                    @if (!string.IsNullOrEmpty(_searchText))
                    {
                        <button class="msg-search-clear" @onclick='() => _searchText = ""'>✕</button>
                    }
                </div>
                @foreach (var msg in FilteredMessages)
                {
                    if (ShouldShowDateSeparator(msg))
                    {
                        <div class="msg-date-sep">@DateSeparatorText(msg.CreatedAt)</div>
                    }
                    if (msg.IsDeleted)
                    {
                        <div class="msg @MsgClass(msg)">
                            <div class="msg-bubble msg-deleted">این پیام حذف شده است</div>
                        </div>
                        continue;
                    }
                    <div class="msg @MsgClass(msg)">
                        @if (_editingMessageId == msg.Id)
                        {
                            <div class="msg-bubble msg-edit-box">
                                <textarea class="msg-edit-input" @bind="_editingText" rows="2"></textarea>
                                <div class="msg-edit-actions">
                                    <button class="btn btn-sm btn-primary" @onclick="() => SaveEdit(msg.Id)" disabled="@string.IsNullOrWhiteSpace(_editingText)">ذخیره</button>
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEdit">لغو</button>
                                </div>
                            </div>
                        }
                        else
                        {
                            @if (IsUserLike(msg))
                            {
                                <div class="msg-head msg-user-head">
                                    <span class="msg-avatar"><span class="oi oi-person"></span></span>
                                    <div class="msg-head-info">
                                        <span class="msg-name">کاربر</span>
                                        @if (!string.IsNullOrEmpty(msg.SenderId))
                                        {
                                            <span class="msg-channel">@UserChannelLabel(msg.SenderId)</span>
                                        }
                                    </div>
                                </div>
                            }
                            else if (IsOperatorLike(msg) && msg.SenderId != "system")
                            {
                                <div class="msg-head msg-op-head">
                                    <span class="msg-avatar op"><span class="oi oi-headphones"></span></span>
                                    <div class="msg-head-info">
                                        <span class="msg-name">اپراتور</span>
                                        @if (!string.IsNullOrEmpty(msg.SenderId) && msg.SenderId != "اپراتور")
                                        {
                                            <span class="msg-chan-extra">@msg.SenderId</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (msg.ReplyToId != null)
                            {
                                var reply = _messages.FirstOrDefault(m => m.Id == msg.ReplyToId);
                                <div class="msg-reply-quote">
                                    <div class="reply-quote-sender">@(reply != null && IsOperatorLike(reply) ? "اپراتور" : "کاربر")</div>
                                    <div class="reply-quote-text">@(string.IsNullOrWhiteSpace(reply?.Content) ? (reply?.MessageType == ChatMessageTypeDto.Image ? "تصویر" : reply?.MessageType == ChatMessageTypeDto.Voice ? "پیام صوتی" : reply?.MessageType == ChatMessageTypeDto.File ? "فایل" : "پیام") : reply!.Content)</div>
                                </div>
                            }
                            @if (msg.MessageType != ChatMessageTypeDto.System)
                            {
                                <span class="bubble-role @(IsOperatorLike(msg) ? "role-op" : "role-user")">@(IsOperatorLike(msg) ? "اپراتور" : "کاربر")</span>
                            }
                            @if (msg.MessageType == ChatMessageTypeDto.Text)
                            {
                                <div class="msg-bubble msg-text">@((MarkupString)RenderMsgHtml(msg.Content))</div>
                            }
                            else if (msg.MessageType == ChatMessageTypeDto.Image)
                            {
                                <div class="msg-bubble msg-image-wrapper">
                                    <img src="@msg.MediaUrl" class="msg-img" @onclick="() => OpenLightbox(msg.MediaUrl)" />
                                    @if (!string.IsNullOrEmpty(msg.Content)) { <div class="mt-1 small">@msg.Content</div> }
                                </div>
                            }
                            else if (msg.MessageType == ChatMessageTypeDto.Voice)
                            {
                                <div class="msg-bubble msg-voice-wrapper">
                                    <audio src="@msg.MediaUrl" controls class="msg-audio" preload="metadata"></audio>
                                </div>
                            }
                            else if (msg.MessageType == ChatMessageTypeDto.File)
                            {
                                <div class="msg-bubble msg-file-wrapper">
                                    <a href="@msg.MediaUrl" target="_blank" class="file-link" download>
                                        <span class="oi oi-file"></span>
                                        @(!string.IsNullOrEmpty(msg.Content) ? msg.Content : "فایل")
                                    </a>
                                </div>
                            }
                            else if (msg.MessageType == ChatMessageTypeDto.System)
                            {
                                <div class="msg-system">@msg.Content</div>
                            }
                            if (msg.SenderType == ChatSenderTypeDto.Operator && msg.SenderId != "system" && _selectedSession?.Status != ChatSessionStatusDto.Closed)
                            {
                                <div class="msg-actions">
                                    <button class="msg-act" @onclick="() => StartReply(msg.Id)" title="پاسخ"><span class="oi oi-action-undo"></span></button>
                                    @if (msg.MessageType == ChatMessageTypeDto.Text)
                                    {
                                        <button class="msg-act" @onclick="() => StartEdit(msg)" title="ویرایش"><span class="oi oi-pencil"></span></button>
                                    }
                                    <button class="msg-act danger" @onclick="() => DeleteMsg(msg.Id)" title="حذف"><span class="oi oi-trash"></span></button>
                                </div>
                            }
                        }
                        <div class="msg-time">
                            @msg.CreatedAt.ToLocalTime().ToString("HH:mm")
                            @if (msg.EditedAt != null) { <span class="msg-edited">(ویرایش‌شده)</span> }
                            @if (msg.SenderType == ChatSenderTypeDto.Operator)
                            {
                                @if (msg.Status == ChatMessageStatusDto.Sending)
                                {
                                    <span class="msg-status">⏳</span>
                                }
                                else if (msg.Status == ChatMessageStatusDto.Read)
                                {
                                    <span class="msg-status read">✓✓</span>
                                }
                                else
                                {
                                    <span class="msg-status">✓</span>
                                }
                            }
                        </div>
                    </div>
                }
                @if (_userTyping)
                {
                    <div class="msg msg-user">
                        <div class="msg-bubble typing-dots"><span></span><span></span><span></span></div>
                    </div>
                }
            </div>

            @* --- Input --- *@
            @if (_selectedSession?.Status != ChatSessionStatusDto.Closed)
            {
                <div class="chat-input-area">
                    @if (!string.IsNullOrEmpty(_chatError))
                    {
                        <div class="chat-error">@_chatError</div>
                    }
                    @if (_replyToMessage != null)
                    {
                        <div class="reply-bar">
                            <div class="reply-bar-info">
                                <span class="reply-bar-title">در حال پاسخ به: @(_replyToMessage.SenderType == ChatSenderTypeDto.Operator ? "اپراتور" : "کاربر")</span>
                                <span class="reply-bar-text">@(string.IsNullOrWhiteSpace(_replyToMessage.Content) ? "..." : _replyToMessage.Content)</span>
                            </div>
                            <button class="reply-bar-close" @onclick="CancelReply">✕</button>
                        </div>
                    }
                    <div class="chat-input-bar">
                        <button class="input-btn" @onclick="PickImage" title="ارسال تصویر"><span class="oi oi-image"></span></button>
                        <button class="input-btn" @onclick="PickFile" title="ارسال فایل"><span class="oi oi-paperclip"></span></button>
                        <button class="input-btn @(_isRecording ? "rec-on" : "")" @onclick="ToggleVoice" title="@(_isRecording ? "توقف ضبط" : "ضبط صدا")"><span class="oi oi-microphone"></span></button>
                        <button class="input-btn" @onclick="ToggleCannedPanel" title="پاسخ‌های آماده"><span class="oi oi-list-rich"></span></button>
                        <input class="input-field" value="@_inputText"
                               @oninput="OnInputChanged"
                               @onkeydown="HandleKeyDown"
                               placeholder="پیام خود را بنویسید..." />
                        <button class="send-btn" @onclick="SendMessage" disabled="@string.IsNullOrWhiteSpace(_inputText)">
                            <span class="oi oi-arrow-left"></span>
                        </button>
                    </div>
                    @if (_cannedOpen)
                    {
                        <div class="canned-panel">
                            <div class="canned-head">
                                <div class="canned-head-title">
                                    <span class="canned-head-ico"><span class="oi oi-list-rich"></span></span>
                                    <div>
                                        <div class="canned-head-name">پاسخ‌های آماده</div>
                                        <div class="canned-head-sub">@_cannedResponses.Count پاسخ ذخیره شده</div>
                                    </div>
                                </div>
                                <div class="canned-head-actions">
                                    <button class="canned-icon-btn" @onclick="OpenFaqManage" title="پرسش‌های پرتکرار (FAQ)"><span class="oi oi-question-mark"></span></button>
                                    <button class="canned-icon-btn" @onclick="OpenCannedManage" title="مدیریت پاسخ‌ها"><span class="oi oi-pencil"></span></button>
                                    <button class="canned-icon-btn" @onclick='() => _cannedOpen = false' title="بستن"><span class="oi oi-x"></span></button>
                                </div>
                            </div>
                            <div class="canned-search-row">
                                <span class="oi oi-magnifying-glass canned-search-ico"></span>
                                <input class="canned-search" @bind="_cannedSearch" placeholder="جستجو در عنوان، متن یا دسته..." />
                                @if (!string.IsNullOrEmpty(_cannedSearch))
                                {
                                    <button class="canned-search-clear" @onclick='() => _cannedSearch = ""'>✕</button>
                                }
                            </div>
                            <div class="canned-body">
                                @if (FilteredCannedResponses.Count == 0)
                                {
                                    <div class="canned-empty">
                                        <span class="canned-empty-ico">💬</span>
                                        <div class="canned-empty-text">
                                            @(string.IsNullOrWhiteSpace(_cannedSearch) ? "هنوز پاسخی ذخیره نشده است" : "نتیجه‌ای برای جستجوی شما یافت نشد")
                                        </div>
                                        @if (string.IsNullOrWhiteSpace(_cannedSearch))
                                        {
                                            <button class="canned-add-first" @onclick="OpenCannedManage">+ افزودن اولین پاسخ</button>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @foreach (var g in GroupedCanned)
                                    {
                                        <div class="canned-group">
                                            <div class="canned-group-head">
                                                <span class="canned-group-dot"></span>
                                                <span class="canned-group-name">@g.Category</span>
                                                <span class="canned-group-count">@g.Items.Count</span>
                                            </div>
                                            <div class="canned-group-items">
                                                @foreach (var cr in g.Items)
                                                {
                                                    <button class="canned-item" @onclick="() => UseCanned(cr)">
                                                        <span class="canned-item-top">
                                                            <span class="canned-item-title">@cr.Title</span>
                                                            <span class="canned-item-use">ارسال <span class="oi oi-arrow-left"></span></span>
                                                        </span>
                                                        <span class="canned-item-text">@cr.Content</span>
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <div class="canned-foot">
                                <button class="canned-foot-btn" @onclick="OpenCannedManage"><span class="oi oi-plus"></span> افزودن پاسخ جدید</button>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>
</div>

@* --- Transfer modal --- *@
@if (_showTransfer)
{
    <div class="settings-backdrop" @onclick="() => _showTransfer = false"></div>
    <div class="settings-modal">
        <div class="settings-head">
            <h6 class="m-0 fw-bold">انتقال مکالمه</h6>
            <button class="btn-close-sm" @onclick="() => _showTransfer = false"></button>
        </div>
        <div class="settings-body">
            <p class="small text-muted mb-3">این مکالمه را به کدام اپراتور منتقل می‌کنید؟</p>
            @if (_operators.Count == 0)
            {
                <div class="text-muted small">اپراتوری یافت نشد.</div>
            }
            @foreach (var op in _operators)
            {
                <button class="op-row @(_selectedSession?.OperatorId == op.Id ? "sel" : "")" @onclick="() => DoTransfer(op.Id)">
                    <span class="s-avatar">@(op.FullName?.FirstOrDefault() ?? '?')</span>
                    <span class="op-name">@op.FullName</span>
                    @if (_selectedSession?.OperatorId == op.Id) { <span class="op-cur">فعلی</span> }
                </button>
            }
        </div>
    </div>
}

@* --- Canned responses manage modal --- *@
@if (_showCannedManage)
{
    <div class="settings-backdrop" @onclick="() => CloseCannedManage()"></div>
    <div class="settings-modal">
        <div class="settings-head">
            <h6 class="m-0 fw-bold">پاسخ‌های آماده</h6>
            <button class="btn-close-sm" @onclick="CloseCannedManage"></button>
        </div>
        <div class="settings-body">
            <div class="mb-3">
                <label class="form-label small fw-bold">عنوان</label>
                <input class="form-control form-control-sm" @bind="_cannedFormTitle" placeholder="مثلاً: سلام و خوش‌آمدگویی" />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-bold">متن پاسخ</label>
                <textarea class="form-control form-control-sm" rows="3" @bind="_cannedFormContent" placeholder="متن پاسخ آماده..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-bold">دسته‌بندی (اختیاری)</label>
                <input class="form-control form-control-sm" @bind="_cannedFormCategory" placeholder="مثلاً: عمومی، محصولات، ارسال" />
            </div>
            <button class="btn btn-primary btn-sm w-100" @onclick="SaveCannedForm" disabled="@(string.IsNullOrWhiteSpace(_cannedFormTitle) || string.IsNullOrWhiteSpace(_cannedFormContent))">
                @(_cannedEditingId > 0 ? "به‌روزرسانی" : "افزودن")
            </button>
            <hr />
            <div class="canned-manage-list">
                @foreach (var cr in _cannedResponses)
                {
                    <div class="canned-manage-row">
                        <div class="canned-manage-info">
                            <div class="canned-manage-title">@cr.Title</div>
                            <div class="canned-manage-content">@cr.Content</div>
                        </div>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditCanned(cr)" title="ویرایش"><span class="oi oi-pencil"></span></button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveCanned(cr.Id)" title="حذف"><span class="oi oi-trash"></span></button>
                        </div>
                    </div>
                }
                @if (_cannedResponses.Count == 0)
                {
                    <div class="text-muted small text-center py-3">پاسخی ثبت نشده است.</div>
                }
            </div>
        </div>
    </div>
}

@* --- FAQ manage modal --- *@
@if (_showFaqManage)
{
    <div class="settings-backdrop" @onclick="() => CloseFaqManage()"></div>
    <div class="settings-modal">
        <div class="settings-head">
            <h6 class="m-0 fw-bold">پرسش‌های پرتکرار (FAQ)</h6>
            <button class="btn-close-sm" @onclick="CloseFaqManage"></button>
        </div>
        <div class="settings-body">
            <p class="text-muted small mb-3">دستیار هوشمند وقتی AI پیکربندی نشده باشد به این‌ها پاسخ می‌دهد.</p>
            <div class="mb-3">
                <label class="form-label small fw-bold">سوال</label>
                <input class="form-control form-control-sm" @bind="_faqFormQuestion" placeholder="مثلاً: هزینه ارسال چقدر است؟" />
            </div>
            <div class="mb-3">
                <label class="form-label small fw-bold">پاسخ</label>
                <textarea class="form-control form-control-sm" rows="3" @bind="_faqFormAnswer" placeholder="متن پاسخ..."></textarea>
            </div>
            <div class="mb-3">
                <label class="form-label small fw-bold">کلمات کلیدی (اختیاری، با ویرگول)</label>
                <input class="form-control form-control-sm" @bind="_faqFormKeywords" placeholder="ارسال، هزینه ارسال، پست" />
            </div>
            <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="chkFaqEnabled" @bind="_faqFormEnabled" />
                <label class="form-check-label small" for="chkFaqEnabled">فعال</label>
            </div>
            <button class="btn btn-primary btn-sm w-100" @onclick="SaveFaqForm" disabled="@(string.IsNullOrWhiteSpace(_faqFormQuestion) || string.IsNullOrWhiteSpace(_faqFormAnswer))">
                @(_faqEditingId > 0 ? "به‌روزرسانی" : "افزودن")
            </button>
            <hr />
            <div class="canned-manage-list">
                @foreach (var f in _faqEntries)
                {
                    <div class="canned-manage-row">
                        <div class="canned-manage-info">
                            <div class="canned-manage-title">@f.Question</div>
                            <div class="canned-manage-content">@f.Answer</div>
                        </div>
                        <span class="badge @(f.IsEnabled ? "bg-success" : "bg-secondary")">@(f.IsEnabled ? "فعال" : "غیرفعال")</span>
                        <div class="d-flex gap-1">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditFaq(f)" title="ویرایش"><span class="oi oi-pencil"></span></button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveFaq(f.Id)" title="حذف"><span class="oi oi-trash"></span></button>
                        </div>
                    </div>
                }
                @if (_faqEntries.Count == 0)
                {
                    <div class="text-muted small text-center py-3">پرسشی ثبت نشده است.</div>
                }
            </div>
        </div>
    </div>
}

@* --- Lightbox --- *@
@if (!string.IsNullOrEmpty(_lightboxUrl))
{
    <div class="lightbox-overlay" @onclick="() => _lightboxUrl = null">
        <img src="@_lightboxUrl" class="lightbox-img" />
    </div>
}

<style>
    /* ── Root ── */
    .chat-app { display:flex; height:calc(100vh - 80px); background:#fff; border-radius:18px; overflow:hidden; box-shadow:0 2px 24px rgba(0,0,0,.07); position:relative; --chat-kb:0px; }
    .chat-overlay { display:none; }

    /* ── Sidebar ── */
    .chat-sidebar { width:320px; min-width:320px; border-left:1px solid #f0f0f0; display:flex; flex-direction:column; background:#fafafa; }
    .sidebar-head { padding:18px 16px 12px; border-bottom:1px solid #f0f0f0; }
    .bale-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; }
    .bale-dot.on { background:#22c55e; box-shadow:0 0 6px rgba(34,197,94,.4); }
    .bale-dot.off { background:#ef4444; box-shadow:0 0 6px rgba(239,68,68,.4); }
    .conn-dot { width:8px; height:8px; border-radius:50%; flex-shrink:0; background:#ef4444; }
    .conn-dot.on { background:#22c55e; box-shadow:0 0 6px rgba(34,197,94,.4); }
    .chat-error { background:#fef2f2; color:#dc2626; font-size:.72rem; padding:8px 14px; }
    .filter-row { display:flex; gap:4px; }
    .filter-btn { flex:1; border:none; background:#f0f0f0; padding:5px 0; border-radius:8px; font-size:.72rem; font-weight:600; cursor:pointer; transition:.15s; color:#6b7280; position:relative; }
    .filter-btn.act { background:#4f46e5; color:#fff; }
    .filter-btn:hover:not(.act) { background:#e5e7eb; }
    .filter-badge { position:absolute; top:-4px; right:-4px; background:#ef4444; color:#fff; font-size:.55rem; width:16px; height:16px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-weight:700; }

    .session-list { flex:1; overflow-y:auto; scrollbar-width:thin; }
    .session-row { display:flex; align-items:center; gap:10px; padding:12px 16px; cursor:pointer; border-bottom:1px solid #f5f5f5; transition:.15s; position:relative; }
    .session-row:hover { background:#f3f4f6; }
    .session-row.sel { background:#eef2ff; }
    .session-row.unread { background:#fefce8; }
    .s-avatar { width:42px; height:42px; border-radius:50%; background:linear-gradient(135deg,#4f46e5,#6366f1); color:#fff; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:.9rem; flex-shrink:0; }
    .s-info { flex:1; min-width:0; }
    .s-name { font-weight:600; font-size:.85rem; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .s-meta { display:flex; align-items:center; gap:6px; margin-top:2px; }
    .s-badge { font-size:.58rem; padding:1px 6px; border-radius:10px; font-weight:600; }
    .badge-active { background:#dcfce7; color:#16a34a; }
    .badge-closed { background:#f3f4f6; color:#6b7280; }
    .s-rating { font-size:.62rem; color:#f59e0b; font-weight:700; background:#fffbeb; padding:1px 7px; border-radius:10px; }
    .s-phone { font-size:.6rem; }
    .s-time { font-size:.62rem; color:#9ca3af; }
    .s-unread { width:8px; height:8px; border-radius:50%; background:#ef4444; flex-shrink:0; }
    .empty-list { display:flex; flex-direction:column; align-items:center; gap:8px; padding:60px 20px; color:#9ca3af; font-size:.85rem; }
    .empty-icon { font-size:2rem; }
    .sidebar-foot { padding:12px 16px; border-top:1px solid #f0f0f0; }
    .settings-trigger { width:100%; border:none; background:#f0f0f0; padding:10px; border-radius:12px; font-weight:600; font-size:.82rem; cursor:pointer; transition:.15s; display:flex; align-items:center; justify-content:center; gap:6px; color:#374151; }
    .settings-trigger:hover { background:#e5e7eb; }

    /* ── Settings modal ── */
    .settings-backdrop { position:fixed; inset:0; background:rgba(0,0,0,.4); z-index:2000; }
    .settings-modal { position:fixed; top:50%; left:50%; transform:translate(-50%,-50%); width:520px; max-width:94vw; max-height:85vh; background:#fff; border-radius:18px; overflow:hidden; z-index:2001; box-shadow:0 20px 60px rgba(0,0,0,.2); display:flex; flex-direction:column; }
    .settings-head { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; border-bottom:1px solid #f0f0f0; }
    .settings-body { flex:1; overflow-y:auto; padding:20px; }
    .btn-close-sm { width:30px; height:30px; border:none; background:#f0f0f0; border-radius:50%; cursor:pointer; font-size:1.1rem; display:flex; align-items:center; justify-content:center; color:#6b7280; transition:.15s; }
    .btn-close-sm:hover { background:#e5e7eb; }
    .btn-close-sm::after { content:"✕"; }

    /* ── Settings tabs / cards / switch ── */
    .settings-tabs { display:flex; gap:6px; padding:10px 14px; border-bottom:1px solid #f0f0f0; background:#fafafa; overflow-x:auto; }
    .settings-tab { flex:0 0 auto; display:flex; align-items:center; gap:6px; border:1px solid #e5e7eb; background:#fff; color:#6b7280; padding:7px 13px; border-radius:999px; font-size:.8rem; font-weight:600; cursor:pointer; transition:.15s; white-space:nowrap; }
    .settings-tab:hover { border-color:#c7d2fe; color:#4f46e5; }
    .settings-tab.active { background:#4f46e5; border-color:#4f46e5; color:#fff; box-shadow:0 4px 12px rgba(79,70,229,.28); }

    .settings-card { background:#fff; border:1px solid #eef0f4; border-radius:14px; padding:14px 15px; margin-bottom:12px; box-shadow:0 1px 3px rgba(16,24,40,.04); }
    .settings-card.accent { background:linear-gradient(180deg,#f7f8ff,#fff); border-color:#e0e4ff; }
    .settings-card-title { font-size:.82rem; font-weight:700; color:#1f2937; margin-bottom:10px; }
    .settings-actions { display:flex; justify-content:flex-end; gap:8px; margin-top:4px; }
    .field-block { margin-top:10px; }
    .field-label { display:block; font-size:.78rem; font-weight:700; color:#374151; margin-bottom:4px; }
    .sub-sep { font-size:.78rem; font-weight:700; color:#374151; margin:14px 0 8px; padding-top:12px; border-top:1px dashed #e5e7eb; }
    .btn-row { display:flex; flex-wrap:wrap; gap:8px; margin-top:12px; }
    .info-chip { margin-top:10px; padding:9px 11px; background:#f5f7ff; border:1px solid #e3e7ff; border-radius:10px; font-size:.78rem; color:#4b5563; }

    /* ── AI settings: stats / credits / limits / model cards ── */
    .ai-title-row { display:flex; align-items:center; justify-content:space-between; gap:10px; flex-wrap:wrap; }
    .ai-title-row > span:first-child { display:inline-flex; align-items:center; gap:6px; }
    .mini-btn { border:1px solid #dfe3ea; background:#fff; color:#4b5563; font-size:.7rem; font-weight:700; padding:4px 10px; border-radius:999px; cursor:pointer; transition:.15s; white-space:nowrap; }
    .mini-btn:hover:not(:disabled) { background:#f5f7ff; border-color:#c7cdff; color:#4f46e5; }
    .mini-btn:disabled { opacity:.6; cursor:default; }

    .ai-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; }
    .ai-stat { background:#f7f8fc; border:1px solid #eef0f6; border-radius:12px; padding:9px 8px; text-align:center; min-width:0; }
    .ai-stat b { display:block; font-size:1.05rem; font-weight:800; color:#4f46e5; line-height:1.3; }
    .ai-stat span { display:block; font-size:.66rem; color:#6b7280; margin-top:2px; }

    .ai-quota { margin-top:10px; display:flex; flex-direction:column; gap:6px; }
    .ai-quota-row { display:flex; align-items:center; justify-content:space-between; gap:10px; background:#fbfbfd; border:1px dashed #e5e7eb; border-radius:9px; padding:6px 10px; font-size:.74rem; color:#4b5563; }
    .ai-quota-row b { font-weight:700; color:#1f2937; }

    .ai-credits { margin-top:12px; border:1px solid #e6e9f0; border-radius:12px; padding:10px 11px; background:#fcfcff; }
    .ai-credits.loading { opacity:.85; }
    .ai-credits-head { display:flex; align-items:center; justify-content:space-between; gap:8px; margin-bottom:8px; }
    .ai-credits-head > span { display:inline-flex; align-items:center; gap:6px; font-size:.78rem; font-weight:700; color:#1f2937; }
    .ai-credits-note { font-size:.74rem; color:#6b7280; line-height:1.7; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
    .ai-credits-note.warn { color:#b45309; background:#fffbeb; border:1px solid #fde68a; border-radius:8px; padding:7px 9px; }
    .ai-credits-note.ok { color:#15803d; }
    .ai-credits-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:8px; margin-bottom:8px; }
    .ai-credit { background:#fff; border:1px solid #eef0f6; border-radius:10px; padding:8px 6px; text-align:center; min-width:0; }
    .ai-credit b { display:block; font-size:.98rem; font-weight:800; color:#1f2937; word-break:break-all; }
    .ai-credit span { display:block; font-size:.62rem; color:#6b7280; margin-top:2px; }
    .ai-credit.ok b { color:#16a34a; }
    .ai-credit.used b { color:#f59e0b; }
    .ai-credits-bar { height:7px; border-radius:999px; background:#eef0f6; overflow:hidden; }
    .ai-credits-bar__fill { height:100%; border-radius:999px; background:linear-gradient(90deg,#4f46e5,#22d3ee); transition:width .4s ease; }

    .limit-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:10px; margin-top:12px; }
    .limit-box { min-width:0; background:#fafbfe; border:1px solid #eef0f6; border-radius:10px; padding:9px 10px; }
    .limit-box .field-label { margin-bottom:5px; }
    .limit-box .form-text { margin-top:4px; font-size:.68rem; }

    .model-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:9px; }
    .model-card { position:relative; text-align:right; background:#fff; border:1.5px solid #e5e7eb; border-radius:12px; padding:11px 12px 11px 36px; cursor:pointer; transition:.15s; font-family:inherit; color:inherit; display:block; width:100%; min-width:0; }
    .model-card:hover { border-color:#c7cdff; background:#fbfbff; }
    .model-card.sel { border-color:#4f46e5; background:linear-gradient(180deg,#f2f4ff,#fff); box-shadow:0 2px 10px rgba(79,70,229,.14); }
    .model-card.sel .model-name { color:#4f46e5; }
    .model-check { position:absolute; top:11px; left:10px; width:19px; height:19px; border-radius:50%; border:1.5px solid #d1d5db; display:flex; align-items:center; justify-content:center; font-size:.6rem; color:transparent; background:#fff; transition:.15s; }
    .model-card.sel .model-check { background:#4f46e5; border-color:#4f46e5; color:#fff; }
    .model-name { display:block; font-size:.78rem; font-weight:800; color:#1f2937; word-break:break-all; line-height:1.4; }
    .model-desc { display:block; font-size:.68rem; color:#6b7280; line-height:1.6; margin-top:4px; }
    .model-tags { display:flex; flex-wrap:wrap; gap:5px; margin-top:7px; }
    .model-tag { font-size:.6rem; font-weight:700; background:#f3f4f6; color:#4b5563; padding:2px 7px; border-radius:999px; }
    .model-card.sel .model-tag { background:#e0e7ff; color:#4338ca; }
    .model-tag.tag-speed { background:#ecfeff; color:#0e7490; }
    .model-card.sel .model-tag.tag-speed { background:#cffafe; color:#155e75; }
    .model-active-chip { font-size:.68rem; font-weight:700; background:#eef2ff; color:#4338ca; border:1px solid #e0e7ff; border-radius:999px; padding:3px 10px; max-width:60%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .model-test-row { display:flex; align-items:center; gap:6px; margin-top:8px; flex-wrap:wrap; }
    .model-test-btn { display:inline-flex; align-items:center; gap:5px; border:1px solid #c7d2fe; background:#eef2ff; color:#4338ca; font-size:.64rem; font-weight:700; border-radius:999px; padding:3px 10px; cursor:pointer; transition:.15s; font-family:inherit; }
    .model-test-btn:hover:not(:disabled) { background:#4f46e5; border-color:#4f46e5; color:#fff; }
    .model-test-btn:disabled { opacity:.6; cursor:default; }
    .model-test-btn .spinner-border { width:.7rem; height:.7rem; border-width:.12em; }
    .model-test-result { font-size:.62rem; font-weight:700; border-radius:8px; padding:3px 8px; max-width:100%; line-height:1.6; word-break:break-word; white-space:normal; }
    .model-test-result.ok { background:#ecfdf5; color:#047857; }
    .model-test-result.fail { background:#fef2f2; color:#b91c1c; }

    /* ── AI providers chain ── */
    .ai-provider-box { border:1.5px solid #e5e7eb; border-radius:12px; padding:10px 12px; margin-bottom:10px; background:#fafbff; }
    .ai-provider-box.off { opacity:.55; }
    .ai-provider-head { display:flex; align-items:center; gap:8px; flex-wrap:wrap; margin-bottom:8px; }
    .ai-provider-head .form-control { max-width:200px; }
    .ai-sub-title { font-size:.72rem; font-weight:700; color:#4338ca; margin-bottom:5px; }
    .ai-row { display:flex; align-items:center; gap:7px; padding:5px 0; flex-wrap:wrap; }
    .ai-row.off { opacity:.5; }
    .ai-row .form-control { max-width:240px; }
    .ai-status-chip { font-size:.62rem; font-weight:700; border-radius:999px; padding:2px 9px; white-space:nowrap; }
    .ai-status-chip.ok { background:#ecfdf5; color:#047857; }
    .ai-status-chip.warn { background:#fffbeb; color:#b45309; }
    .ai-status-chip.bad { background:#fef2f2; color:#b91c1c; }
    .icon-btn-sm { border:none; background:#f3f4f6; color:#6b7280; width:26px; height:26px; border-radius:7px; cursor:pointer; display:inline-flex; align-items:center; justify-content:center; transition:.15s; font-size:.7rem; }
    .icon-btn-sm:hover { background:#e5e7eb; }
    .icon-btn-sm.text-danger:hover { background:#fee2e2; color:#dc2626; }
    .ai-catalog { max-height:230px; overflow:auto; border:1px solid #e5e7eb; border-radius:9px; background:#fff; padding:8px; margin-bottom:8px; }
    .ai-catalog-item { display:flex; align-items:center; gap:8px; font-size:.72rem; padding:3px 2px; cursor:pointer; margin:0; }
    .ai-catalog-item span { direction:ltr; font-family:ui-monospace,monospace; }
    .ai-chain-results { border:1px solid #e5e7eb; border-radius:9px; overflow:hidden; }
    .ai-chain-row { display:flex; align-items:center; gap:10px; padding:6px 10px; font-size:.7rem; border-bottom:1px solid #f3f4f6; flex-wrap:wrap; }
    .ai-chain-row:last-child { border-bottom:none; }
    .ai-chain-row.ok { background:#f0fdf4; }
    .ai-chain-row.fail { background:#fef2f2; }
    .chain-provider { font-weight:700; color:#1f2937; }
    .chain-model { font-family:ui-monospace,monospace; color:#4338ca; }
    .chain-key { color:#9ca3af; }
    .chain-status { flex:1; min-width:120px; color:#6b7280; word-break:break-word; }
    .chain-ms { color:#9ca3af; font-size:.64rem; }

    .switch-row { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
    .switch-text { min-width:0; }
    .switch-title { font-size:.82rem; font-weight:700; color:#1f2937; }
    .switch-desc { font-size:.74rem; color:#6b7280; margin-top:3px; line-height:1.6; }

    .chat-switch { position:relative; display:inline-block; width:44px; height:24px; flex:0 0 auto; margin-top:2px; }
    .chat-switch input { opacity:0; width:0; height:0; }
    .chat-slider { position:absolute; inset:0; background:#d1d5db; border-radius:999px; cursor:pointer; transition:.2s; }
    .chat-slider::before { content:""; position:absolute; height:18px; width:18px; right:3px; top:3px; background:#fff; border-radius:50%; transition:.2s; box-shadow:0 1px 3px rgba(0,0,0,.25); }
    .chat-switch input:checked + .chat-slider { background:#4f46e5; }
    .chat-switch input:checked + .chat-slider::before { transform:translateX(-20px); }
    .chat-switch input:focus-visible + .chat-slider { box-shadow:0 0 0 3px rgba(79,70,229,.3); }

    /* ── Chat main ── */
    .chat-main { flex:1; display:flex; flex-direction:column; min-width:0; background:#fff; }
    .chat-welcome { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:8px; background:#fafafa; }
    .welcome-icon { width:72px; height:72px; border-radius:50%; background:#eef2ff; display:flex; align-items:center; justify-content:center; font-size:1.8rem; color:#4f46e5; }
    .chat-welcome h5 { font-weight:700; margin:4px 0 0; color:#1f2937; }
    .chat-welcome p { margin:0; font-size:.85rem; }

    .chat-topbar { display:flex; align-items:center; gap:10px; padding:11px 16px; border-bottom:1px solid #f0f0f0; background:#fff; }
    .btn-back { width:34px; height:34px; border:none; background:#f0f0f0; border-radius:50%; cursor:pointer; display:flex; align-items:center; justify-content:center; color:#374151; flex-shrink:0; }
    .btn-back:hover { background:#e5e7eb; }
    .topbar-user { flex:1; min-width:0; }
    .topbar-name { font-weight:700; font-size:.9rem; color:#1f2937; }
    .topbar-detail { font-size:.7rem; color:#9ca3af; }
    .topbar-actions { display:flex; gap:6px; flex-shrink:0; }
    .act-btn { width:32px; height:32px; border-radius:50%; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:.85rem; transition:.15s; }
    .end-btn { background:#fef2f2; color:#ef4444; }
    .end-btn:hover { background:#fee2e2; }
    .delete-btn { background:#fef2f2; color:#ef4444; }
    .delete-btn:hover { background:#fee2e2; }
    .ban-btn { background:#fffbeb; color:#f59e0b; }
    .ban-btn:hover { background:#fef3c7; }

    /* ── Messages ── */
    .messages-area { flex:1; overflow-y:auto; padding:16px 20px; display:flex; flex-direction:column; gap:10px; background:#fcfcfc; scrollbar-width:thin; }
    .msg-search-row { position:sticky; top:0; z-index:5; margin-bottom:4px; display:flex; align-items:center; gap:6px; background:#fcfcfc; padding:4px 0 8px; }
    .msg-search { flex:1; border:1.5px solid #e5e7eb; border-radius:20px; padding:6px 14px; font-size:.78rem; outline:none; background:#fff; transition:border-color .2s; }
    .msg-search:focus { border-color:#4f46e5; }
    .msg-search-clear { width:24px; height:24px; border:none; background:#f0f0f0; border-radius:50%; cursor:pointer; color:#6b7280; font-size:.7rem; display:flex; align-items:center; justify-content:center; }
    .msg-date-sep { align-self:center; background:#e5e7eb; color:#6b7280; font-size:.62rem; padding:2px 12px; border-radius:12px; margin:6px 0; }
    .msg-deleted { background:#f0f0f0 !important; color:#9ca3af !important; font-style:italic; font-size:.75rem; }
    .msg-edited { color:#9ca3af; font-size:.6rem; margin-left:3px; }
    .msg-reply-quote { background:rgba(255,255,255,.18); border-right:3px solid rgba(255,255,255,.7); padding:4px 10px; border-radius:8px; margin-bottom:4px; direction:rtl; }
    .msg-user .msg-reply-quote { background:#f5f5f7; border-right-color:#d1d5db; color:#4b5563; }
    .reply-quote-sender { font-size:.6rem; font-weight:700; opacity:.85; }
    .reply-quote-text { font-size:.68rem; opacity:.8; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:240px; }
    .msg-actions { display:flex; gap:4px; padding:2px 4px; opacity:0; transition:opacity .15s; }
    .msg:hover .msg-actions { opacity:1; }
    .msg-act { width:24px; height:24px; border:none; background:#f0f0f0; border-radius:6px; cursor:pointer; font-size:.65rem; color:#6b7280; display:flex; align-items:center; justify-content:center; transition:.15s; }
    .msg-act:hover { background:#e5e7eb; color:#1f2937; }
    .msg-act.danger:hover { background:#fee2e2; color:#ef4444; }
    .msg-edit-box { background:#fffdf5 !important; color:#1f2937 !important; border:1.5px solid #f5a623; width:320px; max-width:100%; }
    .msg-edit-input { width:100%; border:1px solid #e5e7eb; border-radius:8px; padding:6px 10px; font-size:.82rem; resize:vertical; outline:none; background:#fff; }
    .msg-edit-actions { display:flex; gap:6px; margin-top:6px; justify-content:flex-end; }
    .chat-input-area { border-top:1px solid #f0f0f0; background:#fff; }
    .reply-bar { display:flex; align-items:center; gap:8px; padding:8px 16px 0; }
    .reply-bar-info { flex:1; min-width:0; background:#f0f0f0; border-radius:10px; padding:6px 12px; }
    .reply-bar-title { display:block; font-size:.65rem; font-weight:700; color:#4f46e5; }
    .reply-bar-text { display:block; font-size:.72rem; color:#6b7280; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .reply-bar-close { width:26px; height:26px; border:none; background:#f0f0f0; border-radius:50%; cursor:pointer; color:#6b7280; font-size:.75rem; flex-shrink:0; }
    .rec-on { background:#dc3545 !important; color:#fff !important; animation:pulse 1s infinite; }
    @@keyframes pulse { 0%,100% { box-shadow:0 0 0 0 rgba(220,53,69,.4); } 50% { box-shadow:0 0 0 8px rgba(220,53,69,0); } }
    .canned-panel { border-top:1px solid #f0f0f0; background:#fff; display:flex; flex-direction:column; max-height:340px; }
    .canned-head { display:flex; align-items:center; justify-content:space-between; padding:10px 14px 8px; border-bottom:1px solid #f3f4f6; }
    .canned-head-title { display:flex; align-items:center; gap:9px; }
    .canned-head-ico { width:34px; height:34px; border-radius:10px; background:#eef2ff; color:#4f46e5; display:flex; align-items:center; justify-content:center; font-size:.95rem; }
    .canned-head-name { font-size:.8rem; font-weight:800; color:#111827; }
    .canned-head-sub { font-size:.66rem; color:#9ca3af; margin-top:1px; }
    .canned-head-actions { display:flex; gap:6px; }
    .canned-icon-btn { width:30px; height:30px; border-radius:8px; border:1px solid #eee; background:#fafafa; color:#6b7280; display:flex; align-items:center; justify-content:center; cursor:pointer; transition:.15s; font-size:.7rem; }
    .canned-icon-btn:hover { background:#eef2ff; border-color:#c7d2fe; color:#4f46e5; }
    .canned-search-row { display:flex; align-items:center; gap:8px; margin:10px 14px 4px; padding:2px 10px; border:1px solid #e5e7eb; border-radius:10px; background:#f9fafb; }
    .canned-search-row:focus-within { border-color:#a5b4fc; background:#fff; box-shadow:0 0 0 3px rgba(79,70,229,.08); }
    .canned-search-ico { color:#9ca3af; font-size:.62rem; }
    .canned-search { flex:1; border:none; outline:none; background:transparent; font-size:.74rem; padding:7px 0; color:#1f2937; }
    .canned-search::placeholder { color:#9ca3af; }
    .canned-search-clear { border:none; background:transparent; color:#9ca3af; cursor:pointer; font-size:.7rem; padding:2px 4px; }
    .canned-search-clear:hover { color:#ef4444; }
    .canned-body { overflow-y:auto; padding:6px 14px 10px; display:flex; flex-direction:column; gap:10px; }
    .canned-group { }
    .canned-group-head { display:flex; align-items:center; gap:6px; margin:6px 2px 5px; }
    .canned-group-dot { width:6px; height:6px; border-radius:50%; background:#4f46e5; }
    .canned-group-name { font-size:.68rem; font-weight:700; color:#374151; }
    .canned-group-count { font-size:.6rem; color:#9ca3af; background:#f3f4f6; border-radius:999px; padding:1px 7px; }
    .canned-group-items { display:flex; flex-direction:column; gap:5px; }
    .canned-item { display:flex; flex-direction:column; align-items:flex-start; gap:3px; border:1px solid #e5e7eb; background:#fafafa; border-radius:10px; padding:8px 11px; cursor:pointer; transition:.15s; text-align:right; width:100%; }
    .canned-item:hover { border-color:#c7d2fe; background:#eef2ff; transform:translateY(-1px); box-shadow:0 2px 6px rgba(79,70,229,.08); }
    .canned-item-top { display:flex; align-items:center; justify-content:space-between; width:100%; }
    .canned-item-title { font-size:.72rem; font-weight:700; color:#111827; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .canned-item-use { font-size:.62rem; font-weight:700; color:#4f46e5; display:flex; align-items:center; gap:3px; opacity:0; transition:.15s; }
    .canned-item:hover .canned-item-use { opacity:1; }
    .canned-item-text { font-size:.68rem; color:#6b7280; line-height:1.5; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
    .canned-empty { text-align:center; color:#9ca3af; padding:22px 10px; display:flex; flex-direction:column; align-items:center; gap:8px; }
    .canned-empty-ico { font-size:1.7rem; opacity:.6; }
    .canned-empty-text { font-size:.74rem; color:#6b7280; }
    .canned-add-first { border:none; border-radius:10px; background:#4f46e5; color:#fff; font-size:.7rem; font-weight:700; padding:7px 16px; cursor:pointer; transition:.15s; }
    .canned-add-first:hover { background:#4338ca; }
    .canned-foot { border-top:1px solid #f3f4f6; padding:8px 14px; }
    .canned-foot-btn { width:100%; border:1px dashed #c7d2fe; background:#fafbff; color:#4f46e5; border-radius:10px; font-size:.7rem; font-weight:700; padding:7px 0; cursor:pointer; transition:.15s; display:flex; align-items:center; justify-content:center; gap:6px; }
    .canned-foot-btn:hover { background:#eef2ff; border-style:solid; }
    .canned-manage-list { display:flex; flex-direction:column; gap:8px; }
    .canned-manage-row { display:flex; align-items:center; gap:8px; border:1px solid #f0f0f0; border-radius:10px; padding:8px 12px; background:#fafafa; }
    .canned-manage-info { flex:1; min-width:0; }
    .canned-manage-title { font-size:.75rem; font-weight:700; }
    .canned-manage-content { font-size:.68rem; color:#6b7280; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .op-row { display:flex; align-items:center; gap:10px; width:100%; border:1px solid #f0f0f0; background:#fafafa; border-radius:12px; padding:10px 14px; cursor:pointer; transition:.15s; margin-bottom:8px; }
    .op-row:hover { border-color:#4f46e5; background:#eef2ff; }
    .op-row.sel { border-color:#22c55e; background:#f0fdf4; }
    .op-name { flex:1; text-align:right; font-size:.82rem; font-weight:600; color:#1f2937; }
    .op-cur { font-size:.6rem; color:#16a34a; font-weight:700; }
    .transfer-btn { background:#eef2ff; color:#4f46e5; }
    .transfer-btn:hover { background:#e0e7ff; }
    .sound-btn { background:#f0fdf4; color:#16a34a; }
    .sound-btn:hover { background:#dcfce7; }
    .msg { max-width:78%; display:flex; flex-direction:column; gap:2px; animation:msgIn .2s ease; }
    @@keyframes msgIn { from{opacity:0;transform:translateY(6px)} to{opacity:1;transform:translateY(0)} }
    .msg-op { align-self:flex-start; align-items:flex-start; }
    .msg-user { align-self:flex-end; align-items:flex-end; }
    .msg-sys { align-self:center; max-width:100%; }
    .msg-bubble { padding:9px 14px; border-radius:15px; font-size:.85rem; line-height:1.6; word-break:break-word; white-space:pre-wrap; box-shadow:0 1px 2px rgba(0,0,0,.05); }
    .msg-op .msg-bubble { background:linear-gradient(135deg,#6366f1,#4f46e5); color:#fff; border-bottom-right-radius:4px; }
    .msg-user .msg-bubble { background:#fff; color:#1f2937; border:1px solid #e5e7eb; border-bottom-left-radius:4px; }
    .msg-bubble code { background:rgba(0,0,0,.12); padding:1px 5px; border-radius:5px; font-size:.85em; direction:ltr; unicode-bidi:embed; }
    .msg-op .msg-bubble code { background:rgba(255,255,255,.22); color:#fff; }
    .msg-bubble strong { font-weight:700; }
    .bubble-role { display:inline-block; align-self:flex-start; font-size:.58rem; font-weight:800; padding:2px 9px; border-radius:999px; margin-bottom:3px; }
    .msg-user .bubble-role { align-self:flex-end; }
    .bubble-role.role-op { background:#e0e7ff; color:#4f46e5; }
    .bubble-role.role-user { background:#e2e8f0; color:#475569; }
    .msg-head { display:flex; align-items:center; gap:7px; margin-bottom:3px; }
    .msg-user-head { flex-direction:row-reverse; }
    .msg-avatar { width:26px; height:26px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:.58rem; color:#fff; background:#d1d5db; flex-shrink:0; }
    .msg-avatar.op { background:linear-gradient(135deg,#6366f1,#4f46e5); }
