@page "/admin/sms"
@layout AdminLayout
@using System.Net.Http.Json
@using ErrorService.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using ErrorService.Client.Services
@using System.Security.Claims
@using ErrorService.Client.Helpers
@inject HttpClient Http
@inject ToastService ToastService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav

<div class="sms-container" dir="rtl">

    <!-- Header -->
    <div class="sms-header">
        <div class="sms-header__top">
            <h1 class="sms-header__title">مدیریت پیامک</h1>
        </div>
        <div class="sms-tabs">
            @foreach (var tab in tabs)
            {
                <button class="sms-tab @(activeTab == tab.Key ? "sms-tab--active" : "")"
                        @onclick="() => SwitchTab(tab.Key)">
                    <span class="oi oi-@tab.Icon"></span>
                    <span>@tab.Label</span>
                    @if (tab.Badge > 0)
                    {
                        <span class="sms-tab__badge">@tab.Badge</span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- Tab: Dashboard -->
    @if (activeTab == "dashboard")
    {
        <div class="sms-dashboard">
            @if (_isWorkshopOnlyUser)
            {
                <!-- Workshop dashboard -->
                @if (_wsDashboard != null)
                {
                    <div class="sms-own-credit mb-3">
                        <div class="sms-own-credit__card">
                            <div class="sms-own-credit__label">اعتبار شما</div>
                            <div class="sms-own-credit__amount">@($"{_wsDashboard.Balance:N0}")</div>
                            <div class="sms-own-credit__sub">تومان</div>
                        </div>
                        <div class="sms-own-credit__card sms-own-credit__card--pending">
                            <div class="sms-own-credit__label">درخواست شارژ در انتظار</div>
                            <div class="sms-own-credit__amount">@_wsDashboard.PendingChargeCount</div>
                            <div class="sms-own-credit__sub">عدد</div>
                        </div>
                    </div>
                    @if (_wsDashboard.WarningThreshold.HasValue && _wsDashboard.Balance < _wsDashboard.WarningThreshold.Value)
                    {
                        <div class="sms-warning-banner">
                            <span class="sms-warning-banner__icon oi oi-warning"></span>
                            <span class="sms-warning-banner__text">
                                <span class="sms-warning-banner__desktop-text">اعتبار شما از حد مجاز کمتر است (کمتر از @($"{_wsDashboard.WarningThreshold.Value:N0}") تومان)</span>
                                <span class="sms-warning-banner__mobile-text">اعتبار کمتر از حد مجاز</span>
                            </span>
                            <button class="sms-warning-banner__link" @onclick='() => SwitchTab("charges")'>
                                <span class="oi oi-arrow-left"></span> درخواست شارژ
                            </button>
                        </div>
                    }
                    @if (!_wsDashboard.SmsActive)
                    {
                        <div class="sms-alert sms-alert--warn">
                            <span class="oi oi-warning"></span>
                            <span>سامانه پیامک برای کارگاه شما غیرفعال است.</span>
                        </div>
                    }
                }
            }
            else
            {
                <!-- Admin dashboard -->
                <div class="sms-admin-credit mb-3">
                    <div class="sms-admin-credit__select-row">
                        <span class="sms-admin-credit__select-label">کارگاه:</span>
                        <select class="sms-admin-credit__select" @bind="_selectedWorkshopId" @bind:after="OnSelectedWorkshopChanged">
                            <option value="">-- انتخاب کنید --</option>
                            @foreach (var c in _credits)
                            {
                                <option value="@c.WorkshopId">@c.WorkshopName</option>
                            }
                        </select>
                    </div>
                    @if (_selectedWorkshopCredit != null && settings?.WarningThreshold.HasValue == true && _selectedWorkshopCredit.Balance < settings.WarningThreshold.Value)
                    {
                        <div class="sms-warning-banner">
                            <span class="sms-warning-banner__icon oi oi-warning"></span>
                            <span class="sms-warning-banner__text">
                                <span class="sms-warning-banner__desktop-text">اعتبار کارگاه @_selectedWorkshopCredit.WorkshopName از حد مجاز کمتر است (کمتر از @($"{settings.WarningThreshold.Value:N0}") تومان)</span>
                                <span class="sms-warning-banner__mobile-text">اعتبار کمتر از حد مجاز</span>
                            </span>
                            <button class="sms-warning-banner__link" @onclick='() => SwitchTab("charges")'>
                                <span class="oi oi-arrow-left"></span> شارژ حساب
                            </button>
                        </div>
                    }
                    @if (_selectedWorkshopCredit != null)
                    {
                        <div class="sms-own-credit">
                            <div class="sms-own-credit__card">
                                <div class="sms-own-credit__label">@_selectedWorkshopCredit.WorkshopName</div>
                                <div class="sms-own-credit__amount">@($"{_selectedWorkshopCredit.Balance:N0}")</div>
                                <div class="sms-own-credit__sub">تومان</div>
                            </div>
                            <div class="sms-own-credit__card sms-own-credit__card--pending">
                                <div class="sms-own-credit__label">درخواست شارژ در انتظار</div>
                                <div class="sms-own-credit__amount">@dashboard?.PendingChargeCount</div>
                                <div class="sms-own-credit__sub">عدد</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="sms-own-credit">
                            <div class="sms-own-credit__card">
                                <div class="sms-own-credit__label">مجموع اعتبار همه کارگاه‌ها</div>
                                <div class="sms-own-credit__amount">@($"{dashboard?.TotalBalance:N0}")</div>
                                <div class="sms-own-credit__sub">تومان</div>
                            </div>
                            <div class="sms-own-credit__card sms-own-credit__card--pending">
                                <div class="sms-own-credit__label">درخواست شارژ در انتظار</div>
                                <div class="sms-own-credit__amount">@dashboard?.PendingChargeCount</div>
                                <div class="sms-own-credit__sub">عدد</div>
                            </div>
                        </div>
                    }
                </div>
                <div class="sms-stat-grid">
                    <div class="sms-stat-card">
                        <div class="sms-stat-card__icon sms-stat-card__icon--blue"><span class="oi oi-people"></span></div>
                        <div class="sms-stat-card__body">
                            <div class="sms-stat-card__value">@dashboard?.TotalActiveWorkshops</div>
                            <div class="sms-stat-card__label">کارگاه فعال</div>
                        </div>
                    </div>
                    <div class="sms-stat-card">
                        <div class="sms-stat-card__icon sms-stat-card__icon--green"><span class="oi oi-credit-card"></span></div>
                        <div class="sms-stat-card__body">
                            <div class="sms-stat-card__value">@($"{dashboard?.TotalBalance:N0}")</div>
                            <div class="sms-stat-card__label">مجموع اعتبار (تومان)</div>
                        </div>
                    </div>
                    <div class="sms-stat-card">
                        <div class="sms-stat-card__icon sms-stat-card__icon--amber"><span class="oi oi-arrow-top"></span></div>
                        <div class="sms-stat-card__body">
                            <div class="sms-stat-card__value">@dashboard?.TodaySentCount</div>
                            <div class="sms-stat-card__label">ارسال امروز</div>
                        </div>
                    </div>
                </div>
                @if (_canManageGlobal)
                {
                    if (settings == null)
                    {
                        <div class="sms-empty">
                            <p>برای شروع، تنظیمات سامانه پیامک را پیکربندی کنید.</p>
                            <button class="btn btn-primary" @onclick="GoSettingsTab">رفتن به تنظیمات</button>
                        </div>
                    }
                    else if (!settings.IsActive)
                    {
                        <div class="sms-alert sms-alert--warn">
                            <span class="oi oi-warning"></span>
                            <span>سامانه پیامک در حال حاضر غیرفعال است.</span>
                        </div>
                    }
                }
            }
        </div>
    }

    <!-- Tab: Global Settings -->
    @if (activeTab == "settings-global")
    {
        <div class="sms-section">
            <div class="sms-form">
                <div class="sms-form__group">
                    <label class="sms-form__toggle-label">
                        <span>فعال/غیرفعال سامانه پیامک</span>
                        <input type="checkbox" class="sms-toggle" @bind="@settingsEdit.IsActive" />
                        <span class="sms-toggle-track"></span>
                    </label>
                </div>
                <div class="sms-form__group">
                    <label class="sms-form__toggle-label">
                        <span>فعال‌سازی کد تایید (ثبت درخواست آنلاین)</span>
                        <input type="checkbox" class="sms-toggle" @bind="@settingsEdit.OtpEnabled" />
                        <span class="sms-toggle-track"></span>
                    </label>
                    <small class="sms-form__hint">در صورت غیرفعال بودن، کاربران بدون نیاز به کد تایید می‌توانند درخواست ثبت کنند</small>
                </div>
                <div class="sms-form__group">
                    <label class="sms-form__label">تعرفه هر پیامک (تومان)</label>
                    <input type="number" class="sms-input" @bind="@settingsEdit.TariffPerSms" @bind:event="oninput" min="0" step="100" />
                    <small class="sms-form__hint">هزینه هر پیامک به تومان. برای محاسبه تعداد پیامک از این مقدار استفاده می‌شود.</small>
                </div>
                <div class="sms-form__group">
                    <label class="sms-form__label">کلید API</label>
                    <input type="text" class="sms-input" @bind="@settingsEdit.ApiKey" @bind:event="oninput" placeholder="API Key سامانه پیامکی" />
                </div>
                <div class="sms-form__group">
                    <label class="sms-form__label">شماره ارسال</label>
                    <input type="text" class="sms-input" @bind="@settingsEdit.SenderNumber" @bind:event="oninput" placeholder="مثلاً ۱۰۰۰۸۰۸۰" />
                </div>
                <div class="sms-form__group">
                    <label class="sms-form__label">سقف ماهانه (عدد)</label>
                    <input type="number" class="sms-input" @bind="@settingsEdit.MonthlyQuota" @bind:event="oninput" min="0" />
                    <small class="sms-form__hint">صفر به معنای بدون محدودیت</small>
                </div>
                <div class="sms-form__group">
                    <label class="sms-form__label">آستانه هشدار (عدد)</label>
                    <input type="number" class="sms-input" @bind="@settingsEdit.WarningThreshold" @bind:event="oninput" min="0" />
                    <small class="sms-form__hint">زمانی که تعداد پیامک باقی‌مانده کمتر از این مقدار باشد، هشدار نمایش داده شود</small>
                </div>
                <button class="btn btn-primary w-100 py-2 mt-3" @onclick="SaveSettings" disabled="@saving">
                    @(saving ? "در حال ذخیره..." : "ذخیره تنظیمات")
                </button>
            </div>
        </div>
    }

    <!-- Tab: Workshop Settings (ماژول‌های پیامک کارگاه) -->
    @if (activeTab == "settings-workshop")
    {
        <div class="sms-section">
            <div class="sms-form">
                @if (_allWorkshops?.Count > 0)
                {
                    <div class="sms-form__group mb-3">
                        <label class="sms-form__label fw-bold small mb-1">انتخاب کارگاه</label>
                        <select class="form-select rounded-3 bg-light border-0 fw-bold" @onchange="OnWsWorkshopSelected">
                            <option value="">انتخاب کارگاه...</option>
                            @foreach (var w in _allWorkshops)
                            {
                                <option value="@w.Id" selected="@(_wsSelectedWorkshopId == w.Id)">@w.WorkshopName</option>
                            }
                        </select>
                    </div>
                }
                <div class="sms-form__group">
                    <label class="sms-form__toggle-label">
                        <span>فعال/غیرفعال پیامک کارگاه</span>
                        <input type="checkbox" class="sms-toggle" @bind="@_wsSettingsEdit.IsActive" />
                        <span class="sms-toggle-track"></span>
                    </label>
                    <small class="sms-form__hint">در صورت غیرفعال بودن، هیچ پیامکی برای این کارگاه ارسال نخواهد شد</small>
                </div>
                <button class="btn btn-primary w-100 py-2 mt-3" @onclick="SaveWorkshopSettings" disabled="@(_savingWsSettings || (_canManageGlobal && _wsSelectedWorkshopId == null))">
                    @(_savingWsSettings ? "در حال ذخیره..." : "ذخیره تنظیمات کارگاه")
                </button>
            </div>

            <hr class="my-4" />

            <h3 class="sms-section-title">ماژول‌های ارسال پیامک</h3>
            <p class="sms-form__hint mb-3">تعیین کنید برای هر رویداد، پیامک ارسال شود یا خیر</p>

            @if (_wsModules == null)
            {
                <div class="sms-loading">در حال بارگذاری...</div>
            }
            else
            {
                <div class="sms-module-list">
                    @foreach (var mod in _wsModules)
                    {
                        <div class="sms-module-card">
                            <div class="sms-module-card__info">
                                <span class="sms-module-card__title">@mod.ModuleTitle</span>
                            </div>
                            <div class="sms-module-card__actions">
                                <label class="sms-form__toggle-label" style="min-height:unset">
                                    <input type="checkbox" class="sms-toggle"
                                           checked="@mod.IsActive"
                                           @onchange="e => ToggleModule(mod, (bool)e.Value!)" />
                                    <span class="sms-toggle-track"></span>
                                </label>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    }

    <!-- Tab: Credits -->
    @if (activeTab == "credits")
    {
        <div class="sms-section">
            @if (_isAdminCredits)
            {
                <!-- Admin view: all credits -->
                <div class="sms-table-toolbar">
                    <input type="text" class="sms-input sms-input--search"
                           placeholder="جستجوی کارگاه..." bind="@_creditSearch" @oninput="FilterCredits" />
                    <button class="btn btn-outline-primary btn-sm" @onclick="LoadAdminCredits">
                        <span class="oi oi-reload"></span>
                    </button>
                </div>
                @if (_loadingCredits)
                {
                    <div class="sms-loading">در حال بارگذاری...</div>
                }
                else
                {
                    <div class="sms-credit-list">
                        @foreach (var c in _filteredCredits)
                        {
                            <div class="sms-credit-card">
                                <div class="sms-credit-card__header">
                                    <span class="sms-credit-card__name">@c.WorkshopName</span>
                                </div>
                                <div class="sms-credit-card__body">
                                    <div class="sms-credit-card__stat">
                                        <span class="sms-credit-card__stat-label">اعتبار (تومان)</span>
                                        <span class="sms-credit-card__stat-value">@($"{c.Balance:N0}")</span>
                                    </div>
                                    <div class="sms-credit-card__stat">
                                        <span class="sms-credit-card__stat-label">تعداد پیامک</span>
                                        <span class="sms-credit-card__stat-value">@c.SmsCount</span>
                                    </div>
                                </div>
                                @if (_canManageCredits)
                                {
                                    <div class="sms-credit-card__actions">
                                        <button class="btn btn-sm btn-outline-primary"
                                                @onclick="() => OpenAdjustModal(c)">
                                            <span class="oi oi-plus"></span> شارژ دستی
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @if (_filteredCredits.Count == 0)
                    {
                        <div class="sms-empty">هیچ کارگاهی یافت نشد.</div>
                    }
                }
            }
            else
            {
                <!-- Workshop view: own credit -->
                @if (_ownCredit == null)
                {
                    <div class="sms-loading">در حال بارگذاری...</div>
                }
                else
                {
                    <div class="sms-own-credit">
                        <div class="sms-own-credit__card">
                            <div class="sms-own-credit__label">اعتبار فعلی شما</div>
                            <div class="sms-own-credit__amount">@($"{_ownCredit.Balance:N0}")</div>
                            <div class="sms-own-credit__sub">تومان</div>
                        </div>
                        <div class="sms-own-credit__card sms-own-credit__card--secondary">
                            <div class="sms-own-credit__label">تعداد پیامک قابل ارسال</div>
                            <div class="sms-own-credit__amount">@_ownCredit.SmsCount</div>
                            <div class="sms-own-credit__sub">پیامک</div>
                        </div>
                    </div>
                }
            }
        </div>
    }

    <!-- Tab: Charges -->
    @if (activeTab == "charges")
    {
        <div class="sms-section">
            @if (_isAdminCharges)
            {
                <!-- Admin view: all charges + review -->
                <div class="sms-table-toolbar">
                    <select class="sms-input sms-input--select" @bind="@_chargeStatusFilter" @bind:after="LoadAdminCharges">
                        <option value="-1">همه وضعیت‌ها</option>
                        <option value="0">در انتظار تایید</option>
                        <option value="1">تایید شده</option>
                        <option value="2">رد شده</option>
                    </select>
                </div>
                @if (_loadingCharges)
                {
                    <div class="sms-loading">در حال بارگذاری...</div>
                }
                else
                {
                    <div class="sms-charge-list">
                        @foreach (var ch in _charges)
                        {
                            <div class="sms-charge-card @GetChargeCardClass(ch.Status)">
                                <div class="sms-charge-card__row">
                                    <span class="sms-charge-card__workshop">@ch.WorkshopName</span>
                                    <span class="sms-charge-card__status sms-badge sms-badge--@GetChargeBadgeClass(ch.Status)">@ch.StatusTitle</span>
                                </div>
                                <div class="sms-charge-card__row">
                                    <span class="sms-charge-card__amount">@($"{ch.Amount:N0}") تومان</span>
                                    <span class="sms-charge-card__count">@ch.SmsCount پیامک</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(ch.Description))
                                {
                                    <div class="sms-charge-card__desc">@ch.Description</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(ch.ReceiptFilePath))
                                {
                                    <div class="sms-charge-card__receipt">
                                        <a href="@ch.ReceiptFilePath" target="_blank" class="btn btn-sm btn-outline-info">
                                            <span class="oi oi-eye"></span> مشاهده رسید
                                        </a>
                                    </div>
                                }
                                <div class="sms-charge-card__row sms-charge-card__meta">
                                    <span>@PersianDateHelper.ToPersianDateTimeString(ch.CreatedAt.ToLocalTime(), true)</span>
                                    @if (ch.ReviewedBy != null)
                                    {
                                        <span>توسط: @ch.ReviewedBy</span>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(ch.ReviewNote))
                                {
                                    <div class="sms-charge-card__desc@(ch.Status == 2 ? " sms-charge-card__desc--rejected" : "")">@ch.ReviewNote</div>
                                }
                                @if (ch.Status == 0 && _canApproveCharges)
                                {
                                    <div class="sms-charge-card__actions">
                                        <button class="btn btn-sm btn-success" @onclick="() => ReviewCharge(ch.Id, true)">
                                            <span class="oi oi-check"></span> تایید
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => ReviewCharge(ch.Id, false)">
                                            <span class="oi oi-x"></span> رد
                                        </button>
                                    </div>
                                }
                                @if ((ch.Status == 1 || ch.Status == 2) && _canApproveCharges)
                                {
                                    <div class="sms-charge-card__actions">
                                        <button class="btn btn-sm btn-outline-warning" @onclick="() => RevertCharge(ch.Id)">
                                            <span class="oi oi-action-undo"></span> برگشت به انتظار
                                        </button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    @if (_charges.Count == 0)
                    {
                        <div class="sms-empty">هیچ درخواست شارژی یافت نشد.</div>
                    }
                    @if (_totalCharges > _chargePage * _chargePageSize)
                    {
                        <button class="btn btn-outline-primary w-100 mt-2" @onclick="LoadMoreAdminCharges" disabled="@_loadingCharges">
                            بارگذاری بیشتر
                        </button>
                    }
                }
            }

            @if (_isWorkshopCharges)
            {
                <!-- Workshop view: submit charge + own history -->
                @if (!_isAdminCharges)
                {
                    <!-- Only show submit form if user is NOT admin (admin sees admin view above) -->
                    <div class="sms-section-card mb-3">
                        <h3 class="sms-section-title">درخواست شارژ جدید</h3>
                        <div class="sms-form">
                            <div class="sms-form__group">
                                <label class="sms-form__label">مبلغ درخواستی (تومان)</label>
                                <input type="text" class="sms-input ltr-input"
                                       inputmode="numeric"
                                       value="@_chargeRequestDisplay"
                                       @oninput="OnChargeAmountInput"
                                       placeholder="مثلاً ۵۰۰,۰۰۰" />
                            </div>
                            <div class="sms-form__group">
                                <label class="sms-form__label">رسید پرداخت (اختیاری)</label>
                                <div class="sms-receipt-upload">
                                    <InputFile accept="image/*,.pdf" OnChange="@OnReceiptFileSelected" />
                                    <div class="sms-receipt-upload__zone">
                                        @if (_receiptFileName != null)
                                        {
                                            @if (_receiptPreviewUrl != null)
                                            {
                                                <img class="sms-receipt-upload__preview" src="@_receiptPreviewUrl" alt="رسید" />
                                            }
                                            else
                                            {
                                                <span class="oi oi-document"></span>
                                            }
                                            <span class="sms-receipt-upload__name">@_receiptFileName</span>
                                            <button class="btn btn-sm btn-outline-danger sms-receipt-upload__remove"
                                                    @onclick:stopPropagation @onclick="ClearReceiptFile" type="button">حذف</button>
                                        }
                                        else
                                        {
                                            <span class="oi oi-cloud-upload"></span>
                                            <span>رسید واریز را انتخاب کنید</span>
                                        }
                                    </div>
                                </div>
                                <small class="sms-form__hint">تصویر رسید واریزی یا فایل PDF (حداکثر ۲ مگابایت)</small>
                            </div>
                            <div class="sms-form__group">
                                <label class="sms-form__label">توضیحات</label>
                                <textarea class="sms-input sms-input--textarea" rows="2" bind="@_chargeRequestDesc" placeholder="توضیحات (اختیاری)"></textarea>
                            </div>
                            <button class="btn btn-primary w-100 py-2" @onclick="SubmitChargeRequest" disabled="@(_chargeRequestValue < 1000 || _submittingCharge)">
                                @(_submittingCharge ? "در حال ثبت..." : "ثبت درخواست شارژ")
                            </button>
                        </div>
                    </div>
                }

                <!-- Own charge history -->
                <div class="sms-section-card">
                    <h3 class="sms-section-title">تاریخچه درخواست‌های شارژ</h3>
                    @if (!_isAdminCharges)
                    {
                        <div class="sms-table-toolbar">
                            <select class="sms-input sms-input--select" @bind="@_myChargeStatusFilter" @bind:after="LoadMyCharges">
                                <option value="-1">همه وضعیت‌ها</option>
                                <option value="0">در انتظار تایید</option>
                                <option value="1">تایید شده</option>
                                <option value="2">رد شده</option>
                            </select>
                        </div>
                    }
                    @if (_loadingMyCharges)
                    {
                        <div class="sms-loading">در حال بارگذاری...</div>
                    }
                    else
                    {
                        <div class="sms-charge-list">
                            @foreach (var ch in _myCharges)
                            {
                                <div class="sms-charge-card @GetChargeCardClass(ch.Status)">
                                    <div class="sms-charge-card__row">
                                        <span class="sms-charge-card__amount">@($"{ch.Amount:N0}") تومان</span>
                                        <span class="sms-charge-card__count">@ch.SmsCount پیامک</span>
                                        <span class="sms-badge sms-badge--@GetChargeBadgeClass(ch.Status)">@ch.StatusTitle</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(ch.Description))
                                    {
                                        <div class="sms-charge-card__desc">@ch.Description</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(ch.ReceiptFilePath))
