@page "/profile"
@using ErrorService.Shared
@using ErrorService.Shared.Models
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ErrorService.Client.Utils
@attribute [Authorize]
@inject ErrorService.Client.Services.AuthService Auth
@inject ErrorService.Client.Services.JwtAuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject HttpClient Http
@inject ErrorService.Client.Services.ToastService Toast
@inject IJSRuntime JS

<div class="profile-page" dir="rtl">
    <div class="container py-4">
        <div class="row g-4">

            <!-- ═══════════════ SIDEBAR ═══════════════ -->
            <div class="col-lg-3 @(showMobileSidebar ? "show-mobile-sidebar" : "")">
                <div class="pf-sidebar">
                    <!-- Mobile close button -->
                    <button class="pf-sidebar-close d-lg-none" @onclick="() => showMobileSidebar = false">
                        <span class="oi oi-x"></span>
                    </button>

                    <!-- Sidebar Header -->
                    <div class="pf-sidebar-header">
                        <div class="pf-sidebar-avatar">
                            @if (user != null)
                            {
                                @user.FullName[0]
                            }
                        </div>
                        @if (user != null)
                        {
                            <div class="pf-sidebar-name">@user.FullName</div>
                            <div class="pf-sidebar-phone">@user.PhoneNumber</div>
                        }
                        <button class="pf-sidebar-edit" @onclick='() => SwitchTab("edit")'>
                            <span class="oi oi-pencil"></span>
                        </button>
                    </div>

                    <!-- Sidebar Menu -->
                    <div class="pf-sidebar-menu">
                        <button class="pf-menu-item @(activeTab == "overview" ? "active" : "")" @onclick='() => SwitchTab("overview")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-grid-large"></span>
                            </span>
                            <span class="pf-menu-text">پیشخوان</span>
                            @if (myOrders.Any())
                            {
                                <span class="pf-menu-badge">@myOrders.Count</span>
                            }
                        </button>

                        <button class="pf-menu-item @(activeTab == "orders" ? "active" : "")" @onclick='() => SwitchTab("orders")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-cart"></span>
                            </span>
                            <span class="pf-menu-text">سفارشات من</span>
                        </button>

                        <button class="pf-menu-item @(activeTab == "tickets" ? "active" : "")" @onclick='() => SwitchTab("tickets")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-chat"></span>
                            </span>
                            <span class="pf-menu-text">تیکت‌ها</span>
                            @if (myTickets.Any(t => !t.IsUserRead))
                            {
                                <span class="pf-menu-badge pf-badge-red">@myTickets.Count(t => !t.IsUserRead)</span>
                            }
                        </button>

                        <button class="pf-menu-item @(activeTab == "wishlist" ? "active" : "")" @onclick='() => Nav.NavigateTo("/wishlist")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-heart"></span>
                            </span>
                            <span class="pf-menu-text">علاقمندی‌ها</span>
                        </button>

                        <button class="pf-menu-item @(activeTab == "edit" ? "active" : "")" @onclick='() => SwitchTab("edit")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-person"></span>
                            </span>
                            <span class="pf-menu-text">ویرایش پروفایل</span>
                        </button>

                        <button class="pf-menu-item @(activeTab == "password" ? "active" : "")" @onclick='() => SwitchTab("password")'>
                            <span class="pf-menu-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                <span class="oi oi-lock-locked"></span>
                            </span>
                            <span class="pf-menu-text">تغییر رمز عبور</span>
                        </button>
                    </div>

                    <!-- Logout -->
                    <div class="pf-sidebar-footer">
                        <button class="pf-logout-btn" @onclick="HandleLogout">
                            <span class="oi oi-account-logout"></span>
                            خروج از حساب
                        </button>
                    </div>
                </div>
            </div>

            <!-- ═══════════════ MAIN CONTENT ═══════════════ -->
            <div class="col-lg-9">
                <!-- Mobile top bar -->
                <div class="pf-mobile-topbar d-lg-none">
                    <button class="pf-mobile-menu-btn" @onclick="() => showMobileSidebar = true">
                        <span class="oi oi-menu"></span>
                    </button>
                    <div class="pf-mobile-title">پنل کاربری</div>
                    <button class="pf-mobile-avatar" @onclick='() => SwitchTab("edit")'>
                        @if (user != null) { @user.FullName[0] }
                    </button>
                </div>

                <div class="pf-content-card">

                    @if (user == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-danger"></div>
                        </div>
                    }
                    else
                    {
                        <!-- ══════════ OVERVIEW ══════════ -->
                        @if (activeTab == "overview")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <!-- Profile Completion Banner -->
                                @if (MissingProfileFields.Any())
                                {
                                    <div class="pf-alert-banner mb-4">
                                        <div class="pf-alert-icon">
                                            <span class="oi oi-info"></span>
                                        </div>
                                        <div class="pf-alert-text">
                                            <div class="pf-alert-title">تکمیل پروفایل</div>
                                            <div class="pf-alert-sub">@MissingProfileFields.Count مورد باقی‌مانده: @string.Join("، ", MissingProfileFields)</div>
                                        </div>
                                        <button class="pf-alert-btn" @onclick='() => SwitchTab("edit")'>تکمیل</button>
                                    </div>
                                }

                                <!-- Stat Cards -->
                                <div class="pf-stats-grid">
                                    <div class="pf-stat-card">
                                        <div class="pf-stat-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                            <span class="oi oi-cart"></span>
                                        </div>
                                        <div class="pf-stat-info">
                                            <div class="pf-stat-number">@myOrders.Count</div>
                                            <div class="pf-stat-label">سفارش‌ها</div>
                                        </div>
                                    </div>
                                    <div class="pf-stat-card">
                                        <div class="pf-stat-icon" style="background: rgba(255,193,7,0.15); color: #e67700;">
                                            <span class="oi oi-credit-card"></span>
                                        </div>
                                        <div class="pf-stat-info">
                                            <div class="pf-stat-number">@myOrders.Count(o => o.Status == OrderStatus.PendingPayment)</div>
                                            <div class="pf-stat-label">بن خرید</div>
                                        </div>
                                    </div>
                                    <div class="pf-stat-card">
                                        <div class="pf-stat-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                            <span class="oi oi-chat"></span>
                                        </div>
                                        <div class="pf-stat-info">
                                            <div class="pf-stat-number">@myTickets.Count</div>
                                            <div class="pf-stat-label">تیکت‌ها</div>
                                        </div>
                                    </div>
                                    <div class="pf-stat-card">
                                        <div class="pf-stat-icon" style="background: rgba(220,53,69,0.1); color: #dc3545;">
                                            <span class="oi oi-heart"></span>
                                        </div>
                                        <div class="pf-stat-info">
                                            <div class="pf-stat-number">0</div>
                                            <div class="pf-stat-label">علاقه‌مندی‌ها</div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Notifications -->
                                <div class="pf-section mt-4">
                                    <div class="pf-section-header">
                                        <div class="pf-section-title">
                                            <span class="oi oi-bell" style="color: #dc3545;"></span>
                                            اعلان‌ها
                                        </div>
                                        <span class="pf-section-badge">جدید</span>
                                    </div>
                                    <div class="pf-notifications-list">
                                        <div class="pf-notification-item">
                                            <div class="pf-notif-dot"></div>
                                            <div class="pf-notif-content">
                                                <div class="pf-notif-title">بروزرسانی داشبورد کاربری فروشگاه ارورسرویس</div>
                                                <div class="pf-notif-desc">صفحه داشبورد کاربری فروشگاه ارورسرویس با طراحی جدید و امکانات کاربردی بروزرسانی شده است.</div>
                                                <div class="pf-notif-date">۱۴ تیر ۱۴۰۴</div>
                                            </div>
                                        </div>
                                        <div class="pf-notification-item">
                                            <div class="pf-notif-dot"></div>
                                            <div class="pf-notif-content">
                                                <div class="pf-notif-title">بروزرسانی مرکز خدمات و پشتیبانی ارورسرویس</div>
                                                <div class="pf-notif-desc">مرکز خدمات و پشتیبانی ارورسرویس بروزرسانی شده است تا پشتیبانی دریافت خدمات بهتر و سریع‌تر انجام شود.</div>
                                                <div class="pf-notif-date">۱۰ خرداد ۱۴۰۴</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Latest Order -->
                                @if (myOrders.Any())
                                {
                                    var latest = myOrders.First();
                                    <div class="pf-section mt-4">
                                        <div class="pf-section-header">
                                            <div class="pf-section-title">
                                                <span class="oi oi-document" style="color: #dc3545;"></span>
                                                وضعیت آخرین سفارش شما
                                            </div>
                                            <span class="pf-order-number">#@latest.OrderNumber</span>
                                        </div>
                                        <div class="pf-order-progress">
                                            <div class="pf-progress-steps">
                                                @{
                                                    var steps = new[] {
                                                        ("آماده سازی", "۱۴۰۴/۰۴/۲۴", latest.Status >= OrderStatus.Approved),
                                                        ("در حال پردازش", "۱۴۰۴/۰۴/۲۴", latest.Status >= OrderStatus.Approved),
                                                        ("پرداخت تایید شده", "۱۴۰۴/۰۴/۲۴", latest.Status >= OrderStatus.Approved),
                                                        ("در انتظار تایید", "", latest.Status == OrderStatus.PendingPayment || latest.Status == OrderStatus.ReceiptUploaded)
                                                    };
                                                    int idx = 0;
                                                }
                                                @foreach (var (label, date, isActive) in steps)
                                                {
                                                    idx++;
                                                    <div class="pf-progress-step @(isActive ? "active" : "") @(idx == steps.Length ? "last" : "")">
                                                        <div class="pf-step-dot">
                                                            @if (isActive)
                                                            {
                                                                <span class="oi oi-check"></span>
                                                            }
                                                            else
                                                            {
                                                                <span>@idx</span>
                                                            }
                                                        </div>
                                                        <div class="pf-step-label">@label</div>
                                                        @if (!string.IsNullOrEmpty(date))
                                                        {
                                                            <div class="pf-step-date">@date</div>
                                                        }
                                                    </div>
                                                    @if (idx < steps.Length)
                                                    {
                                                        <div class="pf-step-line @(isActive ? "active" : "")"></div>
                                                    }
                                                }
                                            </div>
                                        </div>
                                    </div>
                                }

                                <!-- Recent Orders Table -->
                                <div class="pf-section mt-4">
                                    <div class="pf-section-header">
                                        <div class="pf-section-title">
                                            <span class="oi oi-clock" style="color: #dc3545;"></span>
                                            آخرین سفارشات
                                        </div>
                                        <button class="pf-section-link" @onclick='() => SwitchTab("orders")'>مشاهده همه</button>
                                    </div>
                                    @if (!myOrders.Any())
                                    {
                                        <div class="pf-empty-state">
                                            <span class="oi oi-cart"></span>
                                            <p>هنوز سفارشی ثبت نکرده‌اید.</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pf-table-responsive">
                                            <table class="pf-table">
                                                <thead>
                                                    <tr>
                                                        <th>شماره سفارش</th>
                                                        <th>تاریخ ثبت</th>
                                                        <th>وضعیت</th>
                                                        <th>مبلغ</th>
                                                        <th>جزئیات</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var o in myOrders.Take(3))
                                                    {
                                                        <tr>
                                                            <td class="fw-bold">#@o.OrderNumber</td>
                                                            <td>@PersianDate.ToJalaliDate(o.CreatedAt)</td>
                                                            <td><span class="pf-status-badge @GetOrderStatusClass(o.Status)">@GetOrderStatusLabel(o.Status)</span></td>
                                                            <td class="fw-bold">@o.TotalAmount.ToString("N0") ریال</td>
                                                            <td><button class="pf-view-btn" @onclick="() => ToggleOrder(o.Id)">مشاهده</button></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- ══════════ ORDERS ══════════ -->
                        else if (activeTab == "orders")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <div class="pf-tab-header">
                                    <h5 class="pf-tab-title">
                                        <span class="oi oi-clock"></span>
                                        تاریخچه سفارشات
                                    </h5>
                                    <button class="pf-refresh-btn" @onclick="LoadOrdersAsync">
                                        <span class="oi oi-reload"></span>
                                    </button>
                                </div>

                                <!-- Filter Tabs -->
                                <div class="pf-filter-tabs">
                                    <button class="pf-filter-tab @(orderFilter == "all" ? "active" : "")" @onclick='() => orderFilter = "all"'>
                                        <span class="oi oi-grid-large"></span>
                                        همه (@myOrders.Count)
                                    </button>
                                    <button class="pf-filter-tab @(orderFilter == "pending" ? "active" : "")" @onclick='() => orderFilter = "pending"'>
                                        <span class="oi oi-credit-card"></span>
                                        پرداخت نشده (@myOrders.Count(o => o.Status == OrderStatus.PendingPayment))
                                    </button>
                                    <button class="pf-filter-tab @(orderFilter == "cancelled" ? "active" : "")" @onclick='() => orderFilter = "cancelled"'>
                                        <span class="oi oi-ban"></span>
                                        لغو شده (@myOrders.Count(o => o.Status == OrderStatus.Cancelled))
                                    </button>
                                </div>

                                @if (isLoadingOrders)
                                {
                                    <div class="text-center py-4">
                                        <div class="spinner-border spinner-border-sm text-danger"></div>
                                    </div>
                                }
                                else
                                {
                                    var filteredOrders = orderFilter switch
                                    {
                                        "pending" => myOrders.Where(o => o.Status == OrderStatus.PendingPayment).ToList(),
                                        "cancelled" => myOrders.Where(o => o.Status == OrderStatus.Cancelled).ToList(),
                                        _ => myOrders
                                    };

                                    @if (!filteredOrders.Any())
                                    {
                                        <div class="pf-empty-state">
                                            <span class="oi oi-cart"></span>
                                            <p>سفارشی یافت نشد</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pf-table-responsive">
                                            <table class="pf-table pf-table-full">
                                                <thead>
                                                    <tr>
                                                        <th>شماره سفارش</th>
                                                        <th>تاریخ ثبت</th>
                                                        <th>وضعیت</th>
                                                        <th>مبلغ</th>
                                                        <th>جزئیات</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var o in filteredOrders)
                                                    {
                                                        <tr class="cursor-pointer" @onclick="() => ToggleOrder(o.Id)">
                                                            <td class="fw-bold">#@o.OrderNumber</td>
                                                            <td>@PersianDate.ToJalaliDate(o.CreatedAt)</td>
                                                            <td><span class="pf-status-badge @GetOrderStatusClass(o.Status)">@GetOrderStatusLabel(o.Status)</span></td>
                                                            <td class="fw-bold">@o.TotalAmount.ToString("N0") ریال</td>
                                                            <td><button class="pf-view-btn" @onclick="() => ToggleOrder(o.Id)" @onclick:stopPropagation>مشاهده</button></td>
                                                        </tr>

                                                        @if (expandedOrders.Contains(o.Id))
                                                        {
                                                            <tr>
                                                                <td colspan="5" class="pf-order-expanded">
                                                                    <div class="pf-order-details">
                                                                        <div class="pf-detail-grid">
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">روش پرداخت</div>
                                                                                <div class="pf-detail-value">کارت به کارت</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">شماره پیگیری</div>
                                                                                <div class="pf-detail-value">@(string.IsNullOrWhiteSpace(o.TrackingNumber) ? "---" : o.TrackingNumber)</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">تاریخ پرداخت</div>
                                                                                <div class="pf-detail-value">@(o.PaymentDate.HasValue ? PersianDate.ToJalaliDateTime(o.PaymentDate.Value) : "---")</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">نام خریدار</div>
                                                                                <div class="pf-detail-value">@o.FullName</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">موبایل</div>
                                                                                <div class="pf-detail-value" dir="ltr">@o.PhoneNumber</div>
                                                                            </div>
                                                                            <div class="pf-detail-box">
                                                                                <div class="pf-detail-label">ایمیل</div>
                                                                                <div class="pf-detail-value">@(string.IsNullOrWhiteSpace(o.Email) ? "---" : o.Email)</div>
                                                                            </div>
                                                                        </div>

                                                                        @if (!string.IsNullOrWhiteSpace(o.Address))
                                                                        {
                                                                            <div class="pf-detail-address">
                                                                                <span class="oi oi-map-marker"></span>
                                                                                @o.Address
                                                                            </div>
                                                                        }

                                                                        @if (!string.IsNullOrWhiteSpace(o.AdminNotes))
                                                                        {
                                                                            <div class="pf-detail-note">
                                                                                <span class="oi oi-info"></span>
                                                                                <strong>یادداشت مدیر:</strong> @o.AdminNotes
                                                                            </div>
                                                                        }

                                                                        @if (!string.IsNullOrEmpty(o.ReceiptImageUrl))
                                                                        {
                                                                            <div class="pf-detail-receipt">
                                                                                <div class="pf-detail-label mb-2">رسید پرداخت</div>
                                                                                <a href="@o.ReceiptImageUrl" target="_blank">
                                                                                    <img src="@o.ReceiptImageUrl" class="pf-receipt-img" />
                                                                                </a>
                                                                            </div>
                                                                        }

                                                                        <div class="pf-order-items">
                                                                            @foreach (var it in o.Items)
                                                                            {
                                                                                <div class="pf-order-item">
                                                                                    <div class="pf-item-name">@it.ProductName</div>
                                                                                    <div class="pf-item-meta">
                                                                                        <span>تعداد: @it.Quantity</span>
                                                                                        <span>قیمت واحد: @it.Price.ToString("N0")</span>
                                                                                        <span class="fw-bold">جمع: @((it.Price * it.Quantity).ToString("N0"))</span>
                                                                                    </div>
                                                                                </div>
                                                                            }
                                                                        </div>

                                                                        <div class="pf-order-total">
                                                                            <span>جمع کل پرداختی</span>
                                                                            <span class="fw-bold text-danger">@o.TotalAmount.ToString("N0") ریال</span>
                                                                        </div>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        }
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                            </div>
                        }

                        <!-- ══════════ TICKETS ══════════ -->
                        else if (activeTab == "tickets")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                @if (selectedTicketForProfile == null && !isCreatingNewTicket)
                                {
                                    <div class="pf-tab-header">
                                        <h5 class="pf-tab-title">
                                            <span class="oi oi-chat"></span>
                                            تیکت‌های پشتیبانی
                                        </h5>
                                        <button class="pf-primary-btn" @onclick="() => isCreatingNewTicket = true">
                                            <span class="oi oi-plus"></span>
                                            ثبت تیکت جدید
                                        </button>
                                    </div>

                                    @if (isLoadingTickets)
                                    {
                                        <div class="text-center py-4">
                                            <div class="spinner-border spinner-border-sm text-danger"></div>
                                        </div>
                                    }
                                    else if (!myTickets.Any())
                                    {
                                        <div class="pf-empty-state">
                                            <span class="oi oi-chat"></span>
                                            <p>هنوز تیکتی ثبت نکرده‌اید</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="pf-tickets-list">
                                            @foreach (var t in myTickets)
                                            {
                                                var isUnread = !t.IsUserRead;
                                                <div class="pf-ticket-card @(isUnread ? "unread" : "")" @onclick="() => SelectTicketForProfile(t)">
                                                    <div class="pf-ticket-header">
                                                        <div class="pf-ticket-info">
                                                            @if (isUnread)
                                                            {
                                                                <span class="pf-ticket-new">پاسخ جدید</span>
                                                            }
                                                            <h6 class="pf-ticket-title">@t.Title</h6>
                                                            <span class="pf-ticket-date">@FormatJalaliDateTime(t.CreatedAt)</span>
                                                        </div>
                                                        <span class="pf-status-badge @GetTicketStatusClass(t)">@GetTicketStatusLabel(t)</span>
                                                    </div>
                                                    <p class="pf-ticket-desc">@t.Description</p>
                                                    <div class="pf-ticket-footer">
                                                        <div class="pf-ticket-avatars">
                                                            <span class="pf-avatar-mini user">شما</span>
                                                            @if (t.Replies.Any(r => r.IsAdmin))
                                                            {
                                                                <span class="pf-avatar-mini admin">تیم</span>
                                                            }
                                                        </div>
                                                        <span class="pf-ticket-replies">@t.Replies.Count پاسخ</span>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    }
                                }
                                else if (isCreatingNewTicket)
                                {
                                    <div class="pf-tab-header">
                                        <button class="pf-back-btn" @onclick="() => isCreatingNewTicket = false">
                                            <span class="oi oi-chevron-right"></span>
                                        </button>
                                        <h5 class="pf-tab-title">ثبت تیکت جدید</h5>
                                    </div>
                                    <div class="pf-form-card">
                                        <EditForm Model="newTicket" OnValidSubmit="HandleSubmitTicket">
                                            <DataAnnotationsValidator />
                                            <div class="pf-form-group">
                                                <label class="pf-form-label">موضوع</label>
                                                <InputText class="pf-form-input" @bind-Value="newTicket.Title" placeholder="عنوان کوتاه موضوع" />
                                                <ValidationMessage For="@(() => newTicket.Title)" class="text-danger smaller" />
                                            </div>
                                            <div class="pf-form-group">
                                                <label class="pf-form-label">شرح دقیق مشکل</label>
                                                <InputTextArea class="pf-form-input" @bind-Value="newTicket.Description" rows="4" placeholder="علائم خرابی را بنویسید..." />
                                                <ValidationMessage For="@(() => newTicket.Description)" class="text-danger smaller" />
                                            </div>
                                            <div class="pf-form-group">
                                                <label class="pf-form-label">آپلود مستندات (اختیاری)</label>
                                                <div class="pf-upload-zone">
                                                    <InputFile OnChange="OnAttachmentSelected" class="pf-upload-input" />
                                                    @if (!string.IsNullOrEmpty(newTicket.ImageUrl) || !string.IsNullOrEmpty(newTicket.FileUrl))
                                                    {
                                                        <span class="oi oi-check text-success display-6"></span>
                                                        <div class="small fw-bold mt-2">فایل انتخاب شد</div>
                                                    }
                                                    else
                                                    {
                                                        <span class="oi oi-paperclip text-danger display-6"></span>
                                                        <div class="small text-muted mt-2">برای انتخاب تصویر یا فایل کلیک کنید</div>
                                                    }
                                                </div>
                                            </div>
                                            <button type="submit" class="pf-primary-btn w-100" disabled="@isBusy">
                                                @if (isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                ارسال تیکت پشتیبانی
                                            </button>
                                        </EditForm>
                                    </div>
                                }
                                else if (selectedTicketForProfile != null)
                                {
                                    <div class="pf-tab-header">
                                        <button class="pf-back-btn" @onclick="() => selectedTicketForProfile = null">
                                            <span class="oi oi-chevron-right"></span>
                                        </button>
                                        <div class="overflow-hidden">
                                            <h6 class="pf-tab-title mb-0 text-truncate">@selectedTicketForProfile.Title</h6>
                                            <span class="pf-status-badge @GetTicketStatusClass(selectedTicketForProfile) smaller">@GetTicketStatusLabel(selectedTicketForProfile)</span>
                                        </div>
                                    </div>

                                    <div class="pf-chat-area">
                                        <!-- User Message -->
                                        <div class="pf-chat-msg user">
                                            <div class="pf-chat-avatar user">شما</div>
                                            <div class="pf-chat-bubble user">
                                                <p class="mb-0 small">@selectedTicketForProfile.Description</p>
                                                @if (!string.IsNullOrEmpty(selectedTicketForProfile.ImageUrl))
                                                {
                                                    <img src="@selectedTicketForProfile.ImageUrl" class="img-fluid rounded-3 mt-2 border shadow-sm" style="max-height: 200px;" />
                                                }
                                                @if (!string.IsNullOrEmpty(selectedTicketForProfile.FileUrl))
                                                {
                                                    <div class="mt-2 p-2 bg-light rounded-3 border d-flex align-items-center gap-2">
                                                        <span class="oi oi-file text-primary"></span>
                                                        <span class="smaller text-truncate flex-grow-1">@selectedTicketForProfile.FileName</span>
                                                        <a href="@selectedTicketForProfile.FileUrl" target="_blank" class="btn btn-sm btn-link p-0"><span class="oi oi-cloud-download"></span></a>
                                                    </div>
                                                }
                                                <div class="pf-chat-time">@FormatJalaliDateTime(selectedTicketForProfile.CreatedAt)</div>
                                            </div>
                                        </div>

                                        @foreach (var reply in selectedTicketForProfile.Replies)
                                        {
                                            <div class="pf-chat-msg @(reply.IsAdmin ? "admin" : "user")">
                                                <div class="pf-chat-avatar @(reply.IsAdmin ? "admin" : "user")">@(reply.IsAdmin ? "تیم" : "شما")</div>
                                                <div class="pf-chat-bubble @(reply.IsAdmin ? "admin" : "user")">
                                                    <p class="mb-0 small">@reply.Message</p>
                                                    @if (!string.IsNullOrEmpty(reply.AttachmentUrl))
                                                    {
                                                        <div class="mt-2 p-2 @(reply.IsAdmin ? "bg-white bg-opacity-50" : "bg-light") rounded-3 border d-flex align-items-center gap-2">
                                                            <span class="oi @(reply.AttachmentContentType?.StartsWith("image/") == true ? "oi-image" : "oi-file") text-primary"></span>
                                                            <span class="smaller text-truncate flex-grow-1">@reply.AttachmentName</span>
                                                            <a href="@reply.AttachmentUrl" target="_blank" class="btn btn-sm btn-link p-0"><span class="oi oi-cloud-download"></span></a>
                                                        </div>
                                                    }
                                                    <div class="pf-chat-time @(reply.IsAdmin ? "admin" : "")">@FormatJalaliDateTime(reply.RepliedAt)</div>
                                                </div>
                                            </div>
                                        }
                                    </div>

                                    <div class="pf-chat-input">
                                        <input type="text" class="pf-form-input" placeholder="پاسخ..." @bind="replyMessage" />
                                        <button class="pf-primary-btn" @onclick="HandleReplySubmit" disabled="@(string.IsNullOrEmpty(replyMessage) || isBusy)">ارسال</button>
                                    </div>
                                }
                            </div>
                        }

                        <!-- ══════════ EDIT PROFILE ══════════ -->
                        else if (activeTab == "edit")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <div class="pf-tab-header">
                                    <h5 class="pf-tab-title">
                                        <span class="oi oi-person"></span>
                                        ویرایش اطلاعات شخصی
                                    </h5>
                                </div>
                                <div class="pf-form-card">
                                    <EditForm Model="updateModel" OnValidSubmit="HandleUpdateProfile">
                                        <DataAnnotationsValidator />
                                        <div class="row g-3">
                                            <div class="col-md-6">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">نام و نام خانوادگی</label>
                                                    <InputText class="pf-form-input" @bind-Value="updateModel.FullName" />
                                                    <ValidationMessage For="@(() => updateModel.FullName)" class="text-danger smaller" />
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">شماره موبایل (غیرقابل تغییر)</label>
                                                    <input type="text" class="pf-form-input readonly" value="@user.PhoneNumber" readonly />
                                                </div>
                                            </div>
                                            <div class="col-12">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">آدرس ایمیل</label>
                                                    <InputText class="pf-form-input" @bind-Value="updateModel.Email" placeholder="example@mail.com" />
                                                </div>
                                            </div>
                                            <div class="col-md-4">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">کد پستی</label>
                                                    <InputText class="pf-form-input" @bind-Value="updateModel.PostalCode" placeholder="۱۰ رقم" />
                                                </div>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="pf-form-group">
                                                    <label class="pf-form-label">آدرس کامل پستی</label>
                                                    <InputTextArea class="pf-form-input" @bind-Value="updateModel.Address" rows="2" placeholder="استان، شهر، خیابان..." />
                                                </div>
                                            </div>
                                            <div class="col-12 mt-4">
                                                <button type="submit" class="pf-primary-btn px-5" disabled="@isBusy">
                                                    @if (isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                    ذخیره تغییرات
                                                </button>
                                            </div>
                                        </div>
                                    </EditForm>
                                </div>
                            </div>
                        }

                        <!-- ══════════ CHANGE PASSWORD ══════════ -->
                        else if (activeTab == "password")
                        {
                            <div class="pf-tab-content animate__animated animate__fadeIn">
                                <div class="pf-tab-header">
                                    <h5 class="pf-tab-title">
                                        <span class="oi oi-lock-locked"></span>
                                        تغییر رمز عبور
                                    </h5>
                                </div>
                                <div class="pf-form-card" style="max-width: 500px;">
                                    <EditForm Model="passwordModel" OnValidSubmit="HandleChangePassword">
                                        <DataAnnotationsValidator />
                                        <div class="pf-form-group">
                                            <label class="pf-form-label">رمز عبور فعلی</label>
                                            <InputText type="password" class="pf-form-input" @bind-Value="passwordModel.CurrentPassword" />
                                            <ValidationMessage For="@(() => passwordModel.CurrentPassword)" class="text-danger smaller" />
                                        </div>
                                        <div class="pf-form-group">
                                            <label class="pf-form-label">رمز عبور جدید</label>
                                            <InputText type="password" class="pf-form-input" @bind-Value="passwordModel.NewPassword" />
                                            <ValidationMessage For="@(() => passwordModel.NewPassword)" class="text-danger smaller" />
                                        </div>
                                        <div class="mt-4">
                                            <button type="submit" class="pf-outline-btn px-4" disabled="@isBusy">
                                                @if (isBusy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                                                تغییر رمز عبور
                                            </button>
                                        </div>
                                    </EditForm>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Mobile Sidebar Overlay -->
@if (showMobileSidebar)
{
    <div class="pf-sidebar-overlay" @onclick="() => showMobileSidebar = false"></div>
}

<style>
    /* ═══════════════ VARIABLES ═══════════════ */
    :root {
        --pf-red: #dc3545;
        --pf-red-light: rgba(220,53,69,0.08);
        --pf-red-dark: #b02a37;
        --pf-bg: #f5f5f5;
        --pf-card: #ffffff;
        --pf-border: rgba(0,0,0,0.06);
        --pf-text: #1a1a1a;
        --pf-text-muted: #6c757d;
        --pf-radius: 16px;
        --pf-radius-sm: 12px;
        --pf-shadow: 0 2px 12px rgba(0,0,0,0.06);
    }

    .fw-black { font-weight: 900; }
    .smaller { font-size: 0.7rem; }

    /* ═══════════════ SIDEBAR ═══════════════ */
    .pf-sidebar {
        background: var(--pf-card);
        border-radius: var(--pf-radius);
        box-shadow: var(--pf-shadow);
        overflow: hidden;
        position: sticky;
        top: 140px;
    }

    .pf-sidebar-header {
        background: linear-gradient(135deg, #dc3545 0%, #ff6b6b 100%);
        padding: 28px 20px 24px;
        text-align: center;
        position: relative;
        color: #fff;
    }

    .pf-sidebar-avatar {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(255,255,255,0.25);
        backdrop-filter: blur(8px);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.6rem;
        font-weight: 800;
        color: #fff;
        border: 3px solid rgba(255,255,255,0.4);
        margin-bottom: 10px;
    }

    .pf-sidebar-name {
        font-size: 1rem;
        font-weight: 800;
        margin-bottom: 2px;
    }

    .pf-sidebar-phone {
        font-size: 0.82rem;
        opacity: 0.85;
    }

    .pf-sidebar-edit {
        position: absolute;
        top: 16px;
        left: 16px;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        border: none;
        color: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: background 0.2s;
        font-size: 0.8rem;
    }
    .pf-sidebar-edit:hover { background: rgba(255,255,255,0.35); }

    .pf-sidebar-menu {
        padding: 12px;
    }

    .pf-menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
        padding: 11px 14px;
        border: none;
        background: transparent;
        border-radius: var(--pf-radius-sm);
        cursor: pointer;
        transition: all 0.15s;
        font-family: inherit;
        color: var(--pf-text);
        font-size: 0.88rem;
        font-weight: 600;
        text-align: right;
    }
    .pf-menu-item:hover { background: var(--pf-red-light); }
    .pf-menu-item.active {
        background: var(--pf-red-light);
        color: var(--pf-red);
    }

    .pf-menu-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        font-size: 0.9rem;
        flex-shrink: 0;
    }

    .pf-menu-text { flex: 1; }

    .pf-menu-badge {
        background: var(--pf-red);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 800;
        min-width: 20px;
        height: 20px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 6px;
    }
    .pf-badge-red { background: #dc3545; }

    .pf-sidebar-footer {
        padding: 12px;
        border-top: 1px solid var(--pf-border);
    }

    .pf-logout-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        width: 100%;
        padding: 10px;
        border: 2px solid var(--pf-red);
        background: transparent;
        color: var(--pf-red);
        border-radius: var(--pf-radius-sm);
        font-weight: 700;
        font-size: 0.88rem;
        cursor: pointer;
        transition: all 0.2s;
        font-family: inherit;
    }
    .pf-logout-btn:hover {
        background: var(--pf-red);
        color: #fff;
    }

    .pf-sidebar-close {
        position: absolute;
        top: 12px;
        left: 12px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        border: none;
        color: #fff;
        display: grid;
        place-items: center;
        cursor: pointer;
        z-index: 10;
    }

    /* ═══════════════ MOBILE TOPBAR ═══════════════ */
    .pf-mobile-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 0;
        margin-bottom: 12px;
    }
    .pf-mobile-menu-btn, .pf-mobile-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: none;
        display: grid;
        place-items: center;
        cursor: pointer;
        font-size: 1rem;
    }
    .pf-mobile-menu-btn {
        background: var(--pf-card);
        color: var(--pf-text);
        box-shadow: var(--pf-shadow);
    }
    .pf-mobile-avatar {
        background: linear-gradient(135deg, #dc3545, #ff6b6b);
        color: #fff;
        font-weight: 700;
    }
    .pf-mobile-title {
        font-weight: 800;
        font-size: 1rem;
    }

    /* ═══════════════ CONTENT CARD ═══════════════ */
    .pf-content-card {
        background: var(--pf-card);
        border-radius: var(--pf-radius);
        box-shadow: var(--pf-shadow);
        padding: 24px;
        min-height: 60vh;
    }

    .pf-tab-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        gap: 12px;
    }

    .pf-tab-title {
        font-weight: 900;
        font-size: 1.05rem;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .pf-tab-title .oi { color: var(--pf-red); }

    /* ═══════════════ STAT CARDS ═══════════════ */
    .pf-stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }

    .pf-stat-card {
        background: var(--pf-card);
        border: 1px solid var(--pf-border);
        border-radius: var(--pf-radius-sm);
        padding: 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .pf-stat-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 16px rgba(0,0,0,0.08);
    }

    .pf-stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        font-size: 1.3rem;
        flex-shrink: 0;
    }

    .pf-stat-number {
        font-size: 1.4rem;
        font-weight: 900;
        line-height: 1.2;
    }

    .pf-stat-label {
        font-size: 0.78rem;
        color: var(--pf-text-muted);
        font-weight: 600;
    }

    /* ═══════════════ NOTIFICATIONS ═══════════════ */
    .pf-section {
        border: 1px solid var(--pf-border);
        border-radius: var(--pf-radius);
        overflow: hidden;
    }

    .pf-section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 14px 16px;
        border-bottom: 1px solid var(--pf-border);
    }

    .pf-section-title {
        font-weight: 800;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pf-section-badge {
        background: var(--pf-red);
        color: #fff;
        font-size: 0.65rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .pf-section-link {
        background: none;
        border: none;
        color: var(--pf-red);
        font-weight: 700;
        font-size: 0.82rem;
        cursor: pointer;
        font-family: inherit;
    }
    .pf-section-link:hover { text-decoration: underline; }

    .pf-notifications-list {
        max-height: 300px;
        overflow-y: auto;
    }

    .pf-notification-item {
        display: flex;
        gap: 12px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--pf-border);
        transition: background 0.15s;
    }
    .pf-notification-item:last-child { border-bottom: none; }
    .pf-notification-item:hover { background: rgba(0,0,0,0.015); }

    .pf-notif-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--pf-red);
        flex-shrink: 0;
        margin-top: 6px;
    }

    .pf-notif-title {
        font-weight: 700;
        font-size: 0.85rem;
        margin-bottom: 4px;
    }

    .pf-notif-desc {
        font-size: 0.78rem;
        color: var(--pf-text-muted);
        line-height: 1.5;
        margin-bottom: 4px;
    }

    .pf-notif-date {
        font-size: 0.7rem;
        color: var(--pf-text-muted);
    }

    .pf-order-number {
        background: var(--pf-red-light);
        color: var(--pf-red);
        font-weight: 800;
        font-size: 0.8rem;
        padding: 4px 12px;
        border-radius: 20px;
    }

    /* ═══════════════ PROGRESS BAR ═══════════════ */
    .pf-order-progress {
        padding: 20px 16px;
    }

    .pf-progress-steps {
        display: flex;
        align-items: flex-start;
        gap: 0;
    }

    .pf-progress-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        flex: 1;
        position: relative;
    }

    .pf-step-dot {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: #e9ecef;
        color: #adb5bd;
        display: grid;
        place-items: center;
        font-size: 0.75rem;
        font-weight: 700;
        margin-bottom: 8px;
        transition: all 0.3s;
        z-index: 2;
    }

    .pf-progress-step.active .pf-step-dot {
        background: #198754;
        color: #fff;
    }

    .pf-step-label {
        font-size: 0.72rem;
        font-weight: 700;
        color: var(--pf-text-muted);
        max-width: 80px;
    }
    .pf-progress-step.active .pf-step-label { color: var(--pf-text); }

    .pf-step-date {
        font-size: 0.65rem;
        color: var(--pf-text-muted);
        margin-top: 2px;
    }

    .pf-step-line {
        flex: 1;
        height: 3px;
        background: #e9ecef;
        margin-top: 14px;
        border-radius: 2px;
        min-width: 20px;
    }
    .pf-step-line.active { background: #198754; }

    /* ═══════════════ TABLE ═══════════════ */
    .pf-table-responsive {
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .pf-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.85rem;
    }

    .pf-table th {
        background: #f8f9fa;
        padding: 12px 14px;
        font-weight: 700;
        color: var(--pf-text-muted);
        font-size: 0.78rem;
        border-bottom: 2px solid var(--pf-border);
        white-space: nowrap;
        text-align: right;
    }

    .pf-table td {
        padding: 12px 14px;
        border-bottom: 1px solid var(--pf-border);
        vertical-align: middle;
    }

    .pf-table tbody tr:hover { background: rgba(220,53,69,0.02); }

    .pf-table-full { width: 100%; }

    .pf-order-expanded td {
        padding: 0 14px 14px;
        background: #fafbfc;
    }

    /* ═══════════════ STATUS BADGES ═══════════════ */
    .pf-status-badge {
        display: inline-flex;
        align-items: center;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.72rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .pf-status-badge.bg-warning-subtle { background: #fff3cd; color: #856404; }
    .pf-status-badge.bg-info-subtle { background: #cffafe; color: #0e7490; }
    .pf-status-badge.bg-success-subtle { background: #d1fae5; color: #065f46; }
    .pf-status-badge.bg-danger-subtle { background: #fee2e2; color: #991b1b; }
    .pf-status-badge.bg-secondary-subtle { background: #e9ecef; color: #495057; }
    .pf-status-badge.bg-success { background: #198754; color: #fff; }
    .pf-status-badge.bg-primary-subtle { background: #dbeafe; color: #1e40af; }

    .pf-status-badge.bg-warning { background: #ffc107; color: #000; }
    .pf-status-badge.bg-info { background: #0dcaf0; color: #000; }
    .pf-status-badge.bg-danger { background: #dc3545; color: #fff; }
    .pf-status-badge.bg-secondary { background: #6c757d; color: #fff; }
