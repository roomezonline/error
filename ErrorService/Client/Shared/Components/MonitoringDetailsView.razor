    private static string SnapshotUnit(string key, string val) => key switch
    {
        "Voltage" => $"{val} V",
        "Jaryan" => $"{val} Amp",
        "Tavan" => val,
        "Temp1" or "Temp2" or "Temp3" => $"{val} C",
        _ => val
    };

    private static List<(string label, string value, string color, string iconSvg)>? ParseSnapshot(string json)
    {
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            var fields = new List<(string, string, string, string)>();

            void Add(string key, string label, string color, bool alwaysShow = false)
            {
                if (key == "Tavan")
                {
                    if (root.TryGetProperty("Tavan", out var tavEl))
                    {
                        var raw = tavEl.GetRawText().Trim('"');
                        if (!string.IsNullOrEmpty(raw) && raw != "null" && double.TryParse(raw, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var tavanVal))
                        {
                            var displayVal = tavanVal >= 1000 ? (tavanVal / 1000).ToString("F2") + " kW" : tavanVal.ToString("F0") + " W";
                            fields.Add((label, displayVal, color, SnapshotIcon(key)));
                            return;
                        }
                    }
                    fields.Add((label, "0 W", color, SnapshotIcon(key)));
                    return;
                }

                if (root.TryGetProperty(key, out var el))
                {
                    var val = el.GetRawText().Trim('"');
                    if (!string.IsNullOrEmpty(val) && val != "null")
                    {
                        var isBool = key is "Priz" or "MotorState" or "Element1" or "Element2";
                        var isOn = isBool && val.Equals("on", StringComparison.OrdinalIgnoreCase)
                                || isBool && val.Equals("True", StringComparison.OrdinalIgnoreCase)
                                || isBool && val == "1";
                        var isOff = isBool && val.Equals("off", StringComparison.OrdinalIgnoreCase)
                                 || isBool && val.Equals("False", StringComparison.OrdinalIgnoreCase)
                                 || isBool && val == "0";
                        var icon = SnapshotIcon(key);
                        if (isOn) fields.Add((label, "روشن", "#10b981", icon));
                        else if (isOff) fields.Add((label, "خاموش", "#ef4444", icon));
                        else
                        {
                            var displayVal = val;
                            if (key == "Jaryan")
                            {
                                var parts = val.Split('-', StringSplitOptions.RemoveEmptyEntries);
                                var maxJ = double.MinValue;
                                foreach (var p in parts)
                                {
                                    if (double.TryParse(p.Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed) && parsed > maxJ)
                                        maxJ = parsed;
                                }
                                if (maxJ > double.MinValue)
                                    displayVal = maxJ.ToString("F2");
                            }
                            else if (key is "Temp1" or "Temp2" or "Temp3")
                            {
                                if (double.TryParse(val, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
                                    displayVal = parsed.ToString("F0");
                            }
                            else if (key == "Voltage")
                            {
                                if (double.TryParse(val, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
                                    displayVal = parsed.ToString("F0");
                                else if (val.Equals("nan", StringComparison.OrdinalIgnoreCase) || val.Equals("NaN", StringComparison.OrdinalIgnoreCase))
                                    displayVal = "0";
                            }
                            fields.Add((label, SnapshotUnit(key, displayVal), color, icon));
                        }
                        return;
                    }
                }
                if (alwaysShow)
                {
                    fields.Add((label, "0", color, SnapshotIcon(key)));
                }
            }

            Add("Priz", "برق اصلی", "#2563eb");
            Add("MotorState", "موتور", "#8b5cf6");
            Add("Element1", "المنت ۱", "#0ea5e9");
            Add("Element2", "المنت ۲", "#0ea5e9");
            Add("Temp1", "دمای یخچال", "#14b8a6");
            Add("Temp2", "دمای فریزر", "#06b6d4");
            Add("Temp3", "دمای محیط", "#eab308");
            Add("Voltage", "ولتاژ", "#f59e0b", true);
            Add("Jaryan", "جریان", "#0ea5e9", true);
            Add("Tavan", "توان", "#10b981", true);

            return fields;
        }
        catch { return null; }
    }

