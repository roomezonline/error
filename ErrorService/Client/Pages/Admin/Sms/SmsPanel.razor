                                <div class="sms-log-card__error">@log.ErrorMessage</div>
                            }
                        </div>
                    }
                    @if (_logs.Count == 0)
                    {
                        <div class="sms-empty">هیچ پیامکی یافت نشد.</div>
                    }
                    @if (_totalLogs > _logPage * _logPageSize)
                    {
                        <button class="btn btn-outline-primary w-100 mt-2" @onclick="LoadMoreAdminLogs" disabled="@_loadingLogs">
                            بارگذاری بیشتر
                        </button>
                    }
                }
            }
            else
            {
                <!-- Workshop view: own logs -->
                <div class="sms-table-toolbar sms-table-toolbar--wrap">
                    <select class="sms-input sms-input--select" @bind="@_myLogModuleFilter" @bind:after="LoadMyLogs">
                        <option value="">همه ماژول‌ها</option>
                        <option value="1">ثبت سفارش</option>
                        <option value="2">آماده تحویل</option>
                        <option value="3">غیر قابل تعمیر</option>
                        <option value="4">کار جدید تکنسین</option>
                    </select>
                    <select class="sms-input sms-input--select" @bind="@_myLogStatusFilter" @bind:after="LoadMyLogs">
                        <option value="-1">همه وضعیت‌ها</option>
                        <option value="0">در انتظار</option>
                        <option value="1">ارسال شده</option>
                        <option value="2">ناموفق</option>
                    </select>
                </div>
                @if (_loadingMyLogs)
                {
                    <div class="sms-loading">در حال بارگذاری...</div>
                }
                else
                {
                    @foreach (var log in _myLogs)
                    {
                        <div class="sms-log-card">
                            <div class="sms-log-card__recipient">
                                <span class="oi oi-phone"></span>
                                <span dir="ltr">@log.RecipientNumber</span>
                            </div>
                            @if (log.ModuleTitle != null)
                            {
                                <div class="sms-log-card__module">
                                    <span class="sms-badge sms-badge--info">@log.ModuleTitle</span>
                                </div>
                            }
                            <div class="sms-log-card__text">@log.MessageText</div>
                            <div class="sms-log-card__footer">
                                <span class="sms-badge sms-badge--@(log.SendStatus == "ارسال شده" ? "success" : log.SendStatus == "ناموفق" ? "danger" : "warn")">
                                    @log.SendStatus
                                </span>
                                <span class="sms-badge sms-badge--delivery sms-badge--@GetDeliveryBadgeClass(log.DeliveryStatus)">
                                    @GetDeliveryStatusText(log.DeliveryStatus)
                                </span>
                                <span class="sms-log-card__date">@PersianDateHelper.ToPersianDateTimeString(log.CreatedAt.ToLocalTime(), true)</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(log.ErrorMessage))
                            {
                                <div class="sms-log-card__error">@log.ErrorMessage</div>
                            }
                        </div>
                    }
                    @if (_myLogs.Count == 0)
                    {
                        <div class="sms-empty">هیچ پیامکی یافت نشد.</div>
                    }
                    @if (_totalMyLogs > _myLogPage * _myLogPageSize)
                    {
                        <button class="btn btn-outline-primary w-100 mt-2" @onclick="LoadMoreMyLogs" disabled="@_loadingMyLogs">
                            بارگذاری بیشتر
                        </button>
                    }
                }
            }
        </div>
    }

    <!-- Adjust Credit Modal -->
    @if (_showAdjustModal)
    {
        <div class="sms-modal-overlay" @onclick="CloseAdjustModal">
            <div class="sms-modal" @onclick:stopPropagation>
                <div class="sms-modal__header">
                    <h3>شارژ دستی اعتبار</h3>
                    <button class="btn-close" @onclick="CloseAdjustModal"></button>
                </div>
                <div class="sms-modal__body">
                    <div class="sms-form__group mb-2">
                        <label class="sms-form__label">کارگاه</label>
                        <div class="sms-form__static">@_adjustWorkshopName</div>
                    </div>
                    <div class="sms-form__group mb-2">
                        <label class="sms-form__label">موجودی فعلی</label>
                        <div class="sms-form__static">@($"{_adjustCurrentBalance:N0}") تومان</div>
                    </div>
                    <div class="sms-form__group mb-2">
                        <label class="sms-form__label">مبلغ شارژ (تومان)</label>
                        <input type="text" class="sms-input ltr-input"
                               inputmode="numeric"
                               value="@_adjustAmountDisplay"
                               @oninput="OnAdjustAmountInput" />
                    </div>
                    <div class="sms-form__group">
                        <label class="sms-form__label">دلیل</label>
                        <input type="text" class="sms-input" bind="@_adjustReason" placeholder="شارژ دستی توسط ادمین" />
                    </div>
                </div>
                <div class="sms-modal__footer">
                    <button class="btn btn-secondary" @onclick="CloseAdjustModal">انصراف</button>
                    <button class="btn btn-primary" @onclick="ConfirmAdjust" disabled="@(_adjustAmount <= 0)">تایید شارژ</button>
                </div>
            </div>
        </div>
    }

</div>

@code {
    private string activeTab = "dashboard";
    private List<TabDef> tabs = new();
    private bool saving;
    private SmsSettingsDto? settings;
    private SmsSettingsUpdateRequest settingsEdit = new();
    private SmsDashboardDto? dashboard;

    // ─── Permission flags ───
    private bool _canManageGlobal;
    private bool _canViewAllCredits;
    private bool _canManageCredits;
    private bool _canViewAllCharges;
    private bool _canApproveCharges;
    private bool _canViewAllLogs;
    private bool _canManageWorkshop;
    private bool _canViewOwnCredit;
    private bool _canRequestCharge;
    private bool _canViewOwnCharges;
    private bool _canViewOwnLogs;

    private bool _isAdminCredits => _canViewAllCredits || _canManageCredits;
    private bool _isAdminCharges => _canViewAllCharges || _canApproveCharges;
    private bool _isAdminLogs => _canViewAllLogs;
    private bool _isWorkshopCharges => _canRequestCharge || _canViewOwnCharges;
    private bool _isWorkshopOnlyUser; // has workshop perms but NO admin perms
    private WorkshopSmsDashboardDto? _wsDashboard;

    // ─── Workshop Settings ───
    private WorkshopSmsSettingDto? _wsSettings;
    private WorkshopSmsSettingUpdateRequest _wsSettingsEdit = new();
    private bool _savingWsSettings;
    private List<WorkshopSmsModuleDto>? _wsModules;
    private bool _loadingWsSettings;
    private List<WorkshopDto>? _allWorkshops;
    private int? _wsSelectedWorkshopId;

    // ─── Credits (Admin) ───
    private List<WorkshopSmsCreditDto> _credits = new();
    private List<WorkshopSmsCreditDto> _filteredCredits = new();
    private bool _loadingCredits;
    private string _creditSearch = "";

    // ─── Dashboard Workshop Selector ───
    private int? _selectedWorkshopId;
    private WorkshopSmsCreditDto? _selectedWorkshopCredit;

    // ─── Credits (Workshop) ───
    private WorkshopSmsCreditDto? _ownCredit;

    // ─── Charges (Admin) ───
    private List<SmsChargeTransactionDto> _charges = new();
    private bool _loadingCharges;
    private int _chargeStatusFilter = -1;
    private int _chargePage = 1;
    private int _totalCharges;
    private const int _chargePageSize = 20;
    private bool _showRejectModal;
    private int _rejectChargeId;
    private string _rejectReason = "";

    // ─── Charges (Workshop submit) ───
    private decimal _chargeRequestValue;
    private string _chargeRequestDisplay = "";
    private string _chargeRequestDesc = "";
    private bool _submittingCharge;
    private IBrowserFile? _receiptFile;
    private string? _receiptFileName;
    private string? _receiptPreviewUrl;

    // ─── Charges (Workshop history) ───
    private List<SmsChargeTransactionDto> _myCharges = new();
    private bool _loadingMyCharges;
    private int _myChargeStatusFilter = -1;
    private int _myChargePage = 1;
    private int _totalMyCharges;
    private const int _myChargePageSize = 20;

    // ─── Logs (Admin) ───
    private List<SmsLogDto> _logs = new();
    private bool _loadingLogs;
    private bool _checkingDelivery;
    private DeliveryCheckBatchResult? _deliveryCheckResult;
    private string _logWorkshopSearch = "";
    private int _logModuleFilter;
    private int _logStatusFilter = -1;
    private int _logPage = 1;
    private int _totalLogs;
    private const int _logPageSize = 20;

    // ─── Logs (Workshop) ───
    private List<SmsLogDto> _myLogs = new();
    private bool _loadingMyLogs;
    private int _myLogModuleFilter;
    private int _myLogStatusFilter = -1;
    private int _myLogPage = 1;
    private int _totalMyLogs;
    private const int _myLogPageSize = 20;

    // ─── Adjust modal ───
    private bool _showAdjustModal;
    private int _adjustWorkshopId;
    private string _adjustWorkshopName = "";
    private decimal _adjustCurrentBalance;
    private decimal _adjustAmount;
    private string _adjustAmountDisplay = "";
    private string _adjustReason = "";

    private sealed record TabDef(string Key, string Label, string Icon, int Badge = 0);

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        var isSuperAdmin = user.HasClaim(ClaimTypes.Role, "super_admin");

        bool HasPerm(string perm) => isSuperAdmin || user.HasClaim("perm", perm);

        _canManageGlobal = HasPerm("admin.sms.manage");
        _canViewAllCredits = HasPerm("admin.sms.credits.view");
        _canManageCredits = HasPerm("admin.sms.credits.manage");
        _canViewAllCharges = HasPerm("admin.sms.charges.view");
        _canApproveCharges = HasPerm("admin.sms.charges.approve");
        _canViewAllLogs = HasPerm("admin.sms.logs.view");
        _canManageWorkshop = HasPerm("workshop.sms.settings.manage");
        _canViewOwnCredit = user.HasClaim("perm", "workshop.sms.credit.view");
        _canRequestCharge = user.HasClaim("perm", "workshop.sms.charge.request");
        _canViewOwnCharges = user.HasClaim("perm", "workshop.sms.charge.history");
        _canViewOwnLogs = user.HasClaim("perm", "workshop.sms.logs.view");

        var hasAnySmsPerm = _canManageGlobal || _canViewAllCredits || _canManageCredits
            || _canViewAllCharges || _canApproveCharges || _canViewAllLogs
            || _canManageWorkshop || _canViewOwnCredit || _canRequestCharge
            || _canViewOwnCharges || _canViewOwnLogs;
        if (!hasAnySmsPerm)
        {
            Nav.NavigateTo("/admin");
            return;
        }

        var hasAdminSmsPerm = _canManageGlobal || _canViewAllCredits || _canManageCredits
            || _canViewAllCharges || _canApproveCharges || _canViewAllLogs;
        _isWorkshopOnlyUser = !hasAdminSmsPerm;

        tabs = new();
        tabs.Add(new("dashboard", "داشبورد", "graph", 0));
        if (_canManageGlobal) tabs.Add(new("settings-global", "تنظیمات کلی", "wrench", 0));
        if (_canManageWorkshop) tabs.Add(new("settings-workshop", "تنظیمات کارگاه", "cog", 0));
        if (_isAdminCredits || _canViewOwnCredit) tabs.Add(new("credits", "اعتبار", "bank", 0));
        if (_isAdminCharges || _isWorkshopCharges) tabs.Add(new("charges", "شارژ", "cart", 0));
        if (_isAdminLogs || _canViewOwnLogs) tabs.Add(new("logs", "گزارشات", "envelope-letter", 0));

        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var tabParam = System.Web.HttpUtility.ParseQueryString(uri.Query).Get("tab");
        if (!string.IsNullOrEmpty(tabParam) && tabs.Any(t => t.Key == tabParam))
        {
            activeTab = tabParam;
            await SwitchTab(tabParam);
        }
        else
        {
            await LoadDashboard();
            if (_canManageGlobal) await LoadSettings();
        }
    }

    private async Task SwitchTab(string key)
    {
        activeTab = key;
        switch (key)
        {
            case "dashboard": await LoadDashboard(); break;
            case "settings-global": break;
            case "settings-workshop":
                if (_allWorkshops == null && _canManageGlobal)
                {
                    await LoadAllWorkshops();
                    if (_allWorkshops?.Count > 0 && _wsSelectedWorkshopId == null)
                        _wsSelectedWorkshopId = _allWorkshops[0].Id;
                }
                await LoadWorkshopSettings();
                break;
            case "credits":
                if (_isAdminCredits) await LoadAdminCredits();
                if (_canViewOwnCredit && !_isAdminCredits) await LoadOwnCredit();
                break;
            case "charges":
                if (_isAdminCharges) await LoadAdminCharges();
                if (_isWorkshopCharges && !_isAdminCharges) await LoadMyCharges();
                break;
            case "logs":
                if (_isAdminLogs) await LoadAdminLogs();
                if (_canViewOwnLogs && !_isAdminLogs) await LoadMyLogs();
                break;
        }
    }

    // ─── Dashboard ───
    private async Task LoadDashboard()
    {
        try
        {
            if (_isWorkshopOnlyUser)
            {
                _wsDashboard = await Http.GetFromJsonAsync<WorkshopSmsDashboardDto>("api/workshop-sms/dashboard");
            }
            else
            {
                dashboard = await Http.GetFromJsonAsync<SmsDashboardDto>("api/sms-admin/dashboard");
                var chargeIdx = tabs.FindIndex(t => t.Key == "charges");
                if (chargeIdx >= 0 && dashboard != null)
                {
                    tabs[chargeIdx] = tabs[chargeIdx] with { Badge = dashboard.PendingChargeCount };
                    StateHasChanged();
                }

                await LoadAdminCredits();
                if (_credits.Count > 0)
                {
                    _selectedWorkshopId = _credits[0].WorkshopId;
                    _selectedWorkshopCredit = _credits[0];
                }
            }
        }
        catch (Exception ex) { Console.WriteLine($"[SmsPanel] LoadDashboard error: {ex.Message}"); }
    }

    private void OnSelectedWorkshopChanged()
    {
        _selectedWorkshopCredit = _selectedWorkshopId.HasValue
            ? _credits.FirstOrDefault(c => c.WorkshopId == _selectedWorkshopId.Value)
            : null;
    }

    // ─── Global Settings ───
    private async Task LoadSettings()
    {
        try
        {
            settings = await Http.GetFromJsonAsync<SmsSettingsDto>("api/sms-settings");
            if (settings != null)
            {
                settingsEdit = new SmsSettingsUpdateRequest
                {
                    IsActive = settings.IsActive,
                    OtpEnabled = settings.OtpEnabled,
                    TariffPerSms = settings.TariffPerSms,
                    ApiKey = settings.ApiKey,
                    SenderNumber = settings.SenderNumber,
                    MonthlyQuota = settings.MonthlyQuota,
                    WarningThreshold = settings.WarningThreshold
                };
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "[SmsPanel] LoadSettings:", ex.ToString());
        }
    }

    private async Task SaveSettings()
    {
        saving = true;
        try
        {
            await JS.InvokeVoidAsync("console.log", "[SmsPanel] saving tariffPerSms=", settingsEdit.TariffPerSms);
            var response = await Http.PutAsJsonAsync("api/sms-settings", settingsEdit);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess("تنظیمات با موفقیت ذخیره شد");
                await LoadSettings();
            }
            else
            {
                var err = await response.Content.ReadAsStringAsync();
                await JS.InvokeVoidAsync("console.error", "[SmsPanel] HTTP error:", err);
                ToastService.ShowError($"خطا در ذخیره: {err}");
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("console.error", "[SmsPanel] SaveSettings:", ex.ToString());
            ToastService.ShowError($"خطا: {ex.Message}");
        }
        finally { saving = false; }
    }

    private async Task GoSettingsTab() => await SwitchTab("settings-global");

    private async Task LoadAllWorkshops()
    {
        try
        {
            var all = await Http.GetFromJsonAsync<List<WorkshopDto>>("api/workshops");
            _allWorkshops = all?.Where(x => x.IsActive).OrderBy(x => x.WorkshopName).ToList();
        }
        catch { _allWorkshops = new(); }
    }

    private async Task OnWsWorkshopSelected(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
            _wsSelectedWorkshopId = id;
        else
            _wsSelectedWorkshopId = null;
        await LoadWorkshopSettings();
